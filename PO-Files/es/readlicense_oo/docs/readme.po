msgid "${PRODUCTNAME} ${PRODUCTVERSION} ReadMe"
msgstr "Léame de ${PRODUCTNAME} ${PRODUCTVERSION}"

#: readme.xrm#LatestUpdates.LatestUpdates.readmeitem.text
#: readme.xrm%23LatestUpdates.LatestUpdates.readmeitem.text
msgid ""
"For latest updates to this readme file, see <a href=\""
"https://www.openoffice.org/welcome/readme.html\""
