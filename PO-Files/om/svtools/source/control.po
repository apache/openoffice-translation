#: ctrltool.src%23STR_SVT_FONTMAP_BOTH.string.text
msgid "The same font will be used on both your printer and your screen."
msgstr "Maxxansaa fi argii keerratti bocquu walfakkaatuti itti fayyadama."

#: ctrltool.src%23STR_SVT_FONTMAP_PRINTERONLY.string.text
msgid "This is a printer font. The screen image may differ."
msgstr "Kuni bocquu maxxansaati. Calaqqeen argii kee adda ta'uu mala."

#: ctrltool.src%23STR_SVT_FONTMAP_SCREENONLY.string.text
msgid "This is a screen font. The printer image may differ."
msgstr "Kuni bocquu argiiti. Calaqqeen argii kee adda ta'uu mala."

#: ctrltool.src%23STR_SVT_FONTMAP_SIZENOTAVAILABLE.string.text
msgid ""
"This font size has not been installed. The closest available size will be "
"used."
msgstr ""
"Bocquun bal'ina hanganaa hin ijaaramne. Bocquu jiran keessaa kan daran itti "
"aanee jiru itti fayyadama."

#: ctrltool.src%23STR_SVT_FONTMAP_STYLENOTAVAILABLE.string.text
msgid ""
"This font style will be simulated or the closest matching style will be used."
msgstr "Bocquun simulate ni ta'a ykn haalatini walsimu ni fudhatama."

#: ctrltool.src%23STR_SVT_FONTMAP_NOTAVAILABLE.string.text
msgid ""
"This font has not been installed. The closest available font will be used."
msgstr ""
"Bocquun bal'ina hanganaa hin ijaaramne. Bocquu jiran keessaa kan daran itti "
"aanee jiru itti fayyadama."

