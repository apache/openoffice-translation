msgid "Target directory:"
msgstr "Galeeloo galtee:"

#: euro.src%23STEP_AUTOPILOT___7.string.text
msgid "Temporarily unprotect sheet without query"
msgstr "Wardii gaafata malee yeroof hin ittisin"

#: euro.src%23STEP_AUTOPILOT___10.string.text
msgid "Also convert fields and tables in text documents"
msgstr "Dirreewwanii fi gabaateewwan galmeelee barruu keessaas  jijjiiri"

#: euro.src%23STATUSLINE.string.text
msgid "Conversion status: "
msgstr "Haala jijjiirraa:"

#: euro.src%23STATUSLINE___1.string.text
msgid "Conversion status of the cell templates:"
msgstr "Haala jijjiirraa qajojiilee maadhee:"

#: euro.src%23STATUSLINE___2.string.text
msgid ""
"Registration of the relevant ranges: Sheet %1Number%1 of %2TotPageCount%2"
msgstr ""
"Galmeeffama hammanagaawwan waltahaa: Wardii %1Number%1 kan %2TotPageCount%2  "

#: euro.src%23STATUSLINE___3.string.text
msgid "Entry of the ranges to be converted..."
msgstr "Galfata hammangaawwan jijjiiramanii"

#: euro.src%23STATUSLINE___4.string.text
msgid "Sheet protection for each sheet will be restored..."
msgstr "Ittisni wardii tokkoon tokkoo wardiitiif  bakkaddeebisama"

#: euro.src%23STATUSLINE___5.string.text
msgid "Conversion of the currency units in the cell templates..."
msgstr "Jijjiirama yuuniitii maallaqaa qajojiilee maadhee keessatti "

#: euro.src%23MESSAGES.string.text
msgid "~Finish"
msgstr "Xumuri"

#: euro.src%23MESSAGES___1.string.text
msgid "Select directory"
msgstr "Galeeloo fili"

#: euro.src%23MESSAGES___2.string.text
msgid "Select file"
msgstr "Faayilii fili"

#: euro.src%23MESSAGES___3.string.text
msgid "Select target directory"
msgstr "Galeeloo galtee fili"

#: euro.src%23MESSAGES___4.string.text
msgid "non-existent"
msgstr "Waan hin jirre"

#: euro.src%23MESSAGES___5.string.text
msgid "Euro Converter"
msgstr "Jijjiiraa Euro"

#: euro.src%23MESSAGES___6.string.text
msgid "Should protected spreadsheets be temporarily unprotected?"
msgstr "Wardiileen ittifaman yeroodhaaf ittisa mulqamuu qabuu?"

#: euro.src%23MESSAGES___7.string.text
msgid "Enter the password to unprotect the table %1TableName%1"
msgstr "Gabatee %1TableName%1 ittisa mulquuf iggita galchi"

#: euro.src%23MESSAGES___8.string.text
msgid "Wrong Password!"
msgstr "Iggita Dogoggoraa!"

#: euro.src%23MESSAGES___9.string.text
msgid "Protected Sheet"
msgstr "Wardii Ittifame"

#: euro.src%23MESSAGES___10.string.text
msgid "Warning!"
msgstr "Of eeggannoo!"

#: euro.src%23MESSAGES___11.string.text
msgid "Protection for the sheets will not be removed."
msgstr "Ittisni wardiilee hin haqamu."

#: euro.src%23MESSAGES___12.string.text
msgid "Sheet cannot be unprotected"
msgstr "Wardiin hin ittifamu"

#: euro.src%23MESSAGES___13.string.text
msgid ""
"The Wizard cannot edit this document as cell formats cannot be modified in "
"documents containing protected spreadsheets."
msgstr ""
"Masakaan kun galmee kana gulaaluu hin danda'u sababni isaas dhangiileen "
"maadhee galmeelee wardiilee ittifamanii fooyya'uu hin danda'an."

#: euro.src%23MESSAGES___14.string.text
msgid ""
"Please note that the Euro Converter will, otherwise, not be able to edit "
"this document!"
msgstr ""
"Mee akka jijjiiraan Euro, ta'uu baatu, galmee kana gulaaluu hin dandeenye "
"hubadhu!"

#: euro.src%23MESSAGES___15.string.text
msgid "Please choose a currency to be converted first!"
msgstr "Mee maallaqa jijjiramu jalqaba fili!"

#: euro.src%23MESSAGES___16.string.text
msgid "Password:"
msgstr "Iggita:"

#: euro.src%23MESSAGES___17.string.text
msgid "OK"
msgstr "TOLE"

#: euro.src%23MESSAGES___18.string.text
msgid "Cancel"
msgstr "Dhiisi"

#: euro.src%23MESSAGES___19.string.text
msgid "Please select a %PRODUCTNAME Calc document for editing!"
msgstr "Mee galmee %PRODUCTNAME Calc gulaalaaf fili!"

#: euro.src%23MESSAGES___20.string.text
msgid "'<1>' is not a directory!"
msgstr "'<1>' Galeeloo miti!"

#: euro.src%23MESSAGES___21.string.text
msgid "Document is read-only!"
msgstr "Galmeen dubbisqofa dha!"

#: euro.src%23MESSAGES___22.string.text
msgid "The '<1>' file already exists.<CR>Do you want to overwrite it?"
msgstr "Faayiliin '<1>' dura jira. <CR>Irrabuu barbaaddaa?"

#: euro.src%23MESSAGES___23.string.text
msgid "Do you really want to terminate conversion at this point?"
msgstr "Jijjiirraa dhugumatti yeroo ammaatti dhaabuu barbaaddaa?"

#: euro.src%23MESSAGES___24.string.text
msgid "Cancel Wizard"
msgstr "Masaka Dhiisi"

