#: main0000.xhp%23tit.help.text
msgid "Charts in $[officename]"
msgstr "Դիագրամները $[officename] -ում"

#: main0000.xhp%23bm_id3148664.help.text
msgid ""
"<bookmark_value>charts; overview</bookmark_value>      <bookmark_value>"
"HowTos for charts</bookmark_value>"
msgstr ""
"<bookmark_value>charts; overview</bookmark_value>      <bookmark_value>"
"HowTos for charts</bookmark_value>"

#: main0000.xhp%23hd_id3148664.1.help.text
msgid ""
"<variable id=\"chart_main\"><link href=\"text/schart/main0000.xhp\" name=\""
"Charts in $[officename]\">Using Charts in %PRODUCTNAME</link></variable>"
msgstr ""
"<variable id=\"chart_main\"><link href=\"text/schart/main0000.xhp\" name=\""
"Դիագրամներ $[officename]\">Դիագրամների օգտագործումը "
"%PRODUCTNAME</link></variable>"

#: main0000.xhp%23par_id3154685.2.help.text
msgid ""
"<variable id=\"chart\">$[officename] lets you present data graphically in a "
"chart, so that you can visually compare data series and view trends in the "
"data. You can insert charts into spreadsheets, text documents, drawings, and "
"presentations. </variable>"
msgstr ""
"<variable id=\"chart\">$[officename] հնարավորություն է տալիս տվյալները "
"ներկայացնել գրաֆիկորեն աղյուսակում, որպեսզի տեսնելով համեմատեք տվյալների "
"շարքը և դիտեք տվյալների միտումները: Դուք կարող եք գծապատկերները ներդնել "
"աղյուսակների, տեքստային փաստաթղթերի, գծագրերի և շնորհանդեսների "
"մեջ:</variable>"

#: main0000.xhp%23hd_id3153143.5.help.text
msgid "Chart Data"
msgstr "Դիագրամայի տվյալներ"

#: main0000.xhp%23par_id5181432.help.text
msgid "Charts can be based on the following data:"
msgstr "Դիագրամաները կարող են հիմնված լինել հետևյալ տվյալների վրա․"

#: main0000.xhp%23par_id7787102.help.text
msgid "Spreadsheet values from Calc cell ranges"
msgstr "Փռված աղյուսակի արժեքները Calc -ի բջջային միջակայքից"

#: main0000.xhp%23par_id7929929.help.text
msgid "Cell values from a Writer table"
msgstr "Բջջային արժեքներ Writer աղյուսակից"

#: main0000.xhp%23par_id4727011.help.text
msgid ""
"Values that you enter in the Chart Data Table dialog (you can create these "
"charts in Writer, Draw, or Impress, and you can copy and paste them also to "
"Calc)"
msgstr ""
"Արժեքները, որոնք մուտքագրում եք Դիագրամայի տվյալների աղյուսակի "
"երկխոսությունում (կարող եք ստեղծել այս գծապատկերները Writer-ում, Draw-ում "
"կամ Impress-ում, և դրանք կարող եք պատճենել և հետ տեղադրել Calc -ում)"

#: main0000.xhp%23par_id76601.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Creates a chart in the current "
"document. To use a continuous range of cells as the data source for your "
"chart, click inside the cell range, and then choose this command. "
"Alternatively, select some cells and choose this command to create a chart "
"of the selected cells.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ընթացիկ փաստաթղթում ստեղծում է "
"գծապատկեր: Որպեսզի ձեր գծապատկերի տվյալների աղբյուրը որպես շարունակական "
"տիրույթ օգտագործվի, կտտացրեք բջջային միջակայքում և ապա ընտրեք այս հրամանը: "
"Այլապես, ընտրեք որոշ բջիջներ և ընտրեք այս հրամանը` ընտրված բջիջների "
"գծապատկերը ստեղծելու համար:</ahelp>"

#: main0000.xhp%23hd_id5345011.help.text
msgid "To insert a chart"
msgstr "Գծապատկերը ներդնելու համար"

#: main0000.xhp%23hd_id5631580.help.text
msgid "To edit a chart"
msgstr "Գծապատկերը խմբագրելու համար"

#: main0000.xhp%23par_id7911008.help.text
msgid "Click a chart to edit the object properties:"
msgstr "Կտտացրեք գծապատկերը օբյեկտի հատկությունները խմբագրելու համար."

#: main0000.xhp%23par_id9844660.help.text
msgid "Size and position on the current page."
msgstr "Չափը և դիրքը ընթացիկ էջում:"

#: main0000.xhp%23par_id8039796.help.text
msgid "Alignment, text wrap, outer borders, and more."
msgstr "Հավասարեցում, տեքստի ծածկում, արտաքին սահմաններ և այլն:"

#: main0000.xhp%23par_id7986693.help.text
msgid "Double-click a chart to enter the chart edit mode:"
msgstr ""
"Երկու անգամ սեղմեք գծապատկերը,աղյուսակի փոփոխման ռեժիմ մուտք գործելու համար."

#: main0000.xhp%23par_id2350840.help.text
msgid "Chart data values (for charts with own data)."
msgstr "Գծապատկերի տվյալների արժեքներ (սեփական տվյալներով գծապատկերների համար):"

#: main0000.xhp%23par_id3776055.help.text
msgid "Chart type, axes, titles, walls, grid, and more."
msgstr "Գծապատկերի տեսակը, առանցքները, վերնագրերը, պատերը, ցանցը և այլն:"

#: main0000.xhp%23par_id8442335.help.text
msgid "Double-click a chart element in chart edit mode:"
msgstr "Կրկնակի սեղմեք գծապատկերի տարրը աղյուսակի խմբագրման ռեժիմում."

#: main0000.xhp%23par_id4194769.help.text
msgid "Double-click an axis to edit the scale, type, color, and more."
msgstr ""
"Կրկնակի սեղմեք առանցք` սանդղակը, տեսակը, գույնը և այլն խմբագրելու համար:"

#: main0000.xhp%23par_id8644672.help.text
msgid ""
"Double-click a data point to select and edit the data series to which the "
"data point belongs."
msgstr ""
"Կրկնակի սեղմեք տվյալների կետը` ընտրելու և խմբագրելու այն տվյալների շարքը, "
"որին պատկանում է տվյալների կետը:"

#: main0000.xhp%23par_id6574907.help.text
msgid ""
"With a data series selected, click, then double-click a single data point to "
"edit the properties of this data point (for example, a single bar in a bar "
"chart)."
msgstr ""
"Ընտրված տվյալների շարքով կտտացրեք, այնուհետև կրկնակի կտտացրեք միայնակ տվյալի "
"կետին, այս տվյալների կետի հատկությունները խմբագրելու համար (օրինակ՝ մեկ "
"հիստոգրամում մեկ գիծ):"

#: main0000.xhp%23par_id1019200902360575.help.text
msgid ""
"Double-click the legend to select and edit the legend. Click, then double-"
"click a symbol in the selected legend to edit the associated data series."
msgstr ""
"Կրկնակի կտտացրեք լեգենդը՝ այն ընտրելու և խմբագրելու համար: Ընտրված լեգենդում "
"կտտացրեք, ապա կրկնակի կտտացրեք նիշը՝ կապակցված տվյալների շարքը խմբագրելու "
"համար:"

#: main0000.xhp%23par_id7528916.help.text
msgid ""
"Double-click any other chart element, or click the element and open the "
"Format menu, to edit the properties."
msgstr ""
"Կրկնակի սեղմեք ցանկացած այլ գծապատկերային տարր, կամ կտտացրեք տարրը և բացեք "
"Ձևաչափման ցանկը՝ հատկությունները խմբագրելու համար:"

#: main0000.xhp%23par_id8420667.help.text
msgid "Click outside the chart to leave the current edit mode."
msgstr "Կտտացրեք աղյուսակից դուրս` ներկայիս փոփոխման ռեժիմը լքելու համար:"

#: main0000.xhp%23par_id4923856.help.text
msgid ""
"To print a chart in high quality, you can export the chart to a PDF file and "
"print that file."
msgstr ""
"Աղյուսակը բարձրորակ տպելու համար կարող եք գծապատկերն արտահանել PDF նիշք և "
"տպել այդ նիշքը:"

#: main0000.xhp%23par_id0810200912061033.help.text
msgid ""
"In chart edit mode, you see the <link href=\"text/schart/main0202.xhp\">"
"Formatting Bar</link> for charts near the upper border of the document. The "
"Drawing Bar for charts appears near the lower border of the document. The "
"Drawing Bar shows a subset of the icons from the <link href=\"text/simpress/"
"main0210.xhp\">Drawing</link> toolbar of Draw and Impress."
msgstr ""
"In chart edit mode, you see the <link href=\"text/schart/main0202.xhp\">"
"Formatting Bar</link> for charts near the upper border of the document. The "
"Drawing Bar for charts appears near the lower border of the document. The "
"Drawing Bar shows a subset of the icons from the <link href=\""
"text/simpress/main0210.xhp\">Drawing</link> toolbar of Draw and Impress."

#: main0000.xhp%23par_id0810200902080452.help.text
msgid ""
"You can right-click an element of a chart to open the context menu. The "
"context menu offers many commands to format the selected element."
msgstr ""
"Համատեքստի ընտրացանկը բացելու համար կարող եք աջ սեղմել գծապատկերի տարրը: "
"Համատեքստի ընտրացանկը առաջարկում է բազմաթիվ հրամաններ` ընտրված տարրը "
"ձևավորելու համար:"

#: main0000.xhp%23par_id081020090354489.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Formats the selected title.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է ընտրված վերնագիրը:</ahelp>"

#: main0000.xhp%23par_id0810200903405629.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Formats the chart area.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է գծապատկերի "
"տարածքը:</ahelp>"

#: main0000.xhp%23par_id0810200903544867.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Formats the chart wall.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է գծապատկերի պատը:</ahelp>"

#: main0000.xhp%23par_id0810200903544952.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Formats the chart floor.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է գծապատկերի հատակը:</ahelp>"

#: main0000.xhp%23par_id0810200903544927.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Formats the chart legend.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է գծապատկերի "
"լեգենդը:</ahelp>"

#: main0000.xhp%23par_id0810200903544949.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Formats the selected axis.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է ընտրված առանցքը:</ahelp>"

#: main0000.xhp%23par_id0810200903544984.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Formats the selected data "
"point.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է ընտրված տվյալների "
"կետը:</ahelp>"

#: main0000.xhp%23par_id0810200903545096.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Formats the major grid.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է հիմնական ցանցը:</ahelp>"

#: main0000.xhp%23par_id0810200903545057.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Formats the minor grid.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է երկրորդական ցանցը:</ahelp>"

#: main0000.xhp%23par_id0810200903545095.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Formats the data series.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է տվյալների շարքը:</ahelp>"

#: main0000.xhp%23par_id0810200903545094.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Formats the stock loss "
"indicators.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է բաժնետոմսերի կորստի "
"ցուցանիշները:</ahelp>"

#: main0000.xhp%23par_id0810200903545113.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Formats the stock gain "
"indicators.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է բաժնետոմսերի շահույթի "
"ցուցանիշները:</ahelp>"

#: main0000.xhp%23par_id0810200903545149.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Formats the data labels.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է տվյալների "
"պիտակները:</ahelp>"

#: main0000.xhp%23par_id0810200903545159.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Formats the Y error bars.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևաչափում է Y սխալի ձողերը.</ahelp>"

#: main0000.xhp%23par_id081020090354524.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Formats the mean value line.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է միջին արժեքի գիծը:</ahelp>"

#: main0000.xhp%23par_id0810200903545274.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Formats the trendline.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է միտումի գիծը:</ahelp>"

#: main0000.xhp%23par_id0810200904063285.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Formats the trendline "
"equation.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է միտումի գծի "
"հավասարումը:</ahelp>"

#: main0000.xhp%23par_id0810200904063252.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Formats the selected data "
"label.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձևավորում է ընտրված տվյալների "
"պիտակը:</ahelp>"

#: main0000.xhp%23par_id0810200904063239.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens a dialog to insert chart "
"titles.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացում է երկխոսությունը, "
"գծապատկերների վերնագրերը տեղադրելու համար:</ahelp>"

#: main0000.xhp%23par_id0810200904233047.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens a dialog to insert or delete "
"axes.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Առանցքները տեղադրելու կամ ջնջելու "
"համար երկխոսություն է բացվում:</ahelp>"

#: main0000.xhp%23par_id0810200904233058.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens a dialog to insert an "
"axis.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացում է երկխոսությունը, առանցքը "
"տեղադրելու համար:</ahelp>"

#: main0000.xhp%23par_id0810200904233089.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens a dialog to insert an axis "
"title.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացվում է երկխոսություն` առանցքի "
"վերնագիրը տեղադրելու համար:</ahelp>"

#: main0000.xhp%23par_id0810200904233160.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Inserts a major grid.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Տեղադրում է հիմնական ցանցը:</ahelp>"

#: main0000.xhp%23par_id0810200904233175.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Inserts a minor grid.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Տեղադրում է երկրորդական ցանցը:</ahelp>"

#: main0000.xhp%23par_id0810200904233111.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Inserts data labels.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Տեղադրում է տվյալների "
"պիտակները:</ahelp>"

#: main0000.xhp%23par_id0810200904233174.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Inserts the trendline equation and "
"the coefficient of determination R².</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Տեղադրում է տենդենցի հավասարումը և R² "
"որոշման գործակիցը։</ahelp>"

#: main0000.xhp%23par_id0810200904265639.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Inserts the coefficient of "
"determination R² value.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Տեղադրում է R² արժեքի որոշման "
"գործակիցը:</ahelp>"

#: main0000.xhp%23par_id0810200904362614.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Inserts a single data label.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Տեղադրում է տվյալների մեկ "
"պիտակ:</ahelp>"

#: main0000.xhp%23par_id0810200904362666.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Deletes the chart legend.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ջնջում է գծապատկերի լեգենդը:</ahelp>"

#: main0000.xhp%23par_id0810200904362777.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Deletes the selected axis.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ջնջում է ընտրված առանցքը:</ahelp>"

#: main0000.xhp%23par_id0810200904362785.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Deletes the major grid.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Ջնջում է հիմնական ցանցը։</ahelp>"

#: main0000.xhp%23par_id0810200904362748.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Deletes the minor grid.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ջնջում է երկրորդական ցանցը։</ahelp>"

#: main0000.xhp%23par_id0810200904362778.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Deletes all data labels.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ջնջում է տվյալների բոլոր "
"պիտակները:</ahelp>"

#: main0000.xhp%23par_id0810200904362893.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Deletes the trendline "
"equation.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ջնջում է միտումների "
"հավասարումը:</ahelp>"

#: main0000.xhp%23par_id0810200904362896.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Deletes the R² value.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Ջնջում է R² արժեքը։</ahelp>"

#: main0000.xhp%23par_id0810200904362827.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Deletes the selected data "
"label.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ջնջում է տվյալների ընտրված "
"պիտակը:</ahelp>"

#: main0000.xhp%23par_id0810200904431376.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Deletes the mean value line.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ջնջում է միջին արժեքի գիծը:</ahelp>"

#: main0000.xhp%23par_id081020090443142.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Deletes the Y error bars.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Ջնջում է Y սխալի ձողերը:</ahelp>"

#: main0000.xhp%23par_id0810200904393229.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Resets the selected data point to "
"default format.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ընտրված տվյալների կետը վերադառնում է "
"լռելյայն ձևաչափի:</ahelp>"

#: main0000.xhp%23par_id0810200904393351.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Resets all data points to default "
"format.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Վերականգնում է տվյալների բոլոր կետերը "
"լռելյայն ձևաչափի:</ahelp>"

#: main0503.xhp%23tit.help.text
msgid "$[officename] Chart Features"
msgstr "$[officename] Chart հնարավորությունները"

#: main0503.xhp%23hd_id3150543.1.help.text
msgid ""
"<link href=\"text/schart/main0503.xhp\" name=\"$[officename] Chart Features\""
">$[officename] Chart Features</link>"
msgstr ""
"<link href=\"text/schart/main0503.xhp\" name=\"$[officename] Chart "
"հնարավորությունները\">$[officename] Chart հնարավորությունները</link>"

#: main0503.xhp%23par_id3150868.2.help.text
msgid "Charts allow you to present data so that it is easy to visualize."
msgstr ""
"Գծապատկերները թույլ են տալիս ներկայացնել տվյալները այնպես, որպեսզի հեշտ լինի "
"դրանք տեսանելի դարձնելը։"

#: main0503.xhp%23par_id3146974.6.help.text
msgid ""
"You can create a chart from source data in a Calc spreadsheet or a Writer "
"table. When the chart is embedded in the same document as the data, it stays "
"linked to the data, so that the chart automatically updates when you change "
"the source data."
msgstr ""
"Calc փռված թերթիկում կամ Writer աղուսակում աղբյուրի տվյալների հիման վրա "
"կարող եք ստեղծել գծապատկեր։ Երբ գծապատկերը ներկառուցված է նույն փաստաթղթում, "
"ինչպես տվյալները, այն մնում է տվյալների հետ կապված, այնպես որ աղյուսակը "
"ինքնաբերաբար թարմացվում է, երբ փոխում եք աղբյուրի տվյալները:"

#: main0503.xhp%23hd_id3153143.7.help.text
msgid "Chart Types"
msgstr "Գծապատկերի տեսակները"

#: main0503.xhp%23par_id3151112.8.help.text
msgid ""
"Choose from a variety of 3D charts and 2D charts, such as bar charts, line "
"charts, stock charts. You can change chart types with a few clicks of the "
"mouse."
msgstr ""
"Ընտրեք մի շարք 3D և 2D գծապատկերներներից, ինչպիսիք են ձողային գծապատկերները, "
"գծային գծապատկերները, ֆոնդային գծապատկերները: Կարող եք փոխել գծապատկերի "
"տեսակները մկնիկի մի քանի կտտոցով:"

#: main0503.xhp%23hd_id3149665.10.help.text
msgid "Individual Formatting"
msgstr "Անհատական ձևաչափում"

#: main0503.xhp%23par_id3156441.11.help.text
msgid ""
"You can customize individual chart elements, such as axes, data labels, and "
"legends, by right-clicking them in the chart, or with toolbar icons and menu "
"commands."
msgstr ""
"Կարող եք անհատականացնել գծապատկերների առանձին տարրերը, ինչպիսիք են "
"առանցքները, տվյալների պիտակները և լեգենդները, դրանք ձախ-սեղմելով "
"գծապատկերում կամ գործիքագոտու պատկերակների և ընտրացանկի հրամանների միջոցով:"

#: main0202.xhp%23tit.help.text
msgid "Formatting Bar"
msgstr "Ձևավորման վահանակ"

#: main0202.xhp%23hd_id0810200911433792.help.text
msgid ""
"<link href=\"text/schart/main0202.xhp\" name=\"Formatting Bar\">Formatting "
"Bar</link>"
msgstr ""
"<link href=\"text/schart/main0202.xhp\" name=\"Ձևավորման վահանակ\">Ձևավորման "
"վահանակ</link>"

#: main0202.xhp%23par_id0810200911433835.help.text
msgid ""
"The Formatting Bar is shown when a chart is set to edit mode. Double-click a "
"chart to enter edit mode. Click outside the chart to leave edit mode."
msgstr ""
"Ձևաչափման վահանակը ցուցադրվում է, երբ գծապատկերը սահմանվում է վիճակը "
"խմբագրելու համար: Կրկնակի կտտացրեք գծապատկերը՝ խմբագրման վիճակ մուտք "
"գործելու համար: Կտտացրեք աղյուսակից դուրս՝ խմբագրման վիճակը լքելու համար:"

#: main0202.xhp%23par_id0810200911433878.help.text
msgid ""
"You can edit the formatting of a chart using the controls and icons on the "
"Formatting Bar."
msgstr ""
"Կարող եք խմբագրել գծապատկերի ձևաչափումը՝ օգտագործելով Ձևաչափման սանդղակի "
"հսկիչներն ու պատկերակները:"

#: main0202.xhp%23hd_id0810200902300436.help.text
msgid "Select Chart Element"
msgstr "Ընտրեք գծապատկերի տարրը"

#: main0202.xhp%23par_id0810200902300479.help.text
msgid ""
"<ahelp hid=\".\">Select the element from the chart that you want to format. "
"The element gets selected in the chart preview. Click Format Selection to "
"open the properties dialog for the selected element.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք տարրը այն աղյուսակից, որը ցանկանում եք ձևափոխել: "
"Տարրը ընտրվում է գծապատկերի նախադիտման մեջ: Կտտացրեք Ձևաչափի ընտրությունը, "
"ընտրված տարրի հատկությունների երկխոսությունը բացելու համար:</ahelp>"

#: main0202.xhp%23hd_id0810200902300555.help.text
msgid "Format Selection"
msgstr "Ձևաչափի Ընտրություն"

#: main0202.xhp%23par_id0810200902300539.help.text
msgid ""
"<ahelp hid=\".\">Opens the properties dialog for the selected "
"element.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրված տարրի համար բացում է հատկությունների "
"երկխոսությունը:</ahelp>"

#: main0202.xhp%23hd_id0810200902300545.help.text
msgid "Chart Type"
msgstr "Գծապատկերի տեսակ"

#: main0202.xhp%23par_id0810200902300594.help.text
msgid "<ahelp hid=\".\">Opens the Chart Type dialog.</ahelp>"
msgstr "<ahelp hid=\".\">Բացում է Գծապատկերի տեսակի երկխոսությունը։</ahelp>"

#: main0202.xhp%23hd_id0810200902300537.help.text
msgid "Chart Data Table"
msgstr "Գծապատկերի տեսակի աղյուսակ"

#: main0202.xhp%23par_id0810200902300699.help.text
msgid ""
"<ahelp hid=\".\">Opens the Data Table dialog where you can edit the chart "
"data.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացվում է Տվյալերի աղյուսակ երկխոսությունը, որտեղ կարող եք "
"խմբագրել գծապատկերային տվյալները:</ahelp>"

#: main0202.xhp%23hd_id0810200902300672.help.text
msgid "Horizontal Grid On/Off"
msgstr "Հորիզոնական ցանցը միացված/անջատված"

#: main0202.xhp%23par_id0810200902300630.help.text
msgid ""
"<ahelp hid=\".\">The Horizontal Grid On/Off icon on the Formatting bar "
"toggles the visibility of the grid display for the Y axis.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ձևավորման վահանակի Հորիզոնական ցանցի միացված/անջատված "
"պատկերակը ղեկավարում է Y առանցքի համար ցանցի ցուցադրման "
"տեսանելիությունը:</ahelp>"

#: main0202.xhp%23hd_id0810200902300738.help.text
msgid "Legend On/Off"
msgstr "Լեգենդը միացված/անջատված"

#: main0202.xhp%23par_id081020090230076.help.text
msgid ""
"<ahelp hid=\".\">To show or hide a legend, click Legend On/Off on the "
"Formatting bar.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Լեգենդը ցույց տալու կամ թաքցնելու համար Ձևաչափման "
"վահանակում կտտացրեք «Լեգենդը միացոված/անջատված»-ը:</ahelp>"

#: main0202.xhp%23hd_id0810200902300785.help.text
msgid "Scale Text"
msgstr "Տեքստի մասշտաբ"

#: main0202.xhp%23par_id0810200902300784.help.text
msgid ""
"<ahelp hid=\".\">Rescales the text in the chart when you change the size of "
"the chart.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Գծապատկերի չափը փոխելիս աղյուսակում տեքստը վերափոխում "
"է:</ahelp>"

#: main0202.xhp%23hd_id081020090230087.help.text
msgid "Automatic Layout"
msgstr "Ավտոմատ դասավորություն"

#: main0202.xhp%23par_id0810200902300834.help.text
msgid ""
"<ahelp hid=\".\">Moves all chart elements to their default positions inside "
"the current chart. This function does not alter the chart type or any other "
"attributes other than the position of elements.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Տեղափոխում են բոլոր գծապատկերային տարրերը իրենց հիմնական "
"դիրքերը ընթացիկ գծապատկերում: Այս գործառույթը չի փոփոխում գծապատկերի տեսակը "
"կամ որևէ այլ հատկանիշ, բացի տարրերի դիրքից:</ahelp>"
