msgstr ""
"<ahelp hid=\"HID_AUTH_MARK_DLG_ID_LISTBOX\">Ընտրեք մատենագրության գրառման "
"կարճ անվանումը, որը ցանկանում եք տեղադրել:</ahelp>"

#: 04120300.xhp#hd_id3151260.7.help.text
#: 04120300.xhp%23hd_id3151260.7.help.text
msgctxt "04120300.xhp#hd_id3151260.7.help.text"
msgid "Author, Title"
msgstr "Հեղինակ, վերնագիր"

#: 04120300.xhp#par_id3149824.8.help.text
#: 04120300.xhp%23par_id3149824.8.help.text
msgid ""
"If available, the author and the full title of the selected short name are "
"displayed in this area."
msgstr ""
"Առկայության դեպքում, այս տարածքում ցուցադրվում են հեղինակը և ընտրված կարճ "
"անվանման ամբողջական վերնագիրը:"

#: 04120300.xhp#hd_id3149105.9.help.text
#: 04120300.xhp%23hd_id3149105.9.help.text
msgctxt "04120300.xhp#hd_id3149105.9.help.text"
msgid "Insert"
msgstr "Տեղադրել"

#: 04120300.xhp#par_id3147100.10.help.text
#: 04120300.xhp%23par_id3147100.10.help.text
msgid ""
"<ahelp hid=\"HID_INSERT_AUTH_MRK_OK\">Inserts the bibliographic reference "
"into the document. If you created a new record, you must also insert it as "
"an entry, otherwise the record is lost when you close the document.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_INSERT_AUTH_MRK_OK\">Մատենագիտական տեղեկանքը տեղադրում է "
"փաստաթղթում: Եթե դուք ստեղծել եք նոր գրառում, այն պետք է նաև տեղադրեք որպես "
"մուտք, հակառակ դեպքում փաստաթուղթը փակելիս գրառումը կորում է:</ahelp>"

#: 04120300.xhp#hd_id3147216.11.help.text
#: 04120300.xhp%23hd_id3147216.11.help.text
msgctxt "04120300.xhp#hd_id3147216.11.help.text"
msgid "Close"
msgstr "Փակել"

#: 04120300.xhp#par_id3149036.12.help.text
#: 04120300.xhp%23par_id3149036.12.help.text
msgid "<ahelp hid=\"HID_INSERT_AUTH_MRK_CLOSE\">Closes the dialog.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_INSERT_AUTH_MRK_CLOSE\">Փակում է երկխոսությունը:</ahelp>"

#: 04120300.xhp#hd_id3153634.13.help.text
#: 04120300.xhp%23hd_id3153634.13.help.text
msgctxt "04120300.xhp#hd_id3153634.13.help.text"
msgid "New"
msgstr "Նոր"

#: 04120300.xhp#par_id3147579.14.help.text
#: 04120300.xhp%23par_id3147579.14.help.text
msgid ""
"<ahelp hid=\"HID_INSERT_AUTH_MRK_CREATE_ENTRY\">Opens the <link href=\""
"text/swriter/01/04120229.xhp\" name=\"Define Bibliography Entry\">Define "
"Bibliography Entry</link> dialog, where you can create a new bibliography "
"record. This record is only stored in the document. To add a record to the "
"bibliography database, choose <emph>Tools - Bibliography "
"Database</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_INSERT_AUTH_MRK_CREATE_ENTRY\">Բացում է <link href=\""
"text/swriter/01/04120229.xhp\" name=\"Սահմանեք մատենագիտական մուտքը\">"
"Սահմանեք մատենագիտական մուտքը</link> երկխոսությունը, որտեղ կարող եք ստեղծել "
"մատենագիտական նոր գրառում: Այս գրառումը պահվում է միայն փաստաթղթում: "
"Մատենագիտական տվյալների շտեմարանին գրառում ավելացնելու համար ընտրեք <emph>"
"Գործիքներ - Մատենագիտական շտեմարան</emph>:</ahelp>"

#: 04120300.xhp#hd_id3155142.20.help.text
#: 04120300.xhp%23hd_id3155142.20.help.text
msgctxt "04120300.xhp#hd_id3155142.20.help.text"
msgid "Edit"
msgstr "Խմբագրել"

#: 04120300.xhp#par_id3157900.21.help.text
#: 04120300.xhp%23par_id3157900.21.help.text
msgid ""
"<ahelp hid=\"HID_INSERT_AUTH_MRK_EDIT_ENTRY\">Opens the <link href=\""
"text/swriter/01/04120229.xhp\" name=\"Define Bibliography Entry\">Define "
"Bibliography Entry</link> dialog where you can edit the selected "
"bibliography record.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_INSERT_AUTH_MRK_EDIT_ENTRY\">Բացում է <link href=\""
"text/swriter/01/04120229.xhp\" name=\"Սահմանեք մատենագիտական մուտքը\">"
"Սահմանեք մատենագիտական մուտքը</link> երկխոսությունը, որտեղ կարող եք խմբագրել "
"մատենագիտական ընտրված գրառումը:</ahelp>"

#: 04120300.xhp#par_id3149172.22.help.text
#: 04120300.xhp%23par_id3149172.22.help.text
msgid ""
"<link href=\"text/swriter/guide/indices_literature.xhp\" name=\"Tips for "
"working with bibliography entries\">Tips for working with bibliography "
"entries</link>"
msgstr ""
"<link href=\"text/swriter/guide/indices_literature.xhp\" name=\""
"Մատենագիտական մուտքերի հետ աշխատելու խորհուրդներ\">Մատենագիտական մուտքերի "
"հետ աշխատելու խորհուրդներ</link>"

#: 05060900.xhp#tit.help.text
#: 05060900.xhp%23tit.help.text
msgctxt "05060900.xhp#tit.help.text"
msgid "Options"
msgstr "Ընտրանքներ"

#: 05060900.xhp#hd_id3149879.1.help.text
#: 05060900.xhp%23hd_id3149879.1.help.text
msgid ""
"<link href=\"text/swriter/01/05060900.xhp\" name=\"Options\">Options</link>"
msgstr ""
"<link href=\"text/swriter/01/05060900.xhp\" name=\"Ընտրանքներ\""
">Ընտրանքներ</link>"

#: 05060900.xhp#par_id3149708.2.help.text
#: 05060900.xhp%23par_id3149708.2.help.text
msgid ""
"<ahelp hid=\"HID_FRM_ADD\">Specifies properties for the selected object, "
"graphic or frame.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FRM_ADD\">Նշում է ընտրված օբյեկտի, գծապատկերի կամ շրջանակի "
"հատկությունները:</ahelp>"

#: 05060900.xhp#hd_id3151183.3.help.text
#: 05060900.xhp%23hd_id3151183.3.help.text
msgctxt "05060900.xhp#hd_id3151183.3.help.text"
msgid "Name"
msgstr "Անուն"

#: 05060900.xhp#par_id3147568.4.help.text
#: 05060900.xhp%23par_id3147568.4.help.text
msgid "Specifies the name of the selected item, and associated links."
msgstr "Նշում է ընտրված նյութի անունը և դրա հետ կապված հղումները:"

#: 05060900.xhp#hd_id3151178.5.help.text
#: 05060900.xhp%23hd_id3151178.5.help.text
msgctxt "05060900.xhp#hd_id3151178.5.help.text"
msgid "Name"
msgstr "Անուն"

#: 05060900.xhp#par_id3147510.6.help.text
#: 05060900.xhp%23par_id3147510.6.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_FRM_ADD:ED_NAME\">Enter a name for the selected "
"item.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_FRM_ADD:ED_NAME\">Մուտքագրեք ընտրված նյութի "
"անունը:</ahelp>"

#: 05060900.xhp#par_id3154565.7.help.text
#: 05060900.xhp%23par_id3154565.7.help.text
msgid ""
"Assign an object, graphic or frame a meaningful name, so that you can "
"quickly locate it afterwards in long documents."
msgstr ""
"Նշանակեք առարկային, գրաֆիկային կամ շրջանակին իմաստալից անուն, որպեսզի "
"այնուհետև այն արագ հայտնաբերեք երկար փաստաթղթերում:"

#: 05060900.xhp#hd_id3153674.15.help.text
#: 05060900.xhp%23hd_id3153674.15.help.text
msgid "Alternative text (floating frames, graphics, and objects only)"
msgstr ""
"Այլընտրանքային տեքստ (միայն լողացող շրջանակներ, գրաֆիկայի և առարկաների համար)"

#: 05060900.xhp#par_id3150977.21.help.text
#: 05060900.xhp%23par_id3150977.21.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_FRM_ADD:ED_ALT_NAME\">Enter the text to display in a "
"web browser when the selected item is unavailable. Alternate text is also "
"used to assist people with disabilities.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_FRM_ADD:ED_ALT_NAME\">Մուտքագրեք տեքստը ոստայնի "
"զննարկչում ցուցադրելու համար, երբ ընտրված նյութն անհասանելի է: "
"Այլընտրանքային տեքստը նաև օգտագործվում է հաշմանդամություն ունեցող անձանց "
"աջակցելու համար:</ahelp>"

#: 05060900.xhp#hd_id3155903.23.help.text
#: 05060900.xhp%23hd_id3155903.23.help.text
msgid "Previous link"
msgstr "Նախորդ հղում"

#: 05060900.xhp#par_id3154192.24.help.text
#: 05060900.xhp%23par_id3154192.24.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_FRM_ADD_LB_PREV\">Displays the item (object, "
"graphic, or frame) that comes before the current item in a linked sequence. "
"To add or change the previous link, select a name from the list. If you are "
"linking frames, the current frame and the target frame must be empty.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_FRM_ADD_LB_PREV\">Կապված հաջորդականությամբ "
"ցուցադրում է այն նյութը (առարկան, գրաֆիկան կամ շրջանակը), որը գալիս է "
"ընթացիկ նյութից առաջ: Նախորդ հղումը ավելացնելու կամ փոխելու համար ցուցակից "
"ընտրեք անուն: Եթե դուք շրջանակներ եք կապում, ապա ընթացիկ շրջանակը և "
"նպատակային շրջանակը պետք է դատարկ լինեն:</ahelp>"

#: 05060900.xhp#hd_id3159198.25.help.text
#: 05060900.xhp%23hd_id3159198.25.help.text
msgid "Next link"
msgstr "Հաջորդ հղումը"

#: 05060900.xhp#par_id3149485.26.help.text
#: 05060900.xhp%23par_id3149485.26.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_FRM_ADD_LB_NEXT\">Displays the item (object, "
"graphic, or frame) that comes after the current item in a linked sequence. "
"To add or change the next link, select a name from the list. If you are a "
"linking frames, the target frame must be empty.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_FRM_ADD_LB_NEXT\">Կապված հաջորդականությամբ "
"ցուցադրում է նյութը (առարկան, գրաֆիկան կամ շրջանակը), որը գալիս է ընթացիկ "
"նյութից հետո: Հաջորդ հղումը ավելացնելու կամ փոխելու համար ցուցակից ընտրեք "
"անուն: Եթե դուք կապող շրջանակներն եք, նպատակային շրջանակը պետք է դատարկ "
"լինի:</ahelp>"

#: 05060900.xhp#hd_id3143280.27.help.text
#: 05060900.xhp%23hd_id3143280.27.help.text
msgctxt "05060900.xhp#hd_id3143280.27.help.text"
msgid "Protect"
msgstr "Պաշտպանել"

#: 05060900.xhp#par_id3154834.28.help.text
#: 05060900.xhp%23par_id3154834.28.help.text
msgid "Specifies protection options for the selected item."
msgstr "Նշում է ընտրված նյութի պաշտպանության ընտրանքները:"

#: 05060900.xhp#hd_id3149820.9.help.text
#: 05060900.xhp%23hd_id3149820.9.help.text
msgid "Protect Contents"
msgstr "Պաշտպանեք բովանդակությունը"

#: 05060900.xhp#par_id3149105.17.help.text
#: 05060900.xhp%23par_id3149105.17.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PROTECT_CONTENT\">Prevents changes to "
"the contents of the selected item.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PROTECT_CONTENT\">Կանխում է ընտրված "
"նյութի բովանդակության փոփոխությունները:</ahelp>"

#: 05060900.xhp#par_id3147099.29.help.text
#: 05060900.xhp%23par_id3147099.29.help.text
msgid "You can still copy the contents of the selected item."
msgstr "Դուք դեռ կարող եք պատճենել ընտրված նյութի պարունակությունը:"

#: 05060900.xhp#hd_id3148979.10.help.text
#: 05060900.xhp%23hd_id3148979.10.help.text
msgid "Protect Position"
msgstr "Պաշտպանեք դիրքը"

#: 05060900.xhp#par_id3147225.11.help.text
#: 05060900.xhp%23par_id3147225.11.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PROTECT_FRAME\">Locks the position of "
"the selected item in the current document.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PROTECT_FRAME\">Կողպում է ընտրված "
"նյութի դիրքը ընթացիկ փաստաթղթում:</ahelp>"

#: 05060900.xhp#hd_id3153629.12.help.text
#: 05060900.xhp%23hd_id3153629.12.help.text
msgid "Protect Size"
msgstr "Պաշտպանեք չափը"

#: 05060900.xhp#par_id3147576.13.help.text
#: 05060900.xhp%23par_id3147576.13.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PROTECT_SIZE\">Locks the size of the "
"selected item.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PROTECT_SIZE\">Կողպում է ընտրված "
"նյութի չափը։</ahelp>"

#: 05060900.xhp#hd_id3152770.8.help.text
#: 05060900.xhp%23hd_id3152770.8.help.text
msgctxt "05060900.xhp#hd_id3152770.8.help.text"
msgid "Properties"
msgstr "Հատկություններ"

#: 05060900.xhp#par_id3155137.16.help.text
#: 05060900.xhp%23par_id3155137.16.help.text
msgid "Specifies print and text options for the selected item."
msgstr "Ընտրված նյութի համար հատկորոշում է տպելու և տեքստի ընտրանքները:"

#: 05060900.xhp#hd_id3153345.18.help.text
#: 05060900.xhp%23hd_id3153345.18.help.text
msgid "Editable in read-only document (frames only)"
msgstr "Փոփոխելի է միայն կարդալ փաստաթղթում (միայն շրջանակների մեջ)"

#: 05060900.xhp#par_id3149167.19.help.text
#: 05060900.xhp%23par_id3149167.19.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_EDIT_IN_READONLY\">Allows you to edit "
"the contents of a frame in a document that is read-only (write-"
"protected).</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_EDIT_IN_READONLY\">Թույլ է տալիս "
"խմբագրել շրջանակի բովանդակությունը փաստաթղթում, որը միայն կարդալ է ("
"պաշտպանված գրելուց):</ahelp>"

#: 05060900.xhp#hd_id3156269.14.help.text
#: 05060900.xhp%23hd_id3156269.14.help.text
msgid "Print"
msgstr "Տպել"

#: 05060900.xhp#par_id3151028.20.help.text
#: 05060900.xhp%23par_id3151028.20.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PRINT_FRAME\">Includes the selected "
"item when you print the document.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_ADD:CB_PRINT_FRAME\">Փաստաթուղթը տպելիս "
"ներառում է ընտրված նյութը:</ahelp>"

#: 05060900.xhp#hd_id3145776.33.help.text
#: 05060900.xhp%23hd_id3145776.33.help.text
msgctxt "05060900.xhp#hd_id3145776.33.help.text"
msgid "Text flow"
msgstr "Տեքստի հոսք"

#: 05060900.xhp#par_id3151374.32.help.text
#: 05060900.xhp%23par_id3151374.32.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_FRM_ADD_LB_TEXTFLOW\">Specifies the preferred "
"text flow direction in a frame. To use the default text flow settings for "
"the page, select <emph>Use superordinate object settings </emph>from the "
"list.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_FRM_ADD_LB_TEXTFLOW\">Սահմանում է նախընտրելի "
"տեքստի հոսքի ուղղությունը շրջանակում: Էջի համար տեքստի հոսքի լռելյայն "
"կարգավորումներն օգտագործելու համար ցուցակից ընտրեք <emph>Օգտագործեք օբյեկտի "
"գերադասելի կարգավորումները </emph>:</ahelp>"

#: 05060900.xhp#par_id3150689.34.help.text
#: 05060900.xhp%23par_id3150689.34.help.text
msgid ""
"<link href=\"text/shared/01/05040200.xhp\" name=\"Text direction\">Text "
"direction</link>."
msgstr ""
"<link href=\"text/shared/01/05040200.xhp\" name=\"Տեքստի ուղղություն\">"
"Տեքստի ուղղություն</link>։"

#: 05040800.xhp#tit.help.text
#: 05040800.xhp%23tit.help.text
msgid "Text Grid"
msgstr "Տեքստային ցանց"

#: 05040800.xhp#bm_id3150760.help.text
#: 05040800.xhp%23bm_id3150760.help.text
msgid "<bookmark_value>text grid for Asian layout</bookmark_value>"
msgstr ""
"<bookmark_value>տեքստային ցանցը ասիական դասավորության համար</bookmark_value>"

#: 05040800.xhp#hd_id3150760.18.help.text
#: 05040800.xhp%23hd_id3150760.18.help.text
msgid ""
"<link href=\"text/swriter/01/05040800.xhp\" name=\"Text Grid\">Text "
"Grid</link>"
msgstr ""
"<link href=\"text/swriter/01/05040800.xhp\" name=\"Տեքստային ցանց\">"
"Տեքստային ցանց</link>"

#: 05040800.xhp#par_id3151171.17.help.text
#: 05040800.xhp%23par_id3151171.17.help.text
msgid ""
"<ahelp hid=\".\">Adds a text grid to the current page style. This option is "
"only available if Asian language support is enabled under <emph>Language "
"Settings - Languages</emph> in the Options dialog box.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Էջի ներկայիս ոճին ավելացնում է տեքստային ցանց: Այս "
"տարբերակը հասանելի է միայն այն դեպքում, եթե ասիական լեզվի աջակցությունը "
"միացված է <emph>Լեզվի կարգավորումներ - Լեզուներ</emph> Ընտրանքների "
"երկխոսության վանդակում:</ahelp>"

#: 05040800.xhp#hd_id3154101.16.help.text
#: 05040800.xhp%23hd_id3154101.16.help.text
msgid "Grid"
msgstr "Ցանց"

#: 05040800.xhp#par_id3149805.15.help.text
#: 05040800.xhp%23par_id3149805.15.help.text
msgid ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_TEXTGRID_PAGE_RB_CHARSGRID\">Adds or removes "
"a text grid for lines or characters to the current page style.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_TEXTGRID_PAGE_RB_CHARSGRID\">Ընթացիկ էջի ոճին "
"ավելացնում կամ հեռացնում է տողերի կամ նիշերի տեքստային ցանց:</ahelp>"

#: 05040800.xhp#hd_id3153537.14.help.text
#: 05040800.xhp%23hd_id3153537.14.help.text
msgid "Grid layout"
msgstr "Ցանցի դասավորություն"

#: 05040800.xhp#hd_id3154478.12.help.text
