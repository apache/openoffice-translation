msgid "(Arrow Buttons)"
msgstr "(Սլաք կոճակներ)"

#: mm_cusaddfie.xhp#par_idN10590.help.text
#: mm_cusaddfie.xhp%23par_idN10590.help.text
msgctxt "mm_cusaddfie.xhp#par_idN10590.help.text"
msgid ""
"<ahelp hid=\".\">Select an item in the list and click an arrow button to "
"move the item.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք նյութը ցուցակում և կտտացրեք սլաքի կոճակին, նյութը "
"տեղափոխելու համար:</ahelp>"

#: 04190000.xhp#tit.help.text
#: 04190000.xhp%23tit.help.text
msgctxt "04190000.xhp#tit.help.text"
msgid "Insert (File)"
msgstr "Տեղադրել (Նիշք)"

#: 04190000.xhp#hd_id3147562.1.help.text
#: 04190000.xhp%23hd_id3147562.1.help.text
msgctxt "04190000.xhp#hd_id3147562.1.help.text"
msgid "Insert (File)"
msgstr "Տեղադրել (Նիշք)"

#: 04190000.xhp#par_id3145411.2.help.text
#: 04190000.xhp%23par_id3145411.2.help.text
msgid ""
"<variable id=\"datei\"><ahelp hid=\".uno:InsertDoc\">Inserts a text file at "
"the current cursor position.</ahelp></variable>"
msgstr ""
"<variable id=\"datei\"><ahelp hid=\".uno:InsertDoc\">Տեղադրում է տեքստային "
"նիշքը կուրսորի ընթացիկ դիրքում:</ahelp></variable>"

#: 04190000.xhp#par_idN105BD.help.text
#: 04190000.xhp%23par_idN105BD.help.text
msgid ""
"To always have the latest version of the contents of a file, insert a "
"section into your document, and then insert a link to the text file in the "
"section. See <link href=\"text/swriter/01/04020100.xhp\">insert a "
"section</link> for details."
msgstr ""
"Նիշքի պարունակության վերջին տարբերակը միշտ ունենալու համար, տեղադրեք բաժինը "
"ձեր փաստաթղթում, ապա բաժնից տեղադրեք հղում տեքստային նիշքին: Տե՛ս <link href="
"\"text/swriter/01/04020100.xhp\">տեղադրեք բաժին</link> մանրամասների համար։"

#: 05190000.xhp#tit.help.text
#: 05190000.xhp%23tit.help.text
msgid "Split Table"
msgstr "Բաժանեք աղյուսակը"

#: 05190000.xhp#bm_id3153246.help.text
#: 05190000.xhp%23bm_id3153246.help.text
msgid ""
"<bookmark_value>tables; splitting</bookmark_value><bookmark_value>splitting "
"tables; at cursor position</bookmark_value><bookmark_value>dividing "
"tables</bookmark_value>"
msgstr ""
"<bookmark_value>աղյուսակներ; պառակտում</bookmark_value><bookmark_value>"
"աղյուսակների պառակտում; կուրսորի դիրքում</bookmark_value><bookmark_value>"
"աղյուսակների բաժանում</bookmark_value>"

#: 05190000.xhp#hd_id3153246.1.help.text
#: 05190000.xhp%23hd_id3153246.1.help.text
msgid ""
"<link href=\"text/swriter/01/05190000.xhp\" name=\"Split Table\">Split "
"Table</link>"
msgstr ""
"<link href=\"text/swriter/01/05190000.xhp\" name=\"Պառակտեք աղյուսակը\">"
"Պառակտեք աղյուսակը</link>"

#: 05190000.xhp#par_id3083450.2.help.text
#: 05190000.xhp%23par_id3083450.2.help.text
msgid ""
"<ahelp hid=\".uno:SplitTable\">Splits the current table into two separate "
"tables at the cursor position.</ahelp> You can also access this command by "
"right-clicking in a table cell."
msgstr ""
"<ahelp hid=\".uno:SplitTable\">Ընթացիկ աղյուսակը կուրսորի դիրքում պառակտում "
"է երկու առանձին աղյուսակների:</ahelp> Այս հրամանին կարող եք մուտք գործել նաև "
"աղյուսակի վանդակում աջ կտտացնելով:"

#: 05190000.xhp#hd_id3149351.3.help.text
#: 05190000.xhp%23hd_id3149351.3.help.text
msgid "Mode"
msgstr "Վիճակ"

#: 05190000.xhp#hd_id3154554.5.help.text
#: 05190000.xhp%23hd_id3154554.5.help.text
msgid "Copy heading"
msgstr "Պատճենեք գլխագիրը"

#: 05190000.xhp#par_id3154503.6.help.text
#: 05190000.xhp%23par_id3154503.6.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SPLIT_TABLE:RB_CNTNT\">Includes the first "
"row of the original table as the first row of the second table.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SPLIT_TABLE:RB_CNTNT\">Ներառում է բնօրինակ "
"աղյուսակի առաջին շարքը որպես երկրորդ աղյուսակի առաջին շարքը:</ahelp>"

#: 05190000.xhp#hd_id3149880.7.help.text
#: 05190000.xhp%23hd_id3149880.7.help.text
msgid "Custom heading (apply style)"
msgstr "Անհատականացված գլխագիր (կիրառել ոճը)"

#: 05190000.xhp#par_id3148389.8.help.text
#: 05190000.xhp%23par_id3148389.8.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SPLIT_TABLE:RB_BOX_PARA\">Inserts a blank "
"header row in the second table that is formatted with the style of the first "
"row in the original table.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SPLIT_TABLE:RB_BOX_PARA\">Երկրորդ "
"աղյուսակում տեղադրում է գլխագրի դատարկ տողը, որը ձևաչափված է սկզբնական "
"աղյուսակի առաջին տողի ոճով:</ahelp>"

#: 05190000.xhp#hd_id3150568.9.help.text
#: 05190000.xhp%23hd_id3150568.9.help.text
msgid "Custom heading"
msgstr "Անհատականացված գլխագիր"

#: 05190000.xhp#par_id3149027.10.help.text
#: 05190000.xhp%23par_id3149027.10.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SPLIT_TABLE:RB_BOX_NOPARA\">Inserts an "
"additional blank row in the second table.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SPLIT_TABLE:RB_BOX_NOPARA\">Երկրորդ "
"աղյուսակում տեղադրում է լրացուցիչ դատարկ տող:</ahelp>"

#: 05190000.xhp#hd_id3153720.11.help.text
#: 05190000.xhp%23hd_id3153720.11.help.text
msgid "No heading"
msgstr "Չկա գլխագիր"

#: 05190000.xhp#par_id3156318.12.help.text
#: 05190000.xhp%23par_id3156318.12.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SPLIT_TABLE:RB_BORDER\">Splits the table "
"without copying the header row.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SPLIT_TABLE:RB_BORDER\">Պառակտում է "
"աղյուսակը, առանց պատճենելու գլխագիրը:</ahelp>"

#: 05190000.xhp#par_id3145411.13.help.text
#: 05190000.xhp%23par_id3145411.13.help.text
msgid ""
"When you split a table that contains formulas, the formulas may be affected."
msgstr ""
"Երբ բանաձեւեր պարունակող աղյուսակ եք պառակտում, բանաձևերը կարող են վնասվել:"

#: 04090006.xhp#tit.help.text
#: 04090006.xhp%23tit.help.text
msgctxt "04090006.xhp#tit.help.text"
msgid "Database"
msgstr "Շտեմարան"

#: 04090006.xhp#hd_id3153536.1.help.text
#: 04090006.xhp%23hd_id3153536.1.help.text
msgid ""
"<link href=\"text/swriter/01/04090006.xhp\" name=\"Database\">Database</link>"
msgstr ""
"<link href=\"text/swriter/01/04090006.xhp\" name=\"Շտեմարան\">Շտեմարան</link>"

#: 04090006.xhp#par_id3154471.2.help.text
#: 04090006.xhp%23par_id3154471.2.help.text
msgid ""
"You can insert fields from any database, for example, address fields, into "
"your document."
msgstr ""
"Տվյալների ցանկացած շտեմարանից կարող եք տեղադրել դաշտեր, օրինակ` հասցեի "
"դաշտերը, ձեր փաստաթղթի մեջ:"

#: 04090006.xhp#par_id090220080439090.help.text
#: 04090006.xhp%23par_id090220080439090.help.text
msgctxt "04090006.xhp#par_id090220080439090.help.text"
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Lists the available field types. To "
"add a field to your document, click a field type, click a field in the <emph>"
"Select </emph>list, and then click <emph>Insert</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Թվարկում է դաշտերի մատչելի տեսակները: "
"Ձեր փաստաթղթին դաշտ ավելացնելու համար կտտացրեք դաշտի տեսակին, սեղմեք դաշտը "
"<emph>Ընտրել </emph> ցուցակում և այնուհետև կտտացրեք "
"<emph>Տեղադրել</emph>:</ahelp>"

#: 04090006.xhp#par_id3154196.3.help.text
#: 04090006.xhp%23par_id3154196.3.help.text
msgid "Field type"
msgstr "Դաշտի տեսակ"

#: 04090006.xhp#par_id3149484.4.help.text
#: 04090006.xhp%23par_id3149484.4.help.text
msgctxt "04090006.xhp#par_id3149484.4.help.text"
msgid "Meaning"
msgstr "Իմաստ"

#: 04090006.xhp#par_id3149096.5.help.text
#: 04090006.xhp%23par_id3149096.5.help.text
msgid "Any Record"
msgstr "Որևէ գրառում"

#: 04090006.xhp#par_id3151257.6.help.text
#: 04090006.xhp%23par_id3151257.6.help.text
msgid ""
"Inserts the contents of the database field that you specify in the <emph>"
"Record Number</emph> box as a mail merge field if the <link href=\""
"text/swriter/01/04090200.xhp\" name=\"Condition\""
"><emph>Condition</emph></link> that you enter is met. Only records selected "
"by a multiple selection in the data source view are considered."
msgstr ""
"Տեղադրում է տվյալների շտեմարանի դաշտի պարունակությունը, որը դուք նշում եք "
"<emph>Գրառման թիվ</emph> վանդակում որպես փոստի միաձուլման դաշտ, եթե <link "
"href=\"text/swriter/01/04090200.xhp\" name=\"Պայման\""
"><emph>Պայման</emph></link> որը մուտք եք արել, բավարարվում է։ Դիտարկվում են "
"միայն տվյալների աղբյուրի տեսադաշտում բազմակի ընտրությամբ նշված գրառումները:"

#: 04090006.xhp#par_id3147100.7.help.text
#: 04090006.xhp%23par_id3147100.7.help.text
msgid ""
"You can use this field to insert several records into a document. Simply "
"insert the <emph>Any Record</emph> field in front of the form letter fields "
"that use a certain record."
msgstr ""
"Այս դաշտը կարող եք օգտագործել փաստաթղթում մի քանի գրառում տեղադրելու համար: "
"Պարզապես տեղադրեք <emph>Որևէ գրառում</emph> դաշտը ձևաթղթի դաշտերի դիմաց, "
"որոնք օգտագործում են որոշակի գրառում:"

#: 04090006.xhp#par_id3153632.8.help.text
#: 04090006.xhp%23par_id3153632.8.help.text
msgid "Database Name"
msgstr "Շտեմարանի անուն"

#: 04090006.xhp#par_id3152776.9.help.text
#: 04090006.xhp%23par_id3152776.9.help.text
msgid ""
"Inserts the name of the database table selected in the <emph>Database "
"selection </emph>box. The \"Database Name\" field is a global field, that "
"is, if you insert a different database name in your document, the contents "
"of all previously inserted \"Database Name\" fields are updated."
msgstr ""
"Տեղադրում է տվյալների շտեմարանի աղյուսակի անունը, որն ընտրված է <emph>"
"Շտեմարանի ընտրություն</emph> վանդակում: «Տվյալների շտեմարանի անուն» դաշտը "
"համընդհանուր դաշտ է, այսինքն, եթե ձեր փաստաթղթում տվյալների այլ շտեմարանի "
"անուն եք տեղադրում, նախկինում տեղադրված «Տվյալների շտեմարանի անուն» դաշտերի "
"բովանդակությունը թարմացվում է:"

#: 04090006.xhp#par_id3149167.15.help.text
#: 04090006.xhp%23par_id3149167.15.help.text
msgid "Mail merge field"
msgstr "Փոստի միաձուլման դաշտ"

#: 04090006.xhp#par_id3145779.16.help.text
#: 04090006.xhp%23par_id3145779.16.help.text
msgid ""
"Inserts the name of a database field as a placeholder, so that you can "
"create a mail merge document. The field content is automatically inserted "
"when you print the form letter."
msgstr ""
"Տեղադրում է տվյալների շտեմարանի դաշտի անունը որպես տեղապահ, այնպես որ կարող "
"եք ստեղծել փոստի միաձուլման փաստաթուղթ: Դաշտի բովանդակությունը ինքնաշխատ "
"կերպով տեղադրվում է ձևի նամակը տպելիս:"

#: 04090006.xhp#par_id3151372.12.help.text
#: 04090006.xhp%23par_id3151372.12.help.text
msgid "Next record"
msgstr "Հաջորդ գրառում"

#: 04090006.xhp#par_id3150114.13.help.text
#: 04090006.xhp%23par_id3150114.13.help.text
msgid ""
"Inserts the contents of the next mail merge field in your document, if the "
"condition that you define is met. The records that you want to include must "
"be selected in the data source view."
msgstr ""
"Եթե ձեր սահմանած պայմանը բավարարված է, ձեր փաստաթղթում տեղադրվում է փոստի "
"միաձուլման հաջորդ դաշտի բովանդակությունը: Գրառումները, որոնք ցանկանում եք "
"ներառել, պետք է ընտրվեն տվյալների աղբյուրի տեսքում:"

#: 04090006.xhp#par_id3155861.14.help.text
#: 04090006.xhp%23par_id3155861.14.help.text
msgid ""
"You can use the \"Next record\" field to insert the contents of consecutive "
"records between the mail merge fields in a document."
msgstr ""
"Կարող եք օգտագործել «Հաջորդ գրառումը» դաշտը` փաստաթղթում փոստի միաձուլման "
"դաշտերի միջև անընդմեջ գրառումների բովանդակությունը տեղադրելու համար:"

#: 04090006.xhp#par_id3147412.10.help.text
#: 04090006.xhp%23par_id3147412.10.help.text
msgctxt "04090006.xhp#par_id3147412.10.help.text"
msgid "Record number"
msgstr "Գրառման թիվ"

#: 04090006.xhp#par_id3147495.11.help.text
#: 04090006.xhp%23par_id3147495.11.help.text
msgid "Inserts the number of the selected database record."
msgstr "Տեղադրում է տվյալների ընտրված շտեմարանի գրառման թիվը:"

#: 04090006.xhp#hd_id3149565.17.help.text
#: 04090006.xhp%23hd_id3149565.17.help.text
msgid "Database Selection"
msgstr "Շտեմարանի ընտրություն"

#: 04090006.xhp#par_id3145268.18.help.text
#: 04090006.xhp%23par_id3145268.18.help.text
msgid ""
"<ahelp hid=\"HID_DB_SELECTION_TLB\">Select the database table or the "
"database query that you want the field to refer to.</ahelp> You can include "
"fields from more than one database or query in a document."
msgstr ""
"<ahelp hid=\"HID_DB_SELECTION_TLB\">Ընտրեք տվյալների շտեմարանի աղյուսակը կամ "
"տվյալների շտեմարանի հարցումը, որին ցանկանում եք որ վկայակոչի դաշտը:</ahelp> "
"Փաստաթղթում կարող եք դաշտեր ներառել տվյալների մեկից ավելի շտեմարաններից կամ "
"հարցումներից:"

#: 04090006.xhp#par_id0902200804391084.help.text
#: 04090006.xhp%23par_id0902200804391084.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">For fields linked to a condition, "
"enter the criteria here.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Պայմանի հետ կապված դաշտերի համար "
"այստեղ մուտքագրեք չափանիշները:</ahelp>"

#: 04090006.xhp#par_id3147739.19.help.text
#: 04090006.xhp%23par_id3147739.19.help.text
msgid ""
"If you want, you can assign a condition that must be met before the contents "
"of the \"Any Record\" and \"Next Record\" fields are inserted. The default "
"condition is \"True\", that is, the condition is always true if you do not "
"change the condition text."
msgstr ""
"Եթե ցանկանում եք, կարող եք նշանակել պայման, որը պետք է բավարարվի նախքան «"
"Ցանկացած գրառում» և «Հաջորդ գրառում» դաշտերի բովանդակությունները տեղադրելը: "
"Լռելյայն պայմանը \"True\" է, այսինքն՝ պայմանը միշտ ճիշտ է, եթե պայմանի "
"տեքստը չփոխես:"

#: 04090006.xhp#hd_id3146336.20.help.text
#: 04090006.xhp%23hd_id3146336.20.help.text
msgctxt "04090006.xhp#hd_id3146336.20.help.text"
msgid "Record number"
msgstr "Գրառման թիվ"

#: 04090006.xhp#par_id3149836.21.help.text
#: 04090006.xhp%23par_id3149836.21.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_FLD_DB:ED_DBSETNUMBER\">Enter the number of the "
"record that you want to insert when the condition that you specify is "
"met.</ahelp> The record number corresponds to the current selection in the "
"data source view. For example, if you select the last 5 records in a "
"database containing 10 records, the number of the first record will be 1, "
"and not 6."
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_FLD_DB:ED_DBSETNUMBER\">Մուտքագրեք գրառման այն թիվը, "
"որը ցանկանում եք տեղադրել, երբ ձեր նշած պայմանը կատարվի:</ahelp> Գրառման "
"թիվը համապատասխանում է տվյալների աղբյուրի տեսքից ընթացիկ ընտրությանը: "
"Օրինակ, եթե 10 գրառում պարունակող շտեմարանում ընտրեք վերջին 5 գրառումները, "
"ապա առաջին գրառման թիվը կլինի 1, և ոչ թե 6:"

#: 04090006.xhp#par_id3153305.22.help.text
#: 04090006.xhp%23par_id3153305.22.help.text
msgid ""
"If you refer to fields in a different database (or in a different table or "
"query within the same database), $[officename] determines the record number "
"relative to the current selection."
msgstr ""
"Եթե դուք վկայակոչում եք տվյալների շտեմարանի այլ դաշտերին (կամ տվյալների "
"նույն շտեմարանի ներսում գտնվող այլ աղյուսակների կամ հարցումների), "
"$[officename] -ը որոշում է գրառման թիվը համեմատած ընթացիկ ընտրության հետ:"

#: 04090006.xhp#hd_id3156109.23.help.text
#: 04090006.xhp%23hd_id3156109.23.help.text
msgctxt "04090006.xhp#hd_id3156109.23.help.text"
msgid "Format"
msgstr "Ձևաչափ"

#: 04090006.xhp#par_id3156122.24.help.text
#: 04090006.xhp%23par_id3156122.24.help.text
msgid ""
"<ahelp hid=\".\">Select the format of the field that you want to insert. "
"This option is available for numerical, boolean, date and time "
"fields.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք դաշտի ձևաչափը, որը ցանկանում եք տեղադրել: Այս "
"տարբերակը հասանելի է թվային, բուլյան, ամսաթվի և ժամի դաշտերի համար:</ahelp>"

#: 04090006.xhp#hd_id3150904.25.help.text
#: 04090006.xhp%23hd_id3150904.25.help.text
msgid "From database"
msgstr "Շտեմարանից"

#: 04090006.xhp#par_id3150922.26.help.text
#: 04090006.xhp%23par_id3150922.26.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FLD_DB:RB_DBOWNFORMAT\">Uses the format "
"defined in the selected database.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FLD_DB:RB_DBOWNFORMAT\">Օգտագործում է ընտրված "
"շտեմարանում սահմանված ձևաչափը:</ahelp>"

#: 04090006.xhp#par_idN1076E.help.text
#: 04090006.xhp%23par_idN1076E.help.text
msgctxt "04090006.xhp#par_idN1076E.help.text"
msgid "Browse"
msgstr "Զննել"

#: 04090006.xhp#par_idN10772.help.text
#: 04090006.xhp%23par_idN10772.help.text
msgid ""
"<ahelp hid=\"878711313\">Opens a file open dialog where you can select a "
"database file (*.odb). The selected file is added to the Databases Selection "
"list.</ahelp>"
msgstr ""
"<ahelp hid=\"878711313\">Բացում է նիշքը բացելու երկխոսությունը, որտեղ կարող "
"եք ընտրել տվյալների շտեմարանի նիշքը (*.odb): Ընտրված նիշքը ավելացվում է "
"տվյալների շտեմարանների ընտրության ցուցակում:</ahelp>"

#: 04090006.xhp#hd_id3155084.27.help.text
#: 04090006.xhp%23hd_id3155084.27.help.text
msgid "User defined"
msgstr "Օգտվողի սահմանած"

#: 04090006.xhp#par_id3154333.28.help.text
#: 04090006.xhp%23par_id3154333.28.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FLD_DB:RB_DBFORMAT\">Applies the format that "
"you select in the <emph>List of user-defined formats</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FLD_DB:RB_DBFORMAT\">Կիրառում է այն ձևաչափը, "
"որը ընտրում եք <emph>Օգտագործողի կողմից սահմանված ձևաչափերի "
"ցուցակում</emph>։</ahelp>"

#: 04090006.xhp#hd_id3146948.29.help.text
#: 04090006.xhp%23hd_id3146948.29.help.text
msgid "List of user-defined formats"
msgstr "Օգտագործողի կողմից սահմանված ձևաչափերի ցուցակ"

#: 04090006.xhp#par_id3150093.30.help.text
#: 04090006.xhp%23par_id3150093.30.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_FLD_DB:LB_DBFORMAT\">Lists the available user-"
"defined formats.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_FLD_DB:LB_DBFORMAT\">Թվարկում է օգտագործողի "
"կողմից սահմանված մատչելի ձևաչափերը:</ahelp>"

#: 04090006.xhp#par_idN107FF.help.text
#: 04090006.xhp%23par_idN107FF.help.text
msgid "Printing a form letter"
msgstr "Ձևաչափային նամակի տպում"

#: 04090006.xhp#par_idN10803.help.text
#: 04090006.xhp%23par_idN10803.help.text
msgid ""
"<ahelp hid=\".\">When you print a document that contains database fields, a "
"dialog asks you if you want to print a form letter. If you answer Yes, the <"
"link href=\"text/swriter/01/01150000.xhp\">Mail Merge</link> dialog opens "
"where you can select the database records to print.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Երբ շտեմարանի դաշտեր պարունակող փաստաթուղթ եք տպում, "
"երկխոսությունը հարցնում է ձեզ, արդյոք ցանկանում եք տպել ձևաթուղթ: Եթե "
"պատասխանեք Այո, ապա բացվում է <link href=\"text/swriter/01/01150000.xhp\">"
"Փոստի միաձուլում</link> երկխոսությունը, որտեղ կարող եք ընտրել տվյալների "
"շտեմարանի գրառումները տպելու համար:</ahelp>"

#: 04090006.xhp#par_idN10812.help.text
#: 04090006.xhp%23par_idN10812.help.text
msgid "Do not show warning again"
msgstr "Մի ցույց տուր զգուշացումը նորից։"

#: 04090006.xhp#par_idN10816.help.text
#: 04090006.xhp%23par_idN10816.help.text
msgid ""
"<ahelp hid=\".\">Suppresses this dialog from now on. There is no easy way to "
"get it back!</ahelp>"
msgstr ""
"<ahelp hid=\".\">Այսուհետ ճնշում է այս երկխոսությունը: Այն վերադարձնելու "
"հեշտ միջոց չկա:</ahelp>"

#: 05040000.xhp#tit.help.text
#: 05040000.xhp%23tit.help.text
msgctxt "05040000.xhp#tit.help.text"
msgid "Page Style"
msgstr "Էջի ոճը"

#: 05040000.xhp#hd_id3150016.1.help.text
#: 05040000.xhp%23hd_id3150016.1.help.text
msgctxt "05040000.xhp#hd_id3150016.1.help.text"
msgid "Page Style"
msgstr "Էջի ոճը"

#: 05040000.xhp#par_id3148774.2.help.text
#: 05040000.xhp%23par_id3148774.2.help.text
msgid ""
"<variable id=\"seitetext\"><ahelp hid=\".uno:PageDialog\">Specify the "
"formatting styles and the layout for the current page style, including page "
"margins, headers and footers, and the page background.</ahelp></variable>"
msgstr ""
"<variable id=\"seitetext\"><ahelp hid=\".uno:PageDialog\">Նշեք ընթացիկ էջի "
"ոճի ձևաչափման ձևը և դասավորությունը, ներառյալ էջի լուսանցքները, գլխագրերը և "
"էջատակերը և էջի ֆոնը:</ahelp></variable>"

#: 03090000.xhp#tit.help.text
#: 03090000.xhp%23tit.help.text
msgctxt "03090000.xhp#tit.help.text"
msgid "Fields"
msgstr "Դաշտեր"

#: 03090000.xhp#hd_id3154505.1.help.text
#: 03090000.xhp%23hd_id3154505.1.help.text
msgid ""
"<link href=\"text/swriter/01/03090000.xhp\" name=\"Fields\">Field "
"Names</link>"
msgstr ""
"<link href=\"text/swriter/01/03090000.xhp\" name=\"Դաշտեր\">Դաշտերի "
"անուններ</link>"

#: 03090000.xhp#par_id3147171.2.help.text
#: 03090000.xhp%23par_id3147171.2.help.text
msgid ""
"<ahelp hid=\".uno:Fieldnames\">Switches the field display between field "
"names and field contents.</ahelp> A check mark indicates that the field "
"names are displayed, and no check mark indicates that field contents are "
"displayed. Some field contents cannot be displayed."
msgstr ""
"<ahelp hid=\".uno:Fieldnames\">Դաշտի ցուցադրումը փոխում է դաշտի անունների և "
"դաշտի բովանդակության միջև:</ahelp> Ստուգման նշանը ցույց է տալիս, որ դաշտի "
"անունները ցուցադրվում են, և ստուգման նշանի բացակայությունը նշում, որ դաշտի "
"պարունակությունն է ցուցադրվում: Դաշտի որոշ բովանդակությունը հնարավոր չէ "
"ցուցադրել:"

#: 03090000.xhp#par_id3149287.4.help.text
#: 03090000.xhp%23par_id3149287.4.help.text
msgid ""
"To change the default field display to field names instead of the field "
"contents, choose <emph><switchinline select=\"sys\"><caseinline select=\""
"MAC\">%PRODUCTNAME - Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - %PRODUCTNAME Writer - View</emph>, "
"and then select the<emph> Field codes </emph>checkbox in the "
"<emph>Display</emph> area."
msgstr ""
"Դաշտի պարունակության լռելյայն ցուցադրումը դաշտի բովանդակության փոխարեն դաշտի "
"անուններով փոխելու համար ընտրեք <emph><switchinline select=\"sys\"><"
"caseinline select=\"MAC\">%PRODUCTNAME - "
"Նախապատվություններ</caseinline><defaultinline>Գործիքներ - "
"Ընտրանքներ</defaultinline></switchinline> - %PRODUCTNAME Writer - Տեսք</emph>"
", և ապա նշեք<emph> Դաշտերի կոդեր </emph>ընտրավանդակը <emph>Արտածում</emph> "
"տարածքում։"

#: 03090000.xhp#par_id3154098.5.help.text
#: 03090000.xhp%23par_id3154098.5.help.text
msgid ""
"When you print a document with <emph>View - Field Names</emph> enabled, you "
"are prompted to include the field names in the print out."
msgstr ""
"Երբ <emph>Դիտում - Դաշտերի անուններ</emph> օգնությամբ փաստաթուղթ եք տպում, "
"ձեզ հուշում են, որ դաշտերի անունները ներառեք տպման մեջ:"

#: 03090000.xhp#par_id3145579.3.help.text
#: 03090000.xhp%23par_id3145579.3.help.text
msgid ""
"<link href=\"text/swriter/01/04090000.xhp\" name=\"Insert - Fields\">Insert -"
" Fields</link>."
msgstr ""
"<link href=\"text/swriter/01/04090000.xhp\" name=\"Տեղադրեք - Դաշտեր\">"
"Տեղադրեք - Դաշտեր</link>."

#: 05150200.xhp#tit.help.text
#: 05150200.xhp%23tit.help.text
msgctxt "05150200.xhp#tit.help.text"
msgid "Apply"
msgstr "Կիրառել"

#: 05150200.xhp#bm_id5028839.help.text
#: 05150200.xhp%23bm_id5028839.help.text
msgid "<bookmark_value>automatic heading formatting</bookmark_value>"
msgstr "<bookmark_value>գլխագրի ինքնաշխատ ձևաչափում</bookmark_value>"

#: 05150200.xhp#bm_id.help.text
#: 05150200.xhp%23bm_id.help.text
msgid ""
"<bookmark_value>AutoCorrect function;headings</bookmark_value>         "
"<bookmark_value>headings;automatic</bookmark_value>         <bookmark_value>"
"separator lines;AutoCorrect function</bookmark_value>"
msgstr ""
"<bookmark_value>Ինքնաշտկում գործառույթ;գլխագրեր</bookmark_value>         "
"<bookmark_value>գլխագրեր;ինքնաշխատ</bookmark_value>         <bookmark_value>"
"բաժանաարար գծեր;Ինքնաշտկում գործառույթ</bookmark_value>"

#: 05150200.xhp#hd_id3155962.1.help.text
#: 05150200.xhp%23hd_id3155962.1.help.text
msgid "<link href=\"text/swriter/01/05150200.xhp\" name=\"Apply\">Apply</link>"
msgstr ""
"<link href=\"text/swriter/01/05150200.xhp\" name=\"Կիրառել\">Կիրառել</link>"

#: 05150200.xhp#par_id3149871.2.help.text
#: 05150200.xhp%23par_id3149871.2.help.text
msgid ""
"<ahelp hid=\".uno:AutoFormatApply\">Automatically formats the file according "
"to the options that you set under <emph>Tools - AutoCorrect</emph>"
"            <emph>Options</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:AutoFormatApply\">Ինքնաշխատ կերպով ձևաչափում է նիշքը, "
"համաձայն ձեր կարգաբերած տարբերակների <emph> Գործիքներ - Ինքնաշխատ</emph>"
"            <emph>Ընտրանքներ</emph>։</ahelp>"

#: 05150200.xhp#par_id3147404.15.help.text
#: 05150200.xhp%23par_id3147404.15.help.text
msgid "When you apply automatic formats, the following rules apply:"
msgstr "Ինքնաշխատ ձևաչափեր կիրառելիս գործում են հետևյալ կանոնները."

#: 05150200.xhp#hd_id3155625.3.help.text
#: 05150200.xhp%23hd_id3155625.3.help.text
msgid "AutoCorrect for Headings"
msgstr "Ինքնաշտկում գլխագրերի համար"

#: 05150200.xhp#par_id3154505.4.help.text
#: 05150200.xhp%23par_id3154505.4.help.text
msgid ""
"A paragraph is formatted as a heading when the following conditions are met:"
msgstr ""
"Հետևյալ պայմանները բավարարելու դեպքում պարբերությունը ձևաչափվում է որպես "
"գլխագիր:"

#: 05150200.xhp#par_id3145241.19.help.text
#: 05150200.xhp%23par_id3145241.19.help.text
msgid "paragraph begins with a capital letter"
msgstr "պարբերությունը սկսվում է մեծատառով"

#: 05150200.xhp#par_id3148386.20.help.text
#: 05150200.xhp%23par_id3148386.20.help.text
msgid "paragraph does not end with a punctuation mark"
msgstr "պարբերությունը չի ավարտվում կետադրական նշանով"

#: 05150200.xhp#par_id3150564.21.help.text
#: 05150200.xhp%23par_id3150564.21.help.text
msgid "empty paragraph above and below the paragraph"
msgstr "պարբերության վերևում և ներքևում գտնվող դատարկ պարբերություն"

#: 05150200.xhp#hd_id3149030.8.help.text
#: 05150200.xhp%23hd_id3149030.8.help.text
msgid "AutoCorrect for Bullets / Numbering"
msgstr "Ինքնաշտկում նշիկների / թվագրման համար"

#: 05150200.xhp#par_id3156316.9.help.text
#: 05150200.xhp%23par_id3156316.9.help.text
msgid ""
"To create a bulleted list, type a hyphen (-), star (*), or plus sign (+), "
"followed by a space or tab at the beginning of a paragraph."
msgstr ""
"Նշիկավորված ցուցակ ստեղծելու համար մուտքագրեք գծիկ (-), աստղ (*) կամ "
"գումարած նշան (+), որին հաջորդում է պարբերության սկզբում բացատ կամ ներդիր:"

#: 05150200.xhp#par_id3150763.18.help.text
#: 05150200.xhp%23par_id3150763.18.help.text
msgid ""
"To create a numbered list, type a number followed by a period (.), followed "
"by a space or tab at the beginning of a paragraph. "
msgstr ""
"Թվագրված ցուցակ ստեղծելու համար մուտքագրեք թիվ, որին հաջորդում է կետը (.), "
"որին հաջորդում է բացատը կամ ներդիրը պարբերությունը սկզբում: "

#: 05150200.xhp#par_id3147507.16.help.text
#: 05150200.xhp%23par_id3147507.16.help.text
msgid ""
"Automatic numbering is only applied to paragraphs formatted with the "
"<emph>Standard</emph>, <emph>Text body</emph> or <emph>Text body "
"indent</emph> paragraph styles."
msgstr ""
"Ինքնաշխատ համարակալումը կիրառվում է միայն <emph>Ստանդարտ</emph>, <emph>"
"Տեքստի մարմին</emph> կամ <emph>Տեքստի մարմնի խորացում</emph> պարբերության "
"ոճերով ձևաչափված պարբերությունների վրա:"

#: 05150200.xhp#hd_id3152941.10.help.text
#: 05150200.xhp%23hd_id3152941.10.help.text
msgid "AutoCorrect for Separator Lines"
msgstr "Ինքնաշտկում բաժանարար գծերի համար"

#: 05150200.xhp#par_id3154105.11.help.text
#: 05150200.xhp%23par_id3154105.11.help.text
msgid ""
"If you type three or more hyphens (---), underscores (___) or equal signs "
"(===) on line and then press Enter, the paragraph is replaced by a "
"horizontal line as wide as the page. The line is actually the <link href=\""
"text/shared/01/05030500.xhp\" name=\"lower border\">lower border</link> of "
"the preceding paragraph. The following rules apply:"
msgstr ""
"Եթե տողի վրա մուտքագրեք երեք կամ ավելի տողադարձման գծիկներ (---), "
"ընդգծումներ (___) կամ հավասարի նշաններ (===) և ապա սեղմեք Enter, "
"պարբերությունը փոխարինվում է էջի լայնությամբ հորիզոնական գծով: Գիծը "
"իրականում <link href=\"text/shared/01/05030500.xhp\" name=\"ստորին սահման\">"
"ստորին սահման</link> է նախորդ պարբերության։ Կիրառվում են հետևյալ կանոնները."

#: 05150200.xhp#par_id3153530.12.help.text
#: 05150200.xhp%23par_id3153530.12.help.text
msgid "Three hyphens (-) yield a single line (0.05 pt thick, gap 0.75 mm)."
msgstr ""
"Երեք գծիկը (-) տալիս են մեկ տող (0.05 pt հաստությամբ, բացվածքը 0․75 մմ):"

#: 05150200.xhp#par_id3154477.13.help.text
#: 05150200.xhp%23par_id3154477.13.help.text
msgid "Three underscore (_) yield a single line (1 pt thick, gap 0.75 mm)."
msgstr ""
"Երեք ընդգծումը (_) տալիս են մեկ տող (1 pt հաստությամբ, բացվածքը 0․75 մմ):"

#: 05150200.xhp#par_id3150982.14.help.text
#: 05150200.xhp%23par_id3150982.14.help.text
msgid "Three equal signs (=) yield a double line (1.10 pt thick, gap 0.75 mm)."
msgstr ""
"Հավասարի երեք նշանը (=) տալիս են կրկանկի տող (1․10 pt հաստությամբ, բացվածքը "
"0․75 մմ):"

#: 04120211.xhp#tit.help.text
