msgid "Link"
msgstr "Հղում"

#: 05060300.xhp#par_id3149164.10.help.text
#: 05060300.xhp%23par_id3149164.10.help.text
msgid "Inserts the graphic as a link."
msgstr "Տեղադրում է գրաֆիկը որպես հղում:"

#: 05060300.xhp#hd_id3149178.11.help.text
#: 05060300.xhp%23hd_id3149178.11.help.text
msgctxt "05060300.xhp#hd_id3149178.11.help.text"
msgid "File name"
msgstr "Նիշքի անուն"

#: 05060300.xhp#par_id3156278.12.help.text
#: 05060300.xhp%23par_id3156278.12.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_GRF_EXT:ED_CONNECT\">Displays the path to the linked "
"graphic file. To change the link, click the browse button (<emph>...</emph>) "
"and then locate the file that you want to link to. </ahelp>"
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_GRF_EXT:ED_CONNECT\">Ցուցադրում է ուղին դեպի կապված "
"գրաֆիկական նիշքը: Հղումը փոխելու համար կտտացրեք թերթելու կոճակին "
"(<emph>...</emph>) և այնուհետև գտեք այն նիշքը, որին ցանկանում եք կապել: "
"</ahelp>"

#: 05060300.xhp#hd_id3145776.13.help.text
#: 05060300.xhp%23hd_id3145776.13.help.text
msgctxt "05060300.xhp#hd_id3145776.13.help.text"
msgid "..."
msgstr "..."

#: 05060300.xhp#par_id3151373.14.help.text
#: 05060300.xhp%23par_id3151373.14.help.text
msgid ""
"<ahelp hid=\"SW:PUSHBUTTON:TP_GRF_EXT:PB_BROWSE\">Locate the new graphic "
"file that you want to link to, and then click <emph>Open</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:PUSHBUTTON:TP_GRF_EXT:PB_BROWSE\">Տեղորոշեք գրաֆիկական նոր "
"նիշքը, որին ուզում եք կապել, և այնուհետև կտտացրեք <emph>Բացել</emph>։</ahelp>"

#: 05060300.xhp#par_id3155855.21.help.text
#: 05060300.xhp%23par_id3155855.21.help.text
msgid ""
"<link href=\"text/shared/01/05240000.xhp\" name=\"Format - Flip\">Format - "
"Flip</link>"
msgstr ""
"<link href=\"text/shared/01/05240000.xhp\" name=\"Ձևաչափ - Շրջել\">Ձևաչափ - "
"Շրջել</link>"

#: 05060300.xhp#par_id3158743.22.help.text
#: 05060300.xhp%23par_id3158743.22.help.text
msgid ""
"<link href=\"text/shared/01/02180000.xhp\" name=\"Edit - Links\">Edit - "
"Links</link>"
msgstr ""
"<link href=\"text/shared/01/02180000.xhp\" name=\"Խմբագրել - Հղումներ\">"
"Խմբագրել - Հղումներ</link>"

#: 04010000.xhp#tit.help.text
#: 04010000.xhp%23tit.help.text
msgctxt "04010000.xhp#tit.help.text"
msgid "Insert Manual Break"
msgstr "Տեղադրեք ձեռքով ընդհատում"

#: 04010000.xhp#hd_id3145827.1.help.text
#: 04010000.xhp%23hd_id3145827.1.help.text
msgctxt "04010000.xhp#hd_id3145827.1.help.text"
msgid "Insert Manual Break"
msgstr "Տեղադրեք ձեռքով ընդհատում"

#: 04010000.xhp#par_id3147176.2.help.text
#: 04010000.xhp%23par_id3147176.2.help.text
msgid ""
"<variable id=\"umbruch\"><ahelp hid=\".uno:InsertBreak\">Inserts a manual "
"line break, column break or a page break at the current cursor "
"position.</ahelp></variable>"
msgstr ""
"<variable id=\"umbruch\"><ahelp hid=\".uno:InsertBreak\">Կուրսորի ընթացիկ "
"դիրքում տեղադրում է ձեռքով տողի ընդհատում, սյունակի ընդհատում կամ էջի "
"ընդհատում։</ahelp></variable>"

#: 04010000.xhp#hd_id3151176.4.help.text
#: 04010000.xhp%23hd_id3151176.4.help.text
msgctxt "04010000.xhp#hd_id3151176.4.help.text"
msgid "Type"
msgstr "Տեսակ"

#: 04010000.xhp#par_id3145420.5.help.text
#: 04010000.xhp%23par_id3145420.5.help.text
msgid "Select the type of break that you want to insert."
msgstr "Ընտրեք ընդհատման տեսակը, որը ցանկանում եք տեղադրել:"

#: 04010000.xhp#hd_id3154097.6.help.text
#: 04010000.xhp%23hd_id3154097.6.help.text
msgid "Line Break"
msgstr "Տողի ընդհատում"

#: 04010000.xhp#par_id3149805.7.help.text
#: 04010000.xhp%23par_id3149805.7.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_BREAK:RB_LINE\">Ends the current line, and "
"moves the text found to the right of the cursor to the next line, without "
"creating a new paragraph.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_BREAK:RB_LINE\">Ավարտում է ընթացիկ տողը և "
"կուրսորի աջ կողմում գտնված տեքստը տեղափոխում հաջորդ տող, առանց նոր "
"պարբերություն ստեղծելու:</ahelp>"

#: 04010000.xhp#par_id3149685.8.help.text
#: 04010000.xhp%23par_id3149685.8.help.text
msgid "You can also insert a line break by pressing Shift+Enter."
msgstr "Կարող եք նաև տողի ընդհատում տեղադրել, սեղմելով Shift+Enter."

#: 04010000.xhp#hd_id3148566.9.help.text
#: 04010000.xhp%23hd_id3148566.9.help.text
msgid "Column Break"
msgstr "Սյունակի ընդհատում"

#: 04010000.xhp#par_id3155182.10.help.text
#: 04010000.xhp%23par_id3155182.10.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_BREAK:RB_COL\">Inserts a manual column break "
"(in a multiple column layout), and moves the text found to the right of the "
"cursor to the beginning of the next <link href=\"text/swriter/01/05040500."
"xhp\" name=\"column\">column</link>. A manual column break is indicated by a "
"nonprinting border at the top of the new column.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_BREAK:RB_COL\">Տեղադրում է սյունակի ձեռքով "
"ընդհատում (սյունակի բազմակի դասավորության մեջ) և կուրսորի աջ կողմում գտնված "
"տեքստը տեղափոխում է հաջորդ <link href=\"text/swriter/01/05040500.xhp\" name="
"\"սյունակի\">սյունակի</link> սկիզբ։ Սյունակի ձեռքով ընդհատումը նշվում է "
"առանց տպելու եզրագծի՝ նոր սյունակի վերևում:</ahelp>"

#: 04010000.xhp#hd_id3149487.11.help.text
#: 04010000.xhp%23hd_id3149487.11.help.text
msgid "Page Break"
msgstr "Էջի ընդհատում"

#: 04010000.xhp#par_id3149102.12.help.text
#: 04010000.xhp%23par_id3149102.12.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_BREAK:RB_PAGE\">Inserts a manual page break, "
"and moves the text found to the right of the cursor to the beginning of the "
"next page. The inserted page break is indicated by a nonprinting border at "
"the top of the new page.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_BREAK:RB_PAGE\">Տեղադրում է էջի ձեռքով "
"ընդհատում և կուրսորից աջ հայտնաբերված տեքստը տեղափոխում հաջորդ էջի սկիզբ: "
"Տեղադրված էջի ընդմիջումը նշվում է նոր էջի վերևում առանց տպելու "
"եզրագծի:</ahelp>"

#: 04010000.xhp#par_id3145758.13.help.text
#: 04010000.xhp%23par_id3145758.13.help.text
msgid ""
"You can also insert a page break by pressing <switchinline select=\"sys\"><"
"caseinline select=\"MAC\">Command "
"</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Enter. "
"However, if you want to assign the following page a different Page Style, "
"you must use the menu command to insert the manual page break."
msgstr ""
"Կարող եք նաև էջի ընհատում տեղադրել, սեղմելով <switchinline select=\"sys\"><"
"caseinline select=\"MAC\">Command "
"</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Enter։ "
"Այնուամենայնիվ, եթե ցանկանում եք հետևյալ էջին այլ Էջի Ոճ նշանակել, ապա էջի "
"ընդհատումը ձեռքով տեղադրելու համար պետք է օգտագործեք ընտրացանկի հրամանը:"

#: 04010000.xhp#hd_id3149175.14.help.text
#: 04010000.xhp%23hd_id3149175.14.help.text
msgid "Style"
msgstr "Ոճ"

#: 04010000.xhp#par_id3156275.15.help.text
#: 04010000.xhp%23par_id3156275.15.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:DLG_BREAK:LB_COLL\">Select the page style for the "
"page that follows the manual page break.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:DLG_BREAK:LB_COLL\">Ընտրեք էջի ոճը այն էջի համար, "
"որը հաջորդում է էջի ձեռքով ընդհատմանը:</ahelp>"

#: 04010000.xhp#hd_id3145782.16.help.text
#: 04010000.xhp%23hd_id3145782.16.help.text
msgid "Change page number"
msgstr "Փոխեք էջի թիվը"

#: 04010000.xhp#par_id3155917.17.help.text
#: 04010000.xhp%23par_id3155917.17.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:DLG_BREAK:CB_PAGENUM\">Assigns the page number that "
"you specify to the page that follows the manual page break. This option is "
"only available if you assign a different page style to the page that follows "
"manual page break.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:DLG_BREAK:CB_PAGENUM\">Ձեր կողմից նշված էջի թիվը "
"վերագրում է այն էջին, որը հաջորդում է էջի ձեռքով ընդհատմանը: Այս տարբերակը "
"մատչելի է միայն այն դեպքում, եթե դուք էջի այլ ոճ եք հատկացնում էջին, որը "
"հաջորդում է ձեռքով ընդհատվող էջին:</ahelp>"

#: 04010000.xhp#hd_id3151384.20.help.text
#: 04010000.xhp%23hd_id3151384.20.help.text
msgctxt "04010000.xhp#hd_id3151384.20.help.text"
msgid "Page number"
msgstr "Էջի թիվը"

#: 04010000.xhp#par_id3150700.21.help.text
#: 04010000.xhp%23par_id3150700.21.help.text
msgid ""
"<ahelp hid=\"SW:NUMERICFIELD:DLG_BREAK:ED_PAGENUM\">Enter the new page "
"number for the page that follows the manual page break.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:NUMERICFIELD:DLG_BREAK:ED_PAGENUM\">Մուտքագրեք էջի նոր թիվը "
"այն էջի համար, որը հաջորդում է էջի ձեռքով ընդհատմանը:</ahelp>"

#: 04010000.xhp#par_id3150554.18.help.text
#: 04010000.xhp%23par_id3150554.18.help.text
msgid ""
"To display manual breaks, choose <link href=\"text/swriter/01/03100000.xhp\" "
"name=\"View - Nonprinting Characters\"><emph>View - Nonprinting "
"Characters</emph></link>."
msgstr ""
"Ձեռքով ընդհատումները արտածելու համար, ընտրեք <link href=\""
"text/swriter/01/03100000.xhp\" name=\"Դիտել - Չտպվող նիշեր\"><emph>Դիտել - "
"Չտպվող նիշեր</emph></link>։"

#: 05100000.xhp#tit.help.text
#: 05100000.xhp%23tit.help.text
msgid "Cell"
msgstr "Բջիջ"

#: 05100000.xhp#hd_id3150765.1.help.text
#: 05100000.xhp%23hd_id3150765.1.help.text
msgid "<link href=\"text/swriter/01/05100000.xhp\" name=\"Cell\">Cell</link>"
msgstr "<link href=\"text/swriter/01/05100000.xhp\" name=\"Բջիջ\">Բջիջ</link>"

#: 05100000.xhp#par_id3147567.2.help.text
#: 05100000.xhp%23par_id3147567.2.help.text
msgid ""
"This command is only available if you have selected a table in your "
"document, or if the cursor is in a table cell."
msgstr ""
"Այս հրամանը մատչելի է միայն այն դեպքում, եթե ձեր փաստաթղթում աղյուսակ եք "
"ընտրել, կամ եթե կուրսորը գտնվում է աղյուսակի բջիջում:"

#: mm_copyto.xhp#tit.help.text
#: mm_copyto.xhp%23tit.help.text
msgid "Copies To"
msgstr "Պատճենում է դեպի"

#: mm_copyto.xhp#par_idN10539.help.text
#: mm_copyto.xhp%23par_idN10539.help.text
msgid "Copy To"
msgstr "Պատճենիր դեպի"

#: mm_copyto.xhp#par_idN1053D.help.text
#: mm_copyto.xhp%23par_idN1053D.help.text
msgid ""
"Specify additional e-mail recipients for the <link href=\""
"text/swriter/01/mailmerge08.xhp\">mail merge</link> document."
msgstr ""
"Նշեք լրացուցիչ էլ. Փոստի հասցեատերերին <link href=\""
"text/swriter/01/mailmerge08.xhp\">փոստի միաձուլում</link> փաստաթղթում։"

#: mm_copyto.xhp#par_idN1054E.help.text
#: mm_copyto.xhp%23par_idN1054E.help.text
msgid "CC"
msgstr "CC"

#: mm_copyto.xhp#par_idN10552.help.text
#: mm_copyto.xhp%23par_idN10552.help.text
msgid ""
"<ahelp hid=\".\">Enter the recipients of e-mail copies, separated by a "
"semicolon (;).</ahelp>"
msgstr ""
"<ahelp hid=\".\">Մուտքագրեք էլ. Փոստի պատճենները ստացողներին` բաժանված կետ "
"ստորակետով (;).</ahelp>"

#: mm_copyto.xhp#par_idN10555.help.text
#: mm_copyto.xhp%23par_idN10555.help.text
