msgid "Description"
msgstr "Նկարագրություն"

#: 05130000.xhp#par_id3151172.6.help.text
#: 05130000.xhp%23par_id3151172.6.help.text
msgid "Character Styles "
msgstr "Նիշերի ոճեր"

#: 05130000.xhp#par_id3147512.7.help.text
#: 05130000.xhp%23par_id3147512.7.help.text
msgid ""
"Use Character Styles to format single characters, or entire words and "
"phrases. If you want, you can nest Character Styles."
msgstr ""
"Օգտագործեք Նիշերի ոճերը՝ մեկ նիշ կամ ամբողջ բառերն ու արտահայտությունները "
"ձևավորելու համար: Եթե ցանկանում եք, կարող եք բնադրել Նիշերի ոճերը:"

#: 05130000.xhp#par_id3150713.8.help.text
#: 05130000.xhp%23par_id3150713.8.help.text
msgid "Paragraph Styles "
