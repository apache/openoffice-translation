#: 06060100.xhp#par_id3150018.4.help.text
#: 06060100.xhp%23par_id3150018.4.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_OUTLINE_NUM:LB_LEVEL\">Click the outline level "
"that you want to modify, and then specify the numbering options for the "
"level.</ahelp> To apply the numbering options, except for the paragraph "
"style, to all of the levels, click \"1-10\"."
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_OUTLINE_NUM:LB_LEVEL\">Կտտացրեք ուրվագծի այն "
"մակարդակին, որը ցանկանում եք փոփոխել, և այնուհետև նշեք մակարդակի "
"համարակալման ընտրանքները:</ahelp> Համարակալման ընտրանքները, բացառությամբ "
"պարբերության ոճի, բոլոր մակարդակներում կիրառելու համար կտտացրեք \"1-10\":"

#: 06060100.xhp#hd_id3145248.8.help.text
