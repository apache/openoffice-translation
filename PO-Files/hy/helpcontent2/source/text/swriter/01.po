msgid "Left"
msgstr "Ձախ"

#: 05090100.xhp#par_id3154836.28.help.text
#: 05090100.xhp%23par_id3154836.28.help.text
msgid ""
"<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_LEFT_DIST\">Enter the amount "
"of space that you want to leave between the left page margin and the edge of "
"the table.</ahelp> This option is not available if the <emph>Automatic "
"</emph>or the <emph>Left</emph> option is selected in the "
"<emph>Alignment</emph> area."
msgstr ""
"<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_LEFT_DIST\">Մուտքագրեք "
"միջակայքի այն չափը, որը ցանկանում եք թողնել ձախ էջի լուսանցքի և աղյուսակի "
"եզրի միջև:</ahelp> Այս ընտրանքը հասանելի չէ, եթե <emph>Ինքնաշխատ </emph>կամ "
"<emph>Ձախ</emph> տարբերակն է ընտրված <emph>Հավասարեցում</emph> տարածքում։"

#: 05090100.xhp#hd_id3147094.29.help.text
#: 05090100.xhp%23hd_id3147094.29.help.text
msgctxt "05090100.xhp#hd_id3147094.29.help.text"
msgid "Right"
msgstr "Աջ"

#: 05090100.xhp#par_id3147220.30.help.text
#: 05090100.xhp%23par_id3147220.30.help.text
msgid ""
"<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_RIGHT_DIST\">Enter the amount "
"of space that you want to leave between the right page margin and the edge "
"of the table.</ahelp> This option is not available if the <emph>Automatic "
"</emph>or the <emph>Right</emph> option is selected in the "
"<emph>Alignment</emph> area."
msgstr ""
"<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_RIGHT_DIST\">Մուտքագրեք "
"միջակայքի այն չափը, որը ցանկանում եք թողնել աջ էջի լուսանցքի և աղյուսակի "
"եզրի միջև:</ahelp> Այս ընտրանքը հասանելի չէ, եթե <emph>Ինքնաշխատ </emph>կամ "
"<emph>Աջ</emph> տարբերակն է ընտրված <emph>Հավասարեցում</emph> տարածքում։"

#: 05090100.xhp#hd_id3147576.31.help.text
#: 05090100.xhp%23hd_id3147576.31.help.text
msgid "Above"
msgstr "Վերևում"

#: 05090100.xhp#par_id3152771.32.help.text
#: 05090100.xhp%23par_id3152771.32.help.text
msgid ""
"<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_TOP_DIST\">Enter the amount "
"of space that you want to leave between the top edge of the table and the "
"text above the table.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_TOP_DIST\">Մուտքագրեք "
"միջակայքի այն չափը, որը ցանկանում եք թողնել աղյուսակի վերին եզրի և աղյուսակի "
"վերևում գտնվող տեքստի միջև:</ahelp>"

#: 05090100.xhp#hd_id3155142.33.help.text
#: 05090100.xhp%23hd_id3155142.33.help.text
msgid "Below"
msgstr "Ներքևում"

#: 05090100.xhp#par_id3145763.34.help.text
#: 05090100.xhp%23par_id3145763.34.help.text
msgid ""
"<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_BOTTOM_DIST\">Enter the "
"amount of space that you want to leave between the bottom edge of the table "
"and the text below the table.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_BOTTOM_DIST\">Մուտքագրեք "
"միջակայքի այն չափը, որը ցանկանում եք թողնել աղյուսակի ներքևի եզրի և "
"աղյուսակի ներքևում գտնվող տեքստի միջև:</ahelp>"

#: 05090100.xhp#par_id3145782.35.help.text
#: 05090100.xhp%23par_id3145782.35.help.text
msgid ""
"To insert a paragraph before a table at the beginning of a document, header "
"or footer, place the cursor before any content in the first cell, and then "
"press Enter."
msgstr ""
"Փաստաթղթի, գլխագրի կամ տողատակի սկզբում աղյուսակից առաջ պարբերություն "
"տեղադրելու համար առաջին բջիջում կուրսորը տեղադրեք ցանկացած բովանդակությունից "
"առաջ, ապա սեղմեք Enter:"

#: 05110200.xhp#tit.help.text
#: 05110200.xhp%23tit.help.text
msgctxt "05110200.xhp#tit.help.text"
msgid "Optimal Height"
msgstr "Լավագույն բարձրություն"

#: 05110200.xhp#hd_id3150010.1.help.text
#: 05110200.xhp%23hd_id3150010.1.help.text
msgctxt "05110200.xhp#hd_id3150010.1.help.text"
msgid "Optimal Height"
msgstr "Լավագույն բարձրություն"

#: 05110200.xhp#par_id3147436.2.help.text
#: 05110200.xhp%23par_id3147436.2.help.text
msgid ""
"<variable id=\"zeilenhoehetext\"><ahelp hid=\".uno:SetOptimalRowHeight\" "
"visibility=\"visible\">Automatically adjusts row heights to match the "
"contents of the cells.</ahelp> This is the default setting for new "
"tables.</variable>"
msgstr ""
"<variable id=\"zeilenhoehetext\"><ahelp hid=\".uno:SetOptimalRowHeight\" "
"visibility=\"visible\">Ինքնաշխատ կերպով կարգավորում է տողերի "
"բարձրությունները՝ բջիջների պարունակությանը համապատասխանեցնլու համար:</ahelp> "
"Սա նոր աղյուսակների համար լռելյայն պարամետրն է:</variable>"

#: 05110200.xhp#par_id3154765.3.help.text
#: 05110200.xhp%23par_id3154765.3.help.text
msgid ""
"This option is only available if the table contains a row with a fixed "
"height."
msgstr ""
"Այս տարբերակը հասանելի է միայն այն դեպքում, երբ աղյուսակը պարունակում է "
"հաստատուն բարձրությամբ տող:"

#: 04120201.xhp#tit.help.text
#: 04120201.xhp%23tit.help.text
msgctxt "04120201.xhp#tit.help.text"
msgid "Styles"
msgstr "Ոճեր"

#: 04120201.xhp#hd_id3145825.36.help.text
#: 04120201.xhp%23hd_id3145825.36.help.text
msgid ""
"<link href=\"text/swriter/01/04120201.xhp\" name=\"Styles\">Styles</link>"
msgstr "<link href=\"text/swriter/01/04120201.xhp\" name=\"Ոճեր\">Ոճեր</link>"

#: 04120201.xhp#par_id3154505.37.help.text
#: 04120201.xhp%23par_id3154505.37.help.text
msgid ""
"You can assign different paragraph styles to change the formatting of index "
"titles, separators and index entries. You can also modify paragraph styles "
"in this dialog."
msgstr ""
"Կարող եք նշանակել պարբերության տարբեր ոճեր` ցուցչի վերնագրերի, բաժանարարների "
"և ցուցչի գրառումների ձևաչափումը փոխելու համար: Այս երկխոսության մեջ կարող եք "
"նաև փոփել պարբերության ոճերը:"

#: 04120201.xhp#hd_id3150565.26.help.text
#: 04120201.xhp%23hd_id3150565.26.help.text
msgid "Assignment"
msgstr "Հանձնարարություն"

