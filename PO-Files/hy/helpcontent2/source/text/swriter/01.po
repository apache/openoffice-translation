msgstr "Չտպվող նիշեր"

#: 03100000.xhp#hd_id3154507.1.help.text
#: 03100000.xhp%23hd_id3154507.1.help.text
msgid ""
"<link href=\"text/swriter/01/03100000.xhp\" name=\"Nonprinting Characters\">"
"Nonprinting Characters</link>"
msgstr ""
"<link href=\"text/swriter/01/03100000.xhp\" name=\"Չտպվող նիշեր\">Չտպվող "
"նիշեր</link>"

#: 03100000.xhp#par_id3154646.2.help.text
#: 03100000.xhp%23par_id3154646.2.help.text
msgid ""
"<ahelp hid=\".uno:ControlCodes\">Shows nonprinting characters in your text, "
"such as paragraph marks, line breaks, tab stops, and spaces.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ControlCodes\">Ցուցադրում է ձեր տեքստի չտպվող նիշերը, "
"ինչպիսիք են պարբերության նշանները, տողերի ընդմիջումները, ներդիրների կանգերը "
"և բացատները:</ahelp>"

#: 03100000.xhp#par_id3145410.5.help.text
#: 03100000.xhp%23par_id3145410.5.help.text
msgid ""
"When you delete a paragraph mark, the paragraph that is merged takes on the "
"formatting of the paragraph that the cursor is in."
msgstr ""
"Պարբերության նշանը ջնջելիս, միաձուլված պարբերությունը ստանում է այն "
"պարբերության ձևաչափումը, որի մեջ է կուրսորը:"

#: 03100000.xhp#par_id3147511.6.help.text
#: 03100000.xhp%23par_id3147511.6.help.text
msgid ""
"To specify which nonprinting characters are displayed, choose <emph><"
"switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - <link href=\""
"text/shared/optionen/01040600.xhp\" name=\"Writer - Formatting Aids\">%"
"PRODUCTNAME Writer - Formatting Aids</link></emph>, and then select the "
"options that you want in the <emph>Display of</emph> area."
msgstr ""
"Նշելու համար, թե տպելու որ նիշերն են ցուցադրվում, ընտրեք <emph><switchinline "
"select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Նախապատվություններ</caseinline><defaultinline>Գործիքներ - "
"Ընտրանքներ</defaultinline></switchinline> - <link href=\""
"text/shared/optionen/01040600.xhp\" name=\"Writer - Ձևաչափման օգնություն\">%"
"PRODUCTNAME Writer - Ձևաչափման օգնություն</link></emph>, և ապա ընտրեք "
"տարբերակները, որոնք ցանկանում եք <emph>Արտածել</emph> տարածքից։"

