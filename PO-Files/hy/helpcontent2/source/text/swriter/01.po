msgid "A,... AA,... AAA,..."
msgstr "A,... AA,... AAA,..."

#: 06080100.xhp#par_id3155895.58.help.text
#: 06080100.xhp%23par_id3155895.58.help.text
msgid ""
"Alphabetical numbering with uppercase letters. After the first 26 entries, "
"the numbering restarts at \"AA\"."
msgstr ""
"Այբբենական համարակալում մեծատառերով: Առաջին 26 գրառումներից հետո "
"համարակալումը վերսկսվում է «AA» -ից:"

#: 06080100.xhp#par_id3154194.59.help.text
#: 06080100.xhp%23par_id3154194.59.help.text
msgctxt "06080100.xhp#par_id3154194.59.help.text"
msgid "a,... aa,... aaa,..."
msgstr "a,... aa,... aaa,..."

#: 06080100.xhp#par_id3149297.60.help.text
#: 06080100.xhp%23par_id3149297.60.help.text
msgid ""
"Alphabetical numbering with lowercase letters. After the first 26 entries, "
"the numbering restarts at \"aa\"."
msgstr ""
"Այբբենական համարակալում փոքրատառերով: Առաջին 26 մուտքերից հետո համարակալումը "
"վերսկսվում է «aa» - ից:"

#: 06080100.xhp#hd_id3151330.25.help.text
#: 06080100.xhp%23hd_id3151330.25.help.text
msgid "Counting"
msgstr "Հաշվելով"

#: 06080100.xhp#par_id3155186.26.help.text
#: 06080100.xhp%23par_id3155186.26.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_FOOTNOTEOPTION:LB_NUMCOUNT\">Select the numbering "
"option for the footnotes.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_FOOTNOTEOPTION:LB_NUMCOUNT\">Տողատակի համար "
"ընտրեք համարակալման տարբերակը:</ahelp>"

#: 06080100.xhp#par_id3149096.65.help.text
#: 06080100.xhp%23par_id3149096.65.help.text
msgid "Option"
msgstr "Ընտրանք"

#: 06080100.xhp#par_id3151256.66.help.text
#: 06080100.xhp%23par_id3151256.66.help.text
msgctxt "06080100.xhp#par_id3151256.66.help.text"
msgid "Meaning"
msgstr "Իմաստ"

#: 06080100.xhp#par_id3147094.27.help.text
#: 06080100.xhp%23par_id3147094.27.help.text
msgid "Per page"
msgstr "Ըստ էջի"

#: 06080100.xhp#par_id3148983.28.help.text
#: 06080100.xhp%23par_id3148983.28.help.text
msgid ""
"Restarts the numbering of footnotes at the top of each page. This option is "
"only available if the <emph>End of page </emph>check box is selected in the "
"<emph>Position </emph>area."
msgstr ""
"Վերսկսում է տողատակերի համարակալումը յուրաքանչյուր էջի վերևում: Այս "
"տարբերակը հասանելի է միայն այն դեպքում, եթե <emph>Էջի վերջը</emph> վանդակը "
"ընտրված է <emph>Դիրք</emph> տարածքում:"

#: 06080100.xhp#par_id3149040.29.help.text
#: 06080100.xhp%23par_id3149040.29.help.text
msgid "Per chapter"
msgstr "Ըստ գլխի"

#: 06080100.xhp#par_id3152766.30.help.text
#: 06080100.xhp%23par_id3152766.30.help.text
msgid "Restarts the numbering of footnotes at the beginning of each chapter."
msgstr "Վերսկսում է տողատակերի համարակալումը յուրաքանչյուր գլխի սկզբից:"

#: 06080100.xhp#par_id3155147.31.help.text
#: 06080100.xhp%23par_id3155147.31.help.text
msgid "Per document"
msgstr "Ըստ փաստաթղթի"

#: 06080100.xhp#par_id3153347.32.help.text
#: 06080100.xhp%23par_id3153347.32.help.text
msgid "Numbers the footnotes in the document sequentially."
msgstr ""
"Փաստաթղթում տողատակի ծանոթագրությունները հաջորդականորեն համարակալվում են:"

#: 06080100.xhp#hd_id3149167.33.help.text
#: 06080100.xhp%23hd_id3149167.33.help.text
msgctxt "06080100.xhp#hd_id3149167.33.help.text"
msgid "Start at"
msgstr "Սկսեք"

#: 06080100.xhp#par_id3156268.34.help.text
#: 06080100.xhp%23par_id3156268.34.help.text
msgid ""
"<ahelp hid=\"SW:NUMERICFIELD:TP_FOOTNOTEOPTION:FLD_OFFSET\">Enter the number "
"for the first footnote in the document. This option is only available if you "
"selected \"Per Document\" in the <emph>Counting </emph>box.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:NUMERICFIELD:TP_FOOTNOTEOPTION:FLD_OFFSET\">Փաստաթղթում "
"մուտքագրեք առաջին տողատակի թիվը: Այս տարբերակը հասանելի է միայն այն դեպքում, "
"եթե դուք ընտրեք «Ըստ փաստաթղթի» <emph>Հաշվել </emph> վանդակում:</ahelp>"

#: 06080100.xhp#hd_id3151036.50.help.text
#: 06080100.xhp%23hd_id3151036.50.help.text
msgctxt "06080100.xhp#hd_id3151036.50.help.text"
msgid "Before"
msgstr "Մինչ"

#: 06080100.xhp#par_id3150587.51.help.text
#: 06080100.xhp%23par_id3150587.51.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_FOOTNOTEOPTION:ED_PREFIX\">Enter the text that you "
"want to display in front of the footnote number in the note text.</ahelp> "
"For example, type \"To \" to display \"To 1\"."
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_FOOTNOTEOPTION:ED_PREFIX\">Ծանոթագրության տեքստում "
"մուտքագրեք այն տեքստը, որը ցանկանում եք որ ցուցադրվի տողատակի թվի "
"առջևում:</ahelp> Օրինակ, մուտքագրեք \"Դեպի\" որպեսզի ցուցադրեք \"Դեպի 1\":"

#: 06080100.xhp#hd_id3156364.52.help.text
#: 06080100.xhp%23hd_id3156364.52.help.text
msgctxt "06080100.xhp#hd_id3156364.52.help.text"
msgid "After"
msgstr "Հետո"

#: 06080100.xhp#par_id3155906.53.help.text
#: 06080100.xhp%23par_id3155906.53.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_FOOTNOTEOPTION:ED_SUFFIX\">Enter the text that you "
"want to display after the footnote number in the note text.</ahelp> For "
"example, type \")\" to display \"1)\"."
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_FOOTNOTEOPTION:ED_SUFFIX\">Ծանոթագրության տեքստում "
"մուտքագրեք տեքստը, որը ցանկանում եք ցուցադրել տողատակի թվից հետո:</ahelp> "
"Օրինակ՝ \"1)\" ցուցադրելու համար մուտքագրեք \")\":"

#: 06080100.xhp#hd_id3148875.3.help.text
#: 06080100.xhp%23hd_id3148875.3.help.text
msgctxt "06080100.xhp#hd_id3148875.3.help.text"
msgid "Position"
msgstr "Դիրք"

#: 06080100.xhp#hd_id3148888.5.help.text
#: 06080100.xhp%23hd_id3148888.5.help.text
msgid "End of page"
msgstr "Էջի վերջ"

#: 06080100.xhp#par_id3151385.6.help.text
#: 06080100.xhp%23par_id3151385.6.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FOOTNOTEOPTION:RB_POS_PAGE\">Displays "
"footnotes at the bottom of the page.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FOOTNOTEOPTION:RB_POS_PAGE\">Ցուցադրում է "
"տողատակի ծանոթագրությունները էջի ներքևում:</ahelp>"

#: 06080100.xhp#hd_id3149549.7.help.text
#: 06080100.xhp%23hd_id3149549.7.help.text
msgid "End of document"
msgstr "Փաստաթղթի վերջ"

#: 06080100.xhp#par_id3150123.8.help.text
#: 06080100.xhp%23par_id3150123.8.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FOOTNOTEOPTION:RB_POS_CHAPTER\">Displays "
"footnotes at the end of the document as endnotes.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FOOTNOTEOPTION:RB_POS_CHAPTER\">Փաստաթղթի "
"վերջում տողատակերը ցուցադրում են որպես էջատակեր:</ahelp>"

#: 06080100.xhp#hd_id3155871.35.help.text
#: 06080100.xhp%23hd_id3155871.35.help.text
msgctxt "06080100.xhp#hd_id3155871.35.help.text"
msgid "Styles"
msgstr "Ոճեր"

#: 06080100.xhp#par_id3150695.36.help.text
#: 06080100.xhp%23par_id3150695.36.help.text
msgid ""
"To ensure a uniform appearance for the footnotes in your document, assign a "
"paragraph style to the footnotes."
msgstr ""
"Ձեր փաստաթղթում տողատակերի համար միատեսակ տեսք ապահովելու նպատակով "
"տողատակում նշեք պարբերության ոճը:"

#: 06080100.xhp#hd_id3147418.37.help.text
#: 06080100.xhp%23hd_id3147418.37.help.text
msgctxt "06080100.xhp#hd_id3147418.37.help.text"
msgid "Paragraph"
msgstr "Պարբերություն"

#: 06080100.xhp#par_id3147620.38.help.text
#: 06080100.xhp%23par_id3147620.38.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_FOOTNOTEOPTION:LB_PARA_TEMPL\">Select the "
"paragraph style for the footnote text.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_FOOTNOTEOPTION:LB_PARA_TEMPL\">Տողատակի տեքստի "
"համար ընտրեք պարբերության ոճը:</ahelp>"

#: 06080100.xhp#hd_id3147495.39.help.text
#: 06080100.xhp%23hd_id3147495.39.help.text
msgctxt "06080100.xhp#hd_id3147495.39.help.text"
msgid "Page"
msgstr "Էջ"

#: 06080100.xhp#par_id3145128.40.help.text
#: 06080100.xhp%23par_id3145128.40.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_FOOTNOTEOPTION:LB_PAGE_TEMPL\">Select the page "
"style that you want to use for footnotes.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_FOOTNOTEOPTION:LB_PAGE_TEMPL\">Ընտրեք էջի ոճը, "
"որը ցանկանում եք օգտագործել տողատակի ծանոթագրությունների համար:</ahelp>"

#: 06080100.xhp#par_id3149229.49.help.text
#: 06080100.xhp%23par_id3149229.49.help.text
msgid ""
"This option is only available if the <emph>End of Document</emph> check box "
"is selected in the <emph>Position</emph> area."
msgstr ""
"Այս տարբերակը միայն հասանելի է, եթե <emph>Փաստաթղթի վերջ</emph> ընտրավանդակը "
"նշված է <emph>Դիրք</emph> տիրույթում։"

#: 06080100.xhp#hd_id3147742.61.help.text
#: 06080100.xhp%23hd_id3147742.61.help.text
msgctxt "06080100.xhp#hd_id3147742.61.help.text"
msgid "Character Styles"
msgstr "Նիշերի ոճեր"

#: 06080100.xhp#par_id3146335.62.help.text
#: 06080100.xhp%23par_id3146335.62.help.text
msgid ""
"You can assign styles to footnote anchors and text. You can use the "
"predefined footnote styles, or use a different style."
msgstr ""
"Դուք կարող եք ոճեր նշանակել տողատակի խարիսխներին և տեքստերին: Կարող եք "
"օգտագործել տողատակի նախորոշված ոճերը կամ օգտագործել այլ ոճ:"

#: 06080100.xhp#hd_id3149834.63.help.text
#: 06080100.xhp%23hd_id3149834.63.help.text
msgctxt "06080100.xhp#hd_id3149834.63.help.text"
msgid "Text area"
msgstr "Տեքստային տարածք"

#: 06080100.xhp#par_id3147592.64.help.text
#: 06080100.xhp%23par_id3147592.64.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_FOOTNOTEOPTION:LB_ANCHR_CHARFMT\">Select the "
"character style that you want to use for footnote anchors in the text area "
"of your document.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_FOOTNOTEOPTION:LB_ANCHR_CHARFMT\">Ընտրեք նիշի "
"ոճը, որը ցանկանում եք օգտագործել ձեր փաստաթղթի տեքստի տարածքում գտնվող "
"էջատակի խարիսխների համար:</ahelp>"

#: 06080100.xhp#hd_id3148845.55.help.text
#: 06080100.xhp%23hd_id3148845.55.help.text
msgctxt "06080100.xhp#hd_id3148845.55.help.text"
msgid "Footnote area"
msgstr "էջատակի տարածք"

#: 06080100.xhp#par_id3148863.56.help.text
#: 06080100.xhp%23par_id3148863.56.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_FOOTNOTEOPTION_LB_TEXT_CHARFMT\">Select the "
"character style that you want to use for the footnote numbers in the "
"footnote area.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_FOOTNOTEOPTION_LB_TEXT_CHARFMT\">Ընտրեք նիշի ոճը, "
"որը ցանկանում եք օգտագործել էջատակի տարածքում էջատակի թվերի համար:</ahelp>"

#: 06080100.xhp#hd_id3155575.41.help.text
#: 06080100.xhp%23hd_id3155575.41.help.text
msgid "Continuation notice"
msgstr "Շարունակության մասին ծանուցում"

#: 06080100.xhp#hd_id3148445.43.help.text
#: 06080100.xhp%23hd_id3148445.43.help.text
msgid "End of Footnote"
msgstr "Էջատակի ավարտ"

#: 06080100.xhp#par_id3151091.46.help.text
#: 06080100.xhp%23par_id3151091.46.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_FOOTNOTEOPTION:ED_CONT\">Enter the text that you "
"want to display when the footnotes are continued on the next page, for "
"example, \"Continued on Page \". $[officename] Writer automatically inserts "
"the number of the following page. </ahelp>"
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_FOOTNOTEOPTION:ED_CONT\">Մուտքագրեք այն տեքստը, որը "
"ցանկանում եք ցուցադրել, երբ էջատակերըը շարունակվեն հաջորդ էջում, օրինակ՝ «"
"Շարունակված է էջում»: $[officename] Writer -ը ինքնաշխատ կերպով ներմուծում է "
"հետևյալ էջի թիվը: </ahelp>"

#: 06080100.xhp#hd_id3154784.45.help.text
#: 06080100.xhp%23hd_id3154784.45.help.text
msgid "Start of next page"
msgstr "Հաջորդ էջի սկիզբ"

#: 06080100.xhp#par_id3154089.44.help.text
#: 06080100.xhp%23par_id3154089.44.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_FOOTNOTEOPTION:ED_CONT_FROM\">Enter the text that "
"you want to display on the page where the footnotes are continued, for "
"example, \"Continued from Page \". $[officename] Writer automatically "
"inserts the number of the previous page.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_FOOTNOTEOPTION:ED_CONT_FROM\">Մուտքագրեք այն տեքստը, "
"որը ցանկանում եք որ ցուցադրվի այն էջում, որտեղ շարունակվում են էջատակի "
"ծանոթագրությունները, օրինակ՝ «Շարունակված է էջից»: $[officename] Writer -ը "
"ինքնաշխատ կերպով տեղադրում է նախորդ էջի թիվը:</ahelp>"

#: 04130100.xhp#tit.help.text
#: 04130100.xhp%23tit.help.text
msgctxt "04130100.xhp#tit.help.text"
msgid "Resizing and Moving Frames, Objects With the Keyboard"
msgstr "Շրջանակների, առարկաների չափափոխում և տեղափոխում ստեղնաշարով"

#: 04130100.xhp#bm_id3154506.help.text
#: 04130100.xhp%23bm_id3154506.help.text
msgid ""
"<bookmark_value>moving;objects and "
"frames</bookmark_value><bookmark_value>objects;moving and resizing with "
"keyboard</bookmark_value><bookmark_value>resizing;objects and frames, by "
"keyboard</bookmark_value>"
msgstr ""
"<bookmark_value>շարժել;առարկաներ և "
"շրջանակներ</bookmark_value><bookmark_value>առարկաներ;շարժել և չափափոխել "
"ստեղնաշարով</bookmark_value><bookmark_value>չափափոխում;առարկաներ և "
"շրջանակներ, ստեղնաշարով</bookmark_value>"

#: 04130100.xhp#hd_id3154506.1.help.text
#: 04130100.xhp%23hd_id3154506.1.help.text
msgctxt "04130100.xhp#hd_id3154506.1.help.text"
msgid "Resizing and Moving Frames, Objects With the Keyboard"
msgstr "Շրջանակների, առարկաների չափափոխում և տեղափոխում ստեղնաշարով"

#: 04130100.xhp#par_id3145248.2.help.text
#: 04130100.xhp%23par_id3145248.2.help.text
msgid "You can resize and move selected frames and objects with the keyboard."
msgstr ""
"Ստեղնաշարի օգնությամբ կարող եք չափափոխել և տեղափոխել ընտրված շրջանակներն ու "
"առարկաները:"

#: 04130100.xhp#par_id3148771.4.help.text
#: 04130100.xhp%23par_id3148771.4.help.text
msgid ""
"To move a selected frame or object, press an arrow key. To move by one "
"pixel, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\""
">Option</caseinline><defaultinline>Alt</defaultinline></switchinline>, and "
"then press an arrow key."
msgstr ""
"Ընտրված շրջանակը կամ առարկան տեղափոխելու համար սեղմեք սլաք ստեղնը: Մեկ "
"պիքսելով շարժվելու համար սեղմած պահեք <switchinline select=\"sys\"><"
"caseinline select=\"MAC\""
">Option</caseinline><defaultinline>Alt</defaultinline></switchinline>, և "
"այնուհետև սեղմեք սլաք ստեղնը:"

#: 04130100.xhp#par_id3150762.5.help.text
#: 04130100.xhp%23par_id3150762.5.help.text
msgid ""
"To resize a selected frame or object, first press Ctrl+Tab. Now one of the "
"handles blinks to show that it is selected. To select another handle, press "
"Ctrl+Tab again. Press an arrow key to resize the object by one grid unit. To "
"resize by one pixel, hold down <switchinline select=\"sys\"><caseinline "
"select=\"MAC\""
">Option</caseinline><defaultinline>Alt</defaultinline></switchinline>, and "
"then press an arrow key."
msgstr ""
"Ընտրված շրջանակը կամ առարկան չափափոխելու համար նախ սեղմեք Ctrl+Tab: Այժմ "
"բռնակներից մեկը թարթում է՝ ցույց տալու համար, որ այն ընտրված է: Մեկ այլ "
"բռնակ ընտրելու համար կրկին սեղմեք Ctrl+Tab: Սեղմեք սլաք ստեղնը՝ առարկան "
"ցանցային մեկ միավորով չափափոխելու համար: Մեկ պիքսելով չափափոխելու համար "
"սեղմած պահեք <switchinline select=\"sys\"><caseinline select=\"MAC\""
">Option</caseinline><defaultinline>Alt</defaultinline></switchinline>, և "
"այնուհետև սեղմեք սլաք ստեղնը:"

#: 04130100.xhp#par_id3149294.6.help.text
#: 04130100.xhp%23par_id3149294.6.help.text
msgid ""
"The increment by which you move an object with the keyboard is determined by "
"the document grid. To change the properties of the document grid, choose "
"<emph><switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - <link href=\""
"text/shared/optionen/01050100.xhp\" name=\"Text document - Grid\">%"
"PRODUCTNAME Writer - Grid</link></emph>."
msgstr ""
"Քայլի այն մեծությունը, որով ստեղնաշարով առարկա եք տեղափոխում, որոշվում է "
"փաստաթղթային ցանցով: Փաստաթղթերի ցանցի հատկությունները փոխելու համար ընտրեք "
"<emph><switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Նախապատվություններ</caseinline><defaultinline>Գործիքներ - "
"Ընտրանքներ</defaultinline></switchinline> - <link href=\""
"text/shared/optionen/01050100.xhp\" name=\"Տեքստային փաստաթուղթ - Ցանց\">%"
"PRODUCTNAME Writer - Ցանց</link></emph>։"

#: mm_seladdlis.xhp#tit.help.text
#: mm_seladdlis.xhp%23tit.help.text
msgctxt "mm_seladdlis.xhp#tit.help.text"
msgid "Select Address List"
msgstr "Ընտրեք հասցեների ցուցակը"

#: mm_seladdlis.xhp#par_idN10542.help.text
#: mm_seladdlis.xhp%23par_idN10542.help.text
msgctxt "mm_seladdlis.xhp#par_idN10542.help.text"
msgid "Select Address List"
msgstr "Ընտրեք հասցեների ցուցակը"

#: mm_seladdlis.xhp#par_idN10549.help.text
#: mm_seladdlis.xhp%23par_idN10549.help.text
msgid ""
"Select the address list that you want to use for <link href=\""
"text/swriter/01/mailmerge03.xhp\">mail merge</link>, then click "
"<emph>OK</emph>."
msgstr ""
"Ընտրեք հասցեների ցուցակը, որը ցանկանում եք օգտագործել <link href=\""
"text/swriter/01/mailmerge03.xhp\">փոստի միաձուլում</link> համար, ապա "
"կտտացրեք <emph>ԼԱՎ</emph>։"

#: mm_seladdlis.xhp#par_idN1055A.help.text
#: mm_seladdlis.xhp%23par_idN1055A.help.text
msgctxt "mm_seladdlis.xhp#par_idN1055A.help.text"
msgid "Add"
msgstr "Ավելացնել"

#: mm_seladdlis.xhp#par_idN1055E.help.text
#: mm_seladdlis.xhp%23par_idN1055E.help.text
msgid ""
"<ahelp hid=\".\">Select the database file that contains the addresses that "
"you want to use as an address list.</ahelp> If the file contains more than "
"one table, the <link href=\"text/swriter/01/mm_seltab.xhp\">Select "
"Table</link> dialog opens."
msgstr ""
"<ahelp hid=\".\">Ընտրեք տվյալների շտեմարանի նիշքը, որը պարունակում է այն "
"հասցեները, որոնք ցանկանում եք օգտագործել որպես հասցեների ցուցակ:</ahelp> Եթե "
"նիշքը պարունակում է մեկից ավելի աղյուսակ, ապա բացվում է <link href=\""
"text/swriter/01/mm_seltab.xhp\">Ընտրեք աղյուսակը</link> երկխոսությունը։"

#: mm_seladdlis.xhp#par_idN10573.help.text
#: mm_seladdlis.xhp%23par_idN10573.help.text
msgid "Create"
msgstr "Ստեղծել"

#: mm_seladdlis.xhp#par_idN10589.help.text
#: mm_seladdlis.xhp%23par_idN10589.help.text
msgid ""
"<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_newaddlis.xhp\">"
"New Address List</link> dialog, where you can create a new address "
"list.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է <link href=\"text/swriter/01/mm_newaddlis.xhp\">"
"Հասցեների նոր ցուցակ</link> երկխոսությունը, որտեղ կարող եք ստեղծել հասցեների "
"նոր ցուցակ:</ahelp>"

#: mm_seladdlis.xhp#par_idN1059A.help.text
#: mm_seladdlis.xhp%23par_idN1059A.help.text
msgid "Filter"
msgstr "Զտիչ"

#: mm_seladdlis.xhp#par_idN1059E.help.text
#: mm_seladdlis.xhp%23par_idN1059E.help.text
msgid ""
"<ahelp hid=\".\">Opens the <link href=\"text/shared/02/12090100.xhp\">"
"Standard Filter</link> dialog , where you can apply filters to the address "
"list to display the recipients that you want to see.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է <link href=\"text/shared/02/12090100.xhp\">"
"Ստանդարտ զտիչ</link> երկխոսությունը, որտեղ կարող եք զտիչներ կիրառել "
"հասցեների ցուցակում՝ ցուցադրելու համար այն ստացողներին, որոնց ցանկանում եք "
"տեսնել:</ahelp>"

#: mm_seladdlis.xhp#par_idN105AF.help.text
#: mm_seladdlis.xhp%23par_idN105AF.help.text
msgctxt "mm_seladdlis.xhp#par_idN105AF.help.text"
msgid "Edit"
msgstr "Խմբագրել"

#: mm_seladdlis.xhp#par_idN105B3.help.text
#: mm_seladdlis.xhp%23par_idN105B3.help.text
msgid ""
"<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_newaddlis.xhp\">"
"New Address List</link> dialog, where you can edit the selected address "
"list.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է <link href=\"text/swriter/01/mm_newaddlis.xhp\">"
"Հասցեների նոր ցուցակ</link> երկխոսությունը, որտեղ կարող եք խմբագրել "
"հասցեների ընտրված ցուցակը:</ahelp>"

#: mm_seladdlis.xhp#par_idN105C4.help.text
#: mm_seladdlis.xhp%23par_idN105C4.help.text
msgid "Change Table"
msgstr "Փոխեք աղյուսակը"

#: mm_seladdlis.xhp#par_idN105C8.help.text
#: mm_seladdlis.xhp%23par_idN105C8.help.text
msgid ""
"<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_seltab.xhp\">"
"Select Table</link> dialog, where you can select another table to use for "
"mail merge.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է <link href=\"text/swriter/01/mm_seltab.xhp\">"
"Ընտրեք աղյուսակը</link> երկխոսություն, որտեղ կարող եք ընտրել մեկ այլ "
"աղյուսակ՝ փոստի միաձուլման նպատակով օգտագործելու համար:</ahelp>"

#: 05120100.xhp#tit.help.text
#: 05120100.xhp%23tit.help.text
msgctxt "05120100.xhp#tit.help.text"
msgid "Column Width"
msgstr "Սյունակի լայնությունը"

#: 05120100.xhp#hd_id3150345.1.help.text
#: 05120100.xhp%23hd_id3150345.1.help.text
msgctxt "05120100.xhp#hd_id3150345.1.help.text"
msgid "Column Width"
msgstr "Սյունակի լայնությունը"

#: 05120100.xhp#par_id3149503.2.help.text
#: 05120100.xhp%23par_id3149503.2.help.text
msgid ""
"<variable id=\"breitetext\"><ahelp hid=\".uno:SetColumnWidth\">Changes the "
"width of the selected column(s).</ahelp></variable>"
msgstr ""
"<variable id=\"breitetext\"><ahelp hid=\".uno:SetColumnWidth\">Փոփոխում է "
"ընտրված սյունակ(ներ)ի լայնությունը:</ahelp></variable>"

#: 05120100.xhp#hd_id3083452.3.help.text
#: 05120100.xhp%23hd_id3083452.3.help.text
msgctxt "05120100.xhp#hd_id3083452.3.help.text"
msgid "Width"
msgstr "Լայնություն"

#: 05120100.xhp#hd_id3146323.4.help.text
#: 05120100.xhp%23hd_id3146323.4.help.text
msgctxt "05120100.xhp#hd_id3146323.4.help.text"
msgid "Columns"
msgstr "Սյունակներ"

#: 05120100.xhp#par_id3145822.5.help.text
#: 05120100.xhp%23par_id3145822.5.help.text
msgid ""
"<ahelp hid=\"SW:NUMERICFIELD:DLG_COL_WIDTH:ED_COL\">Enter the column number "
"of the column you want to change the width of.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:NUMERICFIELD:DLG_COL_WIDTH:ED_COL\">Մուտքագրեք այն սյունակի "
"թիվը, որի համար ցանկանում եք փոխել լայնությունը:</ahelp>"

#: 05120100.xhp#hd_id3154502.6.help.text
#: 05120100.xhp%23hd_id3154502.6.help.text
msgctxt "05120100.xhp#hd_id3154502.6.help.text"
msgid "Width"
msgstr "Լայնություն"

#: 05120100.xhp#par_id3149880.7.help.text
#: 05120100.xhp%23par_id3149880.7.help.text
msgid ""
"<ahelp hid=\"SW:METRICFIELD:DLG_COL_WIDTH:ED_WIDTH\">Enter the width that "
"you want for the selected column(s).</ahelp>"
msgstr ""
"<ahelp hid=\"SW:METRICFIELD:DLG_COL_WIDTH:ED_WIDTH\">Մուտքագրեք ընտրված "
"սյունակ(ներ)ի համար ցանկալի լայնությունը:</ahelp>"

#: 04120224.xhp#tit.help.text
#: 04120224.xhp%23tit.help.text
msgid "Entries (index of tables)"
msgstr "Մուտքեր (աղյուսակների ցուցիչներ)"

#: 04120224.xhp#hd_id3147406.1.help.text
#: 04120224.xhp%23hd_id3147406.1.help.text
msgid ""
"<link href=\"text/swriter/01/04120224.xhp\" name=\"Entries (index of tables)"
"\">Entries (index of tables)</link>"
msgstr ""
