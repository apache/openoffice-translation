#: mm_copyto.xhp#par_idN10559.help.text
#: mm_copyto.xhp%23par_idN10559.help.text
msgid ""
"<ahelp hid=\".\">Enter the recipients of e-mail blind copies, separated by a "
"semicolon (;).</ahelp>"
msgstr ""
"<ahelp hid=\".\">Մուտքագրեք էլեկտրոնային փոստի կույր պատճենների "
"հասցեատերերին` բաժանված կետ ստորակետով (;).</ahelp>"

