msgstr "Սահմանեք աղյուսակի ընտրանքները:"

#: 04150000.xhp#hd_id3154198.42.help.text
#: 04150000.xhp%23hd_id3154198.42.help.text
msgctxt "04150000.xhp#hd_id3154198.42.help.text"
msgid "Heading"
msgstr "Գլխագիր"

#: 04150000.xhp#par_id3155188.43.help.text
#: 04150000.xhp%23par_id3155188.43.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:DLG_INSERT_TABLE:CB_HEADER\">Includes a heading row "
"in the table.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:DLG_INSERT_TABLE:CB_HEADER\">Աղյուսակում ընդգրկում "
"է գլխագրի տողը:</ahelp>"

#: 04150000.xhp#hd_id3143270.38.help.text
#: 04150000.xhp%23hd_id3143270.38.help.text
msgctxt "04150000.xhp#hd_id3143270.38.help.text"
