msgstr "Պարբերության ոճ"

#: 06060100.xhp#par_id3153722.11.help.text
#: 06060100.xhp%23par_id3153722.11.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_OUTLINE_NUM:LB_COLL\">Select the paragraph style "
"that you want to assign to the selected outline level.</ahelp> If you click "
"\"None\", the selected outline level is not defined."
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_OUTLINE_NUM:LB_COLL\">Ընտրեք պարբերության ոճը, "
"որը ցանկանում եք նշանակել ուրվագծի ընտրված մակարդակին:</ahelp> Եթե կտտացնում "
"եք «Ոչ մեկը», ապա ուրվագծի ընտրված մակարդակը սահմանված չէ:"

#: 06060100.xhp#hd_id3151272.12.help.text
#: 06060100.xhp%23hd_id3151272.12.help.text
msgctxt "06060100.xhp#hd_id3151272.12.help.text"
msgid "Number"
msgstr "Թիվ"

#: 06060100.xhp#par_id3156319.13.help.text
