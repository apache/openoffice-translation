msgid "Footnotes"
msgstr "Տողատակեր"

#: 06080100.xhp#hd_id3154705.1.help.text
#: 06080100.xhp%23hd_id3154705.1.help.text
msgid ""
"<link href=\"text/swriter/01/06080100.xhp\" name=\"Footnotes\""
">Footnotes</link>"
msgstr ""
"<link href=\"text/swriter/01/06080100.xhp\" name=\"Տողատակեր\""
">Տողատակեր</link>"

#: 06080100.xhp#par_id3149500.2.help.text
#: 06080100.xhp%23par_id3149500.2.help.text
msgid ""
"<ahelp hid=\"HID_FOOTNOTE_OPTIONS\">Specifies the formatting for footnotes "
"and endnotes.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FOOTNOTE_OPTIONS\">Նշում է տողատակի և էջատակի "
"ծանոթագրությունների ձևաչափումը:</ahelp>"

#: 06080100.xhp#par_id3154560.47.help.text
#: 06080100.xhp%23par_id3154560.47.help.text
msgid ""
"To set additional option for footnotes and endnotes, choose <emph>Format - "
"Page</emph>, and then click the <link href=\"text/swriter/01/05040600.xhp\" "
"name=\"Footnote\"><emph>Footnote</emph></link> tab."
msgstr ""
"Տողատակի և էջատակի ծանոթագրությունների համար լրացուցիչ տարբերակ սահմանելու "
"համար ընտրեք <emph>Ձևաչափ - Էջ</emph>, ապա կտտացրեք <link href=\""
"text/swriter/01/05040600.xhp\" name=\"Էջատակ\"><emph>Էջատակ</emph></link> "
"ներդիրը։"

#: 06080100.xhp#hd_id3149884.9.help.text
#: 06080100.xhp%23hd_id3149884.9.help.text
msgctxt "06080100.xhp#hd_id3149884.9.help.text"
msgid "AutoNumbering"
msgstr "Ինքնաթվագրում"

