"<ahelp hid=\"SW_NUMERICFIELD_TP_TEXTGRID_PAGE_NF_LINESPERPAGE\">Enter the "
"maximum number of lines that you want on a page.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_NUMERICFIELD_TP_TEXTGRID_PAGE_NF_LINESPERPAGE\">Մուտքագրեք "
"տողերի առավելագույն քանակը էջում, որը ցանկանում եք:</ahelp>"

#: 05040800.xhp#hd_id3152957.10.help.text
#: 05040800.xhp%23hd_id3152957.10.help.text
msgid "Characters per line"
msgstr "Նիշերը տողում"

#: 05040800.xhp#par_id3153674.9.help.text
#: 05040800.xhp%23par_id3153674.9.help.text
msgid ""
"<ahelp hid=\"SW_NUMERICFIELD_TP_TEXTGRID_PAGE_NF_CHARSPERLINE\">Enter the "
"maximum number of characters that you want on a line.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_NUMERICFIELD_TP_TEXTGRID_PAGE_NF_CHARSPERLINE\">Մուտքագրեք "
"տողում նիշերի առավելագույն քանակը, որը ցանկանում եք:</ahelp>"

#: 05040800.xhp#hd_id3149684.8.help.text
#: 05040800.xhp%23hd_id3149684.8.help.text
msgid "Max. base text size"
msgstr "Հիմնական տեքստի մաքսիմում չափը"

#: 05040800.xhp#par_id3154193.7.help.text
#: 05040800.xhp%23par_id3154193.7.help.text
msgid ""
"<ahelp hid=\"SW_METRICFIELD_TP_TEXTGRID_PAGE_MF_TEXTSIZE\">Enter the maximum "
"base text size. A large value results in less characters per line.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_METRICFIELD_TP_TEXTGRID_PAGE_MF_TEXTSIZE\">Մուտքագրեք "
"հիմնական տեքստի առավելագույն չափը: Մեծ արժեքը հանգեցնում է տողում ավելի քիչ "
"նիշերի:</ahelp>"

#: 05040800.xhp#hd_id3155182.6.help.text
#: 05040800.xhp%23hd_id3155182.6.help.text
msgid "Max. Ruby text size"
msgstr "Սուտակագույն տեքստի մեծագույն չափը"

#: 05040800.xhp#par_id3143283.5.help.text
#: 05040800.xhp%23par_id3143283.5.help.text
msgid ""
"<ahelp hid=\"SW_METRICFIELD_TP_TEXTGRID_PAGE_MF_RUBYSIZE\">Enter the font "
"size for the Ruby text.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_METRICFIELD_TP_TEXTGRID_PAGE_MF_RUBYSIZE\">Մուտքագրեք "
"Սուտակագույն տեքստի տառատեսակի չափը։</ahelp>"

#: 05040800.xhp#hd_id3149496.4.help.text
#: 05040800.xhp%23hd_id3149496.4.help.text
msgid "Ruby text below/left from base text"
msgstr "Սուտակագույն տեքստ հիմնական տեքստի ներքևում/ձախում"

#: 05040800.xhp#par_id3149816.3.help.text
#: 05040800.xhp%23par_id3149816.3.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_TP_TEXTGRID_PAGE_CB_RUBYBELOW\">Displays Ruby text "
"to the left of or below the base text.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_TP_TEXTGRID_PAGE_CB_RUBYBELOW\">Արտածում է "
"Սուտակագույն տեքստը հիմնական տեքստից ձախ կամ ներքևում։</ahelp>"

#: 05040800.xhp#hd_id3149100.2.help.text
#: 05040800.xhp%23hd_id3149100.2.help.text
msgid "Grid display"
msgstr "Ցանցի արտածում"

#: 05040800.xhp#par_id3147089.1.help.text
#: 05040800.xhp%23par_id3147089.1.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_TEXTGRID_PAGE_LB_COLOR\">Specifies the printing "
"and color options of the text grid.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_TEXTGRID_PAGE_LB_COLOR\">Նշում է տեքստային ցանցի "
"տպման և գունային տարբերակները:</ahelp>"

#: 06090000.xhp#tit.help.text
#: 06090000.xhp%23tit.help.text
msgid "Convert Text to Table"
msgstr "Փոխարկեք տեքստը աղյուսակի"

#: 06090000.xhp#bm_id3147402.help.text
#: 06090000.xhp%23bm_id3147402.help.text
msgid ""
"<bookmark_value>converting; text, into "
"tables</bookmark_value><bookmark_value>text; converting to "
"tables</bookmark_value><bookmark_value>tables; converting to "
"text</bookmark_value>"
msgstr ""
"<bookmark_value>փոխարկում; տեքստ, "
"աղյուսակների</bookmark_value><bookmark_value>տեքստ; փոխարկում "
"աղյուսակների</bookmark_value><bookmark_value>աղյուսակներ; փոխարկում "
"տեքստի</bookmark_value>"

#: 06090000.xhp#hd_id3147402.1.help.text
#: 06090000.xhp%23hd_id3147402.1.help.text
msgid ""
"<link href=\"text/swriter/01/06090000.xhp\" name=\"Convert Text to Table\">"
"Convert Text to Table</link>"
msgstr ""
"<link href=\"text/swriter/01/06090000.xhp\" name=\"Փոխարկեք տեքստը "
"աղյուսակի\">Փոխարկեք տեքստը աղյուսակի</link>"

#: 06090000.xhp#par_id3145829.2.help.text
#: 06090000.xhp%23par_id3145829.2.help.text
msgid ""
"<variable id=\"texttab\"><ahelp hid=\".uno:ConvertTableText\">Converts the "
"selected text into a table, or the selected table into "
"text.</ahelp></variable>"
msgstr ""
"<variable id=\"texttab\"><ahelp hid=\".uno:ConvertTableText\">Փոխարկում է "
"ընտրված տեքստը աղյուսակի, կամ ընտրված աղյուսակը տեքստի:</ahelp></variable>"

#: 06090000.xhp#par_id3150015.15.help.text
#: 06090000.xhp%23par_id3150015.15.help.text
msgid ""
"The options available in this dialog depending on the type of conversion."
msgstr "Այս երկխոսությունում առկա ընտրանքները կախված են փոխարկման տեսակից:"

#: 06090000.xhp#hd_id3145247.3.help.text
#: 06090000.xhp%23hd_id3145247.3.help.text
msgid "Separate text at"
msgstr "Բաժանել տեքստը"

#: 06090000.xhp#par_id3148388.4.help.text
#: 06090000.xhp%23par_id3148388.4.help.text
msgid ""
"A separator, such as a tab, marks the column boundaries in the selected "
"text. Each paragraph in the selection is converted into a row in the table. "
"Similarly, when you convert a table into text, the column markers are "
"changed to the character that you specify, and each row is converted into a "
"separate paragraph."
msgstr ""
"Բաժանարարը, ինչպիսին է ներդիրը, նշում է սյունակի սահմանները ընտրված տեքստում:"
" Ընտրության յուրաքանչյուր պարբերություն աղյուսակում վերածվում է տողի: "
"Նմանապես, երբ աղյուսակը վերածում եք տեքստի, սյունակի նշիչները փոխվում են ձեր "
"կողմից նշված նիշերի, և յուրաքանչյուր տող վերափոխվում է առանձին պարբերության:"

#: 06090000.xhp#hd_id3150936.6.help.text
#: 06090000.xhp%23hd_id3150936.6.help.text
msgctxt "06090000.xhp#hd_id3150936.6.help.text"
msgid "Tabs"
msgstr "Ներդիրներ"

#: 06090000.xhp#par_id3149027.7.help.text
#: 06090000.xhp%23par_id3149027.7.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:CB_TAB\">Converts the text "
"to a table using tabs as column markers.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:CB_TAB\">Տեքստը վերափոխում է "
"աղյուսակի, օգտագործելով ներդիրները որպես սյունակի նշիչներ:</ahelp>"

#: 06090000.xhp#hd_id3147171.10.help.text
#: 06090000.xhp%23hd_id3147171.10.help.text
msgid "Semicolons"
msgstr "Կետ ստորակետ"

#: 06090000.xhp#par_id3147565.11.help.text
#: 06090000.xhp%23par_id3147565.11.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:CB_SEMI\">Converts the text "
"to a table using semi-colons (;) as column markers.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:CB_SEMI\">Տեքստը վերափոխում "
"է աղյուսակի, օգտագործելով կետ ստորակետները (;) որպես սյունակի "
"նշիչներ:</ahelp>"

#: 06090000.xhp#hd_id3151273.12.help.text
#: 06090000.xhp%23hd_id3151273.12.help.text
msgctxt "06090000.xhp#hd_id3151273.12.help.text"
msgid "Paragraph"
msgstr "Պարբերություն"

#: 06090000.xhp#par_id3154645.13.help.text
#: 06090000.xhp%23par_id3154645.13.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:CB_PARA\">Converts the text "
"to a table using paragraphs as column markers.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:CB_PARA\">Տեքստը վերափոխում "
"է աղյուսակի, օգտագործելով պարբերությունները որպես սյունակի նշիչներ:</ahelp>"

#: 06090000.xhp#hd_id3151184.16.help.text
#: 06090000.xhp%23hd_id3151184.16.help.text
msgid "Other:"
msgstr "Այլ․"

#: 06090000.xhp#par_id3150256.17.help.text
#: 06090000.xhp%23par_id3150256.17.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:RB_OTHER\">Converts the text "
"to a table using the character that you type in the box as a column "
"marker.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_CONV_TEXT_TABLE:RB_OTHER\">Տեքստը վերափոխում "
"է աղյուսակի, օգտագործելով այն նիշը, որը դուք մուտքագրում եք վանդակում որպես "
"սյունակի նշիչ:</ahelp>"

#: 06090000.xhp#hd_id3149295.20.help.text
#: 06090000.xhp%23hd_id3149295.20.help.text
msgid "Text box"
msgstr "Տեքստային վանդակ"

#: 06090000.xhp#par_id3151175.21.help.text
#: 06090000.xhp%23par_id3151175.21.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:DLG_CONV_TEXT_TABLE:ED_OTHER\">Type the character that "
"you want to use as a column marker.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:EDIT:DLG_CONV_TEXT_TABLE:ED_OTHER\">Մուտքագրեք նիշը, որը "
"ցանկանում եք օգտագործել որպես սյունակի նշիչ:</ahelp>"

#: 06090000.xhp#hd_id3147508.18.help.text
#: 06090000.xhp%23hd_id3147508.18.help.text
msgid "Equal width for all columns"
msgstr "Հավասար լայնք բոլոր սյունակների համար"

#: 06090000.xhp#par_id3154278.19.help.text
#: 06090000.xhp%23par_id3154278.19.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:DLG_CONV_TEXT_TABLE:CB_KEEPCOLUMN\">Creates columns "
"of equal width, regardless of the position of the column marker.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:DLG_CONV_TEXT_TABLE:CB_KEEPCOLUMN\">Ստեղծում է "
"հավասար լայնության սյունակներ՝ անկախ սյունակի նշիչի դիրքից:</ahelp>"

#: 06090000.xhp#hd_id3150703.14.help.text
#: 06090000.xhp%23hd_id3150703.14.help.text
msgctxt "06090000.xhp#hd_id3150703.14.help.text"
msgid "AutoFormat"
msgstr "Ինքնաձևաչափ"

#: 06090000.xhp#par_id31542781.19.help.text
#: 06090000.xhp%23par_id31542781.19.help.text
msgid ""
"<ahelp hid=\".\">Opens the <emph>AutoFormat</emph> dialog, where you can "
"select a predefined layout for table.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է <emph>Ինքնաձևաչափ</emph> երկխոսությունը, որտեղ "
"դուք կարող եք ընտրել աղյուսակի նախորոշված դասավորությունը:</ahelp>"

#: 06090000.xhp#hd_id3154097.22.help.text
#: 06090000.xhp%23hd_id3154097.22.help.text
msgctxt "06090000.xhp#hd_id3154097.22.help.text"
msgid "Options"
msgstr "Ընտրանքներ"

#: 06090000.xhp#hd_id3149802.23.help.text
#: 06090000.xhp%23hd_id3149802.23.help.text
msgctxt "06090000.xhp#hd_id3149802.23.help.text"
msgid "Heading"
msgstr "Գլխագիր"

#: 06090000.xhp#par_id3153535.28.help.text
#: 06090000.xhp%23par_id3153535.28.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:DLG_CONV_TEXT_TABLE:CB_HEADER\">Formats the first "
"row of the new table as a heading.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:DLG_CONV_TEXT_TABLE:CB_HEADER\">Ձևաչափում է որպես "
"գլխագիր նոր աղյուսակի առաջին տողը։</ahelp>"

#: 06090000.xhp#hd_id3150359.24.help.text
