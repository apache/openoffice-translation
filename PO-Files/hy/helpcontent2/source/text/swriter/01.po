#: 04150000.xhp%23hd_id3152954.13.help.text
msgctxt "04150000.xhp#hd_id3152954.13.help.text"
msgid "Rows"
msgstr "Տողեր"

#: 04150000.xhp#par_id3154477.14.help.text
#: 04150000.xhp%23par_id3154477.14.help.text
