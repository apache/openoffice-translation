msgstr ""
"<link href=\"text/swriter/01/05090100.xhp\" name=\"Աղյուսակ\">Աղյուսակ</link>"

#: 05090100.xhp#par_id3146322.2.help.text
#: 05090100.xhp%23par_id3146322.2.help.text
msgid ""
"<ahelp hid=\"HID_FORMAT_TABLE\">Specify the size, position, spacing, and "
"alignment options for the selected table.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FORMAT_TABLE\">Նշեք ընտրված աղյուսակի չափը, դիրքը, "
"հեռավորությունը և հավասարեցման ընտրանքները:</ahelp>"

#: 05090100.xhp#hd_id3154560.3.help.text
#: 05090100.xhp%23hd_id3154560.3.help.text
msgctxt "05090100.xhp#hd_id3154560.3.help.text"
msgid "Properties"
msgstr "Հատկություններ"

#: 05090100.xhp#hd_id3149881.5.help.text
#: 05090100.xhp%23hd_id3149881.5.help.text
msgctxt "05090100.xhp#hd_id3149881.5.help.text"
msgid "Name"
msgstr "Անուն"

#: 05090100.xhp#par_id3145244.6.help.text
#: 05090100.xhp%23par_id3145244.6.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_FORMAT_TABLE:ED_NAME\">Enter an internal name for "
"the table. You can use this name to quickly locate the table in the "
"Navigator.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_FORMAT_TABLE:ED_NAME\">Մուտքագրեք աղյուսակի ներքին "
"անունը: Կարող եք օգտագործել այս անունը, Նավարկիչում աղյուսակն արագ "
"տեղակայելու համար:</ahelp>"

#: 05090100.xhp#hd_id3150567.7.help.text
#: 05090100.xhp%23hd_id3150567.7.help.text
msgctxt "05090100.xhp#hd_id3150567.7.help.text"
msgid "Width"
msgstr "Լայնություն"

#: 05090100.xhp#par_id3149026.8.help.text
#: 05090100.xhp%23par_id3149026.8.help.text
msgid ""
"<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_WIDTH\">Enter the width of "
"the table.</ahelp> This check box is only available if the "
"<emph>Automatic</emph> option in the <emph>Alignment</emph> area is not "
"selected."
msgstr ""
"<ahelp hid=\"SW:METRICFIELD:TP_FORMAT_TABLE:ED_WIDTH\">Մուտքագրեք աղյուսակի "
"լայնությունը:</ahelp> Այս ընտրավանդակը հասանելի է միայն այն դեպքում, երբ "
"<emph>Հավասարեցում</emph> տարածքում ընտրված չէ <emph>Ինքնաշխատ</emph> "
"տարբերակը:"

#: 05090100.xhp#hd_id3154644.9.help.text
#: 05090100.xhp%23hd_id3154644.9.help.text
msgctxt "05090100.xhp#hd_id3154644.9.help.text"
msgid "Relative"
msgstr "Հարաբերական"

#: 05090100.xhp#par_id3151183.10.help.text
#: 05090100.xhp%23par_id3151183.10.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FORMAT_TABLE:CB_REL_WIDTH\">Displays the width "
"of the table as a percentage of the page width.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FORMAT_TABLE:CB_REL_WIDTH\">Ցուցադրում է "
"աղյուսակի լայնությունը՝ որպես էջի լայնության տոկոս:</ahelp>"

#: 05090100.xhp#hd_id3151168.13.help.text
#: 05090100.xhp%23hd_id3151168.13.help.text
msgctxt "05090100.xhp#hd_id3151168.13.help.text"
msgid "Alignment"
msgstr "Հավասարեցում"

#: 05090100.xhp#par_id3145412.14.help.text
#: 05090100.xhp%23par_id3145412.14.help.text
msgid "Set the alignment options for the selected table."
msgstr "Սահմանեք ընտրված աղյուսակի հավասարեցման ընտրանքները:"

#: 05090100.xhp#hd_id3147511.15.help.text
#: 05090100.xhp%23hd_id3147511.15.help.text
msgctxt "05090100.xhp#hd_id3147511.15.help.text"
msgid "Automatic"
msgstr "Ինքնաշխատ"

#: 05090100.xhp#par_id3154108.16.help.text
#: 05090100.xhp%23par_id3154108.16.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FULL\">Extends the table "
"horizontally to the left and to the right page margins.</ahelp> This is the "
"recommended setting for tables in HTML documents."
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FULL\">Աղյուսակը հորիզոնական "
"կերպով տարածում է դեպի էջի ձախ և աջ եզրերը:</ahelp> Սա HTML փաստաթղթերում "
"աղյուսակների համար առաջարկվող պարամետրն է:"

#: 05090100.xhp#hd_id3149807.17.help.text
#: 05090100.xhp%23hd_id3149807.17.help.text
msgctxt "05090100.xhp#hd_id3149807.17.help.text"
msgid "Left"
msgstr "Ձախ"

#: 05090100.xhp#par_id3153540.18.help.text
#: 05090100.xhp%23par_id3153540.18.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_LEFT\">Aligns the left edge "
"of the table to the left page margin.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_LEFT\">Աղյուսակի ձախ եզրը "
"հավասարեցնում է ձախ էջի լուսանցքին:</ahelp>"

#: 05090100.xhp#hd_id3151311.36.help.text
#: 05090100.xhp%23hd_id3151311.36.help.text
msgid "Left margin"
msgstr "Ձախ լուսանցք"

#: 05090100.xhp#par_id3153672.37.help.text
#: 05090100.xhp%23par_id3153672.37.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FROM_LEFT\">Aligns the left "
"edge of the table to the indent that you enter in the <emph>Left </emph>box "
"in the <emph>Spacing </emph>area.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FROM_LEFT\">Աղյուսակի ձախ "
"եզրը հավասարեցնում է այն ներս ընկածին, որը մուտքագրում եք <emph>Ձախ</emph> "
"վանդակում <emph>Բացատավորում</emph> տարածքում:</ahelp>"

#: 05090100.xhp#hd_id3150982.19.help.text
#: 05090100.xhp%23hd_id3150982.19.help.text
msgctxt "05090100.xhp#hd_id3150982.19.help.text"
msgid "Right"
msgstr "Աջ"

#: 05090100.xhp#par_id3154567.20.help.text
#: 05090100.xhp%23par_id3154567.20.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_RIGHT\">Aligns the right edge "
"of the table to the right page margin.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_RIGHT\">Աղյուսակեղանի աջ եզրը "
"հավասարեցնում է աջ էջի լուսանցքին:</ahelp>"

#: 05090100.xhp#hd_id3155899.21.help.text
#: 05090100.xhp%23hd_id3155899.21.help.text
msgid "Centered"
msgstr "Կենտրոնացված"

#: 05090100.xhp#par_id3149696.22.help.text
#: 05090100.xhp%23par_id3149696.22.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_CENTER\">Centers the table "
"horizontally on the page.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_CENTER\">Աղյուսակը "
"հորիզոնական բերում է էջի կենտրոն:</ahelp>"

#: 05090100.xhp#hd_id3159188.23.help.text
#: 05090100.xhp%23hd_id3159188.23.help.text
msgid "Manual"
msgstr "Ձեռքով"

#: 05090100.xhp#par_id3155180.24.help.text
#: 05090100.xhp%23par_id3155180.24.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FREE\">Horizontally aligns "
"the table based on the values that you enter in the <emph>Left</emph> and "
"<emph>Right</emph> boxes in the<emph> Spacing</emph> area.</ahelp> "
"$[officename] automatically calculates the table width. Select this option "
"if you want to specify the individual <link href=\"text/swriter/01/05090200."
"xhp\" name=\"column widths\">column widths</link>."
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_FORMAT_TABLE:RB_FREE\">Աղյուսակը հորիզոնական "
"հավասարեցնում է այն արժեքների հիման վրա, որոնք մուտքագրում եք "
"<emph>Ձախ</emph> և <emph>Աջ</emph> վանդակներում <emph>Միջակայք</emph> "
"տարածքում:</ahelp> $[officename] -ը ինքնաշխատ կերպով հաշվարկում է աղյուսակի "
"լայնությունը: Ընտրեք այս տարբերակը, եթե ցանկանում եք նշել անհատական <link "
"href=\"text/swriter/01/05090200.xhp\" name=\"սյունակների լայնությունները\">"
"սյունակների լայնությունները</link>."

#: 05090100.xhp#hd_id3149824.25.help.text
#: 05090100.xhp%23hd_id3149824.25.help.text
