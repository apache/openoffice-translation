msgid "Right Arrow"
msgstr "Սլաքը Աջ"

#: 02160000.xhp#par_id3155539.32.help.text
#: 02160000.xhp%23par_id3155539.32.help.text
msgid ""
"You can jump quickly to index entries with the <link href=\""
"text/swriter/01/02110100.xhp\" name=\"Navigation Bar\">Navigation Bar</link>."
msgstr ""
"Դուք կարող եք արագ ցատկել դեպի ցուցիչի մուտքերը <link href=\""
"text/swriter/01/02110100.xhp\" name=\"Նավարկման վահանակ\">Նավարկման "
"վահանակ</link> միջոցով։"

#: mm_newaddblo.xhp#tit.help.text
#: mm_newaddblo.xhp%23tit.help.text
msgctxt "mm_newaddblo.xhp#tit.help.text"
msgid "New Address Block"
msgstr "Հասցեի նոր բլոկ"

#: mm_newaddblo.xhp#par_idN10542.help.text
#: mm_newaddblo.xhp%23par_idN10542.help.text
msgctxt "mm_newaddblo.xhp#par_idN10542.help.text"
msgid "New Address Block"
msgstr "Հասցեի նոր բլոկ"

#: mm_newaddblo.xhp#par_idN10546.help.text
#: mm_newaddblo.xhp%23par_idN10546.help.text
msgid ""
"Specify the placement of address data fields in an address block in <link "
"href=\"text/swriter/01/mm_seladdblo.xhp\">mail merge</link> documents."
msgstr ""
"Նշեք հասցեի տվյալների դաշտերի տեղադրումը հասցեի բլոկում <link href=\""
"text/swriter/01/mm_seladdblo.xhp\">փոստի միաձուլում</link> փաստաթղթերում։"

#: mm_newaddblo.xhp#par_idN10569.help.text
#: mm_newaddblo.xhp%23par_idN10569.help.text
msgctxt "mm_newaddblo.xhp#par_idN10569.help.text"
msgid "Address Elements"
msgstr "Հասցեի տարրեր"

#: mm_newaddblo.xhp#par_idN1056D.help.text
#: mm_newaddblo.xhp%23par_idN1056D.help.text
msgid ""
"<ahelp hid=\".\">Select an address field and drag the field to the other "
"list.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք հասցեի դաշտը և դաշտը քաշեք մյուս ցուցակ:</ahelp>"

#: mm_newaddblo.xhp#par_idN10570.help.text
#: mm_newaddblo.xhp%23par_idN10570.help.text
msgctxt "mm_newaddblo.xhp#par_idN10570.help.text"
msgid ">"
msgstr ">"

#: mm_newaddblo.xhp#par_idN10574.help.text
#: mm_newaddblo.xhp%23par_idN10574.help.text
msgid ""
"<ahelp hid=\".\">Adds the selected field from the Address Elements list to "
"the other list.</ahelp> You can add the same field more than once."
msgstr ""
"<ahelp hid=\".\">Հասցեի տարրերի ցուցակից ընտրված դաշտը ավելացնում է մյուս "
"ցուցակին:</ahelp> Նույն դաշտը կարող եք ավելացնել մեկից ավելի անգամ:"

#: mm_newaddblo.xhp#par_idN10577.help.text
