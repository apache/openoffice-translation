msgid "$[officename] Tag"
msgstr "$[officename] պիտակ"

#: 04090007.xhp#par_id3149846.29.help.text
#: 04090007.xhp%23par_id3149846.29.help.text
msgid "Description (fixed content)"
msgstr "Նկարագրություն (սևեռված բովանդակություն)"

#: 04090007.xhp#par_id3148863.30.help.text
#: 04090007.xhp%23par_id3148863.30.help.text
msgid "<SDFIELD TYPE=DOCINFO SUBTYPE=COMMENT SDFIXED>Description</SDFIELD>"
msgstr "<SDFIELD TYPE=DOCINFO SUBTYPE=COMMENT SDFIXED>Նկարագրություն</SDFIELD>"

#: 04090007.xhp#par_id3151083.31.help.text
#: 04090007.xhp%23par_id3151083.31.help.text
msgid "Creation date"
msgstr "Ստեղծման ամսաթիվ"

#: 04090007.xhp#par_id3153298.32.help.text
#: 04090007.xhp%23par_id3153298.32.help.text
