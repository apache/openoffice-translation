msgstr "Տպել վերևից"

#: 04070300.xhp#par_id3145763.18.help.text
#: 04070300.xhp%23par_id3145763.18.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:TP_ENV_PRT:BTN_TOP\">Feeds the envelope with the "
"print side face up in the printer tray.</ahelp>"
msgstr ""
