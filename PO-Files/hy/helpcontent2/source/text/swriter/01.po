msgid "Character Style for main entries"
msgstr "Նիշերի ոճերը հիմնական մուտքերում։"

#: 04120222.xhp#par_id3149109.9.help.text
#: 04120222.xhp%23par_id3149109.9.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_TOX_ENTRY:LB_MAIN_ENTRY_STYLE\">Specify the "
"formatting style for the main entries in the alphabetical index. To convert "
"an index entry into a main entry, click in front of the index field in the "
"document and then choose <emph>Edit - </emph><link href=\""
"text/swriter/01/04120100.xhp\" name=\"Index Entry\"><emph>Index "
"Entry</emph></link>.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_TOX_ENTRY:LB_MAIN_ENTRY_STYLE\">Այբբենական ցուցչի "
"հիմնական մուտքերի համար նշեք ձևաչափման ոճը: Ցուցչի մուտքը հիմնական մուտքի "
"վերափոխելու համար կտտացրեք փաստաթղթում ցուցիչի դաշտի դիմաց և ընտրեք <emph>"
"Խմբագրել - </emph><link href=\"text/swriter/01/04120100.xhp\" name=\"Ցուցչի "
"մուտք\"><emph>Ցուցչի մուտք</emph></link>։</ahelp>"

#: 04120222.xhp#hd_id3148977.10.help.text
#: 04120222.xhp%23hd_id3148977.10.help.text
msgid "Alphabetical delimiter"
msgstr "Այբբենական սահմանազատող"

#: 04120222.xhp#par_id3147100.11.help.text
#: 04120222.xhp%23par_id3147100.11.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_TOX_ENTRY:CB_ALPHADELIM\">Uses the initial "
"letters of the alphabetically arranged index entries as section "
"headings.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_TOX_ENTRY:CB_ALPHADELIM\">Որպես բաժնի "
"վերնախորագրեր օգտագործում է այբբենական կարգով դասավորված ցուցիչների մուտքերի "
"սկզբնական տառերը:</ahelp>"

#: 04120222.xhp#hd_id3147226.12.help.text
#: 04120222.xhp%23hd_id3147226.12.help.text
msgid "Key separated by commas"
msgstr "Բանալի, բաժանված ստորակետներով"

#: 04120222.xhp#par_id3153631.13.help.text
#: 04120222.xhp%23par_id3153631.13.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_TOX_ENTRY:CB_COMMASEPARATED\">Arranges the index "
"entries on the same line, separated by commas.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_TOX_ENTRY:CB_COMMASEPARATED\">Կազմակերպում է "
"նույն տողում ցուցչի մուտքերը, բաժանված ստորակետներով:</ahelp>"

#: 05130000.xhp#tit.help.text
#: 05130000.xhp%23tit.help.text
msgctxt "05130000.xhp#tit.help.text"
msgid "Styles in Writer"
msgstr "Ոճերը Writer -ում"

