msgctxt "05060100.xhp#hd_id3154646.7.help.text"
msgid "Relative"
msgstr "Վերաբերվող"

#: 05060100.xhp#par_id3145413.8.help.text
#: 05060100.xhp%23par_id3145413.8.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_REL_WIDTH\">Calculates the width of "
"the selected object as a percentage of the width of the page text "
"area.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_REL_WIDTH\">Հաշվարկում է ընտրված "
"օբյեկտի լայնությունը` որպես էջի տեքստի տարածքի լայնության տոկոս:</ahelp>"

#: 05060100.xhp#hd_id3147516.9.help.text
#: 05060100.xhp%23hd_id3147516.9.help.text
msgctxt "05060100.xhp#hd_id3147516.9.help.text"
msgid "Height"
msgstr "Բարձրություն"

#: 05060100.xhp#par_id3154099.10.help.text
#: 05060100.xhp%23par_id3154099.10.help.text
msgid ""
"<ahelp hid=\"SW:METRICFIELD:TP_FRM_STD:ED_HEIGHT\">Enter the height that you "
"want for the selected object.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:METRICFIELD:TP_FRM_STD:ED_HEIGHT\">Մուտքագրեք այն "
"բարձրությունը, որը ցանկանում եք ընտրված օբյեկտի համար:</ahelp>"

#: 05060100.xhp#hd_id3149809.11.help.text
#: 05060100.xhp%23hd_id3149809.11.help.text
msgctxt "05060100.xhp#hd_id3149809.11.help.text"
msgid "Relative"
msgstr "Հարաբերական"

#: 05060100.xhp#par_id3154563.12.help.text
#: 05060100.xhp%23par_id3154563.12.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_REL_HEIGHT\">Calculates the height of "
"the selected object as a percentage of the height of the page text "
"area.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_REL_HEIGHT\">Հաշվարկում է ընտրված "
"օբյեկտի բարձրությունը` որպես էջի տեքստի տարածքի բարձրության տոկոս:</ahelp>"

#: 05060100.xhp#hd_id3151313.13.help.text
#: 05060100.xhp%23hd_id3151313.13.help.text
msgid "Keep ratio"
msgstr "Պահպանեք հարաբերակցությունը"

#: 05060100.xhp#par_id3153675.14.help.text
#: 05060100.xhp%23par_id3153675.14.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_FIXEDRATIO\">Maintains the height and "
"width ratio when you change the width or the height setting.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_FIXEDRATIO\">Պահպանում է բարձրության "
"և լայնության հարաբերակցությունը, երբ փոխում եք լայնության կամ բարձրության "
"կարգավորումները:</ahelp>"

#: 05060100.xhp#hd_id3154470.41.help.text
#: 05060100.xhp%23hd_id3154470.41.help.text
msgid "Original Size"
msgstr "Սկզբնական Չափ"

#: 05060100.xhp#par_id3155898.42.help.text
#: 05060100.xhp%23par_id3155898.42.help.text
msgid ""
"<ahelp hid=\"SW:PUSHBUTTON:TP_FRM_STD:BT_REALSIZE\">Resets the size settings "
"of the selected object to the original values.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:PUSHBUTTON:TP_FRM_STD:BT_REALSIZE\">Վերականգնում է ընտրված "
"օբյեկտի չափի կարգավորումները սկզբնական արժեքներին:</ahelp>"

#: 05060100.xhp#par_id3149102.44.help.text
#: 05060100.xhp%23par_id3149102.44.help.text
msgid "This option is not available for frames."
msgstr "Այս ընտրանքը հասանելի չէ շրջանակների համար:"

#: 05060100.xhp#hd_id3149824.15.help.text
#: 05060100.xhp%23hd_id3149824.15.help.text
msgctxt "05060100.xhp#hd_id3149824.15.help.text"
msgid "Automatic"
msgstr "Ինքնաշխատ"

#: 05060100.xhp#par_id3151262.16.help.text
#: 05060100.xhp%23par_id3151262.16.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_AUTOHEIGHT\">Automatically adjusts "
"the width or height of a frame to match the contents of the frame. If you "
"want, you can specify a minimum width or minimum height for the "
"frame.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_AUTOHEIGHT\">Ինքնաշխատ կերպով "
"կարգավորում է շրջանակի լայնությունը կամ բարձրությունը, շրջանակի "
"պարունակությանը համապատասխանելու համար: Ցանկության դեպքում շրջանակի համար "
"կարող եք նշել նվազագույն լայնություն կամ նվազագույն բարձրություն:</ahelp>"

#: 05060100.xhp#par_id3152773.43.help.text
#: 05060100.xhp%23par_id3152773.43.help.text
msgid ""
"The <emph>Automatic</emph> option is only available when you select a frame."
msgstr ""
"<emph>Ինքնաշխատ</emph> տարբերակը հասանելի է միայն այն ժամանակ, երբ ընտրեք "
"շրջանակ:"

#: 05060100.xhp#hd_id3155144.17.help.text
#: 05060100.xhp%23hd_id3155144.17.help.text
msgid "Anchor"
msgstr "Խարիսխ"

#: 05060100.xhp#par_id3153352.18.help.text
#: 05060100.xhp%23par_id3153352.18.help.text
msgid ""
"Specify the anchoring options for the selected object or frame. The anchor "
"options are not available when you open the dialog from the Styles and "
"Formatting window."
msgstr ""
"Նշեք ընտրված օբյեկտի կամ շրջանակի խարսխման ընտրանքները: Խարիսխի ընտրանքները "
"մատչելի չեն, երբ երկխոսությունը բացում եք ոճերի և ձևավորման պատուհանից:"

#: 05060100.xhp#hd_id3156269.45.help.text
#: 05060100.xhp%23hd_id3156269.45.help.text
msgid "To page"
msgstr "Դեպի էջ"

#: 05060100.xhp#par_id3149169.46.help.text
#: 05060100.xhp%23par_id3149169.46.help.text
msgid ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_PAGE\">Anchors the "
"selection to the current page.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_PAGE\">Ընտրությունը "
"խարսխում է ընթացիկ էջի վրա:</ahelp>"

#: 05060100.xhp#hd_id3151028.60.help.text
#: 05060100.xhp%23hd_id3151028.60.help.text
msgid "To paragraph"
msgstr "Դեպի պարբերություն"

#: 05060100.xhp#par_id3145777.61.help.text
#: 05060100.xhp%23par_id3145777.61.help.text
msgid ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_PARA\">Anchors the "
"selection to the current paragraph.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_PARA\">Խարսխում է "
"ընտրությունը ընթացիկ պարբերության վրա:</ahelp>"

#: 05060100.xhp#hd_id3155913.62.help.text
#: 05060100.xhp%23hd_id3155913.62.help.text
msgid "To character"
msgstr "Դեպի նիշ"

#: 05060100.xhp#par_id3151377.63.help.text
#: 05060100.xhp%23par_id3151377.63.help.text
msgid ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_AT_CHAR\">Anchors the "
"selection to a character.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_AT_CHAR\">Ընտրությունը "
"խարսխում է նիշի վրա:</ahelp>"

#: 05060100.xhp#hd_id3150115.47.help.text
#: 05060100.xhp%23hd_id3150115.47.help.text
msgid "As character"
msgstr "Որպես նիշ"

#: 05060100.xhp#par_id3155863.24.help.text
#: 05060100.xhp%23par_id3155863.24.help.text
msgid ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_AS_CHAR\">Anchors the "
"selection as character. The height of the current line is resized to match "
"the height of the selection.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_FRM_STD_RB_ANCHOR_AS_CHAR\">Խարսխում է "
"ընտրությունը որպես նիշ: Ընթացիկ գծի բարձրությունը չափափոխված է` ընտրության "
"բարձրությանը համապատասխանելու համար:</ahelp>"

#: 05060100.xhp#hd_id3150693.25.help.text
#: 05060100.xhp%23hd_id3150693.25.help.text
msgctxt "05060100.xhp#hd_id3150693.25.help.text"
msgid "Position"
msgstr "Դիրք"

#: 05060100.xhp#par_id3147413.26.help.text
#: 05060100.xhp%23par_id3147413.26.help.text
msgid "Specify the location of the selected object on the current page."
msgstr "Նշեք ընտրված օբյեկտի գտնվելու վայրը ընթացիկ էջում:"

#: 05060100.xhp#hd_id3147488.27.help.text
#: 05060100.xhp%23hd_id3147488.27.help.text
msgid "Horizontal"
msgstr "Հորիզոնական"

#: 05060100.xhp#par_id3145121.28.help.text
#: 05060100.xhp%23par_id3145121.28.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:DLB_HORIZONTAL\">Select the horizontal "
"alignment option for the object.</ahelp> This option is not available if you "
"chose \"anchor as character\"."
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:DLB_HORIZONTAL\">Ընտրեք օբյեկտի "
"հորիզոնական հավասարեցման տարբերակը:</ahelp> Այս տարբերակը հասանելի չէ, եթե "
"դուք ընտրել եք «խարիսխը որպես նիշ»:"

#: 05060100.xhp#hd_id3149554.29.help.text
#: 05060100.xhp%23hd_id3149554.29.help.text
msgctxt "05060100.xhp#hd_id3149554.29.help.text"
msgid "by"
msgstr "կողմից"

#: 05060100.xhp#par_id3145258.30.help.text
#: 05060100.xhp%23par_id3145258.30.help.text
msgid ""
"<ahelp hid=\"SW:METRICFIELD:TP_FRM_STD:ED_AT_HORZ_POS\">Enter the amount of "
"space to leave between the left edge of the selected object and the "
"reference point that you select in the <emph>To</emph> box.</ahelp> This "
"option is only available if you select \"From Left\" in the "
"<emph>Horizontal</emph> box."
msgstr ""
"<ahelp hid=\"SW:METRICFIELD:TP_FRM_STD:ED_AT_HORZ_POS\">Մուտքագրեք ընտրված "
"օբյեկտի ձախ եզրի և <emph>Դեպի</emph> վանդակի հղման կետի միջև ընկած "
"տարածության մեծությունը։</ahelp> Այս տարբերակը հասանելի է միայն այն դեպքում, "
"եթե <emph>Հորիզոնական</emph> վանդակում ընտրեք «Ձախից»:"

#: 05060100.xhp#hd_id3150545.48.help.text
#: 05060100.xhp%23hd_id3150545.48.help.text
msgctxt "05060100.xhp#hd_id3150545.48.help.text"
msgid "to"
msgstr "դեպի"

#: 05060100.xhp#par_id3149213.49.help.text
#: 05060100.xhp%23par_id3149213.49.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:LB_HORI_RELATION\">Select the reference "
"point for the selected horizontal alignment option.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:LB_HORI_RELATION\">Ընտրված հորիզոնական "
"հավասարեցման տարբերակի համար ընտրեք հղման կետը:</ahelp>"

#: 05060100.xhp#par_id3149230.51.help.text
#: 05060100.xhp%23par_id3149230.51.help.text
msgid ""
"You can see the result of the alignments options that you select in the "
"Preview box."
msgstr ""
"Հավասարեցումների ընտրանքների արդյունքը կարող եք տեսնել Նախադիտում վանդակում:"

#: 05060100.xhp#hd_id3147746.52.help.text
#: 05060100.xhp%23hd_id3147746.52.help.text
msgid "Mirror on even pages"
msgstr "Հայելային տեսք զույգ էջերում"

#: 05060100.xhp#par_id3146337.53.help.text
#: 05060100.xhp%23par_id3146337.53.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_MIRROR\">Reverses the current "
"horizontal alignment settings on even pages.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_FRM_STD:CB_MIRROR\">Հակադարձում է զույգ էջերի "
"ընթացիկ հորիզոնական հավասարեցման կարգավորումները:</ahelp>"

#: 05060100.xhp#par_id3148446.54.help.text
#: 05060100.xhp%23par_id3148446.54.help.text
msgid ""
"You can also use the <link href=\"text/swriter/01/05060300.xhp\" name=\""
"Graphics\"><emph>Graphics</emph></link> flip options to adjust the layout of "
"objects on even and odd pages."
msgstr ""
"Կարող եք նաև օգտագործել <link href=\"text/swriter/01/05060300.xhp\" name=\""
"Գրաֆիկներ\"><emph>Գրաֆիկներ</emph></link> շրջելու ընտրանքները` զույգ և կենտ "
"էջերում օբյեկտների դասավորությունը կարգավորելու համար:"

#: 05060100.xhp#hd_id3145310.31.help.text
#: 05060100.xhp%23hd_id3145310.31.help.text
msgid "Vertical"
msgstr "Ուղղահայաց"

#: 05060100.xhp#par_id3150161.32.help.text
#: 05060100.xhp%23par_id3150161.32.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:DLB_VERTICAL\">Select the vertical "
"alignment option for the object.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:DLB_VERTICAL\">Ընտրեք օբյեկտի ուղղահայաց "
"հավասարեցման տարբերակը:</ahelp>"

#: 05060100.xhp#par_id3150463.59.help.text
#: 05060100.xhp%23par_id3150463.59.help.text
msgid ""
"If you anchor an object to a frame with a fixed height, only the \"Bottom\" "
"and \"Center\" alignment options are available."
msgstr ""
"Եթե օբյեկտը խարսխում եք սևեռված բարձրությամբ շրջանակի վրա, ապա հասանելի են "
"միայն «Ներքև» և «Կենտրոն» հավասարեցման ընտրանքները:"

#: 05060100.xhp#hd_id3154724.33.help.text
#: 05060100.xhp%23hd_id3154724.33.help.text
msgctxt "05060100.xhp#hd_id3154724.33.help.text"
msgid "by"
msgstr "կողմից"

#: 05060100.xhp#par_id3156130.34.help.text
#: 05060100.xhp%23par_id3156130.34.help.text
msgid ""
"<ahelp hid=\"SW:METRICFIELD:TP_FRM_STD:ED_AT_VERT_POS\">Enter the amount of "
"space to leave between the top edge of the selected object and the reference "
"point that you select in the <emph>To</emph> box.</ahelp> This option is "
"only available if you select \"From Top\" or \"From Bottom\" (as character) "
"in the <emph>Vertical</emph> box. "
msgstr ""
"<ahelp hid=\"SW:METRICFIELD:TP_FRM_STD:ED_AT_VERT_POS\">Մուտքագրեք ընտրված "
"օբյեկտի վերին եզրի և <emph>Դեպի</emph> վանդակում ընտրված հղման կետի միջև "
"թողնվող տարածության չափը։</ahelp> Այս տարբերակը հասանելի է միայն այն "
"դեպքում, եթե <emph>Ուղղահայաց</emph> վանդակում ընտրեք «Վերևից» կամ «Ներքևից» "
"(որպես նիշ): "

#: 05060100.xhp#hd_id3150912.56.help.text
#: 05060100.xhp%23hd_id3150912.56.help.text
msgctxt "05060100.xhp#hd_id3150912.56.help.text"
msgid "to"
msgstr "դեպի"

#: 05060100.xhp#par_id3155075.57.help.text
#: 05060100.xhp%23par_id3155075.57.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:LB_VERT_RELATION\">Select the reference "
"point for the selected vertical alignment option.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_FRM_STD:LB_VERT_RELATION\">Ընտրեք հղման կետը "
"ընտրված ուղղահայաց հավասարեցման տարբերակի համար:</ahelp>"

#: 05060100.xhp#par_idN10A8E.help.text
#: 05060100.xhp%23par_idN10A8E.help.text
msgid "Follow text flow"
msgstr "Հետևեք տեքստի հոսքին"

#: 05060100.xhp#par_idN10A92.help.text
#: 05060100.xhp%23par_idN10A92.help.text
msgid ""
"<ahelp hid=\"sw:CheckBox:TP_FRM_STD:CB_FOLLOWTEXTFLOW\">Keeps the selected "
"object within the layout boundaries of the text that the object is anchored "
"to. To place the selected object anywhere in your document, do not select "
"this option.</ahelp>"
msgstr ""
"<ahelp hid=\"sw:CheckBox:TP_FRM_STD:CB_FOLLOWTEXTFLOW\">Ընտրված օբյեկտը "
"պահում է տեքստի դասավորության սահմաններում, որի վրա խարսխված է օբյեկտը: "
"Ընտրված օբյեկտը ձեր փաստաթղթի ցանկացած մասում տեղադրելու համար մի ընտրեք այս "
"տարբերակը:</ahelp>"

#: 05060100.xhp#par_idN10AA6.help.text
#: 05060100.xhp%23par_idN10AA6.help.text
msgid ""
"By default, the <emph>Follow text flow</emph> option is selected when you "
"open a document that was created in a version of %PRODUCTNAME older than %"
"PRODUCTNAME %PRODUCTVERSION. However, this option is not selected when you "
"create a document or when you open a document in Microsoft Word format "
"(*.doc)."
msgstr ""
"Լռելյայնորեն, <emph>Հետևել տեքստի հոսքին</emph> տարբերակը ընտրվում է, երբ "
"բացում եք փաստաթուղթ, ստեղծված %PRODUCTNAME -ի ավելի հին տարբերակում, քան %"
"PRODUCTNAME %PRODUCTVERSION -նն է: Այնուամենայնիվ, այս տարբերակը չի "
"ընտրվում, երբ փաստաթուղթ եք ստեղծում կամ Microsoft Word (*.doc) ձևաչափով "
"փաստաթուղթ եք բացում:"

#: 05060100.xhp#par_id3149241.58.help.text
#: 05060100.xhp%23par_id3149241.58.help.text
msgid ""
"The green rectangle represents the selected object and the red rectangle "
"represents the alignment reference point. If you anchor the object as a "
"character, the reference rectangle changes to a red line."
msgstr ""
"Կանաչ ուղղանկյունը ներկայացնում է ընտրված օբյեկտը, իսկ կարմիր ուղղանկյունը՝ "
"հղման հավասարեցման կետը: Եթե օբյեկտը խարսխում եք որպես նիշ, հղման "
"ուղղանկյունը փոխվում է կարմիր գծի:"

#: 05060100.xhp#par_id3146949.66.help.text
#: 05060100.xhp%23par_id3146949.66.help.text
msgid ""
"<link href=\"text/shared/01/05260000.xhp\" name=\"Format - Anchor\"><emph>"
"Format - Anchor</emph></link>"
msgstr ""
"<link href=\"text/shared/01/05260000.xhp\" name=\"Ձևաչափ - Խարիսխ\"><emph>"
"Ձևաչափ - Խարիսխ</emph></link>"

#: 05060100.xhp#par_id3153231.67.help.text
#: 05060100.xhp%23par_id3153231.67.help.text
msgid ""
"<link href=\"text/shared/01/05070000.xhp\" name=\"Format - Alignment\"><emph>"
"Format - Alignment</emph></link>"
msgstr ""
"<link href=\"text/shared/01/05070000.xhp\" name=\"Ձևաչափ - Հավասարեցում\""
"><emph>Ձևաչափ - Հավասարեցում</emph></link>"

#: mm_newaddlis.xhp#tit.help.text
#: mm_newaddlis.xhp%23tit.help.text
msgctxt "mm_newaddlis.xhp#tit.help.text"
msgid "New Address List"
msgstr "Հասցեների նոր ցուցակ"

#: mm_newaddlis.xhp#par_idN10542.help.text
#: mm_newaddlis.xhp%23par_idN10542.help.text
msgctxt "mm_newaddlis.xhp#par_idN10542.help.text"
msgid "New Address List"
msgstr "Հասցեների նոր ցուցակ"

#: mm_newaddlis.xhp#par_idN10546.help.text
#: mm_newaddlis.xhp%23par_idN10546.help.text
msgid ""
"Enter new addresses or edit the addresses for <link href=\""
"text/swriter/01/mailmerge03.xhp\">mail merge</link> documents. When you "
"click <emph>OK</emph>, a dialog prompts you for the location to save the "
"address list."
msgstr ""
"Մուտքագրեք կամ խմբագրեք հասցեների նոր ցուցակը <link href=\""
"text/swriter/01/mailmerge03.xhp\">փոստի ձուլում</link> փաստաթղթերի համար։ "
"Երբ կտտացնում եք <emph>ԼԱՎ</emph>, երկխոսությունը ձեզ հուշում է թե որտեղ "
"պահել հասցեների ցուցակը:"

#: mm_newaddlis.xhp#par_idN10557.help.text
#: mm_newaddlis.xhp%23par_idN10557.help.text
msgid "Address Information"
msgstr "Հասցեների մասին տեղեկատվություն"

#: mm_newaddlis.xhp#par_idN1055B.help.text
#: mm_newaddlis.xhp%23par_idN1055B.help.text
msgid ""
"<ahelp hid=\".\">Enter or edit the field contents for each mail merge "
"recipient.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Մուտքագրեք կամ խմբագրեք դաշտի բովանդակությունը փոստի "
"միաձուլման յուրաքանչյուր ստացողի համար:</ahelp>"

#: mm_newaddlis.xhp#par_idN1055E.help.text
#: mm_newaddlis.xhp%23par_idN1055E.help.text
msgid "Show Entry Number"
msgstr "Ցույց տվեք մուտքի թիվը"

#: mm_newaddlis.xhp#par_idN10574.help.text
#: mm_newaddlis.xhp%23par_idN10574.help.text
msgid ""
"<ahelp hid=\".\">Click the buttons to navigate through the records or enter "
"a record number to display a record.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Գրառումների միջով նավարկելու համար կտտացրեք կոճակները կամ "
"գրառումը ցուցադրելու համար մուտքագրեք գրառման թիվը:</ahelp>"

#: mm_newaddlis.xhp#par_idN10577.help.text
#: mm_newaddlis.xhp%23par_idN10577.help.text
msgctxt "mm_newaddlis.xhp#par_idN10577.help.text"
msgid "New"
msgstr "Նոր"

#: mm_newaddlis.xhp#par_idN1057B.help.text
#: mm_newaddlis.xhp%23par_idN1057B.help.text
msgid "<ahelp hid=\".\">Adds a new blank record to the address list.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Հասցեների ցուցակում ավելացնում է նոր դատարկ գրառում:</ahelp>"

#: mm_newaddlis.xhp#par_idN1057E.help.text
#: mm_newaddlis.xhp%23par_idN1057E.help.text
msgctxt "mm_newaddlis.xhp#par_idN1057E.help.text"
msgid "Delete"
msgstr "Ջնջել"

#: mm_newaddlis.xhp#par_idN10582.help.text
#: mm_newaddlis.xhp%23par_idN10582.help.text
msgid "<ahelp hid=\".\">Deletes the selected record.</ahelp>"
msgstr "<ahelp hid=\".\">Ջնջում է ընտրված գրառումը:</ahelp>"

#: mm_newaddlis.xhp#par_idN10585.help.text
#: mm_newaddlis.xhp%23par_idN10585.help.text
msgctxt "mm_newaddlis.xhp#par_idN10585.help.text"
msgid "Find"
msgstr "Գտնել"

#: mm_newaddlis.xhp#par_idN10589.help.text
#: mm_newaddlis.xhp%23par_idN10589.help.text
msgid ""
"<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_finent.xhp\">Find "
"Entry</link> dialog. You can leave the dialog open while you edit the "
"entries.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է <link href=\"text/swriter/01/mm_finent.xhp\">Գտեք "
"մուտքը</link> երկխոսությունը։ Մուտքերը խմբագրելիս կարող եք երկխոսությունը "
"բացված թողնել:</ahelp>"

#: mm_newaddlis.xhp#par_idN1059A.help.text
#: mm_newaddlis.xhp%23par_idN1059A.help.text
msgid "Customize"
msgstr "Անհատականացնել"

#: mm_newaddlis.xhp#par_idN1059E.help.text
#: mm_newaddlis.xhp%23par_idN1059E.help.text
msgid ""
"<ahelp hid=\".\">Opens the <link href=\"text/swriter/01/mm_cusaddlis.xhp\">"
"Customize Address List</link> dialog where you can rearrange, rename, add, "
"and delete fields.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է <link href=\"text/swriter/01/mm_cusaddlis.xhp\">"
"Անհատականացրեք հասցեների ցուցակը</link> երկխոսությունը, որտեղ կարող եք "
"վերադասավորել, անվանափոխել, ավելացնել և ջնջել դաշտերը:</ahelp>"

#: 04120226.xhp#tit.help.text
#: 04120226.xhp%23tit.help.text
msgid "Entries (table of objects)"
msgstr "Մուտքեր (աղյուսակներ կամ առարկաներ)"

#: 04120226.xhp#hd_id3147401.1.help.text
#: 04120226.xhp%23hd_id3147401.1.help.text
msgid ""
"<link href=\"text/swriter/01/04120226.xhp\" name=\"Entries (table of objects)"
"\">Entries (table of objects)</link>"
msgstr ""
"<link href=\"text/swriter/01/04120226.xhp\" name=\"Մուտքեր (աղյուսակներ կամ "
"առարկաներ)\">Մուտքեր (աղյուսակներ կամ առարկաներ)</link>"

#: 04120226.xhp#par_id3083447.2.help.text
#: 04120226.xhp%23par_id3083447.2.help.text
msgid ""
"<variable id=\"eintraege\">Specify the format for the entries in a Table of "
"Objects. </variable>"
msgstr ""
"<variable id=\"eintraege\">Նշեք առարկաների աղյուսակում մուտքերի ձևաչափը: "
"</variable>"

#: 04120226.xhp#par_id3150017.3.help.text
#: 04120226.xhp%23par_id3150017.3.help.text
msgid "A Table of Objects only has one index level."
msgstr "Առարկաների աղյուսակը ունի ցուցչի միայն մեկ մակարդակ։"

#: 04120250.xhp#tit.help.text
#: 04120250.xhp%23tit.help.text
msgctxt "04120250.xhp#tit.help.text"
msgid "Edit Concordance File"
msgstr "Խմբագրել համապատասխանության նիշքը"

#: 04120250.xhp#bm_id3148768.help.text
#: 04120250.xhp%23bm_id3148768.help.text
msgid ""
"<bookmark_value>editing; concordance files</bookmark_value><bookmark_value>"
"concordance files; definition</bookmark_value>"
msgstr ""
"<bookmark_value>խմբագրում; հհամապատասխանության "
"նիշքեր</bookmark_value><bookmark_value>համապատասխանության նիշքեր; "
"սահմանում</bookmark_value>"

#: 04120250.xhp#hd_id3148768.1.help.text
#: 04120250.xhp%23hd_id3148768.1.help.text
msgctxt "04120250.xhp#hd_id3148768.1.help.text"
msgid "Edit Concordance File"
msgstr "Խմբագրել համապատասխանության նիշքը"

#: 04120250.xhp#par_id3151180.2.help.text
#: 04120250.xhp%23par_id3151180.2.help.text
msgid ""
"<ahelp hid=\"HID_DLG_CREATE_AUTOMARK\">Create or edit a list of words to "
"include in an Alphabetical Index.</ahelp> A concordance file lists words "
"that should be referenced in an alphabetical index, together with the page "
"number(s) where they appear in the document."
msgstr ""
"<ahelp hid=\"HID_DLG_CREATE_AUTOMARK\">Ստեղծեք կամ խմբագրեք այբբենական "
"ցուցիչում ներառվող բառերի ցուցակը:</ahelp> Համապատասխանության նիշքում նշվում "
"են բառերը, որոնք պետք է վկայակոչվեն այբբենական ցուցիչով, ինչպես նաև էջի "
"թիվը, որտեղ դրանք հայտնվում են փաստաթղթում:"

#: 04120250.xhp#par_id837427.help.text
#: 04120250.xhp%23par_id837427.help.text
msgid ""
"You can use the Find All button on the Find & Replace dialog to highlight "
"all places where a word appears, then open the Insert Index Entry dialog to "
"add that word and places to the alphabetical index. However, if you need the "
"same set of alphabetical indexes in multiple documents, the concordance file "
"allows to enter every word just once, then use the list many times."
msgstr ""
"\"Գտեք և փոխարինեք\" երկխոսության «Գտիր բոլորը» կոճակը կարող եք օգտագործել՝ "
"բառերը հայտնվելու բոլոր տեղերը առանձնացնելու համար, այնուհետև բացեք «"
"Տեղադրել ցուցիչի գրառում» երկխոսությունը՝ այդ բառը և տեղերը այբբենական "
"ցուցիչին ավելացնելու համար: Այնուամենայնիվ, եթե այբբենական նույն ցուցիչների "
"բազմության կարիքը ունեք բազմաթիվ փաստաթղթերում, համապատասխանության նիշքը "
"թույլ է տալիս մուտքագրել յուրաքանչյուր բառ մեկ անգամ, ապա օգտագործել ցուցակը "
"բազմիցս:"

#: 04120250.xhp#hd_id3154645.19.help.text
#: 04120250.xhp%23hd_id3154645.19.help.text
msgid "To access the Edit Concordance File dialog:"
msgstr ""
"\"Խմբագրել համապատասխանության նիշքը\" երկխոսություն մուտք գործելու համար․"

#: 04120250.xhp#par_id3149292.20.help.text
#: 04120250.xhp%23par_id3149292.20.help.text
msgid ""
"Choose <emph>Insert - Indexes and Tables - Indexes and Tables - "
"Index/Table</emph>."
msgstr ""
"Ընտրեք <emph>Տեղադրել - Ցուցիչներ և աղյուսակներ - Ցուցիչներ և աղյուսակներ - "
"Ցուցիչ/Աղյուսակ</emph>."

#: 04120250.xhp#par_id3145420.21.help.text
#: 04120250.xhp%23par_id3145420.21.help.text
msgid "In the <emph>Type </emph>box, select \"Alphabetical Index\"."
msgstr "<emph>Տեսակ </emph>վանդակում, ընտրեք «Այբբենական ցուցիչ»:"

#: 04120250.xhp#par_id3154107.22.help.text
#: 04120250.xhp%23par_id3154107.22.help.text
msgid ""
"In the <emph>Options </emph>area, select the <emph>Concordance file</emph> "
"check box."
msgstr ""
"<emph>Ընտրանքներ </emph> տարածքում, ընտրեք <emph>Համապատասխանության "
"նիշք</emph> ընտրավանդակը:"

#: 04120250.xhp#par_id3153668.23.help.text
#: 04120250.xhp%23par_id3153668.23.help.text
msgid ""
"Click the <emph>File</emph> button, and then choose <emph>New</emph> or "
"<emph>Edit</emph>."
msgstr ""
"Կտտացրեք <emph>Նիշք</emph> կոճակին, ապա ընտրեք <emph>Նոր</emph> կամ "
"<emph>Խմբագրել</emph>:"

#: 04120250.xhp#par_id3154470.24.help.text
#: 04120250.xhp%23par_id3154470.24.help.text
msgid "A concordance file contains the following fields: "
msgstr "Համապատասխանության նիշքը պարունակում է։ "

#: 04120250.xhp#par_id3152953.3.help.text
#: 04120250.xhp%23par_id3152953.3.help.text
msgid ""
"\"Search term\" refers to the index entry that you want to mark in the "
"document."
msgstr ""
"«Որոնման տերմինը» վերաբերում է ցուցչի մուտքին, որը ցանկանում եք նշել "
"փաստաթղթում:"

#: 04120250.xhp#par_id3155896.4.help.text
#: 04120250.xhp%23par_id3155896.4.help.text
msgid ""
"\"Alternative entry\" refers to the index entry that you want to appear in "
"the index."
msgstr ""
"«Այլընտրանքային մուտք» -ը վերաբերում է ցուցչի մուտքին, որը ցանկանում եք որ "
"հայտնվի ցուցիչում:"

#: 04120250.xhp#par_id3154194.5.help.text
#: 04120250.xhp%23par_id3154194.5.help.text
msgid ""
"The 1st and 2nd Keys are parent index entries. The \"Search term\" or the \""
"Alternative entry\" appears as a subentry under the 1st and 2nd Keys."
msgstr ""
"1-ին և 2-րդ բանալիները ծնող ցուցչի մուտքեր են: «Որոնման տերմինը» կամ «"
"Այլընտրանքային մուտքը» հայտնվում են որպես ենթակետ է 1-ին և 2-րդ բանալիների "
"ներքո:"

#: 04120250.xhp#par_id3155184.6.help.text
#: 04120250.xhp%23par_id3155184.6.help.text
msgid ""
"\"Match case\" means that uppercase and lowercase letters are considered."
msgstr ""
"«Հաշվի առնել ռեգիստրը» նշանակում է, որ դիտարկվում են մեծատառեր և փոքրատառեր:"

#: 04120250.xhp#par_id3143282.7.help.text
#: 04120250.xhp%23par_id3143282.7.help.text
msgid "\"Word only\" searches for the term as a single word."
msgstr "«Միայն բառ» որոնում է տերմինները որպես մեկ բառ:"

#: 04120250.xhp#par_id3147220.8.help.text
#: 04120250.xhp%23par_id3147220.8.help.text
msgid ""
"To enable the \"Match case\" or \"Word only\" options, click in the "
"corresponding cell, and then select the check box."
msgstr ""
"«Հաշվի առնել ռեգիստրը» կամ «Միայն բառ» ընտրանքները միացնելու համար կտտացրեք "
"համապատասխան բջիջին և այնուհետև ընտրեք վանդակը:"

#: 04120250.xhp#hd_id3153629.25.help.text
#: 04120250.xhp%23hd_id3153629.25.help.text
msgid "To create a concordance file without the Edit Concordance File dialog:"
msgstr ""
"Առանց \"Խմբագրել համապատասխանության նիշքի\" երկխոսության համապատասխանության "
"նիշք ստեղծելու համար."

#: 04120250.xhp#par_id3153644.9.help.text
#: 04120250.xhp%23par_id3153644.9.help.text
msgid "Use the following format guidelines when you create a concordance file:"
msgstr ""
"Համապատասխանության նիշք ստեղծելու ժամանակ օգտագործեք ձևաչափման հետևյալ "
"ուղեցույցները."

#: 04120250.xhp#par_id3152770.10.help.text
#: 04120250.xhp%23par_id3152770.10.help.text
msgid "Each entry in the concordance file is on a separate line."
msgstr "Համապատասխանության նիշքում յուրաքանչյուր մուտք առանձին տողի վրա է:"

#: 04120250.xhp#par_id3155142.26.help.text
#: 04120250.xhp%23par_id3155142.26.help.text
msgid "Commented lines start with #."
msgstr "Մեկնաբանված տողերը սկսվում են # -ից:"

#: 04120250.xhp#par_id3153354.11.help.text
#: 04120250.xhp%23par_id3153354.11.help.text
msgid "Use the following format for the entries:"
msgstr "Մուտքերի համար օգտագործեք հետևյալ ձևաչափը․"

#: 04120250.xhp#par_id3149172.12.help.text
#: 04120250.xhp%23par_id3149172.12.help.text
msgid "Search term;Alternative entry;1st key;2nd key;Match case;Word only"
msgstr ""
"Որոնման տերմին;Այլընտրանքային մուտք;1-ին ստեղն;2-րդ ստեղն;Հաշվի առնել "
"ռեգիստրը;Միայն բառ"

#: 04120250.xhp#par_id3156270.13.help.text
#: 04120250.xhp%23par_id3156270.13.help.text
msgid ""
"The entries \"Match case\" and \"Word only\" are interpreted as \"No\" or "
"FALSE if they are empty or zero (0). All other contents are interpreted as \""
"Yes\" or TRUE."
msgstr ""
"«Հաշվի առնել ռեգիստրը» և «Միայն բառ» մուտքերը մեկնաբանվում են որպես «Ոչ» կամ "
"FALSE, եթե դրանք դատարկ են կամ զրո (0): Մնացած բոլոր բովանդակությունները "
"մեկնաբանվում են որպես «Այո» կամ TRUE:"

#: 04120250.xhp#hd_id3145778.27.help.text
#: 04120250.xhp%23hd_id3145778.27.help.text
msgctxt "04120250.xhp#hd_id3145778.27.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04120250.xhp#par_id3155907.14.help.text
#: 04120250.xhp%23par_id3155907.14.help.text
msgid ""
"For example, to include the word \"Boston\" in your alphabetical index under "
"the \"Cities\" entry, enter the following line in the concordance file:"
msgstr ""
"Օրինակ, «Քաղաքներ» մուտքի ներքո, ձեր այբբենական ցուցիչում «Boston» բառը "
"ներառելու համար համապատասխանության նիշքում մուտքագրեք հետևյալ տողը."

#: 04120250.xhp#par_id3151370.15.help.text
#: 04120250.xhp%23par_id3151370.15.help.text
msgid "Boston;Boston;Cities;;0;0 "
msgstr "Boston;Boston;Cities;;0;0 "

#: 04120250.xhp#par_id3151383.16.help.text
#: 04120250.xhp%23par_id3151383.16.help.text
msgid "This also finds \"Boston\" if it is written in lowercase letters."
msgstr "Սա նաև գտնում է «Boston» -ը, եթե գրված է փոքրատառերով:"

#: 04120250.xhp#par_id3155866.17.help.text
#: 04120250.xhp%23par_id3155866.17.help.text
msgid ""
"To include the \"Beacon Hill\" district in Boston under the \"Cities\" "
"entry, enter the following line:"
msgstr ""
"Boston -ի \"Beacon Hill\" թաղամասը «Քաղաքներ» մուտքի ներքո ընդգրկելու համար "
"մուտքագրեք հետևյալ տողը."

#: 04120250.xhp#par_id3150116.18.help.text
#: 04120250.xhp%23par_id3150116.18.help.text
msgid "Beacon Hill;Boston;Cities; "
msgstr "Beacon Hill;Boston;Cities; "

#: 04230000.xhp#tit.help.text
#: 04230000.xhp%23tit.help.text
msgctxt "04230000.xhp#tit.help.text"
msgid "Footer"
msgstr "Տողատակ"

#: 04230000.xhp#hd_id3147403.1.help.text
#: 04230000.xhp%23hd_id3147403.1.help.text
msgid ""
"<link href=\"text/swriter/01/04230000.xhp\" name=\"Footer\">Footer</link>"
msgstr ""
"<link href=\"text/swriter/01/04230000.xhp\" name=\"Տողատակ\">Տողատակ</link>"

#: 04230000.xhp#par_id3149353.2.help.text
#: 04230000.xhp%23par_id3149353.2.help.text
msgid ""
"<ahelp hid=\".uno:InsertPageFooter\">Adds or removes a footer from the page "
"style that you select in the submenu. The footer is added to all of the "
"pages that use the same page style.</ahelp> In a new document, only the \""
"Default\" page style is listed. Other page styles are added to the list "
"after you apply them in the document."
msgstr ""
"<ahelp hid=\".uno:InsertPageFooter\">Էջի ոճից ավելացնում կամ հեռացնում է "
"էջատակը, որը դուք ընտրում եք ենթաընտրացանկում: էջատակն ավելացվում է բոլոր "
"այն էջերին, որոնք օգտագործում են նույն էջի ոճը:</ahelp> Նոր փաստաթղթում "
"նշված է միայն «Լռելյայն» էջի ոճը: Փաստաթղթում դրանք կիրառելուց հետո էջի այլ "
"ոճերը ավելացվում են ցուցակին:"

#: 04230000.xhp#par_id7026276.help.text
#: 04230000.xhp%23par_id7026276.help.text
msgid ""
"The footers are visible only when you view the document in print layout ("
"enable <emph>View - Print Layout</emph>)."
msgstr ""
"Էջատակերը տեսանելի են միայն այն ժամանակ, երբ դուք փաստաթուղթը դիտում եք "
"տպելու դասավորության մեջ (միացնել <emph>Դիտել - Տպել դասավորությունը</emph>):"

#: 04230000.xhp#par_id3150018.3.help.text
#: 04230000.xhp%23par_id3150018.3.help.text
msgid ""
"A check mark is displayed in front of the page styles that have footers."
msgstr "Էջատակեր ունեցող էջի ոճերի առջև ցուցադրվում է ընտրելու նշանը:"

#: 04230000.xhp#par_id3150566.4.help.text
#: 04230000.xhp%23par_id3150566.4.help.text
msgid ""
"To remove a footer, choose <emph>Insert - Footer</emph>, and then select the "
"page style containing the footer. The footer is removed from all of the "
"pages that use this page style."
msgstr ""
"Էջատակը հեռացնելու համար ընտրեք <emph>Տեղադրել - Էջատակ</emph>, ապա ընտրեք "
"էջատակը պարունակող էջի ոճը: Էջատակը հեռացվում է էջի այս ոճն օգտագործող բոլոր "
"էջերից:"

#: 04230000.xhp#par_id3153923.5.help.text
#: 04230000.xhp%23par_id3153923.5.help.text
msgid ""
"To add or remove footers from all of the page styles that are in use in the "
"document, choose <emph>Insert - Footer - All</emph>."
msgstr ""
"Փաստաթղթում օգտագործվող բոլոր ոճերից էջատակեր ավելացնելու կամ հեռացնելու "
"համար ընտրեք <emph>Տեղադրել - էջատակ - Բոլորը</emph>:"

#: 04230000.xhp#par_id3151187.6.help.text
#: 04230000.xhp%23par_id3151187.6.help.text
msgid ""
"To format a footer, choose <link href=\"text/shared/01/05040300.xhp\" name=\""
"Format - Page - Footer\"><emph>Format - Page - Footer</emph></link>."
msgstr ""
"Էջատակը ձևաչափելու համար, ընտրեք <link href=\"text/shared/01/05040300.xhp\" "
"name=\"Ձևաչափ - Էջ - էջատակ\"><emph>Ձևաչափ - Էջ - էջատակ</emph></link>։"

#: mm_seltab.xhp#tit.help.text
#: mm_seltab.xhp%23tit.help.text
msgctxt "mm_seltab.xhp#tit.help.text"
msgid "Select Table"
msgstr "Ընտրեք աղյուսակը"

