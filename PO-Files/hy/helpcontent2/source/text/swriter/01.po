"<ahelp hid=\"SW:NUMERICFIELD:DLG_INS_ROW_COL:ED_COUNT\">Մուտքագրեք ցանկալի "
"սյունակների կամ տողերի քանակը:</ahelp>"

#: 05120400.xhp#hd_id3145829.6.help.text
#: 05120400.xhp%23hd_id3145829.6.help.text
msgctxt "05120400.xhp#hd_id3145829.6.help.text"
msgid "Position"
msgstr "Դիրք"

#: 05120400.xhp#par_id3154504.11.help.text
