#: 05200000.xhp#par_id3147401.2.help.text
#: 05200000.xhp%23par_id3147401.2.help.text
msgid ""
"<ahelp hid=\".uno:MergeTable\">Combines two consecutive tables into a single "
"table. The tables must be directly next to each other and not separated by "
"an empty paragraph.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:MergeTable\">Երկու անընդմեջ աղյուսակները միավորում է "
"մեկում: Աղյուսակները պետք է լինեն անմիջապես միմյանց կողքին և չբաժանվեն "
"դատարկ պարբերությամբ:</ahelp>"

#: 05200000.xhp#par_id3146325.3.help.text
#: 05200000.xhp%23par_id3146325.3.help.text
msgid ""
"If you choose this command when the cursor is in the middle of three "
"consecutive tables, you are prompted to select the table that you want to "
"merge with."
msgstr ""
"Եթե ընտրում եք այս հրամանը, երբ կուրսորը գտնվում է երեք անընդմեջ "
"աղյուսակների մեջտեղում, ձեզ կառաջարկվի ընտրել այն աղյուսակը, որի հետ "
"ցանկանում եք միաձուլվել:"

