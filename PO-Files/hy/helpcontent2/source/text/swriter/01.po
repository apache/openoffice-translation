msgstr "Լայնություն"

#: 05040500.xhp#par_id3152963.43.help.text
#: 05040500.xhp%23par_id3152963.43.help.text
msgid ""
"<ahelp hid=\"SW_METRICFIELD_TP_COLUMN_ED_3\">Enter the width of the "
"column.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_METRICFIELD_TP_COLUMN_ED_3\">Մուտքագրեք սյունակի "
"լայնությունը:</ahelp>"

#: 05040500.xhp#hd_id3151308.7.help.text
#: 05040500.xhp%23hd_id3151308.7.help.text
msgctxt "05040500.xhp#hd_id3151308.7.help.text"
msgid "Spacing"
msgstr "Միջակայք"

#: 05040500.xhp#par_id3153672.8.help.text
#: 05040500.xhp%23par_id3153672.8.help.text
msgid ""
"<ahelp hid=\"SW_METRICFIELD_TP_COLUMN_ED_DIST2\">Enter the amount of space "
"that you want to leave between the columns.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_METRICFIELD_TP_COLUMN_ED_DIST2\">Մուտքագրեք միջակայքի այն "
"չափը, որը ցանկանում եք թողնել սյունակների միջև:</ahelp>"

#: 05040500.xhp#hd_id3147530.9.help.text
#: 05040500.xhp%23hd_id3147530.9.help.text
msgid "AutoWidth"
msgstr "Ինքնալայնք"

#: 05040500.xhp#par_id3150986.10.help.text
#: 05040500.xhp%23par_id3150986.10.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_TP_COLUMN_CB_AUTO_WIDTH\">Creates columns of equal "
"width.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_TP_COLUMN_CB_AUTO_WIDTH\">Ստեղծում է հավասար "
"լայնության սյունակներ:</ahelp>"

#: 05040500.xhp#par_id3155892.44.help.text
#: 05040500.xhp%23par_id3155892.44.help.text
msgid ""
"The column layout preview only shows the columns and not the surrounding "
"page."
msgstr ""
"Սյունակի դասավորության նախադիտումը ցույց է տալիս միայն սյունակները, և ոչ թե "
"հարակից էջը:"

#: 05040500.xhp#hd_id3149685.11.help.text
#: 05040500.xhp%23hd_id3149685.11.help.text
msgid "Separator line"
msgstr "Բաժանարար գիծ"

#: 05040500.xhp#par_id3154188.12.help.text
#: 05040500.xhp%23par_id3154188.12.help.text
msgid ""
"This area is only available if your layout contains more than one column."
msgstr ""
"Այս տարածքը մատչելի է միայն այն դեպքում, երբ ձեր դասավորությունը պարունակում "
"է մեկից ավելի սյունակ:"

#: 05040500.xhp#hd_id3155775.13.help.text
#: 05040500.xhp%23hd_id3155775.13.help.text
msgid "Line"
msgstr "Գիծ"

#: 05040500.xhp#par_id3159190.14.help.text
#: 05040500.xhp%23par_id3159190.14.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_COLUMN_LB_STYLE\">Select the formatting style for "
"the column separator line. If you do not want a separator line, choose \""
"None\".</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_COLUMN_LB_STYLE\">Ընտրեք սյունակների բաժանարար "
"գծի ձևաչափման ոճը: Եթե բաժանարար գիծ չեք ցանկանում, ընտրեք «Ոչ մեկը»:</ahelp>"

#: 05040500.xhp#hd_id3155184.15.help.text
#: 05040500.xhp%23hd_id3155184.15.help.text
msgctxt "05040500.xhp#hd_id3155184.15.help.text"
msgid "Height"
msgstr "Բարձրություն"

#: 05040500.xhp#par_id3149309.16.help.text
#: 05040500.xhp%23par_id3149309.16.help.text
msgid ""
"<ahelp hid=\"SW_METRICFIELD_TP_COLUMN_ED_HEIGHT\">Enter the length of the "
"separator line as a percentage of the height of the column area.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_METRICFIELD_TP_COLUMN_ED_HEIGHT\">Մուտքագրեք բաժանարար գծի "
"երկարությունը, որպես սյունակի տարածքի բարձրության տոկոս:</ahelp>"

#: 05040500.xhp#hd_id3143271.17.help.text
#: 05040500.xhp%23hd_id3143271.17.help.text
msgctxt "05040500.xhp#hd_id3143271.17.help.text"
msgid "Position"
msgstr "Դիրք"

#: 05040500.xhp#par_id3149485.18.help.text
#: 05040500.xhp%23par_id3149485.18.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_COLUMN_LB_POSITION\">Select the vertical "
"alignment of the separator line. This option is only available if "
"<emph>Height</emph> value of the line is less than 100%.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_COLUMN_LB_POSITION\">Ընտրեք բաժանարար գծի "
"ուղղահայաց հավասարեցումը: Այս տարբերակը հասանելի է միայն այն դեպքում, եթե "
"տողի <emph>Բարձրություն</emph> արժեքը 100% -ից պակաս է:</ahelp>"

#: 05040500.xhp#hd_id3151248.50.help.text
#: 05040500.xhp%23hd_id3151248.50.help.text
msgid "Apply to"
msgstr "Կիրառել"

#: 05040500.xhp#par_id3154827.51.help.text
#: 05040500.xhp%23par_id3154827.51.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_DLG_COLUMN_LB_APPLY_TO\">Select the item that you "
"want to apply the column layout to.</ahelp> This option is only available if "
"you access this dialog by choosing <emph>Format - Columns</emph>."
msgstr ""
"<ahelp hid=\"SW_LISTBOX_DLG_COLUMN_LB_APPLY_TO\">Ընտրեք այն նյութը, որի վրա "
"ցանկանում եք կիրառել սյունակի դասավորությունը:</ahelp> Այս ընտրանքը հասանելի "
"է միայն այն դեպքում, երբ դուք մուտք եք գործում այս երկխոսություն՝ ընտրելով "
"<emph>Ձևաչափ - Սյունակներ</emph>:"

#: 05090100.xhp#tit.help.text
#: 05090100.xhp%23tit.help.text
msgctxt "05090100.xhp#tit.help.text"
msgid "Table"
msgstr "Աղյուսակ"

#: 05090100.xhp#bm_id3154762.help.text
#: 05090100.xhp%23bm_id3154762.help.text
msgid ""
"<bookmark_value>tables; positioning</bookmark_value><bookmark_value>tables; "
"inserting text before</bookmark_value>"
msgstr ""
"<bookmark_value>աղյուսակներ; "
"դիրքավորում</bookmark_value><bookmark_value>աղյուսակներ; տեքստի տեղադրում "
"մինչ</bookmark_value>"

#: 05090100.xhp#hd_id3154762.1.help.text
#: 05090100.xhp%23hd_id3154762.1.help.text
