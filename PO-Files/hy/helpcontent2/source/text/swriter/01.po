#: mailmerge01.xhp#par_idN10543.help.text
#: mailmerge01.xhp%23par_idN10543.help.text
msgid ""
"<link href=\"text/swriter/01/mailmerge01.xhp\">Mail Merge Wizard - Starting "
"Document</link>"
msgstr ""
"<link href=\"text/swriter/01/mailmerge01.xhp\">Փոստի միաձուլման հրաշագործ - "
"Մեկնարկային փաստաթուղթ</link>"

#: mailmerge01.xhp#par_idN10553.help.text
#: mailmerge01.xhp%23par_idN10553.help.text
msgid ""
"Specify the document that you want to use as a base for the mail merge "
"document."
msgstr ""
"Նշեք այն փաստաթուղթը, որը ցանկանում եք օգտագործել որպես փոստի միաձուլման "
"փաստաթղթի հիմք:"

#: mailmerge01.xhp#par_idN10556.help.text
#: mailmerge01.xhp%23par_idN10556.help.text
msgid "Use the current document"
msgstr "Օգտագործեք ընթացիկ փաստաթուղթը։"

#: mailmerge01.xhp#par_idN1055A.help.text
#: mailmerge01.xhp%23par_idN1055A.help.text
msgid ""
"<ahelp hid=\".\">Uses the current Writer document as the base for the mail "
"merge document.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Օգտագործում է ընթացիկ Writer փաստաթուղթը որպես փոստի "
"միաձուլման փաստաթղթի հիմք:</ahelp>"

#: mailmerge01.xhp#par_idN1055D.help.text
#: mailmerge01.xhp%23par_idN1055D.help.text
msgid "Create a new document"
msgstr "Ստեղծել նոր փաստաթուղթ"

#: mailmerge01.xhp#par_idN10561.help.text
#: mailmerge01.xhp%23par_idN10561.help.text
msgid ""
"<ahelp hid=\".\">Creates a new Writer document to use for the mail "
"merge.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ստեղծում է Writer նոր փաստաթուղթ, փոստի միաձուլման "
"համար:</ahelp>"

#: mailmerge01.xhp#par_idN10564.help.text
#: mailmerge01.xhp%23par_idN10564.help.text
msgid "Start from existing document"
msgstr "Սկսեք առկա փաստաթղթից"

#: mailmerge01.xhp#par_idN10568.help.text
#: mailmerge01.xhp%23par_idN10568.help.text
msgid ""
"<ahelp hid=\".\">Select an existing Writer document to use as the base for "
"the mail merge document.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք առկա Writer փաստաթուղթը, որն օգտագործվում է որպես "
"փոստի միաձուլման փաստաթղթի հիմք:</ahelp>"

#: mailmerge01.xhp#par_idN1056B.help.text
#: mailmerge01.xhp%23par_idN1056B.help.text
msgctxt "mailmerge01.xhp#par_idN1056B.help.text"
msgid "Browse"
msgstr "Զննել"

#: mailmerge01.xhp#par_idN1056F.help.text
#: mailmerge01.xhp%23par_idN1056F.help.text
msgid ""
"<ahelp hid=\".\">Locate the Writer document that you want too use, and then "
"click <emph>Open</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Տեղակայեք Writer փաստաթուղթը, որը ցանկանում եք օգտագործել, "
"և այնուհետև կտտացրեք <emph>Բացել</emph>։</ahelp>"

#: mailmerge01.xhp#par_idN10572.help.text
#: mailmerge01.xhp%23par_idN10572.help.text
msgid "Start from a template"
msgstr "Սկսեք ձևանմուշից"

#: mailmerge01.xhp#par_idN10576.help.text
#: mailmerge01.xhp%23par_idN10576.help.text
msgid ""
"<ahelp hid=\".\">Select the template that you want to create your mail merge "
"document with.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք այն ձևանմուշը, որով ցանկանում եք ստեղծել ձեր փոստի "
"միաձուլման փաստաթուղթը:</ahelp>"

#: mailmerge01.xhp#par_idN10579.help.text
#: mailmerge01.xhp%23par_idN10579.help.text
msgctxt "mailmerge01.xhp#par_idN10579.help.text"
msgid "Browse"
msgstr "Զննել"

#: mailmerge01.xhp#par_idN1057D.help.text
#: mailmerge01.xhp%23par_idN1057D.help.text
msgid ""
"<ahelp hid=\".\">Opens the <emph>Templates and Documents</emph> "
"dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է <emph>Ձևանմուշներ և փաստաթղթեր</emph> "
"երկխոսությունը։</ahelp>"

#: mailmerge01.xhp#par_idN10584.help.text
#: mailmerge01.xhp%23par_idN10584.help.text
msgid "Start from a recently saved starting document"
msgstr "Սկսեք վերջերս պահված մեկնարկային փաստաթղթից"

#: mailmerge01.xhp#par_idN10588.help.text
#: mailmerge01.xhp%23par_idN10588.help.text
msgid ""
"<ahelp hid=\".\">Use an existing mail merge document as the base for a new "
"mail merge document.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Օգտագործեք փոստի միաձուլման առկա փաստաթուղթը, որպես փոստի "
"միաձուլման նոր փաստաթղթի հիմք:</ahelp>"

#: mailmerge01.xhp#par_idN106F6.help.text
#: mailmerge01.xhp%23par_idN106F6.help.text
msgid "<ahelp hid=\".\">Select the document.</ahelp>"
msgstr "<ahelp hid=\".\">Ընտրեք փաստաթուղթը:</ahelp>"

#: mailmerge01.xhp#par_idN1058B.help.text
#: mailmerge01.xhp%23par_idN1058B.help.text
msgid ""
"<link href=\"text/swriter/01/mailmerge02.xhp\" name=\"Mail Merge Wizard - "
"Document type\">Mail Merge Wizard - Document type</link>"
msgstr ""
"<link href=\"text/swriter/01/mailmerge02.xhp\" name=\"Փոստի միաձուլման "
"հրաշագործ - Փաստաթղթի տեսակը\">Փոստի միաձուլման հրաշագործ - Փաստաթղթի "
"տեսակը</link>"

#: 06100000.xhp#tit.help.text
#: 06100000.xhp%23tit.help.text
msgctxt "06100000.xhp#tit.help.text"
msgid "Sort"
msgstr "Տեսակավորել"

#: 06100000.xhp#bm_id3149353.help.text
#: 06100000.xhp%23bm_id3149353.help.text
msgid ""
"<bookmark_value>tables;sorting rows</bookmark_value>      "
"<bookmark_value>sorting;paragraphs/table rows</bookmark_value>      "
"<bookmark_value>text; sorting paragraphs</bookmark_value>      "
"<bookmark_value>lines of text; sorting paragraphs</bookmark_value>      "
"<bookmark_value>sorting;paragraphs in special languages</bookmark_value>"
"      <bookmark_value>Asian languages;sorting paragraphs/table "
"rows</bookmark_value>"
msgstr ""
"<bookmark_value>աղյուսակներ;տեսակավորում տողերի</bookmark_value>      "
"<bookmark_value>տեսակավորում;պարբերություններ/աղյուսակի "
"տողեր</bookmark_value>      <bookmark_value>տեքստ; տեսակավորում "
"պարբերություններ</bookmark_value>      <bookmark_value>տեքստի տողեր; "
"տեսակավորում պարբերություններ</bookmark_value>      "
"<bookmark_value>տեսակավորում;պարբերությունները հատուկ "
"լեզուներում</bookmark_value>      <bookmark_value>Ասիական լեզուներ;"
"տեսակավորել պարբերությունները/աղյուսակի տողերը</bookmark_value>"

#: 06100000.xhp#hd_id3149353.1.help.text
#: 06100000.xhp%23hd_id3149353.1.help.text
msgctxt "06100000.xhp#hd_id3149353.1.help.text"
msgid "Sort"
msgstr "Տեսակավորել"

#: 06100000.xhp#par_id3150015.2.help.text
#: 06100000.xhp%23par_id3150015.2.help.text
msgid ""
"<variable id=\"sort\"><ahelp hid=\".uno:SortDialog\">Sorts the selected "
"paragraphs or table rows alphabetically or numerically.</ahelp> You can "
"define up to three sort keys as well as combine alphanumeric and numeric "
"sort keys.</variable>"
msgstr ""
"<variable id=\"sort\"><ahelp hid=\".uno:SortDialog\">տեսակավորում է ընտրված "
"պարբերությունները կամ աղյուսակի տողերը այբբենական կամ թվային կարգով:</ahelp> "
"Կարող եք սահմանել տեսակավորման մինչև երեք բանալի, ինչպես նաև միավորել "
"այբբենական և թվային տեսակավորման ստեղները:</variable>"

#: 06100000.xhp#hd_id3150931.3.help.text
#: 06100000.xhp%23hd_id3150931.3.help.text
msgid "Sort criteria"
msgstr "Տեսակավորման չափանիշ"

#: 06100000.xhp#hd_id3149029.4.help.text
#: 06100000.xhp%23hd_id3149029.4.help.text
msgid "Keys 1 to 3"
msgstr "Ստեղներ 1 մինչև 3"

#: 06100000.xhp#par_id3147170.5.help.text
#: 06100000.xhp%23par_id3147170.5.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:DLG_SORTING:CB_KEY3\">Specifies additional sorting "
"criteria. You can also combine sort keys.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:DLG_SORTING:CB_KEY3\">Նշում է տեսակավորման "
"լրացուցիչ չափանիշները: Կարող եք նաև համադրել տեսակավորման ստեղները:</ahelp>"

#: 06100000.xhp#hd_id3147565.6.help.text
#: 06100000.xhp%23hd_id3147565.6.help.text
msgid "Column 1 to 3"
msgstr "Սյունակ 1-ից մինչև 3"

#: 06100000.xhp#par_id3154644.7.help.text
#: 06100000.xhp%23par_id3154644.7.help.text
msgid ""
"<ahelp hid=\"SW:NUMERICFIELD:DLG_SORTING:ED_KEY3\">Enter the number of the "
"table column that you want to use as a basis for sorting.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:NUMERICFIELD:DLG_SORTING:ED_KEY3\">Մուտքագրեք աղյուսակի "
"սյունակի թիվը, որը ցանկանում եք օգտագործել որպես տեսակավորման հիմք:</ahelp>"

#: 06100000.xhp#hd_id3150254.9.help.text
#: 06100000.xhp%23hd_id3150254.9.help.text
msgid "Key type 1 to 3"
msgstr "Բանալու տեսակ 1 մինչև 3"

#: 06100000.xhp#par_id3149752.10.help.text
#: 06100000.xhp%23par_id3149752.10.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:DLG_SORTING:DLB_KEY3\">Select the sorting option "
"that you want to use.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:DLG_SORTING:DLB_KEY3\">Ընտրեք տեսակավորման "
"տարբերակը, որը ցանկանում եք օգտագործել:</ahelp>"

#: 06100000.xhp#hd_id3151177.16.help.text
#: 06100000.xhp%23hd_id3151177.16.help.text
msgid "Order"
msgstr "Կարգ"

#: 06100000.xhp#hd_id072020090105453.help.text
#: 06100000.xhp%23hd_id072020090105453.help.text
msgid "Ascending"
msgstr "Ըստ Աճման"

#: 06100000.xhp#par_id3154270.18.help.text
#: 06100000.xhp%23par_id3154270.18.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_UP3\">Sorts in ascending order, ("
"for example, 1, 2, 3 or a, b, c).</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_UP3\">Տեսակավորում է ըստ աճման, "
"(օրինակ՝ 1, 2, 3 կամ a, b, c):</ahelp>"

#: 06100000.xhp#hd_id3150708.19.help.text
#: 06100000.xhp%23hd_id3150708.19.help.text
msgid "Descending"
msgstr "Ըստ Նվազման"

#: 06100000.xhp#par_id3152946.20.help.text
#: 06100000.xhp%23par_id3152946.20.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_DN3\">Sorts in descending order ("
"for example, 9, 8, 7 or z, y, x).</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_DN3\">Տեսակավորում է ըստ նվազման "
"(օրինակ՝ 9, 8, 7 կամ z, y, x):</ahelp>"

#: 06100000.xhp#hd_id3149812.11.help.text
#: 06100000.xhp%23hd_id3149812.11.help.text
msgid "Direction"
msgstr "Ուղղություն"

#: 06100000.xhp#hd_id3153540.12.help.text
#: 06100000.xhp%23hd_id3153540.12.help.text
msgctxt "06100000.xhp#hd_id3153540.12.help.text"
msgid "Columns"
msgstr "Սյուներ"

#: 06100000.xhp#par_id3150973.13.help.text
#: 06100000.xhp%23par_id3150973.13.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_COL\">Sorts the columns in the "
"table according to the current sort options.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_COL\">Աղյուսակում սյունակները "
"տեսակավորում է ըստ տեսակավորման ընթացիկ ընտրանքների:</ahelp>"

#: 06100000.xhp#hd_id3147526.14.help.text
#: 06100000.xhp%23hd_id3147526.14.help.text
msgctxt "06100000.xhp#hd_id3147526.14.help.text"
msgid "Rows"
msgstr "Տողեր"

#: 06100000.xhp#par_id3153677.15.help.text
#: 06100000.xhp%23par_id3153677.15.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_ROW\">Sorts the rows in the table "
"or the paragraphs in the selection according to the current sort "
"options.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_ROW\">Տեսակավորում է աղյուսակի "
"տողերը կամ ընտրության պարբերությունները ըստ տեսակավորման ընթացիկ "
"ընտրանքների:</ahelp>"

#: 06100000.xhp#hd_id3151312.21.help.text
#: 06100000.xhp%23hd_id3151312.21.help.text
msgctxt "06100000.xhp#hd_id3151312.21.help.text"
msgid "Separator"
msgstr "Բաժանարար"

#: 06100000.xhp#par_id3150350.22.help.text
#: 06100000.xhp%23par_id3150350.22.help.text
msgid ""
"Paragraphs are separated by nonprinting paragraph marks. You can also "
"specify that tabs or a character act as separators when you sort paragraphs."
msgstr ""
"Պարբերությունները բաժանվում են պարբերության չտպվող նշանների միջոցով: "
"Պարբերությունները տեսակավորելու ժամանակ կարող եք նաև նշել, որ ներդիրները կամ "
"նիշերը հանդես են գալիս որպես բաժանարարներ:"

#: 06100000.xhp#hd_id3154570.23.help.text
#: 06100000.xhp%23hd_id3154570.23.help.text
msgctxt "06100000.xhp#hd_id3154570.23.help.text"
msgid "Tabs"
msgstr "Ներդիրներ"

#: 06100000.xhp#par_id3155902.24.help.text
#: 06100000.xhp%23par_id3155902.24.help.text
msgid ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_TAB\">If the selected paragraphs "
"correspond to a list separated by tabs, select this option.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:RADIOBUTTON:DLG_SORTING:RB_TAB\">Եթե ընտրված "
"պարբերությունները համապատասխանում են ներդիրներով առանձնացված ցուցակին, ապա "
"ընտրեք այս տարբերակը:</ahelp>"

#: 06100000.xhp#hd_id3154190.25.help.text
#: 06100000.xhp%23hd_id3154190.25.help.text
msgctxt "06100000.xhp#hd_id3154190.25.help.text"
msgid "Character"
msgstr "Նիշ"

#: 06100000.xhp#par_id3159196.26.help.text
#: 06100000.xhp%23par_id3159196.26.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:DLG_SORTING:ED_TABCH\">Enter the character that you "
"want to use as a separator in the selected area.</ahelp> By using the "
"separator, $[officename] can determine the position of the sorting key in "
"the selected paragraph."
msgstr ""
"<ahelp hid=\"SW:EDIT:DLG_SORTING:ED_TABCH\">Ընտրված տարածքում մուտքագրեք "
"նիշը, որը ցանկանում եք օգտագործել որպես տարանջատիչ:</ahelp> Օգտագործելով "
"տարանջատիչը՝ $[officename] -ը կարող է որոշել ընտրված պարբերությունում "
"տեսակավորող բանալու դիրքը:"

#: 06100000.xhp#hd_id3151324.31.help.text
#: 06100000.xhp%23hd_id3151324.31.help.text
msgctxt "06100000.xhp#hd_id3151324.31.help.text"
msgid "..."
msgstr "..."

#: 06100000.xhp#par_id3155178.32.help.text
#: 06100000.xhp%23par_id3155178.32.help.text
msgid ""
"<ahelp hid=\"SW_PUSHBUTTON_DLG_SORTING_PB_DELIM\">Opens the <emph>Special "
"Characters</emph> dialog, where you can select the character that you want "
"to use as a separator.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_PUSHBUTTON_DLG_SORTING_PB_DELIM\">Բացում է <emph>Հատուկ "
"նիշեր</emph> երկխոսությունը, որտեղ կարող եք ընտրել այն նիշը, որը ցանկանում "
"եք օգտագործել որպես տարանջատիչ:</ahelp>"

#: 06100000.xhp#hd_id3149482.33.help.text
#: 06100000.xhp%23hd_id3149482.33.help.text
msgctxt "06100000.xhp#hd_id3149482.33.help.text"
msgid "Language"
msgstr "Լեզու"

#: 06100000.xhp#par_id3151252.34.help.text
#: 06100000.xhp%23par_id3151252.34.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_DLG_SORTING_LB_LANG\">Select the language that "
"defines the sorting rules.</ahelp> Some languages sort special characters "
"differently than other languages."
msgstr ""
"<ahelp hid=\"SW_LISTBOX_DLG_SORTING_LB_LANG\">Ընտրեք տեսակավորման կանոնները "
"սահմանող լեզուն:</ahelp> Որոշ լեզուներ հատուկ նիշերը դասավորում են այլ "
"լեզուներից տարբեր:"

#: 06100000.xhp#hd_id3149104.35.help.text
#: 06100000.xhp%23hd_id3149104.35.help.text
msgctxt "06100000.xhp#hd_id3149104.35.help.text"
msgid "Match case"
msgstr "Զգայուն մեծատառի/փոքրատառի նկատմամբ"

#: 06100000.xhp#par_id3154838.36.help.text
#: 06100000.xhp%23par_id3154838.36.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_DLG_SORTING_CB_CASE\">Distinguishes between "
"uppercase and lowercase letters when you sort a table. For Asian languages "
"special handling applies.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_DLG_SORTING_CB_CASE\">Աղյուսակ տեսակավորելիս "
"տարբերակում է մեծատառերը և փոքրատառերը: Ասիական լեզուների համար կիրառվում է "
"հատուկ մոտեցումներ:</ahelp>"

#: 06100000.xhp#par_idN10895.help.text
#: 06100000.xhp%23par_idN10895.help.text
msgid ""
"For Asian languages, select <emph>Match case </emph>to apply multi-level "
"collation. In the multi-level collation, the primitive forms of the entries "
"are first compared with the cases of the forms and diacritics ignored. If "
"the forms are the same, the diacritics of the forms are compared. If the "
"forms are still the same, the cases, character widths, and Japanese Kana "
"differences of the forms are compared."
msgstr ""
"Ասիական լեզուների համար ընտրեք <emph>Համապատասխանեցնել դեպքը</emph> "
"բազմամակարդակ համադրում կիրառելու համար: Բազմամակարդակ համադրման մեջ "
"գրառումների պարզունակ ձևերը նախ համեմատվում են ձևերի և դիակրիտիկների "
"անտեսված դեպքերի հետ: Եթե ձևերը նույնն են, ապա համեմատվում են ձևերի "
"դիակրիտիկները: Եթե ձևերը դեռ նույնն են, ապա համեմատվում են դեպքերը, նիշերի "
"լայնությունները և ճապոնական Կանայի ձևերի տարբերությունները:"

#: 04120225.xhp#tit.help.text
#: 04120225.xhp%23tit.help.text
msgid "Entries (user-defined index)"
msgstr "Մուտքեր (օգտվողի սահմանած ցուցիչ)"

#: 04120225.xhp#hd_id3147406.1.help.text
#: 04120225.xhp%23hd_id3147406.1.help.text
msgid ""
"<link href=\"text/swriter/01/04120225.xhp\" name=\"Entries (user-defined "
"index)\">Entries (user-defined index)</link>"
msgstr ""
"<link href=\"text/swriter/01/04120225.xhp\" name=\"Մուտքեր (օգտվողի սահմանած "
"ցուցիչ)\">Մուտքեր (օգտվողի սահմանած ցուցիչ)</link>"

#: 04120225.xhp#par_id3146318.2.help.text
#: 04120225.xhp%23par_id3146318.2.help.text
msgid ""
"<variable id=\"eintraege\">Specify the format for the entries in a user-"
"defined index. </variable>"
msgstr ""
"<variable id=\"eintraege\">Նշեք մուտքերի ձևաչափը օգտագործողի կողմից "
"սահմանված ցուցիչում: </variable>"

#: 04120225.xhp#par_id3150020.3.help.text
#: 04120225.xhp%23par_id3150020.3.help.text
msgid "User-defined indexes do not support sub-keys."
msgstr "Օգտատիրոջ կողմից սահմանված ցուցիչները չեն ապահովում ենթաբանալիներ:"

#: 06180000.xhp#tit.help.text
#: 06180000.xhp%23tit.help.text
msgctxt "06180000.xhp#tit.help.text"
msgid "Line Numbering"
msgstr "Տողերի համարակալում"

#: 06180000.xhp#hd_id3154705.1.help.text
#: 06180000.xhp%23hd_id3154705.1.help.text
msgctxt "06180000.xhp#hd_id3154705.1.help.text"
msgid "Line Numbering"
msgstr "Տողերի համարակալում"

#: 06180000.xhp#par_id3150249.2.help.text
#: 06180000.xhp%23par_id3150249.2.help.text
msgid ""
"<variable id=\"zeinum\">Adds or removes and formats line numbers in the "
"current document. To exclude a paragraph from line numbering, click in the "
"paragraph, choose <emph>Format - Paragraph</emph>, click the <emph>Numbering "
"</emph>tab, and then clear the <emph>Include this paragraph in line "
"numbering</emph> check box.</variable> You can also exclude a paragraph "
"style from line numbering."
msgstr ""
"<variable id=\"zeinum\">Ընթացիկ փաստաթղթում ավելացնում կամ հեռացնում և "
"ձևաչափում է տողերի համարակալումը: Տողերի համարակալումից պարբերությունը "
"բացառելու համար կտտացրեք պարբերության վրա, ընտրեք <emph>Ձևաչափ - "
"Պարբերություն</emph>, կտտացրեք <emph>Համարակալում</emph> ներդիրին և "
"այնուհետև մաքրեք <emph>Այս պարբերությունը ներառեք տողերի համարակալման "
"մեջ</emph> ընտրավանդակը:</variable> Կարող եք նաև գծի համարակալումից բացառել "
"պարբերության ոճը:"

#: 06180000.xhp#par_id248115.help.text
#: 06180000.xhp%23par_id248115.help.text
msgid "Line numbers are not available in HTML format."
msgstr "Տողերի թվերը հասանելի չեն HTML ձևաչափով:"

#: 06180000.xhp#hd_id3146965.5.help.text
#: 06180000.xhp%23hd_id3146965.5.help.text
msgid "Show numbering"
msgstr "Ցուցադրել համարակալումը"

#: 06180000.xhp#par_id3147295.6.help.text
#: 06180000.xhp%23par_id3147295.6.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_LINENUMBERING:CB_NUMBERING_ON\">Adds line "
"numbers to the current document.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_LINENUMBERING:CB_NUMBERING_ON\">Ընթացիկ "
"փաստաթղթին ավելացնում է տողի համարներ:</ahelp>"

#: 06180000.xhp#hd_id3083449.7.help.text
#: 06180000.xhp%23hd_id3083449.7.help.text
msgid "View"
msgstr "Տեսք"

#: 06180000.xhp#par_id3155621.8.help.text
#: 06180000.xhp%23par_id3155621.8.help.text
msgid "Set the properties of the line numbering."
msgstr "Սահմանեք տողի համարակալման հատկությունները:"

#: 06180000.xhp#hd_id3145822.9.help.text
#: 06180000.xhp%23hd_id3145822.9.help.text
msgctxt "06180000.xhp#hd_id3145822.9.help.text"
msgid "Character Style"
msgstr "Նիշի ոճ"

#: 06180000.xhp#par_id3153000.10.help.text
#: 06180000.xhp%23par_id3153000.10.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_LINENUMBERING:LB_CHAR_STYLE\">Select the "
"formatting style that you want to use for the line numbers.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_LINENUMBERING:LB_CHAR_STYLE\">Ընտրեք ձևավորման "
"ոճը, որը ցանկանում եք օգտագործել տողերի համարների համար:</ahelp>"

#: 06180000.xhp#hd_id3149880.11.help.text
#: 06180000.xhp%23hd_id3149880.11.help.text
msgctxt "06180000.xhp#hd_id3149880.11.help.text"
msgid "Format"
msgstr "Ձևաչափ"

#: 06180000.xhp#par_id3145246.12.help.text
#: 06180000.xhp%23par_id3145246.12.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_LINENUMBERING:LB_FORMAT\">Select the numbering "
"style that you want to use.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_LINENUMBERING:LB_FORMAT\">Ընտրեք համարակալման "
"ոճը, որը ցանկանում եք օգտագործել:</ahelp>"

#: 06180000.xhp#hd_id3150569.13.help.text
#: 06180000.xhp%23hd_id3150569.13.help.text
msgctxt "06180000.xhp#hd_id3150569.13.help.text"
msgid "Position"
msgstr "Դիրք"

#: 06180000.xhp#par_id3150932.14.help.text
#: 06180000.xhp%23par_id3150932.14.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_LINENUMBERING:LB_POS\">Select where you want the "
"line numbers to appear.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_LINENUMBERING:LB_POS\">Ընտրեք, թե որտեղ եք "
"ցանկանում հայտնվեն տողերի համարները:</ahelp>"

#: 06180000.xhp#hd_id3155986.15.help.text
#: 06180000.xhp%23hd_id3155986.15.help.text
msgctxt "06180000.xhp#hd_id3155986.15.help.text"
msgid "Spacing"
msgstr "Բացատավորում"

#: 06180000.xhp#par_id3153719.16.help.text
#: 06180000.xhp%23par_id3153719.16.help.text
msgid ""
"<ahelp hid=\"SW:METRICFIELD:TP_LINENUMBERING:MF_OFFSET\">Enter the amount of "
"space that you want to leave between the line numbers and the text.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:METRICFIELD:TP_LINENUMBERING:MF_OFFSET\">Մուտքագրեք այն "
"տարածությունը, որը ցանկանում եք թողնել տողերի համարների և տեքստի "
"միջև:</ahelp>"

#: 06180000.xhp#hd_id3151183.17.help.text
#: 06180000.xhp%23hd_id3151183.17.help.text
msgid "Interval"
msgstr "Միջակայք"

#: 06180000.xhp#par_id3151272.18.help.text
#: 06180000.xhp%23par_id3151272.18.help.text
msgid ""
"<ahelp hid=\"SW:NUMERICFIELD:TP_LINENUMBERING:NF_NUM_INVERVAL\">Enter the "
"counting interval for the line numbers.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:NUMERICFIELD:TP_LINENUMBERING:NF_NUM_INVERVAL\">Մուտքագրեք "
"տողերի համարների հաշվարկման միջակայքը:</ahelp>"

#: 06180000.xhp#hd_id3156321.19.help.text
#: 06180000.xhp%23hd_id3156321.19.help.text
msgctxt "06180000.xhp#hd_id3156321.19.help.text"
msgid "Separator"
msgstr "Բաժանարար"

#: 06180000.xhp#par_id3150765.20.help.text
#: 06180000.xhp%23par_id3150765.20.help.text
msgid ""
"You can enter a separator character to display between line numbers if the "
"counting interval is more than one."
msgstr ""
"Կարող եք մուտքագրել տարանջատող նիշ տողերի համարների միջև ցուցադրելու համար, "
"եթե հաշվարկի ընդմիջումը մեկից ավելի է:"

#: 06180000.xhp#hd_id3150258.22.help.text
#: 06180000.xhp%23hd_id3150258.22.help.text
msgctxt "06180000.xhp#hd_id3150258.22.help.text"
msgid "Text"
msgstr "Տեքստ"

#: 06180000.xhp#par_id3149286.23.help.text
#: 06180000.xhp%23par_id3149286.23.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_LINENUMBERING:ED_DIVISOR\">Enter the text that you "
"want to use as a separator.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_LINENUMBERING:ED_DIVISOR\">Մուտքագրեք այն տեքստը, "
"որը ցանկանում եք օգտագործել որպես տարանջատիչ:</ahelp>"

#: 06180000.xhp#hd_id3149757.24.help.text
#: 06180000.xhp%23hd_id3149757.24.help.text
msgid "Every"
msgstr "Ամեն"

#: 06180000.xhp#par_id3145412.25.help.text
#: 06180000.xhp%23par_id3145412.25.help.text
msgid ""
"<ahelp hid=\"SW:NUMERICFIELD:TP_LINENUMBERING:NF_DIV_INTERVAL\">Enter the "
"number of lines to leave between the separators.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:NUMERICFIELD:TP_LINENUMBERING:NF_DIV_INTERVAL\">Մուտքագրեք "
"բաժանարարների միջև թողնվող տողերի քանակը:</ahelp>"

#: 06180000.xhp#par_id3153532.26.help.text
#: 06180000.xhp%23par_id3153532.26.help.text
msgid "Separators are only displayed in lines that are not numbered."
msgstr "Բաշանարարները միայն ցուցադրվում են չհամարակալված տողերով:"

#: 06180000.xhp#hd_id3152962.27.help.text
#: 06180000.xhp%23hd_id3152962.27.help.text
msgid "Count"
msgstr "Հաշիվ"

#: 06180000.xhp#par_id3150358.28.help.text
#: 06180000.xhp%23par_id3150358.28.help.text
msgid ""
"Specify whether to include empty paragraphs or lines in text frames in the "
"line count."
msgstr ""
"Նշեք, արդյոք տողերի շրջանակի մեջ դատարկ պարբերություններ կամ տողեր ներառել՝ "
"տողերը հաշվարկելիս:"

#: 06180000.xhp#hd_id3153677.29.help.text
#: 06180000.xhp%23hd_id3153677.29.help.text
msgid "Blank lines"
msgstr "Դատարկ տողեր"

#: 06180000.xhp#par_id3150973.30.help.text
#: 06180000.xhp%23par_id3150973.30.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_LINENUMBERING:CB_COUNT_EMPTYLINES\">Includes "
"empty paragraphs in the line count.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_LINENUMBERING:CB_COUNT_EMPTYLINES\">Տողերի "
"հաշվարկի մեջ ներառում է դատարկ պարբերություններ:</ahelp>"

#: 06180000.xhp#hd_id3154476.31.help.text
#: 06180000.xhp%23hd_id3154476.31.help.text
msgid "Lines in text frames"
msgstr "Տողեր տեքստային շրջանակներում"

#: 06180000.xhp#par_id3150995.32.help.text
#: 06180000.xhp%23par_id3150995.32.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_LINENUMBERING:CB_COUNT_FRAMELINES\">Adds line "
"numbers to text in text frames. The numbering restarts in each text frame, "
"and is excluded from the line count in the main text area of the "
"document.</ahelp> In <link href=\"text/swriter/02/03210000.xhp\" name=\""
"linked frames\">linked frames</link>, the numbering is not restarted."
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_LINENUMBERING:CB_COUNT_FRAMELINES\">Տեքստի "
"շրջանակներում տեքստին ավելացնում է տողերի համարներ: Համարակալումը վերսկսվում "
"է յուրաքանչյուր տեքստի շրջանակներում և մերժվում է փաստաթղթի հիմնական տեքստի "
"տարածքում տողերի հաշվարկից:</ahelp> Այս <link href=\""
"text/swriter/02/03210000.xhp\" name=\"կապված շրջանակներում\">կապված "
"շրջանակներում</link>, համարակալումը չի վերսկսվում։"

#: 06180000.xhp#hd_id3151320.34.help.text
#: 06180000.xhp%23hd_id3151320.34.help.text
msgid "Restart every new page"
msgstr "Վերսկսեք ամեն նոր էջը"

#: 06180000.xhp#par_id3149685.35.help.text
#: 06180000.xhp%23par_id3149685.35.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_TP_LINENUMBERING_CB_RESTART_PAGE\">Restarts line "
"numbering at the top of each page in the document.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_TP_LINENUMBERING_CB_RESTART_PAGE\">Վերագործարկում է "
"փաստաթղթի յուրաքանչյուր էջի վերևի տողի համարակալումը:</ahelp>"

#: 04220000.xhp#tit.help.text
#: 04220000.xhp%23tit.help.text
msgctxt "04220000.xhp#tit.help.text"
msgid "Header"
msgstr "Էջագլուխ"

#: 04220000.xhp#hd_id3146320.1.help.text
#: 04220000.xhp%23hd_id3146320.1.help.text
msgid ""
"<link href=\"text/swriter/01/04220000.xhp\" name=\"Header\">Header</link>"
msgstr ""
"<link href=\"text/swriter/01/04220000.xhp\" name=\"Էջագլուխ\">Էջագլուխ</link>"

#: 04220000.xhp#par_id3145827.2.help.text
#: 04220000.xhp%23par_id3145827.2.help.text
msgid ""
"<ahelp hid=\".uno:InsertPageHeader\">Adds or removes a header from the page "
"style that you select in the submenu. The header is added to all of the "
"pages that use the same page style.</ahelp> In a new document, only the \""
"Default\" page style is listed. Other page styles are added to the list "
"after you apply them in the document."
msgstr ""
"<ahelp hid=\".uno:InsertPageHeader\">Էջի ոճից ավելացնում կամ հեռացնում է "
"էջագլուխը, որը ընտրում եք ենթաընտրացանկում: Էջագլուխն ավելացվում է բոլոր այն "
"էջերին, որոնք օգտագործում են նույն էջի ոճը:</ahelp> Նոր փաստաթղթում նշված է "
"միայն էջի «Լռելյայն» ոճը: Փաստաթղթում դրանք կիրառելուց հետո էջի այլ ոճերը "
"ավելացվում են ցուցակին:"

#: 04220000.xhp#par_id2326425.help.text
#: 04220000.xhp%23par_id2326425.help.text
msgid ""
"The headers are visible only when you view the document in print layout ("
"enable <emph>View - Print Layout</emph>)."
msgstr ""
"Էջագլուխները տեսանելի են միայն այն ժամանակ, երբ դուք փաստաթուղթը դիտում եք "
"տպելու դասավորության մեջ (միացնել <emph>Դիտել - Տպել դասավորությունը</emph>):"

#: 04220000.xhp#par_id3150570.3.help.text
#: 04220000.xhp%23par_id3150570.3.help.text
msgid ""
"A check mark is displayed in front of the page styles that have headers."
msgstr "Էջագլուխ ունեցող էջերի ոճերի դիմաց, արտածվում է ստուգման նշանը:"

#: 04220000.xhp#par_id3153921.4.help.text
#: 04220000.xhp%23par_id3153921.4.help.text
msgid ""
"To remove a header, choose <emph>Insert - Header</emph>, and then select the "
"page style containing the header. The header is removed from all of the "
"pages that use this page style."
msgstr ""
"Գլխագիրը հեռացնելու համար ընտրեք <emph>Տեղադրել - Գլխագիր</emph>, ապա ընտրեք "
"գլխագիրը պարունակող էջի ոճը: Գլխագիրը հեռացվում է էջի այս ոճն օգտագործող "
"բոլոր էջերից:"

#: 04220000.xhp#par_id3150761.5.help.text
#: 04220000.xhp%23par_id3150761.5.help.text
msgid ""
"To add or remove headers from all of the page styles that are in use in the "
"document, choose <emph>Insert - Header - All</emph>."
msgstr ""
"Փաստաթղթում օգտագործվող էջի բոլոր ոճերից գլխագրեր ավելացնելու կամ հեռացնելու "
"համար ընտրեք <emph>Տեղադրել - Գլխագիր - Բոլորը</emph>։"

#: 04220000.xhp#par_id3156410.6.help.text
#: 04220000.xhp%23par_id3156410.6.help.text
msgid ""
"To format a header, choose <link href=\"text/shared/01/05040300.xhp\" name=\""
"Format - Page - Header\"><emph>Format - Page - Header</emph></link>."
msgstr ""
"Գլխագիրը ձևաչափելու համար, ընտրեք <link href=\"text/shared/01/05040300.xhp\" "
"name=\"Ձևաչափ - Էջ - Գլխագիր\"><emph>Ձևաչափ - Էջ - Գլխագիր</emph></link>։"

#: 06120000.xhp#tit.help.text
#: 06120000.xhp%23tit.help.text
msgid "Page Formatting"
msgstr "Էջի ձևաչափում"

#: 06120000.xhp#hd_id3155961.1.help.text
#: 06120000.xhp%23hd_id3155961.1.help.text
msgid ""
"<link href=\"text/swriter/01/06120000.xhp\" name=\"Page Formatting\">Page "
"Formatting</link>"
msgstr ""
"<link href=\"text/swriter/01/06120000.xhp\" name=\"Էջի ձևաչափում\">Էջի "
"ձևաչափում</link>"

#: 06120000.xhp#par_id3150249.2.help.text
#: 06120000.xhp%23par_id3150249.2.help.text
msgid ""
"<ahelp visibility=\"visible\" hid=\".uno:Repaginate\">Updates the page "
"formats in the document and recalculates the total number of pages that is "
"displayed on the <emph>Status Bar</emph>.</ahelp>"
msgstr ""
"<ahelp visibility=\"visible\" hid=\".uno:Repaginate\">Փաստաթղթում թարմացվում "
"են էջի ձևաչափերը և վերահաշվում էջերի ընդհանուր քանակը, որոնք ցուցադրվում են "
"<emph>Կարգավիճակի տողում</emph>։</ahelp>"

#: 06120000.xhp#par_id3154766.4.help.text
#: 06120000.xhp%23par_id3154766.4.help.text
msgid "In long documents, updating the page formatting can take a while."
msgstr "Երկար փաստաթղթերում էջի ձևավորման թարմացումը կարող է տևել որոշ ժամանակ:"

#: 04060000.xhp#tit.help.text
#: 04060000.xhp%23tit.help.text
msgctxt "04060000.xhp#tit.help.text"
msgid "Caption"
msgstr "Անվանում"

#: 04060000.xhp#hd_id3147173.1.help.text
#: 04060000.xhp%23hd_id3147173.1.help.text
msgid ""
"<link href=\"text/swriter/01/04060000.xhp\" name=\"Caption\">Caption</link>"
msgstr ""
"<link href=\"text/swriter/01/04060000.xhp\" name=\"Անվանում\">Անվանում</link>"

#: 04060000.xhp#par_id3149288.2.help.text
#: 04060000.xhp%23par_id3149288.2.help.text
msgid ""
"<variable id=\"beschrifttext\"><ahelp hid=\"HID_DLG_CAPTION\">Adds a "
"numbered caption to a selected graphic, table, frame, text frame, or drawing "
"object.</ahelp> You can also access this command by right-clicking the item "
"that you want to add the caption to. </variable>"
msgstr ""
"<variable id=\"beschrifttext\"><ahelp hid=\"HID_DLG_CAPTION\">Ընտրված "
"գրաֆիկին, աղյուսակին, շրջանակին, տեքստի շրջանակին կամ նկարչական օբյեկտին "
"ավելացնում է համարակալված անվանում:</ahelp> Կարող եք նաև մուտք գործել այս "
"հրաման՝ աջ կտտացնելով այն կետին, որին ցանկանում եք ավելացնել անվանումը: "
"</variable>"

#: 04060000.xhp#hd_id3154098.3.help.text
#: 04060000.xhp%23hd_id3154098.3.help.text
msgctxt "04060000.xhp#hd_id3154098.3.help.text"
msgid "Properties"
msgstr "Հատկություններ"

#: 04060000.xhp#par_id3149804.4.help.text
#: 04060000.xhp%23par_id3149804.4.help.text
msgid "Set the caption options for the current selection."
msgstr "Սահմանեք անվանման տարբերակները ընթացիկ ընտրության համար:"

#: 04060000.xhp#hd_id3153533.5.help.text
#: 04060000.xhp%23hd_id3153533.5.help.text
msgctxt "04060000.xhp#hd_id3153533.5.help.text"
msgid "Category"
msgstr "Դաս"

#: 04060000.xhp#par_id3154574.6.help.text
#: 04060000.xhp%23par_id3154574.6.help.text
msgid ""
"<ahelp hid=\"SW:COMBOBOX:DLG_CAPTION:BOX_CATEGORY\">Select the caption "
"category, or type a name to create a new category. The category text appears "
"before the caption number in the caption label. Each predefined caption "
"category is formatted with a paragraph style of the same name. </ahelp> For "
"example, the \"Illustration\" caption category is formatted with the \""
"Illustration\" paragraph style."
msgstr ""
"<ahelp hid=\"SW:COMBOBOX:DLG_CAPTION:BOX_CATEGORY\">Ընտրեք անվանման դասը կամ "
"մուտքագրեք անուն՝ նոր դաս ստեղծելու համար: Դասի տեքստը հայտնվում է անվանման "
"պիտակի անվանման թվից առաջ: Անվանման յուրաքանչյուր նախորոշված դաս ձևափոխվում "
"է համանուն պարբերության ոճով: </ahelp> Օրինակ, «Նկարազարդում» անվանման դասը "
"ձևաչափված է «Պատկերազարդ» պարբերության ոճով:"

#: 04060000.xhp#hd_id3153675.7.help.text
#: 04060000.xhp%23hd_id3153675.7.help.text
msgctxt "04060000.xhp#hd_id3153675.7.help.text"
msgid "Numbering"
msgstr "Համարակալում"

#: 04060000.xhp#par_id3152962.8.help.text
#: 04060000.xhp%23par_id3152962.8.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:DLG_CAPTION:BOX_FORMAT\">Select the type of "
"numbering that you want to use in the caption.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:DLG_CAPTION:BOX_FORMAT\">Ընտրեք համարակալման այն "
"տեսակը, որը ցանկանում եք օգտագործել անվանման մեջ:</ahelp>"

#: 04060000.xhp#hd_id3155893.9.help.text
#: 04060000.xhp%23hd_id3155893.9.help.text
msgctxt "04060000.xhp#hd_id3155893.9.help.text"
msgid "Caption"
msgstr "Անվանում"

#: 04060000.xhp#par_id3149688.10.help.text
#: 04060000.xhp%23par_id3149688.10.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:DLG_CAPTION:EDT_TEXT\">Type the text that you want to "
"appear after the caption number.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:EDIT:DLG_CAPTION:EDT_TEXT\">Մուտքագրեք այն տեքստը, որը "
"ցանկանում եք որ հայտնվի անվանման թվից հետո:</ahelp>"

#: 04060000.xhp#par_idN1068A.help.text
#: 04060000.xhp%23par_idN1068A.help.text
msgctxt "04060000.xhp#par_idN1068A.help.text"
msgid "Separator"
msgstr "Բաժանարար"

#: 04060000.xhp#par_idN10690.help.text
#: 04060000.xhp%23par_idN10690.help.text
msgid ""
"<ahelp hid=\".\">Enter optional text characters to appear between the number "
"and the caption text.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Մուտքագրեք կամընտրովի տեքստի նիշերը, թվերի և անվանման "
"տեքստի միջև հայտնվելու համար:</ahelp>"

#: 04060000.xhp#hd_id3154199.11.help.text
#: 04060000.xhp%23hd_id3154199.11.help.text
msgctxt "04060000.xhp#hd_id3154199.11.help.text"
msgid "Position"
msgstr "Դիրք"

#: 04060000.xhp#par_id3149486.12.help.text
#: 04060000.xhp%23par_id3149486.12.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:DLG_CAPTION:BOX_POS\">Adds the caption above or "
"below the selected item. This option is only available for some "
"objects.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:DLG_CAPTION:BOX_POS\">Ավելացնում է անվանումը ընտրված "
"նյութի վերևում կամ ներքևում: Այս տարբերակը հասանելի է միայն որոշ առարկաների "
"համար:</ahelp>"

#: 04060000.xhp#hd_id3149043.29.help.text
#: 04060000.xhp%23hd_id3149043.29.help.text
msgid ""
"<link href=\"text/swriter/01/04060100.xhp\" name=\"Options\">Options</link>"
msgstr ""
"<link href=\"text/swriter/01/04060100.xhp\" name=\"Ընտրանքներ\""
">Ընտրանքներ</link>"

#: 04060000.xhp#par_idN10744.help.text
#: 04060000.xhp%23par_idN10744.help.text
msgid "AutoCaption"
msgstr "Ինքնաանվանում"

#: 04060000.xhp#par_idN1074A.help.text
#: 04060000.xhp%23par_idN1074A.help.text
msgid ""
"<ahelp hid=\".\">Opens the Caption dialog. It has the same information as "
"the dialog you get by menu %PRODUCTNAME Writer - AutoCaption in the Options "
"dialog box.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է Անվանում երկխոսությունը: Այն ունի նույն "
"տեղեկատվությունը, ինչ երկխոսությունը, որը ստանում եք %PRODUCTNAME Writer - "
"Ինքնաանվանում ընտրացանկով, Ընտրանքներ երկխոսության դաշտում:</ahelp>"

#: 01150000.xhp#tit.help.text
#: 01150000.xhp%23tit.help.text
msgctxt "01150000.xhp#tit.help.text"
msgid "Mail Merge"
msgstr "Փոստի միաձուլում"

#: 01150000.xhp#hd_id3150757.1.help.text
#: 01150000.xhp%23hd_id3150757.1.help.text
msgctxt "01150000.xhp#hd_id3150757.1.help.text"
msgid "Mail Merge"
msgstr "Փոստի միաձուլում"

#: 01150000.xhp#par_id3151187.2.help.text
#: 01150000.xhp%23par_id3151187.2.help.text
msgid ""
"<variable id=\"serienbrieftext\"><ahelp hid=\".uno:MergeDialog\">Opens the "
"<emph>Mail Merge</emph> dialog, which helps you in printing and saving form "
"letters.</ahelp></variable>"
msgstr ""
"<variable id=\"serienbrieftext\"><ahelp hid=\".uno:MergeDialog\">Բացում է "
"<emph>Փոստի միաձուլում</emph> երկխոսությունը, որն օգնում է ձեզ տպել և "
"պահպանել ձևաթղթեր:</ahelp></variable>"

#: 01150000.xhp#par_id3154102.4.help.text
#: 01150000.xhp%23par_id3154102.4.help.text
msgid ""
"During printing, the database information replaces the corresponding "
"database fields (placeholders). For more information about inserting "
"database fields refer to the <link href=\"text/swriter/01/04090006.xhp\" "
"name=\"Database\"><emph>Database</emph></link> tab page under <emph>Insert - "
"Fields - Other</emph>."
msgstr ""
"Տպելու ընթացքում տվյալների շտեմարանի տեղեկատվությունը փոխարինում է տվյալների "
"շտեմարանի համապատասխան դաշտերին (տեղապահներ): Տվյալների շտեմարանի դաշտերը "
"տեղադրելու լրացուցիչ տեղեկությունների համար, տե՛ս <link href=\""
"text/swriter/01/04090006.xhp\" name=\"Շտեմարան\"><emph>Շտեմարան</emph></link>"
" ներդիրի էջը, <emph>Տեղադրել - Դաշտեր - Այլ</emph> ներքո։"

#: 01150000.xhp#par_id8186895.help.text
#: 01150000.xhp%23par_id8186895.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Select a database and table.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ընտրեք շտեմարանը և աղյուսակը։</ahelp>"

#: 01150000.xhp#par_id3101901.help.text
#: 01150000.xhp%23par_id3101901.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Click to create one big document "
"containing all data records.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Սեղմեք՝ ստեղծելու մեկ մեծ փաստաթուղթ, "
"որը պարունակում է տվյալների բոլոր գրառումները:</ahelp>"

#: 01150000.xhp#par_id5345011.help.text
#: 01150000.xhp%23par_id5345011.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Click to create one document for "
"every one data record.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Սեղմեք՝ տվյալների յուրաքանչյուր "
"գրառման համար մեկ փաստաթուղթ ստեղծելու նպատակով:</ahelp>"

#: 01150000.xhp#par_id5631580.help.text
#: 01150000.xhp%23par_id5631580.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Generate each file name from data "
"contained in a database.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Գեներացրեք յուրաքանչյուր նիշքի "
"անունը, շտեմարանում պարունակվող տվյալներից:</ahelp>"

#: 01150000.xhp#par_id8992889.help.text
#: 01150000.xhp%23par_id8992889.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Select the file format.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Ընտրեք նիշքի ձևաչափը։</ahelp>"

#: 01150000.xhp#hd_id3154482.5.help.text
