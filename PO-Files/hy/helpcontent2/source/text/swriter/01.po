msgid "Arabic numerals"
msgstr "Արաբական թվեր"

#: 06060100.xhp#par_id3149298.36.help.text
#: 06060100.xhp%23par_id3149298.36.help.text
msgctxt "06060100.xhp#par_id3149298.36.help.text"
msgid "A,... AA,... AAA,..."
msgstr "A,... AA,... AAA,..."

#: 06060100.xhp#par_id3151332.37.help.text
#: 06060100.xhp%23par_id3151332.37.help.text
msgid ""
"Alphabetical numbering with identical capital letters, where the number of "
"letters indicates the chapter level. For example, the second number in level "
"three is \"BBB\"."
msgstr ""
"Այբբենական համարակալում` նույնատիպ մեծատառերով, որտեղ տառերի քանակը ցույց է "
"տալիս գլխի մակարդակը: Օրինակ, երրորդ մակարդակի երկրորդ թիվը \"BBB\" է:"

#: 06060100.xhp#par_id3143284.38.help.text
#: 06060100.xhp%23par_id3143284.38.help.text
msgctxt "06060100.xhp#par_id3143284.38.help.text"
msgid "a,... aa,... aaa,..."
msgstr "a,... aa,... aaa,..."

#: 06060100.xhp#par_id3149820.39.help.text
#: 06060100.xhp%23par_id3149820.39.help.text
msgid ""
"Alphabetical numbering with identical lower case letters, where the number "
"of letters indicates the chapter level. For example, the third number in "
"level two is \"cc\"."
msgstr ""
"Այբբենական համարակալում` նույնատիպ փոքրատառերով, որտեղ տառերի քանակը ցույց է "
"տալիս գլխի մակարդակը: Օրինակ, երկրորդ մակարդակի երրորդ թիվը \"cc\" է:"

#: 06060100.xhp#par_id3154834.26.help.text
#: 06060100.xhp%23par_id3154834.26.help.text
msgctxt "06060100.xhp#par_id3154834.26.help.text"
msgid "None"
msgstr "Ոչ մեկը"

#: 06060100.xhp#par_id3148968.27.help.text
#: 06060100.xhp%23par_id3148968.27.help.text
msgid ""
"No numbering symbol. Only the character or symbol defined in the "
"<emph>Separator</emph> fields appears at the beginning of the numbered line."
msgstr ""
"Համարակալման նիշ չկա: Համարակալված տողի սկզբում հայտնվում է միայն "
"<emph>Բաժանարար</emph> դաշտերում սահմանված նիշը:"

#: 06060100.xhp#hd_id3147098.40.help.text
#: 06060100.xhp%23hd_id3147098.40.help.text
msgctxt "06060100.xhp#hd_id3147098.40.help.text"
msgid "Character Style"
msgstr "Նիշի ոճ"

#: 06060100.xhp#par_id3147224.41.help.text
#: 06060100.xhp%23par_id3147224.41.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_OUTLINE_NUM:LB_CHARFMT\">Select the format of the "
"numbering character.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_OUTLINE_NUM:LB_CHARFMT\">Ընտրեք համարակալման նիշի "
"ձևաչափը:</ahelp>"

#: 06060100.xhp#hd_id3153643.28.help.text
#: 06060100.xhp%23hd_id3153643.28.help.text
msgid "Show sublevels"
msgstr "Ցույց տվեք ենթամակարդակները"

#: 06060100.xhp#par_id3147575.29.help.text
#: 06060100.xhp%23par_id3147575.29.help.text
msgid ""
"<ahelp hid=\"SW:NUMERICFIELD:TP_OUTLINE_NUM:NF_ALL_LEVEL\">Select the number "
"of outline levels to include in the chapter numbering. For example, select \""
"3\" to display three levels of chapter numbering: 1.1.1</ahelp>"
msgstr ""
"<ahelp hid=\"SW:NUMERICFIELD:TP_OUTLINE_NUM:NF_ALL_LEVEL\">Ընտրեք ուրվագծերի "
"մակարդակների քանակը` գլխի համարակալման մեջ ներառելու համար: Օրինակ, ընտրեք "
"«3» -ը` գլուխների համարակալման երեք մակարդակները ցուցադրելու համար՝ "
"1.1.1</ahelp>"

#: 06060100.xhp#hd_id3152772.30.help.text
#: 06060100.xhp%23hd_id3152772.30.help.text
msgid "Separator Before"
msgstr "Բաժանարարը մինչև"

#: 06060100.xhp#par_id3155142.31.help.text
#: 06060100.xhp%23par_id3155142.31.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_OUTLINE_NUM:ED_PREFIX\">Enter the text that you want "
"to display before the chapter number.</ahelp> For example, type \"Chapter \" "
"to display \"Chapter 1\"."
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_OUTLINE_NUM:ED_PREFIX\">Մուտքագրեք այն տեքստը, որը "
"ցանկանում եք ցուցադրել գլխի թվից առաջ:</ahelp> Օրինակ՝ «Գլուխ 1» -ը "
"ցուցադրելու համար մուտքագրեք «Գլուխ»:"

#: 06060100.xhp#hd_id3154386.32.help.text
#: 06060100.xhp%23hd_id3154386.32.help.text
msgid "Separator After"
msgstr "Բաժանարարը հետո"

#: 06060100.xhp#par_id3153358.33.help.text
#: 06060100.xhp%23par_id3153358.33.help.text
msgid ""
"<ahelp hid=\"SW:EDIT:TP_OUTLINE_NUM:ED_SUFFIX\">Enter the text that you want "
"to display after the chapter number.</ahelp> For example, type a period (.) "
"to display \"1.\""
msgstr ""
"<ahelp hid=\"SW:EDIT:TP_OUTLINE_NUM:ED_SUFFIX\">Մուտքագրեք այն տեքստը, որը "
"ցանկանում եք ցուցադրել գլխի թվից հետո:</ahelp> Օրինակ ՝ «1.» - ը ցուցադրելու "
"համար մուտքագրեք կետ (.):"

#: 06060100.xhp#hd_id3150590.6.help.text
#: 06060100.xhp%23hd_id3150590.6.help.text
msgctxt "06060100.xhp#hd_id3150590.6.help.text"
msgid "Start at"
msgstr "Սկսել"

#: 06060100.xhp#par_id3151023.7.help.text
#: 06060100.xhp%23par_id3151023.7.help.text
msgid ""
"<ahelp hid=\"SW:NUMERICFIELD:TP_OUTLINE_NUM:ED_START\">Enter the number that "
"you want to restart the chapter numbering at.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:NUMERICFIELD:TP_OUTLINE_NUM:ED_START\">Մուտքագրեք այն թիվը, "
"որից ցանկանում եք վերսկսել գլխի համարակալումը:</ahelp>"

#: 05140000.xhp#tit.help.text
#: 05140000.xhp%23tit.help.text
msgid "Styles and Formatting"
msgstr "Ոճեր և ձևաչափում"

#: 05140000.xhp#bm_id3907589.help.text
#: 05140000.xhp%23bm_id3907589.help.text
msgid ""
"<bookmark_value>Styles and Formatting window;applying styles</bookmark_value>"
msgstr ""
"<bookmark_value>Ոճերը և ձևաչափման պատուհան;ոճերի կիրառում</bookmark_value>"

#: 05140000.xhp#hd_id3154505.1.help.text
#: 05140000.xhp%23hd_id3154505.1.help.text
msgid ""
"<link href=\"text/swriter/01/05140000.xhp\" name=\"Styles and Formatting\">"
"Styles and Formatting</link>"
msgstr ""
"<link href=\"text/swriter/01/05140000.xhp\" name=\"Ոճեր և ձևաչափում\">Ոճեր և "
"ձևաչափում</link>"

#: 05140000.xhp#par_id3148391.2.help.text
#: 05140000.xhp%23par_id3148391.2.help.text
msgid ""
"<ahelp hid=\".\">Use the Styles and Formatting window to apply, create, "
"edit, add, and remove formatting styles. Double-click an entry to apply the "
"style.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ձևաչափման ոճերը կիրառելու, ստեղծելու, խմբագրելու, "
"ավելացնելու և հեռացնելու համար օգտագործեք Ոճեր և ձևավորում պատուհանը: Ոճը "
"կիրառելու համար կրկնակի սեղմեք գրառմանը:</ahelp>"

#: 05140000.xhp#par_id0122200903183687.help.text
#: 05140000.xhp%23par_id0122200903183687.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Choose Edit Paragraph Style in the "
"context menu of a paragraph to edit the style of all paragraphs of the same "
"style.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Պարբերության համատեքստային "
"ընտրացանկում ընտրեք Խմբագրել Պարբերության Ոճը՝ նույն ոճի բոլոր "
"պարբերությունների ոճերը խմբագրելու համար:</ahelp>"

#: 05140000.xhp#par_idN106EF.help.text
#: 05140000.xhp%23par_idN106EF.help.text
msgid ""
"To <link href=\"text/shared/00/00000005.xhp#andocken\" name=\"dock\""
">dock</link> the Styles and Formatting window, drag its title bar to the "
"left or to the right side of the workspace. To undock the window, double-"
"click a free space on its toolbar."
msgstr ""
"Որպեսզի <link href=\"text/shared/00/00000005.xhp#andocken\" name=\"կառանվի\""
">կառանվի</link> Ոճեր և Ձևաչափում պատուհանը, քաշեք դրա վերնագրի տողը "
"աշխատանքային տարածքի ձախ կամ աջ կողմում: Պատուհանը ապակողպելու համար կրկնակի "
"կտտացրեք նրա գործիքագոտու ազատ տարածությունում:"

#: 05140000.xhp#hd_id3147167.37.help.text
#: 05140000.xhp%23hd_id3147167.37.help.text
msgid "How to apply a style:"
msgstr "Ինչպես կիրառել ոճը"

#: 05140000.xhp#par_id3151264.38.help.text
#: 05140000.xhp%23par_id3151264.38.help.text
msgid ""
"Select the text. To apply a Character Style to one word, click the word. To "
"apply a Paragraph Style, click the paragraph."
msgstr ""
"Ընտրեք տեքստը: Մեկ բառի վրա Նիշերի ոճը կիրառելու համար կտտացրեք բառին: "
"Պարբերության ոճ կիրառելու համար կտտացրեք պարբերությանը:"

#: 05140000.xhp#par_id3150756.39.help.text
#: 05140000.xhp%23par_id3150756.39.help.text
msgid "Double-click the style in the Styles and Formatting window."
msgstr "Ոճեր և Ձևաչափում պատուհանում կրկնակի սեղմեք ոճը:"

#: 05140000.xhp#par_idN1071D.help.text
#: 05140000.xhp%23par_idN1071D.help.text
msgid ""
"You can assign shortcut keys to Styles on the <emph>Tools - Customize - "
"Keyboard</emph> tab page."
msgstr ""
"Կարող եք դյուրանցման ստեղներ նշանակել Ոճերին <emph>Գործիքներ - "
"Անհատականացնել - Ստեղնաշար</emph> ներդիրի էջում:"

#: 05140000.xhp#par_id3154643.4.help.text
#: 05140000.xhp%23par_id3154643.4.help.text
msgid ""
"The Styles and Formatting toolbar contains icons for formatting your "
"documents:"
msgstr ""
"Ոճեր և Ձևաչափում գործիքագոտին պարունակում է պատկերակներ ձեր փաստաթղթերը "
"ձևաչափելու համար."

#: 05140000.xhp#hd_id3153146.5.help.text
#: 05140000.xhp%23hd_id3153146.5.help.text
msgctxt "05140000.xhp#hd_id3153146.5.help.text"
msgid "Style Category"
msgstr "Ոճի դաս"

#: 05140000.xhp#par_id3147506.help.text
#: 05140000.xhp%23par_id3147506.help.text
msgid ""
"<image id=\"img_id3147512\" src=\"sfx2/res/styfam2.png\" width=\"0.1665in\" "
"height=\"0.1665in\"><alt id=\"alt_id3147512\">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3147512\" src=\"sfx2/res/styfam2.png\" width=\"0.1665in\" "
"height=\"0.1665in\"><alt id=\"alt_id3147512\">Պատկերակ</alt></image>"

#: 05140000.xhp#par_id3154106.6.help.text
#: 05140000.xhp%23par_id3154106.6.help.text
msgctxt "05140000.xhp#par_id3154106.6.help.text"
msgid "Paragraph Styles"
msgstr "Պարբերության ոճեր"

#: 05140000.xhp#par_id3149800.7.help.text
#: 05140000.xhp%23par_id3149800.7.help.text
msgid ""
"<ahelp hid=\".uno:ParaStyle\">Displays formatting styles for "
"paragraphs.</ahelp> Use paragraph styles to apply the same <link href=\""
"text/shared/00/00000005.xhp#formatierung\" name=\"formatting\""
">formatting</link>, such as font, numbering, and layout to the paragraphs in "
"your document."
msgstr ""
"<ahelp hid=\".uno:ParaStyle\">Ցուցադրում է պարբերությունների ձևաչափման "
"ոճերը:</ahelp> Օգտագործեք պարբերության ոճերը նույն <link href=\""
"text/shared/00/00000005.xhp#formatierung\" name=\"ձևաչափումը\""
">ձևաչափումը</link> կիրառելու համար, ինչպիսիք են տառատեսակը, համարակալումը և "
"ձեր փաստաթղթի պարբերությունների դասավորությունը:"

#: 05140000.xhp#par_id3151319.help.text
#: 05140000.xhp%23par_id3151319.help.text
msgid ""
"<image id=\"img_id3152955\" src=\"sfx2/res/styfam1.png\" width=\"0.1665in\" "
"height=\"0.1665in\"><alt id=\"alt_id3152955\">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3152955\" src=\"sfx2/res/styfam1.png\" width=\"0.1665in\" "
"height=\"0.1665in\"><alt id=\"alt_id3152955\">Պատկերակ</alt></image>"

#: 05140000.xhp#par_id3150351.8.help.text
#: 05140000.xhp%23par_id3150351.8.help.text
msgctxt "05140000.xhp#par_id3150351.8.help.text"
msgid "Character Styles"
msgstr "Նիշերի ոճեր"

#: 05140000.xhp#par_id3154570.9.help.text
#: 05140000.xhp%23par_id3154570.9.help.text
msgid ""
"<ahelp hid=\".uno:CharStyle\">Displays formatting styles for "
"characters.</ahelp> Use character styles to apply font styles to selected "
"text in a paragraph."
msgstr ""
"<ahelp hid=\".uno:CharStyle\">Ցուցադրում է նիշերի ձևավորման ոճերը:</ahelp> "
"Օգտագործեք նիշերի ոճերը, պարբերության մեջ ընտրված տեքստի տառատեսակների ոճերը "
"կիրառելու համար:"

#: 05140000.xhp#par_id3159194.help.text
#: 05140000.xhp%23par_id3159194.help.text
msgid ""
"<image id=\"img_id3159200\" src=\"sw/imglst/sf03.png\" width=\"0.1665in\" "
"height=\"0.1665in\"><alt id=\"alt_id3159200\">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3159200\" src=\"sw/imglst/sf03.png\" width=\"0.1665in\" "
