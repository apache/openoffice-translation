msgid "Preview"
msgstr "Նախադիտում"

#: mm_seltab.xhp#par_idN1055B.help.text
#: mm_seltab.xhp%23par_idN1055B.help.text
msgid ""
"<ahelp hid=\".\">Opens the <emph>Mail Merge Recipients</emph> dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է <emph>Փոստի ձուլման ստացողներ</emph> "
"երկխոսությունը։</ahelp>"

#: 04120217.xhp#tit.help.text
#: 04120217.xhp%23tit.help.text
msgctxt "04120217.xhp#tit.help.text"
