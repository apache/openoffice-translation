msgid "Numbering"
msgstr "Թվագրում"

#: 06080100.xhp#par_id3150568.12.help.text
#: 06080100.xhp%23par_id3150568.12.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_FOOTNOTEOPTION:LB_NUMVIEW\">Select the numbering "
"style that you want to use for footnotes or endnotes.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_FOOTNOTEOPTION:LB_NUMVIEW\">Ընտրեք թվագրման ոճը, "
"որը ցանկանում եք օգտագործել էջատակի կամ տողատակի ծանոթագրությունների "
"համար:</ahelp>"

#: 06080100.xhp#par_id3147570.13.help.text
#: 06080100.xhp%23par_id3147570.13.help.text
msgctxt "06080100.xhp#par_id3147570.13.help.text"
msgid "Selection"
msgstr "Ընտրություն"

#: 06080100.xhp#par_id3151180.14.help.text
#: 06080100.xhp%23par_id3151180.14.help.text
