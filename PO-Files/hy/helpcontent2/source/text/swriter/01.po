msgstr "<link href=\"text/swriter/01/05120500.xhp\" name=\"Ջնջել\">Ջնջել</link>"

#: 05120500.xhp#par_id3153418.2.help.text
#: 05120500.xhp%23par_id3153418.2.help.text
msgid ""
"<variable id=\"loeschentext\"><ahelp hid=\".uno:DeleteColumns\">Deletes the "
"selected column(s) from the table.</ahelp></variable>"
msgstr ""
"<variable id=\"loeschentext\"><ahelp hid=\".uno:DeleteColumns\">Ջնջում է "
"ընտրված սյունակ(ներ)ը աղյուսակից:</ahelp></variable>"

#: 05120500.xhp#par_id3156385.3.help.text
#: 05120500.xhp%23par_id3156385.3.help.text
msgid "This command is only available if the cursor is in a table."
msgstr "Այս հրամանը հասանելի է միայն այն դեպքում, եթե կուրսորը աղյուսակում է:"

#: 02160000.xhp#tit.help.text
