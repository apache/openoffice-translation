msgstr "Կրկնեք գլխագիրը"

#: 04150000.xhp#par_id3151252.44.help.text
#: 04150000.xhp%23par_id3151252.44.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:DLG_INSERT_TABLE:CB_REPEAT_HEADER\">Repeats the "
"heading of the table at the top of subsequent page if the table spans more "
"than one page.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:DLG_INSERT_TABLE:CB_REPEAT_HEADER\">Կրկնում է "
"աղյուսակի գլխագիրը հաջորդ էջի վերևում, եթե աղյուսակը մեկ էջից ավելի "
"է:</ahelp>"

#: 04150000.xhp#par_idN10754.help.text
#: 04150000.xhp%23par_idN10754.help.text
msgctxt "04150000.xhp#par_idN10754.help.text"
msgid "The first ... rows"
msgstr "Առաջին ... տողերը"

#: 04150000.xhp#par_idN10758.help.text
#: 04150000.xhp%23par_idN10758.help.text
msgid ""
"<ahelp hid=\"sw:NumericField:DLG_INSERT_TABLE:NF_REPEAT_HEADER\">Select the "
"number of rows that you want to use for the heading.</ahelp>"
msgstr ""
"<ahelp hid=\"sw:NumericField:DLG_INSERT_TABLE:NF_REPEAT_HEADER\">Ընտրեք այն "
"տողերի քանակը, որոնք ցանկանում եք օգտագործել գլխագրի համար:</ahelp>"

#: 04150000.xhp#hd_id3149821.39.help.text
#: 04150000.xhp%23hd_id3149821.39.help.text
msgid "Do not split the table"
msgstr "Մի անջատեք աղյուսակը"

#: 04150000.xhp#par_id3149106.45.help.text
#: 04150000.xhp%23par_id3149106.45.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:DLG_INSERT_TABLE:CB_DONT_SPLIT\">Prevents the table "
"from spanning more than one page.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:DLG_INSERT_TABLE:CB_DONT_SPLIT\">Խոչընդոտում է "
"աղյուսակի ընդգրկումը մեկից ավելի էջերում:</ahelp>"

#: 04150000.xhp#hd_id3154838.40.help.text
#: 04150000.xhp%23hd_id3154838.40.help.text
msgctxt "04150000.xhp#hd_id3154838.40.help.text"
msgid "Border"
msgstr "Եզրագիծ"

#: 04150000.xhp#par_id3148970.46.help.text
#: 04150000.xhp%23par_id3148970.46.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:DLG_INSERT_TABLE:CB_BORDER\">Adds a border to the "
"table cells.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:DLG_INSERT_TABLE:CB_BORDER\">եզրագիծ է ավելացնում "
"աղյուսակի բջիջներին:</ahelp>"

#: 04150000.xhp#hd_id3147213.35.help.text
#: 04150000.xhp%23hd_id3147213.35.help.text
msgctxt "04150000.xhp#hd_id3147213.35.help.text"
msgid "AutoFormat"
msgstr "Ինքնաձևաչափ"

#: 04150000.xhp#par_id3149036.36.help.text
#: 04150000.xhp%23par_id3149036.36.help.text
msgid ""
"<variable id=\"autoformattext\"><ahelp hid=\"SW:PUSHBUTTON:DLG_INSERT_TABLE:"
"BT_AUTOFORMAT\">Opens the <emph>AutoFormat</emph> dialog, where you can "
"select a predefined layout for table.</ahelp></variable>"
msgstr ""
"<variable id=\"autoformattext\"><ahelp hid=\"SW:PUSHBUTTON:DLG_INSERT_TABLE:"
"BT_AUTOFORMAT\">Բացում է <emph>Ինքնաձևաչափ</emph> երկխոսությունը, որտեղ "
"կարող եք ընտրել աղյուսակի նախորոշված դասավորությունը:</ahelp></variable>"

#: 04150000.xhp#hd_id3147575.15.help.text
#: 04150000.xhp%23hd_id3147575.15.help.text
msgid "Icon on the Insert toolbar"
msgstr "Պատկերակ Տեղադրել գործիքագոտում"

#: 04150000.xhp#par_id3153511.16.help.text
#: 04150000.xhp%23par_id3153511.16.help.text
msgid ""
"On the Insert toolbar, click the <emph>Table</emph> icon to open the <emph>"
"Insert Table</emph> dialog, where you can insert a table in the current "
"document. You can also click the arrow, drag to select the number of rows "
"and columns to include in the table, and then click in the last cell."
msgstr ""
"Տեղադրել գործիքագոտում կտտացրեք <emph>Աղյուսակ</emph> պատկերակին՝ <emph>"
"Տեղադրել աղյուսակ</emph> երկխոսությունը բացելու համար, որտեղ կարող եք "
"աղյուսակ տեղադրել ընթացիկ փաստաթղթում: Կարող եք նաև սեղմել սլաքը, քաշել՝ "
"ընտրելու համար տողերի և սյունակների քանակը, աղյուսակում ընդգրկելու համար, "
"այնուհետև կտտացրեք վերջին բջիջում:"

#: 04150000.xhp#par_id3155912.52.help.text
