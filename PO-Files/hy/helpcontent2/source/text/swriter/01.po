msgstr "Ուղղահայաց"

#: 05060300.xhp#par_id3149485.8.help.text
#: 05060300.xhp%23par_id3149485.8.help.text
msgid ""
"<variable id=\"vertikaltext\"><ahelp hid=\"SW:CHECKBOX:TP_GRF_EXT:CB_VERT\">"
"Flips the selected graphic vertically.</ahelp></variable>"
msgstr ""
"<variable id=\"vertikaltext\"><ahelp hid=\"SW:CHECKBOX:TP_GRF_EXT:CB_VERT\">"
"Ընտրված գրաֆիկը ուղղահայաց շրջում է:</ahelp></variable>"

#: 05060300.xhp#hd_id3154829.5.help.text
#: 05060300.xhp%23hd_id3154829.5.help.text
msgid "Horizontally"
msgstr "Հորիզոնական"

#: 05060300.xhp#par_id3151261.6.help.text
#: 05060300.xhp%23par_id3151261.6.help.text
msgid ""
"<variable id=\"horizontaltext\"><ahelp hid=\"SW:CHECKBOX:TP_GRF_EXT:CB_HOR\">"
"Flips the selected graphic horizontally.</ahelp></variable>"
msgstr ""
"<variable id=\"horizontaltext\"><ahelp hid=\"SW:CHECKBOX:TP_GRF_EXT:CB_HOR\">"
"Ընտրված գրաֆիկը հորիզոնական շրջում է:</ahelp></variable>"

#: 05060300.xhp#hd_id3147101.15.help.text
#: 05060300.xhp%23hd_id3147101.15.help.text
msgid "On all pages"
msgstr "Բոլոր էջերում"

#: 05060300.xhp#par_id3147212.16.help.text
#: 05060300.xhp%23par_id3147212.16.help.text
msgid ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_GRF_EXT_RB_MIRROR_ALL_PAGES\">Flips the "
"selected graphic horizontally on all pages.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_GRF_EXT_RB_MIRROR_ALL_PAGES\">Ընտրված գրաֆիկը "
"շրջում է հորիզոնական բոլոր էջերում:</ahelp>"

#: 05060300.xhp#hd_id3153632.17.help.text
#: 05060300.xhp%23hd_id3153632.17.help.text
msgid "On left pages"
msgstr "Ձախ էջերում"

#: 05060300.xhp#par_id3149037.18.help.text
#: 05060300.xhp%23par_id3149037.18.help.text
msgid ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_GRF_EXT_RB_MIRROR_LEFT_PAGES\">Flips the "
"selected graphic horizontally only on even pages.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_GRF_EXT_RB_MIRROR_LEFT_PAGES\">Ընտրված "
"գրաֆիկը շրջում է հորիզոնական միայն զույգ էջերում:</ahelp>"

#: 05060300.xhp#hd_id3147580.19.help.text
#: 05060300.xhp%23hd_id3147580.19.help.text
msgid "On right pages"
msgstr "Աջ էջերում"

#: 05060300.xhp#par_id3152775.20.help.text
#: 05060300.xhp%23par_id3152775.20.help.text
msgid ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_GRF_EXT_RB_MIRROR_RIGHT_PAGES\">Flips the "
"selected graphic horizontally only on odd pages.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_RADIOBUTTON_TP_GRF_EXT_RB_MIRROR_RIGHT_PAGES\">Ընտրված "
"գրաֆիկը շրջում է հորիզոնական միայն կենտ էջերում</ahelp>"

#: 05060300.xhp#hd_id3153349.9.help.text
#: 05060300.xhp%23hd_id3153349.9.help.text
