"<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=TIME SDVAL=\"0\" SDNUM=\""
"1031;1031;HH:MM:SS AM/PM\" SDFIXED>03:58:35 PM</SDFIELD>"
msgstr ""
"<SDFIELD TYPE=DOCINFO SUBTYPE=CREATE FORMAT=TIME SDVAL=\"0\" SDNUM=\""
"1031;1031;HH:MM:SS AM/PM\" SDFIXED>03:58:35 PM</SDFIELD>"

#: 04090007.xhp#par_id3155077.35.help.text
#: 04090007.xhp%23par_id3155077.35.help.text
msgid "Modification date"
msgstr "Ձևափոխման ամսաթիվ"

#: 04090007.xhp#par_id3154330.36.help.text
#: 04090007.xhp%23par_id3154330.36.help.text
msgid ""
"<SDFIELD TYPE=DOCINFO SUBTYPE=CHANGE FORMAT=DATE SDNUM=\"1031;1031;NN DD "
"MMM, YY\">Mo 23 Feb, 98</SDFIELD>"
msgstr ""
"<SDFIELD TYPE=DOCINFO SUBTYPE=CHANGE FORMAT=DATE SDNUM=\"1031;1031;NN DD "
"MMM, YY\">Mo 23 Feb, 98</SDFIELD>"

#: 02170000.xhp#tit.help.text
#: 02170000.xhp%23tit.help.text
msgctxt "02170000.xhp#tit.help.text"
msgid "Edit Sections"
msgstr "Խմբագրել բաժինները"

#: 02170000.xhp#hd_id3153673.1.help.text
#: 02170000.xhp%23hd_id3153673.1.help.text
msgctxt "02170000.xhp#hd_id3153673.1.help.text"
msgid "Edit Sections"
msgstr "Խմբագրել բաժինները"

#: 02170000.xhp#par_id3155902.2.help.text
#: 02170000.xhp%23par_id3155902.2.help.text
msgid ""
"<variable id=\"bereichetext\"><ahelp hid=\".uno:EditRegion\">Changes the "
"properties of sections defined in your document.</ahelp> To insert a "
"section, select text or click in your document, and then choose <emph>Insert "
"- Section</emph>.</variable>"
msgstr ""
"<variable id=\"bereichetext\"><ahelp hid=\".uno:EditRegion\">Փոփոխում է ձեր "
"փաստաթղթում սահմանված բաժինների հատկությունները:</ahelp> Բաժին տեղադրելու "
"համար ընտրեք տեքստը կամ կտտացրեք ձեր փաստաթղթում, ապա ընտրեք <emph>Տեղադրել -"
" Բաժին</emph>.</variable>"

#: 02170000.xhp#par_id3143275.3.help.text
#: 02170000.xhp%23par_id3143275.3.help.text
msgid ""
"The <emph>Edit Sections</emph> dialog is similar to the <link href=\""
"text/swriter/01/04020100.xhp\" name=\"Insert - Section\"><emph>Insert - "
"Section</emph></link> dialog, and offers the following additional options:"
msgstr ""
"<emph>Խմբագրել բաժինները</emph> երկխոսությունը նման է <link href=\""
"text/swriter/01/04020100.xhp\" name=\"Տեղադրել - Բաժին\"><emph>Տեղադրել - "
"Բաժին</emph></link> երկխոսությունը և առաջարկում է հետևյալ լրացուցիչ "
"ընտրանքները."

#: 02170000.xhp#hd_id3149820.4.help.text
#: 02170000.xhp%23hd_id3149820.4.help.text
msgctxt "02170000.xhp#hd_id3149820.4.help.text"
msgid "Section"
msgstr "Բաժին"

#: 02170000.xhp#par_id3149104.5.help.text
#: 02170000.xhp%23par_id3149104.5.help.text
msgid ""
"<ahelp hid=\"HID_REGION_TREE\">Type the name of the section that you want to "
"edit, or click a name in the <emph>Section </emph>list.</ahelp> If the "
"cursor is currently in a section, the section name is displayed on the right "
"side of the status bar at the bottom of the document window."
msgstr ""
"<ahelp hid=\"HID_REGION_TREE\">Մուտքագրեք այն բաժնի անունը, որը ցանկանում եք "
"խմբագրել, կամ կտտացրեք անունը <emph>Բաժին</emph> ցուցակում:</ahelp> Եթե "
"կուրսորը ներկայումս գտնվում է մի բաժնում, ապա բաժնի անունը ցուցադրվում է "
"փաստաթղթի պատուհանի ներքևում գտնվող կարգավիճակի տողի աջ կողմում:"

#: 02170000.xhp#par_id3149040.6.help.text
#: 02170000.xhp%23par_id3149040.6.help.text
msgid ""
"The current write protection status of a section is indicated by the lock "
"symbol in front of the section name in the list. An open lock is unprotected "
"and a closed lock is protected. Similarly, visible sections are indicated by "
"a glasses symbol."
msgstr ""
"Բաժնի ներկայիս գրելու դեմ պաշտպանության կարգավիճակը նշվում է ցուցակում բաժնի "
"անվան դիմաց գտնվող կողպեքի նշանով: Բաց կողպեքը անպաշտպանն է, իսկ փակ կողպեքը՝"
" պաշտպանվածն է: Նմանապես, տեսանելի հատվածները նշվում են ակնոցների նշանով:"

#: 02170000.xhp#hd_id3153638.20.help.text
#: 02170000.xhp%23hd_id3153638.20.help.text
msgctxt "02170000.xhp#hd_id3153638.20.help.text"
msgid "Options"
msgstr "Ընտրանքներ"

#: 02170000.xhp#par_id3152773.21.help.text
#: 02170000.xhp%23par_id3152773.21.help.text
msgid ""
"<ahelp hid=\"HID_REGION_TREE\">Opens the <link href=\""
"text/swriter/01/05040501.xhp\" name=\"Options\"><emph>Options</emph></link> "
"dialog, where you can edit the column layout, background, footnote and "
"endnote behavior of the selected section.</ahelp> If the section is password "
"protected, you must enter the password first."
msgstr ""
"<ahelp hid=\"HID_REGION_TREE\">Բացում է <link href=\""
"text/swriter/01/05040501.xhp\" name=\"Ընտրանքներ\""
"><emph>Ընտրանքներ</emph></link> երկխոսությունը, որտեղ կարող եք խմբագրել "
"ընտրված բաժնի սյունակի դասավորությունը, ֆոնը, տողատակի և վերջաբանի "
"վարքը:</ahelp> Եթե բաժինը պաշտպանված է գաղտնաբառով, ապա նախ պետք է "
"մուտքագրեք գաղտնաբառը:"

#: 02170000.xhp#hd_id3155143.16.help.text
#: 02170000.xhp%23hd_id3155143.16.help.text
msgctxt "02170000.xhp#hd_id3155143.16.help.text"
msgid "Remove"
msgstr "Հեռացնել"

#: 02170000.xhp#par_id3145413.17.help.text
#: 02170000.xhp%23par_id3145413.17.help.text
msgid ""
"<ahelp hid=\"SW:PUSHBUTTON:MD_EDIT_REGION:CB_DISMISS\">Removes the selected "
"section from the document, and inserts the contents of the section into the "
"document.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:PUSHBUTTON:MD_EDIT_REGION:CB_DISMISS\">Փաստաթղթից հանում է "
"ընտրված հատվածը և բաժնի բովանդակությունը տեղադրում փաստաթղթի մեջ:</ahelp>"

#: 05060201.xhp#tit.help.text
#: 05060201.xhp%23tit.help.text
msgctxt "05060201.xhp#tit.help.text"
msgid "Contour Editor"
msgstr "Ուրվագծի Խմբագիր"

