msgid "Contour Editor"
msgstr "Ուրվագծի Խմբագիր"

#: 05060201.xhp#par_id3153677.2.help.text
#: 05060201.xhp%23par_id3153677.2.help.text
msgid ""
"<variable id=\"konturtext\"><ahelp hid=\".uno:ContourDialog\">Changes the "
"contour of the selected object. $[officename] uses the contour when "
"determining the <link href=\"text/swriter/01/05060200.xhp\" name=\"text "
"wrap\">text wrap</link> options for the object.</ahelp></variable>"
msgstr ""
"<variable id=\"konturtext\"><ahelp hid=\".uno:ContourDialog\">Փոխում է "
"ընտրված օբյեկտի ուրվագիծը: $[officename] -ն օգտագործում է ուրվագիծը, երբ "
"սահմանվում է <link href=\"text/swriter/01/05060200.xhp\" name=\"փաթաթել "
"տեքստը\">փաթաթել տեքստը</link> ընտրանքը առարկայի համար։</ahelp></variable>"

#: 05060201.xhp#par_id3155892.46.help.text
#: 05060201.xhp%23par_id3155892.46.help.text
msgid ""
"<ahelp hid=\"HID_CONTDLG_GRAPHWND\">Displays a preview of the "
"contour.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_CONTDLG_GRAPHWND\">Ցուցադրում է ուրվագծի "
"նախադիտումը:</ahelp>"

#: 05060201.xhp#hd_id3159195.3.help.text
#: 05060201.xhp%23hd_id3159195.3.help.text
msgctxt "05060201.xhp#hd_id3159195.3.help.text"
msgid "Apply"
msgstr "Կիրառել"

