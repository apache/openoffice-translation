"<link href=\"text/swriter/01/04120217.xhp\" name=\"Ցուցիչ\">Ցուցիչ</link>"

#: 04120217.xhp#par_id3145825.2.help.text
#: 04120217.xhp%23par_id3145825.2.help.text
msgid ""
"<variable id=\"verzeichnis\">The following options are available when you "
"select <emph>Bibliography </emph>as the <link href=\""
"text/swriter/01/04120210.xhp\" name=\"index\">index</link> type.</variable>"
msgstr ""
"<variable id=\"verzeichnis\">Հետևյալ տարբերակները հասանելի են, երբ ընտրում "
"եք <emph>Մատենագիտությունը </emph>որպես <link href=\""
"text/swriter/01/04120210.xhp\" name=\"ցուցիչի\">ցուցիչի</link> "
"տեսակ։</variable>"

#: 04120217.xhp#hd_id3148773.3.help.text
#: 04120217.xhp%23hd_id3148773.3.help.text
msgid "Formatting of the entries"
msgstr "Մուտքերի ձևաչափում"

#: 04120217.xhp#hd_id3147167.5.help.text
#: 04120217.xhp%23hd_id3147167.5.help.text
msgid "Number entries"
msgstr "Համարակալեք մուտքերը"

#: 04120217.xhp#par_id3154647.6.help.text
#: 04120217.xhp%23par_id3154647.6.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_TOX_SELECT:CB_SEQUENCE\">Automatically numbers "
"the bibliography entries.</ahelp> To set the sorting options for the "
"numbering, click the <link href=\"text/swriter/01/04120227.xhp\" name=\""
"Entries\">Entries</link> tab."
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_TOX_SELECT:CB_SEQUENCE\">Ինքնաշխատ կերպով "
"համարակալում է մատենագիտական մուտքերը։</ahelp> Տեսակավորման տարբերակները "
"կարգաբերելու համար, կտտացրեք <link href=\"text/swriter/01/04120227.xhp\" "
"name=\"Մուտքեր\">Մուտքեր</link> ներդիրին։"

#: 04120217.xhp#hd_id3150759.7.help.text
#: 04120217.xhp%23hd_id3150759.7.help.text
msgid "Brackets"
msgstr "Փակագծեր"

#: 04120217.xhp#par_id3149295.8.help.text
#: 04120217.xhp%23par_id3149295.8.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_TOX_SELECT:LB_BRACKET\">Select the brackets that "
"you want to enclose bibliography entries.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_TOX_SELECT:LB_BRACKET\">Ընտրեք այն փակագծերը, "
"որոնցում ցանկանում եք ներառել մատենագիտական մուտքերը:</ahelp>"

#: mailmerge05.xhp#tit.help.text
#: mailmerge05.xhp%23tit.help.text
