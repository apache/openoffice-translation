msgstr "Ցույց է տալիս արժեքները որպես տոկոս"

#: 04030000.xhp#par_id3156382.10.help.text
#: 04030000.xhp%23par_id3156382.10.help.text
msgid ""
"<ahelp hid=\"SCH_RADIOBUTTON_DLG_DATA_DESCR_RB_PERCENT\">Displays the "
"percentage of the data points in each column.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH_RADIOBUTTON_DLG_DATA_DESCR_RB_PERCENT\">Ցույց է տալիս "
"յուրաքանչյուր սյունակում տվյալների կետերի տոկոսը:</ahelp>"

#: 04030000.xhp#hd_id1316873.help.text
#: 04030000.xhp%23hd_id1316873.help.text
msgid "Percentage format"
msgstr "Տոկոսի ձևաչափ"

#: 04030000.xhp#par_id5476241.help.text
#: 04030000.xhp%23par_id5476241.help.text
msgid ""
"<ahelp hid=\".\">Opens a dialog to select the percentage format.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Տոկոսի ձևաչափը ընտրելու համար երկխոսություն է "
"բացվում:</ahelp>"

#: 04030000.xhp#hd_id3145228.11.help.text
#: 04030000.xhp%23hd_id3145228.11.help.text
msgid "Show category"
msgstr "Ցույց տուր դասը"

#: 04030000.xhp#par_id3154702.12.help.text
#: 04030000.xhp%23par_id3154702.12.help.text
msgid ""
"<ahelp hid=\"SCH_CHECKBOX_TP_DATA_DESCR_CB_TEXT\">Shows the data point text "
"labels.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH_CHECKBOX_TP_DATA_DESCR_CB_TEXT\">Ցույց է տալիս տվյալների "
"կետի տեքստի պիտակները:</ahelp>"

#: 04030000.xhp#hd_id3150298.15.help.text
#: 04030000.xhp%23hd_id3150298.15.help.text
msgid "Show legend key"
msgstr "Ցույց տուր լեգենդի բանալին"

#: 04030000.xhp#par_id3150205.16.help.text
#: 04030000.xhp%23par_id3150205.16.help.text
msgid ""
"<ahelp hid=\"SCH_CHECKBOX_TP_DATA_DESCR_CB_SYMBOL\">Displays the legend "
"icons next to each data point label.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH_CHECKBOX_TP_DATA_DESCR_CB_SYMBOL\">Ցուցադրում է լեգենդի "
"պատկերակները տվյալների յուրաքանչյուր կետի պիտակի կողքին:</ahelp>"

#: 04030000.xhp#hd_id3836787.help.text
#: 04030000.xhp%23hd_id3836787.help.text
msgid "Separator"
msgstr "Բաժանարար"

#: 04030000.xhp#par_id6668904.help.text
#: 04030000.xhp%23par_id6668904.help.text
msgid ""
"<ahelp hid=\".\">Selects the separator between multiple text strings for the "
"same object.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Նույն առարկայի համար ընտրում է տեքստային տողերի միջև "
"բաժանարարը:</ahelp>"

#: 04030000.xhp#hd_id4319284.help.text
#: 04030000.xhp%23hd_id4319284.help.text
msgid "Placement"
msgstr "Տեղաբաշխում"

#: 04030000.xhp#par_id5159459.help.text
#: 04030000.xhp%23par_id5159459.help.text
msgid ""
"<ahelp hid=\".\">Selects the placement of data labels relative to the "
"objects.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրում է տվյալների պիտակների տեղադրումը օբյեկտների "
"համեմատ:</ahelp>"

#: 04030000.xhp#hd_id1106200812280727.help.text
#: 04030000.xhp%23hd_id1106200812280727.help.text
msgctxt "04030000.xhp#hd_id1106200812280727.help.text"
msgid "Text Direction"
msgstr "Տեքստի ուղղությունը"

#: 04030000.xhp#par_id1106200812280719.help.text
#: 04030000.xhp%23par_id1106200812280719.help.text
msgctxt "04030000.xhp#par_id1106200812280719.help.text"
msgid ""
"<ahelp hid=\".\">Specify the text direction for a paragraph that uses "
"complex text layout (CTL). This feature is only available if complex text "
"layout support is enabled.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Նշեք տեքստի ուղղությունը մի պարբերության համար, որն "
"օգտագործում է տեքստի բարդ դասավորությունը (CTL): Այս հնարավորությունը "
"հասանելի է միայն այն դեպքում, եթե միացված է տեքստի ձևավորման բարդ "
"աջակցությունը:</ahelp>"

#: 04030000.xhp#hd_id1007200901590713.help.text
#: 04030000.xhp%23hd_id1007200901590713.help.text
msgid "Rotate Text"
msgstr "Պտտեք տեքստը"

#: 04030000.xhp#par_id1007200901590752.help.text
#: 04030000.xhp%23par_id1007200901590752.help.text
msgid ""
"<ahelp hid=\".\">Click in the dial to set the text orientation for the data "
"labels.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Կտտացրեք համարահավաքը՝ տվյալների պիտակների համար տեքստի "
"կողմնորոշումը սահմանելու համար:</ahelp>"

#: 04030000.xhp#par_id1007200901590757.help.text
#: 04030000.xhp%23par_id1007200901590757.help.text
msgid ""
"<ahelp hid=\".\">Enter the rotation angle for the data labels. A positive "
"number rotates the text to the left and a negative number rotates the text "
"to the right.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Մուտքագրեք պտույտի անկյունը տվյալների պիտակների համար: "
"Դրական համարը պտտեցնում է տեքստը դեպի ձախ, և բացասական թիվը տեքստը ուղղում է "
"դեպի աջ:</ahelp>"

