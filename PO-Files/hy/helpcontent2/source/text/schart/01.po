msgstr ""
"<link href=\"text/schart/01/05040200.xhp\" name=\"Y առանցք\">Y առանցք</link>"

#: 05040000.xhp#hd_id3153160.9.help.text
#: 05040000.xhp%23hd_id3153160.9.help.text
