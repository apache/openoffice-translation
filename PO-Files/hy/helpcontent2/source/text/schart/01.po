#: 05020201.xhp#par_id3156422.2.help.text
#: 05020201.xhp%23par_id3156422.2.help.text
msgid "Modifies the alignment of axes or title labels."
msgstr "Փոփոխում է առանցքների կամ վերնագրի պիտակների դասավորվածությունը:"

#: 05020201.xhp#par_id3150439.76.help.text
#: 05020201.xhp%23par_id3150439.76.help.text
msgid ""
"Some of the options listed here are not available for all labels. For "
"example, there are different options for 2D and 3D object labels."
msgstr ""
"Այստեղ թվարկված որոշ տարբերակներ հասանելի չեն բոլոր պիտակների համար: Օրինակ, "
"կան 2D և 3D օբյեկտների պիտակների տարբեր ընտրանքներ:"

#: 05020201.xhp#hd_id3145750.71.help.text
#: 05020201.xhp%23hd_id3145750.71.help.text
msgid "Show labels"
msgstr "Ցույց տալ պիտակները"

#: 05020201.xhp#par_id3154319.72.help.text
#: 05020201.xhp%23par_id3154319.72.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:TP_AXIS_LABEL:CB_AXIS_LABEL_SCHOW_DESCR\">"
"Specifies whether to show or hide the axis labels.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:TP_AXIS_LABEL:CB_AXIS_LABEL_SCHOW_DESCR\">Նշում է՝ "
"ցույց տալ կամ թաքցնել առանցքի պիտակները:</ahelp>"

#: 05020201.xhp#par_id3147436.75.help.text
#: 05020201.xhp%23par_id3147436.75.help.text
msgid ""
"<variable id=\"sytextbeschr\"><ahelp hid=\".uno:ToggleAxisDescr\">The<emph> "
"AxesTitle On/Off </emph>icon on the <emph>Formatting</emph> bar switches the "
"labeling of all axes on or off.</ahelp></variable>"
msgstr ""
"<variable id=\"sytextbeschr\"><ahelp hid=\".uno:ToggleAxisDescr\">Այս<emph> "
"Առանցքների վերնագրեր Միացում/Անջատում </emph>պատկերակը <emph>Ձևաչափում</emph>"
" վահանակում միացնում կամ անջատում է բոլոր առանցքների "
"պիտակավորումները:</ahelp></variable>"

#: 05020201.xhp#hd_id3150717.4.help.text
#: 05020201.xhp%23hd_id3150717.4.help.text
msgid "Rotate text"
msgstr "Պտտեք տեքստը"

#: 05020201.xhp#par_id3154510.5.help.text
#: 05020201.xhp%23par_id3154510.5.help.text
msgid ""
"<ahelp hid=\".uno:ToggleAxisDescr\">Defines the text direction of cell "
"contents.</ahelp> Click one of the ABCD buttons to assign the required "
"direction."
msgstr ""
"<ahelp hid=\".uno:ToggleAxisDescr\">Սահմանում է բջջի բովանդակության տեքստի "
"ուղղությունը:</ahelp> Սեղմեք ABCD կոճակներից մեկը՝ պահանջվող ուղղությունը "
"նշանակելու համար:"

#: 05020201.xhp#hd_id3150327.50.help.text
#: 05020201.xhp%23hd_id3150327.50.help.text
msgid "ABCD wheel"
msgstr "ABCD անիվ"

#: 05020201.xhp#par_id3149018.49.help.text
#: 05020201.xhp%23par_id3149018.49.help.text
msgid ""
"<ahelp hid=\"HID_SCH_ALIGNMENT_CTR_DIAL\">Clicking anywhere on the wheel "
"defines the variable text orientation.</ahelp> The letters \"ABCD\" on the "
"button correspond to the new setting."
msgstr ""
"<ahelp hid=\"HID_SCH_ALIGNMENT_CTR_DIAL\">Անիվի վրա որևէ տեղ սեղմելը "
"սահմանում է փոփոխական տեքստի կողմնորոշումը:</ahelp> Կոճակի վրա «ABCD» տառերը "
"համապատասխանում են նոր կարգաբերմանը:"

#: 05020201.xhp#hd_id3154254.51.help.text
#: 05020201.xhp%23hd_id3154254.51.help.text
msgid "ABCD button"
msgstr "ABCD կոճակ"

#: 05020201.xhp#par_id3154702.52.help.text
#: 05020201.xhp%23par_id3154702.52.help.text
msgid ""
"<ahelp hid=\"HID_SCH_ALIGNMENT_STACKED\">Assigns vertical text orientation "
"for cell contents.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_SCH_ALIGNMENT_STACKED\">Բջջի բովանդակության համար "
"հատկացնում է տեքստի ուղղահայաց կողմնորոշում:</ahelp>"

#: 05020201.xhp#par_id3150342.53.help.text
#: 05020201.xhp%23par_id3150342.53.help.text
msgid ""
"If you define a vertical x-axis label, the text may be cut off by the line "
"of the x-axis."
msgstr ""
"Եթե դուք սահմանում եք x-առանցքի ուղղահայաց պիտակ, տեքստը կարող է կտրվել x-"
"առանցքի գծով:"

#: 05020201.xhp#hd_id3166432.54.help.text
#: 05020201.xhp%23hd_id3166432.54.help.text
msgctxt "05020201.xhp#hd_id3166432.54.help.text"
msgid "Degrees"
msgstr "Աստիճաններ"

#: 05020201.xhp#par_id3150199.55.help.text
#: 05020201.xhp%23par_id3150199.55.help.text
msgid ""
"<ahelp hid=\"HID_SCH_ALIGNMENT_DEGREES\">Allows you to manually enter the "
"orientation angle.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_SCH_ALIGNMENT_DEGREES\">Թույլ է տալիս ձեռքով մուտքագրել "
"կողմնորոշման անկյունը:</ahelp>"

#: 05020201.xhp#hd_id3152985.73.help.text
#: 05020201.xhp%23hd_id3152985.73.help.text
msgid "Text flow"
msgstr "Տեքստի տեղադրում"

#: 05020201.xhp#par_id3155089.74.help.text
#: 05020201.xhp%23par_id3155089.74.help.text
msgid "Determines the text flow of the data label."
msgstr "Որոշում է տվյալների պիտակի տեքստի հոսքը:"

#: 05020201.xhp#hd_id3148837.57.help.text
#: 05020201.xhp%23hd_id3148837.57.help.text
msgctxt "05020201.xhp#hd_id3148837.57.help.text"
msgid "Overlap"
msgstr "Մասնակի ծածկում"

#: 05020201.xhp#par_id3151240.58.help.text
#: 05020201.xhp%23par_id3151240.58.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:TP_AXIS_LABEL:CB_AXIS_LABEL_TEXTOVERLAP\">"
"Specifies that the text in cells may overlap other cells.</ahelp> This can "
"be especially useful if there is a lack of space. This option is not "
"available with different title directions."
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:TP_AXIS_LABEL:CB_AXIS_LABEL_TEXTOVERLAP\">Նշում է, "
"որ բջիջների տեքստը կարող է մասնակի ծածկել այլ բջիջների:</ahelp> Սա կարող է "
"հատկապես օգտակար լինել, եթե կա տարածքի պակաս: Այս տարբերակը հասանելի չէ "
"տարբեր ուղղություններով վերնագրերի համար:"

#: 05020201.xhp#hd_id3157982.68.help.text
#: 05020201.xhp%23hd_id3157982.68.help.text
msgid "Break"
msgstr "Ընդմիջել"

#: 05020201.xhp#par_id3155268.69.help.text
#: 05020201.xhp%23par_id3155268.69.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:TP_AXIS_LABEL:CB_AXIS_LABEL_TEXTBREAK\">Allows a "
"text break.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:TP_AXIS_LABEL:CB_AXIS_LABEL_TEXTBREAK\">Թույլ է "
"տալիս տեքստի ընդմիջում:</ahelp>"

#: 05020201.xhp#hd_id3159205.56.help.text
#: 05020201.xhp%23hd_id3159205.56.help.text
msgid "The following options are not available for all chart types:"
msgstr "Հետևյալ ընտրանքները հասանելի չեն գծապատկերների բոլոր տեսակների համար."

#: 05020201.xhp#hd_id3152872.59.help.text
#: 05020201.xhp%23hd_id3152872.59.help.text
msgid "Order"
msgstr "Կարգ"

#: 05020201.xhp#par_id3159230.11.help.text
#: 05020201.xhp%23par_id3159230.11.help.text
msgid ""
"The options on this tab are only available for a 2D chart, under <emph>"
"Format - Axis - Y Axis</emph> or <emph>X Axis</emph>. In this area, you can "
"define the alignment of the number labels on the X or Y axis."
msgstr ""
"Այս ներդիրի ընտրանքները հասանելի են միայն 2D գծապատկերների համար այստեղից՝ "
"<emph>Ձևաչափ - Առանցք - Y առանցք</emph> կամ <emph>X առանցք</emph>: Այս "
"տարածքում դուք կարող եք սահմանել թվերի պիտակների հավասարեցումը X կամ Y "
"առանցքի վրա:"

#: 05020201.xhp#hd_id3146963.60.help.text
#: 05020201.xhp%23hd_id3146963.60.help.text
msgid "Tile"
msgstr "Սալիկով"

#: 05020201.xhp#par_id3155758.61.help.text
#: 05020201.xhp%23par_id3155758.61.help.text
msgid ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_AXIS_LABEL:RB_AXIS_LABEL_SIDEBYSIDE\">"
"Arranges numbers on the axis side by side.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_AXIS_LABEL:RB_AXIS_LABEL_SIDEBYSIDE\">"
"Առանցքի վրա կողք կողքի դասավորում է թվերը:</ahelp>"

#: 05020201.xhp#hd_id3151195.62.help.text
#: 05020201.xhp%23hd_id3151195.62.help.text
msgid "Stagger odd"
msgstr "Տատանել կենտերը"

#: 05020201.xhp#par_id3145114.63.help.text
#: 05020201.xhp%23par_id3145114.63.help.text
msgid ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_AXIS_LABEL:RB_AXIS_LABEL_UPDOWN\">Staggers "
"numbers on the axis, even numbers lower than odd numbers.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_AXIS_LABEL:RB_AXIS_LABEL_UPDOWN\">Շարժում է "
"առանցքի վրա գտնվող թվերը, զույգ թվերը ավելի ցածր են կենտերից:</ahelp>"

#: 05020201.xhp#hd_id3147250.64.help.text
#: 05020201.xhp%23hd_id3147250.64.help.text
msgid "Stagger even"
msgstr "Շարժել զույգերը"

#: 05020201.xhp#par_id3153958.65.help.text
#: 05020201.xhp%23par_id3153958.65.help.text
msgid ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_AXIS_LABEL:RB_AXIS_LABEL_DOWNUP\">Stagger "
"numbers on the axes, odd numbers lower than even numbers.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_AXIS_LABEL:RB_AXIS_LABEL_DOWNUP\">Առանցքների "
"վրա շարժեք թվերը, կենտ թվերը ցածր են զույգ թվերից:</ahelp>"

#: 05020201.xhp#hd_id3147301.66.help.text
#: 05020201.xhp%23hd_id3147301.66.help.text
msgctxt "05020201.xhp#hd_id3147301.66.help.text"
msgid "Automatic"
msgstr "Ինքնաշխատ"

#: 05020201.xhp#par_id3147404.67.help.text
#: 05020201.xhp%23par_id3147404.67.help.text
msgid ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_AXIS_LABEL:RB_AXIS_LABEL_AUTOORDER\">"
"Automatically arranges numbers on the axis.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_AXIS_LABEL:RB_AXIS_LABEL_AUTOORDER\">"
"Ինքնաշխատ կերպով դասավորում է թվերը առանցքի վրա:</ahelp>"

#: 05020201.xhp#par_id3149353.70.help.text
#: 05020201.xhp%23par_id3149353.70.help.text
msgid ""
"Problems may arise in displaying labels if the size of your chart is too "
"small. You can avoid this by either enlarging the view or decreasing the "
"font size."
msgstr ""
"Խնդիրներ կարող են առաջանալ պիտակների ցուցադրման ժամանակ, եթե ձեր գծապատկերի "
"չափը չափազանց փոքր է: Դուք կարող եք խուսափել դրանից՝ կա՛մ մեծացնելով տեսքը, "
"կա՛մ նվազեցնելով տառատեսակի չափը:"

#: 05020201.xhp#hd_id1106200812235146.help.text
#: 05020201.xhp%23hd_id1106200812235146.help.text
msgctxt "05020201.xhp#hd_id1106200812235146.help.text"
msgid "Text Direction"
msgstr "Տեքստի ուղղություն"

#: 05020201.xhp#par_id1106200812235271.help.text
#: 05020201.xhp%23par_id1106200812235271.help.text
msgctxt "05020201.xhp#par_id1106200812235271.help.text"
msgid ""
"<ahelp hid=\".\">Specify the text direction for a paragraph that uses "
"complex text layout (CTL). This feature is only available if complex text "
"layout support is enabled.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Նշեք տեքստի ուղղությունը պարբերության համար, որն "
"օգտագործում է բարդ տեքստի դասավորություն (CTL): Այս հատկությունը հասանելի է "
"միայն այն դեպքում, եթե միացված է բարդ տեքստի դասավորության "
"աջակցությունը:</ahelp>"

#: type_line.xhp#tit.help.text
#: type_line.xhp%23tit.help.text
msgid "Chart Type Line"
msgstr "Գծապատկերի տեսակը Գծային"

#: type_line.xhp#bm_id2187566.help.text
#: type_line.xhp%23bm_id2187566.help.text
msgid ""
"<bookmark_value>line charts</bookmark_value><bookmark_value>chart "
"types;line</bookmark_value>"
msgstr ""
"<bookmark_value>գծային գծապատկերներ</bookmark_value><bookmark_value>"
"գծապատկերների տեսակներ;գիծ</bookmark_value>"

#: type_line.xhp#hd_id9422894.help.text
#: type_line.xhp%23hd_id9422894.help.text
msgid ""
"<variable id=\"type_line\"><link href=\"text/schart/01/type_line.xhp\">Chart "
"Type Line</link></variable>"
msgstr ""
"<variable id=\"type_line\"><link href=\"text/schart/01/type_line.xhp\">"
"Գծապատկերի տեսակը Գծային</link></variable>"

#: type_line.xhp#par_id389721.help.text
#: type_line.xhp%23par_id389721.help.text
msgctxt "type_line.xhp#par_id389721.help.text"
msgid ""
"On the first page of the <link href=\"text/schart/01/wiz_chart_type.xhp\">"
"Chart Wizard</link> you can choose a chart type. "
msgstr ""
"<link href=\"text/schart/01/wiz_chart_type.xhp\">Գծապատկերների "
"հրաշագործի</link> առաջին էջում կարող եք ընտրել գծապատկերի տեսակը: "

#: type_line.xhp#hd_id9826349.help.text
#: type_line.xhp%23hd_id9826349.help.text
msgid "Line"
msgstr "Գծային"

#: type_line.xhp#par_id2334665.help.text
#: type_line.xhp%23par_id2334665.help.text
msgid ""
"A line chart shows values as points on the y axis. The x axis shows "
"categories. The y values of each data series can be connected by a line."
msgstr ""
"Գծային գծապատկերը ցույց է տալիս արժեքները որպես կետեր y առանցքի վրա: x "
"առանցքը ցույց է տալիս դասերը: Յուրաքանչյուր տվյալների շարքի y արժեքները "
"կարող են միացված լինել գծով:"

#: type_line.xhp#par_id8956572.help.text
#: type_line.xhp%23par_id8956572.help.text
msgid "Points only - this subtype plots only points."
msgstr "Միայն միավորներ - այս ենթատեսակը գծագրում է միայն միավորները:"

#: type_line.xhp#par_id500808.help.text
#: type_line.xhp%23par_id500808.help.text
msgid ""
"Points and lines - this subtype plots points and connects points of the same "
"data series by a line."
msgstr ""
"Կետեր և գծեր - այս ենթատեսակը գծագրում է կետերը և միացնում է նույն տվյալների "
"շարքի կետերը գծով:"

#: type_line.xhp#par_id8366649.help.text
#: type_line.xhp%23par_id8366649.help.text
msgid "Lines only - this subtype plots only lines."
msgstr "Միայն գծեր. այս ենթատեսակը գծագրում է միայն գծեր:"

#: type_line.xhp#par_id476393.help.text
#: type_line.xhp%23par_id476393.help.text
msgid ""
"3D lines - this subtype connects points of the same data series by a 3D line."
msgstr "3D գծեր - այս ենթատիպը միացնում է նույն տվյալների շարքի կետերը 3D գծով:"

#: type_line.xhp#par_id2655720.help.text
#: type_line.xhp%23par_id2655720.help.text
msgid ""
"Mark <emph>Stack series</emph> to arrange the points' y values cumulative "
"above each other. The y values no longer represent absolute values, except "
"for the first column which is drawn at the bottom of the stacked points. If "
"you select <emph>Percent</emph>, the y values are scaled as percentage of "
"the category total."
msgstr ""
"Նշեք <emph>Կուտակումով շարքեր</emph> միավորների y արժեքները միմյանց վերևում "
"կուտակված դասավորելու համար: y արժեքներն այլևս բացարձակ արժեքներ չեն "
"ներկայացնում, բացառությամբ առաջին սյունակի, որը գծված է կուտակված կետերի "
"ներքևում: Եթե ընտրեք <emph>Տոկոս</emph>, y արժեքները չափվում են որպես "
"կատեգորիայի ընդհանուր տոկոս:"

#: type_line.xhp#par_id3682058.help.text
#: type_line.xhp%23par_id3682058.help.text
msgid ""
"Mark <emph>Smooth lines</emph> to draw curves through the points instead of "
"straight lines. Click <emph>Properties</emph> for a <link href=\""
"text/schart/01/smooth_line_properties.xhp\">dialog</link> to change the "
"curves' properties."
msgstr ""
"Նշեք <emph>Հարթեցված գծեր</emph> ուղիղ գծերի փոխարեն կետերի միջով կորեր "
"գծելու համար։ Սեղմեք <emph>Հատկություններ</emph> որպեսզի <link href=\""
"text/schart/01/smooth_line_properties.xhp\">երկխոսությունը</link> փոխի "
"կորերի հատկությունները:"
