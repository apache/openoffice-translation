msgstr ""
"<ahelp hid=\".uno:Forward\">Ընտրված տվյալների շարքը բերում է առաջ (աջ "
"կողմում):</ahelp>"

#: 05120000.xhp#hd_id3146316.4.help.text
#: 05120000.xhp%23hd_id3146316.4.help.text
msgid "Send Backward"
msgstr "Տար հետնամաս"

#: 05120000.xhp#par_id3147001.7.help.text
#: 05120000.xhp%23par_id3147001.7.help.text
