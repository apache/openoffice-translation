msgstr "<ahelp hid=\"HID_SCH_CT_INDICATE2\">Նշում է սխալի ցուցանիշը:</ahelp>"

#: 04050000.xhp#hd_id0428200810574027.help.text
#: 04050000.xhp%23hd_id0428200810574027.help.text
msgid "Positive and Negative"
msgstr "Դրական և բացասական"

#: 04050000.xhp#par_id0428200810574039.help.text
#: 04050000.xhp%23par_id0428200810574039.help.text
msgid "<ahelp hid=\".\">Shows positive and negative error bars.</ahelp>"
msgstr "<ahelp hid=\".\">Ցույց է տալիս սխալի դրական և բացասական ձողերը:</ahelp>"

#: 04050000.xhp#hd_id0428200810574031.help.text
#: 04050000.xhp%23hd_id0428200810574031.help.text
msgid "Positive"
msgstr "Դրական"

#: 04050000.xhp#par_id042820081057411.help.text
#: 04050000.xhp%23par_id042820081057411.help.text
msgid "<ahelp hid=\".\">Shows only positive error bars.</ahelp>"
msgstr "<ahelp hid=\".\">Ցույց է տալիս միայն սխալի դրական ձողերը:</ahelp>"

#: 04050000.xhp#hd_id0428200810574138.help.text
#: 04050000.xhp%23hd_id0428200810574138.help.text
msgid "Negative"
msgstr "Բացասական"

#: 04050000.xhp#par_id0522200809110667.help.text
#: 04050000.xhp%23par_id0522200809110667.help.text
