#: 05040202.xhp#hd_id3166469.67.help.text
#: 05040202.xhp%23hd_id3166469.67.help.text
msgctxt "05040202.xhp#hd_id3166469.67.help.text"
msgid "Outer"
msgstr "Արտաքին"

#: 05040202.xhp#par_id3153120.73.help.text
#: 05040202.xhp%23par_id3153120.73.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:TP_SCALE_Y:CBX_TICKS_OUTER\">Specifies that marks "
"are placed on the outer side of the axis.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:TP_SCALE_Y:CBX_TICKS_OUTER\">Նշում է, որ նշանները "
"տեղադրված են առանցքի արտաքին կողմում:</ahelp>"

#: 05040202.xhp#hd_id3159128.68.help.text
#: 05040202.xhp%23hd_id3159128.68.help.text
msgid "Minor:"
msgstr "Ստորադաս․"

#: 05040202.xhp#par_id3146885.74.help.text
#: 05040202.xhp%23par_id3146885.74.help.text
msgid ""
"This area is used to define the marking dashes between the axis marks. It is "
"possible to activate both fields. This will result in a marking line running "
"from the outside to the inside."
msgstr ""
"Այս տարածքը օգտագործվում է առանցքի գծանշանների միջև գծանշման գծերը "
"սահմանելու համար: Հնարավոր է ակտիվացնել երկու դաշտերը: Դա կհանգեցնի գծանշման "
"գծի, որը դրսից դեպի ներս է գնում:"

#: 05040202.xhp#hd_id3150654.69.help.text
#: 05040202.xhp%23hd_id3150654.69.help.text
msgctxt "05040202.xhp#hd_id3150654.69.help.text"
msgid "Inner"
msgstr "Ներքին"

#: 05040202.xhp#par_id3146880.75.help.text
#: 05040202.xhp%23par_id3146880.75.help.text
