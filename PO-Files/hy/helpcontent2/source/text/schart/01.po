msgid "Friday"
msgstr "Ուրբաթ"

#: type_stock.xhp#par_id2656941.help.text
#: type_stock.xhp%23par_id2656941.help.text
msgid "4600"
msgstr "4600"

#: type_stock.xhp#par_id1481063.help.text
