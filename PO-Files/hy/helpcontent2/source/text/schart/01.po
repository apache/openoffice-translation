msgstr "X առանցք"

#: 04070000.xhp#par_id3150749.6.help.text
#: 04070000.xhp%23par_id3150749.6.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_X_MAIN\">Adds gridlines to the X axis "
"of the chart.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_X_MAIN\">Ավելացնում է ցանցային գծեր "
"գծապատկերի x առանցքին:</ahelp>"

#: 04070000.xhp#par_id3154754.7.help.text
#: 04070000.xhp%23par_id3154754.7.help.text
msgid ""
"<variable id=\"sytextxgitter\"><ahelp hid=\".uno:ToggleGridHorizontal\">The "
"<emph>Horizontal Grid On/Off</emph> icon on the <emph>Formatting</emph> bar "
"toggles the visibility of the grid display for the X axis. Note: This only "
"works if the <emph>Minor grid</emph> check boxes in <emph>Insert - "
"Grids</emph> are cleared.</ahelp></variable> Otherwise, the minor grid "
"remains visible when the major grid is turned off."
msgstr ""
"<variable id=\"sytextxgitter\"><ahelp hid=\".uno:ToggleGridHorizontal\">Այս "
"<emph>Հորիզոնական ցանց Միացված/ Անջատված</emph> պատկերակը "
"<emph>Ձևաչափում</emph> վահանակում փոփոխում է ցանցի ցուցադրման "
"տեսանելիությունը x առանցքի համար: ՆՇՈՒՄ: Սա միայն աշխատում է, եթե <emph>"
"Աննշան ցանց</emph> ընտրավանդակները <emph>Տեղադրել - Ցանցեր</emph> -ում "
"մաքրված են:</ahelp></variable> Հակառակ դեպքում, աննշան ցանցը երեւում է, երբ "
"հիմնական ցանցն անջատված է:"

#: 04070000.xhp#hd_id3145228.8.help.text
#: 04070000.xhp%23hd_id3145228.8.help.text
msgctxt "04070000.xhp#hd_id3145228.8.help.text"
msgid "Y axis"
msgstr "Y առանցք"

#: 04070000.xhp#par_id3147004.9.help.text
#: 04070000.xhp%23par_id3147004.9.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Y_MAIN\">Adds gridlines to the Y axis "
"of the chart.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Y_MAIN\">Ավելացնում է ցանցային գծեր "
"գծապատկերի Y առանցքին:</ahelp>"

#: 04070000.xhp#par_id3150344.10.help.text
#: 04070000.xhp%23par_id3150344.10.help.text
msgid ""
"<variable id=\"sytextygitter\"><ahelp hid=\".uno:ToggleGridVertical\">The "
"<emph>Vertical Grid On/Off</emph> icon on the <emph>Formatting</emph> bar "
"toggles the visibility of the grid display for the Y axis. Note: This only "
"works if the X-axis <emph>Minor grid</emph> is not selected in <emph>Insert -"
" Grids</emph>.</ahelp></variable> Otherwise, the minor grid remains visible "
"when the major grid is turned off."
msgstr ""
"<variable id=\"sytextygitter\"><ahelp hid=\".uno:ToggleGridVertical\">Այս "
"<emph>Ուղղահայաց ցանցը միացված/ անջատված</emph> պատկերակը "
"<emph>Ձևաչափում</emph> վահանակում անջատում է Y առանցքի համար ցանցի "
"ցուցադրման տեսանելիությունը: Նշում. Սա աշխատում է միայն այն դեպքում, եթե X-"
"առանցքի <emph>Փոքր ցանց</emph> -ը ընտրված չէ <emph>Տեղադրել - Ցանցեր</emph> "
"-ում:</ahelp></variable> Հակառակ դեպքում, աննշան ցանցը երեւում է, երբ "
"հիմնական ցանցն անջատված է:"

#: 04070000.xhp#hd_id3166430.11.help.text
#: 04070000.xhp%23hd_id3166430.11.help.text
msgctxt "04070000.xhp#hd_id3166430.11.help.text"
msgid "Z axis"
msgstr "Z առանցք"

#: 04070000.xhp#par_id3155378.12.help.text
#: 04070000.xhp%23par_id3155378.12.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Z_MAIN\">Adds gridlines to the Z axis "
"of the chart.</ahelp> This option is only available if you're working with "
"3D charts."
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Z_MAIN\">Ավելացնում է ցանցային գծերը "
"գծապատկերի Z առանցքին:</ahelp> Այս տարբերակը հասանելի է միայն այն դեպքում, "
"եթե աշխատում եք 3D գծապատկերներով:"

#: 04070000.xhp#hd_id3146978.13.help.text
#: 04070000.xhp%23hd_id3146978.13.help.text
msgctxt "04070000.xhp#hd_id3146978.13.help.text"
msgid "Minor grids"
msgstr "Երկրորդական ցանցեր"

#: 04070000.xhp#par_id3156449.14.help.text
#: 04070000.xhp%23par_id3156449.14.help.text
msgid ""
"Use this area to assign a minor grid for each axis. Assigning minor grids to "
"the axis reduces the distance between the major grids."
msgstr ""
"Յուրաքանչյուր առանցքի համար աննշան ցանց նշանակելու համար օգտագործեք այս "
"տարածքը: Փոքր ցանցերի նշանակումը առանցքին նվազեցնում է հիմնական ցանցերի "
"միջեւ հեռավորությունը:"

#: 04070000.xhp#hd_id3153308.15.help.text
#: 04070000.xhp%23hd_id3153308.15.help.text
msgctxt "04070000.xhp#hd_id3153308.15.help.text"
msgid "X axis"
msgstr "X առանցք"

#: 04070000.xhp#par_id3148704.16.help.text
#: 04070000.xhp%23par_id3148704.16.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_X_HELP\">Adds gridlines that subdivide "
"the X axis into smaller sections.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_X_HELP\">Ավելացնում է ցանցային գծեր, "
"որոնք X առանցքը բաժանում են ավելի փոքր հատվածների:</ahelp>"

#: 04070000.xhp#hd_id3153917.17.help.text
#: 04070000.xhp%23hd_id3153917.17.help.text
msgctxt "04070000.xhp#hd_id3153917.17.help.text"
msgid "Y axis"
msgstr "Y առանցք"

#: 04070000.xhp#par_id3154536.18.help.text
#: 04070000.xhp%23par_id3154536.18.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Y_HELP\">Adds gridlines that subdivide "
"the Y axis into smaller sections.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Y_HELP\">Ավելացնում է ցանցային գծեր, "
"որոնք y առանցքը բաժանում են ավելի փոքր հատվածների:</ahelp>"

#: 04070000.xhp#hd_id3148607.19.help.text
#: 04070000.xhp%23hd_id3148607.19.help.text
msgctxt "04070000.xhp#hd_id3148607.19.help.text"
msgid "Z axis"
msgstr "Z առանցք"

#: 04070000.xhp#par_id3153247.20.help.text
#: 04070000.xhp%23par_id3153247.20.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Z_HELP\">Adds gridlines that subdivide "
"the Z axis into smaller sections.</ahelp> This option is only available if "
"you're working with 3D charts."
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:DLG_GRID:CB_Z_HELP\">Ավելացնում է ցանցային գծեր, "
"որոնք Z առանցքը բաժանում են ավելի փոքր հատվածների:</ahelp> Այս տարբերակը "
"հասանելի է միայն այն դեպքում, եթե աշխատում եք 3D գծապատկերներով:"

#: wiz_data_range.xhp#tit.help.text
#: wiz_data_range.xhp%23tit.help.text
msgid "Chart Wizard - Data Range"
msgstr "Գծապատկերի հրաշագործ - Տվյալների միջակայք"

#: wiz_data_range.xhp#bm_id2429578.help.text
#: wiz_data_range.xhp%23bm_id2429578.help.text
msgid "<bookmark_value>data ranges in charts</bookmark_value>"
msgstr "<bookmark_value>տվյալների միջակայքեր գծապատկերներում</bookmark_value>"

#: wiz_data_range.xhp#hd_id8313852.help.text
#: wiz_data_range.xhp%23hd_id8313852.help.text
msgid ""
"<variable id=\"wiz_data_range\"><link href=\"text/schart/01/wiz_data_range."
"xhp\">Chart Wizard - Data Range</link></variable>"
msgstr ""
"<variable id=\"wiz_data_range\"><link href=\"text/schart/01/wiz_data_range."
"xhp\">Գծապատկերի հրաշագործ - Տվյալների միջակայք</link></variable>"

#: wiz_data_range.xhp#par_id8829309.help.text
#: wiz_data_range.xhp%23par_id8829309.help.text
msgid ""
"On this page of the <link href=\"text/schart/01/wiz_chart_type.xhp\">Chart "
"Wizard</link> you can select one single source of data range. This range may "
"consist of more than one rectangular range of cells."
msgstr ""
"Այս էջում <link href=\"text/schart/01/wiz_chart_type.xhp\">Գծապատկերի "
"հրաշագործ</link> կարող եք ընտրել տվյալների միջակայքի մեկ աղբյուր: Այս "
"միջակայքը կարող է բաղկացած լինել բջիջների ավելի քան մեկ ուղղանկյուն "
"տեսականիից:"

#: wiz_data_range.xhp#par_id6401867.help.text
#: wiz_data_range.xhp%23par_id6401867.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens the Data Ranges dialog where "
"you can edit Data Range and Data Series.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացվում է տվյալների միջակայքերը, "
"որտեղ կարող եք խմբագրել Տվյալների միջակայքը եւ Տվյալների շարքը:</ahelp>"

#: wiz_data_range.xhp#par_id2025818.help.text
#: wiz_data_range.xhp%23par_id2025818.help.text
msgid ""
"Use the Chart Wizard - Data Series page if you need more control over the "
"data ranges."
msgstr ""
"Օգտագործեք Գծապատկերի հրաշագործ - Տվյալների շարքեր էջը եթե ձեզ անհրաժեշտ է "
"ավելի շատ վերահսկողություն տվյալների միջակայքերի նկատմամբ:"

#: wiz_data_range.xhp#par_id8466139.help.text
#: wiz_data_range.xhp%23par_id8466139.help.text
msgctxt "wiz_data_range.xhp#par_id8466139.help.text"
msgid ""
"This dialog is only available for charts based on a Calc or Writer table."
msgstr ""
"Այս երկխոսությունը հասանելի է միայն գծապատկերների հիման վրա, որը հիմնված է "
"Calc-ի կամ Writer-ի աղյուսակի վրա:"

#: wiz_data_range.xhp#hd_id1877193.help.text
#: wiz_data_range.xhp%23hd_id1877193.help.text
msgctxt "wiz_data_range.xhp#hd_id1877193.help.text"
msgid "To specify a data range"
msgstr "Տվյալների միջակայքը նշելու համար"

#: wiz_data_range.xhp#par_id5924863.help.text
#: wiz_data_range.xhp%23par_id5924863.help.text
msgid "Select the data range. Do one of the following:"
msgstr "Ընտրեք տվյալների միջակայքը: Կատարեք հետևյալներից մեկը."

#: wiz_data_range.xhp#par_id4357432.help.text
#: wiz_data_range.xhp%23par_id4357432.help.text
msgctxt "wiz_data_range.xhp#par_id4357432.help.text"
msgid "Enter the data range in the text box."
msgstr "Մուտքագրեք տվյալները տեքստի տուփում:"

#: wiz_data_range.xhp#par_id5626392.help.text
#: wiz_data_range.xhp%23par_id5626392.help.text
msgctxt "wiz_data_range.xhp#par_id5626392.help.text"
msgid ""
"In Calc, an example data range would be \"$Sheet1.$B$3:$B$14\". Note that a "
"data range may consist of more than one region in a spreadsheet, e.g. \""
"$Sheet1.A1:A5;$Sheet1.D1:D5\" is also a valid data range. In Writer, an "
"example data range would be \"Table1.A1:E4\"."
msgstr ""
"Calc-ում, Տվյալների օրինակի տեսականին կլիներ \"$Sheet1.$B$3:$B$14\". Նկատի "
"ունեցեք, որ աղյուսակի մեջ տվյալների միջակայքը կարող է բաղկացած լինել ավելի "
"քան մեկ տարածաշրջանից, օրինակ: \"$Sheet1.A1:A5;$Sheet1.D1:D5\" - ը ևս "
"տվյալների վավեր միջակայք է: Writer-ում, օրինակելի տվյալների տեսականին կլինի "
"\"Table1.A1:E4\"."

#: wiz_data_range.xhp#par_id1363872.help.text
#: wiz_data_range.xhp%23par_id1363872.help.text
msgid ""
"In Calc, click <emph>Select data range</emph> to minimize the dialog, then "
"drag over a cell area to select the data range."
msgstr ""
"Calc-ում կտտացրեք <emph>Ընտրեք տվյալների միջակայքը</emph> երկխոսությունը "
"նվազագույնի հասցնելու համար, ապա քաշեք բջջային տարածքը` տվյալների միջակայքը "
"ընտրելու համար:"

#: wiz_data_range.xhp#par_id6823938.help.text
#: wiz_data_range.xhp%23par_id6823938.help.text
msgctxt "wiz_data_range.xhp#par_id6823938.help.text"
msgid ""
"If you want a data range of multiple cell areas that are not next to each "
"other, enter the first range, then manually add a semicolon at the end of "
"the text box, then enter the other ranges. Use a semicolon as delimiter "
"between ranges."
msgstr ""
"Եթե ցանկանում եք բազմաթիվ բջջային տարածքների տվյալներ, որոնք իրար կողքի չեն, "
"մուտքագրեք առաջին միջակայքը, ապա ձեռքով ավելացրեք կետ ստորակետ տեքստի տուփի "
"վերջում, ապա մուտքագրեք մյուս միջակայքերը: Օգտագործեք կետ ստորակետ, որպես "
"միջակայքերի սահմանազատիչ:"

#: wiz_data_range.xhp#par_id1434369.help.text
#: wiz_data_range.xhp%23par_id1434369.help.text
msgctxt "wiz_data_range.xhp#par_id1434369.help.text"
msgid "Click one of the options for data series in rows or in columns."
msgstr "Կտտացրեք տողերի կամ սյուների մեջ տվյալների շարքի տարբերակներից մեկը:"

#: wiz_data_range.xhp#par_id7524033.help.text
#: wiz_data_range.xhp%23par_id7524033.help.text
msgctxt "wiz_data_range.xhp#par_id7524033.help.text"
msgid ""
"Check whether the data range has labels in the first row or in the first "
"column or both."
msgstr ""
"Ստուգեք, արդյոք տվյալների միջակայքը առաջին շարքում կամ առաջին սյունակում կամ "
"երկուսում էլ ունի պիտակներ:"

#: wiz_data_range.xhp#par_id5256508.help.text
#: wiz_data_range.xhp%23par_id5256508.help.text
msgid "In the preview you can see how the final chart will look."
msgstr "Նախադիտումում կարող եք տեսնել, թե ինչ տեսք կունենա վերջնական աղյուսակը:"

#: wiz_data_range.xhp#par_id379650.help.text
#: wiz_data_range.xhp%23par_id379650.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Enter the data range that you want to "
"include in your chart. To minimize this dialog while you select the data "
"range in Calc, click the <emph>Select data range</emph> button.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Մուտքագրեք տվյալների միջակայքը, որը "
"ցանկանում եք ներառել ձեր գծապատկերում: Այս երկխոսությունը նվազագույնի "
"հասցնելու համար, երբ ընտրեք տվյալների միջակայքը Calc-ում, կտտացրեք <emph>"
"նտրեք տվյալների միջակայքը</emph> կոճակը:</ahelp>"

#: wiz_data_range.xhp#par_id953703.help.text
#: wiz_data_range.xhp%23par_id953703.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Data series get their data from "
"consecutive rows in the selected range. For scatter charts, the first data "
"series will contain x-values for all series. All other data series are used "
"as y-values, one for each series.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Տվյալների շարքերը ստանում են իրենց "
"տվյալները ընտրված տիրույթում անընդմեջ տողերից: Կուտակումով աղյուսակների "
"համար տվյալների առաջին շարքը պարունակում է X- արժեքներ բոլոր շարքերի համար: "
"Բոլոր մյուս տվյալների շարքերը օգտագործվում են որպես Y- արժեքներ, մեկական "
"յուրաքանչյուր շարքի համար:</ahelp>"

#: wiz_data_range.xhp#par_id4496597.help.text
#: wiz_data_range.xhp%23par_id4496597.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Data series get their data from "
"consecutive columns in the selected range. For scatter charts, the first "
"data column will contain x-values for all series. All other data columns are "
"used as y-values, one for each series.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Տվյալների շարքերը ստանում են իրենց "
"տվյալները ընտրված տիրույթում անընդմեջ սյունակներից: Կուտակումով աղյուսակների "
"համար տվյալների առաջին սյունակը պարունակում է X- արժեքներ բոլոր շարքերի "
"համար: Բոլոր այլ տվյալների սյունակները օգտագործվում են որպես Y- արժեքներ, "
"մեկական յուրաքանչյուր շարքի համար:</ahelp>"

#: wiz_data_range.xhp#par_id2898953.help.text
#: wiz_data_range.xhp%23par_id2898953.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">For data series in columns: The first "
"row in the range is used as names for data series. For data series in rows: "
"The first row in the range is used as categories. The remaining rows "
"comprise the data series. If this check box is not selected, all rows are "
"data series.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Սյունակում գտնվող տվյալների շարքի "
"համար. միջակայքում առաջին շարքը օգտագործվում է որպես անուններ տվյալների "
"շարքի համար: Տողերում տվյալների շարքի համար. միջակայքում առաջին շարքը "
"օգտագործվում է որպես դասեր: Մնացած շարքերը ձևավորում են տվյալների շարքերը: "
"Եթե այս վանդակը չի ընտրվում, բոլոր տողերը տվյալների շարքեր են:</ahelp>"

#: wiz_data_range.xhp#par_id7546311.help.text
#: wiz_data_range.xhp%23par_id7546311.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">For data series in columns: The first "
"column in the range is used as names for data series. For data series in "
"rows: The first column in the range is used as categories. The remaining "
"columns comprise the data columns. If this check box is not selected, all "
"columns are data columns.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Սյունակում գտնվող տվյալների շարքի "
"համար. միջակայքում առաջին սյունակը օգտագործվում է որպես անուններ տվյալների "
"շարքի համար: Տողերում տվյալների շարքի համար. միջակայքում առաջին սյունակը "
"օգտագործվում է որպես դասեր: Մնացած շարքերը ձևավորում են տվյալների "
"սյունակները: Եթե այս վանդակը չի ընտրվում, բոլոր սյունակները տվյալների "
"սյունակներ են:</ahelp>"

#: 05010100.xhp#tit.help.text
#: 05010100.xhp%23tit.help.text
msgid "Data Point"
msgstr "Տվյալների կետ"

#: 05010100.xhp#hd_id3153768.1.help.text
#: 05010100.xhp%23hd_id3153768.1.help.text
msgid ""
"<link href=\"text/schart/01/05010100.xhp\" name=\"Data Point\">Data "
"Point</link>"
msgstr ""
"<link href=\"text/schart/01/05010100.xhp\" name=\"Տվյալների կետ\">Տվյալների "
"կետ</link>"

#: 05010100.xhp#par_id3152577.2.help.text
#: 05010100.xhp%23par_id3152577.2.help.text
msgid ""
"This dialog allows you to change the properties of a selected data point. "
"The dialog appears when there is only one data point selected when you "
"choose <emph>Format - Format Selection</emph>. Some of the menu entries are "
"only available for 2D or 3D charts."
msgstr ""
"Այս երկխոսությունը թույլ է տալիս փոխել ընտրված տվյալների կետի "
"հատկությունները: Երկխոսությունը հայտնվում է, երբ ընտրվում է միայն տվյալների "
"մեկ կետ, երբ ընտրում եք <emph>Ձևաչափ - Ձևաչափի ընտրություն</emph>: "
"Ընտրացանկի որոշ մուտքերը հասանելի են միայն 2D կամ 3D գծապատկերների համար:"

#: 05010100.xhp#par_id3149121.3.help.text
#: 05010100.xhp%23par_id3149121.3.help.text
msgid ""
"Any changes made only affect this one data point. For example, if you edit "
"the color of a bar, only the color of that bar will be different."
msgstr ""
"Ցանկացած կատարած փոփոխություն արտացոլվում է միայն տվյալների այս մեկ կետի վրա:"
" Օրինակ, եթե խմբագրեք շետի գույնը, միայն այդ շերտի գույնը տարբեր կլինի:"

#: smooth_line_properties.xhp#tit.help.text
#: smooth_line_properties.xhp%23tit.help.text
msgctxt "smooth_line_properties.xhp#tit.help.text"
msgid "Smooth Line Properties"
msgstr "Հարթեցնող գծի հատկություններ"

#: smooth_line_properties.xhp#bm_id3803827.help.text
#: smooth_line_properties.xhp%23bm_id3803827.help.text
msgid ""
"<bookmark_value>curves;properties in line charts/XY "
"charts</bookmark_value><bookmark_value>properties;smooth lines in line "
"charts/XY charts</bookmark_value>"
msgstr ""
"<bookmark_value>կորեր;հատկությունները գծի գծապատկերներում/XY "
"գծապատկերներում</bookmark_value><bookmark_value>հատկություններ;հարթեցնող "
"գծեր գծի գծապատկերներում/XY գծապատկերներում</bookmark_value>"

#: smooth_line_properties.xhp#hd_id3050325.help.text
#: smooth_line_properties.xhp%23hd_id3050325.help.text
msgctxt "smooth_line_properties.xhp#hd_id3050325.help.text"
msgid "Smooth Line Properties"
msgstr "Հարթեցնող գծի հատկություններ"

#: smooth_line_properties.xhp#par_id9421979.help.text
#: smooth_line_properties.xhp%23par_id9421979.help.text
msgid ""
"In a chart that displays lines (Line type or XY type), you can choose to "
"show curves instead of straight lines. Some options control the properties "
"of those curves."
msgstr ""
"Գծապատկերում, որը ցուցադրում է գծեր (Գծի տեսակ կամ XY տեսակ), կարող եք "
"ընտրել ուղիղ գծերի փոխարեն կորեր: Որոշ տարբերակներ վերահսկում են այդ կորերի "
"հատկությունները:"

#: smooth_line_properties.xhp#hd_id1228370.help.text
#: smooth_line_properties.xhp%23hd_id1228370.help.text
msgid "To change line properties"
msgstr "Գծի հատկությունները փոխելու համար"

#: smooth_line_properties.xhp#par_id1601611.help.text
#: smooth_line_properties.xhp%23par_id1601611.help.text
msgid "Select Cubic Spline or B-Spline."
msgstr "Ընտրեք խորանարդ Spline կամ B-Spline:"

#: smooth_line_properties.xhp#par_id879848.help.text
#: smooth_line_properties.xhp%23par_id879848.help.text
msgid ""
"These are mathematical models that influence the display of the curves. The "
"cubic spline line passes through all points, while the B-spline line "
"connects the first and last point and passes by the intermediate points."
msgstr ""
"Սրանք մաթեմատիկական մոդելներ են, որոնք ազդում են կորերի ցուցադրման վրա: "
"Խորանարդ spline գիծը անցնում է բոլոր կետերի միջով, մինչդեռ B-slipine գիծը "
"միացնում է առաջին եւ վերջին կետերը եւ անցնում միջանկյալ կետերով:"

#: smooth_line_properties.xhp#par_id3464461.help.text
#: smooth_line_properties.xhp%23par_id3464461.help.text
msgid "Optionally set the resolution. A higher value leads to a smoother line."
msgstr ""
"Ընտրովի կարգավորել բանաձեւը: Ավելի բարձր արժեքը բերում է ավելի հարթ գծի:"

#: smooth_line_properties.xhp#par_id6998809.help.text
#: smooth_line_properties.xhp%23par_id6998809.help.text
msgid "For B-spline lines optionally set the data points order."
msgstr "B-spline տողերի համար ըստ ցանկության սահմանել տվյալների կետերի կարգը:"

#: smooth_line_properties.xhp#par_id3424481.help.text
#: smooth_line_properties.xhp%23par_id3424481.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Apply a cubic spline model.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Կիրառեք խորանարդի spline "
"մոդել:</ahelp>"

#: smooth_line_properties.xhp#par_id1068758.help.text
#: smooth_line_properties.xhp%23par_id1068758.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Apply a B-spline model.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Կիրառեք B-spline մոդելը:</ahelp>"

#: smooth_line_properties.xhp#par_id2320932.help.text
#: smooth_line_properties.xhp%23par_id2320932.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Set the resolution.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Սահմանել բանաձեւը:</ahelp>"

#: smooth_line_properties.xhp#par_id8638874.help.text
#: smooth_line_properties.xhp%23par_id8638874.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Set the data points order.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Սահմանեք տվյալների կետերի "
"կարգը:</ahelp>"

#: 05060000.xhp#tit.help.text
#: 05060000.xhp%23tit.help.text
msgctxt "05060000.xhp#tit.help.text"
msgid "Chart Wall"
msgstr "Գծապատկերի պատ"

#: 05060000.xhp#bm_id3150792.help.text
#: 05060000.xhp%23bm_id3150792.help.text
msgid ""
"<bookmark_value>charts; formatting "
"walls</bookmark_value><bookmark_value>formatting;chart walls</bookmark_value>"
msgstr ""
"<bookmark_value>գծապատկերներ; պատերի "
"ձեւաչափում</bookmark_value><bookmark_value>ձևաչափում;գծապատկերի "
"պատեր</bookmark_value>"

#: 05060000.xhp#hd_id3150792.1.help.text
#: 05060000.xhp%23hd_id3150792.1.help.text
msgctxt "05060000.xhp#hd_id3150792.1.help.text"
msgid "Chart Wall"
msgstr "Գծապատկերի պատ"

#: 05060000.xhp#par_id3154685.2.help.text
#: 05060000.xhp%23par_id3154685.2.help.text
msgid ""
"<variable id=\"diagramm\"><ahelp visibility=\"visible\" hid=\".uno:"
"DiagramWall\">Opens the<emph> Chart Wall</emph> dialog, where you can modify "
"the properties of the chart wall. The chart wall is the \"vertical\" "
"background behind the data area of the chart.</ahelp></variable>"
msgstr ""
"<variable id=\"diagramm\"><ahelp visibility=\"visible\" hid=\".uno:"
"DiagramWall\">Բացում է<emph> Գծապատկերի պատ</emph> երկխոսությունը, որտեղ "
"կարող եք փոփոխել գծապատկերի պատի հատկությունները: Գծապատկերային պատը "
"գծապատկերի տվյալների տարածքի «ուղղահայաց» ֆոնն է:</ahelp></variable>"

#: 05040100.xhp#tit.help.text
#: 05040100.xhp%23tit.help.text
msgctxt "05040100.xhp#tit.help.text"
msgid "Axes"
msgstr "Առանցքներ"

#: 05040100.xhp#bm_id3153768.help.text
#: 05040100.xhp%23bm_id3153768.help.text
msgid "<bookmark_value>axes;formatting</bookmark_value>"
msgstr "<bookmark_value>առանցքներ;ձևաչափում</bookmark_value>"

#: 05040100.xhp#hd_id3153768.1.help.text
#: 05040100.xhp%23hd_id3153768.1.help.text
msgctxt "05040100.xhp#hd_id3153768.1.help.text"
msgid "Axes"
msgstr "Առանցքներ"

#: 05040100.xhp#par_id3154319.2.help.text
#: 05040100.xhp%23par_id3154319.2.help.text
msgid ""
"<variable id=\"achsen\"><ahelp hid=\".uno:DiagramAxisAll\">Opens a dialog, "
"where you can edit the properties of the selected axis.</ahelp></variable> "
"The name of the dialog depends on the selected axis."
msgstr ""
"<variable id=\"achsen\"><ahelp hid=\".uno:DiagramAxisAll\">Բացվում է "
"երկխոսություն, որտեղ կարող եք խմբագրել ընտրված առանցքի "
"հատկությունները։</ahelp></variable> Երկխոսության անվանումը կախված է ընտրված "
"առանցքից:"

#: 05040100.xhp#par_id3149667.3.help.text
#: 05040100.xhp%23par_id3149667.3.help.text
msgid ""
"The <link href=\"text/schart/01/05040200.xhp\" name=\"Y axis\">Y axis</link> "
"has an enhanced dialog. For X-Y charts, the X axis chart is also enhanced by "
"the <link href=\"text/schart/01/05040201.xhp\" name=\"Scaling\""
"><emph>Scaling</emph></link> tab."
msgstr ""
"<link href=\"text/schart/01/05040200.xhp\" name=\"Y առանցք\">Y առանցք</link> "
"-ը ունի ընդլայնված երկխոսություն: X-Y գծապատկերների համար X առանցքի "
"գծապատկերը նույնպես ընդլայնված է <link href=\"text/schart/01/05040201.xhp\" "
"name=\"Մասշտաբավորում\"><emph>Մասշտաբավորում</emph></link> ներդիրով։"

#: 05040100.xhp#par_id3159266.4.help.text
#: 05040100.xhp%23par_id3159266.4.help.text
msgid "Scaling the X axis is only possible in the X-Y chart type."
msgstr "X առանցքի մասշտաբավորումը հնարավոր է միայն X-Y գծապատկերային տիպում:"

#: 05040100.xhp#hd_id3145230.5.help.text
#: 05040100.xhp%23hd_id3145230.5.help.text
msgctxt "05040100.xhp#hd_id3145230.5.help.text"
msgid ""
"<link href=\"text/shared/01/05020100.xhp\" name=\"Character\""
">Character</link>"
msgstr "<link href=\"text/shared/01/05020100.xhp\" name=\"Նիշ\">Նիշ</link>"

#: 04020000.xhp#tit.help.text
#: 04020000.xhp%23tit.help.text
msgctxt "04020000.xhp#tit.help.text"
msgid "Legend"
msgstr "Լեգենդ"

#: 04020000.xhp#bm_id3156441.help.text
#: 04020000.xhp%23bm_id3156441.help.text
msgid ""
"<bookmark_value>chart legends; hiding</bookmark_value><bookmark_value>hiding;"
"chart legends</bookmark_value>"
msgstr ""
"<bookmark_value>գծապատկերային լեգենդներ; "
"թաքցնել</bookmark_value><bookmark_value>թաքցնել;գծապատկերային "
"լեգենդներ</bookmark_value>"

#: 04020000.xhp#hd_id3156441.1.help.text
#: 04020000.xhp%23hd_id3156441.1.help.text
msgctxt "04020000.xhp#hd_id3156441.1.help.text"
msgid "Legend"
msgstr "Լեգենդ"

#: 04020000.xhp#par_id3155413.2.help.text
#: 04020000.xhp%23par_id3155413.2.help.text
msgid ""
"<variable id=\"legende\"><ahelp hid=\".uno:InsertMenuLegend\">Opens the "
"<emph>Legend </emph>dialog, which allows you to change the position of "
"legends in the chart, and to specify whether the legend is "
"displayed.</ahelp></variable>"
msgstr ""
"<variable id=\"legende\"><ahelp hid=\".uno:InsertMenuLegend\">Բացում է <emph>"
"Լեգենդ </emph>երկխոսությունը, որը թույլ է տալիս փոխել լեգենդների դիրքը "
"գծապատկերում եւ նշել, թե արդյոք լեգենդը ցուցադրվում է:</ahelp></variable>"

#: 04020000.xhp#par_id3149124.3.help.text
#: 04020000.xhp%23par_id3149124.3.help.text
msgid ""
"<variable id=\"sytextlegende\"><ahelp hid=\".uno:ToggleLegend\">To show or "
"hide a legend, click <emph>Legend On/Off</emph> on the "
"<emph>Formatting</emph> bar.</ahelp></variable>"
msgstr ""
"<variable id=\"sytextlegende\"><ahelp hid=\".uno:ToggleLegend\">Լեգենդը "
"ցուցադրելու համար թաքցրեք լեգենդը, կտտացրեք <emph>Լեգենդը "
"Միացված/Անջատված</emph> <emph>Ձևաչափում</emph> տողում:</ahelp></variable>"

#: 04020000.xhp#par_id3145230.help.text
