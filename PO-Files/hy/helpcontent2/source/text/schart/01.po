#: type_pie.xhp#tit.help.text
#: type_pie.xhp%23tit.help.text
msgid "Chart Type Pie "
msgstr "Գծապատկերի տիպի կարկանդակ"

#: type_pie.xhp#bm_id7621997.help.text
#: type_pie.xhp%23bm_id7621997.help.text
msgid ""
"<bookmark_value>donut charts</bookmark_value>      <bookmark_value>pie "
"charts;types</bookmark_value>      <bookmark_value>chart "
"types;pie/donut</bookmark_value>"
msgstr ""
"<bookmark_value>donut charts</bookmark_value>      <bookmark_value>pie "
"charts;types</bookmark_value>      <bookmark_value>chart "
"types;pie/donut</bookmark_value>"

#: type_pie.xhp#hd_id3365276.help.text
#: type_pie.xhp%23hd_id3365276.help.text
msgid ""
"<variable id=\"type_pie\"><link href=\"text/schart/01/type_pie.xhp\">Chart "
"Type Pie</link></variable>"
msgstr ""
"<variable id=\"type_pie\"><link href=\"text/schart/01/type_pie.xhp\">"
"Գծապատկերի տիպի կարկանդակ</link></variable>"

#: type_pie.xhp#par_id245979.help.text
#: type_pie.xhp%23par_id245979.help.text
msgctxt "type_pie.xhp#par_id245979.help.text"
msgid ""
"On the first page of the <link href=\"text/schart/01/wiz_chart_type.xhp\">"
"Chart Wizard</link> you can choose a chart type. "
msgstr ""
"<link href=\"text/schart/01/wiz_chart_type.xhp\">Գծապատկերի հրաշագործի</link>"
" առաջին էջում կարող եք ընտրել գծապատկերի տեսակը։ "

#: type_pie.xhp#hd_id5799432.help.text
#: type_pie.xhp%23hd_id5799432.help.text
msgid "Pie"
msgstr "Կարկանդակ"

#: type_pie.xhp#par_id6549272.help.text
#: type_pie.xhp%23par_id6549272.help.text
msgid ""
"A pie chart shows values as circular sectors of the total circle. The length "
"of the arc, or the area of each sector, is proportional to its value."
msgstr ""
"Կարկանդակի աղյուսակը ցույց է տալիս արժեքները որպես ընդհանուր օղակի շրջանաձև "
"հատվածներ: Աղեղի երկարությունը կամ յուրաքանչյուր հատվածի տարածքը համաչափ է "
"դրա արժեքի հետ:"

#: type_pie.xhp#par_id6529740.help.text
#: type_pie.xhp%23par_id6529740.help.text
msgid ""
"Pie - this subtype shows sectors as colored areas of the total pie, for one "
"data column only. In the created chart, you can click and drag any sector to "
"separate that sector from the remaining pie or to join it back."
msgstr ""
"Կարկանդակ - այս ենթատեսակը ցույց է տալիս հատվածները որպես ընդհանուր "
"կարկանդակի գունավոր տարածքներ, միայն մեկ տվյալների սյունակի համար: Ստեղծված "
"գծապատկերում կարող եք սեղմել և քաշել ցանկացած հատված՝ այդ հատվածը մնացած "
"կարկանդակից առանձնացնելու կամ հետ միացնելու համար:"

#: type_pie.xhp#par_id9121982.help.text
#: type_pie.xhp%23par_id9121982.help.text
msgid ""
"Exploded pie - this subtype shows the sectors already separated from each "
"other. In the created chart, you can click and drag any sector to move it "
"along a radial from the pie's center."
msgstr ""
"Պայթեցված կարկանդակ - այս ենթատեսակը ցույց է տալիս միմյանցից արդեն "
"առանձնացված հատվածները: Ստեղծված գծապատկերում կարող եք սեղմել և քաշել "
"ցանկացած հատված՝ այն կարկանդակի կենտրոնից շառավղով տեղափոխելու համար:"

#: type_pie.xhp#par_id3808404.help.text
#: type_pie.xhp%23par_id3808404.help.text
msgid ""
"Donut - this subtype can show multiple data columns. Each data column is "
"shown as one donut shape with a hole inside, where the next data column can "
"be shown. In the created chart, you can click and drag an outer sector to "
"move it along a radial from the donut's center."
msgstr ""
"ԴՈՆԱԹ - այս ենթատեսակը կարող է ցույց տալ տվյալների բազմաթիվ սյուներ: "
"Տվյալների յուրաքանչյուր սյունը ցուցադրվում է որպես մեկ բլիթի ձև, որի մեջ կա "
"անցք, որտեղ կարելի է ցույց տալ տվյալների հաջորդ սյունը: Ստեղծված "
"գծապատկերում կարող եք սեղմել և քաշել արտաքին հատվածը, այն բլիթի կենտրոնից "
"շեղակի երկայնքով տեղափոխելու համար:"

#: type_pie.xhp#par_id2394482.help.text
#: type_pie.xhp%23par_id2394482.help.text
msgid ""
"Exploded donut - this subtype shows the outer sectors already separated from "
"the remaining donut. In the created chart, you can click and drag an outer "
"sector to move it along a radial from the donut's center."
msgstr ""
"Պայթուցիկ բլիթ. Այս ենթատեսակը ցույց է տալիս մնացած հատվածից արդեն "
"առանձնացված արտաքին հատվածները: Ստեղծված գծապատկերում կարող եք սեղմել և "
"քաշել արտաքին հատվածը, այն բլիթի կենտրոնից շեղակի երկայնքով տեղափոխելու "
"համար:"

#: 05050100.xhp#tit.help.text
#: 05050100.xhp%23tit.help.text
msgctxt "05050100.xhp#tit.help.text"
msgid "Grid"
msgstr "Ցանց"

#: 05050100.xhp#bm_id3150398.help.text
#: 05050100.xhp%23bm_id3150398.help.text
msgid ""
"<bookmark_value>X axes;grid formatting</bookmark_value><bookmark_value>Y "
"axes;grid formatting</bookmark_value><bookmark_value>Z axes; grid "
"formatting</bookmark_value>"
msgstr ""
"<bookmark_value>X axes;grid formatting</bookmark_value><bookmark_value>Y "
"axes;grid formatting</bookmark_value><bookmark_value>Z axes; grid "
"formatting</bookmark_value>"

#: 05050100.xhp#hd_id3150398.2.help.text
#: 05050100.xhp%23hd_id3150398.2.help.text
msgctxt "05050100.xhp#hd_id3150398.2.help.text"
msgid "Grid"
msgstr "Ցանց"

#: 05050100.xhp#par_id3152577.1.help.text
#: 05050100.xhp%23par_id3152577.1.help.text
msgid ""
"<variable id=\"gitter\"><ahelp hid=\".uno:DiagramGridAll\">Opens the "
"<emph>Grid</emph> dialog for defining grid properties.</ahelp></variable>"
msgstr ""
"<variable id=\"gitter\"><ahelp hid=\".uno:DiagramGridAll\">Բացում է "
"<emph>Ցանց</emph> երկխոսությունը՝ ցանցի հատկությունների որոշման "
"համար:</ahelp></variable>"

#: 04050100.xhp#tit.help.text
#: 04050100.xhp%23tit.help.text
msgid "Trend Lines "
msgstr "Միտումի գծեր"

#: 04050100.xhp#bm_id1744743.help.text
#: 04050100.xhp%23bm_id1744743.help.text
msgid ""
"<bookmark_value>calculating;regression curves</bookmark_value>      "
"<bookmark_value>regression curves in charts</bookmark_value>      "
"<bookmark_value>trend lines in charts</bookmark_value>      <bookmark_value>"
"mean value lines in charts</bookmark_value>"
msgstr ""
"<bookmark_value>calculating;regression curves</bookmark_value>      "
"<bookmark_value>regression curves in charts</bookmark_value>      "
"<bookmark_value>trend lines in charts</bookmark_value>      <bookmark_value>"
"mean value lines in charts</bookmark_value>"

#: 04050100.xhp#hd_id5409405.help.text
#: 04050100.xhp%23hd_id5409405.help.text
msgid ""
"<variable id=\"regression\"><link href=\"text/schart/01/04050100.xhp\">Trend "
"Lines</link></variable>"
msgstr ""
"<variable id=\"regression\"><link href=\"text/schart/01/04050100.xhp\">"
"Միտումի գծեր</link></variable>"

#: 04050100.xhp#par_id7272255.help.text
#: 04050100.xhp%23par_id7272255.help.text
msgid ""
"<variable id=\"trendlinestext\"><ahelp hid=\".\">Trend lines can be added to "
"all 2D chart types except for Pie and Stock charts.</ahelp></variable>"
msgstr ""
"<variable id=\"trendlinestext\"><ahelp hid=\".\">Թրենդային գծերը կարող են "
"ավելացվել բոլոր 2D գծապատկերների բոլոր տեսակների համար, բացառությամբ "
"կարկանդակ և ֆոնդային գծապատկերների:</ahelp></variable>"

#: 04050100.xhp#par_id143436.help.text
#: 04050100.xhp%23par_id143436.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">No trend line is shown.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Թրենդային գիծ չի ցուցադրվում:</ahelp>"

#: 04050100.xhp#par_id5716727.help.text
#: 04050100.xhp%23par_id5716727.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">A linear trend line is shown.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ցուցադրվում է թրենդի գծային "
"գիծը:</ahelp>"

#: 04050100.xhp#par_id5840021.help.text
#: 04050100.xhp%23par_id5840021.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">A logarithmic trend line is "
"shown.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ցուցադրվում է լոգարիթմական թրենդային "
"գիծը:</ahelp>"

#: 04050100.xhp#par_id9417096.help.text
#: 04050100.xhp%23par_id9417096.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">An exponential trend line is "
"shown.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ցուցադրվում է էքսպոնենտալ թրենդային "
"գիծը:</ahelp>"

#: 04050100.xhp#par_id8482924.help.text
#: 04050100.xhp%23par_id8482924.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">A power trend line is shown.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ցուցադրվում է աստիճանական թրենդային "
"գիծը:</ahelp>"

#: 04050100.xhp#par_id8962370.help.text
#: 04050100.xhp%23par_id8962370.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Shows the trend line equation next to "
"the trend line.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ցույց է տալիս տողերի գծի հավասարումը՝ "
"թրենդի գծի կողքին:</ahelp>"

#: 04050100.xhp#par_id6889858.help.text
#: 04050100.xhp%23par_id6889858.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Shows the coefficient of "
"determination next to the trend line.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ցույց է տալիս դետերմինանտի գործակիցը` "
"միտման գծի կողքին:</ahelp>"

#: 04050100.xhp#par_id8398998.help.text
#: 04050100.xhp%23par_id8398998.help.text
msgid ""
"If you insert a trend line to a chart type that uses categories, like <emph>"
"Line </emph>or <emph>Column, </emph>then the numbers 1, 2, 3, <emph>…</emph> "
"are used as x-values to calculate the trend line."
msgstr ""
"Եթե միտումի գիծ եք ներդնում գծապատկերի տիպում, որն օգտագործում է կարգեր, "
"օրինակ՝ <emph>Տող </emph> կամ <emph>Սյունակ, </emph>, ապա 1, 2, 3, "
"<emph>…</emph> թվերը օգտագործվում են որպես x -արժեքներ` միտման գիծը "
"հաշվարկելու համար:"

#: 04050100.xhp#par_id5676747.help.text
#: 04050100.xhp%23par_id5676747.help.text
msgid ""
"To insert trend lines for all data series, double-click the chart to enter "
"edit mode. Choose <item type=\"menuitem\">Insert - Trend Lines</item>, then "
"select the type of trend line from None, Linear, Logarithmic, Exponential, "
"or Power trend line."
msgstr ""
"Տվյալների բոլոր շարքերի համար միտումի գծերը տեղադրելու համար երկու անգամ "
"սեղմեք գծապատկերը՝ խմբագրման ռեժիմը մուտք գործելու համար: Ընտրեք <item type="
"\"menuitem\">Տեղադրեք - Միտումի գծեր</item>, ապա Ոչ մեկը, Գծային, "
"Լոգարիթմական, էքսպոնենտալ կամ Աստիճան միտումի գծից ընտրեք միտումի գծի տեսակը:"

#: 04050100.xhp#par_id4349192.help.text
#: 04050100.xhp%23par_id4349192.help.text
msgid ""
"To insert a trend line for a single data series, select the data series in "
"the chart, right-click to open the context menu, and choose <item type=\""
"menuitem\">Insert - Trend Line</item>."
msgstr ""
"Տվյալների մեկ շարքի համար միտումի գիծ տեղադրելու համար ընտրեք տվյալների "
"շարքը գծապատկերում, աջ սեղմեք համատեքստային ընտրացանկը բացելու համար և "
"ընտրեք <item type=\"menuitem\">Տեղադրեք - Միտումի գիծ</item>:"

#: 04050100.xhp#par_id9337443.help.text
#: 04050100.xhp%23par_id9337443.help.text
msgid ""
"To delete a single trend line or mean value line, click the line, then press "
"the Del key."
msgstr ""
"Միտումի մեկ գիծը կամ միջին արժեքի գիծը ջնջելու համար կտտացրեք տողը, ապա "
"սեղմեք Del ստեղնը:"

#: 04050100.xhp#par_id4529251.help.text
#: 04050100.xhp%23par_id4529251.help.text
msgid ""
"To delete all trend lines, choose <item type=\"menuitem\">Insert - Trend "
"Lines</item>, then select <emph>None</emph>."
msgstr ""
"Մտումի գծերը ջնջելու համար, սեղմեք <item type=\"menuitem\">Տեղադրեք - "
"Միտումի գծեր</item>, ապա ընըտրեք <emph>Ոչ մեկը</emph>։"

#: 04050100.xhp#par_id296334.help.text
#: 04050100.xhp%23par_id296334.help.text
msgid "A trend line is shown in the legend automatically."
msgstr "Միտումի գիծը լեգենդում ինքնաբերաբար ցուցադրվում է:"

#: 04050100.xhp#par_id4072084.help.text
#: 04050100.xhp%23par_id4072084.help.text
msgid ""
"<ahelp hid=\".\">Mean Value Lines are special trend lines that show the mean "
"value. Use <item type=\"menuitem\">Insert - Mean Value Lines</item> to "
"insert mean value lines for data series.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Միջին արժեքի գծերը հատուկ միտման գծեր են, որոնք ցույց են "
"տալիս միջին արժեքը: Օգտագործեք <item type=\"menuitem\">Տեղադրեք - Միջին "
"արժեքի գծերը</item> տվյալների շարքի համար միջին արժեքային տողեր տեղադրելու "
"համար:</ahelp>"

#: 04050100.xhp#par_id9569689.help.text
#: 04050100.xhp%23par_id9569689.help.text
msgid ""
"The trend line has the same color as the corresponding data series. To "
"change the line properties, select the trend line and choose <item type=\""
"menuitem\">Format - Format Selection - Line</item>."
msgstr ""
"Միտումի գիծը ունի նույն գույնը, ինչը ունի համապատասխան տվյալների շարքը: Գծի "
"հատկությունները փոխելու համար ընտրեք միտումի գիծը և ընտրեք <item type=\""
"menuitem\">Ձևաչափ - Ձևաչափի ընտրությունn - Գիծ</item>։"

#: 04050100.xhp#par_id846888.help.text
#: 04050100.xhp%23par_id846888.help.text
msgid ""
"<ahelp hid=\".\">To show the trend line equation, select the trend line in "
"the chart, right-click to open the context menu, and choose <emph>Insert "
"Trend Line Equation</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Միտումի գծի հավասարումը ցույց տալու համար ընտրեք միտումի "
"գիծը աղյուսակում, աջ սեղմեք համատեքստային ընտրացանկը բացելու համար և ընտրեք "
"<emph>Տեղադրեք տենդային գծի հավասարումը</emph>.</ahelp>"

#: 04050100.xhp#par_id8962065.help.text
#: 04050100.xhp%23par_id8962065.help.text
msgid ""
"When the chart is in edit mode, %PRODUCTNAME gives you the equation of the "
"trend line and the coefficient of determination R². Click on the trend line "
"to see the information in the status bar."
msgstr ""
"Երբ գծապատկերը խմբագրման ռեժիմում է,%PRODUCTNAME -ը տալիս է միտումային գծի "
"հավասարությունը և որոշման R² գործակիցը: Կտտացրեք միտումի գծին՝ վիճակի տողում "
"տեղեկությունները տեսնելու համար:"

#: 04050100.xhp#par_id1328470.help.text
#: 04050100.xhp%23par_id1328470.help.text
msgid ""
"For a category chart (for example a line chart), the trend line information "
"is calculated using numbers 1, 2, 3, … as x-values. This is also true if "
"your data series uses other numbers as names for the x-values. For such "
"charts the XY chart type might be more suitable."
msgstr ""
"Դասի գծապատկերում (օրինակ՝ տողի գծապատկեր), տեքստի գծի տեղեկատվությունը "
"հաշվարկվում է՝ օգտագործելով 1, 2, 3,… համարները որպես x- արժեքներ: Սա "
"նույնպես ճիշտ է, եթե ձեր տվյալների շարքը այլ թվեր է օգտագործում՝ որպես անուն "
"x- արժեքների համար: Նման գծապատկերների համար XY աղյուսակի տեսակը կարող է "
"ավելի հարմար լինել:"

#: 04050100.xhp#par_id8092593.help.text
#: 04050100.xhp%23par_id8092593.help.text
msgid ""
"To show the equation and the coefficient of determination, select the trend "
"line and choose <item type=\"menuitem\">Format - Format Selection - "
"Equation</item>."
msgstr ""
"Հավասարումը և որոշման գործակիցը ցույց տալու համար ընտրեք միտումի գիծը և "
"ընտրեք <item type=\"menuitem\">Ձևաչափ - Ձևաչափի ընտրություն - "
"Հավասարում</item>։"

#: 04050100.xhp#par_id7971434.help.text
#: 04050100.xhp%23par_id7971434.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Enable Show equation to see the "
"equation of the trend line.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Միացրեք Ցույց տալ հավասարումը` "
"տեսնելու համար միտումի գծի հավասարումը:</ahelp>"

#: 04050100.xhp#par_id558793.help.text
#: 04050100.xhp%23par_id558793.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Enable Show Coefficient of "
"Determination to see the determination coefficient of the trend line.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Միացրեք Ցույց տալ գործակիցը` որոշելու "
"միտումի գծի որոշման գործակիցը:</ahelp>"

#: 04050100.xhp#par_id7735221.help.text
#: 04050100.xhp%23par_id7735221.help.text
msgid "You can also calculate the parameters using Calc functions as follows."
msgstr ""
"Կարող եք նաև հաշվարկել պարամետրերը՝ օգտագործելով Calc գործառույթները "
"հետևյալի միջոցով:"

#: 04050100.xhp#hd_id5744193.help.text
#: 04050100.xhp%23hd_id5744193.help.text
msgid "The linear regression equation"
msgstr "Գծային ռեգրեսիայի հավասարումը"

#: 04050100.xhp#par_id9251991.help.text
#: 04050100.xhp%23par_id9251991.help.text
msgid ""
"The <emph>linear regression</emph> follows the equation <item type=\""
"literal\">y=m*x+b</item>."
msgstr ""
"<emph>Գծային ռեգրեսիան</emph> հետևում է հավասարմանը <item type=\"literal\""
">y=m*x+b</item>."

#: 04050100.xhp#par_id7951902.help.text
#: 04050100.xhp%23par_id7951902.help.text
msgid "m = SLOPE(Data_Y;Data_X) "
msgstr "m = SLOPE(Data_Y;Data_X) "

#: 04050100.xhp#par_id6637165.help.text
#: 04050100.xhp%23par_id6637165.help.text
msgid "b = INTERCEPT(Data_Y ;Data_X) "
msgstr "b = INTERCEPT(Data_Y ;Data_X) "

#: 04050100.xhp#par_id7879268.help.text
#: 04050100.xhp%23par_id7879268.help.text
msgctxt "04050100.xhp#par_id7879268.help.text"
msgid "Calculate the coefficient of determination by"
msgstr "Հաշվարկեք որոշման գործակիցը ըստ"

#: 04050100.xhp#par_id9244361.help.text
#: 04050100.xhp%23par_id9244361.help.text
msgid "r² = RSQ(Data_Y;Data_X) "
msgstr "r² = RSQ(Data_Y;Data_X) "

#: 04050100.xhp#par_id2083498.help.text
#: 04050100.xhp%23par_id2083498.help.text
msgid ""
"Besides m, b and r² the array function <emph>LINEST</emph> provides "
"additional statistics for a regression analysis."
msgstr ""
"Բացի m, b և r² զանգվածի <emph>LINEST</emph> գործառույթը տրամադրում է "
"լրացուցիչ վիճակագրություն՝ ռեգրեսիայի վերլուծության համար:"

#: 04050100.xhp#hd_id2538834.help.text
#: 04050100.xhp%23hd_id2538834.help.text
msgid "The logarithm regression equation"
msgstr "Լոգարիթմի ռեգրեսիայի հավասարումը"

#: 04050100.xhp#par_id394299.help.text
#: 04050100.xhp%23par_id394299.help.text
msgid ""
"The <emph>logarithm regression</emph> follows the equation <item type=\""
"literal\">y=a*ln(x)+b</item>."
msgstr ""
"<emph>Լոգարիթմի ռեգրեսիան</emph> հտևում է հավասարմանը <item type=\"literal\""
">y=a*ln(x)+b</item>."

#: 04050100.xhp#par_id2134159.help.text
#: 04050100.xhp%23par_id2134159.help.text
msgid "a = SLOPE(Data_Y;LN(Data_X)) "
msgstr "a = SLOPE(Data_Y;LN(Data_X)) "

#: 04050100.xhp#par_id5946531.help.text
#: 04050100.xhp%23par_id5946531.help.text
msgid "b = INTERCEPT(Data_Y ;LN(Data_X)) "
msgstr "b = INTERCEPT(Data_Y ;LN(Data_X)) "

#: 04050100.xhp#par_id5649281.help.text
#: 04050100.xhp%23par_id5649281.help.text
msgid "r² = RSQ(Data_Y;LN(Data_X)) "
msgstr "r² = RSQ(Data_Y;LN(Data_X)) "

#: 04050100.xhp#hd_id7874080.help.text
#: 04050100.xhp%23hd_id7874080.help.text
msgid "The exponential regression equation"
msgstr "Էքսպոնենցիոնալ ռեգրեսիայի հավասարումը"

#: 04050100.xhp#par_id4679097.help.text
#: 04050100.xhp%23par_id4679097.help.text
msgid ""
" For exponential trend lines a transformation to a linear model takes place. "
"The optimal curve fitting is related to the linear model and the results are "
"interpreted accordingly. "
msgstr ""
" Էքսպոնենտալ միտման գծերի համար տեղի է ունենում գծային մոդելի վերափոխում: "
"Կորի օպտիմալ տեղավորումը կապված է գծային մոդելի հետ և արդյունքները "
"համապատասխանաբար մեկնաբանվում են։ "

#: 04050100.xhp#par_id9112216.help.text
#: 04050100.xhp%23par_id9112216.help.text
msgid ""
"The exponential regression follows the equation <item type=\"literal\""
">y=b*exp(a*x)</item> or <item type=\"literal\">y=b*m^x</item>, which is "
"transformed to <item type=\"literal\">ln(y)=ln(b)+a*x</item> or <item type=\""
"literal\">ln(y)=ln(b)+ln(m)*x</item> respectively."
msgstr ""
"Էքսպոնենտալ ռեգրեսիան հետևում է հավասարմանը <item type=\"literal\""
">y=b*exp(a*x)</item> or <item type=\"literal\">y=b*m^x</item>, որը "
"վերափոխվում է <item type=\"literal\">ln(y)=ln(b)+a*x</item> կամ <item type=\""
"literal\">ln(y)=ln(b)+ln(m)*x</item> համապատասխանաբար։"

#: 04050100.xhp#par_id4416638.help.text
#: 04050100.xhp%23par_id4416638.help.text
msgid "a = SLOPE(LN(Data_Y);Data_X) "
msgstr "a = SLOPE(LN(Data_Y);Data_X) "

#: 04050100.xhp#par_id1039155.help.text
#: 04050100.xhp%23par_id1039155.help.text
msgid "The variables for the second variation are calculated as follows:"
msgstr "Երկրորդ տարբերակի համար փոփոխականները հաշվարկվում են հետևյալ կերպ."

#: 04050100.xhp#par_id7184057.help.text
#: 04050100.xhp%23par_id7184057.help.text
msgid "m = EXP(SLOPE(LN(Data_Y);Data_X)) "
msgstr "m = EXP(SLOPE(LN(Data_Y);Data_X)) "

#: 04050100.xhp#par_id786767.help.text
#: 04050100.xhp%23par_id786767.help.text
msgid "b = EXP(INTERCEPT(LN(Data_Y);Data_X)) "
msgstr "b = EXP(INTERCEPT(LN(Data_Y);Data_X)) "

#: 04050100.xhp#par_id7127292.help.text
#: 04050100.xhp%23par_id7127292.help.text
msgctxt "04050100.xhp#par_id7127292.help.text"
msgid "Calculate the coefficient of determination by"
msgstr "Հաշվարկեք որոշման գործակիցը ըստ"

#: 04050100.xhp#par_id5437177.help.text
#: 04050100.xhp%23par_id5437177.help.text
msgid "r² = RSQ(LN(Data_Y);Data_X) "
msgstr "r² = RSQ(LN(Data_Y);Data_X) "

#: 04050100.xhp#par_id6946317.help.text
#: 04050100.xhp%23par_id6946317.help.text
msgid ""
"Besides m, b and r² the array function LOGEST provides additional statistics "
"for a regression analysis."
msgstr ""
"բացի m, b և r² զանգվածի LOGEST գործառույթը տրամադրում է լրացուցիչ "
"վիճակագրություն՝ ռեգրեսիայի վերլուծության համար:"

#: 04050100.xhp#hd_id6349375.help.text
#: 04050100.xhp%23hd_id6349375.help.text
msgid "The power regression equation"
msgstr "Աստիճանային ռեգրեսիայի հավասարում"

#: 04050100.xhp#par_id1857661.help.text
#: 04050100.xhp%23par_id1857661.help.text
msgid ""
" For <emph>power regression</emph> curves a transformation to a linear model "
"takes place. The power regression follows the equation <item type=\"literal\""
">y=b*x^a</item> , which is transformed to <item type=\"literal\""
">ln(y)=ln(b)+a*ln(x)</item>."
msgstr ""
"<emph>Աստիճանային ռեգրեսիայի</emph> կորերի համար տեղի են ունենում գծային "
"մոդելի վերափոխումներ: Աստիճանային ռեգրեսիան հետևում է հավասարմանը <item type="
"\"literal\">y=b*x^a</item>,որը վերափոխվում է <item type=\"literal\""
">ln(y)=ln(b)+a*ln(x)</item>։"

#: 04050100.xhp#par_id8517105.help.text
#: 04050100.xhp%23par_id8517105.help.text
msgid "a = SLOPE(LN(Data_Y);LN(Data_X)) "
msgstr "a = SLOPE(LN(Data_Y);LN(Data_X)) "

#: 04050100.xhp#par_id9827265.help.text
#: 04050100.xhp%23par_id9827265.help.text
msgid "b = EXP(INTERCEPT(LN(Data_Y);LN(Data_X)) "
msgstr "b = EXP(INTERCEPT(LN(Data_Y);LN(Data_X)) "

#: 04050100.xhp#par_id2357249.help.text
#: 04050100.xhp%23par_id2357249.help.text
msgid "r² = RSQ(LN(Data_Y);LN(Data_X)) "
msgstr "r² = RSQ(LN(Data_Y);LN(Data_X)) "

#: 04050100.xhp#hd_id9204077.help.text
#: 04050100.xhp%23hd_id9204077.help.text
msgid "Constraints"
msgstr "Սահմանափակումներ"

#: 04050100.xhp#par_id7393719.help.text
#: 04050100.xhp%23par_id7393719.help.text
msgid ""
" The calculation of the trend line considers only data pairs with the "
"following values:"
msgstr ""
" Թրենդային գծի հաշվարկը հաշվի է առնում միայն տվյալների զույգերը՝ հետևյալ "
"արժեքներով."

#: 04050100.xhp#par_id7212744.help.text
#: 04050100.xhp%23par_id7212744.help.text
msgid "logarithm regression: only positive x-values are considered,"
msgstr "լոգարիթմի հետընթաց. հաշվի են առնվում միայն դրական x- արժեքները,"

#: 04050100.xhp#par_id1664479.help.text
#: 04050100.xhp%23par_id1664479.help.text
msgid "exponential regression: only positive y-values are considered,"
msgstr "էքսպոնենտալ ռեգրեսիա. հաշվի են առնվում միայն դրական y- արժեքները,"

#: 04050100.xhp#par_id8734702.help.text
#: 04050100.xhp%23par_id8734702.help.text
msgid ""
"power regression: only positive x-values and positive y-values are "
"considered."
msgstr ""
"աստիճանային ռեգրեսիա. հաշվի են առնվում միայն դրական x- արժեքները և դրական y- "
"արժեքները:"

#: 04050100.xhp#par_id181279.help.text
#: 04050100.xhp%23par_id181279.help.text
msgid ""
"You should transform your data accordingly; it is best to work on a copy of "
"the original data and transform the copied data."
msgstr ""
"Պետք է համապատասխանաբար վերափոխեք ձեր տվյալները. ավելի լավ է աշխատել "
"բնօրինակ տվյալների պատճենի վրա և փոխակերպել պատճենահանված տվյալները:"

#: 04050100.xhp#hd_id7907040.help.text
#: 04050100.xhp%23hd_id7907040.help.text
msgid "The polynomial regression equation"
msgstr "Պոլինորմալ ռեգրեսիոն հավասարում"

#: 04050100.xhp#par_id8918729.help.text
#: 04050100.xhp%23par_id8918729.help.text
msgid ""
"A <emph>polynomial regression</emph> curve cannot be added automatically. "
"You must calculate this curve manually. "
msgstr ""
"<emph>Պոլինորմալ ռեգրեսիայի</emph> կորը չի կարող ավտոմատ ավելացվել։ Պետք է "
"ձեռքով հաշվարկեք այս կորը: "

#: 04050100.xhp#par_id33875.help.text
#: 04050100.xhp%23par_id33875.help.text
msgid ""
"Create a table with the columns x, x², x³, … , xⁿ, y up to the desired "
"degree n. "
msgstr ""
"ստեղծեք աղյուսակ սյունակներով x, x², x³, … , xⁿ, y մինճչև ցանկալի n աստիճանը։"
" "

#: 04050100.xhp#par_id8720053.help.text
#: 04050100.xhp%23par_id8720053.help.text
msgid ""
"Use the formula <item type=\"literal\">=LINEST(Data_Y,Data_X)</item> with "
"the complete range x to xⁿ (without headings) as Data_X. "
msgstr ""
"Օգտագործեք բանաձևը <item type=\"literal\">=LINEST(Data_Y,Data_X)</item> x -ի "
"x -ի ամբողջական միջակայքով (առանց վերնագրերի) որպես Data_X:"

#: 04050100.xhp#par_id5068514.help.text
#: 04050100.xhp%23par_id5068514.help.text
msgid ""
"The first row of the LINEST output contains the coefficients of the "
"regression polynomial, with the coefficient of xⁿ at the leftmost position."
msgstr ""
"LINEST- ի ելքի առաջին տողը պարունակում է ռեգրեսիոն պոլինոմիալ գործակիցը, որի "
"ամենաձախ դիրքում xⁿ գործակիցն է:"

#: 04050100.xhp#par_id8202154.help.text
#: 04050100.xhp%23par_id8202154.help.text
msgid ""
"The first element of the third row of the LINEST output is the value of r². "
"See the <link href=\"text/scalc/01/04060107.xhp#Section8\">LINEST</link> "
"function for details on proper use and an explanation of the other output "
"parameters."
msgstr ""
"LINEST ելքի երրորդ տողի առաջին տարրը r² -ի արժեքն է: Տես <link href=\""
"text/scalc/01/04060107.xhp#Section8\">LINEST</link> գործառույթը պատշաճ "
"օգտագործման վերաբերյալ մանրամասների և ելքային մյուս պարամետրերի բացատրության "
"համար:"

#: 04050100.xhp#par_id4562211.help.text
#: 04050100.xhp%23par_id4562211.help.text
msgid "<link href=\"text/schart/01/04050000.xhp\">Y Error Bars tab page</link>"
msgstr ""
"<link href=\"text/schart/01/04050000.xhp\">Y սխալի ձողերի ներդիրների "
"էջ</link>"

#: type_area.xhp#tit.help.text
#: type_area.xhp%23tit.help.text
msgid "Chart Type Area"
msgstr "Գծապատկերի տեսակի տիրույթ"

#: type_area.xhp#bm_id4130680.help.text
#: type_area.xhp%23bm_id4130680.help.text
msgid ""
"<bookmark_value>area charts</bookmark_value><bookmark_value>chart "
"types;area</bookmark_value>"
msgstr ""
"<bookmark_value>area charts</bookmark_value><bookmark_value>chart "
"types;area</bookmark_value>"

#: type_area.xhp#hd_id310678.help.text
#: type_area.xhp%23hd_id310678.help.text
msgid ""
"<variable id=\"type_area\"><link href=\"text/schart/01/type_area.xhp\">Chart "
"Type Area</link></variable>"
msgstr ""
"<variable id=\"type_area\"><link href=\"text/schart/01/type_area.xhp\">"
"Գծապատկերի տեսակի տիրույթ</link></variable>"

#: type_area.xhp#par_id916776.help.text
#: type_area.xhp%23par_id916776.help.text
msgctxt "type_area.xhp#par_id916776.help.text"
msgid ""
"On the first page of the <link href=\"text/schart/01/wiz_chart_type.xhp\">"
"Chart Wizard</link> you can choose a chart type. "
msgstr ""
"<link href=\"text/schart/01/wiz_chart_type.xhp\">Գծապատկերի հրաշագործի</link>"
" առաջին էջում կարող եք ընտրել գծապատկերի տեսակը։"

#: type_area.xhp#hd_id961943.help.text
#: type_area.xhp%23hd_id961943.help.text
msgid "Area"
msgstr "Տիրույթ"

#: type_area.xhp#par_id631733.help.text
#: type_area.xhp%23par_id631733.help.text
msgid ""
"An area chart shows values as points on the y axis. The x axis shows "
"categories. The y values of each data series are connected by a line. The "
"area between each two lines is filled with a color. The area chart's focus "
"is to emphasize the changes from one category to the next."
msgstr ""
"Տարածքի գծապատկերում ցույց են տրված արժեքները որպես y առանցքի կետեր: X "
"առանցքը ցույց է տալիս դասերը: Տվյալների յուրաքանչյուր շարքի y արժեքները "
"կապված են տողի հետ: Յուրաքանչյուր երկու տողի միջև ընկած տարածքը գունավորված "
"է: Գծապատկերի տիրույթը կիզակետում է մեկ դասից մյուսը փոփոխությունները "
"շեշտադրելը:"

#: type_area.xhp#par_id7811822.help.text
#: type_area.xhp%23par_id7811822.help.text
msgid ""
"Normal - this subtype plots all values as absolute y values. It first plots "
"the area of the last column in the data range, then the next to last, and so "
"on, and finally the first column of data is drawn. Thus, if the values in "
"the first column are higher than other values, the last drawn area will hide "
"the other areas."
msgstr ""
"Նորմալ - այս ենթատեսակը նկարագրում է բոլոր արժեքները որպես բացարձակ y "
"արժեքներ: Այն նախ գծագրում է վերջին սյունակի տարածքը տվյալների տիրույթում, "
"հետո հաջորդը վերջինը և այլն, և վերջապես գծվում է տվյալների առաջին սյունակը: "
"Այսպիսով, եթե առաջին սյունակում նշված արժեքները ավելի բարձր են, քան մյուս "
"արժեքները, վերջին գծագրված տարածքը կթաքցնի մյուս տարածքները:"

#: type_area.xhp#par_id3640247.help.text
#: type_area.xhp%23par_id3640247.help.text
msgid ""
"Stacked - this subtypes plots values cumulatively stacked on each other. It "
"ensures that all values are visible, and no data set is hidden by others. "
"However, the y values no longer represent absolute values, except for the "
"last column which is drawn at the bottom of the stacked areas."
msgstr ""
"Կուտակումով - այս ենթատեսակները գծում է արժեքները, որոնք կուտակվում են իրար "
"վրա: Այն ապահովում է, որ բոլոր արժեքները տեսանելի լինեն, և տվյալների ոչ մի "
"շարք չի թաքնված ուրիշների կողմից: Այնուամենայնիվ, y- ի արժեքներն այլևս չեն "
"ներկայացնում բացարձակ արժեքներ, բացառությամբ վերջին սյունակի, որը գծված է "
"հավաքված տարածքների ներքևի մասում:"

#: type_area.xhp#par_id4585100.help.text
#: type_area.xhp%23par_id4585100.help.text
msgid ""
"Percent - this subtype plots values cumulatively stacked on each other and "
"scaled as percentage of the category total."
msgstr ""
"Տոկոս - այս ենթատեսակի սյուժեների արժեքները կուտակված կերպով դրված են "
"միմյանց վրա և մասշտաբվորվում են որպես դասի ընդհանուրի տոկոս:"

#: 04060000.xhp#tit.help.text
#: 04060000.xhp%23tit.help.text
msgid "Options"
msgstr "Ընտրանքներ"

#: 04060000.xhp#bm_id3149400.help.text
#: 04060000.xhp%23bm_id3149400.help.text
msgid ""
"<bookmark_value>aligning; 2D charts</bookmark_value>         "
"<bookmark_value>charts; aligning</bookmark_value>         <bookmark_value>"
"pie charts;options</bookmark_value>"
msgstr ""
"<bookmark_value>aligning; 2D charts</bookmark_value>         "
"<bookmark_value>charts; aligning</bookmark_value>         <bookmark_value>"
"pie charts;options</bookmark_value>"

#: 04060000.xhp#hd_id3149400.1.help.text
#: 04060000.xhp%23hd_id3149400.1.help.text
msgid ""
"<link href=\"text/schart/01/04060000.xhp\" name=\"Options\">Options</link>"
msgstr ""
"<link href=\"text/schart/01/04060000.xhp\" name=\"Ընտրանքներ\""
">Ընտրանքներ</link>"

#: 04060000.xhp#par_id3155067.2.help.text
#: 04060000.xhp%23par_id3155067.2.help.text
msgid ""
"Use this dialog to define some options that are available for specific chart "
"types. The contents of the Options dialog vary with the chart type."
msgstr ""
"Օգտագործեք այս երկխոսությունը սահմանելու որոշ ընտրանքներ, որոնք մատչելի են "
"գծապատկերների հատուկ տեսակների համար: Ընտրանքների երկխոսության "
"բովանդակությունը տարբերվում է գծապատկերի տեսակից:"

#: 04060000.xhp#hd_id3150043.9.help.text
#: 04060000.xhp%23hd_id3150043.9.help.text
msgid "Align data series to:"
msgstr "Տվյալների շարքը հավասարեցնել հետևյալին"

#: 04060000.xhp#par_id3145228.10.help.text
#: 04060000.xhp%23par_id3145228.10.help.text
msgid ""
"In this area you can choose between two Y axis scaling modes. The axes can "
"only be scaled and given properties separately."
msgstr ""
"Այս տիրույթում կարող եք ընտրել Y առանցքի մասշտաբի երկու ռեժիմների միջև: "
"Առանցքները կարող են միայն մասշտաբավորվել և տրվեն առանձին հատկություններին:"

#: 04060000.xhp#hd_id3147346.4.help.text
#: 04060000.xhp%23hd_id3147346.4.help.text
msgid "Primary Y axis"
msgstr "Սկզբնական Y առանցք"

#: 04060000.xhp#par_id3147005.15.help.text
#: 04060000.xhp%23par_id3147005.15.help.text
msgid ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_OPTIONS:RBT_OPT_AXIS_1\">This option is "
"active as default. All data series are aligned to the primary Y axis.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_OPTIONS:RBT_OPT_AXIS_1\">Այս տարբերակը ակտիվ "
"է որպես լռելյայն: Բոլոր տվյալների շարքը համահունչ է առաջնային Y "
"առանցքին:</ahelp>"

#: 04060000.xhp#hd_id3143221.5.help.text
#: 04060000.xhp%23hd_id3143221.5.help.text
msgid "Secondary Y axis"
msgstr "Երկրորդական Y առանցք"

#: 04060000.xhp#par_id3154656.11.help.text
#: 04060000.xhp%23par_id3154656.11.help.text
msgid ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_OPTIONS:RBT_OPT_AXIS_2\">Changes the scaling "
"of the Y axis. This axis is only visible when at least one data series is "
"assigned to it and the axis view is active.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_OPTIONS:RBT_OPT_AXIS_2\">Փոխում է Y առանցքի "
"մասշտաբը: Այս առանցքը տեսանելի է միայն այն դեպքում, երբ դրան առնվազն "
"տվյալների մեկ շարք է նշանակված, իսկ առանցքի տեսքը`ակտիվ է:</ahelp>"

#: 04060000.xhp#hd_id3166423.6.help.text
#: 04060000.xhp%23hd_id3166423.6.help.text
msgid "Settings"
msgstr "Կարգավորումներ"

#: 04060000.xhp#par_id3150365.12.help.text
#: 04060000.xhp%23par_id3150365.12.help.text
msgid ""
"Define the settings for a bar chart in this area. Any changes apply to all "
"data series of the chart, not to the selected data only."
msgstr ""
"Սահմանեք այս տիրույթի ձողի գծապատկերների պարամետրերը: Ցանկացած փոփոխություն "
"տարածվում է գծապատկերի տվյալների բոլոր շարքերի վրա, այլ ոչ միայն ընտրված "
"տվյալների վրա:"

#: 04060000.xhp#hd_id3145584.7.help.text
#: 04060000.xhp%23hd_id3145584.7.help.text
msgid "Spacing"
msgstr "Տարածություն"

#: 04060000.xhp#par_id3155376.13.help.text
#: 04060000.xhp%23par_id3155376.13.help.text
msgid ""
"<ahelp hid=\"SCH:METRICFIELD:TP_OPTIONS:MT_GAP\">Defines the spacing between "
"the columns in percent.</ahelp> The maximal spacing is 600%."
msgstr ""
"<ahelp hid=\"SCH:METRICFIELD:TP_OPTIONS:MT_GAP\">Սյունակների միջև ընկած "
"հատվածը սահմանում է տոկոսով:</ahelp> Առավելագույն հեռավորությունը 600% է:"

#: 04060000.xhp#hd_id3145384.8.help.text
#: 04060000.xhp%23hd_id3145384.8.help.text
msgctxt "04060000.xhp#hd_id3145384.8.help.text"
msgid "Overlap"
msgstr "Համընկնում"

#: 04060000.xhp#par_id3156447.14.help.text
#: 04060000.xhp%23par_id3156447.14.help.text
msgid ""
"<ahelp hid=\"SCH:METRICFIELD:TP_OPTIONS:MT_OVERLAP\">Defines the necessary "
"settings for overlapping data series.</ahelp> You can choose between -100 "
"and +100%."
msgstr ""
"<ahelp hid=\"SCH:METRICFIELD:TP_OPTIONS:MT_OVERLAP\">Սահմանում է տվյալների "
"շարքի համընկնման համար անհրաժեշտ պարամետրերը:</ahelp> Դուք կարող եք ընտրել "
"-100-ի և +100% -ի սահմաններում:"

#: 04060000.xhp#hd_id3153305.16.help.text
#: 04060000.xhp%23hd_id3153305.16.help.text
msgid "Connection Lines"
msgstr "Միացնող գծեր"

#: 04060000.xhp#par_id3148868.17.help.text
#: 04060000.xhp%23par_id3148868.17.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:TP_OPTIONS:CB_CONNECTOR\">For \"stacked\" and \""
"percent\" column (vertical bar) charts, mark this check box to connect the "
"column layers that belong together with lines.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:TP_OPTIONS:CB_CONNECTOR\">«Կուտակումով» և «տոկոս» "
"սյունակի (ուղղահայաց ձող) գծապատկերների համար նշեք այս վանդակը` սյուների "
"շերտերը միացնելու համար, որոնք միասին պատկանում են տողերին:</ahelp>"

#: 04060000.xhp#hd_id9842219.help.text
#: 04060000.xhp%23hd_id9842219.help.text
msgid "Show bars side by side"
msgstr "Ցույց տուր ձողերը կողք կողքի"

#: 04060000.xhp#par_id9800103.help.text
#: 04060000.xhp%23par_id9800103.help.text
msgid ""
"If two axes are shown in a bar chart, and some data series are attached to "
"the first axis, while some other data series are attached to the second "
"axis, then both sets of data series are shown independently, overlapping "
"each other."
msgstr ""
"Եթե երկու առանցքները ցույց են տրված գծապատկերում, և տվյալների որոշ շարքեր "
"կցվում են առաջին առանցքին, իսկ տվյալների մյուս շարքը կցվում է երկրորդ "
"առանցքին, ապա տվյալների շարքի երկու խմբաքանակները ցուցադրվում են ինքնուրույն՝"
" իրարհետ համընկնելով:"

#: 04060000.xhp#par_id2144535.help.text
#: 04060000.xhp%23par_id2144535.help.text
msgid ""
"As a result, bars attached to the first y-axis are partly or completely "
"hidden by bars attached to the second y-axis. To avoid this, enable the "
"option to display bars side by side. <ahelp hid=\".\">The bars from "
"different data series are shown as if they were attached only to one "
"axis.</ahelp>"
msgstr ""
"Արդյունքում, առաջին y- առանցքին կցված ձողերը մասամբ կամ ամբողջովին թաքնված "
"են երկրորդ y- առանցքին կցված ձողերից: Դրանից խուսափելու համար միացրեք այն "
"տարբերակը, որը կողք կողքի ցուցադրում է ձողերը: <ahelp hid=\".\"> տարբեր "
"տվյալների շարքի սանդղակները ցույց են տրված, կարծես դրանք կցված են միայն մեկ "
"առանցքի վրա:</ahelp>"

#: 04060000.xhp#hd_id24414.help.text
#: 04060000.xhp%23hd_id24414.help.text
msgid "Clockwise direction"
msgstr "Ժամ սլաքի ուղղությամբ"

#: 04060000.xhp#par_id2527237.help.text
#: 04060000.xhp%23par_id2527237.help.text
msgid ""
"Available for pie and donut charts. <ahelp hid=\".\">The default direction "
"in which the pieces of a pie chart are ordered is counterclockwise. Enable "
"the <emph>Clockwise direction</emph> checkbox to draw the pieces in opposite "
"direction.</ahelp>"
msgstr ""
"Առկա է կարկանդակի և բլիթի գծապատկերների համար: <ahelp hid=\".\">Լռելյայն "
"ուղղությունը, որի ընթացքում պատվիրվում են կարկանդակի աղյուսակի կտորները, "
"հակառակ ուղղությամբ է: Ընտրեքք <emph>ժամացույցի սլաքի ուղղությամբ</emph> "
"վանդակը` կտորները հակառակ ուղղությամբ գծելու համար:</ahelp>"

#: 04060000.xhp#hd_id401013.help.text
#: 04060000.xhp%23hd_id401013.help.text
msgid "Starting angle"
msgstr "Սկզբնական անկյուն"

#: 04060000.xhp#par_id761131.help.text
#: 04060000.xhp%23par_id761131.help.text
msgid ""
"<ahelp hid=\".\">Drag the small dot along the circle or click any position "
"on the circle to set the starting angle of a pie or donut chart. The "
"starting angle is the mathematical angle position where the first piece is "
"drawn. The value of 90 degrees draws the first piece at the 12 o'clock "
"position. A value of 0 degrees starts at the 3 o'clock position.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Քաշեք փոքր կետը շրջագծի երկայնքով կամ շրջանակում կտտացրեք "
"ցանկացած դիրքի վրա` կարկանդակ կամ բլիթների գծապատկերների մեկնարկի անկյունը "
"սահմանելու համար: Մեկնարկային անկյունը մաթեմատիկական անկյունի դիրքն է, որտեղ "
"գծագրվում է առաջին կտորը: 90 աստիճանի արժեքը առաջին կտորը նկարում է ժամը 12-"
"ի դիրքում: 0 աստիճանի արժեքը սկսվում է ժամը 3-ից:</ahelp>"

#: 04060000.xhp#par_id553910.help.text
#: 04060000.xhp%23par_id553910.help.text
msgid ""
"In 3D pie and donut charts that were created with older versions of the "
"software, the starting angle is 0 degrees instead of 90 degrees. For old and "
"new 2D charts the default starting angle is 90 degrees."
msgstr ""
"3D կարկանդակ և բլիթային գծապատկերներում, որոնք ստեղծվել են ծրագրակազմի ավելի "
"հին տարբերակներով, մեկնարկային անկյունը կազմում է 0 աստիճան` 90 աստիճանի "
"փոխարեն: Հին և նոր 2D գծապատկերների համար նախնական ելակետը 90 աստիճան է:"

#: 04060000.xhp#par_id1414838.help.text
#: 04060000.xhp%23par_id1414838.help.text
msgid ""
"When you change the starting angle or the direction, only current versions "
"of the software show the changed values. Older versions of the software "
"display the same document using the default values: Always counterclockwise "
"direction and a starting value of 90 degrees (2D pie charts) or 0 degrees ("
"3D pie charts)."
msgstr ""
"Երբ փոխում եք մեկնարկային անկյունը կամ ուղղությունը, միայն ծրագրաշարի "
"ընթացիկ տարբերակները են ցույց տալիս փոփոխված արժեքները: Ծրագրաշարի հին "
"տարբերակները ցուցադրում են նույն փաստաթուղթը` օգտագործելով լռելյայն "
"արժեքները. Միշտ հակառակ սլաքի ուղղությամբ և 90 աստիճանի (2D կարկանդակ "
"գծապատկերներ) կամ 0 աստիճանի (3D կարկանդակ գծապատկերներ) սկզբնական արժեքը:"

#: 04060000.xhp#hd_id3179723.help.text
#: 04060000.xhp%23hd_id3179723.help.text
msgctxt "04060000.xhp#hd_id3179723.help.text"
msgid "Degrees"
msgstr "Աստիճաններ"

#: 04060000.xhp#par_id2164067.help.text
#: 04060000.xhp%23par_id2164067.help.text
msgid ""
"<ahelp hid=\".\">Enter the starting angle between 0 and 359 degrees. You can "
"also click the arrows to change the displayed value.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Մուտքագրեք մեկնարկային անկյունը 0-ից 359 աստիճանի միջև: "
"Կարող եք նաև սեղմել սլաքները՝  ցուցադրված արժեքը փոխելու համար.</ahelp>"

#: 04060000.xhp#hd_id0305200910524613.help.text
#: 04060000.xhp%23hd_id0305200910524613.help.text
msgid "Plot missing values"
msgstr "Կառուցել բացակայող արժեքները"

#: 04060000.xhp#par_id0305200910524650.help.text
#: 04060000.xhp%23par_id0305200910524650.help.text
msgid ""
"Sometimes values are missing in a data series that is shown in a chart. You "
"can select from different options how to plot the missing values. The "
"options are available for some chart types only."
msgstr ""
"Արժեքները երբեմն բացակայում են տվյալների շարքում, որը ցույց է տրված "
"աղյուսակում: Կարող եք տարբեր ընտրանքներից ընտրել, թե ինչպես գծագրել "
"բացակայող արժեքները: Ընտրանքները մատչելի են միայն որոշ գծապատկերների համար:"

#: 04060000.xhp#hd_id0305200910524823.help.text
#: 04060000.xhp%23hd_id0305200910524823.help.text
msgid "Leave gap"
msgstr "Թողնել բացատ"

#: 04060000.xhp#par_id0305200910524811.help.text
#: 04060000.xhp%23par_id0305200910524811.help.text
msgid ""
"<ahelp hid=\".\">For a missing value, no data will be shown. This is the "
"default for chart types Column, Bar, Line, Net.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացակայող արժեքի համար ոչ մի տվյալ չի ցուցադրվի: Սա լռակյաց "
"է աղյուսակի տեսակների համար Column, Bar, Line, Net:</ahelp>"

#: 04060000.xhp#hd_id0305200910524811.help.text
#: 04060000.xhp%23hd_id0305200910524811.help.text
msgid "Assume zero"
msgstr "Ընդունեք զրո"

#: 04060000.xhp#par_id030520091052489.help.text
#: 04060000.xhp%23par_id030520091052489.help.text
msgid ""
"<ahelp hid=\".\">For a missing value, the y-value will be shown as zero. "
"This is the default for chart type Area.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացակայող արժեքի դեպքում y- ի արժեքը ցույց կտա որպես զրո: "
"Սա լռակյաց է գծապատկերի տիպի համար:</ahelp>"

#: 04060000.xhp#hd_id0305200910524837.help.text
#: 04060000.xhp%23hd_id0305200910524837.help.text
msgid "Continue line"
msgstr "Շարունակել գիծը"

#: 04060000.xhp#par_id0305200910524938.help.text
#: 04060000.xhp%23par_id0305200910524938.help.text
msgid ""
"<ahelp hid=\".\">For a missing value, the interpolation from the neighbor "
"values will be shown. This is the default for chart type XY.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացակայող արժեքի համար կցուցադրվի հարևան արժեքների "
"միջնորդությունը: Սա կանխադրված է գծապատկերային XY տեսակի համար:</ahelp>"

#: 04060000.xhp#hd_id0305200910524937.help.text
#: 04060000.xhp%23hd_id0305200910524937.help.text
msgid "Include values from hidden cells"
msgstr "Ներառեք արժեքները թաքնված բջիջներից"

#: 04060000.xhp#par_id030520091052494.help.text
#: 04060000.xhp%23par_id030520091052494.help.text
msgid ""
"<ahelp hid=\".\">Check to also show values of currently hidden cells within "
"the source cell range.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք՝ նաև ներկայումս թաքնված բջիջների արժեքները ցույց "
"տալու համար աղբյուրի բջջային միջակայքում:</ahelp>"

#: type_column_line.xhp#tit.help.text
#: type_column_line.xhp%23tit.help.text
msgid "Chart Type Column and Line "
msgstr "Գծապատկերի տեսակի սյունակ և տող "

#: type_column_line.xhp#bm_id5976744.help.text
#: type_column_line.xhp%23bm_id5976744.help.text
msgid ""
"<bookmark_value>column and line charts</bookmark_value><bookmark_value>chart "
"types;column and line</bookmark_value><bookmark_value>combination "
"charts</bookmark_value>"
msgstr ""
"<bookmark_value>column and line charts</bookmark_value><bookmark_value>chart "
"types;column and line</bookmark_value><bookmark_value>combination "
"charts</bookmark_value>"

#: type_column_line.xhp#hd_id8596453.help.text
#: type_column_line.xhp%23hd_id8596453.help.text
msgid ""
"<variable id=\"type_column_line\"><link href=\""
"text/schart/01/type_column_line.xhp\">Chart Type Column and "
"Line</link></variable>"
msgstr ""
"<variable id=\"type_column_line\"><link href=\""
"text/schart/01/type_column_line.xhp\">Գծապատկերի տեսակի սյունակ և "
"տող</link></variable>"

#: type_column_line.xhp#par_id4818567.help.text
#: type_column_line.xhp%23par_id4818567.help.text
msgctxt "type_column_line.xhp#par_id4818567.help.text"
msgid ""
"On the first page of the <link href=\"text/schart/01/wiz_chart_type.xhp\">"
"Chart Wizard</link> you can choose a chart type. "
msgstr ""
"<link href=\"text/schart/01/wiz_chart_type.xhp\">Գծապատկերի հրաշագործի</link>"
" առաջին էջում կարող եք ընտրել գծապատկերի տեսակը։ "

#: type_column_line.xhp#hd_id2451551.help.text
#: type_column_line.xhp%23hd_id2451551.help.text
msgid "Column and Line"
msgstr "Սյունակ և տող"

#: type_column_line.xhp#par_id3101901.help.text
#: type_column_line.xhp%23par_id3101901.help.text
msgid ""
"A Column and Line chart is a combination of a <link href=\""
"text/schart/01/type_column_bar.xhp\">Column chart</link> with a <link href=\""
"text/schart/01/type_line.xhp\">Line chart</link>."
msgstr ""
"Սյունակ և Տող գծապատկերը <link href=\"text/schart/01/type_column_bar.xhp\">"
"Սյունակի գծապատկերի</link> համադրումն է <link href=\""
"text/schart/01/type_line.xhp\">Տողի գծապատկերի</link> հետ։"

#: type_column_line.xhp#par_id7910397.help.text
#: type_column_line.xhp%23par_id7910397.help.text
msgid "Select one of the variants"
msgstr "Ընտրեք տարբերակներից մեկը"

#: type_column_line.xhp#par_id5244300.help.text
#: type_column_line.xhp%23par_id5244300.help.text
msgid ""
"Columns and Lines. The rectangles of the column data series are drawn side "
"by side so that you can easily compare their values."
msgstr ""
"Սյուներ և Տողեր: Սյունակի տվյալների շարքի ուղղանկյունները գծվում են կողք "
"կողքի, որպեսզի հեշտությամբ կարողանաք համեմատել դրանց արժեքները:"

#: type_column_line.xhp#par_id7163609.help.text
#: type_column_line.xhp%23par_id7163609.help.text
msgid ""
"Stacked Columns and Lines. The rectangles of the column data series are "
"drawn stacked above each other, so that the height of a column visualizes "
"the sum of the data values."
msgstr ""
"Կուտակումով սյուներ և գծեր: Սյունակի տվյալների շարքի ուղղանկյունները գծված "
"են միմյանց վերևից, այնպես որ սյունակի բարձրությունը տվյալների արժեքների "
"գումարի մասին պատկերացնում է տալիս:"

#: type_column_line.xhp#par_id1842097.help.text
#: type_column_line.xhp%23par_id1842097.help.text
msgid ""
"You can insert a second y-axis with <link href=\"text/schart/01/04040000."
"xhp\">Insert - Axes</link> after you finish the wizard."
msgstr ""
"Կարող եք ներդնել երկրորդ y-առանցքը <link href=\"text/schart/01/04040000.xhp\""
">Տեղադրեքt - Առանցքներ</link> -ով, երբ կավարտեք հրաշագործը։"

#: type_column_line.xhp#hd_id8297677.help.text
#: type_column_line.xhp%23hd_id8297677.help.text
msgctxt "type_column_line.xhp#hd_id8297677.help.text"
msgid "To specify a data range"
msgstr "Տվյալների միջակայքը հատկորոշելու համար"

#: type_column_line.xhp#par_id8871120.help.text
#: type_column_line.xhp%23par_id8871120.help.text
msgid ""
"The leftmost columns (or the top rows) of the selected data range provide "
"the data that are shown as Columns objects. The other columns or rows of the "
"data range provide the data for the Lines objects. You can change this "
"assignment in the <emph>Data Series</emph> dialog."
msgstr ""
"Ընտրված տվյալների տիրույթի ամենաձախ սյուները (կամ վերին տողերը) տրամադրում "
"են այն տվյալները, որոնք ցուցադրվում են որպես Սյունակների օբյեկտներ: "
"Տվյալների միջակայքի մյուս սյուները կամ շարքերը տրամադրում են տվյալները "
"տողերի օբյեկտների համար: Կարող եք փոխել այս հանձնարարությունը <emph>"
"Տվյալների շարքեր</emph> երկխոսության մեջ:"

#: type_column_line.xhp#par_id2952055.help.text
#: type_column_line.xhp%23par_id2952055.help.text
msgid "Select the data range."
msgstr "Ընտրեք տվյալների միջակայքը։"

#: type_column_line.xhp#par_id594500.help.text
#: type_column_line.xhp%23par_id594500.help.text
msgctxt "type_column_line.xhp#par_id594500.help.text"
msgid "Click one of the options for data series in rows or in columns."
msgstr ""
"Շարքերում կամ սյունակներում կտտացրեք տվյալների շարքի տարբերակներից մեկը:"

#: type_column_line.xhp#par_id1944944.help.text
#: type_column_line.xhp%23par_id1944944.help.text
msgctxt "type_column_line.xhp#par_id1944944.help.text"
msgid ""
"Check whether the data range has labels in the first row or in the first "
"column or both."
msgstr ""
"Ստուգեք, թե արդյոք տվյալների շարքն ունի պիտակներ առաջին շարքում կամ առաջին "
"սյունակում, կամ երկուսն էլ:"

#: type_column_line.xhp#hd_id6667683.help.text
#: type_column_line.xhp%23hd_id6667683.help.text
msgctxt "type_column_line.xhp#hd_id6667683.help.text"
msgid "Organizing data series"
msgstr "Կազմակերպեք տվյալների շարքեր"

#: type_column_line.xhp#par_id7616809.help.text
#: type_column_line.xhp%23par_id7616809.help.text
msgctxt "type_column_line.xhp#par_id7616809.help.text"
msgid ""
"In the Data Series list box you see a list of all data series in the current "
"chart."
msgstr ""
"Տվյալների շարքի ցուցակի վանդակում տեսնում եք ընթացիկ գծապատկերում տվյալների "
"բոլոր շարքերի ցուցակը:"

#: type_column_line.xhp#par_id9770195.help.text
#: type_column_line.xhp%23par_id9770195.help.text
msgid ""
"The column data series are positioned at the top of the list, the line data "
"series at the bottom of the list."
msgstr ""
"Սյունակի տվյալների շարքը տեղադրված է ցուցակի վերին մասում, տողի տվյալների "
"շարքը`ցուցակի ներքևում:"

#: type_column_line.xhp#par_id1446272.help.text
#: type_column_line.xhp%23par_id1446272.help.text
msgctxt "type_column_line.xhp#par_id1446272.help.text"
msgid "To organize the data series, select an entry in the list."
msgstr "Տվյալների շարքը կազմակերպելու համար ցուցակից ընտրեք մուտքը:"

#: type_column_line.xhp#par_id3779717.help.text
#: type_column_line.xhp%23par_id3779717.help.text
msgctxt "type_column_line.xhp#par_id3779717.help.text"
msgid ""
"Click Add to add another data series below the selected entry. The new data "
"series has the same type as the selected entry."
msgstr ""
"Կտտացրեք Ավելացնել՝ ընտրված մուտքի ներքևում տվյալների այլ շարքեր ավելացնելու "
"համար: Տվյալների նոր շարքը ընտրված մուտքի նույն տեսակն ունի:"

#: type_column_line.xhp#par_id5056611.help.text
#: type_column_line.xhp%23par_id5056611.help.text
msgctxt "type_column_line.xhp#par_id5056611.help.text"
msgid "Click Remove to remove the selected entry from the Data Series list."
msgstr ""
"Կտտացրեք Հեռացնել՝ ընտրված մուտքը Տվյալների շարքի ցուցակից հանելու համար:"

#: type_column_line.xhp#par_id7786492.help.text
#: type_column_line.xhp%23par_id7786492.help.text
msgid ""
"Use the Up and Down arrow buttons to move the selected entry in the list up "
"or down. This way you can convert a Column data series to a List data series "
"and back. This does not change the order in the data source table, but "
"changes only the arrangement in the chart."
msgstr ""
"Ընտրված մուտքը ցուցակում վեր կամ վար շարժելու համար, օգտագործեք Վեր կմ Վար "
"սլաքների կոճակները: Այս կերպ կարող եք Սյունակի տվյալների շարքը վերափոխել "
"Ցուցակի տվյալների շարքի և հակառակը: Սա չի փոխում տվյալների աղբյուրի "
"աղյուսակում կարգը, բայց փոխում է միայն աղյուսակում դասավորվածությունը:"

#: type_column_line.xhp#hd_id265816.help.text
#: type_column_line.xhp%23hd_id265816.help.text
msgctxt "type_column_line.xhp#hd_id265816.help.text"
msgid "Editing data series"
msgstr "Տվյալների շարքերի խմբագրում"

#: type_column_line.xhp#par_id6768700.help.text
#: type_column_line.xhp%23par_id6768700.help.text
msgctxt "type_column_line.xhp#par_id6768700.help.text"
msgid ""
"Click an entry in the list to view and edit the properties for that entry."
msgstr ""
"Կտտացրեք մուտքը ցուցակի մեջ՝ այդ մուտքի հատկությունները դիտելու և խմբագրելու "
"համար:"

#: type_column_line.xhp#par_id1924497.help.text
#: type_column_line.xhp%23par_id1924497.help.text
msgctxt "type_column_line.xhp#par_id1924497.help.text"
msgid ""
"In the Data Ranges list box you see the role names and cell ranges of the "
"data series components. "
msgstr ""
"Տվյալների միջակայքի ցուցակի վանդակում տեսնում եք տվյալների շարքի "
"բաղադրիչների դերերի անուններն ու բջջային միջակայքերը: "

#: type_column_line.xhp#par_id5081942.help.text
#: type_column_line.xhp%23par_id5081942.help.text
msgctxt "type_column_line.xhp#par_id5081942.help.text"
msgid "Click an entry, then edit the contents in the text box below. "
msgstr ""
"Կտտացրեք մուտքը, ապա խմբագրեք բովանդակությունը ներքևում գտնվող տեքստի "
"վանդակում:"

#: type_column_line.xhp#par_id2958464.help.text
#: type_column_line.xhp%23par_id2958464.help.text
msgctxt "type_column_line.xhp#par_id2958464.help.text"
msgid "The label next to the text box states the currently selected role. "
msgstr "Տեքստի տուփի կողքի պիտակը նշում է ներկայումս ընտրված դերը։ "

#: type_column_line.xhp#par_id883816.help.text
#: type_column_line.xhp%23par_id883816.help.text
msgctxt "type_column_line.xhp#par_id883816.help.text"
msgid ""
"Enter the range or click <emph>Select data range</emph> to minimize the "
"dialog and select the range with the mouse."
msgstr ""
"Մուտքագրեք միջակայքը կամ կտտացրեք <emph>Ընտրեք տվյալների միջակայքը</emph>, "
"երկխոսությունը նվազագույնի հասցնելու և մկնիկով միջակայքը ընտրելու համար:"

#: type_column_line.xhp#par_id5091708.help.text
#: type_column_line.xhp%23par_id5091708.help.text
msgctxt "type_column_line.xhp#par_id5091708.help.text"
msgid ""
"The range for a data role, like Y-Values, must not include a label cell."
msgstr ""
"Տվյալների դերի սահմանը, ինչպես Y- արժեքները, չպետք է պարունակի պիտակի բջիջ:"

#: type_column_line.xhp#hd_id974456.help.text
#: type_column_line.xhp%23hd_id974456.help.text
msgctxt "type_column_line.xhp#hd_id974456.help.text"
msgid "Editing categories or data labels"
msgstr "Դասերի կամ տվյալների պիտակների խմբագրում"

#: type_column_line.xhp#par_id2767113.help.text
#: type_column_line.xhp%23par_id2767113.help.text
msgctxt "type_column_line.xhp#par_id2767113.help.text"
msgid ""
"Enter or select a cell range that will be used as text for categories or "
"data labels. "
msgstr ""
"Մուտքագրեք կամ ընտրեք բջջային միջակայքը, որը կօգտագործվի որպես տեքստ դասերի "
"կամ տվյալների պիտակների համար։ "

#: type_column_line.xhp#par_id301828.help.text
#: type_column_line.xhp%23par_id301828.help.text
msgid ""
"The values in the Categories range will be shown as labels on the x axis."
msgstr ""
"Դասերի միջակայքում նշված արժեքները կցուցադրվեն որպես x առանցքի պիտակներ:"

#: type_column_line.xhp#hd_id8996246.help.text
#: type_column_line.xhp%23hd_id8996246.help.text
msgid "Inserting chart elements"
msgstr "Գծապատկերային տարրերի տեղադրում"

#: type_column_line.xhp#par_id5729544.help.text
#: type_column_line.xhp%23par_id5729544.help.text
msgid ""
"Use the Chart Elements page of the Chart Wizard to insert any of the "
"following elements:"
msgstr ""
"Օգտագործեք Գծապատկերի Հրաշագործի Գծապատկերի տարրեր էջը՝ հետևյալ տարրերից "
"որևէ մեկը տեղադրելու համար"

#: type_column_line.xhp#par_id2932828.help.text
#: type_column_line.xhp%23par_id2932828.help.text
msgid "Chart titles"
msgstr "Գծապատկերների վերնագրեր"

#: type_column_line.xhp#par_id9449446.help.text
#: type_column_line.xhp%23par_id9449446.help.text
msgctxt "type_column_line.xhp#par_id9449446.help.text"
msgid "Legend"
msgstr "Լեգենդ"

#: type_column_line.xhp#par_id8122196.help.text
#: type_column_line.xhp%23par_id8122196.help.text
msgid "Visible grid lines"
msgstr "Ցանցի տեսանելի գծեր"

#: type_column_line.xhp#par_id9909665.help.text
#: type_column_line.xhp%23par_id9909665.help.text
msgctxt "type_column_line.xhp#par_id9909665.help.text"
msgid ""
"For additional elements use the Insert menu of the chart in edit mode. There "
"you can define the following elements:"
msgstr ""
"Լրացուցիչ տարրերի համար օգտագործեք աղյուսակի Տեղադրման ընտրացանկը խմբագրման "
"ռեժիմում: Այնտեղ կարող եք սահմանել հետևյալ տարրերը."

#: type_column_line.xhp#par_id9141819.help.text
#: type_column_line.xhp%23par_id9141819.help.text
msgctxt "type_column_line.xhp#par_id9141819.help.text"
msgid "Secondary axes"
msgstr "Երկրորդական առանցքներ"

#: type_column_line.xhp#par_id6354869.help.text
#: type_column_line.xhp%23par_id6354869.help.text
msgctxt "type_column_line.xhp#par_id6354869.help.text"
msgid "Minor grids"
msgstr "Ստորադաս առանցքներ"

#: type_column_line.xhp#par_id2685323.help.text
#: type_column_line.xhp%23par_id2685323.help.text
msgctxt "type_column_line.xhp#par_id2685323.help.text"
msgid "Data labels"
msgstr "Տվյալների պիտակներ"

#: type_column_line.xhp#par_id6042664.help.text
#: type_column_line.xhp%23par_id6042664.help.text
msgctxt "type_column_line.xhp#par_id6042664.help.text"
msgid "Statistics, for example mean values, y error bars and trend lines"
msgstr "Վիճակագրությունը, օրինակ, միջին արժեքները, y սխալի գիծը և միտումի գծերը"

#: type_column_line.xhp#par_id7889950.help.text
#: type_column_line.xhp%23par_id7889950.help.text
msgid ""
"To set different data labels for each data series, use the properties dialog "
"of the data series."
msgstr ""
"Տվյալների յուրաքանչյուր շարքի համար տարբեր տվյալների պիտակներ սահմանելու "
"համար օգտագործեք տվյալների շարքի հատկությունների երկխոսությունը:"

#: type_line.xhp#tit.help.text
#: type_line.xhp%23tit.help.text
msgid "Chart Type Line"
msgstr "Գծապտկերի տեսակի գիծ"

#: type_line.xhp#bm_id2187566.help.text
#: type_line.xhp%23bm_id2187566.help.text
msgid ""
"<bookmark_value>line charts</bookmark_value><bookmark_value>chart "
"types;line</bookmark_value>"
msgstr ""
"<bookmark_value>line charts</bookmark_value><bookmark_value>chart "
"types;line</bookmark_value>"

#: type_line.xhp#hd_id9422894.help.text
#: type_line.xhp%23hd_id9422894.help.text
msgid ""
"<variable id=\"type_line\"><link href=\"text/schart/01/type_line.xhp\">Chart "
"Type Line</link></variable>"
msgstr ""
"<variable id=\"type_line\"><link href=\"text/schart/01/type_line.xhp\">"
"Գծապատկերի տեսակի գիծ</link></variable>"

#: type_line.xhp#par_id389721.help.text
#: type_line.xhp%23par_id389721.help.text
msgctxt "type_line.xhp#par_id389721.help.text"
msgid ""
"On the first page of the <link href=\"text/schart/01/wiz_chart_type.xhp\">"
"Chart Wizard</link> you can choose a chart type. "
msgstr ""
"<link href=\"text/schart/01/wiz_chart_type.xhp\">Գծապատկերի Հրաշագործի</link>"
" առաջին էջում կարող եք ընտրել գծապատկերի տեսակը։"

#: type_line.xhp#hd_id9826349.help.text
#: type_line.xhp%23hd_id9826349.help.text
msgid "Line"
msgstr "Գիծ"

#: type_line.xhp#par_id2334665.help.text
#: type_line.xhp%23par_id2334665.help.text
msgid ""
"A line chart shows values as points on the y axis. The x axis shows "
"categories. The y values of each data series can be connected by a line."
msgstr ""
"Տողի գծապատկերում ցույց են տրված արժեքները որպես y առանցքի կետեր: X առանցքը "
"ցույց է տալիս դասերը: Տվյալների յուրաքանչյուր շարքի y արժեքները կարող են "
"կապված լինել տողի միջոցով:"

#: type_line.xhp#par_id8956572.help.text
#: type_line.xhp%23par_id8956572.help.text
msgid "Points only - this subtype plots only points."
msgstr "Միայն կետեր - այս ենթատեսակը միայն կետեր է տալիս:"

#: type_line.xhp#par_id500808.help.text
#: type_line.xhp%23par_id500808.help.text
msgid ""
"Points and lines - this subtype plots points and connects points of the same "
"data series by a line."
msgstr ""
"Կետեր և տողեր. Այս ենթատեսակը գծագրում է միավորներ և միացնում է տվյալների "
"նույն շարքի կետերը:"

#: type_line.xhp#par_id8366649.help.text
#: type_line.xhp%23par_id8366649.help.text
msgid "Lines only - this subtype plots only lines."
msgstr "Միայն գծեր. Այս ենթատեսակը տողեր է գծում:"

#: type_line.xhp#par_id476393.help.text
#: type_line.xhp%23par_id476393.help.text
msgid ""
"3D lines - this subtype connects points of the same data series by a 3D line."
msgstr ""
"3D տողեր - այս ենթատեսակը միացնում է տվյալների նույն շարքի կետերը՝ 3D տողով:"

#: type_line.xhp#par_id2655720.help.text
#: type_line.xhp%23par_id2655720.help.text
msgid ""
"Mark <emph>Stack series</emph> to arrange the points' y values cumulative "
"above each other. The y values no longer represent absolute values, except "
"for the first column which is drawn at the bottom of the stacked points. If "
"you select <emph>Percent</emph>, the y values are scaled as percentage of "
"the category total."
msgstr ""
"Նշեք <emph>Կուտակվող շարքերը</emph> դասավորելու կետերի y արժեքները միմյանցից "
"վեր: Y- ի արժեքներն այլևս չեն ներկայացնում բացարձակ արժեքներ, բացառությամբ "
"առաջին սյունակի, որը գծված է հավաքված կետերի ներքևի մասում: Եթե ընտրեք "
"<emph>Տոկոս</emph>, ապա y արժեքները մասշտաբվում են որպես դասի ընդհանուր "
"տոկոս:"

#: type_line.xhp#par_id3682058.help.text
#: type_line.xhp%23par_id3682058.help.text
msgid ""
"Mark <emph>Smooth lines</emph> to draw curves through the points instead of "
"straight lines. Click <emph>Properties</emph> for a <link href=\""
"text/schart/01/smooth_line_properties.xhp\">dialog</link> to change the "
"curves' properties."
msgstr ""
"Նշեք <emph>Հարթեցնող գծեր</emph> կետերի միջոցով ուղիղ գծերի փոխարեն կորեր "
"գծելու համար: Սեղմեք <emph>Հատկություններ</emph> այս <link href=\""
"text/schart/01/smooth_line_properties.xhp\">երկխոսության</link> համար, կորի "
"հատկությունները փոխելու համար։"

#: 04020000.xhp#tit.help.text
#: 04020000.xhp%23tit.help.text
msgctxt "04020000.xhp#tit.help.text"
msgid "Legend"
msgstr "Լեգենդ"

#: 04020000.xhp#bm_id3156441.help.text
#: 04020000.xhp%23bm_id3156441.help.text
msgid ""
"<bookmark_value>chart legends; hiding</bookmark_value><bookmark_value>hiding;"
"chart legends</bookmark_value>"
msgstr ""
"<bookmark_value>chart legends; hiding</bookmark_value><bookmark_value>hiding;"
"chart legends</bookmark_value>"

#: 04020000.xhp#hd_id3156441.1.help.text
#: 04020000.xhp%23hd_id3156441.1.help.text
msgctxt "04020000.xhp#hd_id3156441.1.help.text"
msgid "Legend"
msgstr "Լեգենդ"

#: 04020000.xhp#par_id3155413.2.help.text
#: 04020000.xhp%23par_id3155413.2.help.text
msgid ""
"<variable id=\"legende\"><ahelp hid=\".uno:InsertMenuLegend\">Opens the "
"<emph>Legend </emph>dialog, which allows you to change the position of "
"legends in the chart, and to specify whether the legend is "
"displayed.</ahelp></variable>"
msgstr ""
"<variable id=\"legende\"><ahelp hid=\".uno:InsertMenuLegend\">Բացվում է "
"<emph>Լեգենդ</emph> երկխոսությունը, որը թույլ է տալիս փոխել լեգենդների դիրքը "
"գծապատկերում և ճշտել, թե արդյոք լեգենդը ցուցադրվում է:</ahelp></variable>"

#: 04020000.xhp#par_id3149124.3.help.text
#: 04020000.xhp%23par_id3149124.3.help.text
msgid ""
"<variable id=\"sytextlegende\"><ahelp hid=\".uno:ToggleLegend\">To show or "
"hide a legend, click <emph>Legend On/Off</emph> on the "
"<emph>Formatting</emph> bar.</ahelp></variable>"
msgstr ""
"<variable id=\"sytextlegende\"><ahelp hid=\".uno:ToggleLegend\">Լեգենդը "
"ցույց տալու կամ թաքցնելու համար <emph>Ձևավորում</emph> ներդիրում կտտացրեք "
"<emph>Լեգենդը միացված/անջատված</emph>։</ahelp></variable>"

#: 04020000.xhp#par_id3145230.help.text
#: 04020000.xhp%23par_id3145230.help.text
msgid ""
"<image id=\"img_id3147346\" src=\"res/commandimagelist/sc_togglelegend.png\" "
"width=\"0.1665in\" height=\"0.1665in\"><alt id=\"alt_id3147346\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3147346\" src=\"res/commandimagelist/sc_togglelegend.png\" "
"width=\"0.1665in\" height=\"0.1665in\"><alt id=\"alt_id3147346\""
">Պատկերիկ</alt></image>"

#: 04020000.xhp#par_id3149207.16.help.text
#: 04020000.xhp%23par_id3149207.16.help.text
msgid "Legend On/Off"
msgstr "Լեգենդը միացված/անջատված"

#: 04020000.xhp#hd_id3155114.6.help.text
#: 04020000.xhp%23hd_id3155114.6.help.text
msgid "Display"
msgstr "Պատկերակում"

#: 04020000.xhp#par_id3150206.7.help.text
#: 04020000.xhp%23par_id3150206.7.help.text
msgid ""
"<ahelp hid=\"SCH_CHECKBOX_DLG_LEGEND_CBX_SHOW\">Specifies whether to display "
"a legend for the chart.</ahelp> This option is only visible if you call the "
"dialog by choosing <emph>Insert - Legend</emph>."
msgstr ""
"<ahelp hid=\"SCH_CHECKBOX_DLG_LEGEND_CBX_SHOW\">Ճշգրտում է արդյոք գծապատկերի "
"համար ցուցադրել լեգենդը:</ahelp> Այս ընտրանքը տեսանելի է միայն այն դեպքում, "
"երբ կանչում եք երկխոսությունը, ընտրելով<emph>Տեղադրել - Լեգենդ</emph>։"

#: 04020000.xhp#hd_id3150201.4.help.text
#: 04020000.xhp%23hd_id3150201.4.help.text
msgid "Position"
msgstr "Դիրք"

#: 04020000.xhp#par_id3155376.5.help.text
#: 04020000.xhp%23par_id3155376.5.help.text
msgid "Select the position for the legend:"
msgstr "Ընտրեք դիրքը լեգենդի համար։"

#: 04020000.xhp#hd_id3152988.8.help.text
#: 04020000.xhp%23hd_id3152988.8.help.text
msgid "Left"
msgstr "Ձախ"

#: 04020000.xhp#par_id3155087.9.help.text
#: 04020000.xhp%23par_id3155087.9.help.text
msgid ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_LEGEND_POS:RBT_LEFT\">Positions the legend "
"at the left of the chart.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_LEGEND_POS:RBT_LEFT\">Դիրքավորում է լեգենդը "
"գծապատկերի ձախ մասում։</ahelp>"

#: 04020000.xhp#hd_id3153816.10.help.text
#: 04020000.xhp%23hd_id3153816.10.help.text
msgid "Top"
msgstr "Վերին մաս"

#: 04020000.xhp#par_id3153912.11.help.text
#: 04020000.xhp%23par_id3153912.11.help.text
msgid ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_LEGEND_POS:RBT_TOP\">Positions the legend at "
"the top of the chart.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_LEGEND_POS:RBT_TOP\">Դիրքավորում է լեգենդը "
"գծապատկերի վերին մասում։</ahelp>"

#: 04020000.xhp#hd_id3144773.12.help.text
#: 04020000.xhp%23hd_id3144773.12.help.text
msgid "Right"
msgstr "Աջ"

#: 04020000.xhp#par_id3155268.13.help.text
#: 04020000.xhp%23par_id3155268.13.help.text
msgid ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_LEGEND_POS:RBT_RIGHT\">Positions the legend "
"at the right of the chart.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_LEGEND_POS:RBT_RIGHT\">Դիրքավորում է լեգենդը "
"գծապատկերի աջ մասում։</ahelp>"

#: 04020000.xhp#hd_id3152871.14.help.text
#: 04020000.xhp%23hd_id3152871.14.help.text
msgid "Bottom"
msgstr "Ստորին"

#: 04020000.xhp#par_id3153249.15.help.text
#: 04020000.xhp%23par_id3153249.15.help.text
msgid ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_LEGEND_POS:RBT_BOTTOM\">Positions the legend "
"at the bottom of the chart.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:RADIOBUTTON:TP_LEGEND_POS:RBT_BOTTOM\">Դիրքավորում է "
"լեգենդը գծապատկերի ստորին մասում։</ahelp>"

#: 04020000.xhp#hd_id1106200812072645.help.text
#: 04020000.xhp%23hd_id1106200812072645.help.text
msgid "Text Orientation"
msgstr "Տեքստի կողմնորոշում"

#: 04020000.xhp#par_id1106200812072653.help.text
#: 04020000.xhp%23par_id1106200812072653.help.text
msgid ""
"This feature is only available if complex text layout support is enabled in <"
"item type=\"menuitem\"><switchinline select=\"sys\"><caseinline select=\""
"MAC\">%PRODUCTNAME - Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - Language settings - "
"Languages</item>."
msgstr ""
"Այս հնարավորությունը հասանելի է միայն այն դեպքում, եթե <item type=\""
"menuitem\"><switchinline select=\"sys\"><caseinline select=\"MAC\">%"
"PRODUCTNAME - Նախապատվություններ</caseinline><defaultinline>Գործիքներ - "
"Ընտրանքներ</defaultinline></switchinline> - Լեզվական կարգաբերումներ - "
"Լեզուներ</item> -ում գործարկված է տեքստի ձևավորման բարդ աջակցությունը։"

#: 04020000.xhp#hd_id1106200812112444.help.text
#: 04020000.xhp%23hd_id1106200812112444.help.text
msgctxt "04020000.xhp#hd_id1106200812112444.help.text"
msgid "Text Direction"
msgstr "Տեքստի ուղղությունը"

#: 04020000.xhp#par_id1106200812112530.help.text
#: 04020000.xhp%23par_id1106200812112530.help.text
msgctxt "04020000.xhp#par_id1106200812112530.help.text"
msgid ""
"<ahelp hid=\".\">Specify the text direction for a paragraph that uses "
"complex text layout (CTL). This feature is only available if complex text "
"layout support is enabled.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Նշեք տեքստի ուղղությունը մի պարբերության համար, որն "
"օգտագործում է տեքստի բարդ դասավորությունը (CTL): Այս հնարավորությունը "
"հասանելի է միայն այն դեպքում, եթե միացված է տեքստի ձևավորման բարդ "
"աջակցությունը:</ahelp>"

#: 05040201.xhp#tit.help.text
#: 05040201.xhp%23tit.help.text
msgctxt "05040201.xhp#tit.help.text"
msgid "Scale"
msgstr "Սանդղակ"

#: 05040201.xhp#bm_id3150868.help.text
#: 05040201.xhp%23bm_id3150868.help.text
msgid ""
"<bookmark_value>scaling; axes</bookmark_value><bookmark_value>logarithmic "
"scaling along axes</bookmark_value><bookmark_value>charts;scaling "
"axes</bookmark_value><bookmark_value>X "
"axes;scaling</bookmark_value><bookmark_value>Y axes; scaling</bookmark_value>"
msgstr ""
"<bookmark_value>scaling; axes</bookmark_value><bookmark_value>logarithmic "
"scaling along axes</bookmark_value><bookmark_value>charts;scaling "
"axes</bookmark_value><bookmark_value>X "
"axes;scaling</bookmark_value><bookmark_value>Y axes; scaling</bookmark_value>"

#: 05040201.xhp#hd_id3150868.1.help.text
#: 05040201.xhp%23hd_id3150868.1.help.text
msgid "<link href=\"text/schart/01/05040201.xhp\" name=\"Scale\">Scale</link>"
msgstr ""
"<link href=\"text/schart/01/05040201.xhp\" name=\"Սանդղակ\">Սանդղակ</link>"

#: 05040201.xhp#par_id3154013.2.help.text
#: 05040201.xhp%23par_id3154013.2.help.text
msgid "Controls the scaling of the X or Y axis."
msgstr "Վերահսկում է X կամ Y առանցքի սանդղակավորումը։"

#: 05040201.xhp#par_id3148576.79.help.text
#: 05040201.xhp%23par_id3148576.79.help.text
msgid ""
"The axes are automatically scaled by $[officename] so that all values are "
"optimally displayed."
msgstr ""
"Առանցքներն ինքնաշխատ կերպով մասշտաբվում են $[officename] -ով, որպեսզի բոլոր "
"արժեքներն լավագույն կերպով ցուցադրվեն:"

#: 05040201.xhp#par_id3149379.3.help.text
#: 05040201.xhp%23par_id3149379.3.help.text
msgid ""
"To achieve specific results, you can manually change the axis scaling. For "
"example, you can display only the top areas of the columns by shifting the "
"zero line upwards."
msgstr ""
"Հատուկ արդյունքների հասնելու համար կարող եք ձեռքով փոխել առանցքի մասշտաբը: "
"Օրինակ, կարող եք ցուցադրել միայն սյուների վերին հատվածները` զրոյական գիծը "
"վերև տեղափոխելով:"

#: 05040201.xhp#hd_id3154730.4.help.text
#: 05040201.xhp%23hd_id3154730.4.help.text
msgctxt "05040201.xhp#hd_id3154730.4.help.text"
msgid "Scale"
msgstr "Սանդղակ"

#: 05040201.xhp#par_id3149400.5.help.text
#: 05040201.xhp%23par_id3149400.5.help.text
msgid ""
"You can enter values for subdividing axes in this area. You can "
"automatically set the properties <emph>Minimum, Maximum, Major interval, "
"Minor interval count</emph> and <emph>Reference value</emph>."
msgstr ""
"Դուք կարող եք մուտքագրել արժեքներ այս հատվածում առանցքների բաժանման համար: "
"Կարող եք ինքնաբերաբար կարգավորել <emph>Նվազագույն, Առավելագույն, Գլխավոր "
"միջակայք, Երկրորդական միջակայքի հաշվիչ</emph> և <emph>Տեղեկատու արժեք</emph> "
"հատկությունները:"

#: 05040201.xhp#hd_id3150751.6.help.text
#: 05040201.xhp%23hd_id3150751.6.help.text
msgid "Minimum"
msgstr "Նվազագույն"

#: 05040201.xhp#par_id3153713.7.help.text
#: 05040201.xhp%23par_id3153713.7.help.text
msgid ""
"<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_MIN\">Defines the minimum value for "
"the beginning of the axis.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_MIN\">Սահմանում է առանցքի սկզբի "
"նվազագույն արժեքը:</ahelp>"

#: 05040201.xhp#hd_id3156385.8.help.text
#: 05040201.xhp%23hd_id3156385.8.help.text
msgid "Maximum"
msgstr "Առավելագույն"

#: 05040201.xhp#par_id3159266.9.help.text
#: 05040201.xhp%23par_id3159266.9.help.text
msgid ""
"<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_MAX\">Defines the maximum value for "
"the end of the axis.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_MAX\">Սահմանում է առանցքի վերջի "
"առավելագույն արժեքը:</ahelp>"

#: 05040201.xhp#hd_id3155336.10.help.text
#: 05040201.xhp%23hd_id3155336.10.help.text
msgid "Major interval"
msgstr "Հիմնական միջակայք"

#: 05040201.xhp#par_id3143218.11.help.text
#: 05040201.xhp%23par_id3143218.11.help.text
msgid ""
"<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_STEP_MAIN\">Defines the interval for "
"the main division of the axes.</ahelp> The main interval cannot be larger "
"than the value area."
msgstr ""
"<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_STEP_MAIN\">Սահմանում է առանցքների "
"հիմնական բաժանման միջակայքը:</ahelp> Հիմնական միջակայքը չի կարող լինել ավելի "
"մեծ, քան արժեքի մակերեսը:"

#: 05040201.xhp#hd_id3154020.12.help.text
#: 05040201.xhp%23hd_id3154020.12.help.text
msgid "Minor interval count"
msgstr "Ստորադաս միջակայքի հաշվիչ"

#: 05040201.xhp#par_id3154656.13.help.text
#: 05040201.xhp%23par_id3154656.13.help.text
msgid ""
"<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_STEP_HELP\">Defines the interval for "
"the subdivision of the axes.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_STEP_HELP\">Սահմանում է առանցքների "
"ստորաբաժանման միջակայքը:</ahelp>"

#: 05040201.xhp#hd_id3150089.14.help.text
#: 05040201.xhp%23hd_id3150089.14.help.text
msgid "Reference value"
msgstr "Տեղեկատու արժեք"

#: 05040201.xhp#par_id3152990.15.help.text
#: 05040201.xhp%23par_id3152990.15.help.text
msgid ""
"<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_ORIGIN\">Specifies at which position "
"to display the values along the axis.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH_SPINFIELD_TP_SCALE_EDT_ORIGIN\">Նշում է, թե առանցքի "
"երկայնքով որ դիրքում է ցուցադրելու արժեքները:</ahelp>"

#: 05040201.xhp#hd_id3166432.62.help.text
#: 05040201.xhp%23hd_id3166432.62.help.text
msgctxt "05040201.xhp#hd_id3166432.62.help.text"
msgid "Automatic"
msgstr "Ինքնաշխատ"

#: 05040201.xhp#par_id3145389.63.help.text
#: 05040201.xhp%23par_id3145389.63.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:TP_SCALE:CBX_AUTO_ORIGIN\">You must first deselect "
"the <emph>Automatic</emph> option in order to modify the values.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:TP_SCALE:CBX_AUTO_ORIGIN\">Պետք է նախ ապաընտրեք "
"<emph>Ինքնաշխատ</emph> տարբերակը՝ արժեքները փոփոխելու համար:</ahelp>"

#: 05040201.xhp#par_id3149129.64.help.text
#: 05040201.xhp%23par_id3149129.64.help.text
msgid ""
"Disable this feature if you are working with \"fixed\" values, as it does "
"not permit automatic scaling."
msgstr ""
"Անջատեք այս հատկությունը, եթե աշխատում եք «սևեռված» արժեքներով, քանի որ դա "
"թույլ չի տալիս ինքնաշխատ կերպով մասշտաբավորել:"

#: 05040201.xhp#hd_id3159206.16.help.text
#: 05040201.xhp%23hd_id3159206.16.help.text
msgid "Logarithmic scale"
msgstr "Լոգարիթմական սանդղակ"

#: 05040201.xhp#par_id3145360.17.help.text
#: 05040201.xhp%23par_id3145360.17.help.text
msgid ""
"<ahelp hid=\"SCH:CHECKBOX:TP_SCALE:CBX_LOGARITHM\">Specifies that you want "
"the axis to be subdivided logarithmically.</ahelp>"
msgstr ""
"<ahelp hid=\"SCH:CHECKBOX:TP_SCALE:CBX_LOGARITHM\">Նշում է, որ ցանկանում եք, "
"որ առանցքը լոգարիթմորեն բաժանվի:</ahelp>"

#: 05040201.xhp#par_id3153956.61.help.text
#: 05040201.xhp%23par_id3153956.61.help.text
msgid ""
"Use this feature if you are working with values that differ sharply from "
"each other. You can use logarithmic scaling to make the grid lines of the "
"axis equidistant but have values that may increase or decrease."
msgstr ""
"Օգտագործեք այս հնարավորությունը, եթե աշխատում եք միմյանցից կտրուկ տարբերվող "
"արժեքների հետ: Դուք կարող եք օգտագործել լոգարիթմական սանդղակներ՝ առանցքի "
"ցանցի գծերը հավասար դարձնելու համար, եթե ունեն արժեքներ, որոնք կարող են աճել "
"կամ նվազել:"

#: 05040201.xhp#hd_id9941404.help.text
#: 05040201.xhp%23hd_id9941404.help.text
msgid "Reverse direction"
msgstr "Հակառակ ուղղություն"

#: 05040201.xhp#par_id5581835.help.text
#: 05040201.xhp%23par_id5581835.help.text
msgid ""
"<ahelp hid=\".\">Defines where the lower and where the higher values are "
"displayed at the axis. The unchecked state is the mathematical "
"direction.</ahelp> That means for Cartesian coordinate systems that the x-"
"axis shows the lower values on the left and the y-axis shows the lower "
"values at the bottom. For polar coordinate systems the mathematical angle "
"axis direction is counterclockwise and the radial axis is from inner to "
"outer."
msgstr ""
"<ahelp hid=\".\">Սահմանում է, թե առանցքի վրա որտեղ են ցածր և որտեղ ավելի "
"բարձր արժեքները ցուցադրվում: Չստուգված վիճակը մաթեմատիկական ուղղությունն "
"է:</ahelp> Դա նշանակում է Դեկարտյան կոորդինատային համակարգերի համար, որ x- "
"առանցքը ցույց է տալիս ձախ ստորին արժեքները, իսկ y- առանցքը ցույց է տալիս "
"փոքր արժեքները ներքևում: Բևեռային կոորդինատային համակարգերի համար "
"մաթեմատիկական անկյան առանցքի ուղղությունը հակառակ ուղղությամբ է, իսկ "
"ճառագայթային առանցքը` ներսից դեպի դուրս:"

#: 05040201.xhp#hd_id922204.help.text
#: 05040201.xhp%23hd_id922204.help.text
msgid "Type"
msgstr "Տեսակ"

#: 05040201.xhp#par_id59225.help.text
#: 05040201.xhp%23par_id59225.help.text
msgid ""
"<ahelp hid=\".\">For some types of axes, you can select to format an axis as "
"text or date, or to detect the type automatically.</ahelp> For the axis type "
"\"Date\" you can set the following options."
msgstr ""
"<ahelp hid=\".\">Առանցքների որոշ տեսակների համար կարող եք ընտրել առանցքի "
"ձևաչափումը որպես տեքստ կամ ամսաթիվ, կամ ինքնաբերաբար հայտնաբերել "
"տեսակը:</ahelp> «Ամսաթիվ» առանցքի տիպի համար կարող եք սահմանել հետևյալ "
"ընտրանքները:"

#: 05040201.xhp#par_id1159225.help.text
#: 05040201.xhp%23par_id1159225.help.text
msgid "Minimum and maximum value to be shown on the ends of the scale."
msgstr "Սանդղակի ծայրերում ցուցադրվելու է նվազագույն և առավելագույն արժեք:"

#: 05040201.xhp#par_id2259225.help.text
#: 05040201.xhp%23par_id2259225.help.text
msgid ""
"<ahelp hid=\".\">Resolution can be set to show days, months, or years as "
"interval steps.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բանաձևը կարող է սահմանվել, որ ցույց տա օրերը, ամիսները կամ "
"տարիները որպես միջակայքի քայլեր:</ahelp>"

#: 05040201.xhp#par_id3359225.help.text
#: 05040201.xhp%23par_id3359225.help.text
msgid ""
"<ahelp hid=\".\">Major interval can be set to show a certain number of days, "
"months, or years.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Գլխավոր միջակայքը կարող է սահմանվել, որպեսզի ցույց տա "
"որոշակի քանակությամբ օրեր, ամիսներ կամ տարիներ:</ahelp>"

#: 05040201.xhp#par_id4459225.help.text
#: 05040201.xhp%23par_id4459225.help.text
msgid ""
"<ahelp hid=\".\">Minor interval can be set to show a certain number of days, "
"months, or years.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ստորադաս միջակայքը կարող է սահմանվել ցույց տալու որոշակի "
"օրեր, ամիսներ կամ տարիներ:</ahelp>"

