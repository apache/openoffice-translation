#: 04030000.xhp%23par_id9794610.help.text
msgid "<ahelp hid=\".\">Opens a dialog to select the number format.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացվում է երկխոսությունը՝ թվի ձևաչափը ընտրելու "
"համար:</ahelp>"

#: 04030000.xhp#hd_id3145643.9.help.text
#: 04030000.xhp%23hd_id3145643.9.help.text
