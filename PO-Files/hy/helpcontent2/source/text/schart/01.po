msgid ""
"<ahelp hid=\".\">Select where to place the labels: near axis, near axis ("
"other side), outside start, or outside end.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք, թե որտեղ պետք է տեղադրեք պիտակները. առանցքի մոտ, "
"առանցքի մոտ (մյուս կողմում), սկզբից կամ արտաքին ծայրից:</ahelp>"

