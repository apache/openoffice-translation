msgid ""
"<ahelp hid=\".uno:SelectObject\">Allows you to select objects in the current "
"document.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:SelectObject\">Թույլ է տալիս ընտրել առարկաները ընթացիկ "
"փաստաթղթում:</ahelp>"

#: 18010000.xhp#par_id3149511.help.text
