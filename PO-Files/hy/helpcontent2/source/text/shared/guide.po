#: edit_symbolbar.xhp%23par_id3145171.91.help.text
msgctxt "edit_symbolbar.xhp#par_id3145171.91.help.text"
msgid "Click <emph>OK</emph>."
msgstr "Կտտացրեք <emph>ԼԱՎ</emph>."

