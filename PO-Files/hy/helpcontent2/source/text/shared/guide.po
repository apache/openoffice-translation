#: aaa_start.xhp#tit.help.text
#: aaa_start.xhp%23tit.help.text
msgid "First Steps"
msgstr "Առաջին քայլերը"

#: aaa_start.xhp#bm_id3156324.help.text
#: aaa_start.xhp%23bm_id3156324.help.text
