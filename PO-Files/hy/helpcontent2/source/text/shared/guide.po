"<bookmark_value>line "
"styles;defining</bookmark_value><bookmark_value>defining;line "
"styles</bookmark_value>"

#: linestyle_define.xhp#hd_id3153825.9.help.text
#: linestyle_define.xhp%23hd_id3153825.9.help.text
