"<bookmark_value>documents; merging</bookmark_value><bookmark_value>merging; "
"documents</bookmark_value><bookmark_value>versions;merging document "
"versions</bookmark_value>"
msgstr ""
"<bookmark_value>documents; merging</bookmark_value><bookmark_value>merging; "
"documents</bookmark_value><bookmark_value>versions;merging document "
"versions</bookmark_value>"

