msgstr "Կտտացրեք <emph>Օգտագործեք հրաշագործը աղյուսակ ստեղծելու համար</emph>։"

#: data_tables.xhp#par_idN10645.help.text
#: data_tables.xhp%23par_idN10645.help.text
