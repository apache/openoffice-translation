msgstr "Կազմել"

#: xformsdatatab.xhp#par_id1481063.help.text
#: xformsdatatab.xhp%23par_id1481063.help.text
msgid ""
"<ahelp hid=\".\">Select or enter the name of a binding. Selecting the name "
"of an existing binding associates the binding with the form control. "
"Entering a new name creates a new binding and associates it with the form "
"control.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք կամ մուտքագրեք պարտադիրի անունը: Առկա պարտադիր "
"անվանման ընտրությունը կապում է կապի ձևի վերահսկման հետ: Նոր անուն "
"մուտքագրելը ստեղծում է նոր պարտադիր և այն կապում է ձևի հսկողության "
"հետ:</ahelp>"

#: xformsdatatab.xhp#hd_id7921079.help.text
