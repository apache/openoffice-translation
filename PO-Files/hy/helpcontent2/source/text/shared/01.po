#: 02100000.xhp%23par_id3145421.206.help.text
msgid ""
"<variable id=\"aehnlichtext\"><ahelp hid=\""
"SVX_CHECKBOX_RID_SVXDLG_SEARCH_CB_JAP_SOUNDS_LIKE\">Lets you specify the "
