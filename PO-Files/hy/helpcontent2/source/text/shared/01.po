"գրադիենտի սկզբնական կետի համար:</ahelp>"

#: 05210300.xhp#par_id3149398.25.help.text
#: 05210300.xhp%23par_id3149398.25.help.text
msgid ""
"<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_GRADIENT:MTR_COLOR_FROM\">Enter the "
"intensity for the color in the <emph>From </emph>box, where 0% corresponds "
"to black, and 100 % to the selected color.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_GRADIENT:MTR_COLOR_FROM\">"
"Մուտքագրեք գույնի ինտենսիվությունը <emph>Այստեղից </emph>վանդակում, որտեղ 0% "
"համապատասխանում է սևին, և 100 % ընտրված գույնին։</ahelp>"

