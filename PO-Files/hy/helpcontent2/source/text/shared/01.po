msgid "Not permitted"
msgstr "Չի թույլատրված"

#: ref_pdf_export.xhp#par_id3939634.help.text
#: ref_pdf_export.xhp%23par_id3939634.help.text
msgid "<ahelp hid=\".\">Printing the document is not permitted.</ahelp>"
msgstr "<ahelp hid=\".\">Փաստաթղթի տպումը չի թույլատրվում:</ahelp>"

