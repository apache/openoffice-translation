msgstr "A-B (անփոփոխ)"

#: 06040100.xhp#par_id714438.help.text
#: 06040100.xhp%23par_id714438.help.text
msgid "A -B (A, space, minus, B)"
msgstr "A -B (A, բացատ, մինուս, B)"

