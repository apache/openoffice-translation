msgstr "Կենտրոն (ուղղահայաց)"

#: 05100600.xhp#hd_id3149874.1.help.text
#: 05100600.xhp%23hd_id3149874.1.help.text
msgid ""
"<link href=\"text/shared/01/05100600.xhp\" name=\"Center (vertical)\">Center "
"(vertical)</link>"
msgstr ""
"<link href=\"text/shared/01/05100600.xhp\" name=\"Կենտրոն (ուղղահայաց)\">"
"Կենտրոն (ուղղահայաց)</link>"

#: 05100600.xhp#par_id3149048.2.help.text
#: 05100600.xhp%23par_id3149048.2.help.text
msgid ""
"<ahelp hid=\".\">Centers the contents of the cell between top and bottom of "
"the cell.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բերում է կենտրոն բջիջի պարունակությունը բջիջի վերին և "
"ստորին մասերի միջև:</ahelp>"

#: 05100600.xhp#par_id3149525.121.help.text
#: 05100600.xhp%23par_id3149525.121.help.text
msgid ""
"<variable id=\"zellemitte\">In the context menu of a cell, choose <emph>Cell "
"- Center</emph></variable>"
msgstr ""
"<variable id=\"zellemitte\">Բջջի համատեքստի ընտրացանկում ընտրեք <emph>Բջիջ - "
"Կենտրոն</emph></variable>"

#: xformsdataaddcon.xhp#tit.help.text
#: xformsdataaddcon.xhp%23tit.help.text
