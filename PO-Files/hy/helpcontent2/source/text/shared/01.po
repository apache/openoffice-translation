#: ref_pdf_export.xhp%23hd_id5833307.help.text
msgctxt "ref_pdf_export.xhp#hd_id5833307.help.text"
msgid "Not permitted"
msgstr "Չի թույլատրված"

#: ref_pdf_export.xhp#par_id7726676.help.text
