msgid ""
"<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_TRANSPARENCE:MTR_TRGR_BORDER\">"
"Enter the amount by which you want to adjust the transparent area of the "
"gradient. The default value is 0%.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_TRANSPARENCE:MTR_TRGR_BORDER\">"
