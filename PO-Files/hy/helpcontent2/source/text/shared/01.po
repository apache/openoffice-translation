msgstr "Օգտվողի սահմանած բառարաններ"

#: 06201000.xhp#par_idN10563.help.text
#: 06201000.xhp%23par_idN10563.help.text
msgid ""
"<ahelp hid=\"HID_HANGULHANJA_NEWDICT_DLG\">Lists all user-defined "
"dictionaries. Select the check box next to the dictionary that you want to "
"use. Clear the check box next to the dictionary that you do not want to "
"use.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_HANGULHANJA_NEWDICT_DLG\">Թվարկում է օգտվողի կողմից "
"սահմանված բոլոր բառարանները: Ընտրեք բառարանի կողքի այն ընտրավանդակը, որը "
"ցանկանում եք օգտագործել: Մաքրեք բառարանի կողքին գտնվող վանդակը, որը չեք "
"ցանկանում օգտագործել:</ahelp>"

#: 06201000.xhp#par_idN1057A.help.text
#: 06201000.xhp%23par_idN1057A.help.text
