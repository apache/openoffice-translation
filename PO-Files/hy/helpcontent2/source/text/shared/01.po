msgstr ""
"<ahelp hid=\".\">Ընտրեք տվյալների տեսակը, ըստ որի պետք է վավերացվի "
"հսկողությունը:</ahelp>"

#: xformsdatatab.xhp#hd_id2480849.help.text
#: xformsdatatab.xhp%23hd_id2480849.help.text
msgid "x"
msgstr "x"

#: xformsdatatab.xhp#par_id4181951.help.text
#: xformsdatatab.xhp%23par_id4181951.help.text
