"<link href=\"text/shared/01/06020000.xhp\" name=\"Thesaurus\""
">Thesaurus</link>"
msgstr ""
"<link href=\"text/shared/01/06020000.xhp\" name=\"Գանձարան\">Գանձարան</link>"

