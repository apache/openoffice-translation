"<ahelp hid=\"SVX_LISTBOX_RID_SVXDLG_RUBY_LB_POSITION\">Select where you want "
"to place the ruby text.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX_LISTBOX_RID_SVXDLG_RUBY_LB_POSITION\">Ընտրեք, որտեղ եք "
"ցանկանում տեղադրել ruby տեքստը:</ahelp>"

#: 05060000.xhp#hd_id3148672.9.help.text
#: 05060000.xhp%23hd_id3148672.9.help.text
msgid "Character Style for ruby text"
msgstr "Նիշի Ոճruby տեքստի համար"

#: 05060000.xhp#par_id3148676.10.help.text
#: 05060000.xhp%23par_id3148676.10.help.text
