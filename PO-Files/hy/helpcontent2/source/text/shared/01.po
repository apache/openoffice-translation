"<bookmark_value>AutoCorrect function; context "
"menu</bookmark_value><bookmark_value>spellcheck; context "
"menus</bookmark_value>"
msgstr ""
"<bookmark_value>AutoCorrect function; context "
"menu</bookmark_value><bookmark_value>spellcheck; context "
"menus</bookmark_value>"

#: 06040500.xhp#hd_id3152823.1.help.text
#: 06040500.xhp%23hd_id3152823.1.help.text
msgctxt "06040500.xhp#hd_id3152823.1.help.text"
msgid "AutoCorrect context menu"
msgstr "Ինքնշտկման բովանդակային ընտրացանկ"

#: 06040500.xhp#par_id3146936.2.help.text
#: 06040500.xhp%23par_id3146936.2.help.text
msgid ""
"To access this menu, right-click a misspelled word in your document. To view "
"the misspelled words in your document, enable <emph>AutoSpellcheck</emph> "
"icon on the Standard toolbar."
msgstr ""
"Այս ընտրացանկին մուտք գործելու համար աջ սեղմելեք ձեր փաստաթղթի սխալ բառի վրա:"
" Ձեր փաստաթղթում բաց թողնված բառերը դիտելու համար թույլատրեք <emph> "
"Ինքնաուղղագրիչ </emph> պատկերակը Ստանդարտ գործիքագոտում:"

#: 06040500.xhp#hd_id3153899.4.help.text
#: 06040500.xhp%23hd_id3153899.4.help.text
msgid "<Replacement Suggestions>"
msgstr "<Փոխարինման առաջարկություններ>"

#: 06040500.xhp#par_id3147000.5.help.text
#: 06040500.xhp%23par_id3147000.5.help.text
msgid ""
"<ahelp hid=\"HID_LINGU_REPLACE\">Click the word to replace the highlighted "
"word. Use the AutoCorrect submenu for permanent replacement.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_LINGU_REPLACE\">Կտտացրեք բառը` ընդգծված բառը փոխարինելու "
"համար: Մշտական փոխարինման համար օգտագործեք Ինքնաշտկում "
"ենթաընտրացանկը:</ahelp>"

#: 06040500.xhp#hd_id3153089.6.help.text
#: 06040500.xhp%23hd_id3153089.6.help.text
msgctxt "06040500.xhp#hd_id3153089.6.help.text"
msgid "Spellcheck"
msgstr "Ուղղագրիչ"

#: 06040500.xhp#par_id3154497.7.help.text
#: 06040500.xhp%23par_id3154497.7.help.text
msgid ""
"<ahelp hid=\"HID_LINGU_SPELLING_DLG\">Opens the <link href=\""
"text/shared/01/06010000.xhp\" name=\"Spellcheck\">Spellcheck</link> "
"dialog.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_LINGU_SPELLING_DLG\">Բացում է <link href=\""
"text/shared/01/06010000.xhp\" name=\"Ուղղագրիչ\">Ուղղագրիչ</link> "
"երկխոսությունը։</ahelp>"

#: 06040500.xhp#hd_id3149283.8.help.text
#: 06040500.xhp%23hd_id3149283.8.help.text
msgctxt "06040500.xhp#hd_id3149283.8.help.text"
msgid "Add"
msgstr "Ավելացնել"

#: 06040500.xhp#par_id3158405.9.help.text
#: 06040500.xhp%23par_id3158405.9.help.text
msgid ""
"<ahelp hid=\"HID_LINGU_ADD_WORD\">Adds the highlighted word to a user-"
"defined dictionary.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_LINGU_ADD_WORD\">Ընդգծված բառը ավելացնում է օգտագործողի "
"կողմից սահմանված բառարանում:</ahelp>"

#: 06040500.xhp#hd_id3152924.10.help.text
#: 06040500.xhp%23hd_id3152924.10.help.text
msgid "Ignore all"
msgstr "Անտեսել բոլորը"

#: 06040500.xhp#par_id3151226.11.help.text
#: 06040500.xhp%23par_id3151226.11.help.text
msgid ""
"<ahelp hid=\"HID_LINGU_IGNORE_WORD\">Ignores all instances of the "
"highlighted word in the current document.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_LINGU_IGNORE_WORD\">Անտեսում է ընթացիկ փաստաթղթում ընդգծված "
"բառի բոլոր դեպքերը:</ahelp>"

#: 06040500.xhp#hd_id3157958.12.help.text
#: 06040500.xhp%23hd_id3157958.12.help.text
msgctxt "06040500.xhp#hd_id3157958.12.help.text"
msgid "AutoCorrect"
msgstr "Ինքնաշտկում"

#: 06040500.xhp#par_id3149177.13.help.text
#: 06040500.xhp%23par_id3149177.13.help.text
msgid ""
"<ahelp hid=\"HID_LINGU_AUTOCORR\">To always replace the highlighted word, "
"click a word in the list. The word pair is stored in the replacement table "
"under Tools - AutoCorrect Options - Replace.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_LINGU_AUTOCORR\">Նշված բառը միշտ փոխարինելու համար կտտացրեք "
"որևէ բառ ցանկի մեջ: Բառերի զույգը պահվում է փոխարինման աղյուսակում Գործիքներ "
"- Ինքնաշտկման ընտրանքներ - Փոխարինել ներքո։</ahelp>"

#: 06040500.xhp#hd_id3146797.15.help.text
#: 06040500.xhp%23hd_id3146797.15.help.text
msgid "Word is <name of language>"
msgstr "Բառն է <name of language>"

#: 06040500.xhp#par_id3150443.16.help.text
#: 06040500.xhp%23par_id3150443.16.help.text
msgid ""
"<ahelp hid=\"HID_LINGU_WORD_LANGUAGE\">Changes the language settings for the "
"highlighted word, if the word is found in another dictionary.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_LINGU_WORD_LANGUAGE\">Նշված բառի համար փոխում է լեզվական "
"կարգաբերումները, եթե բառը գտնված է մեկ այլ բառարանում:</ahelp>"

#: 06040500.xhp#hd_id3166411.17.help.text
#: 06040500.xhp%23hd_id3166411.17.help.text
msgid "Paragraph is <name of language>"
msgstr "Պարբերությունն է <name of language>"

#: 06040500.xhp#par_id3148925.18.help.text
#: 06040500.xhp%23par_id3148925.18.help.text
msgid ""
"<ahelp hid=\"HID_LINGU_PARA_LANGUAGE\">Changes the language setting for the "
"paragraph that contains the highlighted word, if the word is found in "
"another dictionary.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_LINGU_PARA_LANGUAGE\">Պարբերության համար, որը պարունակում է "
"ընդգծված բառը փոխում է լեզվի կարգաբերումը, եթե բառը գտնված է մեկ այլ "
"բառարանում:</ahelp>"

#: 05340200.xhp#tit.help.text
#: 05340200.xhp%23tit.help.text
msgctxt "05340200.xhp#tit.help.text"
msgid "Column width"
msgstr "Սյունակի լայնություն"

#: 05340200.xhp#hd_id3158397.1.help.text
#: 05340200.xhp%23hd_id3158397.1.help.text
