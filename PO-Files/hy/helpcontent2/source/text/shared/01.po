#: 05230100.xhp#hd_id3154350.1.help.text
#: 05230100.xhp%23hd_id3154350.1.help.text
msgid ""
"<link href=\"text/shared/01/05230100.xhp\" name=\"Position and Size\">"
"Position and Size</link>"
msgstr ""
"<link href=\"text/shared/01/05230100.xhp\" name=\"Դիրք և չափ\">Դիրք և "
"չափ</link>"

#: 05230100.xhp#par_id3153255.2.help.text
#: 05230100.xhp%23par_id3153255.2.help.text
msgid "<ahelp hid=\".\">Resizes or moves the selected object.</ahelp>"
msgstr "<ahelp hid=\".\">չափափոխում կամ տեղափոխում է ընտրված օբյեկտը:</ahelp>"

#: 05230100.xhp#hd_id3158405.3.help.text
#: 05230100.xhp%23hd_id3158405.3.help.text
msgctxt "05230100.xhp#hd_id3158405.3.help.text"
