msgstr ""
"<ahelp hid=\"HID_SORT_ACTION\">Ցուցակը տեսակավորում է ըստ փոփոխության "
"տեսակի:</ahelp>"

#: 02230401.xhp#hd_id3150116.50.help.text
#: 02230401.xhp%23hd_id3150116.50.help.text
msgctxt "02230401.xhp#hd_id3150116.50.help.text"
msgid "Author"
msgstr "Հեղինակ"

#: 02230401.xhp#par_id3149960.51.help.text
#: 02230401.xhp%23par_id3149960.51.help.text
msgid ""
"<ahelp hid=\"HID_SORT_AUTHOR\">Sorts the list according to the "
"Author.</ahelp>"
msgstr ""
