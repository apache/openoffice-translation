msgstr ""
"<ahelp hid=\".\">Պահպանում է փոփոխված մուտքը տվյալների շտեմարանի "
"նիշքում։</ahelp>"

#: 06010601.xhp#par_idN105A1.help.text
#: 06010601.xhp%23par_idN105A1.help.text
msgctxt "06010601.xhp#par_idN105A1.help.text"
msgid "Delete"
msgstr "Ջնջել"

#: 06010601.xhp#par_idN105A5.help.text
#: 06010601.xhp%23par_idN105A5.help.text
msgid ""
"<ahelp hid=\".\">Removes the selected user-defined entry from the "
"dictionary.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Հեռացնում է օգտվողի կողմից որոշված ընտրված մուտքը "
"բառարանից:</ahelp>"

#: 01060000.xhp#tit.help.text
#: 01060000.xhp%23tit.help.text
msgctxt "01060000.xhp#tit.help.text"
msgid "Save"
msgstr "Պահպանել"

#: 01060000.xhp#hd_id3147000.5.help.text
#: 01060000.xhp%23hd_id3147000.5.help.text
msgid "<link href=\"text/shared/01/01060000.xhp\" name=\"Save\">Save</link>"
msgstr ""
"<link href=\"text/shared/01/01060000.xhp\" name=\"Պահպանել\">Պահպանել</link>"

#: 01060000.xhp#par_id3153255.1.help.text
#: 01060000.xhp%23par_id3153255.1.help.text
msgid "<ahelp hid=\".uno:Save\">Saves the current document.</ahelp>"
msgstr "<ahelp hid=\".uno:Save\">Պահում է ընթացիկ փաստաթուղթը:</ahelp>"

#: 01060000.xhp#par_id3152551.4.help.text
#: 01060000.xhp%23par_id3152551.4.help.text
msgid ""
"When you edit an AutoText entry, this command changes to <emph>Save "
"AutoText</emph>."
msgstr ""
"Երբ խմբագրում եք AutoText մուտքը, այս հրամանը փոխվում է <emph>Պահպանել "
"AutoText</emph> -ի։"

#: 01130000.xhp#tit.help.text
#: 01130000.xhp%23tit.help.text
msgctxt "01130000.xhp#tit.help.text"
msgid "Print"
msgstr "Տպել"

