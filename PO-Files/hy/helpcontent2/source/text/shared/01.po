#: 02040000.xhp%23par_id3153255.2.help.text
msgid ""
"<ahelp hid=\".uno:Cut\">Removes and copies the selection to the "
"clipboard.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:Cut\">Ընտրությունը հեռացնում և պատճենում է փոխանակաման "
"տիրույթ:</ahelp>"

#: gallery.xhp#tit.help.text
#: gallery.xhp%23tit.help.text
msgid "Gallery"
msgstr "Պատկերասրահ"

#: gallery.xhp#par_id3149783.46.help.text
#: gallery.xhp%23par_id3149783.46.help.text
msgid ""
"<ahelp hid=\"HID_GALLERY_ICONVIEW\" visibility=\"hidden\">Displays the "
"contents of the <emph>Gallery </emph>as icons.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_GALLERY_ICONVIEW\" visibility=\"hidden\">Ցուցադրում է <emph>"
"Պատկերասրահի </emph>բովանդակությունը որպես պատկերիկներ:</ahelp>"

#: gallery.xhp#par_id3148983.47.help.text
#: gallery.xhp%23par_id3148983.47.help.text
msgid ""
"<ahelp hid=\"HID_GALLERY_LISTVIEW\" visibility=\"hidden\">Displays the "
"contents of the <emph>Gallery </emph>as small icons, with title and path "
"information.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_GALLERY_LISTVIEW\" visibility=\"hidden\">Ցուցադրում է <emph>"
"Պատկերասրահի </emph>բովանդակությունը որպես փոքրիկ պատկերիկներ, վերնագրի և "
"ուղու տեղեկատվությամբ։</ahelp>"

#: gallery.xhp#hd_id3153894.1.help.text
#: gallery.xhp%23hd_id3153894.1.help.text
msgid ""
"<link href=\"text/shared/01/gallery.xhp\" name=\"Gallery\">Gallery</link>"
msgstr ""
"<link href=\"text/shared/01/gallery.xhp\" name=\"Պատկերասրահ\""
">Պատկերասրահ</link>"

#: gallery.xhp#par_id3150789.2.help.text
#: gallery.xhp%23par_id3150789.2.help.text
msgid ""
"<ahelp hid=\".uno:Gallery\">Opens the <emph>Gallery</emph>, where you can "
"select graphics and sounds to insert into your document.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:Gallery\">Բացում է <emph>Պատկերասրահը</emph>, որտեղ կարող "
"եք ընտրել գրաֆիկները և հնչյունները՝ ձեր փաստաթղթում մտցնելու համար:</ahelp>"

#: gallery.xhp#par_id3155555.44.help.text
#: gallery.xhp%23par_id3155555.44.help.text
msgid ""
"You can display the contents of the <emph>Gallery </emph>as icons, or icons "
"with titles and path information."
msgstr ""
"Կարող եք ցուցադրել <emph>Պատկերասրահի </emph>բովանդակությունը որպես "
"պատկերիկներ, կամ պատկերակներ իրենց վերնագրերով և ուղու տեղեկություններով:"

#: gallery.xhp#par_id3153394.45.help.text
#: gallery.xhp%23par_id3153394.45.help.text
msgid ""
"To zoom in or zoom out on a single object in the <emph>Gallery</emph>, "
"double-click the object, or select the object, and then press the Spacebar."
msgstr ""
"<emph>Պատկերասրահում </emph> առանձին օբյեկտը փոքրացնելու կամ մեծացնելու "
"համար, կրկնակի կտտացրեք օբյեկտը կամ ընտրեք օբյեկտը, ապա սեղմեք Spacebar:"

#: gallery.xhp#par_id3145346.26.help.text
#: gallery.xhp%23par_id3145346.26.help.text
msgid ""
"Themes are listed on the left side of the <emph>Gallery</emph>.<ahelp hid=\""
"HID_GALLERY_THEMELIST\">Click a theme to view the objects associated with "
"the theme.</ahelp>"
msgstr ""
"Թեմաները թվարկված են <emph>Պատկերասրահի</emph>ձախ մասում։<ahelp hid=\""
"HID_GALLERY_THEMELIST\">Կտտացրեք թեման՝ թեմայի հետ կապված օբյեկտները դիտելու "
"համար:</ahelp>"

#: gallery.xhp#par_id3155355.50.help.text
#: gallery.xhp%23par_id3155355.50.help.text
msgid ""
"<ahelp hid=\"HID_GALLERY_WINDOW\">To insert a <emph>Gallery </emph>object, "
"select the object, and then drag it into the document.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_GALLERY_WINDOW\">Ներդնելու համար <emph>Պատկերասրահի </emph>"
"օբյեկտը, ընտրեք օբյեկտը, ապա քաշեք այն փաստաթղթի մեջ:</ahelp>"

#: gallery.xhp#hd_id3156113.4.help.text
#: gallery.xhp%23hd_id3156113.4.help.text
msgid "Adding a New File to the Gallery"
msgstr "Նոր նիշքի ավելացում Պատկերասրահին"

#: gallery.xhp#par_id3153032.43.help.text
#: gallery.xhp%23par_id3153032.43.help.text
msgid ""
"To add a file to the <emph>Gallery</emph>, right-click a theme, choose "
"<emph>Properties</emph>, click the <emph>Files </emph>tab, and then click "
"<emph>Add</emph>. You can also click an object in the current document, "
"hold, and then drag it to the <emph>Gallery</emph> window."
msgstr ""
"Նիշք ավելացնելու համար <emph>Պատկերասրահին</emph>, աջ կտտացրեք թեման, ընտրեք "
"<emph>Հատկություններ</emph>, կտտացրեք <emph>Նիշքեր </emph>ներդիրը, ապա "
"կտտացրեք <emph>Ավելացնել</emph>։ Կարող եք նաև կտտացնել որևէ առարկա ընթացիկ "
"փաստաթղթում, պահել, այնուհետև քաշել այն <emph>Պատկերասրահ</emph> պատուհան:"

#: gallery.xhp#hd_id3145315.10.help.text
#: gallery.xhp%23hd_id3145315.10.help.text
msgid "New theme"
msgstr "Նոր թեմա"

#: gallery.xhp#par_id3150275.11.help.text
#: gallery.xhp%23par_id3150275.11.help.text
msgid ""
"<ahelp hid=\"HID_GALLERY_NEWTHEME\">Adds a new theme to the <emph>Gallery "
"</emph>and lets you choose the files to include in the theme.</ahelp>."
msgstr ""
"<ahelp hid=\"HID_GALLERY_NEWTHEME\">Նոր թեմա է ավելացնում <emph>"
"Պատկերասրահին </emph> և թույլ է տալիս ընտրել այն նիշքերը, որոնք ներառվելու "
"են թեմայում:</ahelp>."

#: gallery.xhp#par_id3159167.9.help.text
#: gallery.xhp%23par_id3159167.9.help.text
msgid ""
"To access the following commands, right-click a theme in the "
"<emph>Gallery</emph>:"
msgstr ""
"Հետևյալ հրահանգներին մուտք գործելու համար աջ սեղմեք թեման "
"<emph>Պատկերասրահում</emph>:"

#: gallery.xhp#hd_id3154142.15.help.text
#: gallery.xhp%23hd_id3154142.15.help.text
msgctxt "gallery.xhp#hd_id3154142.15.help.text"
msgid "Properties"
msgstr "Հատկություններ"

#: gallery.xhp#par_id3148990.16.help.text
#: gallery.xhp%23par_id3148990.16.help.text
msgid ""
"The <emph>Properties of (Theme)</emph> dialog contains the following tabs:"
msgstr ""
"<emph>Հատկություններ (Թեմայի)</emph> երկխոսությունը պարունակում է հետևյալ "
"ներդիրները։"

#: gallery.xhp#hd_id3151384.25.help.text
#: gallery.xhp%23hd_id3151384.25.help.text
msgid ""
"<link href=\"text/shared/01/gallery_files.xhp\" name=\"Files\">Files</link>"
msgstr ""
"<link href=\"text/shared/01/gallery_files.xhp\" name=\"Նիշքեր\">Նիշքեր</link>"

