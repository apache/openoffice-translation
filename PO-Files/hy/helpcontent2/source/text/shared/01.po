msgctxt "05210300.xhp#hd_id3150772.19.help.text"
msgid "Modify"
msgstr "Փոփոխել"

#: 05210300.xhp#par_id3147573.20.help.text
#: 05210300.xhp%23par_id3147573.20.help.text
msgid ""
"<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_GRADIENT:BTN_MODIFY\">Applies the "
"current gradient properties to the selected gradient. If you want, you can "
"save the gradient under a different name.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_GRADIENT:BTN_MODIFY\">Կիրառում է "
"ընթացիկ գրադիենտային հատկությունները ընտրված գրադիենտին: Եթե ցանկանում եք, "
"կարող եք գրադիենտը պահել այլ անվան տակ:</ahelp>"

#: 05210300.xhp#hd_id3155341.31.help.text
#: 05210300.xhp%23hd_id3155341.31.help.text
msgid "Load Gradients List"
msgstr "Բեռնավորեք գրադիենտների ցուցակը"

#: 05210300.xhp#par_id3145085.32.help.text
#: 05210300.xhp%23par_id3145085.32.help.text
msgid ""
"<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_GRADIENT:BTN_LOAD\">Load a "
"different list of gradients.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_GRADIENT:BTN_LOAD\">Բեռնավորեք "
"գրադիենտների այլ ցանկ.</ahelp>"

#: 05210300.xhp#hd_id3148943.33.help.text
#: 05210300.xhp%23hd_id3148943.33.help.text
msgid "Save Gradients List"
msgstr "Պահպանեք գրադիենտների ցուցակը"

#: 05210300.xhp#par_id3161459.34.help.text
#: 05210300.xhp%23par_id3161459.34.help.text
msgid ""
"<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_GRADIENT:BTN_SAVE\">Saves the "
"current list of gradients, so that you can load it later.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_GRADIENT:BTN_SAVE\">Պահպանում է "
"գրադիենտների ներկա ցուցակը, այնպես որ այն կարող եք ավելի ուշ բեռնել:</ahelp>"

