msgid "Save In"
msgstr "Պահպանել"

#: 06140500.xhp#par_idN1060E.help.text
#: 06140500.xhp%23par_idN1060E.help.text
msgid ""
"<ahelp hid=\"705547787\">Select first where to save the event binding, in "
"the current document or in %PRODUCTNAME.</ahelp>"
msgstr ""
"<ahelp hid=\"705547787\">Ընտրեք նախ, որտեղ պահպանել իրադարձության կապը՝ "
"ներկայիս փաստաթղթում կամ %PRODUCTNAME -ում։</ahelp>"

#: 06140500.xhp#par_id3153662.36.help.text
#: 06140500.xhp%23par_id3153662.36.help.text
msgid ""
"A macro that is saved with a document can only be run when that document is "
"opened."
msgstr ""
"Մակրոն, որը պահպանվում է փաստաթղթի հետ, կարող է գործարկվել միայն այդ "
"փաստաթղթի բացման դեպքում:"

#: 06140500.xhp#par_idN1061A.help.text
#: 06140500.xhp%23par_idN1061A.help.text
msgid ""
"<ahelp hid=\"40000\">The big list box lists the events and the assigned "
"macros. After you selected the location in the <emph>Save In</emph> list "
"box, select an event in the big list box. Then click <emph>Assign "
"Macro</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\"40000\">Ցուցակի մեծ վանդակը թվարկում է իրադարձությունները և "
"նշանակված մակրոները: Տեղակայումը <emph>Պահպանել</emph> ցուցակային վանդակում "
"ընտրելուց հետո, ընտրեք իրադարձությունը մեծ ցուցակի վանդակում: Այնուհետև "
"կտտացրեք <emph>Նշանակեք մակրո</emph>։</ahelp>"

#: 06140500.xhp#hd_id3159258.22.help.text
#: 06140500.xhp%23hd_id3159258.22.help.text
msgid "Assign Macro"
msgstr "Նշանակեք մակրո"

