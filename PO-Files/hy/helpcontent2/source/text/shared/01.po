msgstr "Դիրք"

#: 05030600.xhp#par_id3153741.28.help.text
#: 05030600.xhp%23par_id3153741.28.help.text
msgid ""
"<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_BACKGROUND:BTN_POSITION\">Select "
"this option, and then click a location in the position grid.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_BACKGROUND:BTN_POSITION\">Ընտրեք "
"այս տարբերակը, այնուհետև կտտացրեք տեղաբաշխումը դիրքի ցանցում:</ahelp>"

