"filter.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_XML_FILTER_NEW\">Նոր զտիչի անվանմամբ երկխոսություն է "
"բացվում:</ahelp>"

#: 06150000.xhp#hd_id3143270.19.help.text
#: 06150000.xhp%23hd_id3143270.19.help.text
msgctxt "06150000.xhp#hd_id3143270.19.help.text"
msgid "Edit"
msgstr "Խմբագրել"

#: 06150000.xhp#par_id3156192.20.help.text
#: 06150000.xhp%23par_id3156192.20.help.text
