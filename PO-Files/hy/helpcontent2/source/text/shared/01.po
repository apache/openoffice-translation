msgstr "Գաղտնաբառ"

#: password_dlg.xhp#par_id3150502.62.help.text
#: password_dlg.xhp%23par_id3150502.62.help.text
msgid ""
"<ahelp hid=\"HID_PASSWD_TABLE\">Type a password. A password is case "
"sensitive.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_PASSWD_TABLE\">Մուտքագրեք գաղտնաբառ: Գաղտնաբառը ընտրությանը "
"զգայուն է:</ahelp>"

#: password_dlg.xhp#hd_id3153029.66.help.text
#: password_dlg.xhp%23hd_id3153029.66.help.text
msgctxt "password_dlg.xhp#hd_id3153029.66.help.text"
msgid "Confirm"
msgstr "Հաստատել"

#: password_dlg.xhp#par_id3151100.67.help.text
#: password_dlg.xhp%23par_id3151100.67.help.text
msgctxt "password_dlg.xhp#par_id3151100.67.help.text"
msgid "<ahelp hid=\".\">Re-enter the password.</ahelp>"
msgstr "<ahelp hid=\".\">Նորից մուտքագրեք գաղտնաբառը։</ahelp>"

#: password_dlg.xhp#hd_id3155351.68.help.text
#: password_dlg.xhp%23hd_id3155351.68.help.text
msgid "Undoing password protection"
msgstr "Հանել գաղտնաբառի պաշտպանությունը։"

#: password_dlg.xhp#par_id3146109.69.help.text
#: password_dlg.xhp%23par_id3146109.69.help.text
msgid "To remove a password, open the document, then save without password."
msgstr ""
"Գաղտնաբառը հեռացնելու համար բացեք փաստաթուղթը, այնուհետև պահպանեք առանց "
"գաղտնաբառի:"

#: password_dlg.xhp#par_id31323250502.help.text
#: password_dlg.xhp%23par_id31323250502.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Click to show or hide the file "
"sharing password options.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Կտտացրեք՝ նիշքերի փոխանակման "
"գաղտնաբառի ընտրանքները ցուցադրելու կամ թաքցնելու համար:</ahelp>"

#: 02200000.xhp#tit.help.text
#: 02200000.xhp%23tit.help.text
msgid "Object"
msgstr "Օբյեկտ"

#: 02200000.xhp#hd_id3146959.1.help.text
#: 02200000.xhp%23hd_id3146959.1.help.text
msgid ""
"<link href=\"text/shared/01/02200000.xhp\" name=\"Object\">Object</link>"
msgstr ""
"<link href=\"text/shared/01/02200000.xhp\" name=\"Օբյեկտ\">Օբյեկտ</link>"

#: 02200000.xhp#par_id3154840.2.help.text
#: 02200000.xhp%23par_id3154840.2.help.text
msgid ""
"<ahelp hid=\".uno:ObjectMenue\">Lets you edit a selected object in your file "
"that you inserted with the <emph>Insert - Object </emph>command.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ObjectMenue\">Հնարավորություն է տալիս խմբագրելու ձեր "
"նիշքում ընտրված օբյեկտը , որը դուք տեղադրել եք <emph>Տեղադրել - Օբյեկտ "
"</emph>հրամանով։</ahelp>"

#: 02200000.xhp#par_id3153551.help.text
#: 02200000.xhp%23par_id3153551.help.text
msgid ""
"<link href=\"text/shared/01/04150000.xhp\" name=\"Insert - Object\">Insert - "
"Object</link>"
msgstr ""
"<link href=\"text/shared/01/04150000.xhp\" name=\"Տեղադրել - Օբյեկտ\">"
"Տեղադրել - Օբյեկտ</link>"

#: 02200000.xhp#par_id1717886.help.text
#: 02200000.xhp%23par_id1717886.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Resizes the object to the original "
"size.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Չափափոխում է օբյեկտը սկզբնական "
"չափի:</ahelp>"

#: 03170000.xhp#tit.help.text
#: 03170000.xhp%23tit.help.text
msgid "Color Bar"
msgstr "Գույնի վահանակ"

#: 03170000.xhp#bm_id3147477.help.text
#: 03170000.xhp%23bm_id3147477.help.text
msgid ""
"<bookmark_value>color bar</bookmark_value><bookmark_value>paint "
"box</bookmark_value>"
msgstr ""
"<bookmark_value>color bar</bookmark_value><bookmark_value>paint "
"box</bookmark_value>"

#: 03170000.xhp#hd_id3147477.1.help.text
#: 03170000.xhp%23hd_id3147477.1.help.text
msgid ""
"<link href=\"text/shared/01/03170000.xhp\" name=\"Color Bar\">Color "
"Bar</link>"
msgstr ""
"<link href=\"text/shared/01/03170000.xhp\" name=\"Գույնի վահանակ\">Գույնի "
"վահանակ</link>"

#: 03170000.xhp#par_id3153255.2.help.text
#: 03170000.xhp%23par_id3153255.2.help.text
msgid ""
"<ahelp hid=\".uno:ColorControl\">Show or hides the <emph>Color Bar</emph>. "
"To modify or change the color table that is displayed, choose <emph>Format - "
"Area</emph>, and then click on the <emph>Colors</emph> tab.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ColorControl\">Ցույց է տալիս կամ թաքցնում է <emph>Գույնի "
"վահանակը</emph>։ Ցուցադրվող գունային աղյուսակը փոփոխելու կամ փոխելու համար "
"ընտրեք <emph>Ձևաչափ - Տիրույթ</emph>, և ապա սեղմեք <emph>Գույներ</emph> "
"ներդիրը։</ahelp>"

#: 03170000.xhp#par_id3154186.3.help.text
#: 03170000.xhp%23par_id3154186.3.help.text
msgid ""
"<ahelp hid=\"HID_COLOR_CTL_COLORS\">Click the color that you want to use. To "
"change the fill color of an object in the current file, select the object "
"and then click a color. To change the line color of the selected object, "
"right-click a color. To change the color of text in a text object, double-"
"click the text-object, select the text, and then click a color.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_COLOR_CTL_COLORS\">Կտտացրեք այն գույնը, որը ցանկանում եք "
"օգտագործել: Ընթացիկ նիշքում առարկայի լրացման գույնը փոխելու համար ընտրեք "
"օբյեկտը, ապա կտտացրեք գույնը: Ընտրված օբյեկտի տողի գույնը փոխելու համար աջ "
"կտտացրեք գույնի վրա: Տեքստային օբյեկտում տեքստի գույնը փոխելու համար երկու "
"անգամ սեղմեք տեքստի օբյեկտը, ընտրեք տեքստը, ապա կտտացրեք մի գույն:</ahelp>"

#: 03170000.xhp#par_id3147399.9.help.text
#: 03170000.xhp%23par_id3147399.9.help.text
msgid ""
"You can also drag a color from the <emph>Color Bar</emph> and drop it on a "
"draw object on your slide."
msgstr ""
"Կարող եք նաև գույնը քաշել <emph>Գույնի վահանակից</emph> և այն գցել ձեր "
"սահիկի նկարվող օբյեկտի վրա:"

#: 03170000.xhp#par_id3147009.7.help.text
#: 03170000.xhp%23par_id3147009.7.help.text
msgid ""
"To detach the <emph>Color Bar</emph>, click on a gray area of the toolbar "
"and then drag. To reattach the <emph>Color Bar</emph>, drag the title bar of "
"the toolbar to the edge of the window."
msgstr ""
"<emph>Գույնի սանդղակը</emph> անջատելու համար կտտացրեք գործիքագոտու գորշ "
"գոտին և ապա քաշեք: <emph>Գույնի սանդղակը</emph> վերստին կապելու համար քաշեք "
"գործիքագոտու վերնագրի գիծը պատուհանի եզրին:"

#: 03990000.xhp#tit.help.text
#: 03990000.xhp%23tit.help.text
msgctxt "03990000.xhp#tit.help.text"
msgid "Toolbars"
msgstr "Գործիքաշարներ"

#: 03990000.xhp#hd_id3160463.1.help.text
#: 03990000.xhp%23hd_id3160463.1.help.text
msgid ""
"<link href=\"text/shared/01/03990000.xhp\" name=\"Toolbars\">Toolbars</link>"
msgstr ""
"<link href=\"text/shared/01/03990000.xhp\" name=\"Գործիքաշարներ\""
">Գործիքաշարներ</link>"

#: 03990000.xhp#par_id3149748.2.help.text
#: 03990000.xhp%23par_id3149748.2.help.text
msgid ""
"<ahelp hid=\".\">Opens a submenu to show and hide toolbars.</ahelp> A "
"toolbar contains icons and options that let you quickly access $[officename] "
"commands."
msgstr ""
"<ahelp hid=\".\">Բացվում է ենթաընտրացանկը, գործիքագոտիները ցուցադրելու և "
"թաքցնելու համար:</ahelp> Գործիքադարակը պարունակում է պատկերիկներ և "
"ընտրանքներ, որոնք թույլ են տալիս արագ մուտք գործել $[officename] հրամաններ:"

#: 03990000.xhp#hd_id3153683.3.help.text
#: 03990000.xhp%23hd_id3153683.3.help.text
msgid ""
"<link href=\"text/shared/guide/edit_symbolbar.xhp\" name=\"Customize\""
">Customize</link>"
msgstr ""
"<link href=\"text/shared/guide/edit_symbolbar.xhp\" name=\"Անհատականացնել\""
">Անհատականացնել</link>"

#: 03990000.xhp#par_id2789086.help.text
#: 03990000.xhp%23par_id2789086.help.text
msgid "Opens a dialog where you can add, edit, and remove icons."
msgstr ""
"Բացվում է երկխոսություն, որտեղ կարող եք ավելացնել, խմբագրել և հեռացնել "
"պատկերիկները:"

#: 03990000.xhp#hd_id371715.help.text
#: 03990000.xhp%23hd_id371715.help.text
msgctxt "03990000.xhp#hd_id371715.help.text"
msgid "Reset"
msgstr "Վերականգնել"

#: 03990000.xhp#par_id1886654.help.text
#: 03990000.xhp%23par_id1886654.help.text
msgid ""
"<ahelp hid=\".\">Choose <emph>View - Toolbars - Reset</emph> to reset the "
"toolbars to their default context sensitive behavior. Now some toolbars will "
"be shown automatically, dependent on the context.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք <emph>Դիտել - Գործիքադարակներ - Վերագրել</emph> "
"գործիքագոտիները վերափոխելու իրենց նախնական համատեքստի զգայուն պահվածքին: "
"Այժմ որոշ գործիքագոտիներ կցուցադրվեն ինքնաբերաբար՝ կախված "
"ենթատեքստից:</ahelp>"

#: 05100500.xhp#tit.help.text
#: 05100500.xhp%23tit.help.text
msgctxt "05100500.xhp#tit.help.text"
msgid "Top"
msgstr "Վերին մաս"

#: 05100500.xhp#hd_id3154765.1.help.text
#: 05100500.xhp%23hd_id3154765.1.help.text
msgid "<link href=\"text/shared/01/05100500.xhp\" name=\"Top\">Top</link>"
msgstr ""
"<link href=\"text/shared/01/05100500.xhp\" name=\"Վերին մաս\">Վերին "
"մաս</link>"

#: 05100500.xhp#par_id3151390.2.help.text
#: 05100500.xhp%23par_id3151390.2.help.text
msgid ""
"<ahelp hid=\".uno:CellVertTop\">Aligns the contents of the cell to the top "
"edge of the cell.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:CellVertTop\">Բջջի պարունակությունը հավասարեցնում է բջիջի "
"վերին եզրին:</ahelp>"

#: 05100500.xhp#par_id3145671.120.help.text
#: 05100500.xhp%23par_id3145671.120.help.text
msgid ""
"<variable id=\"zelleoben\">In the context menu of a cell, choose <emph>Cell -"
" Top</emph></variable>"
msgstr ""
"<variable id=\"zelleoben\">Բջջի համատեքստի ընտրացանկում, ընտրեք <emph>Բջիջ - "
"Վերին մաս</emph></variable>"

#: 01010301.xhp#tit.help.text
#: 01010301.xhp%23tit.help.text
msgid "Medium"
msgstr "Միջոց"

#: 01010301.xhp#hd_id3148765.1.help.text
#: 01010301.xhp%23hd_id3148765.1.help.text
msgid ""
"<link href=\"text/shared/01/01010301.xhp\" name=\"Medium\">Medium</link>"
msgstr "<link href=\"text/shared/01/01010301.xhp\" name=\"Միջոց\">Միջոց</link>"

#: 01010301.xhp#par_id3150278.2.help.text
#: 01010301.xhp%23par_id3150278.2.help.text
msgid ""
"<ahelp hid=\".\">Select the size of your business card from a number of pre-"
"defined size formats, or a size format that you specify on the <emph>Format "
"</emph>tab.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք ձեր այցեքարտի չափը նախորոշված չափի մի շարք "
"ձևաչափերից կամ այն չափի ձևաչափից, որը դուք նշում եք <emph>Ձևաչափ "
"</emph>ներդիրում։</ahelp>"

#: 01010301.xhp#hd_id3149991.3.help.text
#: 01010301.xhp%23hd_id3149991.3.help.text
msgctxt "01010301.xhp#hd_id3149991.3.help.text"
msgid "Format"
msgstr "Ձևաչափ"

#: 01010301.xhp#par_id3147543.4.help.text
#: 01010301.xhp%23par_id3147543.4.help.text
msgid "Select a size format for your business card."
msgstr "Ընտրեք չափի ձևաչափը ձեր այցեքարտի համար:"

#: 01010301.xhp#hd_id3160463.5.help.text
#: 01010301.xhp%23hd_id3160463.5.help.text
msgctxt "01010301.xhp#hd_id3160463.5.help.text"
msgid "Continuous"
msgstr "Անընդհատ"

#: 01010301.xhp#par_id3150279.6.help.text
#: 01010301.xhp%23par_id3150279.6.help.text
msgid ""
"<ahelp hid=\"HID_BUSINESS_FMT_PAGE_CONT\">Prints business cards on "
"continuous paper.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_BUSINESS_FMT_PAGE_CONT\">Տպում է այցեքարտերը շարունակական "
"թղթի վրա:</ahelp>"

#: 01010301.xhp#hd_id3154840.7.help.text
#: 01010301.xhp%23hd_id3154840.7.help.text
msgctxt "01010301.xhp#hd_id3154840.7.help.text"
msgid "Sheet"
msgstr "Թերթիկ"

#: 01010301.xhp#par_id3148731.8.help.text
#: 01010301.xhp%23par_id3148731.8.help.text
msgid ""
"<ahelp hid=\"HID_BUSINESS_FMT_PAGE_SHEET\">Prints business cards on "
"individual sheets.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_BUSINESS_FMT_PAGE_SHEET\">Տպում է այցեքարտերը առանձին "
"թերթերով:</ahelp>"

#: 01010301.xhp#hd_id3154894.9.help.text
#: 01010301.xhp%23hd_id3154894.9.help.text
msgctxt "01010301.xhp#hd_id3154894.9.help.text"
msgid "Brand"
msgstr "Ապրանքանիշ"

#: 01010301.xhp#par_id3155351.10.help.text
#: 01010301.xhp%23par_id3155351.10.help.text
msgid ""
"<ahelp hid=\"HID_BUSINESS_FMT_PAGE_BRAND\">Select the brand of paper that "
"you want to use.</ahelp> Each brand has its own size formats."
msgstr ""
"<ahelp hid=\"HID_BUSINESS_FMT_PAGE_BRAND\">Ընտրեք թղթի ապրանքանիշը, որը "
"ցանկանում եք օգտագործել:</ahelp> Յուրաքանչյուր ապրանքանիշ ունի իր չափսի "
"ձևաչափերը:"

#: 01010301.xhp#hd_id3153935.11.help.text
#: 01010301.xhp%23hd_id3153935.11.help.text
msgctxt "01010301.xhp#hd_id3153935.11.help.text"
msgid "Type"
msgstr "Տեսակ"

#: 01010301.xhp#par_id3159201.12.help.text
#: 01010301.xhp%23par_id3159201.12.help.text
msgid ""
"<ahelp hid=\"HID_BUSINESS_FMT_PAGE_TYPE\">Select the size format that you "
"want to use. The available formats depend on what you selected in the "
"<emph>Brand</emph> list. If you want to use a custom size format, select "
"<emph>[User]</emph>, and then click the <link href=\"text/shared/01/01010202."
"xhp\" name=\"Format\"><emph>Format</emph></link> tab to define the "
"format.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_BUSINESS_FMT_PAGE_TYPE\">Ընտրեք չափի ձևաչափը, որը ցանկանում "
"եք օգտագործել: Առկա ձևաչափերը կախված են այն բանից, թե ինչն եք ընտրել "
"<emph>Ապրանքանիշ</emph> ցուցակում: Եթե ցանկանում եք օգտագործել հատուկ չափի "
"ձևաչափ, ընտրեք <emph>[User]</emph>, և ապա կտտացրեք <link href=\""
"text/shared/01/01010202.xhp\" name=\"Ձևաչափ\"><emph>Ձևաչափ</emph></link> "
"ներդիրը, ձևաչափը սահմանելու համար։</ahelp>"

#: 01010301.xhp#hd_id3147226.13.help.text
#: 01010301.xhp%23hd_id3147226.13.help.text
msgctxt "01010301.xhp#hd_id3147226.13.help.text"
