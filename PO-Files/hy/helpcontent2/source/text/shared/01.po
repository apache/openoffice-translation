"<switchinline select=\"appl\"><caseinline select=\"CALC\">Բջիջների քանակը: "
"</caseinline></switchinline>"

#: 01100400.xhp#par_id3156114.31.help.text
#: 01100400.xhp%23par_id3156114.31.help.text
msgid ""
"<switchinline select=\"appl\"><caseinline select=\"CALC\">Number of cells "
"with content in the file. </caseinline></switchinline>"
msgstr ""
"<switchinline select=\"appl\"><caseinline select=\"CALC\">Նիշքում "
"պարունակվող բջիջների քանակը: </caseinline></switchinline>"

