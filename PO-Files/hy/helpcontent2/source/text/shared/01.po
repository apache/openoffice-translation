msgid ""
"<ahelp hid=\".uno:FillShadow\">Adds a shadow to the selected object. If the "
"object already has a shadow, the shadow is removed. If you click this icon "
"when no object is selected, the shadow is added to the next object that you "
"draw.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:FillShadow\">Ընտրված օբյեկտին ստվեր է ավելացնում: Եթե "
"օբյեկտն արդեն ունի ստվեր, ապա ստվերը հանվում է: Եթե կտտացնեք այս պատկերակը, "
"երբ որևէ առարկա ընտրված չէ, ստվերն ավելացվում է ձեր նկարած հաջորդ օբյեկտի "
"վրա:</ahelp>"

#: 05210600.xhp#par_id3145068.help.text
#: 05210600.xhp%23par_id3145068.help.text
