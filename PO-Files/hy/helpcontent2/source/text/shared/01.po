"<emph>seconds</emph> box. To observe the result, open the page in a "
"browser.</ahelp>"
msgstr ""
"<ahelp hid=\"SFX2_RADIOBUTTON_TP_DOCINFORELOAD_RB_RELOADUPDATE\">Վերաբեռնում "
"է HTML էջը այն վայրկյաններից հետո, որը կմուտքագրեք <emph>վայրկյաններ</emph> "
"վանդակում: Արդյունքը դիտելու համար բացեք էջը զննարկիչում:</ahelp>"

#: 01100500.xhp#hd_id3155535.7.help.text
#: 01100500.xhp%23hd_id3155535.7.help.text
msgid "Seconds"
msgstr "Վայրկյաններ"

