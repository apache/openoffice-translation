msgstr ""
"<link href=\"text/shared/01/xformsdatatab.xhp\">Տվյալներ (XML ձևի "
"փաստաթղթերի համար)</link>"

#: xformsdatatab.xhp#par_id1161534.help.text
#: xformsdatatab.xhp%23par_id1161534.help.text
msgid ""
"The Data tab page of the Properties dialog for an XML Form document offers "
"some XML forms settings."
msgstr ""
"XML Ձևաթղթի փաստաթղթի համար Հատկություններ երկխոսության տվյալների էջանիշը "
"առաջարկում է XML ձևերի մի քանի կարգաբերումներ:"

#: xformsdatatab.xhp#par_id3994567.help.text
#: xformsdatatab.xhp%23par_id3994567.help.text
msgid ""
"The possible settings of the <emph>Data</emph> tab page of a control depend "
"on the respective control. You will only see the options that are available "
"for the current control and context. The following fields are available:"
msgstr ""
"Հնարավոր կարգաբերումները <emph>Տվյալներ</emph> վերահսկման ներդիրի էջի համար "
"կախված են համապատասխան հսկողությունից։ Դուք կտեսնեք միայն այն տարբերակները, "
"որոնք առկա են ներկայիս հսկողության մեջ և համատեքստում: Հասանելի են հետևյալ "
"դաշտերը."

#: xformsdatatab.xhp#hd_id9461653.help.text
#: xformsdatatab.xhp%23hd_id9461653.help.text
msgid "XML data model"
msgstr "XML տվյալների մոդել"

