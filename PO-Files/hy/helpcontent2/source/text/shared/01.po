msgid "Business data"
msgstr "Բիզնես տվյալներ"

#: 01010304.xhp#par_id3156027.4.help.text
#: 01010304.xhp%23par_id3156027.4.help.text
msgid ""
"Enter the contact information that you want to include on your business card."
msgstr ""
"Մուտքագրեք այն կոնտակտային տվյալները, որոնք ցանկանում եք ներառել ձեր "
"այցեքարտում:"

