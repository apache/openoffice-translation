#: 02100000.xhp%23hd_id3149065.72.help.text
msgctxt "02100000.xhp#hd_id3149065.72.help.text"
msgid "Replace"
msgstr "Փոխարինել"

#: 02100000.xhp#par_id3151170.73.help.text
#: 02100000.xhp%23par_id3151170.73.help.text
