msgctxt "05070100.xhp#tit.help.text"
msgid "Align Left"
msgstr "Հավասարեցրու ձախ"

#: 05070100.xhp#hd_id3147069.1.help.text
#: 05070100.xhp%23hd_id3147069.1.help.text
msgid ""
"<link href=\"text/shared/01/05070100.xhp\" name=\"Align Left\">Align "
"Left</link>"
msgstr ""
"<link href=\"text/shared/01/05070100.xhp\" name=\"Հավասարեցրու ձախ\">"
"Հավասարեցրու ձախ</link>"

#: 05070100.xhp#par_id3160463.2.help.text
#: 05070100.xhp%23par_id3160463.2.help.text
msgid ""
"<ahelp hid=\".uno:ObjectAlignLeft\">Aligns the left edges of the selected "
"objects. If only one object is selected in Draw or Impress, the left edge of "
"the object is aligned to the left page margin.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ObjectAlignLeft\">Հավասարեցնում է ընտրված օբյեկտների ձախ "
"եզրերը: Եթե Draw կամ Impress -ում ընտրված է միայն մեկ առարկա, ապա օբյեկտի "
"ձախ եզրը հավասարեցվում է ձախ էջի լուսանցքին:</ahelp>"

#: 05070100.xhp#par_id3150146.4.help.text
#: 05070100.xhp%23par_id3150146.4.help.text
msgid ""
"Objects are aligned to the left edge of the leftmost object in the selection."
msgstr "Ընտրությունում օբեկտները հավասարեցված են ամենաձախ օբյեկտի ձախ եզրին:"

#: 05070100.xhp#par_id3150445.3.help.text
#: 05070100.xhp%23par_id3150445.3.help.text
msgid ""
"<variable id=\"mehrfachselektion\">To align the individual objects in a "
"group, <switchinline select=\"appl\"><caseinline select=\"CALC\">choose "
"<emph>Format - Group - Edit Group</emph></caseinline><defaultinline>double-"
"click</defaultinline></switchinline> to enter the group, select the objects, "
"right-click, and then choose an alignment option. </variable>"
msgstr ""
"<variable id=\"mehrfachselektion\">Անհատական առարկաները խմբով հավասարեցնելու "
"համար, <switchinline select=\"appl\"><caseinline select=\"CALC\">ընտրեք "
"<emph>Ձևաչափ - Խումբ - Խմբագրել խումբը</emph></caseinline><defaultinline>"
"կրկնակի կտտացրեք</defaultinline></switchinline> խումբ մտնելու համար ընտրեք "
"օբյեկտները, սեղմեք աջ և ապա ընտրեք հավասարեցման տարբերակը: </variable>"

#: securitywarning.xhp#tit.help.text
#: securitywarning.xhp%23tit.help.text
msgid "Security Warning"
msgstr "Անվտանգության Զգուշացում"

#: securitywarning.xhp#bm_id6499832.help.text
#: securitywarning.xhp%23bm_id6499832.help.text
msgid ""
"<bookmark_value>security;warning dialogs with "
"macros</bookmark_value><bookmark_value>macros;security warning "
"dialog</bookmark_value>"
msgstr ""
"<bookmark_value>security;warning dialogs with "
"macros</bookmark_value><bookmark_value>macros;security warning "
"dialog</bookmark_value>"

#: securitywarning.xhp#par_idN1054D.help.text
#: securitywarning.xhp%23par_idN1054D.help.text
msgid ""
"<variable id=\"securitywarning\"><link href=\"text/shared/01/securitywarning."
"xhp\">Security Warning</link></variable>"
msgstr ""
"<variable id=\"securitywarning\"><link href=\"text/shared/01/securitywarning."
"xhp\">Անվտանգության Զգուշացում</link></variable>"

#: securitywarning.xhp#par_idN1056B.help.text
#: securitywarning.xhp%23par_idN1056B.help.text
msgid ""
"When you open a document that contains an unsigned macro, or a signed macro "
"from an unknown source, the <emph>Security Warning</emph> dialog opens."
msgstr ""
"Երբ բացում եք փաստաթուղթը, որը պարունակում է չստորագրված մակրո կամ անհայտ "
"աղբյուրից ստորագրված մակրո, բացվում է <emph>Անվտանգության նախազգուշացում "
"</emph> երկխոսությունը:"

#: securitywarning.xhp#par_idN105FC.help.text
#: securitywarning.xhp%23par_idN105FC.help.text
msgid ""
"<ahelp hid=\".\">Enable or disable the macros. Choose <emph>%PRODUCTNAME - "
"Security</emph> in the Options dialog box to set the options.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Միացնել կամ անջատել մակրոները: Ընտրեք Տարբերակներ "
"երկխոսության վանդակում <emph>%PRODUCTNAME - Անվտանգություն</emph> "
"ընտրանքները կարգաբերելու համար:</ahelp>"

#: securitywarning.xhp#par_idN1056E.help.text
#: securitywarning.xhp%23par_idN1056E.help.text
msgid "View Signature"
msgstr "Դիտեք ստորագրությունը"

#: securitywarning.xhp#par_idN10572.help.text
#: securitywarning.xhp%23par_idN10572.help.text
msgid ""
"<ahelp hid=\".\">Opens a dialog where you can view the signature.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացվում է երկխոսությունը, որտեղ կարող եք դիտել "
"ստորագրությունը:</ahelp>"

#: securitywarning.xhp#par_idN10587.help.text
#: securitywarning.xhp%23par_idN10587.help.text
msgid "Always trust macros from this source"
msgstr "Միշտ վստահեք մակրոներին այս աղբյուրից"

#: securitywarning.xhp#par_idN1058B.help.text
#: securitywarning.xhp%23par_idN1058B.help.text
msgid ""
"<ahelp hid=\".\">Adds the current macro source to the list of <link href=\""
"text/shared/optionen/macrosecurity_ts.xhp\">trusted sources</link>.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ավելացնում է ընթացիկ մակրո աղբյուրը <link href=\""
"text/shared/optionen/macrosecurity_ts.xhp\">վստահված "
"աղբյուրներ</link>ցանկում։</ahelp>"

#: securitywarning.xhp#par_idN1059C.help.text
#: securitywarning.xhp%23par_idN1059C.help.text
msgid "Enable Macros"
msgstr "Թույլատրեք մակրոները"

#: securitywarning.xhp#par_idN105A0.help.text
#: securitywarning.xhp%23par_idN105A0.help.text
msgid "<ahelp hid=\".\">Allows macros in the document to run.</ahelp>"
msgstr "<ahelp hid=\".\">Թույլ է տալիս փաստաթղթերի մակրոները գործարկել:</ahelp>"

#: securitywarning.xhp#par_idN105A3.help.text
#: securitywarning.xhp%23par_idN105A3.help.text
msgid "Disable Macros"
msgstr "Արգելեք մակրոները"

#: securitywarning.xhp#par_idN105A7.help.text
#: securitywarning.xhp%23par_idN105A7.help.text
msgid "<ahelp hid=\".\">Does not allow macros in the document to run.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Թույլ չի տալիս փաստաթղթերում մակրոները գործարկել:</ahelp>"

