#: 01100500.xhp#par_id3153662.29.help.text
#: 01100500.xhp%23par_id3153662.29.help.text
msgid ""
"<ahelp hid=\"SFX2_RADIOBUTTON_TP_DOCINFORELOAD_RB_FORWARDUPDATE\">Loads a "
"page that you specify after the number of seconds that you enter in the "
"<emph>seconds </emph>box.</ahelp>"
msgstr ""
"<ahelp hid=\"SFX2_RADIOBUTTON_TP_DOCINFORELOAD_RB_FORWARDUPDATE\">Բեռնվում է "
"էջը, որը նշում եք այն վայրկյաններիից հետո, որը մուտքագրում եք <emph>"
"վայրկյաններ </emph> վանդակում:</ahelp>"

