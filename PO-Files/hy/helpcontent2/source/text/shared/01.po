#: 05340400.xhp%23bm_id3153116.help.text
msgid ""
"<bookmark_value>data source browser</bookmark_value><bookmark_value>tables "
"in databases;browsing and editing</bookmark_value><bookmark_value>databases; "
"editing tables</bookmark_value><bookmark_value>editing; database tables and "
"queries</bookmark_value><bookmark_value>queries; editing in data source "
"view</bookmark_value>"
msgstr ""
"<bookmark_value>data source browser</bookmark_value><bookmark_value>tables "
"in databases;browsing and editing</bookmark_value><bookmark_value>databases; "
"editing tables</bookmark_value><bookmark_value>editing; database tables and "
"queries</bookmark_value><bookmark_value>queries; editing in data source "
"view</bookmark_value>"

#: 05340400.xhp#hd_id3153323.68.help.text
#: 05340400.xhp%23hd_id3153323.68.help.text
msgid ""
"<link href=\"text/shared/01/05340400.xhp\" name=\"Data Sources\">Data "
"Sources</link>"
msgstr ""
"<link href=\"text/shared/01/05340400.xhp\" name=\"Տվյալների աղբյուրներ\">"
"Տվյալների աղբյուրներ</link>"

#: 05340400.xhp#par_id3149511.2.help.text
#: 05340400.xhp%23par_id3149511.2.help.text
msgid ""
"This section contains information on browsing and editing database tables."
msgstr ""
"Այս բաժինը պարունակում է տեղեկատվություն տվյալների շտեմարանի աղյուսակների "
"զննման և խմբագրման վերաբերյալ:"

#: 05340400.xhp#par_id3149150.51.help.text
#: 05340400.xhp%23par_id3149150.51.help.text
msgid ""
"You cannot use the data source browser on a database table that is open in "
"Design view."
msgstr ""
"Դուք չեք կարող օգտագործել տվյալների աղբյուրի զննարկիչը տվյալների շտեմարանի "
"աղյուսակում, որը բացված է Նախագծման տեսքում:"

#: 05340400.xhp#hd_id3149235.8.help.text
#: 05340400.xhp%23hd_id3149235.8.help.text
msgid "Data source browser"
msgstr "Տվյալների աղբյուրի զննարկիչ"

#: 05340400.xhp#par_id3154897.9.help.text
#: 05340400.xhp%23par_id3154897.9.help.text
msgid ""
"<ahelp hid=\".\">The commands for the data source browser are found on the <"
"link href=\"text/shared/01/05340400.xhp\" name=\"Database Bar\">Table Data "
"bar</link> and in <link href=\"text/shared/01/05340400.xhp\" name=\"context "
"menus\">context menus</link>.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Տվյալների աղբյուրի զննարկչի հրամանները հայտնաբերված են <"
"link href=\"text/shared/01/05340400.xhp\" name=\"Շտեմարանի վահանակ\">"
"Աղյուսակի տվյալների վահանակ</link> և <link href=\"text/shared/01/05340400."
"xhp\" name=\"context menus\">context menus</link>.</ahelp>"

#: 05340400.xhp#hd_id3154514.12.help.text
#: 05340400.xhp%23hd_id3154514.12.help.text
msgid "Selecting records"
msgstr "Գրառումների ընտրություն"

#: 05340400.xhp#par_id3149514.34.help.text
#: 05340400.xhp%23par_id3149514.34.help.text
msgid ""
"To select a record in a database table, click the row header, or click a row "
"header, and then use the Up or Down arrow keys."
msgstr ""
"Տվյալների շտեմարանի աղյուսակում գրառում ընտրելու համար կտտացրեք տողի "
"վերնագիրը կամ կտտացրեք տողի վերնագրին, ու այնուհետև օգտագործեք սլաքը վերև "
"կամ ներքևի ստեղները:"

#: 05340400.xhp#par_id7812433001.help.text
#: 05340400.xhp%23par_id7812433001.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Select database records. Drag-and-"
"drop rows or cells to the document to insert contents. Drag-and-drop column "
"headers to insert fields.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ընտրեք տվյալների շտեմարանի "
"գրառումները: Քաշեք և թողնեք տողերը կամ բջիջները դեպի փաստաթուղթ՝ "
"բովանդակությունը տեղադրելու համար: Քաշեք և թողնեք սյունակների վերնագրերը՝ "
"դաշտերը տեղադրելու համար:</ahelp>"

#: 05340400.xhp#par_id3149578.13.help.text
#: 05340400.xhp%23par_id3149578.13.help.text
msgid ""
"The following table describes how to select individual elements in the data "
"source browser:"
msgstr ""
"Հետևյալ աղյուսակը նկարագրում է, թե ինչպես ընտրել տվյալների աղբյուրի "
"զննարկիչում առանձին տարրեը․"

#: 05340400.xhp#par_id3158432.66.help.text
#: 05340400.xhp%23par_id3158432.66.help.text
msgctxt "05340400.xhp#par_id3158432.66.help.text"
msgid "Selection"
msgstr "Ընտրություն"

#: 05340400.xhp#par_id3150670.67.help.text
#: 05340400.xhp%23par_id3150670.67.help.text
msgctxt "05340400.xhp#par_id3150670.67.help.text"
msgid "Action"
msgstr "Գործողություն"

#: 05340400.xhp#par_id3153332.14.help.text
#: 05340400.xhp%23par_id3153332.14.help.text
msgctxt "05340400.xhp#par_id3153332.14.help.text"
msgid "Record"
msgstr "Գրառում"

#: 05340400.xhp#par_id3153700.15.help.text
#: 05340400.xhp%23par_id3153700.15.help.text
msgid "Click the row header"
msgstr "Կտտացրեք տողի վերնագիրը"

#: 05340400.xhp#par_id3149575.16.help.text
#: 05340400.xhp%23par_id3149575.16.help.text
msgid "Several records or removing a selection"
msgstr "Մի քանի գրառում կամ հեռացնել ընտրությունը"

#: 05340400.xhp#par_id3149295.17.help.text
#: 05340400.xhp%23par_id3149295.17.help.text
msgid ""
"Hold down <switchinline select=\"sys\"><caseinline select=\"MAC\">Command "
"</caseinline><defaultinline>Ctrl </defaultinline></switchinline>and click "
"the row header"
msgstr ""
"Սեղմած պահեք <switchinline select=\"sys\"><caseinline select=\"MAC\">Command "
"</caseinline><defaultinline>Ctrl </defaultinline></switchinline>և կտտացրեք "
"տողի վերնագիրը"

#: 05340400.xhp#par_id3152360.18.help.text
#: 05340400.xhp%23par_id3152360.18.help.text
msgctxt "05340400.xhp#par_id3152360.18.help.text"
msgid "Column"
msgstr "Սյունակ"

#: 05340400.xhp#par_id3153960.19.help.text
#: 05340400.xhp%23par_id3153960.19.help.text
msgid "Click the column header"
msgstr "Կտտացրեք սյունակի վերնագիրը"

#: 05340400.xhp#par_id3150541.20.help.text
#: 05340400.xhp%23par_id3150541.20.help.text
msgid "Data field"
msgstr "Տվյալի դաշտ"

#: 05340400.xhp#par_id3150358.21.help.text
#: 05340400.xhp%23par_id3150358.21.help.text
msgid "Click in the data field"
msgstr "Կտտացրեք տվյալի դաշտում"

#: 05340400.xhp#par_id3154366.22.help.text
#: 05340400.xhp%23par_id3154366.22.help.text
msgid "Entire table"
msgstr "Ամբողջական աղյուսակը"

#: 05340400.xhp#par_id3156422.23.help.text
#: 05340400.xhp%23par_id3156422.23.help.text
msgid "Click the row header of the column headings"
msgstr "Կտտացրեք տողի վերնագրի կամ սյունակի վերնագրերի վրա"

#: 05340400.xhp#hd_id3154822.49.help.text
#: 05340400.xhp%23hd_id3154822.49.help.text
msgid "Table Data toolbar (editing table data)"
msgstr "Աղյուսակի տվյալների գործիքադարակ (աղյուսակի տվյալների խմբագրում)"

#: 05340400.xhp#par_id3151041.help.text
#: 05340400.xhp%23par_id3151041.help.text
msgid ""
"<image id=\"img_id3150740\" src=\"res/commandimagelist/sc_editdoc.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3150740\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3150740\" src=\"res/commandimagelist/sc_editdoc.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3150740\""
">Պատկերիկ</alt></image>"

#: 05340400.xhp#par_id3158410.7.help.text
#: 05340400.xhp%23par_id3158410.7.help.text
msgid "Allows you to edit, add, or delete records from the database table."
msgstr ""
"Թույլ է տալիս խմբագրել, ավելացնել կամ ջնջել գրառումները տվյալների շտեմարանի "
"աղյուսակից:"

#: 05340400.xhp#hd_id3152463.53.help.text
#: 05340400.xhp%23hd_id3152463.53.help.text
msgid "Cutting, copying and pasting data"
msgstr "Տվյալների կտրում, պատճենում և հետ տեղադրում"

#: 05340400.xhp#par_id3149287.54.help.text
#: 05340400.xhp%23par_id3149287.54.help.text
msgid ""
"You can cut, copy, and paste records in <emph>Data Source</emph> view. The "
"Data Source browser also supports the dragging and dropping of records, or "
"text and numbers from other $[officename] files."
msgstr ""
"Կարող եք կտրել, պատճենել և տեղադրել գրառումները <emph>Տվյալների "
"աղբյուրի</emph> տեսքում: Տվյալների աղբյուրի զննարկիչը նաև օժանդակում է "
"գրառումների կամ տեքստի և համարակալման քաշել-գցելը $[officename] այլ նիշքերից:"

#: 05340400.xhp#par_id3146921.64.help.text
#: 05340400.xhp%23par_id3146921.64.help.text
msgid ""
"You cannot drag and drop to Yes/No, binary, image, or counting table fields."
msgstr ""
"Չեք կարող քաշել և գցել Այո/Ոչ, երկուական, պատկերի կամ աղյուսակային հաշվարկի "
"դաշտերը։"

#: 05340400.xhp#par_id3149064.63.help.text
