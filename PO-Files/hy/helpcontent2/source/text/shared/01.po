#: 05030600.xhp%23par_id3152596.30.help.text
msgid ""
"<ahelp hid=\"SVX:RADIOBUTTON:RID_SVXPAGE_BACKGROUND:BTN_AREA\">Stretches the "
"graphic to fill the entire background of the selected object.</ahelp>"
msgstr ""
