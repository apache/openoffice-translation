msgid ""
"<ahelp hid=\".\">Adds new icons to the list of icons. You see a file open "
"dialog that imports the selected icon or icons into the internal icon "
"directory of %PRODUCTNAME.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Պատկերակների ցանկում ավելացնում է նոր պատկերակներ: Դուք "
"տեսնում եք բացել նիշքը երկխոսություն, որը ներմուծում է ընտրված պատկերակը կամ "
"պատկերակները %PRODUCTNAME -ի ներքին պատկերակների ցուցակում։</ahelp>"

#: 06140402.xhp#par_idN10575.help.text
#: 06140402.xhp%23par_idN10575.help.text
msgid ""
"You can only import icons that are in the PNG file format and that are 16x16 "
"or 26x26 pixels in size."
msgstr ""
"Կարող եք ներմուծել միայն պատկերակներ, որոնք նիշքի PNG ձևաչափով են և դրանց "
"չափն է 16x16 կամ 26x26 պիքսել:"

#: 06140402.xhp#par_id8224433.help.text
#: 06140402.xhp%23par_id8224433.help.text
msgid ""
"<ahelp hid=\".\">Click to remove the selected icon from the list. Only user-"
"defined icons can be removed.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Կտտացրեք ընտրված պատկերակը ցուցակից հանելու համար: Միայն "
"օգտագործողի կողմից սահմանված պատկերակները կարող են հեռացվել:</ahelp>"

