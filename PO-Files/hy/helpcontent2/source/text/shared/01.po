msgid "Security"
msgstr "Անվտանգություն"

#: 01100600.xhp#bm_id1472519.help.text
#: 01100600.xhp%23bm_id1472519.help.text
msgid ""
"<bookmark_value>password as document "
"property</bookmark_value><bookmark_value>file sharing options for current "
"document</bookmark_value><bookmark_value>read-only documents;opening "
"documents as</bookmark_value><bookmark_value>saving;with password by "
"default</bookmark_value><bookmark_value>user data;removing when "
"saving</bookmark_value>"
msgstr ""
"<bookmark_value>password as document "
"property</bookmark_value><bookmark_value>file sharing options for current "
"document</bookmark_value><bookmark_value>read-only documents;opening "
"documents as</bookmark_value><bookmark_value>saving;with password by "
"default</bookmark_value><bookmark_value>user data;removing when "
"saving</bookmark_value>"

#: 01100600.xhp#hd_id3149969.help.text
#: 01100600.xhp%23hd_id3149969.help.text
msgid ""
"<link href=\"text/shared/01/01100600.xhp\" name=\"Security\">Security</link>"
msgstr ""
"<link href=\"text/shared/01/01100600.xhp\" name=\"Անվտանգություն\""
">Անվտանգություն</link>"

#: 01100600.xhp#par_id3156049.help.text
#: 01100600.xhp%23par_id3156049.help.text
msgid ""
"<ahelp hid=\".\">Sets password options for the current document.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Սահմանում է գաղտնաբառի ընտրանքները ընթացիկ փաստաթղթի "
"համար:</ahelp>"

#: 01100600.xhp#hd_id31499.help.text
#: 01100600.xhp%23hd_id31499.help.text
msgid "File encryption"
msgstr "Նիշքի կոդավորում"

#: 01100600.xhp#hd_id31499A.help.text
#: 01100600.xhp%23hd_id31499A.help.text
msgid ""
"The password to open the current document can be set in the Properties "
"dialog on the Security tab page. You can also set a password to open the "
"document when you save the document. Check the Save with password option on "
"the Save As dialog, and enter the password."
msgstr ""
"Ընթացիկ փաստաթղթի բացման գաղտնաբառը կարող է դրվել «Հատկություններ» "
"երկխոսության մեջ՝ «Անվտանգության» ներդիրի էջում: Փաստաթուղթը պահելու "
"ընթացքում կարող եք նաև գաղտնաբառ սահմանել՝ փաստաթուղթը բացելու համար: Նշեք "
"Հիշել գաղտնաբառով տարբերակը Հիշել որպես երկխոսությունում, և մուտքագրեք "
"գաղտնաբառը:"

#: 01100600.xhp#par_idN106AA1.help.text
#: 01100600.xhp%23par_idN106AA1.help.text
msgid "Enter password to open"
msgstr "Բացելու համար մուտքագրեք գաղտնաբառը"

#: 01100600.xhp#par_id3150502B.help.text
#: 01100600.xhp%23par_id3150502B.help.text
msgctxt "01100600.xhp#par_id3150502B.help.text"
msgid "<ahelp hid=\".\">Type a password. A password is case sensitive.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Մուտքագրեք գաղտնաբառը: Գաղտնաբառը ընտրությանը զգայուն "
"է:</ahelp>"

#: 01100600.xhp#par_idN106AA2.help.text
#: 01100600.xhp%23par_idN106AA2.help.text
msgctxt "01100600.xhp#par_idN106AA2.help.text"
msgid "Confirm password"
msgstr "Հաստատել գաղտնաբառը"

#: 01100600.xhp#par_id3151100E.help.text
#: 01100600.xhp%23par_id3151100E.help.text
msgctxt "01100600.xhp#par_id3151100E.help.text"
msgid "<ahelp hid=\".\">Re-enter the password.</ahelp>"
msgstr "<ahelp hid=\".\">Նորից մուտք արեք գաղտնաբառը։</ahelp>"

#: 01100600.xhp#par_idN106A3.help.text
#: 01100600.xhp%23par_idN106A3.help.text
msgid "File sharing options"
msgstr "Նիշքի համատեղման ընտրանքներ"

#: 01100600.xhp#hd_id31499F.help.text
#: 01100600.xhp%23hd_id31499F.help.text
msgid ""
"The password to edit the current document can be set in the Properties "
"dialog on the Security tab page. Currently this option is evaluated for "
"documents in some Microsoft file formats."
msgstr ""
"Ընթացիկ փաստաթղթի խմբագրման գաղտնաբառը կարող է կարգաբերվել Հատկություններ "
"երկխոսության մեջ՝ Անվտանգության ներդիրի էջում: Ներկայումս այս տարբերակը "
"հաշվի է առնվում Microsoft-ի որոշ նիշքերի ձևաչափերով փաստաթղթերի համար:"

#: 01100600.xhp#par_idN106AA3.help.text
#: 01100600.xhp%23par_idN106AA3.help.text
msgid "Enter password to allow editing"
msgstr "Մուտքագրեք գաղտնաբառը՝ խմբագրումը թույլ տալու համար"

#: 01100600.xhp#par_id3150502H.help.text
#: 01100600.xhp%23par_id3150502H.help.text
msgctxt "01100600.xhp#par_id3150502H.help.text"
msgid "<ahelp hid=\".\">Type a password. A password is case sensitive.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Մուտքագրեք գաղտնաբառ: Գաղտնաբառը ընտրությանը զգայուն "
"է:</ahelp>"

#: 01100600.xhp#par_idN106AA4.help.text
#: 01100600.xhp%23par_idN106AA4.help.text
msgctxt "01100600.xhp#par_idN106AA4.help.text"
msgid "Confirm password"
msgstr "Հաստատել գաղտնաբառը"

#: 01100600.xhp#par_id3151100J.help.text
#: 01100600.xhp%23par_id3151100J.help.text
msgctxt "01100600.xhp#par_id3151100J.help.text"
msgid "<ahelp hid=\".\">Re-enter the password.</ahelp>"
msgstr "<ahelp hid=\".\">Կրկին մուտքագրեք գաղտնաբառը:</ahelp>"

#: 01100600.xhp#par_idN106AA.help.text
#: 01100600.xhp%23par_idN106AA.help.text
msgid "Open file read-only"
msgstr "Բացեք նիշքը որպես միայն-կարդալ։"

#: 01100600.xhp#par_idN106AE.help.text
#: 01100600.xhp%23par_idN106AE.help.text
msgid ""
"<ahelp hid=\".\">Select to allow this document to be opened in read-only "
"mode only.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք, որպեսզի այս փաստաթուղթը բացվի միայն կարդալու "
"ռեժիմով:</ahelp>"

#: 01100600.xhp#par_idN106B1.help.text
#: 01100600.xhp%23par_idN106B1.help.text
msgid ""
"This file sharing option protects the document against accidental changes. "
"It is still possible to edit a copy of the document and save that copy with "
"the same name as the original."
msgstr ""
"Նիշքի կիսման այս տարբերակը պաշտպանում է փաստաթուղթը պատահական "
"փոփոխություններից: Դեռ հնարավոր է խմբագրել փաստաթղթի պատճենը և պահպանել այդ "
"օրինակը բնօրինակի նույն անունով:"

#: 01100600.xhp#par_idN106B4.help.text
#: 01100600.xhp%23par_idN106B4.help.text
msgid "Record changes"
msgstr "Գրառել փոփոխությունները"

#: 01100600.xhp#par_idN106B8.help.text
#: 01100600.xhp%23par_idN106B8.help.text
msgid ""
"<ahelp hid=\".\">Select to enable recording changes. This is the same as "
"<emph>Edit - Changes - Record</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք՝ թույլատրելու գրանցման փոփոխությունները: Սա նույնն "
"է, ինչ <emph>Խմբագրել - Փոփոխություններ - Գրանցել</emph>։</ahelp>"

#: 01100600.xhp#par_idN106C9.help.text
#: 01100600.xhp%23par_idN106C9.help.text
msgid ""
"To protect the recording state with a password, click <emph>Protect</emph> "
"and enter a password. Other users of this document can apply their changes, "
"but they cannot disable change recording without knowing the password."
msgstr ""
"Գրանցման վիճակը գաղտնաբառով պաշտպանելու համար կտտացրեք <emph>Պաշտպանեք</emph>"
" և մուտքագրեք գաղտնաբառը: Այս փաստաթղթից մյուս օգտվողները կարող են կիրառել "
"իրենց փոփոխությունները, բայց նրանք չեն կարող անջատել փոփոխության գրանցումը` "
"առանց իմանալու գաղտնաբառը:"

#: 01100600.xhp#par_idN106D0.help.text
#: 01100600.xhp%23par_idN106D0.help.text
msgid "Protect / Unprotect"
msgstr "Պաշտպանեք / Մի պաշտպանեք"

#: 01100600.xhp#par_idN106D4.help.text
#: 01100600.xhp%23par_idN106D4.help.text
msgid ""
"<ahelp hid=\"703992336\">Protects the change recording state with a "
"password. If change recording is protected for the current document, the "
"button is named <emph>Unprotect</emph>. Click <emph>Unprotect</emph> and "
"type the correct password to disable the protection.</ahelp>"
msgstr ""
"<ahelp hid=\"703992336\">Պաշտպանում է փոփոխության գրանցման վիճակը "
"գաղտնաբառով: Եթե փոփոխության գրանցումը պաշտպանված է ընթացիկ փաստաթղթի համար, "
"կոճակը կոչվում է <emph>Մի պաշտպանեք</emph>։ Կտտացրեք <emph>Մի "
"պաշտպանեք</emph> և մուտքագրեք ճիշտ գաղտնաբառը՝ պաշտպանությունն անջատելու "
"համար:</ahelp>"

#: 05070300.xhp#tit.help.text
#: 05070300.xhp%23tit.help.text
msgctxt "05070300.xhp#tit.help.text"
msgid "Align Right"
msgstr "Հավասարեցրու աջ"

#: 05070300.xhp#hd_id3153383.1.help.text
#: 05070300.xhp%23hd_id3153383.1.help.text
msgid ""
"<link href=\"text/shared/01/05070300.xhp\" name=\"Align Right\">Align "
"Right</link>"
msgstr ""
"<link href=\"text/shared/01/05070300.xhp\" name=\"Հավասարեցրու աջ\">"
"Հավասարեցրու աջ</link>"

#: 05070300.xhp#par_id3151264.2.help.text
#: 05070300.xhp%23par_id3151264.2.help.text
msgid ""
"<ahelp hid=\".uno:ObjectAlignRight\">Aligns the right edges of the selected "
"objects. If only one object is selected in Impress or Draw, the right edge "
"of the object is aligned to the right page margin.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ObjectAlignRight\">Հավասարեցնում է ընտրված օբյեկտների աջ "
"եզրերը: Եթե Impress -ում կամ Draw -ում ընտրված է միայն մեկ առարկա, օբյեկտի "
"աջ եզրը հավասարեցված է աջ էջի լուսանցքին:</ahelp>"

#: 05070300.xhp#par_id3144336.3.help.text
#: 05070300.xhp%23par_id3144336.3.help.text
