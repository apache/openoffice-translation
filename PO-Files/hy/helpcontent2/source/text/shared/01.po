msgstr "Մուտքագրեք ընտրված հրամանի նոր անունը:"

#: 06140100.xhp#par_idN10824.help.text
#: 06140100.xhp%23par_idN10824.help.text
msgctxt "06140100.xhp#par_idN10824.help.text"
msgid "Delete"
