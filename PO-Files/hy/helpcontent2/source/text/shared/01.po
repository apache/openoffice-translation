msgid "Filter list"
msgstr "Զտիչների ցուցակ"

#: 01020103.xhp#par_id3159201.5.help.text
#: 01020103.xhp%23par_id3159201.5.help.text
msgid ""
"<ahelp hid=\"SFX2:LISTBOX:DLG_FILTER_SELECT:LB_DLG_LISTBOX\">Select the "
"import filter for the file that you want to open.</ahelp>"
msgstr ""
"<ahelp hid=\"SFX2:LISTBOX:DLG_FILTER_SELECT:LB_DLG_LISTBOX\">Ընտրեք "
"ներմուծման զտիչը այն նիշքի համար, որը ցանկանում եք բացել:</ahelp>"

#: 01020103.xhp#par_id3152918.6.help.text
#: 01020103.xhp%23par_id3152918.6.help.text
msgid ""
"If $[officename] does not recognize the file type of the document that your "
"want to open, try any of the following:"
msgstr ""
"Եթե $[officename] չի ճանաչում այն փաստաթղթի նիշքի տեսակը, որը ցանկանում եք "
"բացել, փորձեք հետևյալներից որևէ մեկը."

#: 01020103.xhp#par_id3152924.7.help.text
#: 01020103.xhp%23par_id3152924.7.help.text
msgid "Select the import filter from the list."
msgstr "Ցուցակից ընտրեք ներմուծման զտիչը։"

#: 01020103.xhp#par_id3155892.9.help.text
#: 01020103.xhp%23par_id3155892.9.help.text
msgid ""
"Ensure that the file extension corresponds to the file type of the document. "
"For example, a Microsoft Word document must have a (*.doc) extension for "
"$[officename] to use the appropriate filter."
msgstr ""
"Ապահովեք, որ նիշքի ընդլայնումը համապատասխանի փաստաթղթի նիշքի տիպին: Օրինակ, "
"Microsoft Word-ի փաստաթուղթը պետք է ունենա (*.doc) երկարացում $[officename] -"
"ի համար` համապատասխան զտիչը օգտագործելու համար:"

#: 01020103.xhp#par_id3147571.8.help.text
#: 01020103.xhp%23par_id3147571.8.help.text
msgid ""
"Install a missing import filter with the <emph>$[officename] Setup</emph> "
"program."
msgstr ""
"Տեղադրեք ներմուծման բացակա զտիչը <emph>$[officename] կարգաբերում</emph> "
"ծրագրի միջոցով։"

#: 06040500.xhp#tit.help.text
#: 06040500.xhp%23tit.help.text
msgctxt "06040500.xhp#tit.help.text"
msgid "AutoCorrect context menu"
msgstr "Ինքնշտկման բովանդակային ընտրացանկ"

#: 06040500.xhp#bm_id3152823.help.text
