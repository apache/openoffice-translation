msgid "For Selection"
msgstr "Ընտրության համար"

#: 06010500.xhp#par_id1507309.help.text
#: 06010500.xhp%23par_id1507309.help.text
msgid ""
"<ahelp hid=\".\">Opens a submenu. Choose a language for the selected text. "
"<br/>Choose None to exclude the selected text from spellchecking and "
"hyphenation.<br/>Choose More to open a dialog with more options.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է ենթաընտրացանկը: Ընտրված տեքստի համար ընտրեք լեզուն:"
" <br/>Ընտրեք Ոչ մեկը` ընտրված տեքստը զերծ պահելու համար ուղղագրական "
"շտկումներից և տողադարձումից։<br/>Ընտրեք Ավելին՝ ավելի շատ ընտրանքներով "
"երկխոսություն բացելու համար:</ahelp>"

#: 06010500.xhp#hd_id7693411.help.text
#: 06010500.xhp%23hd_id7693411.help.text
