msgid "Angle"
msgstr "Անկյուն"

#: 05230400.xhp#par_id3153683.10.help.text
#: 05230400.xhp%23par_id3153683.10.help.text
msgid ""
"<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_SLANT:MTR_FLD_ANGLE\">Enter the "
"angle of the slant axis.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_SLANT:MTR_FLD_ANGLE\">Մուտքագրեք "
"թեք առանցքի անկյունը:</ahelp>"

#: 01180000.xhp#tit.help.text
#: 01180000.xhp%23tit.help.text
