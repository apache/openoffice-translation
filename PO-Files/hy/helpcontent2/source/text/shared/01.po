"<ahelp hid=\"HID_SC_CHANGES_COMMENT\">Edit the comment for the selected "
"change.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_SC_CHANGES_COMMENT\">Ընտրված փոփոխության համար խմբագրեք "
"մեկնաբանությունը։</ahelp>"

#: 02230401.xhp#hd_id3153281.46.help.text
#: 02230401.xhp%23hd_id3153281.46.help.text
msgid "Sort"
msgstr "Տեսակավորել"

