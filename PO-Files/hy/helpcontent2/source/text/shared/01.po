"<switchinline select=\"appl\"><caseinline select=\"WRITER\">Չկա "
"ձևաչափ</caseinline></switchinline>"

#: 02100000.xhp#par_id3159155.136.help.text
#: 02100000.xhp%23par_id3159155.136.help.text
msgid ""
"<switchinline select=\"appl\"><caseinline select=\"WRITER\">Click in the "
