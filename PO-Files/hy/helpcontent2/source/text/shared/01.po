msgstr ""
"<variable id=\"aufhebentext\"><ahelp hid=\".uno:FormatUngroup\" visibility=\""
"visible\">Ընտրված խումբը առանձնացնում է առանձին "
"օբյեկտների:</ahelp></variable>"

#: 05290200.xhp#par_id3146067.3.help.text
#: 05290200.xhp%23par_id3146067.3.help.text
msgid ""
