#: 05350300.xhp#par_id3156344.18.help.text
#: 05350300.xhp%23par_id3156344.18.help.text
msgid ""
"<ahelp hid=\"SVX:METRICFIELD:RID_SVXFLOAT_3D:MTR_FOCAL_LENGTH\">Enter the "
"focal length of the camera, where a small value corresponds to a \"fisheye\" "
"lens, and a large value to a telephoto lens.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:METRICFIELD:RID_SVXFLOAT_3D:MTR_FOCAL_LENGTH\">Մուտքագրեք "
"ֆոտոխցիկի կիզակետային երկարությունը, որտեղ փոքր արժեքը համապատասխանում է \""
"fisheye\" ոսպնյակին, իսկ մեծ արժեքը` տելեֆոտո ոսպնյակներին:</ahelp>"

