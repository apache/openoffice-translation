msgstr ""
"<ahelp hid=\"SVX:METRICFIELD:RID_SVXPAGE_SLANT:MTR_FLD_RADIUS\">Մուտքագրեք "
"այն շրջանակի շառավղը, որը ցանկանում եք օգտագործել անկյունները կլորացնելու "
"համար:</ahelp>"

#: 05230400.xhp#hd_id3145090.7.help.text
#: 05230400.xhp%23hd_id3145090.7.help.text
msgctxt "05230400.xhp#hd_id3145090.7.help.text"
msgid "Slant"
msgstr "Թեքություն"

#: 05230400.xhp#par_id3153345.8.help.text
