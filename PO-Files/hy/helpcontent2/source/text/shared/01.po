#: 01100500.xhp%23par_id3157958.8.help.text
msgid ""
"<ahelp hid=\"SFX2:NUMERICFIELD:TP_DOCINFORELOAD:ED_SECONDS\">Enter the "
"number of seconds to wait before the page is reloaded.</ahelp>"
