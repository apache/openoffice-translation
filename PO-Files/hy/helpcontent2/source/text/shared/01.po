msgid "Add"
msgstr "Ավելացնել"

#: 05210300.xhp#par_id3145416.18.help.text
#: 05210300.xhp%23par_id3145416.18.help.text
msgid ""
"<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_GRADIENT:BTN_ADD\">Adds a custom "
"gradient to the current list. Specify the properties of your gradient, and "
"then click this button</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXPAGE_GRADIENT:BTN_ADD\">Ընթացիկ ցուցակին "
"ավելացնում է հաճախորդի գրադիենտը: Նշեք ձեր գրադիենտի հատկությունները, ապա "
"կտտացրեք այս կոճակը</ahelp>"

#: 05210300.xhp#hd_id3150772.19.help.text
