msgstr "Թվեր (միայն տեքստում)"

#: 01150300.xhp#par_id3153254.15.help.text
#: 01150300.xhp%23par_id3153254.15.help.text
msgid ""
"<ahelp hid=\"SVX_LISTBOX_RID_SVXPAGE_OPTIONS_CTL_LB_NUMERALS\">Selects the "
"type of numerals used within text, text in objects, fields, and controls, in "
"all <item type=\"productname\">%PRODUCTNAME</item> modules. Only cell "
"contents of <item type=\"productname\">%PRODUCTNAME</item> Calc are not "
"affected.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX_LISTBOX_RID_SVXPAGE_OPTIONS_CTL_LB_NUMERALS\">Ընդհանուր "
"առմամբ ընտրում է տեքստի մեջ օգտագործվող թվերի տեսակը, տեքստը առարկաներում, "
"դաշտերում և հսկիչներում, բոլոր <item type=\"productname\">%PRODUCTNAME</item>"
" մոդուլներում։ Միայն բջջի պարունակությունը <item type=\"productname\""
">%PRODUCTNAME</item> Calc չեն ազդվում:</ahelp>"

#: 01150300.xhp#par_id3153561.16.help.text
#: 01150300.xhp%23par_id3153561.16.help.text
msgid ""
"Arabic: All numbers are shown using Arabic numerals. This is the default."
msgstr ""
"Արաբերեն. Բոլոր թվերը ցուցադրվում են արաբական թվանշանների միջոցով: Սա "
"լռելյայն է:"

#: 01150300.xhp#par_id3148563.17.help.text
#: 01150300.xhp%23par_id3148563.17.help.text
msgid "Hindi: All numbers are shown using Hindi numerals. "
msgstr "Հինդի. Բոլոր թվերը ցուցադրվում են հինդի թվանշանների միջոցով:"

#: 01150300.xhp#par_id3149295.18.help.text
#: 01150300.xhp%23par_id3149295.18.help.text
msgid ""
"System: All numbers are shown using Arabic or Hindi numerals, according to "
"the locale settings defined by your system locale."
msgstr ""
"Համակարգ. Բոլոր թվերը ցուցադրվում են արաբերեն կամ հինդի թվանշաններով՝ "
"համաձայն ձեր համակարգի տեղայինի կողմից սահմանված տեղայինի պարամետրերի:"

#: 01150300.xhp#par_id3146794.19.help.text
#: 01150300.xhp%23par_id3146794.19.help.text
msgid ""
"This setting is not saved in the document but in the <item type=\""
"productname\">%PRODUCTNAME</item> configuration."
msgstr ""
"Այս կարգավորումը չի պահվում փաստաթղթում, այլ <item type=\"productname\""
">%PRODUCTNAME</item> կազմաձևում:"

