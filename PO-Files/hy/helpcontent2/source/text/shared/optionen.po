msgid ""
"<ahelp hid=\"HID_OPTIONS_COLORCONFIG_COLORLIST_WIN\">Select the colors for "
"the user interface elements.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_OPTIONS_COLORCONFIG_COLORLIST_WIN\">Ընտրեք գույները "
"օգտագործողի միջերեսի տարրերի համար:</ahelp>"

#: 01012000.xhp#par_id3150769.15.help.text
#: 01012000.xhp%23par_id3150769.15.help.text
msgid ""
"To apply a color to a user interface element, ensure that the checkbox in "
"front of the name is marked. To hide a user interface element, clear the "
"check box."
msgstr ""
"Օգտագործողի միջերեսի տարրի վրա գույն կիրառելու համար համոզվեք, որ անվան "
"դիմացի ընտրավանդակը նշված է: Օգտագործողի միջերեսի տարրը թաքցնելու համար "
"մաքրեք վանդակը:"

#: 01012000.xhp#par_id3155430.18.help.text
#: 01012000.xhp%23par_id3155430.18.help.text
msgid "Some user interface elements cannot be hidden."
msgstr "Օգտագործողի միջերեսի որոշ տարրեր հնարավոր չէ թաքցնել:"

#: 01012000.xhp#par_id3145365.20.help.text
#: 01012000.xhp%23par_id3145365.20.help.text
msgid ""
"In order to enhance cursor visibility, if the user sets the application "
"background color between 40% and 60% gray, it is automatically changed to 40%"
" gray."
msgstr ""
"Կուրսորի տեսանելիությունը բարձրացնելու համար, եթե օգտագործողը կիրառության "
"հետնամասի գույնը դնում է 40% և 60% միջև մոխրագույնի, ապա այն ինքնաշխատ "
"կերպով փոխվում է`դառնալով 40% մոխրագույն:"

#: 01012000.xhp#par_id3153144.16.help.text
#: 01012000.xhp%23par_id3153144.16.help.text
msgid ""
"The <emph>Automatic</emph> color setting changes the user interface element "
"to the preset color from the color scheme."
msgstr ""
"<emph>Ինքնաշխատ</emph> գույնի կարգաբերումը փոխում է օգտագործողի միջերեսի "
"տարրը գունային սխեմայից ներկայիս գույնին:"

#: 01012000.xhp#par_id3154921.17.help.text
#: 01012000.xhp%23par_id3154921.17.help.text
msgid ""
"The color settings for \"Visited links\" and \"Unvisited links\" only apply "
"to documents created after the settings are applied."
msgstr ""
"«Այցելված հղումներ» և «Չայցելված հղումներ» գույների կարգավորումները "
"տարածվում են միայն պարամետրերը կիրառելուց հետո ստեղծված փաստաթղթերի վրա:"

