"մեծ չափի բռնակներ (սահմանային ուղղանկյան ութ կետերը):</ahelp>"

#: 01040200.xhp#hd_id3149416.11.help.text
#: 01040200.xhp%23hd_id3149416.11.help.text
msgctxt "01040200.xhp#hd_id3149416.11.help.text"
msgid "View"
msgstr "Տեսք"

#: 01040200.xhp#par_id3155922.12.help.text
#: 01040200.xhp%23par_id3155922.12.help.text
msgid "Specifies whether scrollbars and rulers are displayed."
msgstr "Նշում է, թե արդյոք ցուցադրվում են ոլորման վահանակներն ու քանոնները:"

#: 01040200.xhp#hd_id3145609.13.help.text
#: 01040200.xhp%23hd_id3145609.13.help.text
msgctxt "01040200.xhp#hd_id3145609.13.help.text"
msgid "Horizontal scrollbar"
msgstr "Ոլորման հորիզոնական վահանակ"

#: 01040200.xhp#par_id3154347.14.help.text
#: 01040200.xhp%23par_id3154347.14.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_TP_CONTENT_OPT_CB_HSCROLL\">Displays the horizontal "
"scrollbar.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_TP_CONTENT_OPT_CB_HSCROLL\">Ցուցադրում է ոլորման "
"հորիզոնական վահանակը։</ahelp>"

#: 01040200.xhp#hd_id3148663.15.help.text
#: 01040200.xhp%23hd_id3148663.15.help.text
msgctxt "01040200.xhp#hd_id3148663.15.help.text"
msgid "Vertical scrollbar"
msgstr "Ուղղահայաց ոլորվող վահանակ"

#: 01040200.xhp#par_id3150541.16.help.text
#: 01040200.xhp%23par_id3150541.16.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_TP_CONTENT_OPT_CB_VSCROLL\">Displays the vertical "
"scrollbar.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_TP_CONTENT_OPT_CB_VSCROLL\">Ցուցադրում է ուղղահայաց "
"ոլորվող վահանակը։</ahelp>"

#: 01040200.xhp#hd_id3148798.65.help.text
#: 01040200.xhp%23hd_id3148798.65.help.text
msgid "Ruler"
msgstr "Քանոն"

#: 01040200.xhp#par_id3154126.66.help.text
#: 01040200.xhp%23par_id3154126.66.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_TP_CONTENT_OPT_CB_ANY_RULER\">Enables the rulers. "
"Use the following two check boxes to select the ruler(s) to be shown.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_TP_CONTENT_OPT_CB_ANY_RULER\">Թույլատարում է "
"քանոնները։ Ցուցադրվող քանոն(ներ)ը ընտրելու համար օգտագործեք հետևյալ երկու "
"ընտրավանդակները:</ahelp>"

#: 01040200.xhp#hd_id3159149.17.help.text
#: 01040200.xhp%23hd_id3159149.17.help.text
msgid "Horizontal ruler"
msgstr "Հորիզոնական քանոն"

#: 01040200.xhp#par_id3149202.18.help.text
#: 01040200.xhp%23par_id3149202.18.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_CONTENT_OPT_LB_HMETRIC\">Displays the horizontal "
"ruler. Select the desired measurement unit from the corresponding "
"list.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_CONTENT_OPT_LB_HMETRIC\">Ցուցադրում է հորիզոնական "
"քանոնը: Համապատասխան ցուցակից ընտրեք ցանկալի չափման միավորը:</ahelp>"

#: 01040200.xhp#hd_id3153104.19.help.text
#: 01040200.xhp%23hd_id3153104.19.help.text
msgid "Vertical ruler"
msgstr "Ուղղահայաց քանոն"

#: 01040200.xhp#par_id3147287.20.help.text
#: 01040200.xhp%23par_id3147287.20.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_CONTENT_OPT_LB_VMETRIC\">Displays the vertical "
"ruler. Select the desired measurement unit from the corresponding "
"list.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_CONTENT_OPT_LB_VMETRIC\">Ցուցադրում է ուղղահայաց "
"քանոնը: Համապատասխան ցուցակից ընտրեք չափման ցանկալի միավորը:</ahelp>"

#: 01040200.xhp#hd_id3152460.62.help.text
#: 01040200.xhp%23hd_id3152460.62.help.text
msgid "Right-aligned"
msgstr "Աջ հավասարեցված"

#: 01040200.xhp#par_id3151116.61.help.text
#: 01040200.xhp%23par_id3151116.61.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_TP_CONTENT_OPT_CB_VRULER_RIGHT\">Aligns the "
"vertical ruler with the right border.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_TP_CONTENT_OPT_CB_VRULER_RIGHT\">Ուղղահայաց քանոնը "
"հավասարեցնում է աջ եզրագծին:</ahelp>"

#: 01040200.xhp#hd_id3155414.27.help.text
#: 01040200.xhp%23hd_id3155414.27.help.text
msgid "Smooth scroll"
msgstr "Հարթ ոլորում"

#: 01040200.xhp#par_id3153364.28.help.text
#: 01040200.xhp%23par_id3153364.28.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_TP_CONTENT_OPT_CB_SMOOTH_SCROLL\">Activates the "
"smooth page scrolling function. </ahelp> The scrolling speed depends of the "
"area and of the color depth display."
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_TP_CONTENT_OPT_CB_SMOOTH_SCROLL\">Ակտիվացնում է "
"սահուն էջի ոլորման գործառույթը: </ahelp> Ոլորման արագությունը կախված է "
"տարածքից և գույնի խորության ցուցադրումից:"

#: 01040200.xhp#hd_id3153091.34.help.text
#: 01040200.xhp%23hd_id3153091.34.help.text
msgctxt "01040200.xhp#hd_id3153091.34.help.text"
msgid "Display"
msgstr "Արտածում"

#: 01040200.xhp#par_id3154920.35.help.text
#: 01040200.xhp%23par_id3154920.35.help.text
msgid "Defines which document elements are displayed."
msgstr "Սահմանում է, թե փաստաթղթի որ տարրերն են արտածվում:"

#: 01040200.xhp#hd_id3153143.36.help.text
#: 01040200.xhp%23hd_id3153143.36.help.text
msgid "Graphics and objects"
msgstr "Գրաֆիկներ և առարկաներ"

#: 01040200.xhp#par_id3149261.37.help.text
#: 01040200.xhp%23par_id3149261.37.help.text
msgid ""
"<variable id=\"grafikenaus\"><ahelp hid=\"SW:CHECKBOX:TP_CONTENT_OPT:CB_GRF\""
">Specifies whether to display graphics and objects on the "
"screen.</ahelp></variable> If these elements are hidden, you will see empty "
"frames as placeholders."
msgstr ""
"<variable id=\"grafikenaus\"><ahelp hid=\"SW:CHECKBOX:TP_CONTENT_OPT:CB_GRF\""
">Նշում է արդյոք պաստառի վրա գրաֆիկա և առարկաներ ցուցադրել:</ahelp></variable>"
" Եթե այս տարրերը թաքնված են, դուք կտեսնեք դատարկ շրջանակներ՝ որպես "
"տեղապահներ:"

#: 01040200.xhp#par_id3154944.38.help.text
#: 01040200.xhp%23par_id3154944.38.help.text
msgid ""
"You can also control the display of graphics through the <link href=\""
"text/swriter/02/18120000.xhp\" name=\"Graphics\"><emph>Graphics "
"On/Off</emph></link> icon. If a text document is open, this icon is "
"displayed on the <emph>Tools</emph> bar."
msgstr ""
"Կարող եք նաև վերահսկել գրաֆիկայի ցուցադրումը <link href=\""
"text/swriter/02/18120000.xhp\" name=\"Գրաֆիկներ\"><emph>Գրաֆիկները "
"միացված/անջատված</emph></link> պատկերակի միջոցով։ Եթե տեքստային փաստաթուղթ "
"բացված է, այս պատկերակը ցուցադրվում է <emph>Գործիքներ</emph> վահանակում։"

#: 01040200.xhp#par_id3146898.39.help.text
#: 01040200.xhp%23par_id3146898.39.help.text
msgid ""
"If the <emph>Graphics and objects </emph>option is not selected, no graphics "
"will be loaded from the Internet. Graphics within a table and without an "
"indication of their size can cause display problems when using an older HTML "
"standard on the browsed page."
msgstr ""
"Եթե <emph>Գրաֆիկա և առարկաներ </emph> տարբերակը ընտրված չէ, ոչ մի գրաֆիկա չի "
"բեռնվում Ինտերնետից: Աղյուսակի ներսում գրաֆիկները և առանց դրանց չափի նշման "
"գծապատկերները կարող են խնդիրներ առաջացնել զննարկված էջում ավելի հին HTML "
"ստանդարտ օգտագործելիս:"

#: 01040200.xhp#hd_id3156332.40.help.text
#: 01040200.xhp%23hd_id3156332.40.help.text
msgid "Tables"
msgstr "Աղյուսակներ"

#: 01040200.xhp#par_id3154482.41.help.text
#: 01040200.xhp%23par_id3154482.41.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_CONTENT_OPT:CB_TBL\">Displays the tables "
"contained in your document.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_CONTENT_OPT:CB_TBL\">Ցուցադրում է ձեր "
"փաստաթղթում պարունակվող աղյուսակները:</ahelp>"

#: 01040200.xhp#par_id3153713.67.help.text
#: 01040200.xhp%23par_id3153713.67.help.text
msgid ""
"<ahelp hid=\".uno:TableBoundaries\">To display the table boundaries, right-"
"click any table and choose <emph>Table Boundaries</emph>, or choose <emph>"
"Table - Table Boundaries</emph> in a Writer document.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:TableBoundaries\">Սեղանի սահմանները ցուցադրելու համար, աջ "
"սեղմեք ցանկացած սեղան և ընտրեք <emph>Աղյուսակի սահմանները</emph> կամ ընտրեք "
"<emph>Աղյուսակ - Աղյուսակի սահմաններ</emph> Writer փաստաթղթում։</ahelp>"

#: 01040200.xhp#hd_id3149018.42.help.text
#: 01040200.xhp%23hd_id3149018.42.help.text
msgid "Drawings and controls"
msgstr "Նկարներ և հսկիչներ"

#: 01040200.xhp#par_id3151249.43.help.text
#: 01040200.xhp%23par_id3151249.43.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_CONTENT_OPT:CB_DRWFAST\">Displays the drawings "
"and controls contained in your document.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_CONTENT_OPT:CB_DRWFAST\">Ցուցադրում է ձեր "
"փաստաթղթում պարունակվող նկարներն ու հսկիչները:</ahelp>"

#: 01040200.xhp#hd_id3155937.44.help.text
#: 01040200.xhp%23hd_id3155937.44.help.text
msgid "Field codes"
msgstr "Դաշտի կոդեր"

#: 01040200.xhp#par_id3155959.45.help.text
#: 01040200.xhp%23par_id3155959.45.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_CONTENT_OPT:CB_FIELD\">Displays the field names "
"in the document instead of the contents of the fields.</ahelp> You can also "
"choose <link href=\"text/swriter/01/03090000.xhp\" name=\"View - Fields\""
"><emph>View - Fields</emph></link> in a text document."
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_CONTENT_OPT:CB_FIELD\">Դաշտերի բովանդակության "
"փոխարեն ցուցադրում է փաստաթղթում դաշտերի անունները:</ahelp> կարող եք նաև "
"ընտրել <link href=\"text/swriter/01/03090000.xhp\" name=\"Տեսք - Դաշտեր\""
"><emph>Տեսք - Դաշտեր</emph></link> տեքստային փաստաթղթում։"

#: 01040200.xhp#hd_id3150647.46.help.text
#: 01040200.xhp%23hd_id3150647.46.help.text
msgctxt "01040200.xhp#hd_id3150647.46.help.text"
msgid "Comments"
msgstr "Մեկնաբանություններ"

#: 01040200.xhp#par_id3159335.47.help.text
#: 01040200.xhp%23par_id3159335.47.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_CONTENT_OPT:CB_POSTIT\">Displays comments. Click "
"a comment to edit the text. Use the context menu in Navigator to locate or "
"delete a comment. Use the comments's context menu to delete this comment or "
"all comments or all comments of this author.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_CONTENT_OPT:CB_POSTIT\">Ցուցադրում է "
"մեկնաբանությունները: Տեքստը խմբագրելու համար կտտացրեք մեկնաբանությանը: "
"Մեկնաբանությունը գտնելու կամ ջնջելու համար օգտագործեք Նավարկիչի "
"համատեքստային ընտրացանկը: Օգտագործեք մեկնաբանությունների համատեքստային ցանկը՝"
" ջնջելու համար այս մեկնաբանությունը, կամ բոլոր մեկնաբանությունները, կամ այս "
"հեղինակի բոլոր մեկնաբանությունները:</ahelp>"

#: 01040200.xhp#hd_id3147001.63.help.text
#: 01040200.xhp%23hd_id3147001.63.help.text
msgid "Settings (for HTML document only)"
msgstr "Կարգաբերումներ (միայն HTML փաստաթղթի համար)"

#: 01040200.xhp#hd_id3149926.58.help.text
#: 01040200.xhp%23hd_id3149926.58.help.text
msgid "Measurement unit (for HTML document only)"
msgstr "Չափման միավոր (միայն HTML փաստաթղթի համար)"

#: 01040200.xhp#par_id3154716.59.help.text
#: 01040200.xhp%23par_id3154716.59.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_CONTENT_OPT_LB_METRIC\">Specifies the <link href="
"\"text/shared/00/00000003.xhp#metrik\" name=\"Unit\">Unit</link> for HTML "
"documents.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_CONTENT_OPT_LB_METRIC\">Հատկորոշում է <link href="
"\"text/shared/00/00000003.xhp#metrik\" name=\"Միավոր\">Միավոր</link> HTML "
"փաստաթղթերի համար։</ahelp>"

#: viewcertificate_c.xhp#tit.help.text
#: viewcertificate_c.xhp%23tit.help.text
msgid "Certificate Path"
msgstr "Վկայագրի ուղին"

#: viewcertificate_c.xhp#par_idN1054D.help.text
#: viewcertificate_c.xhp%23par_idN1054D.help.text
msgid ""
"<variable id=\"certificatepath\"><link href=\""
"text/shared/optionen/viewcertificate_c.xhp\">Certificate "
"Path</link></variable>"
msgstr ""
"<variable id=\"certificatepath\"><link href=\""
"text/shared/optionen/viewcertificate_c.xhp\">Վկայագրի ուղին</link></variable>"

#: viewcertificate_c.xhp#par_idN1056B.help.text
#: viewcertificate_c.xhp%23par_idN1056B.help.text
msgid ""
"<ahelp hid=\".\">The Certificate Path page of the <link href=\""
"text/shared/optionen/viewcertificate.xhp\">View Certificate</link> dialog "
"displays the location and the status of the certificate.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Վկայագրի ուղու էջը <link href=\""
"text/shared/optionen/viewcertificate.xhp\">Դիտել վկայագիրը</link> "
"երկխոսությունում, ցույց է տալիս վկայագրի գտնվելու վայրը և "
"կարգավիճակը:</ahelp>"

#: 01040301.xhp#tit.help.text
#: 01040301.xhp%23tit.help.text
msgctxt "01040301.xhp#tit.help.text"
msgid "Change default template"
msgstr "Փոխեք լռելյայն կաղապարը"

#: 01040301.xhp#hd_id3156327.1.help.text
#: 01040301.xhp%23hd_id3156327.1.help.text
msgctxt "01040301.xhp#hd_id3156327.1.help.text"
msgid "Change default template"
msgstr "Փոխեք լռելյայն կաղապարը"

#: 01080000.xhp#tit.help.text
#: 01080000.xhp%23tit.help.text
msgid "Drawing Options"
msgstr "Նկարելու ընտրանքներ"

#: 01080000.xhp#hd_id3155135.1.help.text
#: 01080000.xhp%23hd_id3155135.1.help.text
msgid "%PRODUCTNAME Draw Options"
msgstr "%PRODUCTNAME Draw ընտրանքներ"

#: 01080000.xhp#par_id3158430.2.help.text
#: 01080000.xhp%23par_id3158430.2.help.text
msgid ""
"<variable id=\"allgemein\"><ahelp hid=\".uno:SdGraphicOptions\">Defines the "
"global settings for drawing documents, including the contents to be "
"displayed, the scale to be used, the grid alignment and the contents to be "
"printed by default.</ahelp></variable>"
msgstr ""
"<variable id=\"allgemein\"><ahelp hid=\".uno:SdGraphicOptions\">Սահմանում է "
"փաստաթղթերի նկարչության համընդգրկուն կարգավորումները, ներառյալ ցուցադրվող "
"բովանդակությունը, օգտագործվող սանդղակը, ցանցի հավասարեցումը և տպվող լռելյայն "
"բովանդակությունը:</ahelp></variable>"

#: serverauthentication.xhp#tit.help.text
#: serverauthentication.xhp%23tit.help.text
msgctxt "serverauthentication.xhp#tit.help.text"
msgid "Server Authentication"
msgstr "Սպասարկիչի Վավերության ստուգում"

#: serverauthentication.xhp#par_idN1053E.help.text
#: serverauthentication.xhp%23par_idN1053E.help.text
msgid ""
"<link href=\"text/shared/optionen/serverauthentication.xhp\">Server "
"Authentication</link>"
msgstr ""
"<link href=\"text/shared/optionen/serverauthentication.xhp\">Սպասարկիչի "
"Վավերության ստուգում</link>"

#: serverauthentication.xhp#par_idN1054E.help.text
#: serverauthentication.xhp%23par_idN1054E.help.text
msgid ""
"On the <switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME -"
" Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - <link href=\""
"text/shared/optionen/mailmerge.xhp\">%PRODUCTNAME Writer - Mail Merge "
"E-mail</link> tab page, click the <emph>Server Authentication</emph> button "
"to specify the server security settings."
msgstr ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Նախապատվություններ</caseinline><defaultinline>Գործիքներ - "
"Ընտրանքներ</defaultinline></switchinline> - <link href=\""
"text/shared/optionen/mailmerge.xhp\">%PRODUCTNAME Writer - Նամակ ձուլել "
"էլ․նամակը</link> ներդիրի էջում, կտտացրեք <emph>Սպասարկիչի վավերության "
"ստուգում</emph> կոճակը, կայանի անվտանգության պարամետրերը նշելու համար:"

#: serverauthentication.xhp#par_idN10563.help.text
#: serverauthentication.xhp%23par_idN10563.help.text
msgid "The outgoing mail server (SMTP) requires authentication"
msgstr "Ելքային փոստի կայանը (SMTP) պահանջում է նույնականացում"

#: serverauthentication.xhp#par_idN105BE.help.text
#: serverauthentication.xhp%23par_idN105BE.help.text
msgid ""
"<ahelp hid=\".\">Enables the authentication that is required to send e-mail "
"by SMTP.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Թույլատրում է նույնականացմանը, որը պահանջվում է SMTP- ով էլ-"
"նամակ ուղարկելու համար:</ahelp>"

#: serverauthentication.xhp#par_idN105CD.help.text
#: serverauthentication.xhp%23par_idN105CD.help.text
msgid "The outgoing mail server (SMTP) requires separate authentication"
msgstr "Ելքային փոստի կայանը (SMTP) պահանջում է առանձին վավերացում"

#: serverauthentication.xhp#par_idN105D2.help.text
#: serverauthentication.xhp%23par_idN105D2.help.text
msgid ""
"<ahelp hid=\".\">Select if your SMTP server requires a user name and "
"password.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք, արդյոք ձեր SMTP կայանը պահանջում է օգտվողի անուն և "
"գաղտնաբառ:</ahelp>"

#: serverauthentication.xhp#par_idN105E5.help.text
#: serverauthentication.xhp%23par_idN105E5.help.text
msgctxt "serverauthentication.xhp#par_idN105E5.help.text"
msgid "User name"
msgstr "Օգտվողի անուն"

#: serverauthentication.xhp#par_idN105EA.help.text
#: serverauthentication.xhp%23par_idN105EA.help.text
msgid "<ahelp hid=\".\">Enter the user name for the SMTP server.</ahelp>"
msgstr "<ahelp hid=\".\">Մուտքագրեք SMTP կայանի օգտվողի անունը:</ahelp>"

#: serverauthentication.xhp#par_idN105FD.help.text
#: serverauthentication.xhp%23par_idN105FD.help.text
msgctxt "serverauthentication.xhp#par_idN105FD.help.text"
msgid "Password"
msgstr "Գաղտնաբառ"

#: serverauthentication.xhp#par_idN10602.help.text
#: serverauthentication.xhp%23par_idN10602.help.text
msgid "<ahelp hid=\".\">Enter the password for the user name.</ahelp>"
msgstr "<ahelp hid=\".\">Մուտքագրեք օգտվողի անվան գաղտնաբառը:</ahelp>"

#: serverauthentication.xhp#par_idN10615.help.text
#: serverauthentication.xhp%23par_idN10615.help.text
msgid ""
"The outgoing mail server uses the same authentication as the incoming mail "
"server."
msgstr ""
"Ելքային փոստի կայանը օգտագործում է նույն նույնականացումը, ինչ մուտքային "
"փոստի կայանը:"

#: serverauthentication.xhp#par_idN1061A.help.text
#: serverauthentication.xhp%23par_idN1061A.help.text
msgid ""
"<ahelp hid=\".\">Select if you are required to first read your e-mail before "
"you can send e-mail.</ahelp> This method is also called \"SMTP after POP3\"."
msgstr ""
"<ahelp hid=\".\">Ընտրեք, եթե պահանջվում է նախ կարդալ ձեր էլ-նամակը, նախքան "
"էլ-նամակ ուղարկելը:</ahelp> Այս մեթոդը կոչվում է նաև «SMTP POP3 -ից հետո»:"

#: serverauthentication.xhp#par_idN10629.help.text
#: serverauthentication.xhp%23par_idN10629.help.text
msgctxt "serverauthentication.xhp#par_idN10629.help.text"
msgid "Server name"
msgstr "Կայանի անունը"

#: serverauthentication.xhp#par_idN1062C.help.text
#: serverauthentication.xhp%23par_idN1062C.help.text
msgid ""
"<ahelp hid=\".\">Enter the server name of your POP 3 or IMAP mail "
"server.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Մուտքագրեք ձեր POP 3 կամ IMAP փոստային կայանի համար սերվերի "
"անունը:</ahelp>"

#: serverauthentication.xhp#par_idN1063B.help.text
#: serverauthentication.xhp%23par_idN1063B.help.text
msgctxt "serverauthentication.xhp#par_idN1063B.help.text"
msgid "Port"
msgstr "Հանգույց"

#: serverauthentication.xhp#par_idN10640.help.text
#: serverauthentication.xhp%23par_idN10640.help.text
msgid "<ahelp hid=\".\">Enter the port on the POP3 or IMAP server.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Մուտքագրեք հանգույցը POP3 կամ IMAP կայանի համար:</ahelp>"

#: serverauthentication.xhp#par_idN10653.help.text
#: serverauthentication.xhp%23par_idN10653.help.text
msgid "POP 3"
msgstr "POP 3"

#: serverauthentication.xhp#par_idN10658.help.text
#: serverauthentication.xhp%23par_idN10658.help.text
msgid ""
"<ahelp hid=\".\">Specifies that the incoming mail server uses POP 3.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Նշում է, որ մուտքային փոստի կայանն օգտագործում է POP "
"3:</ahelp>"

#: serverauthentication.xhp#par_idN10667.help.text
#: serverauthentication.xhp%23par_idN10667.help.text
msgid "IMAP"
msgstr "IMAP"

#: serverauthentication.xhp#par_idN1066A.help.text
#: serverauthentication.xhp%23par_idN1066A.help.text
msgid ""
"<ahelp hid=\".\">Specifies that the incoming mail server uses IMAP.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Նշում է, որ մուտքային փոստի կայանն օգտագործում է "
"IMAP:</ahelp>"

#: serverauthentication.xhp#par_idN10679.help.text
#: serverauthentication.xhp%23par_idN10679.help.text
msgctxt "serverauthentication.xhp#par_idN10679.help.text"
msgid "User name"
msgstr "Օգտվողի անուն"

#: serverauthentication.xhp#par_idN1067E.help.text
#: serverauthentication.xhp%23par_idN1067E.help.text
msgid "<ahelp hid=\".\">Enter the user name for the IMAP server.</ahelp>"
msgstr "<ahelp hid=\".\">Մուտքագրեք IMAP կայանի օգտվողի անունը:</ahelp>"

#: serverauthentication.xhp#par_idN10691.help.text
#: serverauthentication.xhp%23par_idN10691.help.text
msgctxt "serverauthentication.xhp#par_idN10691.help.text"
msgid "Password"
msgstr "Գաղտնաբառ"

#: serverauthentication.xhp#par_idN10696.help.text
#: serverauthentication.xhp%23par_idN10696.help.text
msgid "<ahelp hid=\".\">Enter the password.</ahelp>"
msgstr "<ahelp hid=\".\">Մուտքագրեք գաղտնաբառը:</ahelp>"

