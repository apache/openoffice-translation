#: 01070100.xhp#par_id3147443.26.help.text
#: 01070100.xhp%23par_id3147443.26.help.text
msgid ""
"<ahelp hid=\"SD_CHECKBOX_TP_OPTIONS_CONTENTS_CBX_RULER\">Specifies whether "
"to display the rulers at the top and to the left of the work area.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_CHECKBOX_TP_OPTIONS_CONTENTS_CBX_RULER\">Նշում է՝ արդյոք "
"ցույց տալ քանոնները աշխատանքային տարածքի վերևում և ձախում:</ahelp>"

#: 01070100.xhp#hd_id3145364.27.help.text
#: 01070100.xhp%23hd_id3145364.27.help.text
msgid "Guides when moving"
msgstr "Ուղեցույցներ շարժվելիս"

#: 01070100.xhp#par_id3154147.28.help.text
#: 01070100.xhp%23par_id3154147.28.help.text
msgid ""
"<variable id=\"verschieb\"><ahelp hid=\""
"SD_CHECKBOX_TP_OPTIONS_CONTENTS_CBX_HELPLINES\">Specifies whether to display "
"guides when moving an object.</ahelp></variable>"
msgstr ""
"<variable id=\"verschieb\"><ahelp hid=\""
"SD_CHECKBOX_TP_OPTIONS_CONTENTS_CBX_HELPLINES\">Նշում է, թե արդյոք "
"առարկաները տեղափոխելիս ցուցիչները պետք է ցուցադրվեն:</ahelp></variable>"

#: 01070100.xhp#par_id3150488.29.help.text
#: 01070100.xhp%23par_id3150488.29.help.text
msgid ""
"<variable id=\"vertext\"><item type=\"productname\">%PRODUCTNAME</item> "
"creates dotted guides that extend beyond the box containing the selected "
"object and which cover the entire work area, helping you position the "
"object. </variable>"
msgstr ""
"<variable id=\"vertext\"><item type=\"productname\">%PRODUCTNAME</item> "
"ստեղծում է կետերով ուղեցույցներ, որոնք տարածվում են ընտրված առարկան "
"պարունակող տուփի սահմաններից այն կողմ և որոնք ընդգրկում են ամբողջ "
"աշխատանքային տարածքը՝ օգնելով ձեզ դիրքավորելու առարկան: </variable>"

#: 01070100.xhp#par_id3153365.30.help.text
#: 01070100.xhp%23par_id3153365.30.help.text
msgid ""
"You also can use this function through the <switchinline select=\"appl\"><"
"caseinline select=\"IMPRESS\"><link href=\"text/shared/02/01171400.xhp\" "
"name=\"Icon\">icon</link></caseinline><caseinline select=\"DRAW\"><link href="
"\"text/shared/02/01171400.xhp\" name=\"Icon\""
">icon</link></caseinline><defaultinline>icon</defaultinline></switchinline> "
"with the same name in the <emph>Options</emph> bar if a presentation or a "
"drawing document is opened."
msgstr ""
"Կարող եք նաև օգտագործել այս գործառույթը <switchinline select=\"appl\"><"
"caseinline select=\"IMPRESS\"><link href=\"text/shared/02/01171400.xhp\" "
"name=\"Պատկերակ\">պատկերակ</link></caseinline><caseinline select=\"DRAW\"><"
"link href=\"text/shared/02/01171400.xhp\" name=\"Պատկերակ\">պատկերակ</link></"
"caseinline><defaultinline>պատկերակ</defaultinline></switchinline> միջոցով, "
"նույն անունով <emph>Ընտրանքներ</emph> վահանակում, եթե շնորհանդեսի կամ "
"նկարչական փաստաթուղթ է բացվում:"

#: 01070100.xhp#hd_id3155306.31.help.text
#: 01070100.xhp%23hd_id3155306.31.help.text
msgid "All control points in Bézier editor"
msgstr "Բեզիերի խմբագրիչում հսկման բոլոր կետերը"

#: 01070100.xhp#par_id3153877.32.help.text
#: 01070100.xhp%23par_id3153877.32.help.text
msgid ""
"<ahelp hid=\"SD_CHECKBOX_TP_OPTIONS_CONTENTS_CBX_HANDLES_BEZIER\">Displays "
"the control points of all Bézier points if you have previously selected a <"
"link href=\"text/shared/00/00000005.xhp#bezierobjekt\" name=\"Bézier curve\">"
"Bézier curve</link>. If the <emph>All control points in Bézier</emph> editor "
"option is not marked, only the control points of the selected Bézier points "
"will be visible.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_CHECKBOX_TP_OPTIONS_CONTENTS_CBX_HANDLES_BEZIER\">Ցուցադրում "
"է Բեզիերի բոլոր կետերի կառավարման կետերը, եթե նախկինում ընտրել եք <link href="
"\"text/shared/00/00000005.xhp#bezierobjekt\" name=\"Բեզիերի կոր\">Բեզիերի "
"կոր</link>։ Եթե <emph>Հսկման բոլոր կետերը Բեզիերում</emph> խմբագրիչում "
"տարբերակը նշված չէ, տեսանելի կլինեն միայն ընտրված Բեզիեր կետերի հսկման "
"կետերը:</ahelp>"

#: 01070100.xhp#hd_id3149418.33.help.text
#: 01070100.xhp%23hd_id3149418.33.help.text
msgid "Contour of each individual object"
msgstr "Յուրաքանչյուր առանձին առարկայի ուրվագիծ"

#: 01070100.xhp#par_id3156284.34.help.text
#: 01070100.xhp%23par_id3156284.34.help.text
msgid ""
"<ahelp hid=\"SD_CHECKBOX_TP_OPTIONS_CONTENTS_CBX_MOVE_OUTLINE\"><item type=\""
"productname\">%PRODUCTNAME</item> displays the contour line of each "
"individual object when moving this object.</ahelp> The <emph>Contour of each "
"individual object </emph>option enables you to see if single objects "
"conflict with other objects in the target position. If you do not mark the "
"<emph>Contour of each individual object </emph>option, <item type=\""
"productname\">%PRODUCTNAME</item> only displays a square contour that "
"includes all selected objects."
msgstr ""
"<ahelp hid=\"SD_CHECKBOX_TP_OPTIONS_CONTENTS_CBX_MOVE_OUTLINE\"><item type=\""
"productname\">%PRODUCTNAME</item> ցուցադրում է յուրաքանչյուր առարկայի "
"ուրվագծային գիծը այս առարկան տեղափոխելիս:</ahelp> <emph>Յուրաքանչյուր "
"առանձին առարկայի ուրվագծի </emph> ընտրանքը հնարավորություն է տալիս տեսնել, "
"թե արդյոք առանձին առարկաները հակասության մեջ են նպատակային դիրքում գտնվող "
"այլ առարկաների հետ: Եթե չեք նշում <emph>Յուրաքանչյուր առանձին առարկայի "
"ուրվագիծ </emph>ընտրանքհը, <item type=\"productname\">%PRODUCTNAME</item> "
"ցուցադրվում է միայն քառակուսի ուրվագիծ, որը ներառում է բոլոր ընտրված "
"առարկաները:"

#: 01010700.xhp#tit.help.text
