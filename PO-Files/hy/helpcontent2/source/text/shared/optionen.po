#: 01040900.xhp#par_id3150417.34.help.text
#: 01040900.xhp%23par_id3150417.34.help.text
msgid ""
"<ahelp hid=\"SW_METRICFIELD_TP_OPTLOAD_PAGE_MF_TAB\">Specifies the spacing "
"between the individual tab stops.</ahelp> The horizontal ruler displays the "
"selected spacing."
msgstr ""
"<ahelp hid=\"SW_METRICFIELD_TP_OPTLOAD_PAGE_MF_TAB\">Նշում է անհատական "
"ներդիրի կանգերի միջև հեռավորությունը:</ahelp> Հորիզոնական քանոնը ցուցադրում "
"է ընտրված տարածությունը:"

