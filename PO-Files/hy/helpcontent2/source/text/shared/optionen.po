msgstr ""
"<switchinline select=\"appl\"><caseinline select=\"WRITER\"></caseinline><"
"caseinline select=\"CALC\"></caseinline><caseinline select=\"CHART\""
"></caseinline><caseinline select=\"MATH\"></caseinline><defaultinline>"
"Շնորհանդեսի կամ նկարչական փաստաթղթում կարող եք նաև ակտիվացնել տեքստի "
"խմբագրման ռեժիմը <emph>Թույլատրել արագ խմբագրումը</emph> <link href=\""
"text/simpress/02/13180000.xhp\" name=\"պատկերակով\">պատկերակով</link> "
"<emph>Ընտրանք</emph> վահանակում։</defaultinline></switchinline>"

#: 01070500.xhp#hd_id3154686.7.help.text
#: 01070500.xhp%23hd_id3154686.7.help.text
msgid "Only text area selectable"
msgstr "Ընտրելի է միայն տեքստի տարածքը"

#: 01070500.xhp#par_id3149808.8.help.text
#: 01070500.xhp%23par_id3149808.8.help.text
