#: 01060400.xhp#tit.help.text
#: 01060400.xhp%23tit.help.text
msgid "Sort Lists"
msgstr "Տեսակավորել ցուցակներ"

#: 01060400.xhp#hd_id3145382.1.help.text
#: 01060400.xhp%23hd_id3145382.1.help.text
msgid ""
"<link href=\"text/shared/optionen/01060400.xhp\" name=\"Sort Lists\">Sort "
"Lists</link>"
msgstr ""
"<link href=\"text/shared/optionen/01060400.xhp\" name=\"Տեսակավորել "
"ցուցակներ\">Տեսակավորել ցուցակներ</link>"

#: 01060400.xhp#par_id3153825.2.help.text
#: 01060400.xhp%23par_id3153825.2.help.text
msgid ""
"<ahelp hid=\"HID_SCPAGE_USERLISTS\">All user-defined lists are displayed in "
"the<emph> Sort Lists </emph>dialog. You can also define and edit your own "
"lists. Only text can be used as sort lists, no numbers.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_SCPAGE_USERLISTS\">Օգտագործողի կողմից սահմանված բոլոր "
"ցուցակները ցուցադրվում են <emph>Տեսակավորել ցուցակները</emph> երկխոսության "
"մեջ: Կարող եք նաև սահմանել և խմբագրել ձեր սեփական ցուցակները: Միայն տեքստը "
"կարող է օգտագործվել որպես տեսակավորման ցուցակներ, առանց թվերի:</ahelp>"

#: 01060400.xhp#hd_id3149416.3.help.text
#: 01060400.xhp%23hd_id3149416.3.help.text
msgid "Lists"
msgstr "Ցանկերը"

#: 01060400.xhp#par_id3150503.4.help.text
#: 01060400.xhp%23par_id3150503.4.help.text
msgid ""
"<ahelp hid=\"SC:LISTBOX:RID_SCPAGE_USERLISTS:LB_LISTS\">Displays all the "
"available lists. These lists can be selected for editing.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:LISTBOX:RID_SCPAGE_USERLISTS:LB_LISTS\">Ցուցադրում է բոլոր "
"մատչելի ցուցակները: Այս ցուցակները կարող են ընտրվել խմբագրման համար:</ahelp>"

#: 01060400.xhp#hd_id3147531.5.help.text
#: 01060400.xhp%23hd_id3147531.5.help.text
msgid "Entries"
msgstr "Մուտքեր"

#: 01060400.xhp#par_id3149669.6.help.text
#: 01060400.xhp%23par_id3149669.6.help.text
msgid ""
"<ahelp hid=\"SC:MULTILINEEDIT:RID_SCPAGE_USERLISTS:ED_ENTRIES\">Displays the "
"content of the currently selected list. This content can be edited.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:MULTILINEEDIT:RID_SCPAGE_USERLISTS:ED_ENTRIES\">Ցուցադրում է "
"ներկայումս ընտրված ցուցակի բովանդակությունը: Այս բովանդակությունը կարող է "
"խմբագրվել:</ahelp>"

#: 01060400.xhp#hd_id3145069.7.help.text
#: 01060400.xhp%23hd_id3145069.7.help.text
msgid "Copy list from"
msgstr "Պատճենիր ցուցակը"

#: 01060400.xhp#par_id3149457.8.help.text
#: 01060400.xhp%23par_id3149457.8.help.text
msgid ""
"<ahelp hid=\"SC:EDIT:RID_SCPAGE_USERLISTS:ED_COPYFROM\">Defines the "
"spreadsheet and the cells to copy, in order to include them in the "
"<emph>Lists</emph> box. The currently selected range in the spreadsheet is "
"the default.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:EDIT:RID_SCPAGE_USERLISTS:ED_COPYFROM\">Սահմանում է փռված "
"թերթիկը և պատճենահանման բջիջները` դրանք ներառելու համար "
"<emph>Ցուցակներ</emph> վանդակում։ Փռված թերթիկում ներկայումս ընտրված "
"տիրույթը լռելյայն է:</ahelp>"

#: 01060400.xhp#hd_id3151211.13.help.text
#: 01060400.xhp%23hd_id3151211.13.help.text
msgid "Copy"
msgstr "Պատճենել"

#: 01060400.xhp#par_id3158409.14.help.text
#: 01060400.xhp%23par_id3158409.14.help.text
msgid ""
"<ahelp hid=\"SC:PUSHBUTTON:RID_SCPAGE_USERLISTS:BTN_COPY\">Copies the "
"contents of the cells in the <emph>Copy list from</emph> box. If you select "
"a reference to related rows and columns, the <link href=\""
"text/shared/optionen/01060401.xhp\" name=\"Copy List\"><emph>Copy "
"List</emph></link> dialog appears after clicking the button. You can use "
"this dialog to define if the reference is converted to sort lists by row or "
"by column.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:PUSHBUTTON:RID_SCPAGE_USERLISTS:BTN_COPY\">Պատճենում է "
"բջիջների պարունակությունը <emph>Պատճենել ցուցակը</emph> վանդակում: Եթե "
"ընտրում եք հղում հարակից տողերին և սյունակներին, ապա հայտնվում է <link href="
"\"text/shared/optionen/01060401.xhp\" name=\"Պատճենել ցուցակը\"><emph>"
"Պատճենել ցուցակը</emph></link> երկխոսությունը, կոճակը սեղմելուց հետո: Կարող "
"եք օգտագործել այս երկխոսությունը` որոշելու համար, թե արդյոք հղումը "
"վերափոխվում է տեսակավորված ցուցակների՝ ըստ տողի կամ ըստ սյունակի:</ahelp>"

#: 01060400.xhp#hd_id3154684.9.help.text
#: 01060400.xhp%23hd_id3154684.9.help.text
msgid "New/Discard"
msgstr "Նոր/Հեռացնել"

#: 01060400.xhp#par_id3153970.10.help.text
#: 01060400.xhp%23par_id3153970.10.help.text
msgid ""
"<ahelp hid=\"SC:PUSHBUTTON:RID_SCPAGE_USERLISTS:BTN_NEW\">Enters the "
"contents of a new list into the <emph>Entries</emph> box.</ahelp> This "
"button will change from <emph>New</emph> to <emph>Discard</emph>, which "
"enables you to delete the new list."
msgstr ""
"<ahelp hid=\"SC:PUSHBUTTON:RID_SCPAGE_USERLISTS:BTN_NEW\">Նոր ցուցակի "
"բովանդակությունը մուտքագրում է <emph>Մուտքեր</emph> վանդակում:</ahelp> Այս "
"կոճակը կփոխվի <emph>Նոր</emph> -ից <emph>Հեռացնել</emph>, ինչը "
"հնարավորություն է տալիս ջնջել նոր ցուցակը:"

#: 01060400.xhp#hd_id3144760.11.help.text
#: 01060400.xhp%23hd_id3144760.11.help.text
msgid "Add/Modify"
msgstr "Ավելացնել/Ձևափոխել"

#: 01060400.xhp#par_id3145785.12.help.text
#: 01060400.xhp%23par_id3145785.12.help.text
msgid ""
"<ahelp hid=\"SC:PUSHBUTTON:RID_SCPAGE_USERLISTS:BTN_ADD\">Adds a new list "
"into the <emph>Lists</emph> box.</ahelp> If you would like to edit this list "
"in the <emph>Entries</emph> box, this button will change from "
"<emph>Add</emph> to <emph>Modify</emph>, which enables you to include the "
"newly modified list."
msgstr ""
"<ahelp hid=\"SC:PUSHBUTTON:RID_SCPAGE_USERLISTS:BTN_ADD\">Նոր ցուցակ է "
"ավելացնում <emph>Ցուցակներ</emph> վանդակում:</ahelp> Եթե ցանկանում եք "
"խմբագրել այս ցուցակը <emph>Մուտքեր</emph> վանդակում, այս կոճակը կփոխվի "
