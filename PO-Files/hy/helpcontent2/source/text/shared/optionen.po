#: 01000000.xhp#par_id3151384.2.help.text
#: 01000000.xhp%23par_id3151384.2.help.text
msgid ""
"<ahelp hid=\".uno:OptionsTreeDialog\">This command opens a dialog for a "
"customized program configuration.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:OptionsTreeDialog\">Այս հրամանը բացում է երկխոսությունը "
"անհատականացված ծրագրի կազմաձևման համար:</ahelp>"

#: 01000000.xhp#par_id3156344.18.help.text
#: 01000000.xhp%23par_id3156344.18.help.text
msgid ""
"All your settings are saved automatically. To expand an entry either double "
"click this entry or click the plus sign. To collapse the entry, click the "
"minus sign or double click the entry."
msgstr ""
"Ձեր բոլոր կարգաբերումները ինքնաշխատ կերպով պահվում են: Գրառումն ընդլայնելու "
"համար կամ կրկնակի կտտացրեք այս գրառմանը կամ կտտացրեք պլյուս նշանին: Գրառումը "
"փլուզելու համար կտտացրեք մինուս նշանին կամ կրկնակի սեղմեք գրառումը:"

#: 01000000.xhp#par_idN10607.help.text
#: 01000000.xhp%23par_idN10607.help.text
msgid ""
"You see only the entries that are applicable to the current document. If the "
"current document is a text document, you see the %PRODUCTNAME Writer entry, "
"and so on for all modules of %PRODUCTNAME. %PRODUCTNAME Impress and %"
"PRODUCTNAME Draw are treated as the same in this dialog. The common entries "
"are always visible."
msgstr ""
"Դուք տեսնում եք միայն այն մուտքերը, որոնք կիրառելի են ընթացիկ փաստաթղթի "
"համար: Եթե ընթացիկ փաստաթուղթը տեքստային փաստաթուղթ է, %PRODUCTNAME -ի բոլոր "
"մոդուլների համար տեսնում եք %PRODUCTNAME Writer գրառումը և այլն: %"
"PRODUCTNAME Impress -ը և %PRODUCTNAME Draw -ն այս երկխոսության մեջ նույնն են:"
" Ընդհանուր մուտքերը միշտ տեսանելի են:"

#: 01000000.xhp#par_id3125863.13.help.text
#: 01000000.xhp%23par_id3125863.13.help.text
msgid ""
"<ahelp hid=\"HID_OFADLG_TREELISTBOX\" visibility=\"hidden\">Select an entry "
"to edit.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_OFADLG_TREELISTBOX\" visibility=\"hidden\">Ընտրեք մուտքը "
"խմբագրելու համար։</ahelp>"

#: 01000000.xhp#par_id1013200911280529.help.text
#: 01000000.xhp%23par_id1013200911280529.help.text
msgid ""
"Note for Mac OS X users: The Help mentions the menu path Tools - Options at "
"numerous places. Replace this path with %PRODUCTNAME - Preferences on your "
"Mac OS X main menu. Both menu entries open the Options dialog box."
msgstr ""
"Նշում Mac OS X օգտագործողների համար. Օգնությունը նշում է ընտրացանկի ուղին "
"Գործիքներ - Ընտրանքներ բազմաթիվ տեղերում: Փոխարինեք այս ուղին %PRODUCTNAME - "
"Նախապատվություններ ձեր Mac OS X հիմնական ընտրացանկում: Ընտրացանկի երկու "
"մուտքերը բացում են Ընտրանքներ երկխոսության տուփը:"

