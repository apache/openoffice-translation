#: 01110100.xhp%23par_id3145345.4.help.text
msgid ""
"<ahelp hid=\"SCH:LISTBOX:TP_DEF_COLOR:LB_CHART_COLOR_LIST\">Displays all the "
"colors available for the data series.</ahelp> Select a data series to change "
"its color. Select the desired color from the adjacent color table."
msgstr ""
"<ahelp hid=\"SCH:LISTBOX:TP_DEF_COLOR:LB_CHART_COLOR_LIST\">Ցուցադրում է "
"տվյալների շարքի համար առկա բոլոր գույները:</ahelp> Ընտրեք տվյալների շարքը` "
"դրա գույնը փոխելու համար: Հարակից գունային աղյուսակից ընտրեք ցանկալի գույնը:"

#: 01110100.xhp#hd_id3154823.5.help.text
