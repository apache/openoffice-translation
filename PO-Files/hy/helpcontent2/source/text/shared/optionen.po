"արդյոք պետք է մասշտաբավորել ընթացիկ տպիչի լուսանցքից դուրս գտնվող "
"առարկաները, որպեսզի դրանք տեղավորվեն տպիչի թղթի վրա:</ahelp>"

#: 01070400.xhp#hd_id3155764.29.help.text
#: 01070400.xhp%23hd_id3155764.29.help.text
msgid "Tile pages"
msgstr "Սալիկների տեսքով էջեր"

#: 01070400.xhp#par_id3154255.30.help.text
#: 01070400.xhp%23par_id3154255.30.help.text
msgid ""
"<ahelp hid=\"SD:RADIOBUTTON:TP_PRINT_OPTIONS:RBT_PAGETILE\">Specifies that "
"pages are to be printed in tiled format. If the pages or slides are smaller "
"than the paper, several pages or slides will be printed on one page of "
"paper.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:RADIOBUTTON:TP_PRINT_OPTIONS:RBT_PAGETILE\">Նշում է, որ "
"էջերը պետք է տպվեն սալիկապատված ձևաչափով: Եթե էջերը կամ սահիկները թղթից փոքր "
"են, մի էջի վրա կտպագրվեն մի քանի էջեր կամ սահիլներ:</ahelp>"

#: 01070400.xhp#hd_id3150388.31.help.text
#: 01070400.xhp%23hd_id3150388.31.help.text
msgctxt "01070400.xhp#hd_id3150388.31.help.text"
msgid "Brochure"
msgstr "Գրքույկ"

#: 01070400.xhp#par_id3147322.32.help.text
#: 01070400.xhp%23par_id3147322.32.help.text
msgid ""
"<ahelp hid=\"SD:RADIOBUTTON:TP_PRINT_OPTIONS:RBT_BOOKLET\">Select the<emph> "
"Brochure </emph>option to print the document in brochure format.</ahelp> You "
"can also decide if you want to print the front, the back or both sides of "
"the brochure."
msgstr ""
"<ahelp hid=\"SD:RADIOBUTTON:TP_PRINT_OPTIONS:RBT_BOOKLET\">Ընտրեք<emph> "
"Գրքույկ </emph>տարբերակը, փաստաթուղթը գրքույկի ձևաչափով տպելու համար:</ahelp>"
" Կարող եք նաև որոշել, արդյոք ցանկանում եք տպել գրքույկի առջևի, հետևի կամ "
"երկու կողմերը:"

#: 01070400.xhp#hd_id3145790.35.help.text
#: 01070400.xhp%23hd_id3145790.35.help.text
msgid "Front"
msgstr "Առջև"

#: 01070400.xhp#par_id3145766.36.help.text
#: 01070400.xhp%23par_id3145766.36.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:TP_PRINT_OPTIONS:CBX_FRONT\">Select<emph> Front "
"</emph>to print the front of a brochure.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:TP_PRINT_OPTIONS:CBX_FRONT\">Ընտրեք<emph> Առջև "
"</emph>գրքույկի առջևը տպելու համար:</ahelp>"

#: 01070400.xhp#hd_id3145760.37.help.text
#: 01070400.xhp%23hd_id3145760.37.help.text
msgctxt "01070400.xhp#hd_id3145760.37.help.text"
msgid "Back"
msgstr "Հետև"

#: 01070400.xhp#par_id3154118.38.help.text
#: 01070400.xhp%23par_id3154118.38.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:TP_PRINT_OPTIONS:CBX_BACK\">Select <emph>Back</emph>"
" to print the back of a brochure.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:TP_PRINT_OPTIONS:CBX_BACK\">Ընտրեք <emph>Հետև</emph>"
" գրքույկի հետևը տպելու համար:</ahelp>"

#: 01070400.xhp#hd_id3153704.41.help.text
#: 01070400.xhp%23hd_id3153704.41.help.text
msgctxt "01070400.xhp#hd_id3153704.41.help.text"
msgid "Paper tray from printer settings"
msgstr "Թղթի սկուտեղ տպիչի կարգավորումներից"

#: 01070400.xhp#par_id3150380.42.help.text
#: 01070400.xhp%23par_id3150380.42.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:TP_PRINT_OPTIONS:CBX_PAPERBIN\">Determines that the "
"paper tray to be used is the one defined in the printer setup.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:TP_PRINT_OPTIONS:CBX_PAPERBIN\">Սահմանում է, որ "
"օգտագործվող թղթի սկուտեղը տպիչի կարգավորման մեջ սահմանվածն է:</ahelp>"

#: javaparameters.xhp#tit.help.text
#: javaparameters.xhp%23tit.help.text
msgid "Start Parameters"
msgstr "Սկսելու պարամետրերը"

#: javaparameters.xhp#par_idN10545.help.text
#: javaparameters.xhp%23par_idN10545.help.text
msgid "Java Start Parameters"
msgstr "Java-ն սկսելու պարամետրերը"

#: javaparameters.xhp#par_idN10549.help.text
#: javaparameters.xhp%23par_idN10549.help.text
msgid ""
"You can use this dialog to enter optional start parameters for the Java "
"runtime environment (JRE). The settings that you specify in this dialog are "
"valid for any JRE that you start."
msgstr ""
"Կարող եք օգտագործել այս երկխոսությունը` Java runtime environment (JRE) "
"մեկնարկի ընտրովի պարամետրերը մուտքագրելու համար: Այս երկխոսության մեջ նշված "
"պարամետրերը ուժի մեջ են ցանկացած JRE-ի համար, որը դուք սկսում եք:"

#: javaparameters.xhp#par_idN10568.help.text
#: javaparameters.xhp%23par_idN10568.help.text
msgid "Java Start parameter"
msgstr "Java-ն սկսելու պարամետրերը"

#: javaparameters.xhp#par_idN1056C.help.text
#: javaparameters.xhp%23par_idN1056C.help.text
msgid ""
"<ahelp hid=\"svx:Edit:RID_SVXDLG_JAVA_PARAMETER:ED_PARAMETER\">Enter a start "
"parameter for a JRE as you would on a command line. Click Assign to add the "
"parameter to the list of available start parameters.</ahelp>"
msgstr ""
"<ahelp hid=\"svx:Edit:RID_SVXDLG_JAVA_PARAMETER:ED_PARAMETER\">Մուտքագրեք "
"JRE-ի մեկնարկի պարամետրը, ինչպես դա անում եք հրամանի տողում: Կտտացրեք "
"Նշանակել՝ ավելացնելու պարամետրը մեկնարկի հնարավոր պարամետրերի "
"ցուցակին:</ahelp>"

#: javaparameters.xhp#par_id5404522.help.text
#: javaparameters.xhp%23par_id5404522.help.text
msgid "Do not use escape characters or quotes in path names."
msgstr "Ուղիների անուններում մի օգտագործեք փախուստի նիշեր կամ մեջբերումներ:"

#: javaparameters.xhp#par_idN105D8.help.text
#: javaparameters.xhp%23par_idN105D8.help.text
msgid ""
"For example, to point the system property \"myprop\" to a folder, enter the "
"following parameter:"
msgstr ""
"Օրինակ, \"myprop\" համակարգի հատկությունը թղթապանակին ուղղելու համար, "
"մուտքագրեք հետևյալ պարամետրը."

#: javaparameters.xhp#par_idN105DD.help.text
#: javaparameters.xhp%23par_idN105DD.help.text
msgid "-Dmyprop=c:\\program files\\java"
msgstr "-Dmyprop=c:\\program files\\java"

#: javaparameters.xhp#par_idN1057B.help.text
#: javaparameters.xhp%23par_idN1057B.help.text
msgid "To enable debugging in a JRE, enter the following parameters:"
msgstr "JRE-ում կարգաբերում թույլ տալու համար, մուտքագրեք հետևյալ պարամետրերը."

#: javaparameters.xhp#par_idN1057E.help.text
#: javaparameters.xhp%23par_idN1057E.help.text
msgid "-Xdebug"
msgstr "-Xdebug"

#: javaparameters.xhp#par_idN10581.help.text
#: javaparameters.xhp%23par_idN10581.help.text
msgid "-Xrunjdwp:transport=dt_socket,server=y,address=8000"
msgstr "-Xrunjdwp:transport=dt_socket,server=y,address=8000"

#: javaparameters.xhp#par_idN1060C.help.text
#: javaparameters.xhp%23par_idN1060C.help.text
msgid "These changes take effect after you restart %PRODUCTNAME."
msgstr ""
"Այս փոփոխություններն ուժի մեջ են մտնում %PRODUCTNAME -ը վերագործարկելուց "
"հետո:"

#: javaparameters.xhp#par_idN1058C.help.text
#: javaparameters.xhp%23par_idN1058C.help.text
msgid "Assigned start parameters"
msgstr "Նշանակված մեկնարկի պարամետրեր"

#: javaparameters.xhp#par_idN10590.help.text
#: javaparameters.xhp%23par_idN10590.help.text
msgid ""
"<ahelp hid=\"svx:ListBox:RID_SVXDLG_JAVA_PARAMETER:LB_ASSIGNED\">Lists the "
"assigned JRE start parameters. To remove a start parameter, select the "
"parameter, and then click <emph>Remove</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\"svx:ListBox:RID_SVXDLG_JAVA_PARAMETER:LB_ASSIGNED\">Թվարկում է "
"նշանակված JRE մեկնարկի պարամետրերը: Մեկնարկի պարամետրը հեռացնելու համար "
"ընտրեք պարամետրը և այնուհետև կտտացրեք <emph>Հեռացնել</emph>։</ahelp>"

#: javaparameters.xhp#par_idN105A7.help.text
#: javaparameters.xhp%23par_idN105A7.help.text
msgid "Assign"
msgstr "Նշանակել"

#: javaparameters.xhp#par_idN105AB.help.text
#: javaparameters.xhp%23par_idN105AB.help.text
msgid ""
"<ahelp hid=\"svx:PushButton:RID_SVXDLG_JAVA_PARAMETER:PB_ASSIGN\">Adds the "
"current JRE start parameter to the list.</ahelp>"
msgstr ""
"<ahelp hid=\"svx:PushButton:RID_SVXDLG_JAVA_PARAMETER:PB_ASSIGN\">Ցուցակում "
"ավելացնում է ընթացիկ JRE մեկնարկի պարամետրը:</ahelp>"

#: javaparameters.xhp#par_idN105C2.help.text
#: javaparameters.xhp%23par_idN105C2.help.text
msgctxt "javaparameters.xhp#par_idN105C2.help.text"
msgid "Remove"
msgstr "Հեռացնել"

#: javaparameters.xhp#par_idN105C6.help.text
#: javaparameters.xhp%23par_idN105C6.help.text
msgid ""
"<ahelp hid=\"svx:PushButton:RID_SVXDLG_JAVA_PARAMETER:PB_REMOVE\">Deletes "
"the selected JRE start parameter.</ahelp>"
msgstr ""
"<ahelp hid=\"svx:PushButton:RID_SVXDLG_JAVA_PARAMETER:PB_REMOVE\">Հեռացնում "
"է ընտրված JRE մեկնարկի պարամետրը:</ahelp>"

#: 01150000.xhp#tit.help.text
#: 01150000.xhp%23tit.help.text
msgctxt "01150000.xhp#tit.help.text"
msgid "Language Setting Options"
msgstr "Լեզվի կարգաբերման ընտրանքներ"

#: 01150000.xhp#bm_id3148668.help.text
#: 01150000.xhp%23bm_id3148668.help.text
msgid "<bookmark_value>languages;setting options</bookmark_value>"
msgstr "<bookmark_value>լեզուներ;կարգաբերման ընտրանքներ</bookmark_value>"

#: 01150000.xhp#hd_id3148668.1.help.text
#: 01150000.xhp%23hd_id3148668.1.help.text
msgctxt "01150000.xhp#hd_id3148668.1.help.text"
msgid "Language Setting Options"
msgstr "Լեզվի կարգաբերման ընտրանքներ"

#: 01150000.xhp#par_id3150499.2.help.text
#: 01150000.xhp%23par_id3150499.2.help.text
msgid ""
"<variable id=\"typotext\">Defines the properties for additional languages. "
"</variable>"
msgstr ""
"<variable id=\"typotext\">Սահմանում է լրացուցիչ լեզուների հատկությունները: "
"</variable>"

#: 01150000.xhp#par_id3153665.3.help.text
#: 01150000.xhp%23par_id3153665.3.help.text
msgid ""
"The <emph>Searching in Japanese</emph> and <emph>Asian Layout</emph> tab "
"pages are only visible if the <emph>Asian language support</emph> option in "
"the <emph>Languages</emph> tab page is activated and the <emph>Options</emph>"
" dialog is re-opened. The <emph>Complex Text Layout</emph> tab page is only "
"visible if the <emph>CTL support</emph> is enabled."
msgstr ""
"<emph>Փնտրում ճապոներենում</emph> և <emph>Ասիական դասավորություն</emph> "
"ներդիրների էջերը տեսանելի են միայն այն դեպքում, երբ <emph>Ասիական լեզվի "
"աջակցություն</emph> ընտրանքը <emph>Լեզուներ</emph> ներդիրի էջում ակտիվացված "
"է և <emph>Ընտրանքներ</emph> երկխոսությունը կրկին բացված է։ <emph>Բարդ տեքստի "
"դասավորություն</emph> ներդիրի էջը տեսանելի է միայն այն դեպքում, եթե միացված "
"է <emph>CTL աջակցությունը</emph>:"

#: macrosecurity_ts.xhp#tit.help.text
#: macrosecurity_ts.xhp%23tit.help.text
msgid "Trusted Sources"
msgstr "Վստահելի աղբյուրներ"

#: macrosecurity_ts.xhp#par_idN10549.help.text
#: macrosecurity_ts.xhp%23par_idN10549.help.text
msgid ""
"<variable id=\"macrosecurity_ts\"><link href=\""
"text/shared/optionen/macrosecurity_ts.xhp\">Trusted Sources</link></variable>"
msgstr ""
"<variable id=\"macrosecurity_ts\"><link href=\""
"text/shared/optionen/macrosecurity_ts.xhp\">Վստահելի "
"աղբյուրներ</link></variable>"

#: macrosecurity_ts.xhp#par_idN10567.help.text
#: macrosecurity_ts.xhp%23par_idN10567.help.text
msgid ""
"Specifies the <link href=\"text/shared/optionen/macrosecurity.xhp\">macro "
"security</link> settings for trusted certificates and trusted file locations."
msgstr ""
"Հատկորոշում է <link href=\"text/shared/optionen/macrosecurity.xhp\">մակրո "
"անվտանգություն</link> կարգաբերումները վստահելի վկայագրերի և վստահելի նիշքերի "
"տեղադրությունների համար։"

#: macrosecurity_ts.xhp#par_idN10578.help.text
#: macrosecurity_ts.xhp%23par_idN10578.help.text
msgid "Trusted certificates"
msgstr "Վստահելի վկայագրեր"

#: macrosecurity_ts.xhp#par_idN1057C.help.text
#: macrosecurity_ts.xhp%23par_idN1057C.help.text
msgid "<ahelp hid=\".\">Lists the trusted certificates.</ahelp>"
msgstr "<ahelp hid=\".\">Թվարկում է վստահելի վկայագրերը։</ahelp>"

#: macrosecurity_ts.xhp#par_idN10591.help.text
#: macrosecurity_ts.xhp%23par_idN10591.help.text
msgctxt "macrosecurity_ts.xhp#par_idN10591.help.text"
msgid "View"
msgstr "Տեսք"

#: macrosecurity_ts.xhp#par_idN10595.help.text
#: macrosecurity_ts.xhp%23par_idN10595.help.text
msgid ""
"<ahelp hid=\".\">Opens the View Certificate dialog for the selected "
"certificate.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է Դիտել վկայականը երկխոսությունը ընտրված վկայագրի "
"համար:</ahelp>"

#: macrosecurity_ts.xhp#par_idN105A6.help.text
#: macrosecurity_ts.xhp%23par_idN105A6.help.text
msgctxt "macrosecurity_ts.xhp#par_idN105A6.help.text"
msgid "Remove"
msgstr "Հեռացնել"

#: macrosecurity_ts.xhp#par_idN105AA.help.text
#: macrosecurity_ts.xhp%23par_idN105AA.help.text
msgid ""
"<ahelp hid=\".\">Removes the selected certificate from the list of trusted "
"certificates.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Հեռացնում է ընտրված վկայականը վստահելի վկայագրերի "
"ցուցակից:</ahelp>"

#: macrosecurity_ts.xhp#par_idN105AD.help.text
#: macrosecurity_ts.xhp%23par_idN105AD.help.text
msgid "Trusted file locations"
msgstr "Վստահելի նիշքերի տեղադրություններ"

#: macrosecurity_ts.xhp#par_idN105B1.help.text
#: macrosecurity_ts.xhp%23par_idN105B1.help.text
msgid ""
"<ahelp hid=\".\">Document macros are only executed if they have been opened "
"from one of the following locations.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Փաստաթղթի մակրոները կատարվում են միայն այն դեպքում, եթե "
"դրանք բացվել են հետևյալ տեղադրություններից մեկից:</ahelp>"

#: macrosecurity_ts.xhp#par_idN105B4.help.text
#: macrosecurity_ts.xhp%23par_idN105B4.help.text
msgctxt "macrosecurity_ts.xhp#par_idN105B4.help.text"
msgid "Add"
msgstr "Ավելացնել"

#: macrosecurity_ts.xhp#par_idN105B8.help.text
#: macrosecurity_ts.xhp%23par_idN105B8.help.text
msgid ""
"<ahelp hid=\".\">Opens a folder selection dialog. Select a folder from which "
"all macros are allowed to execute.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է պանակի ընտրության երկխոսությունը: Ընտրեք պանակը, "
