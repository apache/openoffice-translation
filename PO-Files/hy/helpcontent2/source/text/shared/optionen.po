#: 01010500.xhp#par_id3154705.34.help.text
#: 01010500.xhp%23par_id3154705.34.help.text
msgid ""
"<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_COLOR:BTN_LOAD\">Accesses the "
"<emph>Open</emph> dialog, which allows you to select a color palette</ahelp>."
msgstr ""
"<ahelp hid=\"SVX:IMAGEBUTTON:RID_SVXPAGE_COLOR:BTN_LOAD\">Մուտք եղեք "
"<emph>Բացել</emph> երկխոսությունը, որը թույլ է տալիս ընտրել գունային "
"ներկապնակը</ahelp>."

#: 01010500.xhp#hd_id3147344.36.help.text
