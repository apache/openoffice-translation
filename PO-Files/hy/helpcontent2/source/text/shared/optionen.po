#: 01040900.xhp#par_id3150768.24.help.text
#: 01040900.xhp%23par_id3150768.24.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_OPTLOAD_PAGE:CB_AUTO_UPDATE_CHARTS\">Specifies "
"whether to automatically update charts. Whenever a Writer table cell value "
"changes and the cursor leaves that cell, the chart that displays the cell "
"value is updated automatically.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_OPTLOAD_PAGE:CB_AUTO_UPDATE_CHARTS\">Սահմանում է "
"գծապատկերների ինքնաբերաբար արդիականացումը։ Ամեն անգամ, երբ Writer աղյուսակի "
"բջիջի արժեքը փոխվում է, և ցուցիչը դուրս է գալիս այդ բջիջից, բջջի արժեքը "
"ցուցադրող գծապատկերը ինքնաշխատ կերպով թարմացվում է:</ahelp>"

#: 01040900.xhp#hd_id3146976.46.help.text
#: 01040900.xhp%23hd_id3146976.46.help.text
