#: 01040400.xhp#hd_id3156414.1.help.text
#: 01040400.xhp%23hd_id3156414.1.help.text
msgid ""
"<link href=\"text/shared/optionen/01040400.xhp\" name=\"Print\">Print</link>"
msgstr ""
"<link href=\"text/shared/optionen/01040400.xhp\" name=\"Տպել\">Տպել</link>"

#: 01040400.xhp#par_id3152801.2.help.text
#: 01040400.xhp%23par_id3152801.2.help.text
msgid ""
"<ahelp hid=\"HID_OPTPRINT_PAGE\">Specifies print settings within a text or "
"HTML document.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_OPTPRINT_PAGE\">Տեքստի կամ HTML փաստաթղթի մեջ սահմանում է "
"տպման կարգավորումները:</ahelp>"

#: 01040400.xhp#par_id3153542.44.help.text
#: 01040400.xhp%23par_id3153542.44.help.text
msgid ""
"The print settings defined on this tab page apply to all subsequent print "
"jobs, until you change the settings again. If you want to change the "
"settings for the current print job only, use the <emph>File - Print</emph> "
"dialog."
msgstr ""
"Այս ներդիրի էջում սահմանված տպման պարամետրերը տարածվում են հետագա բոլոր "
"աշխատանքների վրա, մինչև կարգավորումները նորից փոխեք: Եթե ցանկանում եք փոխել "
"պարամետրերը միայն ընթացիկ տպման աշխատանքի համար, օգտագործեք <emph>Նիշք - "
"Տպել</emph> երկխոսությունը:"

#: 01040400.xhp#hd_id3156330.3.help.text
#: 01040400.xhp%23hd_id3156330.3.help.text
msgid "Contents"
msgstr "Բովանդակություն"

#: 01040400.xhp#par_id3155628.4.help.text
#: 01040400.xhp%23par_id3155628.4.help.text
msgid "Specifies which document contents are to be printed. "
msgstr "Նշում է, թե որ փաստաթղթի պարունակությունը պետք է տպվի: "

#: 01040400.xhp#hd_id3156156.5.help.text
#: 01040400.xhp%23hd_id3156156.5.help.text
msgid "Pictures and objects"
msgstr "Նկարներ և առարկաներ"

#: 01040400.xhp#par_id3153824.6.help.text
#: 01040400.xhp%23par_id3153824.6.help.text
msgid ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_PGRF\">Specifies whether the "
"graphics of your text document are printed.</ahelp>"
msgstr ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_PGRF\">Նշում է` արդյոք տպագրված "
"են ձեր տեքստային փաստաթղթի գրաֆիկները:</ahelp>"

#: 01040400.xhp#hd_id3153525.11.help.text
#: 01040400.xhp%23hd_id3153525.11.help.text
msgid "Form controls"
msgstr "Ձևի հսկիչներ"

#: 01040400.xhp#par_id3158408.12.help.text
#: 01040400.xhp%23par_id3158408.12.help.text
msgid ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_CTRLFLD\">Specifies whether the "
"form control fields of the text document are printed.</ahelp>"
msgstr ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_CTRLFLD\">Նշում է` արդյոք "
"տպագրվում են տեքստային փաստաթղթի ձևի հսկման դաշտերը:</ahelp>"

#: 01040400.xhp#hd_id3153968.13.help.text
#: 01040400.xhp%23hd_id3153968.13.help.text
msgid "Page background"
msgstr "Էջի հետնամաս"

#: 01040400.xhp#par_id3159150.14.help.text
#: 01040400.xhp%23par_id3159150.14.help.text
msgid ""
"<ahelp hid=\".\">Specifies whether to include colors and objects that are "
"inserted to the background of the page (Format - Page - Background) in the "
"printed document.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Նշում է՝ արդյոք տպագիր փաստաթղթում էջի ետնամասում տեղադրված "
"գույները և առարկաները (Ձևաչափ - էջ - Հետնամաս) ներառել:</ahelp>"

#: 01040400.xhp#hd_id3150868.40.help.text
#: 01040400.xhp%23hd_id3150868.40.help.text
msgid "Print black"
msgstr "Տպել սև"

#: 01040400.xhp#par_id3149562.42.help.text
#: 01040400.xhp%23par_id3149562.42.help.text
msgid ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_BLACK_FONT\">Specifies whether "
"to always print text in black.</ahelp>"
msgstr ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_BLACK_FONT\">Նշում է, թե արդյոք "
"տեքստը միշտ պետք է սեւ տպել:</ahelp>"

#: 01040400.xhp#hd_id8004394.help.text
#: 01040400.xhp%23hd_id8004394.help.text
msgctxt "01040400.xhp#hd_id8004394.help.text"
msgid "Hidden text"
msgstr "Թաքնված տեքստ"

#: 01040400.xhp#par_id2021546.help.text
#: 01040400.xhp%23par_id2021546.help.text
msgid ""
"<ahelp hid=\".\">Enable this option to print text that is marked as "
"hidden.</ahelp> The following hidden text is printed: text that is formatted "
"as hidden by <link href=\"text/shared/01/05020200.xhp\">Format - Character - "
"Font Effects - Hidden</link>, and the text fields <link href=\""
"text/swriter/01/04090003.xhp\">Hidden text and Hidden paragraphs</link>."
msgstr ""
"<ahelp hid=\".\">Թույլատրեք այս տարբերակը՝ տպելու համար այն տեքստը, որը "
"նշված է որպես թաքնված:</ahelp> Տպվում է հետևյալ թաքնված տեքստը. տեքստը, որը "
"ձևաչափված է որպես թաքնված <link href=\"text/shared/01/05020200.xhp\">"
"Ձևաչափել - Նիշ - ՏառատեսակիF ազդեցություններ - Թաքնված</link> այստեղից, և "
"տեքստի դաշտերը <link href=\"text/swriter/01/04090003.xhp\">Թաքնված տեքստ և "
"Թաքնված պարբերություններ</link>։"

#: 01040400.xhp#hd_id2623981.help.text
#: 01040400.xhp%23hd_id2623981.help.text
msgid "Text placeholder"
msgstr "Տեքստի տեղապահ"

#: 01040400.xhp#par_id7242042.help.text
#: 01040400.xhp%23par_id7242042.help.text
msgid ""
"<ahelp hid=\".\">Enable this option to print text placeholders. Disable this "
"option to leave the text placeholders blank in the printout.</ahelp><link "
"href=\"text/swriter/01/04090003.xhp\">Text placeholders</link> are fields."
msgstr ""
"<ahelp hid=\".\">Միացրեք այս տարբերակը՝ տեքստային տեղապահներ տպելու համար: "
"Անջատեք այս տարբերակը՝ տպագրության մեջ տեքստի տեղապահները դատարկ թողնելու "
"համար:</ahelp><link href=\"text/swriter/01/04090003.xhp\">Տեքստի "
"տեղապահները</link> դաշտեր են։"

#: 01040400.xhp#hd_id3151115.15.help.text
#: 01040400.xhp%23hd_id3151115.15.help.text
msgctxt "01040400.xhp#hd_id3151115.15.help.text"
msgid "Pages"
msgstr "Էջեր"

#: 01040400.xhp#par_id3145365.16.help.text
#: 01040400.xhp%23par_id3145365.16.help.text
msgid ""
"Defines the print order for $[officename] Writer documents with multiple "
"pages."
msgstr ""
"Սահմանում է $[officename] Writer փաստաթղթերի տպման հաջորդականությունը "
"բազմաթիվ էջերով:"

#: 01040400.xhp#hd_id3150874.17.help.text
#: 01040400.xhp%23hd_id3150874.17.help.text
msgid "Left pages (not for HTML documents)"
msgstr "Ձախ էջեր (չնախատեսված HTML փաստաթղթերի համար)"

#: 01040400.xhp#par_id3149665.18.help.text
#: 01040400.xhp%23par_id3149665.18.help.text
msgid ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_LEFTP\">Specifies whether to "
"print all left (even numbered) pages of the document.</ahelp>"
msgstr ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_LEFTP\">Նշում է, թե արդյոք պետք "
"է տպել փաստաթղթի ձախ բոլոր (զույգ համարակալված) էջերը:</ahelp>"

#: 01040400.xhp#hd_id3152885.19.help.text
#: 01040400.xhp%23hd_id3152885.19.help.text
msgid "Right pages (not for HTML documents)"
msgstr "Աջ էջեր (ոչ HTML փաստաթղթերի համար)"

#: 01040400.xhp#par_id3150103.20.help.text
#: 01040400.xhp%23par_id3150103.20.help.text
msgid ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_RIGHTP\">Specifies whether to "
"print all right (odd numbered) pages of the document.</ahelp>"
msgstr ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_RIGHTP\">Նշում է, թե արդյոք "
"պետք է տպել փաստաթղթի բոլոր աջ (կենտ համարակալված) էջերը:</ahelp>"

#: 01040400.xhp#hd_id3148577.21.help.text
#: 01040400.xhp%23hd_id3148577.21.help.text
msgid "Reversed"
msgstr "Հակառակ կարգով"

#: 01040400.xhp#par_id3150486.22.help.text
#: 01040400.xhp%23par_id3150486.22.help.text
msgid ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_REVERSE\">Specifies whether to "
"reverse the printing order. The last page of the document will then be the "
"first one printed.</ahelp>"
msgstr ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_REVERSE\">Նշում է` արդյոք տպեը "
"սահմանել հակառակ կարգով: Փաստաթղթի վերջին էջը այնուհետև տպագրվելու է "
"առաջինը:</ahelp>"

#: 01040400.xhp#hd_id3147318.23.help.text
#: 01040400.xhp%23hd_id3147318.23.help.text
msgctxt "01040400.xhp#hd_id3147318.23.help.text"
msgid "Brochure"
msgstr "Գրքույկ"

#: 01040400.xhp#par_id3155417.24.help.text
#: 01040400.xhp%23par_id3155417.24.help.text
msgid ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_PROSPECT\">Select the<emph> "
"Brochure </emph>option to print your document in brochure format.</ahelp> "
"The brochure format is as follows in $[officename] Writer:"
msgstr ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_PROSPECT\">Ընտրեք<emph> Գրքույկ "
"</emph>ընտրանքը, ձեր փաստաթուղթը գրքույկի ձևաչափով տպելու համար:</ahelp> "
"Գրքույկի ձևաչափը հետևյալն է $[officename] Writer -ում:"

#: 01040400.xhp#par_id3149410.25.help.text
#: 01040400.xhp%23par_id3149410.25.help.text
msgid ""
"If you print a document in portrait on a landscape page, two opposing sides "
"in a brochure will be printed next to each other. If you have a printer with "
"double-sided printing capability, you can create an entire brochure from "
"your document without having to collate the pages later. If you have a "
"printer that only has single-sided printing capability, you can achieve this "
"effect by first printing the front pages with the \"Front sides / right "
"pages /odd pages\" option marked, then re-inserting the entire paper stack "
"in your printer and printing all the back pages with the \"Back pages / left "
"pages / even pages\" option marked."
msgstr ""
"Եթե բնապատկերային էջում դիմանկարով փաստաթուղթ եք տպում, գրքույկի երկու "
"հակադիր կողմերը տպվում են միմյանց կողքին: Եթե ունեք տպիչ, որը երկկողմանի "
"տպելու հնարավորություն ունի, կարող եք ձեր փաստաթղթից ստեղծել մի ամբողջ "
"գրքույկ՝ առանց հետագայում էջերը հավաքելու անհրաժեշտության: Եթե ունեք տպիչ, "
"որն ունի միայն միակողմանի տպման հնարավորություն, կարող եք այդ արդյունքին "
"հասնել՝ սկզբից տպելով առջևի էջերը «Առջևի կողմեր / աջ էջեր / կենտ էջեր» "
"տարբերակը նշված, ապա նորից տեղադրելով ամբողջ թղթի տուփը ձեր տպիչի մեջ և "
"հետևյալ բոլոր էջերը տպել նշելով «Հետևի էջեր / ձախ էջեր / զույգ էջեր» "
"տարբերակը:"

#: 01040400.xhp#hd_id9475386.help.text
#: 01040400.xhp%23hd_id9475386.help.text
msgid "Right to left"
msgstr "Աջից ձախ"

#: 01040400.xhp#par_id7894222.help.text
#: 01040400.xhp%23par_id7894222.help.text
msgid ""
"<ahelp hid=\".\">Check to print the pages of the brochure in the correct "
"order for a right-to-left script.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք՝ աջից ձախ գրերի համար գրքույկի էջերը ճիշտ "
"հերթականությամբ տպելու համար:</ahelp>"

#: 01040400.xhp#hd_id3149300.26.help.text
#: 01040400.xhp%23hd_id3149300.26.help.text
msgctxt "01040400.xhp#hd_id3149300.26.help.text"
msgid "Comments"
msgstr "Մեկնաբանություններ"

#: 01040400.xhp#par_id3151320.29.help.text
#: 01040400.xhp%23par_id3151320.29.help.text
msgid ""
"<ahelp hid=\".\">Specifies whether comments in your document are "
"printed.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Նշում է թե արդյոք տպվում են ձեր փաստաթղթի "
"մեկնաբանությունները:</ahelp>"

#: 01040400.xhp#hd_id3148916.45.help.text
#: 01040400.xhp%23hd_id3148916.45.help.text
msgid "Other"
msgstr "Այլ"

#: 01040400.xhp#hd_id4188055.help.text
#: 01040400.xhp%23hd_id4188055.help.text
msgid "Print automatically inserted blank pages"
msgstr "Տպեք ինքնաշխատ կերպով ներդրված դատարկ էջերը"

#: 01040400.xhp#par_id8295541.help.text
#: 01040400.xhp%23par_id8295541.help.text
msgid ""
"<ahelp hid=\".\">If this option is enabled, automatically-inserted blank "
"pages are being printed. This is best if you are printing double-sided. For "
"example, in a book, a \"chapter\" paragraph style has been set to always "
"start with an odd numbered page. If the previous chapter ends on an odd "
"page, %PRODUCTNAME inserts an even numbered blank page. This option controls "
"whether to print that even numbered page or not.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Եթե այս տարբերակը միացված է, ինքնաշխատ կերպով տեղադրված "
"դատարկ էջերը տպվում են: Դա ամենալավն է, եթե երկկողմանի եք տպում: Օրինակ, "
"գրքում «գլուխ» պարբերության ոճը դրված է այնպես, որ միշտ սկսվի կենտ "
"համարակալված էջից: Եթե նախորդ գլուխն ավարտվում է կենտ էջում, %PRODUCTNAME -ը "
"զետեղում է նույնիսկ համարակալված դատարկ էջ: Այս տարբերակը վերահսկում է "
"արդյոք տպել այդ համարակալված զույգ էջը, թե ոչ:</ahelp>"

#: 01040400.xhp#hd_id3145642.47.help.text
#: 01040400.xhp%23hd_id3145642.47.help.text
msgid "Create single print jobs"
msgstr "Ստեղծեք տպելու առանձին աշխատանքներ"

#: 01040400.xhp#par_id3147338.48.help.text
#: 01040400.xhp%23par_id3147338.48.help.text
msgid ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_SINGLEJOBS\">Specifies that "
"each new print job will begin on a new page even if you are using a duplex "
"printer.</ahelp> If this field is not checked then it is possible that the "
"first page of the second copy is printed on the reverse side of the last "
"page of the first copy, especially if there are an odd number of pages."
msgstr ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_SINGLEJOBS\">Նշում է, որ տպելու "
"յուրաքանչյուր նոր աշխատանք կսկսվի նոր էջում, նույնիսկ եթե դու օգտագործում ես "
"դուպլեքս տպիչ:</ahelp> Եթե այս դաշտը չստուգված է, ապա հնարավոր է, որ երկրորդ "
"օրինակի առաջին էջը տպված լինի առաջին օրինակի վերջին էջի հակառակ կողմում, "
"հատկապես եթե էջերի կենտ քանակ կա:"

#: 01040400.xhp#hd_id3156384.41.help.text
#: 01040400.xhp%23hd_id3156384.41.help.text
msgctxt "01040400.xhp#hd_id3156384.41.help.text"
msgid "Paper tray from printer settings"
msgstr "Թղթի սկուտեղը համաձայն տպիչի կարգավորումների"

#: 01040400.xhp#par_id3146316.37.help.text
#: 01040400.xhp%23par_id3146316.37.help.text
msgid ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_PAPERFROMSETUP\">For printers "
"with multiple trays, the \"Paper tray from printer settings\" option "
"specifies whether the paper tray used is specified by the system settings of "
"the printer.</ahelp>"
msgstr ""
"<ahelp hid=\"sw:CheckBox:TP_OPTPRINT_PAGE:CB_PAPERFROMSETUP\">Բազմաթիվ "
"սկուտեղ ունեցող տպիչների համար «Թղթի սկուտեղը տպիչի կարգաբերումներից» "
"տարբերակը սահմանում է, թե արդյոք օգտագործված թղթե սկուտեղը հատկորոշված է "
"տպիչի համակարգային կարգաբերումներով:</ahelp>"

#: 01040400.xhp#hd_id3147362.38.help.text
#: 01040400.xhp%23hd_id3147362.38.help.text
msgctxt "01040400.xhp#hd_id3147362.38.help.text"
msgid "Fax"
msgstr "Ֆաքս"

#: 01040400.xhp#par_id3154703.39.help.text
#: 01040400.xhp%23par_id3154703.39.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_OPTPRINT_PAGE:LB_FAX\">If you have installed fax "
"software on your computer and wish to fax directly from the text document, "
"select the desired fax machine.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_OPTPRINT_PAGE:LB_FAX\">Եթե ձեր համակարգչում "
"տեղադրել եք ֆաքսի ծրագրակազմ և ցանկանում եք ֆաքս ուղարկել անմիջապես "
"տեքստային փաստաթղթից, ընտրեք ֆաքսի ցանկալի սարքը:</ahelp>"

#: 01070000.xhp#tit.help.text
#: 01070000.xhp%23tit.help.text
msgid "Presentation Options"
msgstr "Շնորհանդեսի ընտրանքներ"

#: 01070000.xhp#hd_id3155805.1.help.text
#: 01070000.xhp%23hd_id3155805.1.help.text
msgid "%PRODUCTNAME Impress Options"
msgstr "%PRODUCTNAME Impress ընտրանքներ"

#: 01070000.xhp#par_id3146957.2.help.text
#: 01070000.xhp%23par_id3146957.2.help.text
msgid ""
"<variable id=\"allgemein\"><ahelp hid=\".uno:SdEditOptions\">Defines various "
"settings for newly created presentation documents, such as the contents to "
"be displayed, the measurement unit used, if and how grid alignment is "
"carried out.</ahelp></variable>"
msgstr ""
"<variable id=\"allgemein\"><ahelp hid=\".uno:SdEditOptions\">Սահմանում է "
"նորաստեղծ ներկայացման փաստաթղթերի տարբեր պարամետրեր, ինչպիսիք են ցուցադրվող "
"բովանդակությունը, օգտագործված չափման միավորը, թե արդյոք և ինչպես է "
"իրականացվում ցանցի հավասարեցումը:</ahelp></variable>"

#: 01060500.xhp#tit.help.text
#: 01060500.xhp%23tit.help.text
msgid "Calculate"
msgstr "Հաշվել"

