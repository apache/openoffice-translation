"<ahelp hid=\"SVX_CHECKBOX_RID_SFXPAGE_SAVE_CB_LOAD_SETTINGS\">Loads the user-"
"specific settings saved in a document with the document.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SFXPAGE_SAVE_CB_LOAD_SETTINGS\">Փաստաթղթի հետ "
"բեռնեք անհատականացված կարգաբերումները, պահված փաստաթղթում։</ahelp>"

#: 01010200.xhp#par_id3166460.68.help.text
#: 01010200.xhp%23par_id3166460.68.help.text
msgid ""
"If <emph>Load user-specific settings with the document </emph>is not "
"selected, the following user-specific settings still apply:"
msgstr ""
"Եթե <emph>Փաստաթղթի հետ բեռնեք անհատականացված կարգաբերումները </emph>չի "
"ընտրված, հետևյալ անհատականացված կարգաբերումները դեռ կիրառելի են։"

#: 01010200.xhp#par_id3155388.69.help.text
#: 01010200.xhp%23par_id3155388.69.help.text
