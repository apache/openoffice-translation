"<bookmark_value>views; defaults</bookmark_value>         "
"<bookmark_value>defaults; views</bookmark_value>         "
"<bookmark_value>settings; views</bookmark_value>         "
"<bookmark_value>scaling; font sizes in user interface</bookmark_value>"
