msgctxt "01110100.xhp#hd_id3154823.5.help.text"
msgid "Color table"
msgstr "Գույների աղյուսակ"

#: 01110100.xhp#par_id3149398.6.help.text
#: 01110100.xhp%23par_id3149398.6.help.text
msgid ""
"This table is used as a means of replacing the chart colors for the selected "
"data rows. For example, if you selected data row 6 and then click on the "
"color green 8, the old color of the data row is replaced by green 8. The "
"name of the selected color is shown below the color table."
msgstr ""
"Այս աղյուսակն օգտագործվում է որպես տվյալների ընտրված շարքերում գծապատկերի "
"գույները փոխարինելու միջոց: Օրինակ, եթե դուք ընտրել եք տվյալների 6-րդ տողը, "
"այնուհետև կտտացրել եք կանաչ գույն 8-ին, տվյալների շարքի հին գույնը "
"փոխարինվում է կանաչով: Ընտրված գույնի անունը ցույց է տրվում գունային "
"աղյուսակի ներքո:"

