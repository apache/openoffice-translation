#: 01040700.xhp#hd_id3153823.1.help.text
#: 01040700.xhp%23hd_id3153823.1.help.text
msgid ""
"<link href=\"text/shared/optionen/01040700.xhp\" name=\"Changes\""
">Changes</link>"
msgstr ""
"<link href=\"text/shared/optionen/01040700.xhp\" name=\"Փոփոխություններ\""
">Փոփոխություններ</link>"

#: 01040700.xhp#par_id3149416.2.help.text
#: 01040700.xhp%23par_id3149416.2.help.text
msgid ""
"<ahelp hid=\"HID_REDLINE_OPT\">Defines the appearance of changes in the "
"document.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_REDLINE_OPT\">Սահմանում է փաստաթղթում փոփոխությունների "
"տեսքը:</ahelp>"

#: 01040700.xhp#par_id3156153.27.help.text
#: 01040700.xhp%23par_id3156153.27.help.text
msgid ""
"To record or show changes in your text or spreadsheet document, choose <link "
"href=\"text/shared/01/02230000.xhp\" name=\"Edit - Changes\"><emph>Edit - "
"Changes - Record</emph></link> or <emph>Edit - Changes - Show</emph>."
msgstr ""
"Ձեր տեքստի կամ փռված թերթիկի փաստաթղթում փոփոխությունները գրանցելու կամ "
"ցույց տալու համար ընտրեք <link href=\"text/shared/01/02230000.xhp\" name=\""
"Խմբագրել - Փոփոխություններ\"><emph>Խմբագրել - Փոփոխություններ - "
"Գրառում</emph></link> կամ <emph>Խմբագրել - Փոփոխություններ - "
"Ցուցադրել</emph>։"

#: 01040700.xhp#hd_id3155419.3.help.text
#: 01040700.xhp%23hd_id3155419.3.help.text
msgid "Text display"
msgstr "Տեքստի արտածում"

#: 01040700.xhp#par_id3144510.4.help.text
#: 01040700.xhp%23par_id3144510.4.help.text
msgid ""
"Defines the settings for displaying recorded changes. Select the type of "
"change and the corresponding display attribute and color. The preview field "
"shows the effect of the selected display options."
msgstr ""
"Սահմանում է գրանցված փոփոխությունները ցուցադրելու կարգաբերումները: Ընտրեք "
"փոփոխության տեսակը և համապատասխան ցուցադրման հատկանիշը և գույնը: Նախադիտման "
"դաշտը ցույց է տալիս ընտրված արտածման ընտրանքների ազդեցությունը:"

#: 01040700.xhp#hd_id3148550.21.help.text
#: 01040700.xhp%23hd_id3148550.21.help.text
msgid "Insertions / Attributes"
msgstr "Տեղադրումներ / Հատկանիշներ"

#: 01040700.xhp#par_id3154758.22.help.text
#: 01040700.xhp%23par_id3154758.22.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_REDLINE_OPT_LB_INS_ATTR\">Specifies how changes "
"in the document are displayed when text is inserted.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_REDLINE_OPT_LB_INS_ATTR\">Նշում է, թե ինչպես են "
"փաստաթղթում փոփոխությունները ցուցադրվում, երբ տեքստը տեղադրվում է:</ahelp>"

#: 01040700.xhp#hd_id3152812.23.help.text
#: 01040700.xhp%23hd_id3152812.23.help.text
msgid "Deletions / Attributes"
msgstr "Ջնջումներ / Հատկանիշներ"

#: 01040700.xhp#par_id3154365.24.help.text
#: 01040700.xhp%23par_id3154365.24.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_REDLINE_OPT_LB_DEL_ATTR\">Specifies how changes "
"in the document are displayed when text is deleted. If you record text "
"deletions, the text is displayed with the selected attribute (for example, "
"strikethrough) and is not deleted.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_REDLINE_OPT_LB_DEL_ATTR\">Նշում է, թե ինչպես են "
"փաստաթղթում փոփոխությունները ցուցադրվում, երբ տեքստը ջնջվում է: Եթե դուք "
"արձանագրում եք տեքստի ջնջումները, ապա տեքստը ցուցադրվում է ընտրված "
"հատկանիշով (օրինակ, միջնագծով ջնջել) և չի ջնջվում:</ahelp>"

#: 01040700.xhp#hd_id3148674.25.help.text
#: 01040700.xhp%23hd_id3148674.25.help.text
msgid "Changed attributes / Attributes"
msgstr "Փոխված հատկանիշներ / Հատկանիշներ"

#: 01040700.xhp#par_id3151042.26.help.text
#: 01040700.xhp%23par_id3151042.26.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_REDLINE_OPT_LB_CHG_ATTR\">Defines how changes to "
"text attributes are displayed in the document. These changes affect "
"attributes such as bold, italic or underline.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_REDLINE_OPT_LB_CHG_ATTR\">Սահմանում է, թե ինչպես "
"են փաստաթղթում ցուցադրվում տեքստի հատկանիշների փոփոխությունները: Այս "
"փոփոխություններն ազդում են հատկանիշների վրա, ինչպիսիք են` թավ, շեղ կամ "
"ընդգծված:</ahelp>"

#: 01040700.xhp#hd_id3153105.28.help.text
#: 01040700.xhp%23hd_id3153105.28.help.text
msgctxt "01040700.xhp#hd_id3153105.28.help.text"
msgid "Color"
msgstr "Գույն"

#: 01040700.xhp#par_id3145419.8.help.text
#: 01040700.xhp%23par_id3145419.8.help.text
msgid ""
"<ahelp hid=\"SW_LISTBOX_TP_REDLINE_OPT_LB_CHG_COL\">You can also choose a "
"color to display each type of recorded change. When you choose the condition "
"\"By author\" in the list, the color is automatically determined by "
"$[officename], then modified to match to the author of each change.</ahelp>"
msgstr ""
"<ahelp hid=\"SW_LISTBOX_TP_REDLINE_OPT_LB_CHG_COL\">Կարող եք նաև ընտրել "
"գույնը` յուրաքանչյուր արձանագրված փոփոխության ցուցադրման համար: Երբ "
"ցուցակում ընտրում եք «Ըստ հեղինակի» պայմանը, գույնը ինքնաշխատ կերպով "
"որոշվում է $[officename] -ի կողմից, այնուհետև փոփոխվում է՝ "
"համապատասխանեցնելով յուրաքանչյուր փոփոխության հեղինակին:</ahelp>"

#: 01040700.xhp#hd_id3145607.15.help.text
#: 01040700.xhp%23hd_id3145607.15.help.text
msgid "Lines changed"
msgstr "Տողերը փոփոխված"

#: 01040700.xhp#par_id3149562.16.help.text
#: 01040700.xhp%23par_id3149562.16.help.text
msgid ""
"To indicate which lines of the text have been changed, you can define a mark "
"that appears in the left or right page margin."
msgstr ""
"Նշելու համար, թե տեքստի որ տողերն են փոխվել, կարող եք սահմանել նշան, որը "
"հայտնվում է ձախ կամ աջ էջի լուսանցքում:"

#: 01040700.xhp#hd_id3145785.17.help.text
#: 01040700.xhp%23hd_id3145785.17.help.text
msgid "Mark"
msgstr "Նշել"

#: 01040700.xhp#par_id3154638.18.help.text
#: 01040700.xhp%23par_id3154638.18.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_REDLINE_OPT:LB_MARKPOS\">Defines if and where "
"changed lines in the document are marked.</ahelp> You can set the markings "
"so that they always appear on the left or right page margin, or on the outer "
"or inner margin."
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_REDLINE_OPT:LB_MARKPOS\">Սահմանում է, թե արդյոք և "
"որտեղ են փոփոխված տողերը նշված փաստաթղթում:</ahelp> Կարող եք նշումները "
"կարգաբերել այնպես, որ դրանք միշտ հայտնվեն ձախ կամ աջ էջի լուսանցքում կամ "
"արտաքին կամ ներքին լուսանցքում:"

#: 01040700.xhp#hd_id3163713.19.help.text
#: 01040700.xhp%23hd_id3163713.19.help.text
msgctxt "01040700.xhp#hd_id3163713.19.help.text"
msgid "Color"
msgstr "Գույն"

#: 01040700.xhp#par_id3146975.20.help.text
#: 01040700.xhp%23par_id3146975.20.help.text
msgid ""
"<ahelp hid=\"SW:LISTBOX:TP_REDLINE_OPT:LB_LC_COL\">Specifies the color for "
"highlighting the changed lines in the text.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:LISTBOX:TP_REDLINE_OPT:LB_LC_COL\">Նշում է գույնը տեքստի "
"փոփոխված տողերը գունավորելու համար:</ahelp>"

#: 01010900.xhp#tit.help.text
#: 01010900.xhp%23tit.help.text
msgid "Print Options"
msgstr "Տպելու ընտրանքներ"

#: 01010900.xhp#bm_id3147323.help.text
#: 01010900.xhp%23bm_id3147323.help.text
msgid ""
"<bookmark_value>printing; colors in "
"grayscale</bookmark_value><bookmark_value>grayscale "
"printing</bookmark_value><bookmark_value>colors; printing in "
"grayscale</bookmark_value><bookmark_value>printing; "
"warnings</bookmark_value><bookmark_value>paper size warning</bookmark_value>"
msgstr ""
"<bookmark_value>printing; colors in "
"grayscale</bookmark_value><bookmark_value>grayscale "
"printing</bookmark_value><bookmark_value>colors; printing in "
"grayscale</bookmark_value><bookmark_value>printing; "
"warnings</bookmark_value><bookmark_value>paper size warning</bookmark_value>"

#: 01010900.xhp#hd_id3148946.1.help.text
#: 01010900.xhp%23hd_id3148946.1.help.text
msgid ""
"<link href=\"text/shared/optionen/01010900.xhp\" name=\"Print Options\">"
"Print Options</link>"
msgstr ""
"<link href=\"text/shared/optionen/01010900.xhp\" name=\"Տպելու ընտրանքներ\">"
"Տպելու ընտրանքներ</link>"

#: 01010900.xhp#par_id3150359.2.help.text
#: 01010900.xhp%23par_id3150359.2.help.text
msgid "<ahelp hid=\".\">Specifies the print setting options.</ahelp>"
msgstr "<ahelp hid=\".\">Նշում է տպման կարգավորման ընտրանքները:</ahelp>"

#: 01010900.xhp#hd_id3148451.56.help.text
#: 01010900.xhp%23hd_id3148451.56.help.text
msgid "Reduce print data"
msgstr "Կրճատել տպման տվյալները"

#: 01010900.xhp#par_id3154910.68.help.text
#: 01010900.xhp%23par_id3154910.68.help.text
msgid ""
"You can reduce the amount of data to be sent to the printer. Reducing the "
"print data increases the print speed because the print files are smaller. "
"This makes it easier for printers with a smaller memory to print. Reducing "
"print data can result in slightly lower print quality."
msgstr ""
"Կարող եք կրճատել տպիչին ուղարկվող տվյալների քանակը: Տպման տվյալների "
"կրճատումը մեծացնում է տպման արագությունը, քանի որ տպելու նիշքերն ավելի փոքր "
"են: Սա ավելի հեշտ է դարձնում ավելի փոքր հիշողություն ունեցող տպիչների "
"օգտագործումը: Տպման տվյալների կրճատումը կարող է հանգեցնել տպման որակի մի "
"փոքր ցածր մակարդակի:"

#: 01010900.xhp#hd_id3147085.57.help.text
#: 01010900.xhp%23hd_id3147085.57.help.text
msgid "Settings for"
msgstr "Կարգաբերումներ"

#: 01010900.xhp#par_id3158407.69.help.text
#: 01010900.xhp%23par_id3158407.69.help.text
msgid ""
"<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_PRINTFILEOUTPUT\">"
"Specifies whether the print settings apply to direct printing or to printing "
"to a file.</ahelp>"
msgstr ""
"<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_PRINTFILEOUTPUT\">"
"Նշում է, թե արդյոք տպելու պարամետրերը կիրառվում են ուղղակի տպելու վրա, թե "
"նիշքում տպելու վրա:</ahelp>"

#: 01010900.xhp#hd_id3145786.58.help.text
#: 01010900.xhp%23hd_id3145786.58.help.text
msgid "Reduce transparency"
msgstr "Նվազեցնել թափանցիկությունը"

#: 01010900.xhp#par_id3159154.70.help.text
#: 01010900.xhp%23par_id3159154.70.help.text
msgid ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCETRANSPARENCY\">If "
"you mark this field the transparent objects will be printed like normal, non-"
"transparent objects, depending on your selection in the following two option "
"buttons.</ahelp>"
msgstr ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCETRANSPARENCY\">Եթե "
"այս դաշտը նշեք, թափանցիկ օբյեկտները կտպվեն սովորական, ոչ թափանցիկ առարկաների "
"նման, կախված երկու տարբերականի հետևյալ կոճակներում ձեր ընտրությունից:</ahelp>"

#: 01010900.xhp#par_id3156444.71.help.text
#: 01010900.xhp%23par_id3156444.71.help.text
msgid ""
"Transparency cannot be output directly to a printer. The areas of the "
"document in which transparency is to be visible must therefore always be "
"calculated as bitmaps and sent to the printer. Depending on the size of the "
"bitmaps and the print resolution a large amount of data may result."
msgstr ""
"Թափանցիկությունը հնարավոր չէ ուղղակիորեն ելք անել տպիչ: Փաստաթղթի այն "
"տարածքները, որտեղ պետք է տեսանելի լինի թափանցիկությունը, պետք է միշտ "
"հաշվարկվեն որպես bitmap և ուղարկվեն տպիչին: Կախված bitmap-ների չափից և տպման "
"լուծաչափից մեծ քանակությամբ տվյալների կարող են հանգեցնել:"

#: 01010900.xhp#hd_id3147441.59.help.text
#: 01010900.xhp%23hd_id3147441.59.help.text
msgctxt "01010900.xhp#hd_id3147441.59.help.text"
msgid "Automatically"
msgstr "Ինքնաշխատ կերպով"

#: 01010900.xhp#par_id3150488.72.help.text
#: 01010900.xhp%23par_id3150488.72.help.text
msgid ""
"<ahelp hid=\""
"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCETRANSPARENCY_AUTO\">"
"Specifies that the transparency is only printed if the transparent area "
"covers less than a quarter of the entire page.</ahelp>"
msgstr ""
"<ahelp hid=\""
"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCETRANSPARENCY_AUTO\">Նշում է, "
"որ թափանցիկությունը տպվում է միայն այն դեպքում, եթե թափանցիկ տարածքն "
"ընդգրկում է ամբողջ էջի քառորդ մասից փոքր տարածք:</ahelp>"

#: 01010900.xhp#hd_id3149417.73.help.text
#: 01010900.xhp%23hd_id3149417.73.help.text
msgid "No transparency"
msgstr "Չկա թափանցիկություն"

#: 01010900.xhp#par_id3153878.74.help.text
#: 01010900.xhp%23par_id3153878.74.help.text
msgid ""
"<ahelp hid=\""
"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCETRANSPARENCY_NONE\">With "
"this option transparency is never printed.</ahelp>"
msgstr ""
"<ahelp hid=\""
"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCETRANSPARENCY_NONE\">Այս "
"տարբերակով թափանցիկությունը երբեք չի տպվում:</ahelp>"

#: 01010900.xhp#hd_id3149960.60.help.text
#: 01010900.xhp%23hd_id3149960.60.help.text
msgid "Reduce bitmaps"
msgstr "Կրճատեք բիթքարտեզները"

#: 01010900.xhp#par_id3148455.75.help.text
#: 01010900.xhp%23par_id3148455.75.help.text
msgid ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEBITMAPS\">"
"Specifies that bitmaps are printed with reduced quality. The resolution can "
"only be reduced and not increased.</ahelp>"
msgstr ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEBITMAPS\">Նշում է, "
"որ bitmap- ները տպվում են իջեցված որակով: Լուծելիությունը կարող է միայն "
"կրճատվել, բայց ոչ ավելացվել:</ahelp>"

#: 01010900.xhp#hd_id3149400.61.help.text
#: 01010900.xhp%23hd_id3149400.61.help.text
msgid "High/normal print quality"
msgstr "Տպելու բարձր/նորմալ որակ"

#: 01010900.xhp#par_id3154510.76.help.text
#: 01010900.xhp%23par_id3154510.76.help.text
msgid ""
"<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCEBITMAPS_NORMAL\""
">High print quality corresponds to a resolution of 300dpi. Normal print "
"quality corresponds to a resolution of 200dpi. </ahelp>"
msgstr ""
"<ahelp hid=\"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCEBITMAPS_NORMAL\""
">Տպման բարձր որակը համապատասխանում է 300 dpi լուծաչափին: Տպման նորմալ որակը "
"համապատասխանում է 200 dpi լուծաչափին: </ahelp>"

#: 01010900.xhp#hd_id3146969.62.help.text
#: 01010900.xhp%23hd_id3146969.62.help.text
msgctxt "01010900.xhp#hd_id3146969.62.help.text"
msgid "Resolution"
msgstr "Լուծաչափ"

#: 01010900.xhp#par_id3154270.77.help.text
#: 01010900.xhp%23par_id3154270.77.help.text
msgid ""
"<ahelp hid=\"SFX2_LISTBOX_TP_COMMONPRINTOPTIONS_LB_REDUCEBITMAPS_RESOLUTION\""
">Specifies the maximum print quality in dpi. The resolution can only be "
"reduced and not increased.</ahelp>"
msgstr ""
"<ahelp hid=\"SFX2_LISTBOX_TP_COMMONPRINTOPTIONS_LB_REDUCEBITMAPS_RESOLUTION\""
">Նշում է տպման առավելագույն որակը dpi-ով: Լուծաչափը կարող է միայն կրճատվել և "
"չավելացվել:</ahelp>"

#: 01010900.xhp#hd_id3146789.63.help.text
#: 01010900.xhp%23hd_id3146789.63.help.text
msgid "Include transparent objects"
msgstr "Ներառեք թափանցիկ առարկաները"

#: 01010900.xhp#par_id3150749.78.help.text
#: 01010900.xhp%23par_id3150749.78.help.text
msgid ""
"<ahelp hid=\""
"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEBITMAPS_TRANSPARENCY\">If this "
"field is marked, the reduction in print quality for bitmaps also applies to "
"the transparent areas of objects.</ahelp>"
msgstr ""
"<ahelp hid=\""
"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEBITMAPS_TRANSPARENCY\">Եթե այս "
"դաշտը նշված է, bitmap-ի տպման որակի նվազումը վերաբերում է նաև առարկաների "
"թափանցիկ տարածքներին:</ahelp>"

#: 01010900.xhp#hd_id3154362.64.help.text
#: 01010900.xhp%23hd_id3154362.64.help.text
msgid "Reduce gradients"
msgstr "Նվազեցնել գրադիենտները"

#: 01010900.xhp#par_id3148914.79.help.text
#: 01010900.xhp%23par_id3148914.79.help.text
msgid ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEGRADIENTS\">If "
"this field is marked, gradients are printed with reduced quality.</ahelp>"
msgstr ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_REDUCEGRADIENTS\">Եթե "
"այս դաշտը նշված է, գրադիենտները տպվում են նվազեցված որակով:</ahelp>"

#: 01010900.xhp#hd_id3155766.65.help.text
#: 01010900.xhp%23hd_id3155766.65.help.text
msgid "Gradient stripes"
msgstr "Գրադիենտային շերտեր"

#: 01010900.xhp#par_id3156382.80.help.text
#: 01010900.xhp%23par_id3156382.80.help.text
msgid ""
"<ahelp hid=\""
"SFX2_NUMERICFIELD_TP_COMMONPRINTOPTIONS_NF_REDUCEGRADIENTS_STEPCOUNT\">"
"Specifies the maximum number of gradient stripes for printing.</ahelp>"
msgstr ""
"<ahelp hid=\""
"SFX2_NUMERICFIELD_TP_COMMONPRINTOPTIONS_NF_REDUCEGRADIENTS_STEPCOUNT\">Տպման "
"համար սահմանում է գրադիենտի շերտերի առավելագույն քանակը:</ahelp>"

#: 01010900.xhp#hd_id3146313.66.help.text
#: 01010900.xhp%23hd_id3146313.66.help.text
msgid "Intermediate color"
msgstr "Միջանկյալ գույն"

#: 01010900.xhp#par_id3145230.81.help.text
#: 01010900.xhp%23par_id3145230.81.help.text
msgid ""
"<ahelp hid=\""
"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCEGRADIENTS_COLOR\">Specifies "
"that gradients are only printed in a single intermediate color.</ahelp>"
msgstr ""
"<ahelp hid=\""
"SFX2_RADIOBUTTON_TP_COMMONPRINTOPTIONS_RB_REDUCEGRADIENTS_COLOR\">Նշում է, "
"որ գրադիենտները տպվում են միայն միջանկյալ մեկ գույնով:</ahelp>"

#: 01010900.xhp#hd_id3147323.67.help.text
#: 01010900.xhp%23hd_id3147323.67.help.text
msgid "Convert colors to grayscale"
msgstr "Գույները փոխեք մոխրագույնի"

#: 01010900.xhp#par_id3145150.82.help.text
#: 01010900.xhp%23par_id3145150.82.help.text
msgid ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_CONVERTTOGREYSCALES\">"
"Specifies that all colors are printed only as grayscale.</ahelp>"
msgstr ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_CONVERTTOGREYSCALES\">"
"Նշում է, որ բոլոր գույները տպվում են միայն որպես մոխրագույն:</ahelp>"

#: 01010900.xhp#hd_id3150646.50.help.text
#: 01010900.xhp%23hd_id3150646.50.help.text
msgid "Printer warnings"
msgstr "Տպիչի զգուշացումներ"

#: 01010900.xhp#par_id3154022.51.help.text
#: 01010900.xhp%23par_id3154022.51.help.text
msgid ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_CONVERTTOGREYSCALES\">"
"Defines which warnings appear before printing begins.</ahelp>"
msgstr ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_CONVERTTOGREYSCALES\">"
"Սահմանում է, թե մինչ տպելը սկսելը, որ նախազգուշացումներն են "
"հայտնվում:</ahelp>"

#: 01010900.xhp#hd_id3147003.52.help.text
#: 01010900.xhp%23hd_id3147003.52.help.text
msgid "Paper size"
msgstr "Թղթի չափը"

#: 01010900.xhp#par_id3150206.53.help.text
#: 01010900.xhp%23par_id3150206.53.help.text
msgid ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_PAPERSIZE\">Mark this "
"check box if a certain paper size is needed for printing the current "
"document.</ahelp> If the paper size used in the document is not provided by "
"the current printer, you will receive an error message."
msgstr ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_PAPERSIZE\">Նշեք այս "
"ընտրավանդակը, եթե ընթացիկ փաստաթուղթը տպելու համար անհրաժեշտ է թղթի որոշակի "
"չափ:</ahelp> Եթե փաստաթղթում օգտագործված թղթի չափը չի աջակցվում ընթացիկ "
"տպիչի կողմից, դուք կստանաք սխալի հաղորդագրություն:"

#: 01010900.xhp#hd_id3155581.54.help.text
#: 01010900.xhp%23hd_id3155581.54.help.text
msgid "Paper orientation"
msgstr "Թղթի կողմնորոշում"

#: 01010900.xhp#par_id3153231.55.help.text
#: 01010900.xhp%23par_id3153231.55.help.text
msgid ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_PAPERORIENTATION\">Mark "
"this check box if you need a certain paper orientation for printing the "
"current document.</ahelp> If the format used by the current document is not "
"available from the printer, an error message will appear."
msgstr ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_PAPERORIENTATION\">Նշեք "
"այս ընտրավանդակը, եթե ընթացիկ փաստաթուղթը տպելու համար անհրաժեշտ է թղթի "
"որոշակի ուղղվածություն:</ahelp> Եթե ընթացիկ փաստաթղթի կողմից օգտագործված "
"ձևաչափը տպիչից մատչելի չէ, ապա կհայտնվի սխալի հաղորդագրություն:"

#: 01010900.xhp#hd_id3149531.83.help.text
#: 01010900.xhp%23hd_id3149531.83.help.text
msgctxt "01010900.xhp#hd_id3149531.83.help.text"
msgid "Transparency"
msgstr "Թափանցիկություն"

#: 01010900.xhp#par_id3152778.84.help.text
#: 01010900.xhp%23par_id3152778.84.help.text
msgid ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_TRANSPARENCY\">Mark this "
"check box if you always want to be warned if transparent objects are "
"contained in the document.</ahelp> If you print such a document, a dialog "
"appears in which you can select if the transparency is to be printed in this "
"print instruction."
msgstr ""
"<ahelp hid=\"SFX2_CHECKBOX_TP_COMMONPRINTOPTIONS_CB_TRANSPARENCY\">Նշեք այս "
"ընտրավանդակը, եթե ցանկանում եք միշտ նախազգուշացվել, եթե թափանցիկ առարկաներ "
"են պարունակվում փաստաթղթում:</ahelp> Եթե այդպիսի փաստաթուղթ եք տպում, "
"հայտնվում է երկխոսություն, որում կարող եք ընտրել, թե արդյոք թափանցիկությունը "
"պետք է տպվի տպագիր այս հրահանգում:"

#: 01013000.xhp#tit.help.text
#: 01013000.xhp%23tit.help.text
msgid "Accessibility"
msgstr "Մատչելիություն"

#: 01013000.xhp#bm_id3159411.help.text
#: 01013000.xhp%23bm_id3159411.help.text
msgid ""
"<bookmark_value>disabled persons</bookmark_value><bookmark_value>text colors "
"for better accessibility</bookmark_value><bookmark_value>animations; "
"accessibility options</bookmark_value><bookmark_value>Help tips; "
"hiding</bookmark_value><bookmark_value>high contrast "
"mode</bookmark_value><bookmark_value>accessibility; "
"options</bookmark_value><bookmark_value>options; "
"accessibility</bookmark_value>"
msgstr ""
"<bookmark_value>disabled persons</bookmark_value><bookmark_value>text colors "
"for better accessibility</bookmark_value><bookmark_value>animations; "
"accessibility options</bookmark_value><bookmark_value>Help tips; "
"hiding</bookmark_value><bookmark_value>high contrast "
"mode</bookmark_value><bookmark_value>accessibility; "
"options</bookmark_value><bookmark_value>options; "
"accessibility</bookmark_value>"

#: 01013000.xhp#hd_id3159411.1.help.text
#: 01013000.xhp%23hd_id3159411.1.help.text
msgid ""
"<link href=\"text/shared/optionen/01013000.xhp\" name=\"Accessibility\""
">Accessibility</link>"
msgstr ""
"<link href=\"text/shared/optionen/01013000.xhp\" name=\"Մատչելիություն\""
">Մատչելիություն</link>"

#: 01013000.xhp#par_id3149827.2.help.text
#: 01013000.xhp%23par_id3149827.2.help.text
msgid ""
"<ahelp hid=\".\">Sets options that make <item type=\"productname\""
">%PRODUCTNAME</item> programs more accessible for users with reduced sight, "
"limited dexterity or other disabilities.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Կարգաբերում է ընտրանքները, որոնք դարձնում են <item type=\""
"productname\">%PRODUCTNAME</item> ծրագրերը, ավելի մատչելի տեսողական "
"խնդիրներ, շարժողական սահմանափակումներ կամ այլ հաշմանդամություն ունեցող "
"օգտվողների համար:</ahelp>"

#: 01013000.xhp#hd_id3166460.9.help.text
#: 01013000.xhp%23hd_id3166460.9.help.text
msgid "Miscellaneous options"
msgstr "Տարբեր ընտրանքներ"

#: 01013000.xhp#par_id3152996.10.help.text
#: 01013000.xhp%23par_id3152996.10.help.text
msgid "Sets accessibility options."
msgstr "Սահմանում է մատչելիության ընտրանքները:"

#: 01013000.xhp#hd_id3154750.23.help.text
#: 01013000.xhp%23hd_id3154750.23.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"UNIX\""
"></caseinline><defaultinline>Support assistive technology tools (program "
"restart required)</defaultinline></switchinline>"
msgstr ""
"<switchinline select=\"sys\"><caseinline select=\"UNIX\""
"></caseinline><defaultinline>Օժանդակող տեխնոլոգիական գործիքների աջակցում ("
"ծրագրի վերագործարկում է պահանջվում)</defaultinline></switchinline>"

#: 01013000.xhp#par_id3155628.24.help.text
#: 01013000.xhp%23par_id3155628.24.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"UNIX\""
"></caseinline><defaultinline><ahelp hid=\""
"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_ACCESSIBILITY_TOOL\">Allows "
"you to use assistive tools, such as external screen readers, Braille devices "
"or speech recognition input devices. The Java Runtime Environment must be "
"installed on your computer before you can enable assistive "
"support.</ahelp></defaultinline></switchinline>"
msgstr ""
"<switchinline select=\"sys\"><caseinline select=\"UNIX\""
"></caseinline><defaultinline><ahelp hid=\""
"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_ACCESSIBILITY_TOOL\">Թույլ է "
"տալիս օգտագործել օժանդակ գործիքներ, ինչպիսիք են արտաքին էկրանի ընթերցիչները, "
"բրայլյան սարքերը կամ խոսքի ճանաչման մուտքային սարքերը: Java Runtime "
"միջավայրը պետք է տեղադրված լինի ձեր համակարգչում, նախքան օժանդակ "
"աջակցությունը միացնելը:</ahelp></defaultinline></switchinline>"

#: 01013000.xhp#hd_id3154047.27.help.text
#: 01013000.xhp%23hd_id3154047.27.help.text
msgid "Use text selection cursor in read-only text document"
msgstr ""
"Օգտագործեք տեքստի ընտրության կուրսորը միայն կարդալու համար տեքստային "
"փաստաթղթում"

#: 01013000.xhp#par_id3149164.28.help.text
#: 01013000.xhp%23par_id3149164.28.help.text
msgid ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_TEXTSELECTION\">"
"Displays cursor in read-only documents.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_TEXTSELECTION\">"
"Ցուցադրում է կուրսորը միայն կարդալու փաստաթղթերում:</ahelp>"

#: 01013000.xhp#hd_id3147531.15.help.text
#: 01013000.xhp%23hd_id3147531.15.help.text
msgid "Allow animated graphics"
msgstr "Թույլատրեք շարժապատկերային գրաֆիկները"

#: 01013000.xhp#par_id3145069.16.help.text
#: 01013000.xhp%23par_id3145069.16.help.text
msgid ""
"<ahelp hid=\""
"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_ANIMATED_GRAPHICS\">Previews "
"animated graphics, such as GIF images, in <item type=\"productname\""
">%PRODUCTNAME</item>.</ahelp>"
msgstr ""
"<ahelp hid=\""
"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_ANIMATED_GRAPHICS\">"
"Նախադիտում է շարժապատկերային գրաֆիկները, ինչպիսիք են GIF պատկերները <item "
"type=\"productname\">%PRODUCTNAME</item> -ում։</ahelp>"

#: 01013000.xhp#hd_id3147264.17.help.text
#: 01013000.xhp%23hd_id3147264.17.help.text
msgid "Allow animated text"
msgstr "Թույլատրեք շարժապատկերային տեքստը"

#: 01013000.xhp#par_id3149656.18.help.text
#: 01013000.xhp%23par_id3149656.18.help.text
msgid ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_ANIMATED_TEXTS\""
">Previews animated text, such as blinking and scrolling, in <item type=\""
"productname\">%PRODUCTNAME</item>.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_ANIMATED_TEXTS\""
">Նախադիտում է շարժապատկերային տեքստը, ասենք թարթելը և ոլորելը <item type=\""
"productname\">%PRODUCTNAME</item> -ում։</ahelp>"

#: 01013000.xhp#hd_id3153381.11.help.text
#: 01013000.xhp%23hd_id3153381.11.help.text
msgid "Help tips disappear after"
msgstr "Օգնության խորհուրդները անհետանում են"

#: 01013000.xhp#par_id3150868.12.help.text
#: 01013000.xhp%23par_id3150868.12.help.text
msgid ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_TIPHELP\">Hides "
"the <link href=\"text/shared/main0108.xhp\" name=\"Help tips\">Help "
"tips</link> after the number of seconds that you enter.</ahelp> Otherwise, "
"Help tips are displayed until you press Escape or move the cursor."
msgstr ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_TIPHELP\">"
"Թաքցնում է <link href=\"text/shared/main0108.xhp\" name=\"Օգնության "
"խորհուրդները\">Օգնության խորհուրդները</link> ձեր մուտքագրած վայրկյաններից "
"հետո։</ahelp> Հակառակ դեպքում, Օգնության խորհուրդները ցուցադրվում են այնքան "
"ժամանակ, քանի դեռ չեք սեղմել Escape կամ չեք տեղափոխել կուրսորը:"

#: 01013000.xhp#hd_id3151043.13.help.text
#: 01013000.xhp%23hd_id3151043.13.help.text
msgid "Seconds"
msgstr "Վայրկյաններ"

#: 01013000.xhp#par_id3148672.14.help.text
#: 01013000.xhp%23par_id3148672.14.help.text
msgid ""
"<ahelp hid=\"SVX_NUMERICFIELD_RID_SVXPAGE_ACCESSIBILITYCONFIG_NF_TIPHELP\">"
"Enter the number of seconds to display the Help tips.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX_NUMERICFIELD_RID_SVXPAGE_ACCESSIBILITYCONFIG_NF_TIPHELP\">"
"Մուտքագրեք վայրկյաններ՝ Օգնության խորհուրդները ցուցադրելու համար:</ahelp>"

#: 01013000.xhp#hd_id3149809.3.help.text
#: 01013000.xhp%23hd_id3149809.3.help.text
msgid "Options for high contrast appearance"
msgstr "Բարձր հակապատկերի տեսքի ընտրանքներ"

#: 01013000.xhp#par_id3153106.4.help.text
#: 01013000.xhp%23par_id3153106.4.help.text
msgid ""
"High contrast is an operating system setting that changes the system color "
"scheme to improve readability. You can decide how <item type=\"productname\""
">%PRODUCTNAME</item> uses the high contrast settings of the operating system."
msgstr ""
"Բարձր հակադրությունը գործառնական համակարգի պարամետր է, որը փոխում է "
"համակարգի գունային սխեման` ընթերցելիությունը բարելավելու համար: Դուք կարող "
"եք որոշել, թե ինչպես է <item type=\"productname\">%PRODUCTNAME</item> "
"օգտագործում գործառնական համակարգի բարձր հակադրության պարամետրերը:"

#: 01013000.xhp#par_id3125863.31.help.text
#: 01013000.xhp%23par_id3125863.31.help.text
msgid ""
"Cell borders and shadows are always shown in text color when high contrast "
"mode is active. The cell background color is ignored then."
msgstr ""
"Բջջի սահմաններն ու ստվերները միշտ ցուցադրվում են տեքստի գույնով, երբ ակտիվ է "
"բարձր հակադրության ռեժիմը: Այդ ժամանակ բջջի հետնամասի գույնը անտեսվում է:"

#: 01013000.xhp#hd_id3155132.29.help.text
#: 01013000.xhp%23hd_id3155132.29.help.text
msgid "Automatically detect high contrast mode of operating system"
msgstr ""
"Ինքնաշխատ կերպով հայտնաբերել գործառնական համակարգի բարձր հակապատկեր ռեժիմը"

#: 01013000.xhp#par_id3153768.30.help.text
#: 01013000.xhp%23par_id3153768.30.help.text
msgid ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_AUTO_DETECT_HC\""
">Switches <item type=\"productname\">%PRODUCTNAME</item> into high contrast "
"mode when the system background color is very dark.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_AUTO_DETECT_HC\""
">Փոխմիացնում է <item type=\"productname\">%PRODUCTNAME</item> բարձր "
"հակապատկերի ռեժիմի, երբ համակարգի հետնամասի գույնը շատ մուգ է:</ahelp>"

#: 01013000.xhp#hd_id3154918.19.help.text
#: 01013000.xhp%23hd_id3154918.19.help.text
msgid "Use automatic font color for screen display"
msgstr "Պաստառի ցուցադրման համար օգտագործեք տառատեսակի ինքնաշխատ գույնը"

#: 01013000.xhp#par_id3146984.20.help.text
#: 01013000.xhp%23par_id3146984.20.help.text
msgid ""
"<ahelp hid=\""
"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_AUTOMATIC_FONT_COLOR\">"
"Displays fonts in <item type=\"productname\">%PRODUCTNAME</item> using the "
"system color settings. This option only affects the screen display.</ahelp>"
msgstr ""
"<ahelp hid=\""
"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_AUTOMATIC_FONT_COLOR\">"
"Արտածում է տառատեսակները <item type=\"productname\">%PRODUCTNAME</item> -"
"ում, օգտագործելով համակարգի գույնի կարգավորումները: Այս տարբերակը ազդում է "
"միայն պաստառին ցուցադրմանը:</ahelp>"

#: 01013000.xhp#hd_id3153091.7.help.text
#: 01013000.xhp%23hd_id3153091.7.help.text
msgid "Use system colors for page previews"
msgstr "Էջի նախադիտման համար օգտագործեք համակարգի գույները"

#: 01013000.xhp#par_id3146923.8.help.text
#: 01013000.xhp%23par_id3146923.8.help.text
msgid ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_PAGE_PREVIEWS\">"
"Applies the high contrast settings of the operating system to page "
"previews.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX_CHECKBOX_RID_SVXPAGE_ACCESSIBILITYCONFIG_CB_PAGE_PREVIEWS\">"
"Էջի նախադիտումներին կիրառում է գործառնական համակարգի բարձր հակադրության "
