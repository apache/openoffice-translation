"<ahelp hid=\"SVX:LISTBOX:RID_SVXPAGE_COLOR:LB_COLORMODEL\">To modify, select "
"the color model: Red-Green-Blue (RGB) or Cyan-Magenta-Yellow-BlacK "
"(CMYK).</ahelp>"
msgstr ""
