#: 01070500.xhp%23par_id3152940.16.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:TP_OPTIONS_MISC:CBX_MASTERPAGE_CACHE\">Specifies "
"whether to use the cache for displaying objects on the master page.</ahelp> "
"This speeds up the display. Unmark the <emph>Use background cache</emph> "
"option if you want to display changing contents on the master page."
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:TP_OPTIONS_MISC:CBX_MASTERPAGE_CACHE\">Նշում է՝ "
"արդյոք օգտագործել քեշը գլխավոր էջում առարկաները ցուցադրելու համար:</ahelp> "
"Սա արագացնում է արտածումը։ Ապաընտրեք <emph>Օգտագործել հետնամասի քեշը</emph> "
"տարբերակը, եթե ցանկանում եք փոփոխվող բովանդակությունը ցուցադրել գլխավոր "
"էջում:"

#: 01070500.xhp#hd_id3147428.17.help.text
#: 01070500.xhp%23hd_id3147428.17.help.text
msgid "Copy when moving"
msgstr "Պատճենել երբ շարժվում է"

#: 01070500.xhp#par_id3154730.18.help.text
#: 01070500.xhp%23par_id3154730.18.help.text
msgid ""
"<ahelp hid=\".\">If enabled, a copy is created when you move an object while "
"holding down the Ctrl key (Mac: Command key).</ahelp> The same will apply "
"for rotating and resizing the object. The original object will remain in its "
"current position and size."
msgstr ""
"<ahelp hid=\".\">Միացված լինելու դեպքում, պատճենը ստեղծվում է, երբ առարկան "
"տեղափոխում ես, մինչ պահում ես Ctrl ստեղնը (Mac: Command ստեղնը)։</ahelp> "
"Նույնը կկիրառվի առարկայի պտտման և չափափոխման համար: Բնօրինակը կմնա իր "
"ներկայիս դիրքում և չափում:"

#: 01070500.xhp#hd_id3148457.19.help.text
#: 01070500.xhp%23hd_id3148457.19.help.text
msgid "Objects always moveable"
msgstr "Առարկաները միշտ շարժական են"

#: 01070500.xhp#par_id3149413.20.help.text
#: 01070500.xhp%23par_id3149413.20.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:TP_OPTIONS_MISC:CBX_MARKED_HIT_MOVES_ALWAYS\">"
"Specifies that you want to move an object with the <emph>Rotate</emph> tool "
"enabled. If<emph> Object always moveable </emph>is not marked, the "
"<emph>Rotate</emph> tool can only be used to rotate an object.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:TP_OPTIONS_MISC:CBX_MARKED_HIT_MOVES_ALWAYS\">Նշում "
"է, որ ցանկանում եք առարկան տեղափոխել <emph>Պտտեցնել</emph> գործիքը միացված: "
"Եթե<emph> Առարկան միշտ շարժական է </emph>նշված չէ, <emph>Պտտեցնել</emph> "
"գործիքը կարող է օգտագործվել միայն առարկան պտտելու համար:</ahelp>"

#: 01070500.xhp#hd_id3154512.21.help.text
#: 01070500.xhp%23hd_id3154512.21.help.text
msgid "Do not distort objects in curve (only in drawings)"
msgstr "Մի աղավաղեք առարկաները կորի մեջ (միայն նկարներում)"

#: 01070500.xhp#par_id3154270.22.help.text
#: 01070500.xhp%23par_id3154270.22.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:TP_OPTIONS_MISC:CBX_CROOK_NO_CONTORTION\">Maintains "
"relative alignment of Bézier points and 2D drawing objects to each other "
"when you distort the object.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:TP_OPTIONS_MISC:CBX_CROOK_NO_CONTORTION\">Առարկան "
"խեղաթյուրելիս պահպանում է Բեզիե կետերի և 2D գծագրության օբյեկտների "
"հարաբերական հավասարեցումը:</ahelp>"

#: 01070500.xhp#hd_id3154163.32.help.text
#: 01070500.xhp%23hd_id3154163.32.help.text
msgid "Unit of measurement"
msgstr "Չափման միավոր"

#: 01070500.xhp#par_id3155066.33.help.text
#: 01070500.xhp%23par_id3155066.33.help.text
msgid ""
"<ahelp hid=\"SD_LISTBOX_TP_OPTIONS_MISC_LB_METRIC\">Determines the <link "
"href=\"text/shared/00/00000003.xhp#metrik\" name=\"Unit of measurement\">"
"Unit of measurement</link> for presentations.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_LISTBOX_TP_OPTIONS_MISC_LB_METRIC\">Որոշում է <link href=\""
"text/shared/00/00000003.xhp#metrik\" name=\"Չափման միավորը\">Չափման "
"միավորը</link> շնորհանդեսների համար։</ahelp>"

#: 01070500.xhp#hd_id3152960.34.help.text
#: 01070500.xhp%23hd_id3152960.34.help.text
msgctxt "01070500.xhp#hd_id3152960.34.help.text"
msgid "Tab stops"
msgstr "Ներդիրի կանգեր"

#: 01070500.xhp#par_id3155443.35.help.text
#: 01070500.xhp%23par_id3155443.35.help.text
msgid ""
"<ahelp hid=\"SD_METRICFIELD_TP_OPTIONS_MISC_MTR_FLD_TABSTOP\">Defines the "
"spacing between tab stops.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_METRICFIELD_TP_OPTIONS_MISC_MTR_FLD_TABSTOP\">Սահմանում է "
"ներդիրների կանգերի միջև հեռավորությունը:</ahelp>"

#: 01070500.xhp#hd_id3156383.24.help.text
#: 01070500.xhp%23hd_id3156383.24.help.text
msgid "Start presentation (only in presentations)"
msgstr "Սկսել շնորհանդեսը (միայն շնորհանդեսներում)"

#: 01070500.xhp#hd_id3155902.26.help.text
#: 01070500.xhp%23hd_id3155902.26.help.text
msgid "Always with current page"
msgstr "Միշտ ընթացիկ էջով"

#: 01070500.xhp#par_id3155962.27.help.text
#: 01070500.xhp%23par_id3155962.27.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:TP_OPTIONS_MISC:CBX_START_WITH_ACTUAL_PAGE\">"
"Specifies that you always want a presentation to start with the current "
"slide.</ahelp> Unmark<emph> Always with current page</emph> to always start "
"a presentation with the first page."
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:TP_OPTIONS_MISC:CBX_START_WITH_ACTUAL_PAGE\">Նշում "
"է, որ դուք միշտ ցանկանում եք, որ շնորհանդեսը սկսվի ընթացիկ սահիկից:</ahelp> "
"Ապանշեք<emph> Միշտ ընթացիկ էջով</emph> որպեսզի շնորհանդեսը միշտ առաջին էջով "
"սկսվի:"

#: 01070500.xhp#hd_id31559020.help.text
#: 01070500.xhp%23hd_id31559020.help.text
msgid "With Presenter Screen"
msgstr "Ներկայացնողի պաստառով"

#: 01070500.xhp#par_id31559620.help.text
#: 01070500.xhp%23par_id31559620.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:TP_OPTIONS_MISC:CBX_START_WITH_PRESENTER_SCREEN\">"
"Specifies that you always want the Presenter Screen to start together with "
"the presentation, in a multiple-monitor setup.</ahelp>. Unmark<emph> With "
"Presenter Screen</emph> to disable the Presenter Screen."
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:TP_OPTIONS_MISC:CBX_START_WITH_PRESENTER_SCREEN\">"
"Նշում է, որ դուք միշտ ուզում եք, որ ներկայացնողի պաստառը սկսվի շնորհանդեսի "
"հետ միասին՝ բազմակի մոնիտորի կարգավորումներում:</ahelp>։ Ապանշեք<emph> "
"Ներկայացնողի պաստառի հետ</emph> ներկայացնողի պաստառը արգելելու համար։"

#: 01070500.xhp#hd_id3163806.41.help.text
#: 01070500.xhp%23hd_id3163806.41.help.text
msgid "Scale (only in drawings)"
msgstr "Մասշտաբ (միայն գծագրերում)"

#: 01070500.xhp#hd_id3145147.43.help.text
#: 01070500.xhp%23hd_id3145147.43.help.text
msgid "Drawing scale"
msgstr "Գծագրի մասշտաբ"

#: 01070500.xhp#par_id3153965.42.help.text
#: 01070500.xhp%23par_id3153965.42.help.text
msgid ""
"<ahelp hid=\"SD_COMBOBOX_TP_OPTIONS_MISC_CB_SCALE\">Determines the drawing "
"scale on the rulers.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_COMBOBOX_TP_OPTIONS_MISC_CB_SCALE\">Որոշում է քանոնների վրա "
"գծագրության սանդղակը:</ahelp>"

#: 01070500.xhp#hd_id3155177.36.help.text
#: 01070500.xhp%23hd_id3155177.36.help.text
msgid "Compatibility (document specific settings)"
msgstr "Համատեղելիություն (փաստաթղթի հատուկ կարգավորումներ)"

#: 01070500.xhp#par_id3155608.44.help.text
#: 01070500.xhp%23par_id3155608.44.help.text
msgid "The settings in this area are valid for the current document only."
msgstr "Այս տարածքում կարգավորումները վավեր են միայն ընթացիկ փաստաթղթի համար:"

#: 01070500.xhp#hd_id3145790.38.help.text
#: 01070500.xhp%23hd_id3145790.38.help.text
msgid "Add spacing between paragraphs in the current document"
msgstr "Ընթացիկ փաստաթղթում պարբերությունների միջև բացատներ ավելացրեք"

#: 01070500.xhp#par_id3145768.39.help.text
#: 01070500.xhp%23par_id3145768.39.help.text
msgid ""
"<ahelp hid=\"SD_CHECKBOX_TP_OPTIONS_MISC_CB_MERGE_PARA_DIST\">Specifies that "
"$[officename] Impress calculates the paragraph spacing exactly like "
"Microsoft PowerPoint.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_CHECKBOX_TP_OPTIONS_MISC_CB_MERGE_PARA_DIST\">Նշում է, որ "
"$[officename] Impress -ը հաշվարկում է պարբերության միջակայքը, ճիշտ այնպես, "
"ինչպես Microsoft PowerPoint-ը:</ahelp>"

#: 01070500.xhp#par_id3146135.40.help.text
#: 01070500.xhp%23par_id3146135.40.help.text
msgid ""
"Microsoft PowerPoint adds the bottom spacing of a paragraph to the top "
"spacing of the next paragraph to calculate the total spacing between both "
"paragraphs. $[officename] Impress utilizes only the larger of the two "
"spacings."
msgstr ""
"Microsoft PowerPoint-ը ավելացնում է պարբերության ներքևի հեռավորությունը "
"հաջորդ պարբերության վերևի տարածությանը` երկու պարբերությունների միջև "
"ընդհանուր տարածությունը հաշվարկելու համար: $[officename] Impress-ն "
"օգտագործում է երկու տարածությունից միայն մեծը:"

#: 01010301.xhp#tit.help.text
#: 01010301.xhp%23tit.help.text
msgctxt "01010301.xhp#tit.help.text"
msgid "Edit Paths"
msgstr "Խմբագրել ուղիները"

#: 01010301.xhp#hd_id3150772.1.help.text
#: 01010301.xhp%23hd_id3150772.1.help.text
msgctxt "01010301.xhp#hd_id3150772.1.help.text"
msgid "Edit Paths"
msgstr "Խմբագրել ուղիները"

#: 01010301.xhp#par_id3149762.2.help.text
#: 01010301.xhp%23par_id3149762.2.help.text
msgid ""
"In the <emph>Edit Paths </emph>dialog, you can select some folders that are "
"available in $[officename]."
msgstr ""
"<emph>Խմբագրել ուղիները </emph>երկխոսությունում, կարող եք ընտրել որոշ "
"պանակներ, որոնք մատչելի են $[officename] -ում:"

#: 01010301.xhp#hd_id3147559.3.help.text
#: 01010301.xhp%23hd_id3147559.3.help.text
msgctxt "01010301.xhp#hd_id3147559.3.help.text"
msgid "Paths"
msgstr "Ուղիներ"

#: 01010301.xhp#par_id3153524.4.help.text
#: 01010301.xhp%23par_id3153524.4.help.text
msgid ""
"<ahelp hid=\"SVX:LISTBOX:RID_SVXDLG_MULTIPATH:LB_MULTIPATH\">Contains a list "
"of the paths that have already been added. Mark the default path for new "
"files.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:LISTBOX:RID_SVXDLG_MULTIPATH:LB_MULTIPATH\">Պարունակում է "
"արդեն ավելացված ուղիների ցուցակը: Նշեք նոր նիշքերի կանխադրված ուղին:</ahelp>"

#: 01010301.xhp#hd_id3148798.5.help.text
#: 01010301.xhp%23hd_id3148798.5.help.text
msgctxt "01010301.xhp#hd_id3148798.5.help.text"
msgid "Add"
msgstr "Ավելացնել"

#: 01010301.xhp#par_id3153106.6.help.text
#: 01010301.xhp%23par_id3153106.6.help.text
msgid ""
"<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXDLG_MULTIPATH:BTN_ADD_MULTIPATH\">Opens "
"the <emph>Select Path</emph> dialog to select another folder or the "
"<emph>Open</emph> dialog to select another file.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:PUSHBUTTON:RID_SVXDLG_MULTIPATH:BTN_ADD_MULTIPATH\">Բացվում "
"է <emph>Ընտրեք ուղին</emph> երկխոսությունը, այլ պանակ ընտրելու համար, կամ "
"<emph>Բացել</emph> երկխոսությունը, այլ նիշք ընտրելու համար։</ahelp>"

#: 01010000.xhp#tit.help.text
#: 01010000.xhp%23tit.help.text
msgctxt "01010000.xhp#tit.help.text"
msgid "$[officename]"
msgstr "$[officename]"

#: 01010000.xhp#hd_id3153750.1.help.text
#: 01010000.xhp%23hd_id3153750.1.help.text
msgctxt "01010000.xhp#hd_id3153750.1.help.text"
msgid "$[officename]"
msgstr "$[officename]"

#: 01010000.xhp#par_id3149177.2.help.text
#: 01010000.xhp%23par_id3149177.2.help.text
msgid ""
"<variable id=\"optionenallgemein\"><ahelp hid=\"SID_GENERAL_OPTIONS\">Use "
"this dialog to create general settings for working with $[officename]. The "
"information covers topics such as user data, saving, printing, paths to "
"important files and directories, and color defaults.</ahelp></variable> "
"These settings are saved automatically."
msgstr ""
"<variable id=\"optionenallgemein\"><ahelp hid=\"SID_GENERAL_OPTIONS\">"
"Օգտագործեք այս երկխոսությունը $[officename] հետ աշխատելու ընդհանուր "
"պարամետրեր ստեղծելու համար: Տեղեկատվությունն ընդգրկում է թեմաներ, ինչպիսիք "
"են օգտագործողի տվյալները, պահպանումը, տպելը, կարևոր նիշքեր ու գրացուցակները "
"տանող ուղիները և գույների կանխադրվածները:</ahelp></variable> Այս "
"կարգաբերումները պահվում են ինքնաշխատ կերպով:"

#: 01020300.xhp#tit.help.text
#: 01020300.xhp%23tit.help.text
msgctxt "01020300.xhp#tit.help.text"
msgid "E-mail"
msgstr "Էլ․ փոստ․"

#: 01020300.xhp#par_idN1054D.help.text
#: 01020300.xhp%23par_idN1054D.help.text
msgid "<link href=\"text/shared/optionen/01020300.xhp\">E-mail</link>"
msgstr "<link href=\"text/shared/optionen/01020300.xhp\">Էլ․ փոստ</link>"

#: 01020300.xhp#par_idN1056B.help.text
#: 01020300.xhp%23par_idN1056B.help.text
msgid ""
"On UNIX systems, specifies the e-mail program to use when you send the "
"current document as e-mail."
msgstr ""
"UNIX համակարգերում սահմանում է էլ. փոստի ծրագիրը, որը պետք է օգտագործվի, երբ "
"ընթացիկ փաստաթուղթը ուղարկում եք որպես էլ․ նամակ։"

#: 01020300.xhp#par_idN10576.help.text
#: 01020300.xhp%23par_idN10576.help.text
msgid "E-mail program"
msgstr "էլ. փոստի ծրագիր։"

#: 01020300.xhp#par_idN1057A.help.text
#: 01020300.xhp%23par_idN1057A.help.text
msgid ""
"<ahelp hid=\"703252484\">Enter the e-mail program path and name.</ahelp>"
msgstr ""
"<ahelp hid=\"703252484\">Մուտքագրեք էլ. փոստի ծրագրի ուղին և անունը:</ahelp>"

#: 01020300.xhp#par_idN10591.help.text
#: 01020300.xhp%23par_idN10591.help.text
msgid "..."
msgstr "..."

#: 01020300.xhp#par_idN10595.help.text
#: 01020300.xhp%23par_idN10595.help.text
msgid ""
