#: 01010500.xhp#par_id3141111.help.text
#: 01010500.xhp%23par_id3141111.help.text
msgid ""
"<ahelp hid=\".\">Opens the Color Picker. First highlight a color in the "
"Color table. Then click Edit to open the Color Picker. Select a color in the "
"Color Picker and click OK. The selected color replaces the color that is "
"highlighted in the Color table.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է Գույնը ընտրողը: Նախ Գունային աղյուսակում ընդգծեք "
"գույնը: Դրանից հետո կտտացրեք Խմբագրել՝ Գույնի ընտրիչը բացելու համար: Ընտրեք "
"գույնը Գույնի ընտրիչում և կտտացրեք ԼԱՎ: Ընտրված գույնը փոխարինում է այն "
"գույնին, որն ընդգծված է Գունային աղյուսակում:</ahelp>"

#: 01010500.xhp#hd_id3159267.33.help.text
