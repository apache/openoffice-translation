#: 01090100.xhp#par_id3149516.9.help.text
#: 01090100.xhp%23par_id3149516.9.help.text
msgid ""
"<ahelp hid=\".\">Applies a thin border to the formula area in the "
"printout.</ahelp> <emph>Title</emph> and <emph>Formula text</emph> are only "
"set down by a frame if the corresponding check box is active."
msgstr ""
"<ahelp hid=\".\">Տպագրության մեջ կիրառվում է բարակ եզր՝ բանաձևի տարածքի "
"վրա:</ahelp> <emph>Վերնագիր</emph> և <emph>Բանաձևի տեքստ</emph> շրջանակով "
"տեղադրվում են միայն այն դեպքում, եթե համապատասխան վանդակը ակտիվ է:"

#: 01090100.xhp#hd_id3153822.10.help.text
#: 01090100.xhp%23hd_id3153822.10.help.text
msgid "Print format"
msgstr "Տպելու ձևաչափ"

#: 01090100.xhp#hd_id3150503.12.help.text
#: 01090100.xhp%23hd_id3150503.12.help.text
msgid "Original size"
msgstr "Իրական չափ"

#: 01090100.xhp#par_id3153627.13.help.text
#: 01090100.xhp%23par_id3153627.13.help.text
msgid ""
"<ahelp hid=\"STARMATH_RADIOBUTTON_RID_PRINTOPTIONPAGE_RB_ORIGINAL_SIZE\">"
"Prints the formula without adjusting the current font size.</ahelp> It is "
"possible that with large formulas a part of the command text is cut off."
msgstr ""
"<ahelp hid=\"STARMATH_RADIOBUTTON_RID_PRINTOPTIONPAGE_RB_ORIGINAL_SIZE\">"
"Տպում է բանաձևը՝ առանց ընթացիկ տառատեսակի չափը ճշգրտելու:</ahelp> Հնարավոր "
"է, որ մեծ բանաձևերի դեպքում հրամանի տեքստի մի մասը կտրվում է:"

#: 01090100.xhp#hd_id3153896.14.help.text
#: 01090100.xhp%23hd_id3153896.14.help.text
msgid "Fit to size"
msgstr "Տեղավորել չափի մեջ"

#: 01090100.xhp#par_id3150541.15.help.text
#: 01090100.xhp%23par_id3150541.15.help.text
msgid ""
"<ahelp hid=\"STARMATH_RADIOBUTTON_RID_PRINTOPTIONPAGE_RB_FIT_TO_PAGE\">"
"Adjusts the formula to the page format used in the printout.</ahelp> The "
"real size will be determined by the used paper format."
msgstr ""
"<ahelp hid=\"STARMATH_RADIOBUTTON_RID_PRINTOPTIONPAGE_RB_FIT_TO_PAGE\">"
"Բանաձևը հարմարեցվում է տպագրության մեջ օգտագործվող էջի ձևաչափին:</ahelp> "
"Իրական չափը որոշվելու է օգտագործված թղթի ձևաչափով:"

#: 01090100.xhp#hd_id3153381.16.help.text
#: 01090100.xhp%23hd_id3153381.16.help.text
msgctxt "01090100.xhp#hd_id3153381.16.help.text"
msgid "Scaling"
msgstr "Մասշտաբավորում"

#: 01090100.xhp#par_id3147084.17.help.text
#: 01090100.xhp%23par_id3147084.17.help.text
msgid ""
"<ahelp hid=\"STARMATH_METRICFIELD_RID_PRINTOPTIONPAGE_MF_ZOOM\">Reduces or "
"enlarges the size of the printed formula by a specified enlargement "
"factor.</ahelp> Type the desired enlargement factor directly in the "
"<emph>Scaling</emph> control, or set the value using the arrow buttons."
msgstr ""
"<ahelp hid=\"STARMATH_METRICFIELD_RID_PRINTOPTIONPAGE_MF_ZOOM\">Նվազեցնում "
"կամ մեծացնում է տպվող բանաձևի չափը` խոշորացման նշված գործոնով:</ahelp> "
"Մուտքագրեք խոշորացման ցանկալի գործոնն ուղղակիորեն <emph>Մասշտաբավորում</emph>"
" հսկիչում, կամ նշանակեք արժեք ՝ օգտագործելով սլաքի կոճակները:"

#: 01090100.xhp#hd_id3147228.19.help.text
#: 01090100.xhp%23hd_id3147228.19.help.text
msgid "Other options"
msgstr "Այլ ընտրանքներ"

#: 01090100.xhp#hd_id3149808.21.help.text
#: 01090100.xhp%23hd_id3149808.21.help.text
msgid "Ignore ~ and ' at the end of the line"
msgstr "Անտեսեք ~ և ' տողի վերջում"

#: 01090100.xhp#par_id3149203.22.help.text
#: 01090100.xhp%23par_id3149203.22.help.text
msgid ""
"<ahelp hid=\"STARMATH_CHECKBOX_RID_PRINTOPTIONPAGE_CB_IGNORE_SPACING\">"
"Specifies that these space wildcards will be removed if they are at the end "
"of a line.</ahelp> In earlier versions of $[officename], adding such "
"characters at the end of a line prevented the right edge of the formula from "
"being cut off during printing."
msgstr ""
"<ahelp hid=\"STARMATH_CHECKBOX_RID_PRINTOPTIONPAGE_CB_IGNORE_SPACING\">Նշում "
"է, որ բացատի այս վայրի քարտերը կհեռացվեն, եթե դրանք տողի վերջում են:</ahelp> "
"$[officename] -ի ավելի վաղ տարբերակներում տողի վերջում այդպիսի նիշերի "
"ավելացումը կանխում է տպելու ընթացքում բանաձևի աջ եզրի կտրումը:"

#: 01090100.xhp#hd_id31567808.help.text
#: 01090100.xhp%23hd_id31567808.help.text
msgid "Embed only used symbols (smaller file size)"
msgstr "Տեղադրեք միայն օգտագործված նիշերը (նիշքի փոքր չափը)"

#: 01090100.xhp#par_id3789203.help.text
#: 01090100.xhp%23par_id3789203.help.text
msgid ""
"<ahelp hid=\".\">Saves only those symbols which each formula that are used "
"in that formula.</ahelp> In earlier versions of $[officename], all symbols "
"were saved with each formula."
msgstr ""
"<ahelp hid=\".\">Պահում է միայն այն նիշերը, որոնք յուրաքանչյուր բանաձևով "
"օգտագործվում են այդ բանաձևում:</ahelp> $[officename] -ի ավելի վաղ "
"տարբերակներում բոլոր նիշերը պահվել են յուրաքանչյուր բանաձևի հետ:"

