#: 01060500.xhp#hd_id3145750.22.help.text
#: 01060500.xhp%23hd_id3145750.22.help.text
msgid "Steps"
msgstr "Քայլեր"

#: 01060500.xhp#par_id3152576.23.help.text
#: 01060500.xhp%23par_id3152576.23.help.text
msgid ""
"<ahelp hid=\"SC:NUMERICFIELD:RID_SCPAGE_CALC:ED_STEPS\">Sets the maximum "
"number of iteration steps.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:NUMERICFIELD:RID_SCPAGE_CALC:ED_STEPS\">Կարգավորում է "
"կրկնության քայլերի առավելագույն քանակը:</ahelp>"

#: 01060500.xhp#hd_id3153728.24.help.text
#: 01060500.xhp%23hd_id3153728.24.help.text
msgid "Minimum Change"
msgstr "Նվազագույն փոփոխություն"

#: 01060500.xhp#par_id3153139.25.help.text
#: 01060500.xhp%23par_id3153139.25.help.text
msgid ""
"<ahelp hid=\"SC:EDIT:RID_SCPAGE_CALC:ED_EPS\">Specifies the difference "
"between two consecutive iteration step results. If the result of the "
"iteration is lower than the minimum change value, then the iteration will "
"stop.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:EDIT:RID_SCPAGE_CALC:ED_EPS\">Նշում է տարբերությունը "
"իտերացիոն երկու անընդմեջ քայլերի արդյունքների միջև: Եթե կրկնության արդյունքը "
"ցածր է փոփոխության նվազագույն արժեքից, ապա իտերացիան կդադարի:</ahelp>"

#: 01060500.xhp#hd_id3147125.45.help.text
#: 01060500.xhp%23hd_id3147125.45.help.text
msgctxt "01060500.xhp#hd_id3147125.45.help.text"
msgid "Date"
msgstr "Ամսաթիվ"

#: 01060500.xhp#par_id3155416.46.help.text
#: 01060500.xhp%23par_id3155416.46.help.text
msgid "Select the start date for the internal conversion from days to numbers."
msgstr "Ընտրեք ներքին վերափոխման մեկնարկի ամսաթիվը՝ օրերից թվերի:"

#: 01060500.xhp#hd_id3147396.47.help.text
#: 01060500.xhp%23hd_id3147396.47.help.text
msgid "12/30/1899 (default)"
msgstr "12/30/1899 (լռելյայն)"

#: 01060500.xhp#par_id3145646.48.help.text
#: 01060500.xhp%23par_id3145646.48.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_CALC:BTN_DATESTD\">Sets 12/30/1899 as "
"day zero.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_CALC:BTN_DATESTD\">տեղադրում է 12/30/"
"1899 որպես զրո օր։</ahelp>"

#: 01060500.xhp#hd_id3156283.49.help.text
#: 01060500.xhp%23hd_id3156283.49.help.text
msgid "01/01/1900 (StarCalc 1.0)"
msgstr "01/01/1900 (StarCalc 1.0)"

#: 01060500.xhp#par_id3154018.50.help.text
#: 01060500.xhp%23par_id3154018.50.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_CALC:BTN_DATESC10\">Sets 1/1/1900 as "
"day zero. Use this setting for StarCalc 1.0 spreadsheets containing date "
"entries.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_CALC:BTN_DATESC10\">Տեղադրում է 1/1/"
"1900 որպես զրո օր։ Օգտագործեք այս կարգաբերումը StarCalc 1.0 ամսաթվերի "
"մուտքեր պարունակող փռված թերթիկներում:</ahelp>"

#: 01060500.xhp#hd_id3156181.51.help.text
#: 01060500.xhp%23hd_id3156181.51.help.text
msgid "01/01/1904"
msgstr "01/01/1904"

#: 01060500.xhp#par_id3153948.52.help.text
#: 01060500.xhp%23par_id3153948.52.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_CALC:BTN_DATE1904\">Sets 1/1/1904 as "
"day zero. Use this setting for spreadsheets that are imported in a foreign "
"format.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_CALC:BTN_DATE1904\">տեղադրում էs 1/1/"
"1904 որպես զրո օր։ Օգտագործեք այս կարգավորումը փռված թերթիկների համար, որոնք "
"ներմուծված են օտար ձևաչափով:</ahelp>"

#: 01060500.xhp#hd_id3153838.26.help.text
#: 01060500.xhp%23hd_id3153838.26.help.text
msgid "Case sensitive"
msgstr "Զգայուն ռեգիստրի նկատմամբ"

#: 01060500.xhp#par_id3146793.27.help.text
#: 01060500.xhp%23par_id3146793.27.help.text
msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_CASE\">Specifies whether to "
"distinguish between upper and lower case in texts when comparing cell "
"contents.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_CASE\">Բջիջների "
"պարունակությունը համեմատելիս որոշում է տեքստերում տարբերակել մեծատառերը և "
"փոքրատառերը:</ahelp>"

#: 01060500.xhp#par_id3153707.28.help.text
#: 01060500.xhp%23par_id3153707.28.help.text
msgid ""
"         <emph>Example:</emph> Type the text 'Test' in cell A1; and the text "
"'test' in B1. Then type the formula \"=A1=B1\" in cell C1. If the <emph>Case "
"sensitive</emph> box is marked, FALSE will appear in the cell; otherwise, "
"TRUE will appear in the cell."
msgstr ""
"         <emph>Example:</emph> A1 բջիջում մուտքագրեք «Թեստ» տեքստը, և B1-ում "
"«թեստ» տեքստը: Դրանից հետո C1 բջիջում մուտքագրեք \"=A1=B1\" բանաձեւը: Եթե "
"նշված է <emph>Ընտրությանը զգայուն</emph> վանդակը, բջիջում կհայտնվի FALSE; "
"հակառակ դեպքում բջիջում կհայտնվի TRUE:"

#: 01060500.xhp#par_id3153965.29.help.text
#: 01060500.xhp%23par_id3153965.29.help.text
msgid ""
"The EXACT text function is always case-sensitive, independent of the "
"settings in this dialog."
msgstr ""
"EXACT տեքստի գործառույթը ընտրությանը միշտ զգայուն է՝ անկախ այս երկխոսության "
"պարամետրերից:"

#: 01060500.xhp#hd_id3145231.53.help.text
#: 01060500.xhp%23hd_id3145231.53.help.text
msgid "Decimal places"
msgstr "Տասնորդական դիրքեր"

#: 01060500.xhp#par_id3149568.54.help.text
#: 01060500.xhp%23par_id3149568.54.help.text
msgid ""
"<ahelp hid=\"SC:NUMERICFIELD:RID_SCPAGE_CALC:ED_PREC\">Defines the number of "
"decimals to be displayed for numbers with the <emph>Standard</emph> number "
"format. The numbers are displayed as rounded numbers, but are not saved as "
"rounded numbers.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:NUMERICFIELD:RID_SCPAGE_CALC:ED_PREC\">Սահմանում է "
"<emph>Ստանդարտ</emph> թվային ձևաչափով թվերի համար ցուցադրվող տասնորդականների "
"քանակը: Թվերը ցուցադրվում են որպես կլորացված թվեր, բայց չեն պահվում որպես "
"կլորացված թվեր:</ahelp>"

#: 01060500.xhp#hd_id3145150.30.help.text
#: 01060500.xhp%23hd_id3145150.30.help.text
msgid "Precision as shown"
msgstr "Ճշգրտություն, ինչպես ցույց է տրված"

#: 01060500.xhp#par_id3150644.31.help.text
#: 01060500.xhp%23par_id3150644.31.help.text
msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_CALC\">Specifies whether to "
"make calculations using the rounded values displayed in the sheet. Charts "
"will be shown with the displayed values. If the <emph>Precision as "
"shown</emph> option is not marked, the displayed numbers are rounded, but "
"they are calculated internally using the non-rounded number.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_CALC\">Նշում է, թե արդյոք պետք "
"է կատարել հաշվարկներ, օգտագործելով թերթում ցուցադրված կլորացված արժեքները: "
"Գծապատկերները կցուցադրվեն ցուցադրվող արժեքներով: Եթե <emph>Ճշգրտությունը, "
"ինչպես ցույց է տրված</emph> տարբերակը նշված չէ, ցուցադրված թվերը կլորացվում "
"են, բայց դրանք ներքին հաշվարկվում են՝ օգտագործելով չկլորացված թիվը:</ahelp>"

#: 01060500.xhp#hd_id3152581.32.help.text
#: 01060500.xhp%23hd_id3152581.32.help.text
msgid "Search criteria = and <> must apply to whole cells"
msgstr "Փնտրման չափորոշիչը = և <> պետք է կիրառվեն բոլոր բջիջների վրա"

#: 01060500.xhp#par_id3149211.33.help.text
#: 01060500.xhp%23par_id3149211.33.help.text
msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_MATCH\">Specifies that the "
"search criteria you set for the Calc database functions must match the whole "
"cell exactly. When the <emph>Search criteria = and <> must apply to whole "
"cells</emph> box is marked, $[officename] Calc behaves exactly as MS Excel "
"when searching cells in the database functions.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_MATCH\">Նշում է, որ Calc "
"տվյալների շտեմարանի գործառույթների համար ձեր կողմից սահմանված որոնման "
"չափանիշները պետք է ճշգրտորեն համապատասխանեն ամբողջ բջիջին: Երբ <emph>Փնտրման "
"չափորոշիչը = և <> պետք է կիրառվեն բոլոր բջիջների վրա</emph> վանդակը ընտրված "
"է, $[officename] Calc իրեն պահում է ճիշտ այնպես, ինչպես MS Excel-ը տվյալների "
"շտեմարանի գործառույթներում բջիջներ որոնելիս:</ahelp>"

#: 01060500.xhp#par_id3148422.34.help.text
#: 01060500.xhp%23par_id3148422.34.help.text
msgid ".* in following position:"
msgstr ".* հետևյալ դիրքում:"

#: 01060500.xhp#par_id3156139.35.help.text
#: 01060500.xhp%23par_id3156139.35.help.text
msgid "Search result:"
msgstr "Որոնման արդյունք։"

#: 01060500.xhp#par_id3150979.36.help.text
#: 01060500.xhp%23par_id3150979.36.help.text
msgid "win"
msgstr "win"

#: 01060500.xhp#par_id3159239.37.help.text
#: 01060500.xhp%23par_id3159239.37.help.text
msgid "Finds win, but not win95, os2win, or upwind"
msgstr "Գտնում է win, բայց ոչ win95, os2win, կամ upwind"

#: 01060500.xhp#par_id3153782.38.help.text
#: 01060500.xhp%23par_id3153782.38.help.text
msgid "win.*"
msgstr "win.*"

#: 01060500.xhp#par_id3151278.39.help.text
#: 01060500.xhp%23par_id3151278.39.help.text
msgid "Finds win and win95, but not os2win or upwind"
msgstr "Գտնում է win և win95, բայց ոչ os2win կամ upwind"

#: 01060500.xhp#par_id3155506.40.help.text
#: 01060500.xhp%23par_id3155506.40.help.text
msgid ".*win"
msgstr ".*win"

#: 01060500.xhp#par_id3150886.41.help.text
#: 01060500.xhp%23par_id3150886.41.help.text
msgid "Finds win and os2win, but not win95 or upwind"
msgstr "Գտնում է win և os2win, բայց ոչ win95 կամ upwind"

#: 01060500.xhp#par_id3147167.42.help.text
#: 01060500.xhp%23par_id3147167.42.help.text
msgid ".*win.*"
msgstr ".*win.*"

#: 01060500.xhp#par_id3152985.43.help.text
#: 01060500.xhp%23par_id3152985.43.help.text
msgid "Finds win, win95, os2win, and upwind"
msgstr "Գտնում է win, win95, os2win, և upwind"

#: 01060500.xhp#par_id3148814.44.help.text
#: 01060500.xhp%23par_id3148814.44.help.text
msgid ""
"If <emph>Search criteria = and <> must apply to whole cells </emph>is not "
"enabled, the \"win\" search pattern acts like \".*win.*\". The search "
"pattern can be at any position within the cell when searching with the Calc "
"database functions."
msgstr ""
"Ե <emph>Փնտրման չափորոշիչը = և <> պետք է կիրառվի բոլոր բջիջների վրա </emph>"
"չի թույլատրված, որոնման \"win\" կաղապարը աշխատում է ինչպես \".*win.*\"։ "
"Տվյալների Calc շտեմարանի գործառույթներով որոնում կատարելիս փնտոման կաղապարը "
"կարող է լինել բջիջի ցանկացած դիրքում:"

#: 01060500.xhp#hd_id3156448.58.help.text
#: 01060500.xhp%23hd_id3156448.58.help.text
msgid "Enable regular expressions in formulas"
msgstr "Թույլատրել կանոնավոր արտահայտությունները բանաձևերում"

#: 01060500.xhp#par_id3155092.59.help.text
#: 01060500.xhp%23par_id3155092.59.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CALC_BTN_REGEX\">Specifies that regular "
"expressions are enabled when searching and also for character string "
"comparisons.</ahelp><switchinline select=\"appl\"><caseinline select=\"CALC\""
"> This relates to the <link href=\"text/scalc/01/04060101.xhp\" name=\""
"database functions\">database functions</link>, and to VLOOKUP, HLOOKUP and "
"SEARCH.</caseinline></switchinline>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CALC_BTN_REGEX\">Նշում է, որ կանոնավոր "
"արտահայտությունները միացված են որոնման ժամանակ, ինչպես նաև նիշերի տողի "
"համեմատության համար:</ahelp><switchinline select=\"appl\"><caseinline select="
"\"CALC\"> Սա վերաբերում է <link href=\"text/scalc/01/04060101.xhp\" name=\""
"շտեմարանի գործառույթներ\">շտեմարանի գործառույթներ</link>, և VLOOKUP, HLOOKUP "
"ու SEARCH։</caseinline></switchinline>"

#: 01060500.xhp#hd_id3156199.55.help.text
#: 01060500.xhp%23hd_id3156199.55.help.text
msgid "Automatically find column and row labels"
msgstr "Ինքնաշխատ կերպով գտնել սյունակի և շարքի պիտակները"

#: 01060500.xhp#par_id3153818.56.help.text
#: 01060500.xhp%23par_id3153818.56.help.text
msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_LOOKUP\">Specifies that you can "
"use the text in any cell as a label for the column below the text or the row "
"to the right of the text. The text must consist of at least one word and "
"must not contain any operators.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_CALC:BTN_LOOKUP\">Նշում է, որ ցանկացած "
"բջիջում կարող եք օգտագործել տեքստը որպես տեքստի ներքևի սյունակի կամ տեքստի "
"աջ շարքի պիտակ: Տեքստը պետք է բաղկացած լինի առնվազն մեկ բառից և չպետք է "
"պարունակի որևէ օպերատոր:</ahelp>"

#: 01060500.xhp#par_id3151242.57.help.text
#: 01060500.xhp%23par_id3151242.57.help.text
msgid ""
"         <emph>Example</emph>: Cell E5 contains the text \"Europe\". Below, "
"in cell E6, is the value 100 and in cell E7 the value 200. If the <emph>"
"Automatically find column and row labels</emph> box is marked, you can write "
"the following formula in cell A1: =SUM(Europe)."
msgstr ""
"         <emph>Example</emph>: E5 բջիջը պարունակում է \"Europe\" տեքստը։ "
"Ստորև, E6 բջիջում, 100 արժեքն է, և E7 բջիջում՝ 200 արժեքն է։ Եթե <emph>"
"Ինքնաշխատ գտնել սյունակի և շարքի պիտակները</emph> վանդակը նշված է, դուք "
"բջիջում կարող եք գրել հետևյալ բանաձևը A1: =SUM(Europe)."

#: 01060500.xhp#hd_id315634199.help.text
#: 01060500.xhp%23hd_id315634199.help.text
msgid "Limit decimals for general number format"
msgstr "Սահմանիր տասնորդականները թվի ընդհանուր ձևաչափի համար"

#: 01060500.xhp#par_id315343818.help.text
#: 01060500.xhp%23par_id315343818.help.text
msgid ""
"<ahelp hid=\".\">You can specify the maximum number of decimal places that "
"are shown by default for cells with General number format. If not enabled, "
"cells with General number format show as many decimal places as the column "
"width allows.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընդհանուր թվի ձևաչափով բջիջների համար կարող եք նշել "
"առավելագույն թվով տասնորդական տեղերը: Եթե միացված չէ, ընդհանուր թվի ձևաչափով "
"բջիջները ցույց են տալիս այնքան տասնորդական թվեր, որքան թույլ է տալիս "
"սյունակի լայնությունը:</ahelp>"

#: 01041000.xhp#tit.help.text
#: 01041000.xhp%23tit.help.text
msgid "Compatibility"
msgstr "Համատեղելիություն"

#: 01041000.xhp#bm_id3577990.help.text
#: 01041000.xhp%23bm_id3577990.help.text
msgid ""
"<bookmark_value>Word documents;compatibility</bookmark_value>      "
"<bookmark_value>importing;compatibility settings for text "
"import</bookmark_value>      <bookmark_value>options;compatibility "
"(Writer)</bookmark_value>      <bookmark_value>compatibility settings for MS "
"Word import</bookmark_value>      <bookmark_value>Microsoft Office;importing "
"Word documents</bookmark_value>      <bookmark_value>layout;importing Word "
"documents</bookmark_value>      <bookmark_value>formatting;printer metrics "
"(Writer)</bookmark_value>      <bookmark_value>metrics;document formatting "
"(Writer)</bookmark_value>      <bookmark_value>printer metrics for document "
"formatting (Writer)</bookmark_value>"
msgstr ""
"<bookmark_value>Word documents;compatibility</bookmark_value>      "
"<bookmark_value>importing;compatibility settings for text "
"import</bookmark_value>      <bookmark_value>options;compatibility "
"(Writer)</bookmark_value>      <bookmark_value>compatibility settings for MS "
"Word import</bookmark_value>      <bookmark_value>Microsoft Office;importing "
"Word documents</bookmark_value>      <bookmark_value>layout;importing Word "
"documents</bookmark_value>      <bookmark_value>formatting;printer metrics "
"(Writer)</bookmark_value>      <bookmark_value>metrics;document formatting "
"(Writer)</bookmark_value>      <bookmark_value>printer metrics for document "
"formatting (Writer)</bookmark_value>"

#: 01041000.xhp#par_idN10607.help.text
#: 01041000.xhp%23par_idN10607.help.text
msgid ""
"<variable id=\"compatibility_var\"><link href=\""
"text/shared/optionen/01041000.xhp\">Compatibility</link></variable>"
msgstr ""
"<variable id=\"compatibility_var\"><link href=\""
"text/shared/optionen/01041000.xhp\">Համատեղելիություն</link></variable>"

#: 01041000.xhp#par_idN10625.help.text
#: 01041000.xhp%23par_idN10625.help.text
msgid ""
"<ahelp hid=\"53251\">Specifies compatibility settings for text documents. "
"These options help in fine-tuning %PRODUCTNAME when importing Microsoft Word "
"documents.</ahelp>"
msgstr ""
"<ahelp hid=\"53251\">Նշում է տեքստային փաստաթղթերի համատեղելիության "
"կարգավորումները: Այս ընտրանքները օգնում են ճշգրտել %PRODUCTNAME -ը ՝ "
"Microsoft Word փաստաթղթեր ներմուծելիս:</ahelp>"

#: 01041000.xhp#par_id3153876.17.help.text
#: 01041000.xhp%23par_id3153876.17.help.text
msgid ""
"Some of the settings defined here are only valid for the current document "
"and must be defined separately for each document."
msgstr ""
"Այստեղ սահմանված կարգավորումներից մի քանիսը վավեր են միայն ընթացիկ փաստաթղթի "
"համար և պետք է սահմանվեն յուրաքանչյուր փաստաթղթի համար առանձին:"

#: 01041000.xhp#hd_id3149400.47.help.text
#: 01041000.xhp%23hd_id3149400.47.help.text
msgid "Use printer metrics for document formatting"
msgstr "Փաստաթղթի ձևավորման համար օգտագործեք տպիչի չափիչները"

#: 01041000.xhp#par_id3155602.48.help.text
#: 01041000.xhp%23par_id3155602.48.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_TP_OPTLOAD_PAGE_CB_PRINTER_METRICS\">Specifies that "
"printer metrics are applied for printing and also for formatting the display "
"on the screen.</ahelp> If this box is not checked, a printer independent "
"layout will be used for screen display and printing."
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_TP_OPTLOAD_PAGE_CB_PRINTER_METRICS\">Նշում է, որ "
"տպիչի չափիչները կիրառվում են տպելու, ինչպես նաև պաստառին արտածումը "
"ձևաչափելու համար:</ahelp> Եթե այս վանդակը նշված չէ, պաստառի ցուցադրման և "
"տպման համար կօգտագործվի տպիչի անկախ դասավորությունը:"

#: 01041000.xhp#par_id3155768.49.help.text
#: 01041000.xhp%23par_id3155768.49.help.text
msgid ""
"If you set this option for the current document and then save the document, "
"for example, in an older binary format, this option will not be saved. If "
"you later open the file from the older format, this option will be set by "
"default."
msgstr ""
"Եթե այս տարբերակը դրել եք ընթացիկ փաստաթղթի համար և այնուհետև պահեք "
"փաստաթուղթը, օրինակ՝ ավելի հին երկուական ձևաչափով, այս տարբերակը չի պահվի: "
"Եթե հետագայում նիշքը բացեք հին ձևաչափից, ապա այս տարբերակը նախադրված կլինի:"

#: 01041000.xhp#hd_id3145640.9.help.text
#: 01041000.xhp%23hd_id3145640.9.help.text
msgctxt "01041000.xhp#hd_id3145640.9.help.text"
msgid "Add spacing between paragraphs and tables (in current document)"
msgstr ""
"Պարբերությունների և աղյուսակների միջև հեռավորություն ավելացրեք (ընթացիկ "
"փաստաթղթում)"

#: 01041000.xhp#par_id3147339.18.help.text
#: 01041000.xhp%23par_id3147339.18.help.text
msgid ""
"In $[officename] Writer, paragraph spacing is defined differently than in MS "
"Word documents. If you have defined spacing between two paragraphs or "
"tables, spacing is also added in the corresponding MS Word documents."
msgstr ""
"$[officename] Writer -ում, պարբերությունների միջև տարածությունը սահմանվում է "
"այլ կերպ, քան MS Word փաստաթղթերում: Եթե դուք սահմանել եք հեռավորություն "
"երկու պարբերության կամ աղյուսակի միջև, տարածությունը նույնպես ավելացվում է "
"համապատասխան MS Word փաստաթղթերում:"

#: 01041000.xhp#par_id3151250.19.help.text
#: 01041000.xhp%23par_id3151250.19.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_OPTLOAD_PAGE:CB_MERGE_PARA_DIST\">Specifies "
"whether to add MS Word-compatible spacing between paragraphs and tables in "
"$[officename] Writer text documents.</ahelp>"
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_OPTLOAD_PAGE:CB_MERGE_PARA_DIST\">Նշում է, թե "
"արդյոք ավելացնել $[officename] Writer տեքստային փաստաթղթերում պարբերության և "
"աղյուսակի միջև MS Word համատեղելի միջակայք ավելացնելը:</ahelp>"

#: 01041000.xhp#hd_id3146317.29.help.text
#: 01041000.xhp%23hd_id3146317.29.help.text
msgctxt "01041000.xhp#hd_id3146317.29.help.text"
msgid "Add paragraph and table spacing at tops of pages (in current document)"
msgstr ""
"Էջերի վերևում ավելացնել պարբերությունների և աղյուսակների միջակայքը (ընթացիկ "
"փաստաթղթում)"

#: 01041000.xhp#par_id3155333.30.help.text
#: 01041000.xhp%23par_id3155333.30.help.text
msgid ""
"<ahelp hid=\"SW:CHECKBOX:TP_OPTLOAD_PAGE:CB_MERGE_PARA_DIST_PAGESTART\">"
"Specifies whether paragraph spacing at the top of a page will also be "
"effective at the beginning of a page or column if the paragraph is "
"positioned on the first page of the document.</ahelp> The same applies for a "
"page break."
msgstr ""
"<ahelp hid=\"SW:CHECKBOX:TP_OPTLOAD_PAGE:CB_MERGE_PARA_DIST_PAGESTART\">"
"Նշում է, թե արդյոք էջի վերևում պարբերության միջակայքը արդյունավետ կլինի նաև "
"էջի կամ սյունակի սկզբում, եթե պարբերությունը տեղադրված է փաստաթղթի առաջին "
"էջում:</ahelp> Նույնը վերաբերում է էջի ընդմիջմանը:"

#: 01041000.xhp#par_id3145789.20.help.text
#: 01041000.xhp%23par_id3145789.20.help.text
msgid ""
"If you import an MS Word document, the spaces are automatically added during "
"the conversion."
msgstr ""
"Եթե ներմուծում եք MS Word փաստաթուղթ, փոխակերպման ընթացքում բացատներն "
"ինքնաշխատ ավելացվում են:"

#: 01041000.xhp#hd_id3149964.42.help.text
#: 01041000.xhp%23hd_id3149964.42.help.text
msgid "Use %WRITERCOMPATIBILITYVERSIONOOO11 tab stop formatting"
msgstr "Օգտագործեք %WRITERCOMPATIBILITYVERSIONOOO11 ներդիրի կանգի ձևաչափումը"

#: 01041000.xhp#par_id3152777.43.help.text
#: 01041000.xhp%23par_id3152777.43.help.text
msgid ""
"<ahelp hid=\"SW_CHECKBOX_TP_OPTLOAD_PAGE_CB_TAB_ALIGNMENT\">Specifies how to "
"align text at tab stops beyond the right margin, how to handle decimal tab "
"stops, and how to handle tab stops close to a line break.</ahelp> If this "
"check box is not selected, tab stops are handled in the same way as in other "
"Office applications."
msgstr ""
"<ahelp hid=\"SW_CHECKBOX_TP_OPTLOAD_PAGE_CB_TAB_ALIGNMENT\">Նշում է, թե "
"ինչպես հավասարեցնել տեքստը ներդիրի կանգառներին աջ եզրից այն կողմ, ինչպես "
"կարգավորել տասնորդական կանգառները և ինչպես կարգավորել ներդիրի կանգառները գծի "
"ընդմիջման մոտ:</ahelp> Եթե այս ընտրավանդակը ընտրված չէ, ներդիրների "
"կանգառները մշակվում են այնպես, ինչպես գրասենյակային մյուս ծրագրերում:"

#: 01041000.xhp#par_idN10810.help.text
#: 01041000.xhp%23par_idN10810.help.text
msgid ""
"In text documents created by your current version of Writer, the new tab "
"stop handling is used by default. In text documents created by Writer "
"versions prior to StarOffice 8 or OpenOffice.org 2.0, the old tab stop "
"handling is applied."
msgstr ""
"Writer-ի ձեր ընթացիկ տարբերակի կողմից ստեղծված տեքստային փաստաթղթերում "
"լռելյայն օգտագործվում է ներդիրների կանգի նոր գործարկումը: Նախքան StarOffice "
"8-ին կամ OpenOffice.org 2.0-ին նախորդող Writer-ի վարկածները, որոնք ստեղծվել "
"են տեքստային փաստաթղթերում, կիրառվում է հին ներդիրի բռնակի վարումը:"

#: 01041000.xhp#par_idN107F9.help.text
#: 01041000.xhp%23par_idN107F9.help.text
msgid "Do not add leading (extra space) between lines of text"
msgstr "Տեքստի տողերի միջեւ մի ավելացրեք առաջատար (լրացուցիչ բացատներ)"

#: 01041000.xhp#par_idN10806.help.text
#: 01041000.xhp%23par_idN10806.help.text
msgid ""
"Specifies that additional leading (extra space) between lines of text is not "
"added, even if the font in use contains the additional leading attribute."
msgstr ""
"Նշում է, որ տեքստի տողերի միջև լրացուցիչ առաջատար (լրացուցիչ բացատ) չի "
"ավելացվում, նույնիսկ եթե օգտագործվող տառատեսակը պարունակում է լրացուցիչ "
"առաջատար հատկանիշ:"

#: 01041000.xhp#par_idN10809.help.text
#: 01041000.xhp%23par_idN10809.help.text
msgid ""
"In text documents created by your current version of Writer, the additional "
"leading is used by default. In text documents created by Writer versions "
"prior to StarOffice 8 or OpenOffice.org 2.0, the additional leading is not "
"used."
msgstr ""
"Writer -ի ձեր ներկայիս տարբերակի կողմից ստեղծված տեքստային փաստաթղթերում "
"լրացուցիչ առաջատարն օգտագործվում է լռելյայն: Նախքան StarOffice 8-ին կամ "
"OpenOffice.org 2.0-ին նախորդող Writer -ի վարկածներում, որոնք ստեղծվել են "
"տեքստային փաստաթղթերում, լրացուցիչ առաջատարը չի օգտագործվում:"

#: 01041000.xhp#par_idN107FF.help.text
#: 01041000.xhp%23par_idN107FF.help.text
msgid "Use %WRITERCOMPATIBILITYVERSIONOOO11 line spacing"
msgstr "Օգտագործեք %WRITERCOMPATIBILITYVERSIONOOO11 գծերի հեռավորությունը"

#: 01041000.xhp#par_idN10815.help.text
#: 01041000.xhp%23par_idN10815.help.text
msgid ""
"If the option is off, a new process for formatting text lines with "
"proportional line spacing will be applied. If the option is on, the previous "
"method of formatting of text lines with proportional line spacing will be "
"applied."
msgstr ""
"Եթե տարբերակն անջատված է, կկիրառվի տեքստի տողերի համաչափ տարածությամբ "
"ձևաչափման նոր գործընթացը: Եթե տարբերակը միացված է, կկիրառվի տեքստի տողերի "
"համամասնական հեռավորությամբ ձևաչափման նախորդ մեթոդը:"

#: 01041000.xhp#par_idN10818.help.text
#: 01041000.xhp%23par_idN10818.help.text
msgid ""
"In text documents created by your current version of Writer and in Microsoft "
"Word documents of recent versions, the new process is used. In text "
"documents created by Writer versions prior to StarOffice 8 or OpenOffice.org "
"2.0, the previous process is used."
msgstr ""
"Writer-ի ձեր ներկայիս տարբերակով ստեղծած տեքստային փաստաթղթերում և Microsoft "
"Word-ի վերջին տարբերակների փաստաթղթերում օգտագործվում է նոր գործընթացը: Մինչ "
"StarOffice 8-ը կամ OpenOffice.org 2.0-ն Writer-ի վարկածներով ստեղծված "
"տեքստային փաստաթղթերում, օգտագործվում է նախորդ գործընթացը:"

#: 01041000.xhp#par_idN1081B.help.text
#: 01041000.xhp%23par_idN1081B.help.text
msgctxt "01041000.xhp#par_idN1081B.help.text"
msgid "Add paragraph and table spacing at bottom of table cells"
msgstr ""
"Աղյուսակի բջիջների ներքևի մասում ավելացրեք պարբերություն և աղյուսակի "
"բացատավորում"

#: 01041000.xhp#par_idN10846.help.text
#: 01041000.xhp%23par_idN10846.help.text
msgid ""
"Specifies that the bottom spacing is added to a paragraph, even when it is "
"the last paragraph in a table cell."
msgstr ""
"Նշում է, որ ներքևի տարածությունը ավելացվում է պարբերությանը, նույնիսկ երբ "
"այն աղյուսակի բջջի վերջին պարբերությունն է:"

#: 01041000.xhp#par_idN10849.help.text
#: 01041000.xhp%23par_idN10849.help.text
msgid ""
"If the option is off, table cells will be formatted as in Writer versions "
"prior to StarOffice 8 or OpenOffice.org 2.0. If the option is on, an "
"alternative method of formatting table cells will be applied. The option is "
"on by default for new documents created with %PRODUCTNAME %PRODUCTVERSION "
"and for documents imported from Microsoft Word format."
msgstr ""
"Եթե տարբերակն անջատված է, աղյուսակի բջիջները կձևաչափվեն ինչպես Writer-ի "
"տարբերակներում, նախքան StarOffice 8-ը կամ OpenOffice.org 2.0-ը: Եթե "
"տարբերակը միացված է, կկիրառվի աղյուսակի բջիջների ձևավորման այլընտրանքային "
"եղանակը: Ընտրանքը լռելյայնորեն միացված է %PRODUCTNAME %PRODUCTVERSION -ով "
"ստեղծված նոր փաստաթղթերի և Microsoft Word ձևաչափից ներմուծված փաստաթղթերի "
"համար:"

#: 01041000.xhp#par_idN1084C.help.text
#: 01041000.xhp%23par_idN1084C.help.text
msgid "Use %WRITERCOMPATIBILITYVERSIONOOO11 object positioning"
msgstr "Օգտագործեք %WRITERCOMPATIBILITYVERSIONOOO11 առարկայի դիրքավորումը"

#: 01041000.xhp#par_idN10864.help.text
#: 01041000.xhp%23par_idN10864.help.text
msgid ""
"Specifies how to calculate the position of floating objects anchored to a "
"character or paragraph with respect to the top and bottom paragraph spacing."
msgstr ""
"Նշում է, թե ինչպես կարելի է հաշվարկել նիշի կամ պարբերության վրա խարսխված "
"լողացող առարկաների դիրքը վերևի և ներքևի պարբերությունների միջակայքի նկատմամբ:"

#: 01041000.xhp#par_idN10867.help.text
#: 01041000.xhp%23par_idN10867.help.text
msgid ""
"If the option is on, the floating objects are positioned as in Writer "
"versions prior to StarOffice 8 or OpenOffice.org 2.0. If the option is off, "
"the floating objects are positioned using an alternative method that is "
"similar to the method used by Microsoft Word. "
msgstr ""
"Եթե տարբերակը միացված է, լողացող առարկաները տեղադրվում են այնպես, ինչպես "
"Writer-ի տարբերակներում, նախքան StarOffice 8-ը կամ OpenOffice.org 2.0-ը: Եթե "
"տարբերակն անջատված է, լողացող առարկաները տեղադրվում են այլընտրանքային "
"մեթոդով, որը նման է Microsoft Word-ի օգտագործած մեթոդին: "

#: 01041000.xhp#par_idN1086A.help.text
#: 01041000.xhp%23par_idN1086A.help.text
msgid ""
"The option will be set to off for new documents. For Writer documents "
"created by a version prior to %PRODUCTNAME %PRODUCTVERSION the option is on."
msgstr ""
"Տարբերակն անջատվելու է նոր փաստաթղթերի համար: Writer-ի փաստաթղթերի համար, "
"որոնք ստեղծվել են մինչ %PRODUCTNAME %PRODUCTVERSION -ը՝ տարբերակը միացված է:"

#: 01041000.xhp#par_idN10821.help.text
#: 01041000.xhp%23par_idN10821.help.text
msgid "Use %WRITERCOMPATIBILITYVERSIONOOO11 text wrapping around objects"
msgstr ""
"Օգտագործեք %WRITERCOMPATIBILITYVERSIONOOO11 առարկաների շուրջ տեքստի փաթաթումը"

#: 01041000.xhp#par_id4016541.help.text
#: 01041000.xhp%23par_id4016541.help.text
msgid ""
"MS Word and Writer have different approaches on wrapping text around "
"floating screen objects. Floating screen object are Writer frames and "
"drawing objects, and the objects 'text box', 'graphic', 'frame', 'picture' "
"etc. in MS Word."
msgstr ""
"MS Word-ը և Writer-ը տարբեր մոտեցումներ ունեն պաստառի լողացող առարկաների "
"շուրջ տեքստը փաթաթելու հարցում: Պաստառի լողացող օբյեկտները Writer-ի "
"շրջանակներն ու նկարչական առարկաներն են, և MS Word-ի «տեքստի տուփ», «գրաֆիկա»"
", «շրջանակ», «նկար» առարկաները:"

#: 01041000.xhp#par_id7280190.help.text
#: 01041000.xhp%23par_id7280190.help.text
msgid ""
"In MS Word and in current versions of Writer, page header/footer content and "
"footnote/endnote content does not wrap around floating screen objects. Text "
"body content wraps around floating screen objects which are anchored in the "
"page header. "
msgstr ""
"MS Word-ում և Writer-ի ներկայիս տարբերակներում էջի գլխագրի/տողատակի "
"բովանդակությունը և տողատակի/ծանոթագրի բովանդակությունը չեն փաթաթվում պաստառի "
"լողացող առարկաների շուրջը: Տեքստի մարմնի պարունակությունը փաթաթվում է "
"պաստառի լողացող առարկաների շուրջը, որոնք խարսխված են էջի գլխագրում:"

#: 01041000.xhp#par_id2782982.help.text
#: 01041000.xhp%23par_id2782982.help.text
msgid ""
"In Writer versions prior to StarOffice 8 or OpenOffice.org 2.0, the opposite "
"was true."
msgstr ""
"Writer-ի տարբերակներում, նախքան StarOffice 8-ը կամ OpenOffice.org 2.0-ը, "
"հակառակն էր ճիշտը։"

#: 01041000.xhp#par_idN10892.help.text
#: 01041000.xhp%23par_idN10892.help.text
msgid ""
"If the option is off, which is the default setting, the new text wrapping "
"will be applied. If the option is on, the former text wrapping will be "
"applied. "
msgstr ""
"Եթե ընտրանքը անջատված է, որը լռելյայն կարգաբերումն է, կկիրառվի տեքստի նոր "
"փաթաթում: Եթե ընտրանքը միացված է, կկիրառվի տեքստի նախկին փաթեթավորումը:"

#: 01041000.xhp#par_idN1092A.help.text
#: 01041000.xhp%23par_idN1092A.help.text
msgid "Consider wrapping style when positioning objects"
msgstr "Հաշվի առեք փաթաթելու ոճը առարկաները դիրքավորելիս"

#: 01041000.xhp#par_idN10837.help.text
#: 01041000.xhp%23par_idN10837.help.text
msgid ""
"Specifies how the complex process of positioning floating objects that are "
"anchored to a character or paragraph should work. In Writer versions prior "
"to StarOffice 8 or OpenOffice.org 2.0, an iterative process was used, while "
"in current versions a straightforward process is used, which is similar to "
"the same process in Microsoft Word."
msgstr ""
"Նշում է, թե ինչպես պետք է աշխատի նիշի կամ պարբերության վրա խարսխված լողացող "
"առարկաների դիրքավորման բարդ գործընթացը: Writer-ի տարբերակներում, նախքան "
"StarOffice 8-ը կամ OpenOffice.org 2.0-ը, օգտագործվել է կրկնվող գործընթաց, "
"մինչդեռ ներկայիս տարբերակներում օգտագործվում է ուղղակի գործընթաց, որը նման է "
"Microsoft Word-ի նույն գործընթացին:"

#: 01041000.xhp#par_idN10943.help.text
#: 01041000.xhp%23par_idN10943.help.text
msgid ""
"If the option is off, the old %PRODUCTNAME iterative process of object "
"positioning is used. If the option is on, the new straightforward process is "
"used to ensure compatibility with Microsoft Word documents."
msgstr ""
"Եթե տարբերակն անջատված է, օգտագործվում է առարկայի դիրքի հին %PRODUCTNAME "
"կրկնվող գործընթացը: Եթե տարբերակը միացված է, ապա նոր պարզ գործընթացն "
"օգտագործվում է Microsoft Word փաստաթղթերի հետ համատեղելիությունն ապահովելու "
"համար:"

#: 01041000.xhp#hd_id5240028.help.text
#: 01041000.xhp%23hd_id5240028.help.text
msgctxt "01041000.xhp#hd_id5240028.help.text"
msgid ""
"Expand word space on lines with manual line breaks in justified paragraphs"
msgstr ""
"Ընդարձակեք հավասարեցված պարբերություններում բառերի բացատները ձեռքով տողերի "
"կոտրվածքներով ունեցող տողերում"

#: 01041000.xhp#par_id8599810.help.text
#: 01041000.xhp%23par_id8599810.help.text
msgid ""
"If enabled, Writer adds spacing between words, in lines that end with Shift+"
"Enter in justified paragraphs. If disabled, spacing between words will not "
"be expanded to justify the lines."
msgstr ""
"Միացված լինելու դեպքում Writer-ը բառերի միջև հեռավորություն է ավելացնում այն "
"տողերում, որոնք ավարտվում են Shift+Enter -ով` Հավասարեցված "
"պարբերություններում: Անջատելու դեպքում բառերի միջև տարածությունը չի "
"ընդլայնվի՝ տողերը հավասարեցնելու համար:"

#: 01041000.xhp#par_id8012634.help.text
#: 01041000.xhp%23par_id8012634.help.text
msgid ""
"This setting is on by default for .odt text documents. It will be saved and "
"loaded with the document in the .odt text document format. This setting "
"cannot be saved in old .sxw text documents, so this setting is off for .sxw "
"text documents."
msgstr ""
"Այս կարգաբերումը լռելյայն միացված է .odt տեքստային փաստաթղթերի համար: Այն "
"կհիշվի և կբեռնվի որպես փաստաթուղթ .odt տեքստային փաստաթղթի ձևաչափով: Այս "
"կարգավորումը հնարավոր չէ պահել հին .sxw տեքստային փաստաթղթերում, այնպես որ "
"այս պարամետրն անջատված է .sxw տեքստային փաստաթղթերի համար:"

#: 01041000.xhp#par_idN10845.help.text
#: 01041000.xhp%23par_idN10845.help.text
msgid "Use as Default"
msgstr "Օգտագործեք որպես Լռելյայն"

#: 01041000.xhp#par_idN10848.help.text
#: 01041000.xhp%23par_idN10848.help.text
msgid ""
"<ahelp hid=\"879350288\">Click to use the current settings on this tab page "
"as the default for further sessions with %PRODUCTNAME.</ahelp>"
msgstr ""
"<ahelp hid=\"879350288\">Կտտացրեք՝ այս ներդիրի էջի ընթացիկ կարգավորումներն "
"օգտագործելու համար որպես կանխադրված %PRODUCTNAME -ի հետագա սեսիաների "
"համար:</ahelp>"

#: 01041000.xhp#par_idN10977.help.text
#: 01041000.xhp%23par_idN10977.help.text
msgid ""
"The factory defaults are set as follows. Enabled are the following options, "
"while all other options are disabled:"
msgstr ""
"Գործարանային լեռելյայնները սահմանվում են հետևյալ կերպ. Միացված են հետևյալ "
"ընտրանքները, մինչդեռ մնացած բոլոր տարբերակներն անջատված են."

#: 01041000.xhp#par_idN1097D.help.text
#: 01041000.xhp%23par_idN1097D.help.text
msgctxt "01041000.xhp#par_idN1097D.help.text"
msgid "Add spacing between paragraphs and tables (in current document)"
msgstr ""
"Պարբերությունների և աղյուսակների միջև հեռավորություն ավելացրեք (ընթացիկ "
"փաստաթղթում)"

#: 01041000.xhp#par_idN10981.help.text
#: 01041000.xhp%23par_idN10981.help.text
msgctxt "01041000.xhp#par_idN10981.help.text"
msgid "Add paragraph and table spacing at tops of pages (in current document)"
msgstr ""
"Էջերի վերևում ավելացնել պարբերությունների և աղյուսակների միջակայքները ("
"ընթացիկ փաստաթղթում)"

#: 01041000.xhp#par_idN10985.help.text
#: 01041000.xhp%23par_idN10985.help.text
msgctxt "01041000.xhp#par_idN10985.help.text"
msgid "Add paragraph and table spacing at bottom of table cells"
msgstr ""
"Աղյուսակի բջիջների ներքևում ավելացնել պարբերության և աղյուսակի միջակայքը"

#: 01041000.xhp#par_id4653767.help.text
#: 01041000.xhp%23par_id4653767.help.text
msgctxt "01041000.xhp#par_id4653767.help.text"
msgid ""
