#: 01060100.xhp#hd_id3150445.1.help.text
#: 01060100.xhp%23hd_id3150445.1.help.text
msgid ""
"<link href=\"text/shared/optionen/01060100.xhp\" name=\"View\">View</link>"
msgstr ""
"<link href=\"text/shared/optionen/01060100.xhp\" name=\"Տեսք\">Տեսք</link>"

#: 01060100.xhp#par_id3153988.2.help.text
#: 01060100.xhp%23par_id3153988.2.help.text
msgid ""
"<ahelp hid=\"HID_SCPAGE_CONTENT\">Defines which elements of the <item type=\""
"productname\">%PRODUCTNAME</item> Calc main window are displayed. You can "
"also show or hide highlighting of values in tables.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_SCPAGE_CONTENT\">Սահմանում է, թե <item type=\"productname\""
">%PRODUCTNAME</item> Calc -ի հիմնական պատուհանի որ տարրերն են արտածվում։ "
"Աղյուսակներում կարող եք նաև ցույց տալ կամ թաքցնել արժեքների "
"ընդգծումը:</ahelp>"

#: 01060100.xhp#hd_id3153682.28.help.text
#: 01060100.xhp%23hd_id3153682.28.help.text
msgid "Visual aids"
msgstr "Տեսողական օգնություն"

#: 01060100.xhp#par_id3153311.29.help.text
#: 01060100.xhp%23par_id3153311.29.help.text
msgid "Specifies which lines are displayed."
msgstr "Նշում է, թե որ տողերն են ցուցադրվում:"

#: 01060100.xhp#hd_id3147242.30.help.text
#: 01060100.xhp%23hd_id3147242.30.help.text
msgid "Grid lines"
msgstr "Ցանցի գծեր"

#: 01060100.xhp#par_id3153088.31.help.text
#: 01060100.xhp%23par_id3153088.31.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_GRID\">Specifies whether to "
"display grid lines between the cells.</ahelp><switchinline select=\"appl\"><"
"caseinline select=\"CALC\">For printing, choose <emph>Format - Page - "
"</emph><link href=\"text/scalc/01/05070500.xhp\" name=\"Sheet\""
"><emph>Sheet</emph></link> and mark the <emph>Grid</emph> check "
"box.</caseinline></switchinline>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_GRID\">Նշում է, թե արդյոք "
"բջիջների միջև ցանցային գծերը կցուցադրվեն:</ahelp><switchinline select=\""
"appl\"><caseinline select=\"CALC\">Տպելու համար, ընտրեք <emph>Ձևաչափ - Էջ - "
"</emph><link href=\"text/scalc/01/05070500.xhp\" name=\"Թերթիկ\""
"><emph>Թերթիկ</emph></link> և նշեք <emph>Ցանց</emph> "
"ընտրավանդակը։</caseinline></switchinline>"

#: 01060100.xhp#hd_id3156326.32.help.text
#: 01060100.xhp%23hd_id3156326.32.help.text
msgctxt "01060100.xhp#hd_id3156326.32.help.text"
msgid "Color"
msgstr "Գույն"

#: 01060100.xhp#par_id3154286.33.help.text
#: 01060100.xhp%23par_id3154286.33.help.text
msgid ""
"<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_CONTENT_LB_COLOR\">Specifies a color for "
"the grid lines in the current document.</ahelp> To see the grid line color "
"that was saved with the document, go to <emph><switchinline select=\"sys\"><"
"caseinline select=\"MAC\">%PRODUCTNAME - "
"Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - %PRODUCTNAME - Appearance</emph>, "
"under <emph>Scheme</emph> find the entry <emph>Spreadsheet - Grid "
"lines</emph> and set the color to \"Automatic\"."
msgstr ""
"<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_CONTENT_LB_COLOR\">Ընթացիկ փաստաթղթում "
"ցանցի գծերի գույնն է սահմանում:</ahelp> Փաստաթղթի հետ պահված ցանցի գծի "
"գույնը տեսնելու համար, գնա <emph><switchinline select=\"sys\"><caseinline "
"select=\"MAC\">%PRODUCTNAME - Նախապատվություններ</caseinline><defaultinline>"
"Գործիքներ - Ընտրանքներ</defaultinline></switchinline> - %PRODUCTNAME - "
"Արտաքին տեսք</emph>, ապա <emph>Սխեմայի</emph> ներքո գտիր <emph>Փռված թերթիկ -"
" Ցանցի գծեր</emph> մուտքը, և դիր գույնը որպես \"Ինքնաշխատ\"։"

#: 01060100.xhp#hd_id3152349.34.help.text
#: 01060100.xhp%23hd_id3152349.34.help.text
msgid "Page breaks"
msgstr "Էջի ընդմջումներ"

#: 01060100.xhp#par_id3151245.35.help.text
#: 01060100.xhp%23par_id3151245.35.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_PAGEBREAKS\">Specifies "
"whether to view the page breaks within a defined print area.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_PAGEBREAKS\">Նշում է, թե "
"արդյոք պետք է դիտել էջի ընդմիջումները տպելու սահմանված տարածքում:</ahelp>"

#: 01060100.xhp#hd_id3149669.36.help.text
#: 01060100.xhp%23hd_id3149669.36.help.text
msgctxt "01060100.xhp#hd_id3149669.36.help.text"
msgid "Guides while moving"
msgstr "Ուղեկցում է շարժվելիս"

#: 01060100.xhp#par_id3148550.37.help.text
#: 01060100.xhp%23par_id3148550.37.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_GUIDELINE\">Specifies whether "
"to view guides when moving drawings, frames, graphics and other "
"objects.</ahelp> These guides help you align objects."
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_GUIDELINE\">Նշում է՝ դիտել "
"ուղեցույցները երբ տեղափոխում եք գծանկարները, շրջանակները, գրաֆիկան և այլ "
"առարկաները:</ahelp> Այս ուղեցույցները օգնում են ձեզ առարկաները դասավորելիս:"

#: 01060100.xhp#hd_id3150358.38.help.text
#: 01060100.xhp%23hd_id3150358.38.help.text
msgctxt "01060100.xhp#hd_id3150358.38.help.text"
msgid "Simple handles"
msgstr "Պարզ բռնակներ"

#: 01060100.xhp#par_id3154140.39.help.text
#: 01060100.xhp%23par_id3154140.39.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_HANDLES\">Specifies whether "
"to display the handles (the eight points on a selection box) as simple "
"squares without 3D effect.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_HANDLES\">Նշում է, թե արդյոք "
"բռնակները (ընտրության տուփի ութ կետերը) կցուցադրվեն որպես պարզ քառակուսիներ, "
"առանց 3D էֆեկտի:</ahelp>"

#: 01060100.xhp#hd_id3149202.40.help.text
#: 01060100.xhp%23hd_id3149202.40.help.text
msgctxt "01060100.xhp#hd_id3149202.40.help.text"
msgid "Large handles"
msgstr "Խոշոր բռնակներ"

#: 01060100.xhp#par_id3154123.41.help.text
#: 01060100.xhp%23par_id3154123.41.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_BIGHANDLES\">Specifies that "
"larger than normal handles (the eight points on a selection box) are "
"displayed.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_BIGHANDLES\">Նշում է, որ "
"ցուցադրվում են նորմլաից ավելի մեծ բռնակներ (ընտրության տուփի ութ "
"կետերը):</ahelp>"

#: 01060100.xhp#hd_id3152920.3.help.text
#: 01060100.xhp%23hd_id3152920.3.help.text
msgctxt "01060100.xhp#hd_id3152920.3.help.text"
msgid "Display"
msgstr "Արտածում"

#: 01060100.xhp#par_id3125864.4.help.text
#: 01060100.xhp%23par_id3125864.4.help.text
msgid "Select various options for the screen display."
msgstr "Պաստառի ցուցադրման համար ընտրեք տարբեր ընտրանքներ:"

#: 01060100.xhp#hd_id3154218.5.help.text
#: 01060100.xhp%23hd_id3154218.5.help.text
msgid "Formulas"
msgstr "Բանաձևեր"

#: 01060100.xhp#par_id3150440.6.help.text
#: 01060100.xhp%23par_id3150440.6.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_FORMULA\">Specifies whether "
"to show formulas instead of results in the cells.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_FORMULA\">Նշում է՝ արդյոք "
"բջիջներում արդյունքների փոխարեն բանաձևեր ցույց տալ:</ahelp>"

#: 01060100.xhp#hd_id3155132.7.help.text
#: 01060100.xhp%23hd_id3155132.7.help.text
msgid "Zero values"
msgstr "Զրո արժեքներ"

#: 01060100.xhp#par_id3147318.8.help.text
#: 01060100.xhp%23par_id3147318.8.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_NIL\">Specifies whether to "
"show numbers with the value of 0.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_NIL\">Նշում է՝ արդյոք ցույց "
"տալ 0 արժեքով թվերը:</ahelp>"

#: 01060100.xhp#hd_id3147348.9.help.text
#: 01060100.xhp%23hd_id3147348.9.help.text
msgid "Comment indicator"
msgstr "Մեկնաբանության ցուցիչ"

#: 01060100.xhp#par_id3146974.10.help.text
#: 01060100.xhp%23par_id3146974.10.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_ANNOT\">Specifies that a "
"small rectangle in the top right corner of the cell indicates that a comment "
"exists. The comment will be shown only when you enable tips under <emph>%"
"PRODUCTNAME - General</emph> in the Options dialog box.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_ANNOT\">Նշում է, որ վանդակի "
"վերևի աջ անկյունում գտնվող փոքրիկ ուղղանկյունը ցույց է տալիս, որ "
"մեկնաբանությունն առկա է: Մեկնաբանությունը կցուցադրվի միայն այն ժամանակ, երբ "
"կթույլատրեք խորհուրդները <emph>%PRODUCTNAME - Ընդհանուր</emph> ներքո, "
"Ընտրանքներ երկխոսության վանդակում։</ahelp>"

#: 01060100.xhp#par_id3150487.24.help.text
#: 01060100.xhp%23par_id3150487.24.help.text
msgid ""
"<ahelp hid=\".uno:NoteVisible\">To display a comment permanently, select the "
"<emph>Show comment</emph> command from the cell's context menu.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:NoteVisible\">Մեկնաբանությունը մշտապես ցուցադրելու համար "
"ընտրեք <emph>Ցուցադրել մեկնաբանությունը</emph> հրամանը բջիջի համատեքստային "
"ընտրացանկից:</ahelp>"

#: 01060100.xhp#par_id3149667.25.help.text
#: 01060100.xhp%23par_id3149667.25.help.text
msgid ""
"You can type and edit comments with the <link href=\"text/shared/01/04050000."
"xhp\" name=\"Insert - Comment\"><emph>Insert - Comment</emph></link> "
"command. Comments that are permanently displayed can be edited by clicking "
"the comment box. Click the Navigator and under the <emph>Comments</emph> "
"entry you can view all comments in the current document. By double clicking "
"a comment in Navigator, the cursor will jump to the corresponding cell "
"containing the comment."
msgstr ""
"Կարող եք մեկնաբանությունները մուտքագրել և խմբագրել <link href=\""
"text/shared/01/04050000.xhp\" name=\"Տեղադրել - Մեկնաբանություն\"><emph>"
"Տեղադրել - Մեկնաբանություն</emph></link> հրամանի միջոցով։ Մշտապես ցուցադրվող "
"մեկնաբանությունները կարող են խմբագրվել՝ սեղմելով մեկնաբանությունների վանդակը:"
" Կտտացրեք Նավարկիչը և <emph>Մեկնաբանություններ</emph> գրառման ներքո կարող եք "
"դիտել ընթացիկ փաստաթղթի բոլոր մեկնաբանությունները: Նավարկիչում կրկնակի "
"կտտացնելով մեկնաբանությունը, կուրսորը կթռչի մեկնաբանություն պարունակող "
"համապատասխան բջիջ:"

#: 01060100.xhp#hd_id3150872.11.help.text
#: 01060100.xhp%23hd_id3150872.11.help.text
msgid "Value highlighting"
msgstr "Արժեքի լուսաբանում"

#: 01060100.xhp#par_id3154792.12.help.text
#: 01060100.xhp%23par_id3154792.12.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_VALUE\">Mark the <emph>Value "
"highlighting</emph> box to show the cell contents in different colors, "
"depending on type. Text cells are formatted in black, formulas in green, and "
"number cells in blue, no matter how their display is formatted.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_VALUE\">Նշեք <emph>Արժեքի "
"լուսաբանում</emph> վանդակը՝ բջջի պարունակությունը տարբեր գույներով ցույց "
"տալու համար, կախված տեսակից: Տեքստային բջիջները ձևաչափվում են սև, բանաձևերը՝ "
"կանաչ, իսկ թվային բջիջները՝ կապույտ, անկախ նրանից, թե ինչպես է ձևաչափվում "
"դրանց ցուցադրումը:</ahelp>"

#: 01060100.xhp#par_id3151319.13.help.text
#: 01060100.xhp%23par_id3151319.13.help.text
msgid ""
"When this command is active, any colors assigned in the document will not be "
"displayed until the function is deactivated."
msgstr ""
"Երբ այս հրամանն ակտիվ է, փաստաթղթում նշանակված ցանկացած գույն չի ցուցադրվի, "
"մինչև գործառույթը չջնջվի:"

#: 01060100.xhp#hd_id3157846.14.help.text
#: 01060100.xhp%23hd_id3157846.14.help.text
msgid "Anchor"
msgstr "Խարիսխ"

#: 01060100.xhp#par_id3147494.15.help.text
#: 01060100.xhp%23par_id3147494.15.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_ANCHOR\">Specifies whether "
"the anchor icon is displayed when an inserted object, such as a graphic, is "
"selected.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_ANCHOR\">Նշում է, թե արդյոք "
"խարսխի պատկերակը ցուցադրվում է, երբ տեղադրված առարկան, օրինակ՝ գրաֆիկական, "
"ընտրված է:</ahelp>"

#: 01060100.xhp#hd_id3146898.26.help.text
#: 01060100.xhp%23hd_id3146898.26.help.text
msgid "Text overflow"
msgstr "Տեքստի գերլցնում"

#: 01060100.xhp#par_id3153707.27.help.text
#: 01060100.xhp%23par_id3153707.27.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_CLIP\">If a cell contains "
"text that is wider than the width of the cell, the text is displayed over "
"empty neighboring cells in the same row. If there is no empty neighboring "
"cell, a small triangle at the cell border indicates that the text "
"continues.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_CLIP\">Եթե բջիջը պարունակում "
"է տեքստ, որն ավելի լայն է, քան բջջի լայնությունն է, տեքստը ցուցադրվում է "
"նույն տողում գտնվող հարևան դատարկ բջիջների վերևում: Եթե չկա հարևան դատարկ "
"բջիջ, բջջի սահմանին գտնվող փոքր եռանկյունը ցույց է տալիս, որ տեքստը "
"շարունակվում է:</ahelp>"

#: 01060100.xhp#hd_id3150327.54.help.text
#: 01060100.xhp%23hd_id3150327.54.help.text
msgid "Show references in color"
msgstr "Ցուցադրել հղումները գույներով"

#: 01060100.xhp#par_id3153766.55.help.text
#: 01060100.xhp%23par_id3153766.55.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_RFIND\">Specifies that each "
"reference is highlighted in color in the formula. The cell range is also "
"enclosed by a colored border as soon as the cell containing the reference is "
"selected for editing.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_RFIND\">Նշում է, որ բանաձևում "
"յուրաքանչյուր հղում ընդգծվում է գույնով: Բջիջների շարքը ևս ներառվում է "
"գունավոր եզրագծով, հենց որ հղումը պարունակող բջիջը ընտրվի խմբագրման "
"համար:</ahelp>"

#: 01060100.xhp#hd_id3155444.16.help.text
#: 01060100.xhp%23hd_id3155444.16.help.text
msgid "Objects"
msgstr "Առարկաներ"

#: 01060100.xhp#par_id3148405.17.help.text
#: 01060100.xhp%23par_id3148405.17.help.text
msgid ""
"Defines whether to display or hide objects for up to three object groups."
msgstr ""
"Սահմանում է առարկաների մինչև երեք խմբերի համար արդյոք ցուցադրել կամ թաքցնել "
"առարկաները:"

#: 01060100.xhp#hd_id3150043.18.help.text
#: 01060100.xhp%23hd_id3150043.18.help.text
msgid "Objects/Graphics"
msgstr "Առարկաներ/Գրաֆիկա"

#: 01060100.xhp#par_id3163549.19.help.text
#: 01060100.xhp%23par_id3163549.19.help.text
msgid ""
"<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_CONTENT_LB_OBJGRF\">Defines if objects "
"and graphics are shown or hidden.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_CONTENT_LB_OBJGRF\">Սահմանում է "
"առարկաների և գրաֆիկայի ցուցադրումը կամ թաքցումը:</ahelp>"

#: 01060100.xhp#hd_id3151249.20.help.text
#: 01060100.xhp%23hd_id3151249.20.help.text
msgctxt "01060100.xhp#hd_id3151249.20.help.text"
msgid "Charts"
msgstr "Գծապատկերներ"

#: 01060100.xhp#par_id3149106.21.help.text
#: 01060100.xhp%23par_id3149106.21.help.text
msgid ""
"<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_CONTENT_LB_DIAGRAM\">Defines if charts in "
"your document are shown or hidden.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_CONTENT_LB_DIAGRAM\">Սահմանում է, արդյոք "
"ձեր փաստաթղթում գծապատկերները ցուցադրվում են կամ թաքնված են:</ahelp>"

#: 01060100.xhp#hd_id3154703.22.help.text
#: 01060100.xhp%23hd_id3154703.22.help.text
msgid "Drawing objects"
msgstr "Նկարչական առարկաներ"

#: 01060100.xhp#par_id3155959.23.help.text
#: 01060100.xhp%23par_id3155959.23.help.text
msgid ""
"<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_CONTENT_LB_DRAW\">Defines if drawing "
"objects in your document are shown or hidden.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_LISTBOX_RID_SCPAGE_CONTENT_LB_DRAW\">Սահմանում է արդյոք ձեր "
"փաստաթղթում նկարչական առարկաները ցուցադրվում են կամ թաքնված են:</ahelp>"

#: 01060100.xhp#hd_id0909200810585828.help.text
#: 01060100.xhp%23hd_id0909200810585828.help.text
msgid "Zoom"
msgstr "Մեծացնել"

#: 01060100.xhp#hd_id0909200810585881.help.text
#: 01060100.xhp%23hd_id0909200810585881.help.text
msgid "Synchronize sheets"
msgstr "Համաժամանակեցրեք թերթիկները"

#: 01060100.xhp#par_id0909200810585870.help.text
#: 01060100.xhp%23par_id0909200810585870.help.text
msgid ""
"<ahelp hid=\".\">If checked, all sheets are shown with the same zoom factor. "
"If not checked, each sheet can have its own zoom factor.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Եթե նշված է, բոլոր թերթերը ցուցադրվում են խոշորացման նույն "
"գործոնով: Եթե չի նշված, յուրաքանչյուր թերթ կարող է ունենալ խոշորացման իր "
"գործոնը:</ahelp>"

#: 01060100.xhp#hd_id3153920.42.help.text
#: 01060100.xhp%23hd_id3153920.42.help.text
msgid "Window"
msgstr "Պատուհան"

#: 01060100.xhp#par_id3154661.43.help.text
#: 01060100.xhp%23par_id3154661.43.help.text
msgid ""
"Specifies whether some Help elements will or will not appear in the table."
msgstr "Նշում է արդյոք Օգնության որոշ տարրեր աղյուսակում կհայտնվեն թե ոչ:"

#: 01060100.xhp#hd_id3149923.44.help.text
#: 01060100.xhp%23hd_id3149923.44.help.text
msgid "Column/Row headers"
msgstr "Սյունակի/տողի գլխագրեր"

#: 01060100.xhp#par_id3149816.45.help.text
#: 01060100.xhp%23par_id3149816.45.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_ROWCOLHEADER\">Specifies "
"whether to display row and column headers.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_ROWCOLHEADER\">Նշում է, թե "
"արդյոք կցուցադրվի տողի և սյունակի գլխագիրը:</ahelp>"

#: 01060100.xhp#hd_id3154205.46.help.text
#: 01060100.xhp%23hd_id3154205.46.help.text
msgctxt "01060100.xhp#hd_id3154205.46.help.text"
msgid "Horizontal scrollbar"
msgstr "Հորիզոնական Ոլորվող Վահանակ"

#: 01060100.xhp#par_id3155578.47.help.text
#: 01060100.xhp%23par_id3155578.47.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_HSCROLL\">Specifies whether "
"to display a horizontal scrollbar at the bottom of the document "
"window.</ahelp> Note that there is a slider between the horizontal scrollbar "
"and the sheet tabs that may be set to one end."
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_HSCROLL\">Նշում է, թե արդյոք "
"փաստաթղթի պատուհանի ներքևում կցուցադրվի հորիզոնական ոլորման գոտին:</ahelp> "
"Նկատի ունեցեք, որ հորիզոնական ոլորման տողի և թերթիկի ներդիրների միջև կա "
"սահող, որը կարող է դրվել մի ծայրին:"

#: 01060100.xhp#hd_id3148422.48.help.text
#: 01060100.xhp%23hd_id3148422.48.help.text
msgctxt "01060100.xhp#hd_id3148422.48.help.text"
msgid "Vertical scrollbar"
msgstr "Ուղղահայաց Ոլորվող Վահանակ"

#: 01060100.xhp#par_id3147128.49.help.text
#: 01060100.xhp%23par_id3147128.49.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_VSCROLL\">Specifies whether "
"to display a vertical scrollbar at the right of the document window.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_VSCROLL\">Նշում է թե արդյոք "
"կցուցադրվի փաստաթղթի պատուհանի աջ կողմի ուղղահայաց ոլորման գոտին:</ahelp>"

#: 01060100.xhp#hd_id3150826.50.help.text
#: 01060100.xhp%23hd_id3150826.50.help.text
msgid "Sheet tabs"
msgstr "Թերթիկի ներդիրներ"

#: 01060100.xhp#par_id3154658.51.help.text
#: 01060100.xhp%23par_id3154658.51.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_TBLREG\">Specifies whether to "
"display the sheet tabs at the bottom of the spreadsheet document.</ahelp> If "
"this box is not checked, you will only be able to switch between the sheets "
"through the <switchinline select=\"appl\"><caseinline select=\"CALC\"><link "
"href=\"text/scalc/01/02110000.xhp\" name=\"Navigator\">Navigator</link></case"
"inline><defaultinline>Navigator</defaultinline></switchinline>. Note that "
"there is a slider between the horizontal scrollbar and the sheet tabs that "
"may be set to one end."
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_TBLREG\">Նշում է, թե արդյոք "
"աղյուսակի փաստաթղթի ներքևում կցուցադրվեն թերթի ներդիրները:</ahelp> Եթե այս "
"վանդակը նշված չէ, դուք կկարողանաք միայն անցումներ կատարել թերթիկների միջև <"
"switchinline select=\"appl\"><caseinline select=\"CALC\"><link href=\""
"text/scalc/01/02110000.xhp\" name=\"Նավարկիչ\">Նավարկիչ</link></caseinline><d"
"efaultinline>Նավարկիչ</defaultinline></switchinline> օգնությամբ։ Նկատի "
"ունեցեք, որ հորիզոնական ոլորման տողի և թերթիկի ներդիրների միջև կա սահող, որը "
"կարող է դրվել մի ծայրին:"

#: 01060100.xhp#hd_id3152584.52.help.text
#: 01060100.xhp%23hd_id3152584.52.help.text
msgid "Outline symbols"
msgstr "Ուրվագծել նիշերը"

#: 01060100.xhp#par_id3145135.53.help.text
#: 01060100.xhp%23par_id3145135.53.help.text
msgid ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_OUTLINE\">If you have defined "
"an <switchinline select=\"appl\"><caseinline select=\"CALC\"><link href=\""
"text/scalc/01/12080000.xhp\" name=\"outline\">outline</link></caseinline><def"
"aultinline>outline</defaultinline></switchinline>, the <emph>Outline "
"symbols</emph> option specifies whether to view the outline symbols at the "
"border of the sheet.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_CHECKBOX_RID_SCPAGE_CONTENT_CB_OUTLINE\">Եթե սահմանել եք <"
"switchinline select=\"appl\"><caseinline select=\"CALC\"><link href=\""
"text/scalc/01/12080000.xhp\" name=\"ուրվագիծ\">ուրվագիծ</link></caseinline><d"
"efaultinline>ուրվագիծ</defaultinline></switchinline>, <emph>Ուրվագծել "
"նիշերը</emph> տարբերակը սահմանում է, թե արդյոք պետք է դիտել ուրվագծի նիշերը "
"թերթիկի եզրին:</ahelp>"

