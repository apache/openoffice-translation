"<link href=\"text/shared/optionen/online_update.xhp\">Առցանց թարմացում</link>"

#: online_update.xhp#par_id8754844.help.text
#: online_update.xhp%23par_id8754844.help.text
msgid ""
"Specifies some options for the automatic notification and downloading of "
"online updates to %PRODUCTNAME."
msgstr ""
"Նշում է %PRODUCTNAME -ի առցանց թարմացումները ինքնաշխատ ծանուցելու և "
"ներբեռնելու որոշ տարբերակներ:"

#: online_update.xhp#hd_id2189397.help.text
#: online_update.xhp%23hd_id2189397.help.text
msgid "Check for updates automatically"
msgstr "Ստուգեք թարմացումներն ինքնաշխատ կերպով"

#: online_update.xhp#par_id7523728.help.text
#: online_update.xhp%23par_id7523728.help.text
msgid ""
"<ahelp hid=\".\">Mark to check for online updates periodically, then select "
"the time interval how often %PRODUCTNAME will check for online "
"updates.</ahelp> %PRODUCTNAME will check once a day, week, or month, as soon "
"as a working Internet connection is detected. If you connect to the Internet "
"by a proxy server, set the proxy on <item type=\"menuitem\"><switchinline "
"select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - Internet - Proxy</item>."
msgstr ""
"<ahelp hid=\".\">Նշեք՝ պարբերաբար ստուգելու առցանց թարմացումները, ապա ընտրեք "
"ժամանակի միջակայքը, թե որքան հաճախ %PRODUCTNAME -ը կստուգի առցանց "
"թարմացումները:</ahelp> %PRODUCTNAME -ը կստուգի օրը, շաբաթը կամ ամիսը մեկ "
"անգամ՝ աշխատանքային ինտերնետ կապը հայտնաբերելուն պես: Եթե միջնորդ կայանի "
"միջոցով միանում եք ինտերնետին, կարգաբերեք միջնորդը <item type=\"menuitem\"><"
"switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Նախապատվություններ</caseinline><defaultinline>Գործիքներ - "
"Ընտրանքներ</defaultinline></switchinline> - Ինտերնետ - Միջնորդ</item>։"

#: online_update.xhp#par_id8994109.help.text
#: online_update.xhp%23par_id8994109.help.text
msgid ""
"When an update is available, an icon in the menu bar displays some "
"explaining text. Click the icon to proceed."
msgstr ""
"Երբ թարմացումը հասանելի է, ընտրացանկի տողում պատկերակը ցուցադրում է բացատրող "
"տեքստ: Շարունակելու համար կտտացրեք պատկերակի վրա:"

#: online_update.xhp#par_id476699.help.text
#: online_update.xhp%23par_id476699.help.text
msgid "If you disable the check, the icon is removed from the menu bar."
msgstr "Եթե անջատեք ստուգումը, պատկերակը հեռացվում է ընտրացանկի տողից:"

#: online_update.xhp#par_id4057130.help.text
#: online_update.xhp%23par_id4057130.help.text
msgid ""
"Online Update is a module that can be selected or deselected to be "
"installed. Choose the customized installation in the Setup of %PRODUCTNAME."
msgstr ""
"Առցանց թարմացումը մի մոդուլ է, որը կարող է ընտրվել կամ ապաընտրվել, որպեսզի "
"տեղադրվի: Ընտրեք անհատական տեղադրումը %PRODUCTNAME -ի Կարգավորումներում:"

#: online_update.xhp#hd_id266426.help.text
#: online_update.xhp%23hd_id266426.help.text
msgid "Every Day"
msgstr "Ամեն օր"

#: online_update.xhp#par_id3031098.help.text
#: online_update.xhp%23par_id3031098.help.text
msgid "<ahelp hid=\".\">A check will be performed once a day.</ahelp>"
msgstr "<ahelp hid=\".\">Ստուգումը կկատարվի օրական մեկ անգամ:</ahelp>"

#: online_update.xhp#hd_id8276619.help.text
#: online_update.xhp%23hd_id8276619.help.text
msgid "Every Week"
msgstr "Ամեն շաբաթ"

#: online_update.xhp#par_id7824030.help.text
#: online_update.xhp%23par_id7824030.help.text
msgid ""
"<ahelp hid=\".\">A check will be performed once a week. This is the default "
"setting.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ստուգումը կկատարվի շաբաթը մեկ անգամ: Սա լռելյայն պարամետր "
"է:</ahelp>"

#: online_update.xhp#hd_id7534104.help.text
#: online_update.xhp%23hd_id7534104.help.text
msgid "Every Month"
msgstr "Ամեն ամիս"

#: online_update.xhp#par_id209051.help.text
#: online_update.xhp%23par_id209051.help.text
msgid "<ahelp hid=\".\">A check will be performed once a month.</ahelp>"
msgstr "<ahelp hid=\".\">Ստուգումը կկատարվի ամիսը մեկ անգամ:</ahelp>"

#: online_update.xhp#hd_id1418805.help.text
#: online_update.xhp%23hd_id1418805.help.text
msgid "Check now"
msgstr "Ստուգեք հիմա"

#: online_update.xhp#par_id1743522.help.text
#: online_update.xhp%23par_id1743522.help.text
msgid "<ahelp hid=\".\">A check will be performed now.</ahelp>"
msgstr "<ahelp hid=\".\">Ստուգումը կկատարվի հիմա։</ahelp>"

#: online_update.xhp#hd_id5994140.help.text
#: online_update.xhp%23hd_id5994140.help.text
msgid "Download updates automatically"
msgstr "Ներբեռնեք թարմացումները ինքնաշխատ կերպով"

#: online_update.xhp#par_id7870113.help.text
#: online_update.xhp%23par_id7870113.help.text
msgid ""
"<ahelp hid=\".\">Select to download an available online update file "
"automatically to the specified folder.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք՝ մատչելի առցանց թարմացման նիշքն ինքնաշխատ կերպով "
"ներբեռնելու համար նշված պանակում:</ahelp>"

#: online_update.xhp#hd_id3051545.help.text
#: online_update.xhp%23hd_id3051545.help.text
msgid "Download destination"
msgstr "Ներբեռնման նպատակակետը"

#: online_update.xhp#par_id3061311.help.text
#: online_update.xhp%23par_id3061311.help.text
msgid ""
"<ahelp hid=\".\">Displays the selected folder to store the downloaded "
"files.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ներբեռնված նիշքերը պահելու համար ցուցադրում է ընտրված "
"պանակը:</ahelp>"

#: online_update.xhp#hd_id4814905.help.text
#: online_update.xhp%23hd_id4814905.help.text
msgid "Change"
msgstr "Փոփոխություն"

#: online_update.xhp#par_id2143925.help.text
#: online_update.xhp%23par_id2143925.help.text
msgid ""
"<ahelp hid=\".\">Click to show a dialog box where you can select another "
"folder.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Կտտացրեք՝ երկխոսության վանդակը ցույց տալու համար, որտեղ "
"կարող եք ընտրել մեկ այլ պանակ:</ahelp>"

#: 01030300.xhp#tit.help.text
#: 01030300.xhp%23tit.help.text
msgid "Security"
msgstr "Անվտանգություն"

#: 01030300.xhp#bm_id2322153.help.text
#: 01030300.xhp%23bm_id2322153.help.text
msgid ""
"<bookmark_value>macros;selecting security "
"warnings</bookmark_value><bookmark_value>security;options for documents with "
"macros</bookmark_value><bookmark_value>macros;security</bookmark_value>"
msgstr ""
"<bookmark_value>macros;selecting security "
"warnings</bookmark_value><bookmark_value>security;options for documents with "
"macros</bookmark_value><bookmark_value>macros;security</bookmark_value>"

#: 01030300.xhp#hd_id3147588.1.help.text
#: 01030300.xhp%23hd_id3147588.1.help.text
msgid ""
"<link href=\"text/shared/optionen/01030300.xhp\" name=\"Security\""
">Security</link>"
msgstr ""
"<link href=\"text/shared/optionen/01030300.xhp\" name=\"Անվտանգություն\""
">Անվտանգություն</link>"

#: 01030300.xhp#par_id3153255.2.help.text
#: 01030300.xhp%23par_id3153255.2.help.text
msgid ""
"<ahelp hid=\".\">Defines the security options for saving documents, for web "
"connections, and for opening documents that contain macros.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Սահմանում է փաստաթղթերը պահելու, վեբ միացումների և մակրոներ "
"պարունակող փաստաթղթերը բացելու անվտանգության տարբերակները:</ahelp>"

#: 01030300.xhp#par_idN10640.help.text
#: 01030300.xhp%23par_idN10640.help.text
msgctxt "01030300.xhp#par_idN10640.help.text"
msgid "Options"
msgstr "Ընտրանքներ"

#: 01030300.xhp#par_idN10644.help.text
#: 01030300.xhp%23par_idN10644.help.text
msgid ""
"<ahelp hid=\".\">Opens the \"Security options and warning\" dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է «Անվտանգության ընտրանքներ և նախազգուշացում» "
"երկխոսությունը:</ahelp>"

#: 01030300.xhp#par_id5616626.help.text
#: 01030300.xhp%23par_id5616626.help.text
msgid ""
"The Security options and warnings dialog contains the following controls:"
msgstr ""
"Անվտանգության ընտրանքների և նախազգուշացումների երկխոսությունը պարունակում է "
"հետևյալ հսկիչները."

#: 01030300.xhp#par_idN10647.help.text
#: 01030300.xhp%23par_idN10647.help.text
msgid "When saving or sending"
msgstr "Երբ պահում կամ ուղարկում է"

#: 01030300.xhp#par_idN1064B.help.text
#: 01030300.xhp%23par_idN1064B.help.text
msgid ""
"<ahelp hid=\"703988739\">Select to see a warning dialog when you try to save "
"or send a document that contains recorded changes, versions, or "
"comments.</ahelp>"
msgstr ""
"<ahelp hid=\"703988739\">Ընտրեք՝ նախազգուշացման երկխոսությունը տեսնելու "
"համար, երբ փորձում եք պահպանել կամ ուղարկել փաստաթուղթ, որը պարունակում է "
"գրանցված փոփոխություններ, տարբերակներ կամ մեկնաբանություններ:</ahelp>"

#: 01030300.xhp#par_idN1064E.help.text
#: 01030300.xhp%23par_idN1064E.help.text
msgid "When printing"
msgstr "Երբ տպում է"

#: 01030300.xhp#par_idN10652.help.text
#: 01030300.xhp%23par_idN10652.help.text
msgid ""
"<ahelp hid=\"703988740\">Select to see a warning dialog when you try to "
"print a document that contains recorded changes or comments.</ahelp>"
msgstr ""
"<ahelp hid=\"703988740\">Ընտրեք՝ նախազգուշացման երկխոսությունը տեսնելու "
"համար, երբ փորձում եք տպել մի փաստաթուղթ, որը պարունակում է գրանցված "
"փոփոխություններ կամ մեկնաբանություններ:</ahelp>"

#: 01030300.xhp#par_idN10655.help.text
#: 01030300.xhp%23par_idN10655.help.text
msgid "When signing"
msgstr "Ստորագրելիս"

#: 01030300.xhp#par_idN10659.help.text
#: 01030300.xhp%23par_idN10659.help.text
msgid ""
"<ahelp hid=\"703988741\">Select to see a warning dialog when you try to sign "
"a document that contains recorded changes, versions, fields, references to "
"other sources (for example linked sections or linked pictures), or "
"comments.</ahelp>"
msgstr ""
"<ahelp hid=\"703988741\">Ընտրեք՝ նախազգուշացման երկխոսությունը տեսնելու "
"համար, երբ փորձում եք ստորագրել մի փաստաթուղթ, որը պարունակում է գրանցված "
"փոփոխություններ, տարբերակներ, դաշտեր, հղումներ այլ աղբյուրներին (օրինակ՝ "
"կապված բաժիններ կամ կապված նկարներ) կամ մեկնաբանություններ:</ahelp>"

#: 01030300.xhp#par_idN1065C.help.text
#: 01030300.xhp%23par_idN1065C.help.text
msgid "When creating PDF files"
msgstr "Երբ ստեղծում է PDF նիշքեր"

#: 01030300.xhp#par_idN10660.help.text
#: 01030300.xhp%23par_idN10660.help.text
msgid ""
"<ahelp hid=\"703988742\">Select to see a warning dialog when you try to "
"export a document to PDF format that displays recorded changes in Writer, or "
"that displays comments.</ahelp>"
msgstr ""
"<ahelp hid=\"703988742\">Ընտրեք՝ նախազգուշացման երկխոսությունը տեսնելու "
"համար, երբ փորձում եք փաստաթուղթ արտահանել որպես PDF ձևաչափ, որը ցուցադրում "
"է Writer-ում գրանցված փոփոխությունները, կամ ցուցադրում է "
"մեկնաբանությունները:</ahelp>"

#: 01030300.xhp#par_idN10663.help.text
#: 01030300.xhp%23par_idN10663.help.text
msgid "Remove personal information on saving"
msgstr "Պահելուց հեռացրեք անձնական տեղեկատվությունը"

#: 01030300.xhp#par_idN10667.help.text
#: 01030300.xhp%23par_idN10667.help.text
msgid ""
"<ahelp hid=\"703988743\">Select to always remove user data from the file "
"properties. If this option is not selected, you can still remove the "
"personal information for the current document with the <emph>Reset</emph> "
"button on <emph>File - Properties - General</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\"703988743\">Ընտրեք՝ օգտվողի տվյալները նիշքի հատկություններից "
"միշտ հեռացնելու համար: Եթե այս տարբերակը ընտրված չէ, դուք դեռ կարող եք "
"հեռացնել ընթացիկ փաստաթղթի անձնական տվյալները <emph>Նիշք - Հատկություններ - "
"Ընդհանուր</emph> առկա <emph>Վերաշտկել</emph> կոճակով:</ahelp>"

#: 01030300.xhp#par_idN1067C.help.text
#: 01030300.xhp%23par_idN1067C.help.text
msgid "Recommend password protection on saving"
msgstr "Պահելուց խորհուրդ տվեք գաղտնաբառով պաշտպանություն"

#: 01030300.xhp#par_idN10680.help.text
#: 01030300.xhp%23par_idN10680.help.text
msgid ""
"<ahelp hid=\"703988744\">Select to always enable the <emph>Save with "
"password</emph> option in the file save dialogs. Deselect the option to save "
"files by default without password.</ahelp>"
msgstr ""
"<ahelp hid=\"703988744\">Ընտրեք՝ նիշքի պահպանման երկխոսություններում <emph>"
"Հիշել գաղտնաբառով</emph> տարբերակը միշտ միացնելու համար: Ապաընտրեք տարբերակը՝"
" նիշքերը առանց գաղտնաբառի լռելյայն պահելու համար:</ahelp>"

#: 01030300.xhp#hd_id1972106.help.text
#: 01030300.xhp%23hd_id1972106.help.text
msgid "Ctrl-click required to follow hyperlinks"
msgstr "Ctrl-կտտոց է պահանջվում, գերհղումներին հետևելու համար"

#: 01030300.xhp#par_id79042.help.text
#: 01030300.xhp%23par_id79042.help.text
msgid ""
"<ahelp hid=\".\">If enabled, you must hold down the Ctrl key while clicking "
"a hyperlink to follow that link. If not enabled, a click opens the "
"hyperlink.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Միացված լինելու դեպքում այդ հղմանը հետևելու համար գերհղումը "
"սեղմելիս պետք է սեղմած պահեք Ctrl ստեղնը: Եթե միացված չէ, կտտոցով բացվում է "
"գերհղումը:</ahelp>"

#: 01030300.xhp#hd_id4076357.help.text
#: 01030300.xhp%23hd_id4076357.help.text
msgid "Passwords for web connections"
msgstr "Վեբ միացման համար գաղտնաբառեր"

#: 01030300.xhp#par_id8231757.help.text
#: 01030300.xhp%23par_id8231757.help.text
msgid ""
"You can enter a master password to enable easy access to sites that require "
"a user name and password."
msgstr ""
"Կարող եք մուտքագրել հիմնական գաղտնաբառը՝ օգտագործողի անուն և գաղտնաբառ "
"պահանջող կայքերը հեշտ մուտք գործելու համար:"

#: 01030300.xhp#hd_id3168736.help.text
#: 01030300.xhp%23hd_id3168736.help.text
msgid "Persistently save passwords protected by a master password"
msgstr "Անընդհատ պահեք հիմնական գաղտնաբառով պաշտպանված գաղտնաբառերը"

#: 01030300.xhp#par_id1909848.help.text
#: 01030300.xhp%23par_id1909848.help.text
msgid ""
"<ahelp hid=\".\">If enabled, %PRODUCTNAME will securely store all passwords "
"that you use to access files from web servers. You can retrieve the "
"passwords from the list after you enter the master password.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Միացված լինելու դեպքում, %PRODUCTNAME -ը ապահով կերպով "
"կպահի բոլոր գաղտնաբառերը, որոնք օգտագործում եք վեբ կայաններից նիշքեր մուտք "
"գործելու համար: Հիմնական գաղտնաբառը մուտքագրելուց հետո կարող եք վերստանալ "
"գաղտնաբառերը ցուցակից:</ahelp>"

#: 01030300.xhp#hd_id3901791.help.text
#: 01030300.xhp%23hd_id3901791.help.text
msgid "Master Password"
msgstr "Վարպետ գաղտնաբառ"

#: 01030300.xhp#par_id4571977.help.text
#: 01030300.xhp%23par_id4571977.help.text
msgid "<ahelp hid=\".\">Opens the Enter Master Password dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է Մուտքագրեք Վարպետ գաղտնաբառը "
"երկխոսությունը:</ahelp>"

#: 01030300.xhp#par_id5216223.help.text
#: 01030300.xhp%23par_id5216223.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Enter the master password.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Մուտքագրեք վարպետ գաղտնաբառը։</ahelp>"

#: 01030300.xhp#par_id7067171.help.text
#: 01030300.xhp%23par_id7067171.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Enter the master password "
"again.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Կրկին մուտքագրեք վարպետ "
"գաղտնաբառը։</ahelp>"

#: 01030300.xhp#par_id7499313.help.text
#: 01030300.xhp%23par_id7499313.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Enter the master password to "
"continue.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Շարունակելու համար մուտքագրեք վարպետ "
"գաղտնաբառը։</ahelp>"

#: 01030300.xhp#hd_id3283486.help.text
#: 01030300.xhp%23hd_id3283486.help.text
msgctxt "01030300.xhp#hd_id3283486.help.text"
msgid "Connections"
msgstr "Միացումներ"

#: 01030300.xhp#par_id3472090.help.text
#: 01030300.xhp%23par_id3472090.help.text
msgid ""
"<ahelp hid=\".\">Asks for the master password. If master password is "
"correct, shows the Stored Web Connection Information dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Հարցնում է հիմնական գաղտնաբառը: Եթե հիմնական գաղտնաբառը "
"ճիշտ է, ցույց է տալիս Պահված Վեբ Կապի Տեղեկատվության երկխոսությունը:</ahelp>"

#: 01030300.xhp#par_id3289590.help.text
#: 01030300.xhp%23par_id3289590.help.text
msgid ""
"The Stored Web Connection Information dialog shows a list of web sites and "
"user names that you entered previously. You can select any entry and remove "
"it from the list. You can view the password for the selected entry."
msgstr ""
"Պահված վեբ կապի տեղեկատվության երկխոսությունը ցույց է տալիս նախկինում "
"մուտքագրված վեբ կայքերի և օգտագործողների անունների ցուցակը: Կարող եք ընտրել "
"ցանկացած մուտք և հեռացնել այն ցուցակից: Կարող եք դիտել ընտրված մուտքի "
"գաղտնաբառը:"

#: 01030300.xhp#par_id7499008.help.text
#: 01030300.xhp%23par_id7499008.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Removes the selected entry from the "
"list.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ցուցակից հեռացնում է ընտրված "
"մուտքը:</ahelp>"

#: 01030300.xhp#par_id7021088.help.text
#: 01030300.xhp%23par_id7021088.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Removes all entries from the "
"list.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ցուցակից հեռացնում է բոլոր "
"մուտքերը:</ahelp>"

#: 01030300.xhp#par_id1981261.help.text
#: 01030300.xhp%23par_id1981261.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens a dialog where you can view and "
"change the password for the selected entry.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացվում է երկխոսությունը, որտեղ կարող "
"եք դիտել և փոխել ընտրված մուտքի գաղտնաբառը:</ahelp>"

#: 01030300.xhp#par_idN10687.help.text
#: 01030300.xhp%23par_idN10687.help.text
msgid "Macro security"
msgstr "Մակրո անվտանգություն"

#: 01030300.xhp#par_idN1068B.help.text
#: 01030300.xhp%23par_idN1068B.help.text
msgid ""
"Adjust the security level for executing macros and specify trusted macro "
"authors."
msgstr ""
"Կարգավորեք մակրոների կատարման անվտանգության մակարդակը և նշեք վստահելի "
"մակրոների հեղինակներին:"

#: 01030300.xhp#par_idN1068E.help.text
#: 01030300.xhp%23par_idN1068E.help.text
msgctxt "01030300.xhp#par_idN1068E.help.text"
msgid "Macro Security"
msgstr "Մակրո անվտանգություն"

#: 01030300.xhp#par_idN10692.help.text
#: 01030300.xhp%23par_idN10692.help.text
msgid ""
"<ahelp hid=\"703992332\">Opens the <emph>Macro Security</emph> "
"dialog.</ahelp>"
msgstr ""
"<ahelp hid=\"703992332\">Բացում է <emph>Մակրո անվտանգություն</emph> "
"երկխոսությունը։</ahelp>"

#: 01060401.xhp#tit.help.text
#: 01060401.xhp%23tit.help.text
msgctxt "01060401.xhp#tit.help.text"
msgid "Copy List"
msgstr "Պատճենել ցուցակը"

#: 01060401.xhp#bm_id3153341.help.text
#: 01060401.xhp%23bm_id3153341.help.text
msgid "<bookmark_value>sort lists; copying to in Calc</bookmark_value>"
msgstr ""
"<bookmark_value>տեսակավորման ցուցակներ; պատճենել Calc-ում</bookmark_value>"

#: 01060401.xhp#hd_id3153341.1.help.text
#: 01060401.xhp%23hd_id3153341.1.help.text
msgctxt "01060401.xhp#hd_id3153341.1.help.text"
msgid "Copy List"
msgstr "Պատճենել ցուցակը"

#: 01060401.xhp#par_id3150772.2.help.text
#: 01060401.xhp%23par_id3150772.2.help.text
msgid ""
"<ahelp hid=\"SC_MODALDIALOG_RID_SCDLG_COLORROW\">Allows you to copy marked "
"cells to a sort list.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_MODALDIALOG_RID_SCDLG_COLORROW\">Թույլ է տալիս պատճենել "
"նշված բջիջները տեսակավորման ցուցակում:</ahelp>"

#: 01060401.xhp#hd_id3147574.3.help.text
#: 01060401.xhp%23hd_id3147574.3.help.text
msgid "List from"
msgstr "Ցուցակը այստեղից"

#: 01060401.xhp#par_id3148563.4.help.text
#: 01060401.xhp%23par_id3148563.4.help.text
msgid ""
"Choose between the options<emph> Rows</emph> and <emph>Columns</emph>. Cells "
"without text will be ignored when copying."
msgstr ""
"Ընտրեք <emph>Տողեր</emph> և <emph>Սյունակներ</emph> ընտրանքների միջև: "
"Պատճենելիս առանց տեքստի բջիջները անտեսվում են:"

#: 01060401.xhp#hd_id3156343.5.help.text
#: 01060401.xhp%23hd_id3156343.5.help.text
msgid "Rows"
msgstr "Տողեր"

#: 01060401.xhp#par_id3148664.6.help.text
#: 01060401.xhp%23par_id3148664.6.help.text
msgid ""
"<ahelp hid=\"SC_RADIOBUTTON_RID_SCDLG_COLORROW_BTN_GROUP_ROWS\">Select "
"the<emph> Rows </emph>option to summarize the contents of the selected rows "
"in a list.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_RADIOBUTTON_RID_SCDLG_COLORROW_BTN_GROUP_ROWS\">Ընտրեք<emph> "
"Տողեր </emph>տարբերակը տողերի բովանդակությունը ցուցակում ամփոփելու "
"համար:</ahelp>"

#: 01060401.xhp#hd_id3153525.7.help.text
#: 01060401.xhp%23hd_id3153525.7.help.text
msgid "Columns"
msgstr "Սյունակներ"

#: 01060401.xhp#par_id3154216.8.help.text
#: 01060401.xhp%23par_id3154216.8.help.text
msgid ""
"<ahelp hid=\"SC_RADIOBUTTON_RID_SCDLG_COLORROW_BTN_GROUP_COLS\">Select "
"the<emph> Columns </emph>option to summarize the contents of the selected "
"columns in a list.</ahelp>"
msgstr ""
"<ahelp hid=\"SC_RADIOBUTTON_RID_SCDLG_COLORROW_BTN_GROUP_COLS\">Ընտրեք<emph> "
"Սյունակներ </emph>տարբերակը, ընտրված սյունակների բովանդակությունը ցուցակում "
"ամփոփելու համար:</ahelp>"

#: 01130100.xhp#tit.help.text
#: 01130100.xhp%23tit.help.text
msgid "VBA Properties"
msgstr "VBA հատկություններ"

#: 01130100.xhp#bm_id3155805.help.text
#: 01130100.xhp%23bm_id3155805.help.text
