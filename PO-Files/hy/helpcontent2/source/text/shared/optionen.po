msgid ""
"<ahelp hid=\"HID_STD_FONT\">Specifies the settings for the basic fonts in "
"your documents.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_STD_FONT\">Նշում է ձեր փաստաթղթերի հիմնական տառատեսակների "
"կարգավորումները:</ahelp>"

#: 01040300.xhp#par_id3152349.19.help.text
#: 01040300.xhp%23par_id3152349.19.help.text
msgid ""
"You can also change the basic fonts for Asian and complex text layout "
"languages if their support is enabled in <emph><switchinline select=\"sys\"><"
"caseinline select=\"MAC\">%PRODUCTNAME - "
"Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - Language Settings - "
"Languages</emph>."
msgstr ""
"Կարող եք նաև փոխել հիմնական տառատեսակները ասիական և բարդ տեքստի "
"դասավորության լեզուների համար, եթե դրանց աջակցումը միացված է այստեղ <emph><"
"switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Նախապատվություններ</caseinline><defaultinline>Գործիքներ - "
"Ընտրանքներ</defaultinline></switchinline> - Լեզվի կարգավորումներ - "
"Լեզուներ</emph>."

#: 01040300.xhp#par_id3145609.18.help.text
#: 01040300.xhp%23par_id3145609.18.help.text
msgid ""
"These settings define the basic fonts for the predefined templates. You can "
"also modify or customize the <link href=\"text/shared/optionen/01040301.xhp\""
" name=\"default text templates\">default text templates</link>."
msgstr ""
"Այս կարգավորումները սահմանում են նախորոշված ձևանմուշների հիմնական "
"տառատեսակները: Կարող եք նաև փոփոխել կամ հարմարեցնել <link href=\""
"text/shared/optionen/01040301.xhp\" name=\"լռելյայն տեքստի ձևանմուշները\">"
"լռելյայն տեքստի ձևանմուշները</link>։"

