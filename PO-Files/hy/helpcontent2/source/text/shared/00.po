msgstr ""
"<ahelp hid=\"HID_GALLERY_MN_ADD_LINK\">Տեղադրում է ընտրված գրաֆիկը որպես "
"հղում:</ahelp>"

#: 01010000.xhp#par_id3158428.15.help.text
#: 01010000.xhp%23par_id3158428.15.help.text
