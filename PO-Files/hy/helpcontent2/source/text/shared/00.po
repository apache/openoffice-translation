msgid "Reset"
msgstr "Վերականգնել"

#: 00000001.xhp#par_id3150791.19.help.text
#: 00000001.xhp%23par_id3150791.19.help.text
msgid ""
"<ahelp hid=\"HID_TABDLG_RESET_BTN\">Resets modified values back to the "
"default values.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_TABDLG_RESET_BTN\">Վերափոխված արժեքները վերադարձվում են "
"լռելյայն արժեքներին:</ahelp>"

#: 00000001.xhp#par_id3154331.20.help.text
#: 00000001.xhp%23par_id3154331.20.help.text
msgid ""
"A confirmation query does not appear. If you confirm the dialog with OK all "
"settings in this dialog are reset."
msgstr ""
"Հաստատման հարցումը չի հայտնվում: Եթե հաստատում եք երկխոսությունը ԼԱՎ-ով, ապա "
"այս երկխոսության բոլոր պարամետրերը վերագրվում են:"

#: 00000001.xhp#hd_id3145173.10.help.text
#: 00000001.xhp%23hd_id3145173.10.help.text
