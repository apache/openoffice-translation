msgstr ""
"<bookmark_value>BETAINV function</bookmark_value>         <bookmark_value>"
"cumulative probability density function;inverse of</bookmark_value>"

#: 04060181.xhp#hd_id3145620.52.help.text
#: 04060181.xhp%23hd_id3145620.52.help.text
