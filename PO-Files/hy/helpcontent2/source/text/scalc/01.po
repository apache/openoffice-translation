msgstr "<bookmark_value>LCM_ADD function</bookmark_value>"

#: 04060106.xhp#hd_id3154230.684.help.text
#: 04060106.xhp%23hd_id3154230.684.help.text
msgid "LCM_ADD"
msgstr "LCM_ADD"

#: 04060106.xhp#par_id3149036.685.help.text
#: 04060106.xhp%23par_id3149036.685.help.text
msgid ""
"<ahelp hid=\"HID_AAI_FUNC_LCM\"> The result is the lowest common multiple of "
"a list of numbers.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_AAI_FUNC_LCM\"> Արդյունքը ցուցակի թվերի ամենափոքր ընդհանուր "
"բազմապատիկն է:</ahelp>"

#: 04060106.xhp#hd_id3153132.686.help.text
#: 04060106.xhp%23hd_id3153132.686.help.text
msgctxt "04060106.xhp#hd_id3153132.686.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3154395.687.help.text
#: 04060106.xhp%23par_id3154395.687.help.text
msgid "LCM_ADD(Number(s))"
msgstr "LCM_ADD(Number(s))"

#: 04060106.xhp#par_id3147377.688.help.text
#: 04060106.xhp%23par_id3147377.688.help.text
msgctxt "04060106.xhp#par_id3147377.688.help.text"
msgid "<emph>Number(s)</emph> is a list of up to 30 numbers."
msgstr "<emph>Թիվ(եր)</emph> մինչև 30 թվերի ցուցակն է։"

#: 04060106.xhp#hd_id3145122.689.help.text
#: 04060106.xhp%23hd_id3145122.689.help.text
msgctxt "04060106.xhp#hd_id3145122.689.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3145135.690.help.text
#: 04060106.xhp%23par_id3145135.690.help.text
msgid "<item type=\"input\">=LCM_ADD(5;15;25)</item> returns 75."
msgstr "<item type=\"input\">=LCM_ADD(5;15;25)</item> վերադարձնում է 75։"

#: 04060106.xhp#bm_id3155802.help.text
#: 04060106.xhp%23bm_id3155802.help.text
msgid ""
"<bookmark_value>COMBIN function</bookmark_value><bookmark_value>number of "
"combinations</bookmark_value>"
msgstr ""
"<bookmark_value>COMBIN function</bookmark_value><bookmark_value>"
"համակցությունների քանակն է</bookmark_value>"

#: 04060106.xhp#hd_id3155802.273.help.text
#: 04060106.xhp%23hd_id3155802.273.help.text
msgid "COMBIN"
msgstr "COMBIN"

#: 04060106.xhp#par_id3156172.274.help.text
#: 04060106.xhp%23par_id3156172.274.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_KOMBINATIONEN\">Returns the number of combinations for "
"elements without repetition.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_KOMBINATIONEN\">Վերադարձնում է տարրերի համար առանց "
"կրկնության համակցությունների քանակը:</ahelp>"

#: 04060106.xhp#hd_id3156193.275.help.text
#: 04060106.xhp%23hd_id3156193.275.help.text
msgctxt "04060106.xhp#hd_id3156193.275.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3150223.276.help.text
#: 04060106.xhp%23par_id3150223.276.help.text
msgid "COMBIN(Count1; Count2)"
msgstr "COMBIN(Count1; Count2)"

#: 04060106.xhp#par_id3150313.277.help.text
#: 04060106.xhp%23par_id3150313.277.help.text
msgctxt "04060106.xhp#par_id3150313.277.help.text"
msgid "<emph>Count1</emph> is the number of items in the set."
msgstr "<emph>Count1</emph> բազմության նյութերի քանակն է:"

#: 04060106.xhp#par_id3153830.278.help.text
#: 04060106.xhp%23par_id3153830.278.help.text
msgctxt "04060106.xhp#par_id3153830.278.help.text"
msgid "<emph>Count2</emph> is the number of items to choose from the set."
msgstr "<emph>Count2</emph> բազմությունից ընտրվող նյութերի քանակն է:"

#: 04060106.xhp#par_id6807458.help.text
#: 04060106.xhp%23par_id6807458.help.text
msgid ""
"COMBIN returns the number of ordered ways to choose these items. For example "
"if there are 3 items A, B and C in a set, you can choose 2 items in 3 "
"different ways, namely AB, AC and BC."
msgstr ""
"COMBIN -ը վերադարձնում է այս նյութերը ընտրելու կարգավորված եղանակների քանակը:"
" Օրինակ, եթե հավաքածուի մեջ կա 3 նյութ՝ A, B և C, կարող եք ընտրել 2 նյութ 3 "
"տարբեր եղանակներով՝ AB, AC և BC:"

#: 04060106.xhp#par_id7414471.help.text
#: 04060106.xhp%23par_id7414471.help.text
msgid "COMBIN implements the formula: Count1!/(Count2!*(Count1-Count2)!)"
msgstr "COMBIN -ը ներդնում է Count1!/(Count2!*(Count1-Count2)!) բանաձևը․"

#: 04060106.xhp#hd_id3153171.279.help.text
#: 04060106.xhp%23hd_id3153171.279.help.text
msgctxt "04060106.xhp#hd_id3153171.279.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3153517.280.help.text
#: 04060106.xhp%23par_id3153517.280.help.text
msgid "<item type=\"input\">=COMBIN(3;2)</item> returns 3."
msgstr "<item type=\"input\">=COMBIN(3;2)</item> վերադարձնում է 3։"

#: 04060106.xhp#bm_id3150284.help.text
#: 04060106.xhp%23bm_id3150284.help.text
msgid ""
"<bookmark_value>COMBINA function</bookmark_value><bookmark_value>number of "
"combinations with repetitions</bookmark_value>"
msgstr ""
"<bookmark_value>COMBINA function</bookmark_value><bookmark_value>կրկնվող "
"համադրությունների քանակը</bookmark_value>"

#: 04060106.xhp#hd_id3150284.282.help.text
#: 04060106.xhp%23hd_id3150284.282.help.text
msgid "COMBINA"
msgstr "COMBINA"

#: 04060106.xhp#par_id3157894.283.help.text
#: 04060106.xhp%23par_id3157894.283.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_KOMBINATIONEN2\">Returns the number of combinations of "
"a subset of items including repetitions.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_KOMBINATIONEN2\">Վերադարձնում է տարրերի "
"ենթաբազմությունների համադրությունների քանակը` ներառյալ "
"կրկնությունները:</ahelp>"

#: 04060106.xhp#hd_id3145752.284.help.text
#: 04060106.xhp%23hd_id3145752.284.help.text
msgctxt "04060106.xhp#hd_id3145752.284.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3145765.285.help.text
#: 04060106.xhp%23par_id3145765.285.help.text
msgid "COMBINA(Count1; Count2)"
msgstr "COMBINA(Count1; Count2)"

#: 04060106.xhp#par_id3153372.286.help.text
#: 04060106.xhp%23par_id3153372.286.help.text
msgctxt "04060106.xhp#par_id3153372.286.help.text"
msgid "<emph>Count1</emph> is the number of items in the set."
msgstr "<emph>Count1</emph> բազմությունում նյութերի քանակն է։"

#: 04060106.xhp#par_id3155544.287.help.text
#: 04060106.xhp%23par_id3155544.287.help.text
msgctxt "04060106.xhp#par_id3155544.287.help.text"
msgid "<emph>Count2</emph> is the number of items to choose from the set."
msgstr "<emph>Count2</emph> բազմությունից ընտրվող նյութերի քանակն է։"

#: 04060106.xhp#par_id1997131.help.text
#: 04060106.xhp%23par_id1997131.help.text
msgid ""
"COMBINA returns the number of unique ways to choose these items, where the "
"order of choosing is irrelevant, and repetition of items is allowed. For "
"example if there are 3 items A, B and C in a set, you can choose 2 items in "
"6 different ways, namely AA, AB, AC, BB, BC and CC."
msgstr ""
"COMBINA -ը վերադարձնում է այս նյութերի ընտրության եզակի եղանակների քանակը, "
"որտեղ ընտրության կարգը անտեսվում է, և նյութերի կրկնությունը թույլատրվում է: "
"Օրինակ, եթե հավաքածուի մեջ կան 3 նյութ A, B և C, ապա կարող եք ընտրել 2 նյութ "
"6 տարբեր եղանակներով՝ մասնավորապես AA, AB, AC, BB, BC և CC:"

#: 04060106.xhp#par_id2052064.help.text
#: 04060106.xhp%23par_id2052064.help.text
msgid ""
"COMBINA implements the formula: (Count1+Count2-1)! / (Count2!(Count1-1)!)"
msgstr "COMBINA ներդնում է (Count1+Count2-1)! / (Count2!(Count1-1)!) բանաձևը"

#: 04060106.xhp#hd_id3154584.288.help.text
#: 04060106.xhp%23hd_id3154584.288.help.text
msgctxt "04060106.xhp#hd_id3154584.288.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3152904.289.help.text
#: 04060106.xhp%23par_id3152904.289.help.text
msgid "<item type=\"input\">=COMBINA(3;2)</item> returns 6."
msgstr "<item type=\"input\">=COMBINA(3;2)</item> վերադարձնում է 6։"

#: 04060106.xhp#bm_id3156086.help.text
#: 04060106.xhp%23bm_id3156086.help.text
msgid ""
"<bookmark_value>TRUNC function</bookmark_value><bookmark_value>decimal "
"places;cutting off</bookmark_value>"
msgstr ""
"<bookmark_value>TRUNC function</bookmark_value><bookmark_value>տասական "
"դիրքեր;հատում</bookmark_value>"

#: 04060106.xhp#hd_id3156086.291.help.text
#: 04060106.xhp%23hd_id3156086.291.help.text
msgid "TRUNC"
msgstr "TRUNC"

#: 04060106.xhp#par_id3157866.292.help.text
#: 04060106.xhp%23par_id3157866.292.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_KUERZEN\">Truncates a number by removing decimal "
"places.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_KUERZEN\">Հատում է թիվը, հեռացնելով տասական "
"դիրքերը։</ahelp>"

#: 04060106.xhp#hd_id3148499.293.help.text
#: 04060106.xhp%23hd_id3148499.293.help.text
msgctxt "04060106.xhp#hd_id3148499.293.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3148511.294.help.text
#: 04060106.xhp%23par_id3148511.294.help.text
msgid "TRUNC(Number; Count)"
msgstr "TRUNC(Number; Count)"

#: 04060106.xhp#par_id3150796.295.help.text
#: 04060106.xhp%23par_id3150796.295.help.text
msgid ""
"Returns <emph>Number</emph> with at most <emph>Count</emph> decimal places. "
"Excess decimal places are simply removed, irrespective of sign."
msgstr ""
"Վերադարձնում է <emph>Թիվ</emph> առավելագույնը <emph>Հաշվարկ</emph> տասական "
"դիրքերով։ Ավելորդ տասնորդական դիրքերը պարզապես հանվում են, անկախ նշանից:"

#: 04060106.xhp#par_id3150816.296.help.text
#: 04060106.xhp%23par_id3150816.296.help.text
msgid ""
"<item type=\"literal\">TRUNC(Number; 0)</item> behaves as <item type=\""
"literal\">INT(Number)</item> for positive numbers, but effectively rounds "
"towards zero for negative numbers."
msgstr ""
"<item type=\"literal\">TRUNC(Number; 0)</item> պահում է ինչպես <item type=\""
"literal\">INT(Number)</item> դրական թվերի համար, բայց արդյունավետորեն "
"կլորացվում է դեպի զրո՝ բացասական թվերի համար:"

#: 04060106.xhp#par_id3148548.557.help.text
#: 04060106.xhp%23par_id3148548.557.help.text
msgid ""
"The <emph>visible</emph> decimal places of the result are specified in <"
"switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - <link href=\""
"text/shared/optionen/01060500.xhp\">%PRODUCTNAME Calc - Calculate</link>."
msgstr ""
"<emph>տեսանելի</emph> արդյունքի տասնորդական տեղերը նշված են <switchinline "
"select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Նախապատվություններ</caseinline><defaultinline>Գործիքներ - "
"Ընտրանքներ</defaultinline></switchinline> - <link href=\""
"text/shared/optionen/01060500.xhp\">%PRODUCTNAME Calc - Հաշվել</link>։"

#: 04060106.xhp#hd_id3152555.297.help.text
#: 04060106.xhp%23hd_id3152555.297.help.text
msgctxt "04060106.xhp#hd_id3152555.297.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3152569.298.help.text
#: 04060106.xhp%23par_id3152569.298.help.text
msgid ""
"<item type=\"input\">=TRUNC(1.239;2)</item> returns 1.23. The 9 is lost."
msgstr ""
"<item type=\"input\">=TRUNC(1.239;2)</item> վերադարձնում է 1.23։ 9-ը կորում "
"է։"

#: 04060106.xhp#par_id7050080.help.text
#: 04060106.xhp%23par_id7050080.help.text
msgid ""
"<item type=\"input\">=TRUNC(-1.234999;3)</item> returns -1.234. All the 9s "
"are lost."
msgstr ""
"<item type=\"input\">=TRUNC(-1.234999;3)</item> վերադարձնում է -1.234. Բոլոր "
"9-երը կորում են։"

#: 04060106.xhp#bm_id3153601.help.text
#: 04060106.xhp%23bm_id3153601.help.text
msgid ""
"<bookmark_value>LN function</bookmark_value><bookmark_value>natural "
"logarithm</bookmark_value>"
msgstr ""
"<bookmark_value>LN function</bookmark_value><bookmark_value>բնական "
"լոգարիթմ</bookmark_value>"

#: 04060106.xhp#hd_id3153601.301.help.text
#: 04060106.xhp%23hd_id3153601.301.help.text
msgid "LN"
msgstr "LN"

#: 04060106.xhp#par_id3154974.302.help.text
#: 04060106.xhp%23par_id3154974.302.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_LN\">Returns the natural logarithm based on the "
"constant e of a number.</ahelp> The constant e has a value of approximately "
"2.71828182845904."
msgstr ""
"<ahelp hid=\"HID_FUNC_LN\">Վերադարձնում է թվի բնական լոգարիթմը ըստ e "
"հիմքի։</ahelp> e հիմքը դա հաստատուն է, մոտավորապես 2.71828182845904 արժեքով:"

#: 04060106.xhp#hd_id3154993.303.help.text
#: 04060106.xhp%23hd_id3154993.303.help.text
msgctxt "04060106.xhp#hd_id3154993.303.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3155284.304.help.text
#: 04060106.xhp%23par_id3155284.304.help.text
msgid "LN(Number)"
msgstr "LN(Number)"

#: 04060106.xhp#par_id3155297.305.help.text
#: 04060106.xhp%23par_id3155297.305.help.text
msgid ""
"<emph>Number</emph> is the value whose natural logarithm is to be calculated."
msgstr "<emph>Թիվ</emph> այն արժեքն է, որի բնական լոգարիթմը պետք է հաշվել։"

#: 04060106.xhp#hd_id3153852.306.help.text
#: 04060106.xhp%23hd_id3153852.306.help.text
msgctxt "04060106.xhp#hd_id3153852.306.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3153866.307.help.text
#: 04060106.xhp%23par_id3153866.307.help.text
msgid ""
"<item type=\"input\">=LN(3)</item> returns the natural logarithm of 3 ("
"approximately 1.0986)."
msgstr ""
"<item type=\"input\">=LN(3)</item> վերադարձնում է 3-ի բնական լոգարիթմը ("
"մոտավորապես 1.0986):"

#: 04060106.xhp#par_id5747245.help.text
#: 04060106.xhp%23par_id5747245.help.text
msgid "<item type=\"input\">=LN(EXP(321))</item> returns 321."
msgstr "<item type=\"input\">=LN(EXP(321))</item> վերադարձնում է 321։"

#: 04060106.xhp#bm_id3109813.help.text
#: 04060106.xhp%23bm_id3109813.help.text
msgid ""
"<bookmark_value>LOG "
"function</bookmark_value><bookmark_value>logarithms</bookmark_value>"
msgstr ""
"<bookmark_value>LOG "
"function</bookmark_value><bookmark_value>լոգարիթմներ</bookmark_value>"

#: 04060106.xhp#hd_id3109813.311.help.text
#: 04060106.xhp%23hd_id3109813.311.help.text
msgid "LOG"
msgstr "LOG"

#: 04060106.xhp#par_id3109841.312.help.text
#: 04060106.xhp%23par_id3109841.312.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_LOG\">Returns the logarithm of a number to the "
"specified base.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_LOG\">Վերադարձնում է մի սահմանված հիմքով "
"լոգարիթմը:</ahelp>"

#: 04060106.xhp#hd_id3144719.313.help.text
#: 04060106.xhp%23hd_id3144719.313.help.text
msgctxt "04060106.xhp#hd_id3144719.313.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3144732.314.help.text
#: 04060106.xhp%23par_id3144732.314.help.text
msgid "LOG(Number; Base)"
msgstr "LOG(Number; Base)"

#: 04060106.xhp#par_id3144746.315.help.text
#: 04060106.xhp%23par_id3144746.315.help.text
msgid "<emph>Number</emph> is the value whose logarithm is to be calculated."
msgstr "<emph>Թիվ</emph> այն արժեքն է, որի լոգարիթմը պետք է հաշվել:"

#: 04060106.xhp#par_id3152840.316.help.text
#: 04060106.xhp%23par_id3152840.316.help.text
msgid ""
"<emph>Base</emph> (optional) is the base for the logarithm calculation. If "
"omitted, Base 10 is assumed."
msgstr ""
"<emph>Հիմք</emph> (կամընտրական) լոգարիթմը հաշվելու հիմքն է: Եթե բացակայում "
"է, ենթադրվում է որ հիմքը 10 է:"

#: 04060106.xhp#hd_id3152860.317.help.text
#: 04060106.xhp%23hd_id3152860.317.help.text
msgctxt "04060106.xhp#hd_id3152860.317.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3154429.318.help.text
#: 04060106.xhp%23par_id3154429.318.help.text
msgid ""
"<item type=\"input\">=LOG(10;3)</item> returns the logarithm to base 3 of 10 "
"(approximately 2.0959)."
msgstr ""
"<item type=\"input\">=LOG(10;3)</item> վերադարձնում է 10-ի լոգարիթմը ըստ 3 "
"հիմքի (մոտավորապես 2.0959)։"

#: 04060106.xhp#par_id5577562.help.text
#: 04060106.xhp%23par_id5577562.help.text
msgid "<item type=\"input\">=LOG(7^4;7)</item> returns 4."
msgstr "<item type=\"input\">=LOG(7^4;7)</item> վերադարձնում է 4։"

#: 04060106.xhp#bm_id3154187.help.text
#: 04060106.xhp%23bm_id3154187.help.text
msgid ""
"<bookmark_value>LOG10 function</bookmark_value><bookmark_value>base-10 "
"logarithm</bookmark_value>"
msgstr ""
"<bookmark_value>LOG10 function</bookmark_value><bookmark_value>լոգարիթմը ըստ "
"10 հիմքի</bookmark_value>"

#: 04060106.xhp#hd_id3154187.322.help.text
#: 04060106.xhp%23hd_id3154187.322.help.text
msgid "LOG10"
msgstr "LOG10"

#: 04060106.xhp#par_id3155476.323.help.text
#: 04060106.xhp%23par_id3155476.323.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_LOG10\">Returns the base-10 logarithm of a "
"number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_LOG10\">Վերադարձնում է թվի լոգարիթմը ըստ 10 "
"հիմքի։</ahelp>"

#: 04060106.xhp#hd_id3155494.324.help.text
#: 04060106.xhp%23hd_id3155494.324.help.text
msgctxt "04060106.xhp#hd_id3155494.324.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3159294.325.help.text
#: 04060106.xhp%23par_id3159294.325.help.text
msgid "LOG10(Number)"
msgstr "LOG10(Number)"

#: 04060106.xhp#par_id3159308.326.help.text
#: 04060106.xhp%23par_id3159308.326.help.text
msgid "Returns the logarithm to base 10 of <emph>Number</emph>."
msgstr "Վերադարձնում է 10 հիմքով լոգարիթմը <emph>Թիվ</emph>։"

#: 04060106.xhp#hd_id3159328.327.help.text
#: 04060106.xhp%23hd_id3159328.327.help.text
msgctxt "04060106.xhp#hd_id3159328.327.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3157916.328.help.text
#: 04060106.xhp%23par_id3157916.328.help.text
msgid ""
"<item type=\"input\">=LOG10(5)</item> returns the base-10 logarithm of 5 ("
"approximately 0.69897)."
msgstr ""
"<item type=\"input\">=LOG10(5)</item> վերադարձնում է 5-ի լոգարիթմը ըստ 10 "
"հիմքի (մոտավորապես 0.69897)։"

#: 04060106.xhp#bm_id3152518.help.text
#: 04060106.xhp%23bm_id3152518.help.text
msgid ""
"<bookmark_value>CEILING function</bookmark_value><bookmark_value>rounding;up "
"to multiples of significance</bookmark_value>"
msgstr ""
"<bookmark_value>CEILING function</bookmark_value><bookmark_value>կլորացնել;"
"դեպի մեծը բազմապատիկներով</bookmark_value>"

#: 04060106.xhp#hd_id3152518.332.help.text
#: 04060106.xhp%23hd_id3152518.332.help.text
msgid "CEILING"
msgstr "CEILING"

#: 04060106.xhp#par_id3153422.558.help.text
#: 04060106.xhp%23par_id3153422.558.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_OBERGRENZE\">Rounds a number up to the nearest "
"multiple of Significance.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_OBERGRENZE\">Կլորացնում է թիվը դեպի մեծը, մինչև մոտակա "
"բազմապատիկը:</ahelp>"

#: 04060106.xhp#hd_id3153440.334.help.text
#: 04060106.xhp%23hd_id3153440.334.help.text
msgctxt "04060106.xhp#hd_id3153440.334.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3153454.335.help.text
#: 04060106.xhp%23par_id3153454.335.help.text
msgid "CEILING(Number; Significance; Mode)"
msgstr "CEILING(Number; Significance; Mode)"

#: 04060106.xhp#par_id3153467.336.help.text
#: 04060106.xhp%23par_id3153467.336.help.text
msgid "<emph>Number</emph> is the number that is to be rounded up."
msgstr "<emph>Թիվ</emph> կլորացման ենթակա թիվն է։"

#: 04060106.xhp#par_id3155000.337.help.text
#: 04060106.xhp%23par_id3155000.337.help.text
msgid ""
"<emph>Significance</emph> is the number to whose multiple the value is to be "
"rounded up."
msgstr "<emph>Ճշտություն</emph> այն թիվն է, որի բազմապատիկը պետք է կլորացվի:"

#: 04060106.xhp#par_id3155020.559.help.text
#: 04060106.xhp%23par_id3155020.559.help.text
msgid ""
"<emph>Mode</emph> is an optional value. If the Mode value is given and not "
"equal to zero, and if Number and Significance are negative, then rounding is "
"done based on the absolute value of Number. This parameter is ignored when "
"exporting to MS Excel as Excel does not know any third parameter."
msgstr ""
"<emph>Վիճակ</emph> կամընտրևական արժեք է։ Եթե Վիճակ արժեքը տրված է և հավասար "
"չէ զրոյի, և եթե Թիվը և Ճշտությունը բացասական են, ապա կլորացումը կատարվում է "
"Թվի բացարձակ արժեքի հիման վրա: Այս պարամետրը անտեսվում է, երբ արտահանվում է "
"MS Excel, քանի որ Excel- ը որևէ երրորդ պարամետր չգիտի:"

#: 04060106.xhp#par_id3163792.629.help.text
#: 04060106.xhp%23par_id3163792.629.help.text
msgid ""
"If both parameters Number and Significance are negative and the Mode value "
"is equal to zero or is not given, the results in $[officename] and Excel "
"will differ after the import has been completed. If you export the "
"spreadsheet to Excel, use Mode=1 to see the same results in Excel as in Calc."
msgstr ""
"Եթե երկու պարամետրերն էլ՝ Թիվ և Ճշտություն բացասական են, իսկ Վիճակ արժեքը "
"հավասար է զրոյի կամ չի տրվել, ապա $[officename] և Excel - ում արդյունքները "
"կտարբերվեն ներմուծման ավարտից հետո: Եթե աղյուսակը արտահանեք Excel, "
"օգտագործեք Mode=1, որպեսզի տեսնեք նույն արդյունքները Excel -ում ևCalc -ում:"

#: 04060106.xhp#hd_id3145697.338.help.text
#: 04060106.xhp%23hd_id3145697.338.help.text
msgctxt "04060106.xhp#hd_id3145697.338.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3145710.339.help.text
#: 04060106.xhp%23par_id3145710.339.help.text
msgid "<item type=\"input\">=CEILING(-11;-2)</item> returns -10"
msgstr "<item type=\"input\">=CEILING(-11;-2)</item> վերադարձնում է -10"

#: 04060106.xhp#par_id3145725.340.help.text
#: 04060106.xhp%23par_id3145725.340.help.text
msgid "<item type=\"input\">=CEILING(-11;-2;0)</item> returns -10"
msgstr "<item type=\"input\">=CEILING(-11;-2;0)</item> վերադարձնում է -10"

#: 04060106.xhp#par_id3145740.341.help.text
#: 04060106.xhp%23par_id3145740.341.help.text
msgid "<item type=\"input\">=CEILING(-11;-2;1)</item> returns -12"
msgstr "<item type=\"input\">=CEILING(-11;-2;1)</item> վերադարձնում է -12"

#: 04060106.xhp#bm_id3157762.help.text
#: 04060106.xhp%23bm_id3157762.help.text
msgid "<bookmark_value>PI function</bookmark_value>"
msgstr "<bookmark_value>PI function</bookmark_value>"

#: 04060106.xhp#hd_id3157762.343.help.text
#: 04060106.xhp%23hd_id3157762.343.help.text
msgid "PI"
msgstr "PI"

#: 04060106.xhp#par_id3157790.344.help.text
#: 04060106.xhp%23par_id3157790.344.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_PI\">Returns 3.14159265358979, the value of the "
"mathematical constant PI to 14 decimal places.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_PI\">Վերադարձնում է 3.14159265358979, մաթեմատիկական PI "
"հաստատունի արժեքը 14 տասնորդական դիրքերով։</ahelp>"

#: 04060106.xhp#hd_id3157809.345.help.text
#: 04060106.xhp%23hd_id3157809.345.help.text
msgctxt "04060106.xhp#hd_id3157809.345.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3157822.346.help.text
#: 04060106.xhp%23par_id3157822.346.help.text
msgid "PI()"
msgstr "PI()"

#: 04060106.xhp#hd_id3157836.347.help.text
#: 04060106.xhp%23hd_id3157836.347.help.text
msgctxt "04060106.xhp#hd_id3157836.347.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3152370.348.help.text
#: 04060106.xhp%23par_id3152370.348.help.text
msgid "<item type=\"input\">=PI()</item> returns 3.14159265358979."
msgstr "<item type=\"input\">=PI()</item> վերադարձնում է 3.14159265358979։"

#: 04060106.xhp#bm_id3152418.help.text
#: 04060106.xhp%23bm_id3152418.help.text
msgid "<bookmark_value>MULTINOMIAL function</bookmark_value>"
msgstr "<bookmark_value>MULTINOMIAL function</bookmark_value>"

#: 04060106.xhp#hd_id3152418.635.help.text
#: 04060106.xhp%23hd_id3152418.635.help.text
msgid "MULTINOMIAL"
msgstr "MULTINOMIAL"

#: 04060106.xhp#par_id3152454.636.help.text
#: 04060106.xhp%23par_id3152454.636.help.text
msgid ""
"<ahelp hid=\"HID_AAI_FUNC_MULTINOMIAL\"> Returns the factorial of the sum of "
"the arguments divided by the product of the factorials of the "
"arguments.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_AAI_FUNC_MULTINOMIAL\"> Վերադարձնում է փաստարկների գումարի "
"ֆակտորիալը, բաժանած փաստարկների ֆակտորիալների արտադրանքի վրա:</ahelp>"

#: 04060106.xhp#hd_id3155646.637.help.text
#: 04060106.xhp%23hd_id3155646.637.help.text
msgctxt "04060106.xhp#hd_id3155646.637.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3155660.638.help.text
#: 04060106.xhp%23par_id3155660.638.help.text
msgid "MULTINOMIAL(Number(s))"
msgstr "MULTINOMIAL(Number(s))"

#: 04060106.xhp#par_id3155673.639.help.text
#: 04060106.xhp%23par_id3155673.639.help.text
msgctxt "04060106.xhp#par_id3155673.639.help.text"
msgid "<emph>Number(s)</emph> is a list of up to 30 numbers."
msgstr "<emph>Թիվ(եր)</emph> մինչև 30 թվերի ցուցակ է։"

#: 04060106.xhp#hd_id3155687.640.help.text
#: 04060106.xhp%23hd_id3155687.640.help.text
msgctxt "04060106.xhp#hd_id3155687.640.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3155701.641.help.text
#: 04060106.xhp%23par_id3155701.641.help.text
msgid ""
"<item type=\"input\">=MULTINOMIAL(F11:H11)</item> returns 1260, if F11 to "
"H11 contain the values <item type=\"input\">2</item>, <item type=\"input\""
">3</item> and <item type=\"input\">4</item>. This corresponds to the formula "
"=(2+3+4)! / (2!*3!*4!)"
msgstr ""
"<item type=\"input\">=MULTINOMIAL(F11:H11)</item> վերադարձնում է 1260, եթե "
"F11 մինչև H11 պարունակում են արժեքներ <item type=\"input\">2</item>, <item "
"type=\"input\">3</item> և <item type=\"input\">4</item>։ Սա համապատասխանում "
"է =(2+3+4)! / (2!*3!*4!) բանաձևին"

#: 04060106.xhp#bm_id3155717.help.text
#: 04060106.xhp%23bm_id3155717.help.text
msgid "<bookmark_value>POWER function</bookmark_value>"
msgstr "<bookmark_value>POWER function</bookmark_value>"

#: 04060106.xhp#hd_id3155717.350.help.text
#: 04060106.xhp%23hd_id3155717.350.help.text
msgid "POWER"
msgstr "POWER"

#: 04060106.xhp#par_id3159495.351.help.text
#: 04060106.xhp%23par_id3159495.351.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_POTENZ\">Returns a number raised to another "
"number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_POTENZ\">Վերադարձնում է թիվը աստիճան բարձրացնելու "
"արդյունքը։</ahelp>"

#: 04060106.xhp#hd_id3159513.352.help.text
#: 04060106.xhp%23hd_id3159513.352.help.text
msgctxt "04060106.xhp#hd_id3159513.352.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3159526.353.help.text
#: 04060106.xhp%23par_id3159526.353.help.text
msgid "POWER(Base; Exponent)"
msgstr "POWER(Base; Exponent)"

#: 04060106.xhp#par_id3159540.354.help.text
#: 04060106.xhp%23par_id3159540.354.help.text
msgid "Returns <emph>Base</emph> raised to the power of <emph>Exponent</emph>."
msgstr ""
"Վերադարձնում է <emph>Base</emph> բարձացված աստիճան <emph>Exponent</emph>։"

#: 04060106.xhp#par_id5081637.help.text
#: 04060106.xhp%23par_id5081637.help.text
msgid "The same result may be achieved by using the exponentiation operator ^:"
msgstr ""
"Նույն արդյունքի կարելի է հասնել, օգտագործելով աստիճան բարձրացնելու օպերատորը "
"^։"

#: 04060106.xhp#par_id9759514.help.text
#: 04060106.xhp%23par_id9759514.help.text
msgid "<item type=\"literal\">Base^Exponent</item>"
msgstr "<item type=\"literal\">Base^Exponent</item>"

#: 04060106.xhp#hd_id3159580.356.help.text
#: 04060106.xhp%23hd_id3159580.356.help.text
msgctxt "04060106.xhp#hd_id3159580.356.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3159594.357.help.text
#: 04060106.xhp%23par_id3159594.357.help.text
msgid ""
"<item type=\"input\">=POWER(4;3)</item> returns 64, which is 4 to the power "
"of 3."
msgstr ""
"<item type=\"input\">=POWER(4;3)</item> վերադարձնում է 64, այսինքն 4-ը "
"բարձացրած 3 աստիճան։"

#: 04060106.xhp#par_id1614429.help.text
#: 04060106.xhp%23par_id1614429.help.text
msgid "=4^3 also returns 4 to the power of 3."
msgstr "=4^3 ևս վերադարձնում է 4 -ը աստիճան 3։"

#: 04060106.xhp#bm_id3152651.help.text
#: 04060106.xhp%23bm_id3152651.help.text
msgid "<bookmark_value>SERIESSUM function</bookmark_value>"
msgstr "<bookmark_value>SERIESSUM function</bookmark_value>"

#: 04060106.xhp#hd_id3152651.642.help.text
#: 04060106.xhp%23hd_id3152651.642.help.text
msgid "SERIESSUM"
msgstr "SERIESSUM"

#: 04060106.xhp#par_id3152688.643.help.text
#: 04060106.xhp%23par_id3152688.643.help.text
msgid "<ahelp hid=\".\">Sums the first terms of a power series.</ahelp>"
msgstr "<ahelp hid=\".\">Աստիճանական շարքի առաջին անդամների գումարը։</ahelp>"

#: 04060106.xhp#par_id3152708.644.help.text
#: 04060106.xhp%23par_id3152708.644.help.text
msgid ""
"SERIESSUM(x;n;m;coefficients) = coefficient_1*x^n + coefficient_2*x^(n+m) + "
"coefficient_3*x^(n+2m) +...+ coefficient_i*x^(n+(i-1)m)"
msgstr ""
"SERIESSUM(x;n;m;coefficients) = coefficient_1*x^n + coefficient_2*x^(n+m) + "
"coefficient_3*x^(n+2m) +...+ coefficient_i*x^(n+(i-1)m)"

#: 04060106.xhp#hd_id3152724.645.help.text
#: 04060106.xhp%23hd_id3152724.645.help.text
msgctxt "04060106.xhp#hd_id3152724.645.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_idN11BD9.help.text
#: 04060106.xhp%23par_idN11BD9.help.text
msgid "SERIESSUM(X; N; M; Coefficients)"
msgstr "SERIESSUM(X; N; M; Coefficients)"

#: 04060106.xhp#par_id3152737.646.help.text
#: 04060106.xhp%23par_id3152737.646.help.text
msgid "<emph>X</emph> is the input value for the power series."
msgstr "<emph>X</emph> աստիճանական շարքի համար մուտքագրվող արժեքը։"

#: 04060106.xhp#par_id3144344.647.help.text
#: 04060106.xhp%23par_id3144344.647.help.text
msgid "<emph>N</emph> is the initial power"
msgstr "<emph>N</emph> սկզբնական աստիճան"

#: 04060106.xhp#par_id3144357.648.help.text
#: 04060106.xhp%23par_id3144357.648.help.text
msgid "<emph>M</emph> is the increment to increase N"
msgstr "<emph>M</emph> ավելացումն է N-ի աճի համար "

#: 04060106.xhp#par_id3144370.649.help.text
#: 04060106.xhp%23par_id3144370.649.help.text
msgid ""
"<emph>Coefficients</emph> is a series of coefficients. For each coefficient "
"the series sum is extended by one section."
msgstr ""
"<emph>Գործակիցներ</emph> գործակիցների շարք է: Յուրաքանչյուր գործակցի համար "
"շարքի գումարը ընդլայնվում է մեկ բաժնով:"

#: 04060106.xhp#bm_id3144386.help.text
#: 04060106.xhp%23bm_id3144386.help.text
msgid ""
"<bookmark_value>PRODUCT function</bookmark_value><bookmark_value>numbers;mult"
"iplying</bookmark_value><bookmark_value>multiplying;numbers</bookmark_value>"
msgstr ""
"<bookmark_value>PRODUCT function</bookmark_value><bookmark_value>numbers;mult"
"iplying</bookmark_value><bookmark_value>multiplying;numbers</bookmark_value>"

#: 04060106.xhp#hd_id3144386.361.help.text
#: 04060106.xhp%23hd_id3144386.361.help.text
msgctxt "04060106.xhp#hd_id3144386.361.help.text"
msgid "PRODUCT"
msgstr "PRODUCT"

#: 04060106.xhp#par_id3144414.362.help.text
#: 04060106.xhp%23par_id3144414.362.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_PRODUKT\">Multiplies all the numbers given as "
"arguments and returns the product.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_PRODUKT\">Բազմապատկում է բոլոր թվերը, տրված որպես "
"փաստարկներ, և վերադարձնում արտադրյալը:</ahelp>"

#: 04060106.xhp#hd_id3144433.363.help.text
#: 04060106.xhp%23hd_id3144433.363.help.text
msgctxt "04060106.xhp#hd_id3144433.363.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3144446.364.help.text
#: 04060106.xhp%23par_id3144446.364.help.text
msgid "PRODUCT(Number1; Number2; ...; Number30)"
msgstr "PRODUCT(Number1; Number2; ...; Number30)"

#: 04060106.xhp#par_id3144460.365.help.text
#: 04060106.xhp%23par_id3144460.365.help.text
msgid ""
"<emph>Number1 to 30</emph> are up to 30 arguments whose product is to be "
"calculated."
msgstr ""
"<emph>Number1 մինչև 30</emph> մինչև 30 փաստարկ, որոնց արտադրյալը պետք է "
"հաշվարկվի:"

#: 04060106.xhp#par_id1589098.help.text
#: 04060106.xhp%23par_id1589098.help.text
msgid "PRODUCT returns number1 * number2 * number3 * ..."
msgstr "PRODUCT returns number1 * number2 * number3 * ..."

#: 04060106.xhp#hd_id3144480.366.help.text
#: 04060106.xhp%23hd_id3144480.366.help.text
msgctxt "04060106.xhp#hd_id3144480.366.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3144494.367.help.text
#: 04060106.xhp%23par_id3144494.367.help.text
msgid "<item type=\"input\">=PRODUCT(2;3;4)</item> returns 24."
msgstr "<item type=\"input\">=PRODUCT(2;3;4)</item> վերադարձնում է 24։"

#: 04060106.xhp#bm_id3160340.help.text
#: 04060106.xhp%23bm_id3160340.help.text
msgid ""
"<bookmark_value>SUMSQ function</bookmark_value><bookmark_value>square number "
"additions</bookmark_value><bookmark_value>sums;of square "
"numbers</bookmark_value>"
msgstr ""
"<bookmark_value>SUMSQ function</bookmark_value><bookmark_value>square number "
"additions</bookmark_value><bookmark_value>sums;of square "
"numbers</bookmark_value>"

#: 04060106.xhp#hd_id3160340.369.help.text
#: 04060106.xhp%23hd_id3160340.369.help.text
msgid "SUMSQ"
msgstr "SUMSQ"

#: 04060106.xhp#par_id3160368.370.help.text
#: 04060106.xhp%23par_id3160368.370.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_QUADRATESUMME\">If you want to calculate the sum of "
"the squares of numbers (totaling up of the squares of the arguments), enter "
"these into the text fields.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_QUADRATESUMME\">Եթե ցանկանում եք հաշվել թվերի "
"քառակուսիների գումարը (փաստարկների քառակուսիների ընդհանուր քանակը), "
"մուտքագրեք դրանք տեքստի դաշտերում:</ahelp>"

#: 04060106.xhp#hd_id3160388.371.help.text
#: 04060106.xhp%23hd_id3160388.371.help.text
msgctxt "04060106.xhp#hd_id3160388.371.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3160402.372.help.text
#: 04060106.xhp%23par_id3160402.372.help.text
msgid "SUMSQ(Number1; Number2; ...; Number30)"
msgstr "SUMSQ(Number1; Number2; ...; Number30)"

#: 04060106.xhp#par_id3160415.373.help.text
#: 04060106.xhp%23par_id3160415.373.help.text
msgid ""
"<emph>Number1 to 30</emph> are up to 30 arguments the sum of whose squares "
"is to be calculated."
msgstr ""
"<emph>Number1 մինչև 30</emph> մինչև 30 փաստարկ է, որոնց քառակուսիների "
"գումարը պետք է հաշվարկվի:"

#: 04060106.xhp#hd_id3160436.374.help.text
#: 04060106.xhp%23hd_id3160436.374.help.text
msgctxt "04060106.xhp#hd_id3160436.374.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3160449.375.help.text
#: 04060106.xhp%23par_id3160449.375.help.text
msgid ""
"If you enter the numbers <item type=\"input\">2</item>; <item type=\"input\""
">3</item> and <item type=\"input\">4</item> in the Number 1; 2 and 3 text "
"boxes, 29 is returned as the result."
msgstr ""
"Եթե մուտքագրեք <item type=\"input\">2</item>; <item type=\"input\">3</item> "
"և <item type=\"input\">4</item> թվերը 1; 2 և 3 տեքստային վանդակներում, որպես "
"արդյունք վերադարձվում է 29։"

#: 04060106.xhp#bm_id3158247.help.text
#: 04060106.xhp%23bm_id3158247.help.text
msgid ""
"<bookmark_value>MOD function</bookmark_value><bookmark_value>remainders of "
"divisions</bookmark_value>"
msgstr ""
"<bookmark_value>MOD function</bookmark_value><bookmark_value>remainders of "
"divisions</bookmark_value>"

#: 04060106.xhp#hd_id3158247.387.help.text
#: 04060106.xhp%23hd_id3158247.387.help.text
msgid "MOD"
msgstr "MOD"

#: 04060106.xhp#par_id3158276.388.help.text
#: 04060106.xhp%23par_id3158276.388.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_REST\">Returns the remainder when one integer is "
"divided by another.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_REST\">Վերադարձնում է մնացորդը, երբ մի թիվ բաժանվում է "
"մեկ այլով:</ahelp>"

#: 04060106.xhp#hd_id3158294.389.help.text
#: 04060106.xhp%23hd_id3158294.389.help.text
msgctxt "04060106.xhp#hd_id3158294.389.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3158308.390.help.text
#: 04060106.xhp%23par_id3158308.390.help.text
msgid "MOD(Dividend; Divisor)"
msgstr "MOD(Dividend; Divisor)"

#: 04060106.xhp#par_id3158321.391.help.text
#: 04060106.xhp%23par_id3158321.391.help.text
msgid ""
" For integer arguments this function returns Dividend modulo Divisor, that "
"is the remainder when <emph>Dividend</emph> is divided by "
"<emph>Divisor</emph>."
msgstr ""
" Ամբողջ թվային փաստարկների համար, այս գործառույթը վերադարձնում է Dividend "
"modulo Divisor-ը, այն մնացորդն է, երբ <emph>Բաժանելին</emph> բաժանվում է "
"<emph>Բաժանարարի</emph>:"

#: 04060106.xhp#par_id3158341.392.help.text
#: 04060106.xhp%23par_id3158341.392.help.text
msgid ""
"This function is implemented as <item type=\"literal\">Dividend - Divisor * "
"INT(Dividend/Divisor)</item> , and this formula gives the result if the "
"arguments are not integer."
msgstr ""
"Այս գործառույթն իրականացվում է որպես <item type=\"literal\">Dividend - "
"Divisor * INT(Dividend/Divisor)</item>, և այս բանաձևը տալիս է արդյունքը, եթե "
"փաստարկները ամբողջ թվեր չեն:"

#: 04060106.xhp#hd_id3158361.393.help.text
#: 04060106.xhp%23hd_id3158361.393.help.text
msgctxt "04060106.xhp#hd_id3158361.393.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3158374.394.help.text
#: 04060106.xhp%23par_id3158374.394.help.text
msgid ""
"<item type=\"input\">=MOD(22;3)</item> returns 1, the remainder when 22 is "
"divided by 3."
msgstr ""
"<item type=\"input\">=MOD(22;3)</item> վերադարձնում է 1, մնացորդն է, երբ 22 "
"բաժանվում է 3։"

#: 04060106.xhp#par_id1278420.help.text
#: 04060106.xhp%23par_id1278420.help.text
msgid "<item type=\"input\">=MOD(11.25;2.5)</item> returns 1.25."
msgstr "<item type=\"input\">=MOD(11.25;2.5)</item> վերադարձնում է 1.25։"

#: 04060106.xhp#bm_id3144592.help.text
#: 04060106.xhp%23bm_id3144592.help.text
msgid ""
"<bookmark_value>QUOTIENT "
"function</bookmark_value><bookmark_value>divisions</bookmark_value>"
msgstr ""
"<bookmark_value>QUOTIENT "
"function</bookmark_value><bookmark_value>divisions</bookmark_value>"

#: 04060106.xhp#hd_id3144592.652.help.text
#: 04060106.xhp%23hd_id3144592.652.help.text
msgid "QUOTIENT"
msgstr "QUOTIENT"

#: 04060106.xhp#par_id3144627.653.help.text
#: 04060106.xhp%23par_id3144627.653.help.text
msgid ""
"<ahelp hid=\"HID_AAI_FUNC_QUOTIENT\">Returns the integer part of a division "
"operation.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_AAI_FUNC_QUOTIENT\">Վերադարձնում է բաժանման գործողության "
"ամբողջ մասը:</ahelp>"

#: 04060106.xhp#hd_id3144646.654.help.text
#: 04060106.xhp%23hd_id3144646.654.help.text
msgctxt "04060106.xhp#hd_id3144646.654.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3144659.655.help.text
#: 04060106.xhp%23par_id3144659.655.help.text
msgid "QUOTIENT(Numerator; Denominator)"
msgstr "QUOTIENT(Numerator; Denominator)"

#: 04060106.xhp#par_id9038972.help.text
#: 04060106.xhp%23par_id9038972.help.text
msgid ""
"Returns the integer part of <emph>Numerator</emph> divided by "
"<emph>Denominator</emph>."
msgstr ""
"Վերադարձնում է <emph>Համարիչի</emph> ամբողջ մասը, բաժանված "
"<emph>Հայտարար</emph> -ով։"

#: 04060106.xhp#par_id7985168.help.text
#: 04060106.xhp%23par_id7985168.help.text
msgid ""
"QUOTIENT is equivalent to <item type=\"literal\""
">INT(numerator/denominator)</item>, except that it may report errors with "
"different error codes."
msgstr ""
"QUOTIENT համարժեք է <item type=\"literal\">INT(numerator/denominator)</item>"
", բացի այն, որ կարող է հաղորդել տարբեր սխալի կոդերով սխալների մասին:"

#: 04060106.xhp#hd_id3144674.656.help.text
#: 04060106.xhp%23hd_id3144674.656.help.text
msgctxt "04060106.xhp#hd_id3144674.656.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3144687.657.help.text
#: 04060106.xhp%23par_id3144687.657.help.text
msgid ""
"<item type=\"input\">=QUOTIENT(11;3)</item> returns 3. The remainder of 2 is "
"lost."
msgstr ""
"<item type=\"input\">=QUOTIENT(11;3)</item> վերադարձնում է 3։ 2 մնացորդը "
"կորում է։"

#: 04060106.xhp#bm_id3144702.help.text
#: 04060106.xhp%23bm_id3144702.help.text
msgid ""
"<bookmark_value>RADIANS function</bookmark_value><bookmark_value>converting;"
"degrees, into radians</bookmark_value>"
msgstr ""
"<bookmark_value>RADIANS function</bookmark_value><bookmark_value>converting;"
"degrees, into radians</bookmark_value>"

#: 04060106.xhp#hd_id3144702.377.help.text
#: 04060106.xhp%23hd_id3144702.377.help.text
msgid "RADIANS"
msgstr "RADIANS"

#: 04060106.xhp#par_id3158025.378.help.text
#: 04060106.xhp%23par_id3158025.378.help.text
msgid "<ahelp hid=\"HID_FUNC_RAD\">Converts degrees to radians.</ahelp>"
msgstr "<ahelp hid=\"HID_FUNC_RAD\">Աստիճանները վերածում է ռադիանների:</ahelp>"

#: 04060106.xhp#hd_id3158042.379.help.text
#: 04060106.xhp%23hd_id3158042.379.help.text
msgctxt "04060106.xhp#hd_id3158042.379.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3158055.380.help.text
#: 04060106.xhp%23par_id3158055.380.help.text
msgid "RADIANS(Number)"
msgstr "RADIANS(Number)"

#: 04060106.xhp#par_id3158069.381.help.text
#: 04060106.xhp%23par_id3158069.381.help.text
msgid "<emph>Number</emph> is the angle in degrees to be converted to radians."
msgstr ""
"<emph>Թիվ</emph> անկյունն է աստիճաններով, որը պետք է վերածել ռադիանների:"

#: 04060106.xhp#hd_id876186.help.text
#: 04060106.xhp%23hd_id876186.help.text
msgctxt "04060106.xhp#hd_id876186.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3939634.help.text
#: 04060106.xhp%23par_id3939634.help.text
msgid ""
"<item type=\"input\">=RADIANS(90)</item> returns 1.5707963267949, which is "
"PI/2 to Calc's accuracy."
msgstr ""
"<item type=\"input\">=RADIANS(90)</item> վերադարձնում է 1.5707963267949, որը "
"PI/2 ըստ Calc -ի ճշտության։"

#: 04060106.xhp#bm_id3158121.help.text
#: 04060106.xhp%23bm_id3158121.help.text
msgid "<bookmark_value>ROUND function</bookmark_value>"
msgstr "<bookmark_value>ROUND function</bookmark_value>"

#: 04060106.xhp#hd_id3158121.398.help.text
#: 04060106.xhp%23hd_id3158121.398.help.text
msgid "ROUND"
msgstr "ROUND"

#: 04060106.xhp#par_id3158150.399.help.text
#: 04060106.xhp%23par_id3158150.399.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_RUNDEN\">Rounds a number to a certain number of "
"decimal places.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_RUNDEN\">Կլորացնում է թիվը ըստ տասնորդական դիրքերի "
"որոշակի քանակի:</ahelp>"

#: 04060106.xhp#hd_id3158169.400.help.text
#: 04060106.xhp%23hd_id3158169.400.help.text
msgctxt "04060106.xhp#hd_id3158169.400.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3158182.401.help.text
#: 04060106.xhp%23par_id3158182.401.help.text
msgid "ROUND(Number; Count)"
msgstr "ROUND(Number; Count)"

#: 04060106.xhp#par_id3158196.402.help.text
#: 04060106.xhp%23par_id3158196.402.help.text
msgid ""
"Returns <emph>Number</emph> rounded to <emph>Count</emph> decimal places. If "
"Count is omitted or zero, the function rounds to the nearest integer. If "
"Count is negative, the function rounds to the nearest 10, 100, 1000, etc."
msgstr ""
"Վերադարձնում է <emph>Թիվ</emph> կլորացված մինչև <emph>Հաշվել</emph> "
"տասնորդական դիրքերի։ Եթե Հաշվելը բացակայում է կամ զրո է, գործառույթը "
"կլորացվում է մոտակա ամբողջ թվին: Եթե Հաշվելը բացասական է, գործառույթը "
"կլորացվում է մոտակա 10, 100, 1000 և այլն:"

#: 04060106.xhp#par_id599688.help.text
#: 04060106.xhp%23par_id599688.help.text
msgid ""
"This function rounds to the nearest number. See ROUNDDOWN and ROUNDUP for "
"alternatives."
msgstr ""
"Այս գործառույթը կլորացնում է մինչև մոտակա թվին: Տե՛ս ROUNDDOWN -ը և ROUNDUP -"
"ը այլընտրանքների համար:"

#: 04060106.xhp#hd_id3145863.404.help.text
#: 04060106.xhp%23hd_id3145863.404.help.text
msgctxt "04060106.xhp#hd_id3145863.404.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3145876.405.help.text
#: 04060106.xhp%23par_id3145876.405.help.text
msgid "<item type=\"input\">=ROUND(2.348;2)</item> returns 2.35"
msgstr "<item type=\"input\">=ROUND(2.348;2)</item> վերադարձնում է 2.35"

#: 04060106.xhp#par_id3145899.406.help.text
#: 04060106.xhp%23par_id3145899.406.help.text
msgid ""
"<item type=\"input\">=ROUND(-32.4834;3)</item> returns -32.483. Change the "
"cell format to see all decimals."
msgstr ""
"<item type=\"input\">=ROUND(-32.4834;3)</item> վերադարձնում է -32.483։ Փոխեք "
"բջջի ձևաչափը, բոլոր տասնորդականները տեսնելու համար:"

#: 04060106.xhp#par_id1371501.help.text
#: 04060106.xhp%23par_id1371501.help.text
msgid "<item type=\"input\">=ROUND(2.348;0)</item> returns 2."
msgstr "<item type=\"input\">=ROUND(2.348;0)</item> վերադարձնում է 2։"

#: 04060106.xhp#par_id4661702.help.text
#: 04060106.xhp%23par_id4661702.help.text
msgid "<item type=\"input\">=ROUND(2.5)</item> returns 3. "
msgstr "<item type=\"input\">=ROUND(2.5)</item> վերադարձնում է 3։ "

#: 04060106.xhp#par_id7868892.help.text
#: 04060106.xhp%23par_id7868892.help.text
msgid "<item type=\"input\">=ROUND(987.65;-2)</item> returns 1000."
msgstr "<item type=\"input\">=ROUND(987.65;-2)</item> վերադարձնում է 1000։"

#: 04060106.xhp#bm_id3145991.help.text
#: 04060106.xhp%23bm_id3145991.help.text
msgid "<bookmark_value>ROUNDDOWN function</bookmark_value>"
msgstr "<bookmark_value>ROUNDDOWN function</bookmark_value>"

#: 04060106.xhp#hd_id3145991.24.help.text
#: 04060106.xhp%23hd_id3145991.24.help.text
msgid "ROUNDDOWN"
msgstr "ROUNDDOWN"

#: 04060106.xhp#par_id3146020.25.help.text
#: 04060106.xhp%23par_id3146020.25.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_ABRUNDEN\">Rounds a number down, toward zero, to a "
"certain precision.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_ABRUNDEN\">Թիվը կլորացնում է ներքև, դեպի զրո, մինչ "
"որոշակի ճշգրտության:</ahelp>"

#: 04060106.xhp#hd_id3146037.26.help.text
#: 04060106.xhp%23hd_id3146037.26.help.text
msgctxt "04060106.xhp#hd_id3146037.26.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3146051.27.help.text
#: 04060106.xhp%23par_id3146051.27.help.text
msgid "ROUNDDOWN(Number; Count)"
msgstr "ROUNDDOWN(Number; Count)"

#: 04060106.xhp#par_id3146064.28.help.text
#: 04060106.xhp%23par_id3146064.28.help.text
msgid ""
"Returns <emph>Number</emph> rounded down (towards zero) to <emph>Count</emph>"
" decimal places. If Count is omitted or zero, the function rounds down to an "
"integer. If Count is negative, the function rounds down to the next 10, 100, "
"1000, etc."
msgstr ""
"Վերադարձնում է <emph>Թիվ</emph> կլորացված մինչև <emph>Հաշվել</emph> "
"տասնորդական դիրքերի։ Եթե Հաշվելը բացակայում է կամ զրո է, գործառույթը "
"կլորացվում է մոտակա ամբողջ թվին: Եթե Հաշվելը բացասական է, գործառույթը "
"կլորացվում է մոտակա 10, 100, 1000 և այլն:"

#: 04060106.xhp#par_id2188787.help.text
#: 04060106.xhp%23par_id2188787.help.text
msgid ""
"This function rounds towards zero. See ROUNDUP and ROUND for alternatives."
msgstr ""
"Այս գործառույթը կլորացնում է դեպի զրո: Տե՛ս ROUNDUP -ը և ROUND -ը "
"այլընտրանքային տարբերակների համար:"

#: 04060106.xhp#hd_id3163164.30.help.text
#: 04060106.xhp%23hd_id3163164.30.help.text
msgctxt "04060106.xhp#hd_id3163164.30.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3163178.31.help.text
#: 04060106.xhp%23par_id3163178.31.help.text
msgid "<item type=\"input\">=ROUNDDOWN(1.234;2)</item> returns 1.23."
msgstr "<item type=\"input\">=ROUNDDOWN(1.234;2)</item> վերադարձնում է 1.23։"

#: 04060106.xhp#par_id5833307.help.text
#: 04060106.xhp%23par_id5833307.help.text
msgid "<item type=\"input\">=ROUNDDOWN(45.67;0)</item> returns 45."
msgstr "<item type=\"input\">=ROUNDDOWN(45.67;0)</item> վերադարձնում է 45։"

#: 04060106.xhp#par_id7726676.help.text
#: 04060106.xhp%23par_id7726676.help.text
msgid "<item type=\"input\">=ROUNDDOWN(-45.67)</item> returns -45."
msgstr "<item type=\"input\">=ROUNDDOWN(-45.67)</item> վերադարձնում է -45։"

#: 04060106.xhp#par_id3729361.help.text
#: 04060106.xhp%23par_id3729361.help.text
msgid "<item type=\"input\">=ROUNDDOWN(987.65;-2)</item> returns 900."
msgstr "<item type=\"input\">=ROUNDDOWN(987.65;-2)</item> վերադարձնում է 900։"

#: 04060106.xhp#bm_id3163268.help.text
#: 04060106.xhp%23bm_id3163268.help.text
msgid "<bookmark_value>ROUNDUP function</bookmark_value>"
msgstr "<bookmark_value>ROUNDUP function</bookmark_value>"

#: 04060106.xhp#hd_id3163268.140.help.text
#: 04060106.xhp%23hd_id3163268.140.help.text
msgid "ROUNDUP"
msgstr "ROUNDUP"

#: 04060106.xhp#par_id3163297.141.help.text
#: 04060106.xhp%23par_id3163297.141.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_AUFRUNDEN\">Rounds a number up, away from zero, to a "
"certain precision.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_AUFRUNDEN\">Կլորացնում է թիվը վեր, զրոյից սկսած մինչև "
"որոշակի ճշգրտություն:</ahelp>"

#: 04060106.xhp#hd_id3163315.142.help.text
#: 04060106.xhp%23hd_id3163315.142.help.text
msgctxt "04060106.xhp#hd_id3163315.142.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3163328.143.help.text
#: 04060106.xhp%23par_id3163328.143.help.text
msgid "ROUNDUP(Number; Count)"
msgstr "ROUNDUP(Number; Count)"

#: 04060106.xhp#par_id3163342.144.help.text
#: 04060106.xhp%23par_id3163342.144.help.text
msgid ""
"Returns <emph>Number</emph> rounded up (away from zero) to <emph>Count</emph>"
" decimal places. If Count is omitted or zero, the function rounds up to an "
"integer. If Count is negative, the function rounds up to the next 10, 100, "
"1000, etc."
msgstr ""
"Վերադարձնում է <emph>Թիվ</emph> կլորացվում է վեր (զրոյից հեռու) մինչև "
"<emph>Հաշվիչ</emph> տասնորդական նիշերը: Եթե Հաշվիչը բացակայում է կամ "
"զրոյական է, գործառույթը կլորացնում է ամբողջ թվով: Եթե Հաշվիչը բացասական է, "
"գործառույթը կլորացնում է մինչև հաջորդ 10, 100, 1000 և այլն:"

#: 04060106.xhp#par_id9573961.help.text
#: 04060106.xhp%23par_id9573961.help.text
msgid ""
"This function rounds away from zero. See ROUNDDOWN and ROUND for "
"alternatives."
msgstr ""
"Այս գործառույթը կլորացնում է զրոյից: Տե՛ս ROUNDDOWN -ը և ROUND -ը "
"այլընտրանքների համար:"

#: 04060106.xhp#hd_id3163381.146.help.text
#: 04060106.xhp%23hd_id3163381.146.help.text
msgctxt "04060106.xhp#hd_id3163381.146.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3144786.147.help.text
#: 04060106.xhp%23par_id3144786.147.help.text
msgid "<item type=\"input\">=ROUNDUP(1.1111;2)</item> returns 1.12."
msgstr "<item type=\"input\">=ROUNDUP(1.1111;2)</item> վերադարձնում է 1.12։"

#: 04060106.xhp#par_id7700430.help.text
#: 04060106.xhp%23par_id7700430.help.text
msgid "<item type=\"input\">=ROUNDUP(1.2345;1)</item> returns 1.3."
msgstr "<item type=\"input\">=ROUNDUP(1.2345;1)</item> վերադարձնում է 1.3։"

#: 04060106.xhp#par_id1180455.help.text
#: 04060106.xhp%23par_id1180455.help.text
msgid "<item type=\"input\">=ROUNDUP(45.67;0)</item> returns 46."
msgstr "<item type=\"input\">=ROUNDUP(45.67;0)</item> վերադարձնում է 46։"

#: 04060106.xhp#par_id3405560.help.text
#: 04060106.xhp%23par_id3405560.help.text
msgid "<item type=\"input\">=ROUNDUP(-45.67)</item> returns -46."
msgstr "<item type=\"input\">=ROUNDUP(-45.67)</item> վերադարձնում է -46։"

#: 04060106.xhp#par_id3409527.help.text
#: 04060106.xhp%23par_id3409527.help.text
msgid "<item type=\"input\">=ROUNDUP(987.65;-2)</item> returns 1000."
msgstr "<item type=\"input\">=ROUNDUP(987.65;-2)</item> վերադարձնում է 1000։"

#: 04060106.xhp#bm_id3144877.help.text
#: 04060106.xhp%23bm_id3144877.help.text
msgid "<bookmark_value>SIN function</bookmark_value>"
msgstr "<bookmark_value>SIN function</bookmark_value>"

#: 04060106.xhp#hd_id3144877.408.help.text
#: 04060106.xhp%23hd_id3144877.408.help.text
msgid "SIN"
msgstr "SIN"

#: 04060106.xhp#par_id3144906.409.help.text
#: 04060106.xhp%23par_id3144906.409.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_SIN\">Returns the sine of the given angle (in "
"radians).</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_SIN\">Վերադարձնում է տրված անկյանը սինուսը "
"(ռադիաններով)։</ahelp>"

#: 04060106.xhp#hd_id3144923.410.help.text
#: 04060106.xhp%23hd_id3144923.410.help.text
msgctxt "04060106.xhp#hd_id3144923.410.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3144937.411.help.text
#: 04060106.xhp%23par_id3144937.411.help.text
msgid "SIN(Number)"
msgstr "SIN(Number)"

#: 04060106.xhp#par_id3144950.412.help.text
#: 04060106.xhp%23par_id3144950.412.help.text
msgid ""
"Returns the (trigonometric) sine of <emph>Number</emph>, the angle in "
"radians."
msgstr ""
"Վերադարձնում է (եռանկյունաչափական) սինուսը <emph>Թիվ</emph>, անկյունը "
"ռադիաններով է։"

#: 04060106.xhp#par_id8079470.help.text
#: 04060106.xhp%23par_id8079470.help.text
msgid "To return the sine of an angle in degrees, use the RADIANS function."
msgstr ""
"Անկյունի սինուսը աստիճաններով վերադարձնելու համար օգտագործեք RADIANS "
"գործառույթը:"

#: 04060106.xhp#hd_id3144969.413.help.text
#: 04060106.xhp%23hd_id3144969.413.help.text
msgctxt "04060106.xhp#hd_id3144969.413.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3144983.414.help.text
#: 04060106.xhp%23par_id3144983.414.help.text
msgid ""
"<item type=\"input\">=SIN(PI()/2)</item> returns 1, the sine of PI/2 radians."
msgstr ""
"<item type=\"input\">=SIN(PI()/2)</item> վերադարձնում է 1, PI/2 սինուսը "
"ռադիաններով։"

#: 04060106.xhp#par_id3916440.help.text
#: 04060106.xhp%23par_id3916440.help.text
msgid ""
"<item type=\"input\">=SIN(RADIANS(30))</item> returns 0.5, the sine of 30 "
"degrees."
msgstr ""
"<item type=\"input\">=SIN(RADIANS(30))</item> վերադարձնում է 0.5, 30 "
"աստիճանի սինուսը։"

#: 04060106.xhp#bm_id3163397.help.text
#: 04060106.xhp%23bm_id3163397.help.text
msgid "<bookmark_value>SINH function</bookmark_value>"
msgstr "<bookmark_value>SINH function</bookmark_value>"

#: 04060106.xhp#hd_id3163397.418.help.text
#: 04060106.xhp%23hd_id3163397.418.help.text
msgid "SINH"
msgstr "SINH"

#: 04060106.xhp#par_id3163426.419.help.text
#: 04060106.xhp%23par_id3163426.419.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_SINHYP\">Returns the hyperbolic sine of a "
"number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_SINHYP\">Վերադարձնում է թվի հիպերբոլիկ սինուսը։</ahelp>"

#: 04060106.xhp#hd_id3163444.420.help.text
#: 04060106.xhp%23hd_id3163444.420.help.text
msgctxt "04060106.xhp#hd_id3163444.420.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3163457.421.help.text
#: 04060106.xhp%23par_id3163457.421.help.text
msgid "SINH(Number)"
msgstr "SINH(Number)"

#: 04060106.xhp#par_id3163471.422.help.text
#: 04060106.xhp%23par_id3163471.422.help.text
msgid "Returns the hyperbolic sine of <emph>Number</emph>."
msgstr "Վերադարձնում է <emph>Թվի</emph> հիպերբոլիկ սինուսը։"

#: 04060106.xhp#hd_id3163491.423.help.text
#: 04060106.xhp%23hd_id3163491.423.help.text
msgctxt "04060106.xhp#hd_id3163491.423.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3163504.424.help.text
#: 04060106.xhp%23par_id3163504.424.help.text
msgid ""
"<item type=\"input\">=SINH(0)</item> returns 0, the hyperbolic sine of 0."
msgstr ""
"<item type=\"input\">=SINH(0)</item> վերադարձնում է 0, որը 0 -ի հիպերբոլիկ "
"սինուսն է։"

#: 04060106.xhp#bm_id3163596.help.text
#: 04060106.xhp%23bm_id3163596.help.text
msgid ""
"<bookmark_value>SUM function</bookmark_value><bookmark_value>adding;numbers "
"in cell ranges</bookmark_value>"
msgstr ""
"<bookmark_value>SUM function</bookmark_value><bookmark_value>ավելացում;թվեր "
"բջջային տիրույթներում</bookmark_value>"

#: 04060106.xhp#hd_id3163596.428.help.text
#: 04060106.xhp%23hd_id3163596.428.help.text
msgctxt "04060106.xhp#hd_id3163596.428.help.text"
msgid "SUM"
msgstr "SUM"

#: 04060106.xhp#par_id3163625.429.help.text
#: 04060106.xhp%23par_id3163625.429.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_SUMME\">Adds all the numbers in a range of "
"cells.</ahelp>"
msgstr "<ahelp hid=\"HID_FUNC_SUMME\">Բջջային տիրույթի թվերի գումարում։</ahelp>"

#: 04060106.xhp#hd_id3163643.430.help.text
#: 04060106.xhp%23hd_id3163643.430.help.text
msgctxt "04060106.xhp#hd_id3163643.430.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3163656.431.help.text
#: 04060106.xhp%23par_id3163656.431.help.text
msgid "SUM(Number1; Number2; ...; Number30)"
msgstr "SUM(Number1; Number2; ...; Number30)"

#: 04060106.xhp#par_id3163671.432.help.text
#: 04060106.xhp%23par_id3163671.432.help.text
msgid ""
"<emph>Number 1 to Number 30</emph> are up to 30 arguments whose sum is to be "
"calculated."
msgstr ""
"<emph>Թիվ 1 մինչև Թիվ 30</emph> մինչև 30 փաստարկներ են, որոնց գումարը պետք է "
"հաշվարկվի:"

#: 04060106.xhp#hd_id3163690.433.help.text
#: 04060106.xhp%23hd_id3163690.433.help.text
msgctxt "04060106.xhp#hd_id3163690.433.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3163704.434.help.text
#: 04060106.xhp%23par_id3163704.434.help.text
msgid ""
"If you enter the numbers <item type=\"input\">2</item>; <item type=\"input\">"
"3 </item>and <item type=\"input\">4</item> in the Number 1; 2 and 3 text "
"boxes, 9 will be returned as the result."
msgstr ""
"IԵթե մուտքագրում եք <item type=\"input\">2</item>; <item type=\"input\">3 "
"</item>և <item type=\"input\">4</item> թվերը, Թիվ 1; 2 և 3 տեքստային "
"վանդակներում, որպես արդյունք կվերադարձվի 9 -ը։"

#: 04060106.xhp#par_id3151740.556.help.text
#: 04060106.xhp%23par_id3151740.556.help.text
msgid ""
"<item type=\"input\">=SUM(A1;A3;B5)</item> calculates the sum of the three "
"cells. <item type=\"input\">=SUM (A1:E10)</item> calculates the sum of all "
"cells in the A1 to E10 cell range."
msgstr ""
"<item type=\"input\">=SUM(A1;A3;B5)</item> հաշվում է երեք բջիջների գումարը։ <"
"item type=\"input\">=SUM (A1:E10)</item> հաշվում է բոլոր բջիջների գումարը A1 "
"մինչև E10 բջիջների տիրույթից։"

#: 04060106.xhp#par_id3151756.619.help.text
#: 04060106.xhp%23par_id3151756.619.help.text
msgid ""
"Conditions linked by AND can be used with the function SUM() in the "
"following manner:"
msgstr ""
"AND -ի հետ կապված պայմանները կարող են օգտագործվել SUM() գործառույթի հետ "
"հետևյալ կերպ."

#: 04060106.xhp#par_id3151774.620.help.text
#: 04060106.xhp%23par_id3151774.620.help.text
msgid ""
"Example assumption: You have entered invoices into a table. Column A "
"contains the date value of the invoice, column B the amounts. You want to "
"find a formula that you can use to return the total of all amounts only for "
"a specific month, e.g. only the amount for the period >=2008-01-01 to "
"<2008-02-01. The range with the date values covers A1:A40, the range "
"containing the amounts to be totaled is B1:B40. C1 contains the start date, "
"2008<item type=\"input\">-01-01</item>, of the invoices to be included and "
"C2 the date, 2008<item type=\"input\">-02-01</item>, that is no longer "
"included."
msgstr ""
"Ենթադրության օրինակ։ Դուք աղյուսակում հաշիվ-ապրանքագրեր եք մուտքագրել: A "
"սյունակը պարունակում է հաշիվ-ապրանքագրի ամսաթիվը, B սյունակը` գումարները: "
"Դուք ցանկանում եք գտնել մի բանաձև, որը կարող եք օգտագործել, վերադարձնելու "
"բոլոր գումարների ընդհանուր քանակը միայն որոշակի ամսվա համար, օրինակ, միայն "
"գումարը >=2008-01-01 մինչև <2008-02-01 ժամանակահատվածի համար: Ամսաթիվի "
"արժեքներով միջակայքը ընդգրկում է A1:A40 -ը, ընդ որում, գումարման ընդհանուր "
"տիրույթն է B1:B40 : C1 -ը պարունակում է մեկնարկի ամսաթիվը՝ 2008<item type=\""
"input\">-01-01</item>, ներառված հաշիվ-ապրանքագրերը և C2 -ը՝ ամսաթիվը 2008<"
"item type=\"input\">-02-01</item>, այն այլևս ներառված չէ:"

#: 04060106.xhp#par_id3151799.621.help.text
#: 04060106.xhp%23par_id3151799.621.help.text
msgid "Enter the following formula as an array formula:"
msgstr "Մուտքագրեք հետևյալը որպես զանգվածի բանաձև."

#: 04060106.xhp#par_id3151813.622.help.text
#: 04060106.xhp%23par_id3151813.622.help.text
msgid "<item type=\"input\">=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)</item>"
msgstr "<item type=\"input\">=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)</item>"

#: 04060106.xhp#par_id3151828.623.help.text
msgid ""
"In order to enter this as an array formula, you must press the Shift<"
"switchinline select=\"sys\"><caseinline select=\"MAC\""
">+Command</caseinline><defaultinline>+ Ctrl</defaultinline></switchinline>+ "
"Enter keys instead of simply pressing the Enter key to close the formula. "
"The formula will then be shown in the <emph>Formula</emph> bar enclosed in "
"braces."
msgstr ""
"Որպեսզի սա որպես զանգվածի բանաձև մուտքագրվի, պետք է սեղմել Shift<"
"switchinline select=\"sys\"><caseinline select=\"MAC\""
">+Command</caseinline><defaultinline>+ Ctrl</defaultinline></switchinline>+ "
"Enter ստեղները, պարզապես Enter ստեղնը սեղմելու փոխարեն՝ բանաձևը փակելու "
"համար: Ապա բանաձևը կցուցադրվի փակագծերում կցված <emph>Բանաձև</emph> "
"վահանակում, շրջապատված փակագծերով։"

#: 04060106.xhp#par_id3151869.624.help.text
#: 04060106.xhp%23par_id3151869.624.help.text
msgid "{=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)}"
msgstr "{=SUM((A1:A40>=C1)*(A1:A40<C2)*B1:B40)}"

#: 04060106.xhp#par_id3151884.625.help.text
#: 04060106.xhp%23par_id3151884.625.help.text
msgid ""
"The formula is based on the fact that the result of a comparison is 1 if the "
"criterion is met and 0 if it is not met. The individual comparison results "
"will be treated as an array and used in matrix multiplication, and at the "
"end the individual values will be totaled to give the result matrix."
msgstr ""
"Բանաձևը հիմնված է այն փաստի վրա, որ համեմատության արդյունքը 1 է, եթե "
"չափանիշը բավարարված է և 0 է՝ եթե այն չի բավարարվել: Անհատական համեմատության "
"արդյունքները կվերաբերվեն որպես զանգված և կօգտագործվեն մատրիցների "
"բազմապատկման մեջ, և վերջում անհատական արժեքները կգումարվեն, արդյունարար "
"մատրիցան ստանալու համար:"

#: 04060106.xhp#bm_id3151957.help.text
#: 04060106.xhp%23bm_id3151957.help.text
msgid ""
"<bookmark_value>SUMIF function</bookmark_value><bookmark_value>adding;"
"specified numbers</bookmark_value>"
msgstr ""
"<bookmark_value>SUMIF function</bookmark_value><bookmark_value>ավելացում;"
"նշված թվերը</bookmark_value>"

#: 04060106.xhp#hd_id3151957.436.help.text
#: 04060106.xhp%23hd_id3151957.436.help.text
msgid "SUMIF"
msgstr "SUMIF"

#: 04060106.xhp#par_id3151986.437.help.text
#: 04060106.xhp%23par_id3151986.437.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_SUMMEWENN\">Adds the cells specified by a given "
"criteria.</ahelp> This function is used to browse a range when you search "
"for a certain value."
msgstr ""
"<ahelp hid=\"HID_FUNC_SUMMEWENN\">Ավելացնում է տվյալ չափանիշներով նշված "
"բջիջները:</ahelp> Այս գործառույթն օգտագործվում է, տիրույթում շարժվելիս, երբ "
"որոշակի արժեք եք որոնում։"

#: 04060106.xhp#hd_id3152015.438.help.text
#: 04060106.xhp%23hd_id3152015.438.help.text
msgctxt "04060106.xhp#hd_id3152015.438.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3152028.439.help.text
#: 04060106.xhp%23par_id3152028.439.help.text
msgid "SUMIF(Range; Criteria; SumRange)"
msgstr "SUMIF(Range; Criteria; SumRange)"

#: 04060106.xhp#par_id3152043.440.help.text
#: 04060106.xhp%23par_id3152043.440.help.text
msgctxt "04060106.xhp#par_id3152043.440.help.text"
msgid ""
"<emph>Range</emph> is the range to which the criteria are to be applied."
msgstr ""
"<emph>Տիրույթ</emph> այն միջակայքն է, որի վրա պետք է կիրառվեն չափանիշները:"

#: 04060106.xhp#par_id3152062.441.help.text
#: 04060106.xhp%23par_id3152062.441.help.text
msgid ""
"<emph>Criteria</emph> is the cell in which the search criterion is shown, or "
"the search criterion itself. If the criteria is written into the formula, it "
"has to be surrounded by double quotes."
msgstr ""
"<emph>Չափանիշ</emph> այն բջիջն է, որում ցուցադրվում է որոնման չափանիշը կամ "
"հենց որոնման չափանիշը: Եթե չափանիշը գրված է բանաձևի մեջ, ապա այն պետք է "
"շրջապատված լինի կրկնակի չակերտով:"

#: 04060106.xhp#par_id3152083.442.help.text
#: 04060106.xhp%23par_id3152083.442.help.text
msgid ""
"<emph>SumRange</emph> is the range from which values are summed. If this "
"parameter has not been indicated, the values found in the Range are summed."
msgstr ""
"<emph>SumRange</emph> այն միջակայքն է, որից գումարվում են արժեքները: Եթե այս "
"պարամետրը նշված չէ, Միջակայքում հայտնաբերված արժեքները գումարվում են:"

#: 04060106.xhp#par_id8347422.help.text
#: 04060106.xhp%23par_id8347422.help.text
msgid ""
"SUMIF supports the reference concatenation operator (~) only in the Criteria "
"parameter, and only if the optional SumRange parameter is not given."
msgstr ""
"SUMIF աջակցում է հղման համաձայնագրման օպերատորին (~) միայն Չափանիշների "
"պարամետրում և միայն այն դեպքում, եթե կամընտրական SumRange պարամետրը տրված չէ:"

#: 04060106.xhp#hd_id3152110.443.help.text
#: 04060106.xhp%23hd_id3152110.443.help.text
msgctxt "04060106.xhp#hd_id3152110.443.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3152148.626.help.text
#: 04060106.xhp%23par_id3152148.626.help.text
msgid ""
"To sum up only negative numbers: <item type=\"input\">=SUMIF(A1:A10;\"<0\""
")</item>"
msgstr ""
"Միայն բացասական թվերի գումարման համար: <item type=\"input\">=SUMIF(A1:A10;\"<"
"0\")</item>"

#: 04060106.xhp#par_id6670125.help.text
#: 04060106.xhp%23par_id6670125.help.text
msgid ""
"<item type=\"input\">=SUMIF(A1:A10;\">0\";B1:10)</item> - sums values from "
"the range B1:B10 only if the corresponding values in the range A1:A10 are >0."
msgstr ""
"<item type=\"input\">=SUMIF(A1:A10;\">0\";B1:10)</item> - գումարում է B1:B10 "
"միջակայքի արժեքները, միայն եթե A1:A10 միջակայքի համապատասխանող արժեքները >0։"

#: 04060106.xhp#par_id6062196.help.text
#: 04060106.xhp%23par_id6062196.help.text
msgid ""
"See COUNTIF() for some more syntax examples that can be used with SUMIF()."
msgstr ""
"Տես COUNTIF() ևս մի քանի շարահյուսական օրինակների համար, որոնք կարող են "
"օգտագործվել SUMIF () -ի հետ:"

#: 04060106.xhp#bm_id3151957K.help.text
#: 04060106.xhp%23bm_id3151957K.help.text
msgid ""
"<bookmark_value>SUMIFS function</bookmark_value><bookmark_value>adding;"
"specified numbers</bookmark_value>"
msgstr ""
"<bookmark_value>SUMIFS function</bookmark_value><bookmark_value>ավելացնել;"
"նշված թվերը</bookmark_value>"

#: 04060106.xhp#hd_id3151957K.436.help.text
#: 04060106.xhp%23hd_id3151957K.436.help.text
msgid "SUMIFS"
msgstr "SUMIFS"

#: 04060106.xhp#par_id3151986K.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_SUMMEWNRNG\">Sum the values of cells in a range that "
"meet multiple criteria in multiple ranges.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_SUMMEWNRNG\">Գումարեք բջիջների արժեքները մի "
"տիրույթում, որը բավարարում են բազմաթիվ չափանիշների բազմաթիվ "
"տիրույթներում:</ahelp>"

#: 04060106.xhp#hd_id3152015K.help.text
#: 04060106.xhp%23hd_id3152015K.help.text
msgctxt "04060106.xhp#hd_id3152015K.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3152028K.help.text
#: 04060106.xhp%23par_id3152028K.help.text
msgid ""
"SUMIFS( Reference R ; Reference R1 ; Criterion C1 [ ; Reference R2 ; "
"Criterion C2 ]... )"
msgstr ""
"SUMIFS( Reference R ; Reference R1 ; Criterion C1 [ ; Reference R2 ; "
"Criterion C2 ]... )"

#: 04060106.xhp#par_id3152043K.help.text
#: 04060106.xhp%23par_id3152043K.help.text
msgid ""
"Sums the value of cells in range R that meet the Criterion C1 in the "
"reference range R1, and the Criterion C2 in the reference range R2, and so "
"on. "
msgstr ""
"Հավաքում է R տիրույթում գտնվող բջիջների արժեքը, որոնք համապատասխանում են "
"չափանիշ C1- ին` R1 հղման տիրույթում, իսկ Չափանիշ C2-ին` R2 հղման տիրույթում "
"և այլն:"

#: 04060106.xhp#par_id3152062K.help.text
#: 04060106.xhp%23par_id3152062K.help.text
msgid ""
"A <emph>Criterion</emph> is a single cell Reference, Number or Text. If the "
"criterion is written into the formula, it has to be surrounded by double "
"quotes."
msgstr ""
"<emph>Չափանիշը</emph> մեկ բջջի Հղում, Թիվ կամ Տեքստ է։ Եթե չափանիշը գրվում է "
"բանաձևում, ապա այն պետք է շրջապատված լինի կրկնակի չակերտներով:"

#: 04060106.xhp#par_id3152083K.help.text
#: 04060106.xhp%23par_id3152083K.help.text
msgid ""
"All <emph>Reference</emph> ranges shall have the same dimension and size, "
"else an Error is returned."
msgstr ""
"Բոլոր <emph>Հղումներ</emph> միջակայքերը պետք է ունենան նույն "
"չափողականությունը և չափը, հակառակ դեպքում վերադարձվում է Սխալ:"

#: 04060106.xhp#hd_id3152110K.443.help.text
#: 04060106.xhp%23hd_id3152110K.443.help.text
msgctxt "04060106.xhp#hd_id3152110K.443.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3152148K.help.text
msgid ""
"Sum up cells in range A1:10 if the entries in B1:B10 are positive, and the "
"entries in D1:D10 are the letter \"A\": <item type=\"input\""
">=SUMIFS(A1:A10;B1:B10;\">0\";D1:D10;\"A\")</item>"
msgstr ""
"Գումարեք A1:A10 տիրույթում գտնվող բջիջները, եթե B1:B10 -ի մուտքերը դրական "
"են, իսկ D1:D10 -ի մուտքերը \"A\" տառն է. <item type=\"input\""
">=SUMIFS(A1:A10;B1:B10;\">0\";D1:D10;\"A\")</item>"

#: 04060106.xhp#par_id6062196K.help.text
#: 04060106.xhp%23par_id6062196K.help.text
msgid ""
"See COUNTIFS() for some more syntax examples that can be used with SUMIFS()."
msgstr ""
"Տես COUNTIFS() մի քանի այլ շարահյուսական օրինակների համար, որոնք կարող են "
"օգտագործվել SUMIFS() հետ։"

#: 04060106.xhp#bm_id3152195.help.text
#: 04060106.xhp%23bm_id3152195.help.text
msgid "<bookmark_value>TAN function</bookmark_value>"
msgstr "<bookmark_value>TAN function</bookmark_value>"

#: 04060106.xhp#hd_id3152195.446.help.text
#: 04060106.xhp%23hd_id3152195.446.help.text
msgid "TAN"
msgstr "TAN"

#: 04060106.xhp#par_id3152224.447.help.text
#: 04060106.xhp%23par_id3152224.447.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_TAN\">Returns the tangent of the given angle (in "
"radians).</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_TAN\">Վերադարձնում է տրված անկյան տանգեսը "
"(ռադիաններով):</ahelp>"

#: 04060106.xhp#hd_id3152242.448.help.text
#: 04060106.xhp%23hd_id3152242.448.help.text
msgctxt "04060106.xhp#hd_id3152242.448.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3152255.449.help.text
#: 04060106.xhp%23par_id3152255.449.help.text
msgid "TAN(Number)"
msgstr "TAN(Number)"

#: 04060106.xhp#par_id3152269.450.help.text
#: 04060106.xhp%23par_id3152269.450.help.text
msgid ""
"Returns the (trigonometric) tangent of <emph>Number</emph>, the angle in "
"radians."
msgstr ""
"Վերադարձնում է (եռանկյունաչափական) տանգեսը <emph>Թվի</emph>, անկյունը "
"ռադիաններով է։"

#: 04060106.xhp#par_id5752128.help.text
#: 04060106.xhp%23par_id5752128.help.text
msgid "To return the tangent of an angle in degrees, use the RADIANS function."
msgstr ""
"Անկյան տանգեսը ռադիաններով վերադարձնելու համար, օգտագործեք RADIANS "
"գործառույթը։"

#: 04060106.xhp#hd_id3152287.451.help.text
#: 04060106.xhp%23hd_id3152287.451.help.text
msgctxt "04060106.xhp#hd_id3152287.451.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3152301.452.help.text
#: 04060106.xhp%23par_id3152301.452.help.text
msgid ""
"<item type=\"input\">=TAN(PI()/4) </item>returns 1, the tangent of PI/4 "
"radians."
msgstr ""
"<item type=\"input\">=TAN(PI()/4) </item>վերադարձնում է 1, PI/4 տանգեսը "
"ռադիաններով։"

#: 04060106.xhp#par_id1804864.help.text
#: 04060106.xhp%23par_id1804864.help.text
msgid ""
"<item type=\"input\">=TAN(RADIANS(45))</item> returns 1, the tangent of 45 "
"degrees."
msgstr ""
"<item type=\"input\">=TAN(RADIANS(45))</item> վերադարձնում է 1, 45 աստիճանի "
"տանգեսը։"

#: 04060106.xhp#bm_id3165434.help.text
