msgstr ""
"<ahelp hid=\"HID_FUNC_KKLEINSTE\">Վերադարձնում է Rank_c -ի նվազագույն արժեքը "
"տվյալների բազմությունում։</ahelp>"

#: 04060183.xhp#hd_id3154957.13.help.text
#: 04060183.xhp%23hd_id3154957.13.help.text
msgctxt "04060183.xhp#hd_id3154957.13.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060183.xhp#par_id3153974.14.help.text
#: 04060183.xhp%23par_id3153974.14.help.text
msgid "SMALL(Data; RankC)"
msgstr "SMALL(Data; RankC)"

#: 04060183.xhp#par_id3154540.15.help.text
#: 04060183.xhp%23par_id3154540.15.help.text
msgctxt "04060183.xhp#par_id3154540.15.help.text"
msgid "<emph>Data</emph> is the cell range of data."
msgstr "<emph>Տվյալներ</emph> տվյալների բջջային տիրույթն է:"

#: 04060183.xhp#par_id3155094.16.help.text
#: 04060183.xhp%23par_id3155094.16.help.text
msgid "<emph>RankC</emph> is the rank of the value."
msgstr "<emph>RankC</emph> արժեքի դասակարգումն է:"

#: 04060183.xhp#hd_id3153247.17.help.text
#: 04060183.xhp%23hd_id3153247.17.help.text
msgctxt "04060183.xhp#hd_id3153247.17.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060183.xhp#par_id3149897.18.help.text
#: 04060183.xhp%23par_id3149897.18.help.text
msgid ""
"<item type=\"input\">=SMALL(A1:C50;2)</item> gives the second smallest value "
"in A1:C50."
msgstr ""
"<item type=\"input\">=SMALL(A1:C50;2)</item> տալիս է երկրորդ նվազագույն "
"արժեքը A1:C50 -ում։"

#: 04060183.xhp#bm_id3153559.help.text
#: 04060183.xhp%23bm_id3153559.help.text
msgid "<bookmark_value>CONFIDENCE function</bookmark_value>"
msgstr "<bookmark_value>CONFIDENCE function</bookmark_value>"

#: 04060183.xhp#hd_id3153559.20.help.text
#: 04060183.xhp%23hd_id3153559.20.help.text
msgid "CONFIDENCE"
msgstr "CONFIDENCE"

#: 04060183.xhp#par_id3153814.21.help.text
#: 04060183.xhp%23par_id3153814.21.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_KONFIDENZ\">Returns the (1-alpha) confidence interval "
"for a normal distribution.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_KONFIDENZ\">Վերադարձնում է (1-alpha) վստահության "
"միջակայքը նորմալ բաշխման համար:</ahelp>"

#: 04060183.xhp#hd_id3149315.22.help.text
#: 04060183.xhp%23hd_id3149315.22.help.text
msgctxt "04060183.xhp#hd_id3149315.22.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060183.xhp#par_id3147501.23.help.text
#: 04060183.xhp%23par_id3147501.23.help.text
msgid "CONFIDENCE(Alpha; StDev; Size)"
msgstr "CONFIDENCE(Alpha; StDev; Size)"

#: 04060183.xhp#par_id3149872.24.help.text
#: 04060183.xhp%23par_id3149872.24.help.text
msgid "<emph>Alpha</emph> is the level of the confidence interval."
msgstr "<emph>Alpha</emph> վստահության միջակայքի մակարդակն է:"

#: 04060183.xhp#par_id3145324.25.help.text
#: 04060183.xhp%23par_id3145324.25.help.text
msgid "<emph>StDev</emph> is the standard deviation for the total population."
msgstr "<emph>StDev</emph> ընդհանուր պոպուլիացյիայի համար ստանդարտ շեղումն է:"

#: 04060183.xhp#par_id3153075.26.help.text
#: 04060183.xhp%23par_id3153075.26.help.text
msgid "<emph>Size</emph> is the size of the total population."
msgstr "<emph>Չափ</emph> ընդհանուր պոպուլիացիայի չափն է։"

#: 04060183.xhp#hd_id3150435.27.help.text
#: 04060183.xhp%23hd_id3150435.27.help.text
msgctxt "04060183.xhp#hd_id3150435.27.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060183.xhp#par_id3153335.28.help.text
#: 04060183.xhp%23par_id3153335.28.help.text
msgid "<item type=\"input\">=CONFIDENCE(0.05;1.5;100)</item> gives 0.29."
msgstr "<item type=\"input\">=CONFIDENCE(0.05;1.5;100)</item> տալիս է 0.29։"

#: 04060183.xhp#bm_id3148746.help.text
#: 04060183.xhp%23bm_id3148746.help.text
msgid ""
"<bookmark_value>CORREL function</bookmark_value><bookmark_value>coefficient "
"of correlation</bookmark_value>"
msgstr ""
"<bookmark_value>CORREL function</bookmark_value><bookmark_value>"
"հարաբերակցության գործակիցն է</bookmark_value>"

#: 04060183.xhp#hd_id3148746.30.help.text
#: 04060183.xhp%23hd_id3148746.30.help.text
msgid "CORREL"
msgstr "CORREL"

#: 04060183.xhp#par_id3147299.31.help.text
#: 04060183.xhp%23par_id3147299.31.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_KORREL\">Returns the correlation coefficient between "
"two data sets.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_KORREL\">Վերադարձնում է հարաբերակցության գործակիցը "
"տվյալների երկու բազմությունների միջև:</ahelp>"

#: 04060183.xhp#hd_id3156397.32.help.text
#: 04060183.xhp%23hd_id3156397.32.help.text
msgctxt "04060183.xhp#hd_id3156397.32.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060183.xhp#par_id3153023.33.help.text
#: 04060183.xhp%23par_id3153023.33.help.text
msgid "CORREL(Data1; Data2)"
msgstr "CORREL(Data1; Data2)"

#: 04060183.xhp#par_id3150036.34.help.text
#: 04060183.xhp%23par_id3150036.34.help.text
msgctxt "04060183.xhp#par_id3150036.34.help.text"
msgid "<emph>Data1</emph> is the first data set."
msgstr "<emph>Data1</emph> տվյալների առաջին բազմությունն է։"

#: 04060183.xhp#par_id3153021.35.help.text
#: 04060183.xhp%23par_id3153021.35.help.text
msgctxt "04060183.xhp#par_id3153021.35.help.text"
msgid "<emph>Data2</emph> is the second data set."
msgstr "<emph>Data2</emph> տվյալների երկրորդ բազմությունն է։"

#: 04060183.xhp#hd_id3149720.36.help.text
#: 04060183.xhp%23hd_id3149720.36.help.text
msgctxt "04060183.xhp#hd_id3149720.36.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060183.xhp#par_id3149941.37.help.text
#: 04060183.xhp%23par_id3149941.37.help.text
msgid ""
"<item type=\"input\">=CORREL(A1:A50;B1:B50)</item> calculates the "
"correlation coefficient as a measure of the linear correlation of the two "
"data sets."
msgstr ""
"<item type=\"input\">=CORREL(A1:A50;B1:B50)</item> հաշվում է "
"հարաբերակցության գործակիցը, որպես տվյալների երկու հավաքածուի գծային "
"հարաբերակցության չափ:"

#: 04060183.xhp#bm_id3150652.help.text
#: 04060183.xhp%23bm_id3150652.help.text
msgid "<bookmark_value>COVAR function</bookmark_value>"
msgstr "<bookmark_value>COVAR function</bookmark_value>"

#: 04060183.xhp#hd_id3150652.39.help.text
#: 04060183.xhp%23hd_id3150652.39.help.text
msgid "COVAR"
msgstr "COVAR"

#: 04060183.xhp#par_id3146875.40.help.text
#: 04060183.xhp%23par_id3146875.40.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_KOVAR\">Returns the covariance of the product of "
"paired deviations.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_KOVAR\">Վերադարձնում է զույգված շեղումների արդյունքի "
"կովարիանսը:</ahelp>"

#: 04060183.xhp#hd_id3149013.41.help.text
#: 04060183.xhp%23hd_id3149013.41.help.text
msgctxt "04060183.xhp#hd_id3149013.41.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060183.xhp#par_id3150740.42.help.text
#: 04060183.xhp%23par_id3150740.42.help.text
msgid "COVAR(Data1; Data2)"
msgstr "COVAR(Data1; Data2)"

#: 04060183.xhp#par_id3145827.43.help.text
#: 04060183.xhp%23par_id3145827.43.help.text
msgctxt "04060183.xhp#par_id3145827.43.help.text"
msgid "<emph>Data1</emph> is the first data set."
msgstr "<emph>Data1</emph> տվյալների առաջին բազմությունն է։"

#: 04060183.xhp#par_id3150465.44.help.text
#: 04060183.xhp%23par_id3150465.44.help.text
msgctxt "04060183.xhp#par_id3150465.44.help.text"
msgid "<emph>Data2</emph> is the second data set."
msgstr "<emph>Data2</emph> տվյալների երկրորդ բազմությունն է։"

#: 04060183.xhp#hd_id3154677.45.help.text
#: 04060183.xhp%23hd_id3154677.45.help.text
msgctxt "04060183.xhp#hd_id3154677.45.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060183.xhp#par_id3144748.46.help.text
#: 04060183.xhp%23par_id3144748.46.help.text
msgid "<item type=\"input\">=COVAR(A1:A30;B1:B30)</item>"
msgstr "<item type=\"input\">=COVAR(A1:A30;B1:B30)</item>"

#: 04060183.xhp#bm_id3147472.help.text
#: 04060183.xhp%23bm_id3147472.help.text
msgid "<bookmark_value>CRITBINOM function</bookmark_value>"
msgstr "<bookmark_value>CRITBINOM function</bookmark_value>"

#: 04060183.xhp#hd_id3147472.48.help.text
#: 04060183.xhp%23hd_id3147472.48.help.text
msgid "CRITBINOM"
msgstr "CRITBINOM"

#: 04060183.xhp#par_id3149254.49.help.text
#: 04060183.xhp%23par_id3149254.49.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_KRITBINOM\">Returns the smallest value for which the "
"cumulative binomial distribution is less than or equal to a criterion "
"value.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_KRITBINOM\">Վերադարձնում է ամենափոքր արժեքը, որի համար "
"կուտակային բինոմալ բաշխումը փոքր կամ հավասար է չափորոշիչային արժեքին:</ahelp>"

#: 04060183.xhp#hd_id3153930.50.help.text
#: 04060183.xhp%23hd_id3153930.50.help.text
msgctxt "04060183.xhp#hd_id3153930.50.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060183.xhp#par_id3148586.51.help.text
#: 04060183.xhp%23par_id3148586.51.help.text
msgid "CRITBINOM(Trials; SP; Alpha)"
msgstr "CRITBINOM(Trials; SP; Alpha)"

#: 04060183.xhp#par_id3145593.52.help.text
#: 04060183.xhp%23par_id3145593.52.help.text
msgid "<emph>Trials</emph> is the total number of trials."
msgstr "<emph>Փորձեր</emph> փորձերի ընդհանուր քանակն է:"

#: 04060183.xhp#par_id3153084.53.help.text
#: 04060183.xhp%23par_id3153084.53.help.text
msgid "<emph>SP</emph> is the probability of success for one trial."
msgstr "<emph>SP</emph> մեկ փորձի հաջողության հավանականությունն է:"

#: 04060183.xhp#par_id3149726.54.help.text
#: 04060183.xhp%23par_id3149726.54.help.text
msgid ""
"<emph>Alpha</emph> is the threshold probability to be reached or exceeded."
msgstr ""
"<emph>Alpha</emph> սահմանային հավանականությունն է, որին պետք է հասնել կամ "
"գերազանցել:"

#: 04060183.xhp#hd_id3148752.55.help.text
#: 04060183.xhp%23hd_id3148752.55.help.text
msgctxt "04060183.xhp#hd_id3148752.55.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060183.xhp#par_id3148740.56.help.text
#: 04060183.xhp%23par_id3148740.56.help.text
msgid "<item type=\"input\">=CRITBINOM(100;0.5;0.1)</item> yields 44."
msgstr "<item type=\"input\">=CRITBINOM(100;0.5;0.1)</item> yields 44."

#: 04060183.xhp#bm_id3155956.help.text
#: 04060183.xhp%23bm_id3155956.help.text
msgid "<bookmark_value>KURT function</bookmark_value>"
msgstr "<bookmark_value>KURT function</bookmark_value>"

#: 04060183.xhp#hd_id3155956.58.help.text
#: 04060183.xhp%23hd_id3155956.58.help.text
msgid "KURT"
msgstr "KURT"

#: 04060183.xhp#par_id3153108.59.help.text
#: 04060183.xhp%23par_id3153108.59.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_KURT\">Returns the kurtosis of a data set (at least 4 "
"values required).</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_KURT\">Վերադարձնում է տվյալների բազմության էքսցեսը ("
"պահանջվում է առնվազն 4 արժեք):</ahelp>"

#: 04060183.xhp#hd_id3150334.60.help.text
#: 04060183.xhp%23hd_id3150334.60.help.text
msgctxt "04060183.xhp#hd_id3150334.60.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060183.xhp#par_id3154508.61.help.text
#: 04060183.xhp%23par_id3154508.61.help.text
msgid "KURT(Number1; Number2; ...Number30)"
msgstr "KURT(Number1; Number2; ...Number30)"

#: 04060183.xhp#par_id3145167.62.help.text
#: 04060183.xhp%23par_id3145167.62.help.text
msgid ""
"<emph>Number1,Number2,...Number30</emph> are numeric arguments or ranges "
"representing a random sample of distribution."
msgstr ""
"<emph>Number1,Number2,...Number30</emph> թվային փաստարկներ կամ միջակայքեր "
"են, որոնք ներկայացնում են բաշխման պատահական նմուշ."

#: 04060183.xhp#hd_id3158000.63.help.text
#: 04060183.xhp%23hd_id3158000.63.help.text
