"<bookmark_value>numbers;determining ranks</bookmark_value>"
msgstr ""
"<bookmark_value>RANK function</bookmark_value>         "
"<bookmark_value>numbers;determining ranks</bookmark_value>"

#: 04060185.xhp#hd_id3155071.2.help.text
#: 04060185.xhp%23hd_id3155071.2.help.text
msgid "RANK"
msgstr "RANK"

#: 04060185.xhp#par_id3153976.3.help.text
#: 04060185.xhp%23par_id3153976.3.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_RANG\">Returns the rank of a number in a "
"sample.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_RANG\">Վերադարձնում է նմուշի մեջ թվերի քաշերը:</ahelp>"

#: 04060185.xhp#hd_id3159206.4.help.text
#: 04060185.xhp%23hd_id3159206.4.help.text
msgctxt "04060185.xhp#hd_id3159206.4.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060185.xhp#par_id3153250.5.help.text
#: 04060185.xhp%23par_id3153250.5.help.text
msgid "RANK(Value; Data; Type)"
msgstr "RANK(Value; Data; Type)"

#: 04060185.xhp#par_id3154543.6.help.text
#: 04060185.xhp%23par_id3154543.6.help.text
msgid ""
"            <emph>Value</emph> is the value, whose rank is to be determined."
msgstr "            <emph>Արժեք</emph> այն արժեքն է, որի քաշը պետք է որոշվի:"

#: 04060185.xhp#par_id3149130.7.help.text
#: 04060185.xhp%23par_id3149130.7.help.text
msgctxt "04060185.xhp#par_id3149130.7.help.text"
msgid ""
"            <emph>Data</emph> is the array or range of data in the sample."
msgstr ""
"            <emph>Տվյալներ</emph> նմուշում ներկայացված տվյալների զանգվածը "
"կամ շրջանակն է:"

#: 04060185.xhp#par_id3150215.8.help.text
#: 04060185.xhp%23par_id3150215.8.help.text
msgid "            <emph>Type</emph> (optional) is the sequence order."
msgstr "            <emph>Տեսակ</emph> (կամընտրական) հաջորդականության կարգն է։"

#: 04060185.xhp#par_id9305398.help.text
#: 04060185.xhp%23par_id9305398.help.text
msgid ""
"Type = 0 means descending from the last item of the array to the first (this "
"is the default), "
msgstr ""
"Տեսակը = 0 նշանակում է, որ զանգվածի վերջին կետից առաջինը ըստ նվազման է (սա "
"լռելյայն է)։"

#: 04060185.xhp#par_id9996948.help.text
#: 04060185.xhp%23par_id9996948.help.text
msgid "Type = 1 means ascending from the first item of the range to the last."
msgstr "Տեսակը = 1 նշանակում է, որ միջակայքի առաջին կետից վերջինը ըստ աճման է։"

#: 04060185.xhp#hd_id3143223.9.help.text
#: 04060185.xhp%23hd_id3143223.9.help.text
msgctxt "04060185.xhp#hd_id3143223.9.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060185.xhp#par_id3155919.10.help.text
#: 04060185.xhp%23par_id3155919.10.help.text
msgid ""
"            <item type=\"input\">=RANK(A10;A1:A50)</item> returns the "
"ranking of the value in A10 in value range A1:A50. If <item type=\"literal\""
">Value</item> does not exist within the range an error message is displayed."
msgstr ""
"            <item type=\"input\">=RANK(A10;A1:A50)</item> վերադարձնում է A10 "
"-ի արժեքի քաշը A1:A50 տիրույթում։ Եթե <item type=\"literal\">Արժեքը</item> "
"միջակայքում գոյություն չունի, սխալի մասին հաղորդագրություն է արտածվում:"

#: 04060185.xhp#bm_id3153556.help.text
#: 04060185.xhp%23bm_id3153556.help.text
msgid "<bookmark_value>SKEW function</bookmark_value>"
msgstr "<bookmark_value>SKEW function</bookmark_value>"

#: 04060185.xhp#hd_id3153556.12.help.text
#: 04060185.xhp%23hd_id3153556.12.help.text
msgid "SKEW"
msgstr "SKEW"

#: 04060185.xhp#par_id3153485.13.help.text
#: 04060185.xhp%23par_id3153485.13.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_SCHIEFE\">Returns the skewness of a "
"distribution.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_SCHIEFE\">Վերադարձնում է բաշխման խոտորումը:</ahelp>"

#: 04060185.xhp#hd_id3154733.14.help.text
#: 04060185.xhp%23hd_id3154733.14.help.text
msgctxt "04060185.xhp#hd_id3154733.14.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060185.xhp#par_id3151191.15.help.text
#: 04060185.xhp%23par_id3151191.15.help.text
msgid "SKEW(Number1; Number2; ...Number30)"
msgstr "SKEW(Number1; Number2; ...Number30)"

#: 04060185.xhp#par_id3155757.16.help.text
#: 04060185.xhp%23par_id3155757.16.help.text
msgid ""
"            <emph>Number1, Number2...Number30</emph> are numerical values or "
"ranges."
msgstr ""
"            <emph>Number1, Number2...Number30</emph> թվային արժեքներ կամ "
"միջակայքեր են։"

#: 04060185.xhp#hd_id3153297.17.help.text
#: 04060185.xhp%23hd_id3153297.17.help.text
msgctxt "04060185.xhp#hd_id3153297.17.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060185.xhp#par_id3145118.18.help.text
#: 04060185.xhp%23par_id3145118.18.help.text
msgid ""
"            <item type=\"input\">=SKEW(A1:A50)</item> calculates the value "
"of skew for the data referenced."
msgstr ""
"            <item type=\"input\">=SKEW(A1:A50)</item> հաշվում է մատնանշված "
"տվյալների համար խոտորման արժեքը:"

#: 04060185.xhp#bm_id3149051.help.text
#: 04060185.xhp%23bm_id3149051.help.text
msgid ""
"<bookmark_value>regression lines;FORECAST function</bookmark_value>         "
"<bookmark_value>extrapolations</bookmark_value>         <bookmark_value>"
"FORECAST function</bookmark_value>"
msgstr ""
"<bookmark_value>regression lines;FORECAST function</bookmark_value>         "
"<bookmark_value>extrapolations</bookmark_value>         <bookmark_value>"
"FORECAST function</bookmark_value>"

#: 04060185.xhp#hd_id3149051.20.help.text
#: 04060185.xhp%23hd_id3149051.20.help.text
msgid "FORECAST"
msgstr "FORECAST"

#: 04060185.xhp#par_id3153290.21.help.text
#: 04060185.xhp%23par_id3153290.21.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_SCHAETZER\">Extrapolates future values based on "
"existing x and y values.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_SCHAETZER\">Ապագա արժեքները է էքստրապոլյացիա է անում "
"հիմնված առկա x և y արժեքների վրա:</ahelp>"

#: 04060185.xhp#hd_id3151343.22.help.text
#: 04060185.xhp%23hd_id3151343.22.help.text
msgctxt "04060185.xhp#hd_id3151343.22.help.text"
msgid "Syntax"
msgstr "Շարահյուսությու"

#: 04060185.xhp#par_id3147404.23.help.text
#: 04060185.xhp%23par_id3147404.23.help.text
msgid "FORECAST(Value; DataY; DataX)"
msgstr "FORECAST(Value; DataY; DataX)"

#: 04060185.xhp#par_id3148743.24.help.text
#: 04060185.xhp%23par_id3148743.24.help.text
msgid ""
"            <emph>Value</emph> is the x value, for which the y value on the "
"linear regression is to be returned."
msgstr ""
"            <emph>Արժեք</emph> x արժեքն է, որի համար վերադարձվում է y արժեքի "
"գծային ռեգրեսիան։"

#: 04060185.xhp#par_id3146325.25.help.text
#: 04060185.xhp%23par_id3146325.25.help.text
msgid "            <emph>DataY</emph> is the array or range of known y's."
msgstr "            <emph>DataY</emph> հայտնի y-երի զանգված կամ միջակայք։"

#: 04060185.xhp#par_id3150536.26.help.text
#: 04060185.xhp%23par_id3150536.26.help.text
msgid "            <emph>DataX</emph> is the array or range of known x's."
msgstr "            <emph>DataX</emph> հայտնի x-երի զանգված կամ միջակայք։"

#: 04060185.xhp#hd_id3147416.27.help.text
#: 04060185.xhp%23hd_id3147416.27.help.text
msgctxt "04060185.xhp#hd_id3147416.27.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060185.xhp#par_id3157874.28.help.text
#: 04060185.xhp%23par_id3157874.28.help.text
msgid ""
"            <item type=\"input\">=FORECAST(50;A1:A50;B1;B50)</item> returns "
"the Y value expected for the X value of 50 if the X and Y values in both "
"references are linked by a linear trend."
msgstr ""
"            <item type=\"input\">=FORECAST(50;A1:A50;B1;B50)</item> X- ի "
"սպասվող 50 արժեքի համար վերադարձնում է Y արժեքը , եթե երկու հղումներում X և "
"Y արժեքները կապված են գծային տենդենցով:"

#: 04060185.xhp#bm_id3149143.help.text
#: 04060185.xhp%23bm_id3149143.help.text
msgid ""
"<bookmark_value>STDEV function</bookmark_value>         <bookmark_value>"
"standard deviations in statistics;based on a sample</bookmark_value>"
msgstr ""
"<bookmark_value>STDEV function</bookmark_value>         <bookmark_value>"
"standard deviations in statistics;based on a sample</bookmark_value>"

#: 04060185.xhp#hd_id3149143.30.help.text
#: 04060185.xhp%23hd_id3149143.30.help.text
msgctxt "04060185.xhp#hd_id3149143.30.help.text"
msgid "STDEV"
msgstr "STDEV"

#: 04060185.xhp#par_id3146888.31.help.text
#: 04060185.xhp%23par_id3146888.31.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_STABW\">Estimates the standard deviation based on a "
"sample.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_STABW\">Գնահատում է նմուշի հիման վրա ստանդարտ "
"շեղումը:</ahelp>"

#: 04060185.xhp#hd_id3146815.32.help.text
#: 04060185.xhp%23hd_id3146815.32.help.text
msgctxt "04060185.xhp#hd_id3146815.32.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060185.xhp#par_id3149946.33.help.text
#: 04060185.xhp%23par_id3149946.33.help.text
msgid "STDEV(Number1; Number2; ...Number30)"
msgstr "STDEV(Number1; Number2; ...Number30)"

#: 04060185.xhp#par_id3157904.34.help.text
#: 04060185.xhp%23par_id3157904.34.help.text
msgid ""
"            <emph>Number1, Number2, ... Number30</emph> are numerical values "
"or ranges representing a sample based on an entire population."
msgstr ""
"            <emph>Number1, Number2, ... Number30</emph> թվային արժեքներ կամ "
"շարքեր են, որոնք ներկայացնում են նմուշը, հիմնված ողջ ընտրանքի վրա:"

