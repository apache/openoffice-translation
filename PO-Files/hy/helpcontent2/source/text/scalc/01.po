msgstr "Օրինակ"

#: 04060184.xhp#par_id3151187.90.help.text
#: 04060184.xhp%23par_id3151187.90.help.text
msgid ""
"<item type=\"input\">=PEARSON(A1:A30;B1:B30)</item> returns the Pearson "
"correlation coefficient of both data sets."
msgstr ""
"<item type=\"input\">=PEARSON(A1:A30;B1:B30)</item> վերադարձնում է Pearson-ի "
"հարաբերակցության գործակիցը երկու տվյալների հավաքածուների միջև:"

