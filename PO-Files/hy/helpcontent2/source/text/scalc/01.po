msgstr "Ընտրություն"

#: 02160000.xhp#par_id3150751.4.help.text
#: 02160000.xhp%23par_id3150751.4.help.text
msgid ""
"This area contains options for specifying how sheets are displayed after "
"deleting cells."
msgstr ""
"Այս տարածքը պարունակում է ընտրանքներ, նշելու, թե ինչպես են ցուցադրվում "
