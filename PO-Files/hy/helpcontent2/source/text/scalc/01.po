#: 04070100.xhp#hd_id3153966.23.help.text
#: 04070100.xhp%23hd_id3153966.23.help.text
msgid "Repeat row"
msgstr "Կրկնեք տողը"

#: 04070100.xhp#par_id3150300.24.help.text
#: 04070100.xhp%23par_id3150300.24.help.text
