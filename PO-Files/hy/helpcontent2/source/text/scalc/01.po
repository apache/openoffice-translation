msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_SPEC_FILTER:BTN_CASE\">Տարբերում է "
"մեծատառ և փոքրատառ տառերը, տվյալների զտման ժամանակ:</ahelp>"

#: 12040201.xhp#hd_id3154908.7.help.text
#: 12040201.xhp%23hd_id3154908.7.help.text
