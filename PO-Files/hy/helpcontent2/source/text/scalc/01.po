msgstr "2008-ի ո՞ր մասն է ընկած 2008-01-01 և 2008-07-01-ի միջև:"

#: func_yearfrac.xhp#par_id3154632.212.help.text
#: func_yearfrac.xhp%23par_id3154632.212.help.text
msgid "=YEARFRAC(\"2008-01-01\"; \"2008-07-01\";0) returns 0.50."
msgstr "=YEARFRAC(\"2008-01-01\"; \"2008-07-01\";0) վերադարձնում է 0.50։"

