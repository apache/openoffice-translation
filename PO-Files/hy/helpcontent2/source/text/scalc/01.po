msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060185.xhp#par_id3150521.121.help.text
#: 04060185.xhp%23par_id3150521.121.help.text
msgid "TDIST(Number; DegreesFreedom; Mode)"
msgstr "TDIST(Number; DegreesFreedom; Mode)"

#: 04060185.xhp#par_id3146991.122.help.text
#: 04060185.xhp%23par_id3146991.122.help.text
msgid ""
"            <emph>Number</emph> is the value for which the t-distribution is "
"calculated."
msgstr ""
"            <emph>Number</emph> արժեքն է, որի համար հաշվարկվում է t-բաշխումը։"

#: 04060185.xhp#par_id3148824.123.help.text
#: 04060185.xhp%23par_id3148824.123.help.text
msgctxt "04060185.xhp#par_id3148824.123.help.text"
msgid ""
"            <emph>DegreesFreedom</emph> is the number of degrees of freedom "
"for the t-distribution."
msgstr ""
"            <emph>DegreesFreedom</emph> t-բաշխման համար ազատության "
"աստիճանների քանակն է։"

#: 04060185.xhp#par_id3149340.124.help.text
#: 04060185.xhp%23par_id3149340.124.help.text
msgid ""
"            <emph>Mode</emph> = 1 returns the one-tailed test, "
"<emph>Mode</emph> = 2 returns the two-tailed test."
msgstr ""
"            <emph>Mode</emph> = 1 վերադարձնում է մեկանգամյա թեստը, "
"<emph>Mode</emph> = 2 վերադարձնում է երկկողմանի թեստը:"

#: 04060185.xhp#hd_id3159150.125.help.text
#: 04060185.xhp%23hd_id3159150.125.help.text
msgctxt "04060185.xhp#hd_id3159150.125.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060185.xhp#par_id3149773.126.help.text
#: 04060185.xhp%23par_id3149773.126.help.text
msgid "            <item type=\"input\">=TDIST(12;5;1)</item>         "
msgstr "            <item type=\"input\">=TDIST(12;5;1)</item>         "

#: 04060185.xhp#bm_id3153828.help.text
