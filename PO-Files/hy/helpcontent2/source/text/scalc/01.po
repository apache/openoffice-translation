msgid "Format Cells"
msgstr "Ձևավորեք բջիջները"

#: 05020000.xhp#par_id3150448.2.help.text
#: 05020000.xhp%23par_id3150448.2.help.text
msgid ""
"<variable id=\"zellattributetext\"><ahelp hid=\".uno:FormatCellDialog\">"
"Allows you to specify a variety of formatting options and to apply "
"attributes to the selected cells.</ahelp></variable>"
msgstr ""
"<variable id=\"zellattributetext\"><ahelp hid=\".uno:FormatCellDialog\">"
"Թույլ է տալիս նշել ձևաչափման ընտրանքների տարբերակներ և կիրառել հատկանիշներ "
"ընտրված բջիջների վրա:</ahelp></variable>"

#: 05020000.xhp#hd_id3145785.3.help.text
#: 05020000.xhp%23hd_id3145785.3.help.text
msgid ""
"<link href=\"text/shared/01/05020300.xhp\" name=\"Numbers\">Numbers</link>"
