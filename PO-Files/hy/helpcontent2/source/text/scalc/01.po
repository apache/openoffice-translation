#: 04060184.xhp%23par_id3156108.96.help.text
msgid ""
"<emph>Number</emph> represents the value based on which the standard normal "
"distribution is calculated."
msgstr ""
"<emph>Թիվ</emph> ներկայացնում է այն արժեքը, որի հիման վրա հաշվարկվում է "
"ստանդարտ նորմալ բաշխումը:"

#: 04060184.xhp#hd_id3153621.97.help.text
#: 04060184.xhp%23hd_id3153621.97.help.text
msgctxt "04060184.xhp#hd_id3153621.97.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060184.xhp#par_id3155849.98.help.text
#: 04060184.xhp%23par_id3155849.98.help.text
msgid "<item type=\"input\">=PHI(2.25) </item>= 0.03"
msgstr "<item type=\"input\">=PHI(2.25) </item>= 0.03"

#: 04060184.xhp#par_id3143236.99.help.text
#: 04060184.xhp%23par_id3143236.99.help.text
msgid "<item type=\"input\">=PHI(-2.25)</item> = 0.03"
msgstr "<item type=\"input\">=PHI(-2.25)</item> = 0.03"

#: 04060184.xhp#par_id3149286.100.help.text
#: 04060184.xhp%23par_id3149286.100.help.text
msgid "<item type=\"input\">=PHI(0)</item> = 0.4"
msgstr "<item type=\"input\">=PHI(0)</item> = 0.4"

#: 04060184.xhp#bm_id3153985.help.text
#: 04060184.xhp%23bm_id3153985.help.text
msgid "<bookmark_value>POISSON function</bookmark_value>"
msgstr "<bookmark_value>POISSON function</bookmark_value>"

#: 04060184.xhp#hd_id3153985.102.help.text
#: 04060184.xhp%23hd_id3153985.102.help.text
msgid "POISSON"
msgstr "POISSON"

#: 04060184.xhp#par_id3154298.103.help.text
#: 04060184.xhp%23par_id3154298.103.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_POISSON\">Returns the Poisson distribution.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_POISSON\">Վերադարձնում է Պուասոնի բաշխումը։</ahelp>"

#: 04060184.xhp#hd_id3159183.104.help.text
#: 04060184.xhp%23hd_id3159183.104.help.text
msgctxt "04060184.xhp#hd_id3159183.104.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060184.xhp#par_id3146093.105.help.text
#: 04060184.xhp%23par_id3146093.105.help.text
msgid "POISSON(Number; Mean; C)"
msgstr "POISSON(Number; Mean; C)"

#: 04060184.xhp#par_id3147253.106.help.text
#: 04060184.xhp%23par_id3147253.106.help.text
msgid ""
"<emph>Number</emph> represents the value based on which the Poisson "
"distribution is calculated."
msgstr ""
"<emph>Թիվ</emph> ներկայացնում է այն արժեքը, որի հիման վրա հաշվարկվում է "
"Պուասոնի բաշխումը:"

#: 04060184.xhp#par_id3151177.107.help.text
#: 04060184.xhp%23par_id3151177.107.help.text
msgid ""
"<emph>Mean</emph> represents the middle value of the Poisson distribution."
msgstr "<emph>Միջին</emph> ներկայացնում է Պուասոնի բաշխման միջին արժեքը:"

#: 04060184.xhp#par_id3149200.108.help.text
#: 04060184.xhp%23par_id3149200.108.help.text
msgid ""
"<emph>C</emph> (optional) = 0 or False calculates the density function; "
"<emph>C</emph> = 1 or True calculates the distribution. When omitted, the "
"default value True is inserted when you save the document, for best "
"compatibility with other programs and older versions of %PRODUCTNAME."
msgstr ""
"<emph>C</emph> (ընտրովի) = 0 կամ False հաշվում է խտության գործառույթը; "
"<emph>C</emph> = 1 կամ True հաշվարկում է բաշխումը: Երբ բացակայում է, "
"փաստաթուղթը պահելու ժամանակ ճշգրիտ ստանդարտ արժեքը տեղադրվում է այլ ծրագրերի "
"և %PRODUCTNAME ավելի հին տարբերակների հետ լավագույնս համատեղելիության համար: "
"."

#: 04060184.xhp#hd_id3159347.109.help.text
#: 04060184.xhp%23hd_id3159347.109.help.text
msgctxt "04060184.xhp#hd_id3159347.109.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060184.xhp#par_id3150113.110.help.text
#: 04060184.xhp%23par_id3150113.110.help.text
msgid "<item type=\"input\">=POISSON(60;50;1)</item> returns 0.93."
msgstr "<item type=\"input\">=POISSON(60;50;1)</item> վերադարձնում է 0.93։"

#: 04060184.xhp#bm_id3153100.help.text
#: 04060184.xhp%23bm_id3153100.help.text
msgid "<bookmark_value>PERCENTILE function</bookmark_value>"
msgstr "<bookmark_value>PERCENTILE function</bookmark_value>"

#: 04060184.xhp#hd_id3153100.112.help.text
#: 04060184.xhp%23hd_id3153100.112.help.text
msgid "PERCENTILE"
msgstr "PERCENTILE"

#: 04060184.xhp#par_id3154940.113.help.text
#: 04060184.xhp%23par_id3154940.113.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_QUANTIL\">Returns the alpha-percentile of data values "
"in an array.</ahelp> A percentile returns the scale value for a data series "
"which goes from the smallest (Alpha=0) to the largest value (alpha=1) of a "
"data series. For <item type=\"literal\">Alpha</item> = 25%, the percentile "
"means the first quartile; <item type=\"literal\">Alpha</item> = 50% is the "
"MEDIAN."
msgstr ""
"<ahelp hid=\"HID_FUNC_QUANTIL\">Վերադարձնում է զանգվածի տվյալների արժեքների "
"ալֆա-տոկոսային մասը:</ahelp> Մի հարյուրամյակը վերադարձնում է տվյալների շարքի "
"մասշտաբի արժեքը, որը անցնում է տվյալների շարքի ամենափոքրից (Alpha=0) դեպի "
"ամենամեծ արժեքը Alpha=1): <item type=\"literal\">Alpha</item> = 25% համար, "
"հարյուրամյակը նշանակում է առաջին քառյակ; <item type=\"literal\">Alpha</item> "
"= 50% ՄԻՋԻՆՆ է։"

#: 04060184.xhp#hd_id3150531.114.help.text
#: 04060184.xhp%23hd_id3150531.114.help.text
msgctxt "04060184.xhp#hd_id3150531.114.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060184.xhp#par_id3148813.115.help.text
#: 04060184.xhp%23par_id3148813.115.help.text
msgid "PERCENTILE(Data; Alpha)"
msgstr "PERCENTILE(Data; Alpha)"

#: 04060184.xhp#par_id3153054.116.help.text
#: 04060184.xhp%23par_id3153054.116.help.text
msgid "<emph>Data</emph> represents the array of data."
msgstr "<emph>Data</emph> ներկայացնում է տվյալների զանգված:"

#: 04060184.xhp#par_id3154212.117.help.text
#: 04060184.xhp%23par_id3154212.117.help.text
msgid ""
"<emph>Alpha</emph> represents the percentage of the scale between 0 and 1."
msgstr "<emph>Alpha</emph> ներկայացնում է սանդղակի տոկոսը 0-ից 1-ի միջև:"

#: 04060184.xhp#hd_id3154290.118.help.text
#: 04060184.xhp%23hd_id3154290.118.help.text
msgctxt "04060184.xhp#hd_id3154290.118.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060184.xhp#par_id3159147.119.help.text
#: 04060184.xhp%23par_id3159147.119.help.text
msgid ""
"<item type=\"input\">=PERCENTILE(A1:A50;0.1)</item> represents the value in "
"the data set, which equals 10% of the total data scale in A1:A50."
msgstr ""
"<item type=\"input\">=PERCENTILE(A1:A50;0.1)</item> ներկայացնում է արժեքը "
"տվյալների շարքում, որը հավասար է A1:A50 տվյալների ընդհանուր մասշտաբի 10% -ին:"

#: 04060184.xhp#bm_id3148807.help.text
#: 04060184.xhp%23bm_id3148807.help.text
msgid "<bookmark_value>PERCENTRANK function</bookmark_value>"
msgstr "<bookmark_value>PERCENTRANK function</bookmark_value>"

#: 04060184.xhp#hd_id3148807.121.help.text
#: 04060184.xhp%23hd_id3148807.121.help.text
msgid "PERCENTRANK"
msgstr "PERCENTRANK"

#: 04060184.xhp#par_id3153573.122.help.text
#: 04060184.xhp%23par_id3153573.122.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_QUANTILSRANG\">Returns the percentage rank of a value "
"in a sample.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_QUANTILSRANG\">Վերադարձնում է նմուշի մեջ արժեքի "
"տոկոսային աստիճանը:</ahelp>"

#: 04060184.xhp#hd_id3147512.123.help.text
#: 04060184.xhp%23hd_id3147512.123.help.text
msgctxt "04060184.xhp#hd_id3147512.123.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060184.xhp#par_id3147238.124.help.text
#: 04060184.xhp%23par_id3147238.124.help.text
msgid "PERCENTRANK(Data; Value)"
msgstr "PERCENTRANK(Data; Value)"

#: 04060184.xhp#par_id3154266.125.help.text
#: 04060184.xhp%23par_id3154266.125.help.text
msgctxt "04060184.xhp#par_id3154266.125.help.text"
msgid "<emph>Data</emph> represents the array of data in the sample."
msgstr "<emph>Data</emph> ներկայացնում է նմուշում տվյալների զանգվածը:"

#: 04060184.xhp#par_id3148475.126.help.text
#: 04060184.xhp%23par_id3148475.126.help.text
msgid ""
"<emph>Value</emph> represents the value whose percentile rank must be "
"determined."
msgstr ""
"<emph>Value</emph> ներկայացնում է այն արժեքը, որի տոկոսային աստիճանը պետք է "
"որոշվի:"

#: 04060184.xhp#hd_id3155364.127.help.text
#: 04060184.xhp%23hd_id3155364.127.help.text
msgctxt "04060184.xhp#hd_id3155364.127.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060184.xhp#par_id3149163.128.help.text
#: 04060184.xhp%23par_id3149163.128.help.text
msgid ""
"<item type=\"input\">=PERCENTRANK(A1:A50;50)</item> returns the percentage "
"rank of the value 50 from the total range of all values found in A1:A50. If "
"50 falls outside the total range, an error message will appear."
msgstr ""
"<item type=\"input\">=PERCENTRANK(A1:A50;50)</item> վերադարձնում է 50-ի "
"տոկոսային աստիճանը A1:A50-ում հայտնաբերված բոլոր արժեքների ընդհանուր շարքից: "
"Եթե 50-ը ընկնում է ընդհանուր տիրույթից դուրս, ապա կհայտնվի սխալի "
"հաղորդագրություն:"

#: 04060184.xhp#bm_id3166442.help.text
