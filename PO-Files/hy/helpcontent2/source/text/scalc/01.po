msgstr "<bookmark_value>IMPOWER function</bookmark_value>"

#: 04060116.xhp#hd_id3146106.58.help.text
#: 04060116.xhp%23hd_id3146106.58.help.text
msgid "IMPOWER"
msgstr "IMPOWER"

#: 04060116.xhp#par_id3147245.59.help.text
#: 04060116.xhp%23par_id3147245.59.help.text
msgid ""
"<ahelp hid=\"HID_AAI_FUNC_IMPOWER\">The result is the integer power of a "
"complex number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_AAI_FUNC_IMPOWER\">Արդյունքը բարդ թիվը ամբողջ աստիճան "
"բարձրացնելն է:</ahelp>"

#: 04060116.xhp#hd_id3150954.60.help.text
#: 04060116.xhp%23hd_id3150954.60.help.text
msgctxt "04060116.xhp#hd_id3150954.60.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060116.xhp#par_id3147501.61.help.text
#: 04060116.xhp%23par_id3147501.61.help.text
msgid "IMPOWER(\"ComplexNumber\"; Number)"
msgstr "IMPOWER(\"ComplexNumber\"; Number)"

#: 04060116.xhp#par_id3155743.63.help.text
#: 04060116.xhp%23par_id3155743.63.help.text
msgid "            <emph>Number</emph> is the exponent."
msgstr "            <emph>Թիվ</emph> էքսպոնենտ է։"

#: 04060116.xhp#hd_id3149048.64.help.text
#: 04060116.xhp%23hd_id3149048.64.help.text
msgctxt "04060116.xhp#hd_id3149048.64.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060116.xhp#par_id3151393.65.help.text
#: 04060116.xhp%23par_id3151393.65.help.text
msgid ""
"            <item type=\"input\">=IMPOWER(\"2+3i\";2)</item> returns -5+12i."
msgstr ""
"            <item type=\"input\">=IMPOWER(\"2+3i\";2)</item> վերադարձնում է "
"-5+12i։"

#: 04060116.xhp#bm_id3148748.help.text
