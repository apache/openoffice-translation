#: 04060119.xhp%23par_id3156324.176.help.text
msgctxt "04060119.xhp#par_id3156324.176.help.text"
msgid "The following mortgage loan is taken out on a house:"
msgstr "Հետևյալ հիփոթեքային վարկը վերցվում է մի տան համար."

#: 04060119.xhp#par_id3147566.177.help.text
#: 04060119.xhp%23par_id3147566.177.help.text
msgid ""
"Rate: 9.00 per cent per annum (9% / 12 = 0.0075), Duration: 30 years (NPER = "
