msgid "            <emph>Alpha</emph> is a parameter to the distribution."
msgstr "            <emph>Alpha</emph> բաշխման պարամետր է:"

#: 04060181.xhp#par_id3156306.58.help.text
#: 04060181.xhp%23par_id3156306.58.help.text
