"<ahelp hid=\"HID_FUNC_VARIATION\">Calculates the points of an exponential "
"trend in an array.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_VARIATION\">Հաշվում է զանգվածում էքսպոնենցիալ միտման "
"կետերը:</ahelp>"

