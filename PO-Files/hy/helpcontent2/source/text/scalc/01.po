#: 04060107.xhp%23hd_id3151348.39.help.text
msgid "MINVERSE"
msgstr "MINVERSE"

#: 04060107.xhp#par_id3145569.40.help.text
#: 04060107.xhp%23par_id3145569.40.help.text
msgid "<ahelp hid=\"HID_FUNC_MINV\">Returns the inverse array.</ahelp>"
msgstr "<ahelp hid=\"HID_FUNC_MINV\">Վերադարձնում է հակադարձ զանգվածը։</ahelp>"

#: 04060107.xhp#hd_id3156072.41.help.text
#: 04060107.xhp%23hd_id3156072.41.help.text
msgctxt "04060107.xhp#hd_id3156072.41.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060107.xhp#par_id3156085.42.help.text
#: 04060107.xhp%23par_id3156085.42.help.text
msgid "MINVERSE(Array)"
msgstr "MINVERSE(Array)"

#: 04060107.xhp#par_id3157849.43.help.text
#: 04060107.xhp%23par_id3157849.43.help.text
msgid "<emph>Array</emph> represents a square array that is to be inverted."
msgstr ""
"<emph>Զանգված</emph> ներկայացնում է քառակուսի զանգված, որը պետք է շրջվի:"

#: 04060107.xhp#par_idN113EE.help.text
#: 04060107.xhp%23par_idN113EE.help.text
msgctxt "04060107.xhp#par_idN113EE.help.text"
msgid "<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/>"
msgstr "<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/>"

#: 04060107.xhp#hd_id3157868.44.help.text
#: 04060107.xhp%23hd_id3157868.44.help.text
msgctxt "04060107.xhp#hd_id3157868.44.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060107.xhp#par_id3149638.45.help.text
#: 04060107.xhp%23par_id3149638.45.help.text
msgid ""
"Select a square range and select MINVERSE. Select the output array, select "
"the <emph>Array</emph> field and click <emph>OK</emph>."
msgstr ""
"Ընտրեք քառակուսի տիրույթ և ընտրեք MINVERSE։ Ընտրեք ելքային զանգվածը, ընտրեք "
"<emph>Զանգված</emph> դաշտը և սեղմեք <emph>ԼԱՎ</emph>։"

#: 04060107.xhp#bm_id3148546.help.text
#: 04060107.xhp%23bm_id3148546.help.text
msgid "<bookmark_value>MMULT function</bookmark_value>"
msgstr "<bookmark_value>MMULT function</bookmark_value>"

#: 04060107.xhp#hd_id3148546.47.help.text
#: 04060107.xhp%23hd_id3148546.47.help.text
msgid "MMULT"
msgstr "MMULT"

#: 04060107.xhp#par_id3148518.48.help.text
#: 04060107.xhp%23par_id3148518.48.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_MMULT\">Calculates the array product of two "
"arrays.</ahelp> The number of columns for array 1 must match the number of "
"rows for array 2. The square array has an equal number of rows and columns."
msgstr ""
"<ahelp hid=\"HID_FUNC_MMULT\">Հաշվում է երկու զանգվածների զանգվածային "
"արտադրանքը:</ahelp> 1-ին զանգվածի համար սյունակների քանակը պետք է "
"համապատասխանի 2-րդ զանգվածի տողերի քանակին: Քառակուսի զանգվածն ունի հավասար "
"թվով տողեր և սյունակներ:"

#: 04060107.xhp#hd_id3146767.49.help.text
#: 04060107.xhp%23hd_id3146767.49.help.text
msgctxt "04060107.xhp#hd_id3146767.49.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060107.xhp#par_id3150798.50.help.text
#: 04060107.xhp%23par_id3150798.50.help.text
msgid "MMULT(Array; Array)"
msgstr "MMULT(Array; Array)"

#: 04060107.xhp#par_id3150812.51.help.text
#: 04060107.xhp%23par_id3150812.51.help.text
msgid ""
"<emph>Array</emph> at first place represents the first array used in the "
"array product."
msgstr ""
"<emph>Զանգված</emph> առաջին տեղում ներկայացնում է զանգվածի արտադրանքի մեջ "
"օգտագործված առաջին զանգվածը:"

#: 04060107.xhp#par_id3152553.52.help.text
#: 04060107.xhp%23par_id3152553.52.help.text
msgid ""
"<emph>Array</emph> at second place represents the second array with the same "
"number of rows."
msgstr ""
"<emph>Զանգված</emph> երկրորդ տեղում ներկայացնում է երկրորդ զանգվածը, նույն "
"քանակի տողերով:"

#: 04060107.xhp#par_idN114C3.help.text
#: 04060107.xhp%23par_idN114C3.help.text
msgctxt "04060107.xhp#par_idN114C3.help.text"
msgid "<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/>"
msgstr "<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/>"

#: 04060107.xhp#hd_id3152574.53.help.text
#: 04060107.xhp%23hd_id3152574.53.help.text
msgctxt "04060107.xhp#hd_id3152574.53.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060107.xhp#par_id3146826.54.help.text
#: 04060107.xhp%23par_id3146826.54.help.text
msgid ""
"Select a square range. Choose the MMULT function. Select the first "
"<emph>Array</emph>, then select the second <emph>Array</emph>. Using <emph>"
"Function Wizard</emph>, mark the <emph>Array</emph> check box. Click "
"<emph>OK</emph>. The output array will appear in the first selected range."
msgstr ""
"Ընտրեք քառակուսի միջակայք: Ընտրեք MMULT գործառույթը։ Ընտրեք առաջին "
"<emph>Զանգվածը</emph>, ապա ընտրեք երկրորդ <emph>Զանգվածը</emph>։ "
"Օգտագործելով <emph>Գործառույթի հրաշագործը</emph>, նշեք <emph>Զանգված</emph> "
"ընտրավանդակը։ Սեղմեք <emph>ԼԱՎ</emph>։ Ելքի զանգվածը կհայտնվի առաջին ընտրված "
"տիրույթում:"

#: 04060107.xhp#bm_id3154970.help.text
#: 04060107.xhp%23bm_id3154970.help.text
msgid "<bookmark_value>TRANSPOSE function</bookmark_value>"
msgstr "<bookmark_value>TRANSPOSE function</bookmark_value>"

#: 04060107.xhp#hd_id3154970.56.help.text
#: 04060107.xhp%23hd_id3154970.56.help.text
msgid "TRANSPOSE"
msgstr "TRANSPOSE"

#: 04060107.xhp#par_id3155276.57.help.text
#: 04060107.xhp%23par_id3155276.57.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_MTRANS\">Transposes the rows and columns of an "
"array.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_MTRANS\">Փոխադրում է զանգվածի տողերն ու "
"սյունակները:</ahelp>"

#: 04060107.xhp#hd_id3155294.58.help.text
#: 04060107.xhp%23hd_id3155294.58.help.text
msgctxt "04060107.xhp#hd_id3155294.58.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060107.xhp#par_id3153843.59.help.text
#: 04060107.xhp%23par_id3153843.59.help.text
msgid "TRANSPOSE(Array)"
msgstr "TRANSPOSE(Array)"

#: 04060107.xhp#par_id3153857.60.help.text
#: 04060107.xhp%23par_id3153857.60.help.text
msgid ""
"<emph>Array</emph> represents the array in the spreadsheet that is to be "
"transposed."
msgstr ""
"<emph>Զանգված</emph> ներկայացնում է զանգվածը փռված թերթիկում, որը պետք է "
"վերադասավորվի։"

#: 04060107.xhp#par_idN115A5.help.text
#: 04060107.xhp%23par_idN115A5.help.text
msgctxt "04060107.xhp#par_idN115A5.help.text"
msgid "<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/>"
msgstr "<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/>"

#: 04060107.xhp#hd_id3159352.61.help.text
#: 04060107.xhp%23hd_id3159352.61.help.text
msgctxt "04060107.xhp#hd_id3159352.61.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060107.xhp#par_id3159366.62.help.text
#: 04060107.xhp%23par_id3159366.62.help.text
msgid ""
"In the spreadsheet, select the range in which the transposed array can "
"appear. If the original array has n rows and m columns, your selected range "
"must have at least m rows and n columns. Then enter the formula directly, "
"select the original array and press <switchinline select=\"sys\"><caseinline "
"select=\"MAC\">Shift+Command+Enter</caseinline><defaultinline>Shift+Ctrl+Ente"
"r</defaultinline></switchinline>. Or, if you are using the <emph>Function "
"Wizard</emph>, mark the <emph>Array</emph> check box. The transposed array "
"appears in the selected target range and is protected automatically against "
"changes."
msgstr ""
"Փռված թերթիկում ընտրեք այն միջակայքը, որում կարող է հայտնվել փոխադրվող "
"զանգվածը: Եթե սկզբնական զանգվածն ունի n տող և m սյունակ, ձեր ընտրած տիրույթը "
"պետք է առնվազն ունենա m տող և n սյունակ: Այնուհետև ուղղակիորեն մուտքագրեք "
"բանաձևը, ընտրեք սկզբնական զանգվածը և սեղմեք <switchinline select=\"sys\"><"
"caseinline select=\"MAC\">Shift+Command+Enter</caseinline><defaultinline>Shif"
"t+Ctrl+Enter</defaultinline></switchinline>։ Կամ, եթե օգտագործում եք <emph>"
"Գործառույթի հրաշագործը</emph>, նշեք <emph>Զանգված</emph> ընտրավանդակը։ "
"Փոխադրվող զանգվածը հայտնվում է ընտրված նպատակային տիրույթում և ինքնաբերաբար "
"պաշտպանված է փոփոխություններից:"

#: 04060107.xhp#bm_id3109846.help.text
#: 04060107.xhp%23bm_id3109846.help.text
msgid "<bookmark_value>LINEST function</bookmark_value>"
msgstr "<bookmark_value>LINEST function</bookmark_value>"

#: 04060107.xhp#hd_id3109846.64.help.text
#: 04060107.xhp%23hd_id3109846.64.help.text
msgid "LINEST"
msgstr "LINEST"

#: 04060107.xhp#par_id3144733.65.help.text
#: 04060107.xhp%23par_id3144733.65.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_RGP\">Returns a table of statistics for a straight "
"line that best fits a data set.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_RGP\">ՈՒղիղ գծի համար վերադարձնում է վիճակագրության "
"աղյուսակը, որը լավագույնս տեղավորվում է տվյալների շարքում:</ahelp>"

#: 04060107.xhp#hd_id3152825.66.help.text
#: 04060107.xhp%23hd_id3152825.66.help.text
msgctxt "04060107.xhp#hd_id3152825.66.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060107.xhp#par_id3152839.67.help.text
#: 04060107.xhp%23par_id3152839.67.help.text
msgid "LINEST(data_Y; data_X; linearType; stats)"
msgstr "LINEST(data_Y; data_X; linearType; stats)"

#: 04060107.xhp#par_id3152853.68.help.text
#: 04060107.xhp%23par_id3152853.68.help.text
msgid ""
"<emph>data_Y</emph> is a single row or column range specifying the y "
"coordinates in a set of data points."
msgstr ""
"<emph>data_Y</emph> մեկ տողի կամ սյունակի տիրույթ է, բնութագրելով y "
"կոորդինատները տվյալների շարքի կետերում:"

#: 04060107.xhp#par_id3154428.69.help.text
#: 04060107.xhp%23par_id3154428.69.help.text
msgid ""
"<emph>data_X</emph> is a corresponding single row or column range specifying "
"the x coordinates. If <emph>data_X</emph> is omitted it defaults to <item "
"type=\"literal\">1, 2, 3, ..., n</item>. If there is more than one set of "
"variables <emph>data_X</emph> may be a range with corresponding multiple "
"rows or columns."
msgstr ""
"<emph>data_X</emph> համապատասխան մեկ տողի կամ սյունակի միջակայք է, նշելով x "
"կոորդինատները: Եթե <emph>data_X</emph> բացակայում է, այն կանխադրված է <item "
"type=\"literal\">1, 2, 3, ..., n</item>։ Եթե կա մեկից ավելի փոփոխականների "
"բազմություն <emph>data_X</emph> կարող է լինել շարք, համապատասխան բազմաթիվ "
"տողերով կամ սյունակներով:"

#: 04060107.xhp#par_id0811200804502119.help.text
#: 04060107.xhp%23par_id0811200804502119.help.text
msgid ""
"LINEST finds a straight line <item type=\"literal\">y = a + bx</item> that "
"best fits the data, using linear regression (the \"least squares\" method). "
"With more than one set of variables the straight line is of the form <item "
"type=\"literal\">y = a + b1x1 + b2x2 ... + bnxn</item>."
msgstr ""
"LINEST -ը գտնում է ուղիղ գիծը <item type=\"literal\">y = a + bx</item> որը "
"լավագույնս համապատասխանում է տվյալներին, օգտագործելով գծային ռեգրեսիա («"
"նվազագույն քառակուսիների» մեթոդը): Մեկից ավելի փոփոխականների առկայության "
"դեպքում, ուղիղ գծի ձևն է <item type=\"literal\">y = a + b1x1 + b2x2 ... + "
"bnxn</item>։"

#: 04060107.xhp#par_id3154448.70.help.text
#: 04060107.xhp%23par_id3154448.70.help.text
msgid ""
" if<emph>linearType</emph> is FALSE the straight line found is forced to "
"pass through the origin (the constant a is zero; y = bx). If omitted, "
"<emph>linearType</emph> defaults to TRUE (the line is not forced through the "
"origin)."
msgstr ""
" եթե<emph>linearType</emph> ԿԵՂԾ է, գտնված ուղիղ գիծը ստիպված է անցնել "
"ծագման միջոցով (a հաստատունը զրո է, y = bx): Եթե բացակայում է, "
"<emph>linearType</emph> կանխադրված է որպես ՃԻՇՏ (տողը չի պարտադրվում ծագման "
"միջոցով):"

#: 04060107.xhp#par_id3154142.71.help.text
#: 04060107.xhp%23par_id3154142.71.help.text
msgid ""
"if<emph>stats</emph> is omitted or FALSE only the top line of the statistics "
"table is returned. If TRUE the entire table is returned."
msgstr ""
"եթե<emph>stats</emph> բաց է թողնված կամ Կեղծ է, միայն վիճակագրության "
"աղյուսակի վերին գիծն է վերադարձվում: Եթե Ճշմարիտ է, ամբողջ աղյուսակն է "
"վերադարձվում:"

#: 04060107.xhp#par_id0811200804502261.help.text
#: 04060107.xhp%23par_id0811200804502261.help.text
msgid ""
"LINEST returns a table (array) of statistics as below and must be entered as "
"an array formula (for example by using <switchinline select=\"sys\"><"
"caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</defaultinl"
"ine></switchinline>+Shift+Return rather than just Return)."
msgstr ""
"LINEST -ը վերադարձնում է վիճակագրության աղյուսակը (զանգվածը) ինչպես ներքևում "
"է, և պետք է մուտքագրվի որպես զանգվածի բանաձև (օրինակ ՝ օգտագործելով <"
"switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><d"
"efaultinline>Ctrl</defaultinline></switchinline>+Shift+Return քան թե "
"պարզապես Վերադառնալ)։"

#: 04060107.xhp#par_idN11416.help.text
#: 04060107.xhp%23par_idN11416.help.text
msgctxt "04060107.xhp#par_idN11416.help.text"
msgid "<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/>"
msgstr "<embedvar href=\"text/scalc/00/00000004.xhp#optional\"/>"

#: 04060107.xhp#par_idN116C6.help.text
#: 04060107.xhp%23par_idN116C6.help.text
msgctxt "04060107.xhp#par_idN116C6.help.text"
msgid "<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/>"
msgstr "<embedvar href=\"text/scalc/00/00000004.xhp#moreontop\"/>"

#: 04060107.xhp#hd_id3154162.72.help.text
#: 04060107.xhp%23hd_id3154162.72.help.text
msgctxt "04060107.xhp#hd_id3154162.72.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060107.xhp#par_id3154176.73.help.text
#: 04060107.xhp%23par_id3154176.73.help.text
msgid ""
"This function returns an array and is handled in the same way as the other "
"array functions. Select a range for the answers and then the function. "
"Select <emph>data_Y</emph>. If you want, you can enter other parameters. "
"Select <emph>Array</emph> and click <emph>OK</emph>."
msgstr ""
"Այս գործառույթը վերադարձնում է զանգվածը և մշակում է այնպես, ինչպես զանգվածի "
"մյուս գործառույթները: Պատասխանների համար ընտրեք տիրույթը, ապա գործառույթը: "
"Ընտրեք <emph>data_Y</emph>։ Եթե ցանկանում եք, կարող եք մուտքագրել այլ "
"պարամետրեր: Ընտրեք <emph>Զանգված</emph> և սեղմեք <emph>ԼԱՎ</emph>։"

#: 04060107.xhp#par_id3155468.74.help.text
#: 04060107.xhp%23par_id3155468.74.help.text
msgid ""
"The results returned by the system (if <emph>stats</emph> = 0), will at "
"least show the slope of the regression line and its intersection with the Y "
"axis. If <emph>stats</emph> does not equal 0, other results are to be "
"displayed."
msgstr ""
"Համակարգի կողմից վերադարձված արդյունքները (եթե <emph>stats</emph> = 0), "
"առնվազն ցույց կտան ռեգրեսիայի գծի թեքությունը և դրա հատումը Y առանցքի հետ: "
"Եթե <emph>stats</emph> -ը հավասար չէ 0, պետք է ցուցադրվեն այլ արդյունքներ:"

