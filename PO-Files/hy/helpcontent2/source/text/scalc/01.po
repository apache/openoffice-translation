"value of text is 0.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_VARIANZA\">Նմուշի հիման վրա գնահատում է դիսպերսիան: "
"Տեքստի արժեքը 0 է:</ahelp>"

#: 04060185.xhp#hd_id3149176.204.help.text
#: 04060185.xhp%23hd_id3149176.204.help.text
msgctxt "04060185.xhp#hd_id3149176.204.help.text"
