#: 04060116.xhp#hd_id3146125.209.help.text
#: 04060116.xhp%23hd_id3146125.209.help.text
msgctxt "04060116.xhp#hd_id3146125.209.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060116.xhp#par_id3153695.210.help.text
#: 04060116.xhp%23par_id3153695.210.help.text
msgid "CONVERT_ADD(Number; \"FromUnit\"; \"ToUnit\")"
msgstr "CONVERT_ADD(Number; \"FromUnit\"; \"ToUnit\")"

#: 04060116.xhp#par_id3147522.211.help.text
#: 04060116.xhp%23par_id3147522.211.help.text
msgid "            <emph>Number</emph> is the number to be converted."
msgstr "            <emph>Թիվ</emph> ձևափոխման թիվն է։"

#: 04060116.xhp#par_id3154472.212.help.text
#: 04060116.xhp%23par_id3154472.212.help.text
msgid ""
"            <emph>FromUnit</emph> is the unit from which conversion is "
"taking place."
msgstr ""
"            <emph>FromUnit</emph> այն միավորն է, որից փոխարկումը տեղի է "
"ունենում:"

#: 04060116.xhp#par_id3153790.213.help.text
#: 04060116.xhp%23par_id3153790.213.help.text
msgid ""
"            <emph>ToUnit</emph> is the unit to which conversion is taking "
"place. Both units must be of the same type."
msgstr ""
"            <emph>ToUnit</emph> այն միավորն է, որտեղ տեղի է ունենում "
"փոխարկումը: Երկու միավորներն էլ պետք է լինեն նույն տեսակի:"

#: 04060116.xhp#par_id09022809540918.help.text
#: 04060116.xhp%23par_id09022809540918.help.text
msgid ""
"<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:"
"_CONVERT_ADD_function\">Current list of CONVERT_ADD units in the "
"OpenOffice.org Wiki.</link>"
msgstr ""
"<link href=\"https://wiki.openoffice.org/wiki/Documentation/How_Tos/Calc:"
"_CONVERT_ADD_function\">Current list of CONVERT_ADD units in the "
"OpenOffice.org Wiki.</link>"

#: 04060116.xhp#hd_id3156270.214.help.text
#: 04060116.xhp%23hd_id3156270.214.help.text
msgctxt "04060116.xhp#hd_id3156270.214.help.text"
msgid "Examples"
msgstr "Օրինակներ"

#: 04060116.xhp#par_id3156336.215.help.text
#: 04060116.xhp%23par_id3156336.215.help.text
msgid ""
"            <item type=\"input\">=CONVERT_ADD(10;\"HP\";\"PS\") </item>"
"returns, rounded to two decimal places, 10.14. 10 HP equal 10.14 PS."
msgstr ""
"            <item type=\"input\">=CONVERT_ADD(10;\"HP\";\"PS\") </item>"
"վերադարձնում է, կլորացված երկու տասական դիրքով, 10.14. 10 HP հավասար է 10.14 "
"PS։"

#: 04060116.xhp#par_id3154834.216.help.text
#: 04060116.xhp%23par_id3154834.216.help.text
msgid ""
"            <item type=\"input\">=CONVERT_ADD(10;\"km\";\"mi\") </item>"
"returns, rounded to two decimal places, 6.21. 10 kilometers equal 6.21 "
"miles. The k is the permitted prefix character for the factor 10^3."
msgstr ""
"            <item type=\"input\">=CONVERT_ADD(10;\"km\";\"mi\") </item>"
"վերադարձնում է, կլորացված երկու տասական դիրքով, 6.21. 10 կիլոմետրը հավասար է "
"6.21 մղոնի։ k -ն թույլատրված նախածանցի նիշն է 10^3 գործոնի համար։"

#: 04060116.xhp#bm_id3147096.help.text
#: 04060116.xhp%23bm_id3147096.help.text
msgid ""
"<bookmark_value>FACTDOUBLE function</bookmark_value>         "
"<bookmark_value>factorials;numbers with increments of two</bookmark_value>"
msgstr ""
"<bookmark_value>FACTDOUBLE function</bookmark_value>         "
"<bookmark_value>factorials;numbers with increments of two</bookmark_value>"

#: 04060116.xhp#hd_id3147096.36.help.text
#: 04060116.xhp%23hd_id3147096.36.help.text
msgid "FACTDOUBLE"
msgstr "FACTDOUBLE"

#: 04060116.xhp#par_id3151309.37.help.text
#: 04060116.xhp%23par_id3151309.37.help.text
msgid ""
"<ahelp hid=\"HID_AAI_FUNC_FACTDOUBLE\">Returns the double factorial of a "
"number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_AAI_FUNC_FACTDOUBLE\">Վերադարձնում է թվի կրկնակի "
"ֆակտորիալը։</ahelp>"

#: 04060116.xhp#hd_id3154666.38.help.text
#: 04060116.xhp%23hd_id3154666.38.help.text
msgctxt "04060116.xhp#hd_id3154666.38.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060116.xhp#par_id3155121.39.help.text
#: 04060116.xhp%23par_id3155121.39.help.text
msgid "FACTDOUBLE(Number)"
msgstr "FACTDOUBLE(Number)"

#: 04060116.xhp#par_id3158440.40.help.text
#: 04060116.xhp%23par_id3158440.40.help.text
msgid ""
"Returns <emph>Number</emph>            <emph>!!</emph>, the double factorial "
"of <emph>Number</emph>, where <emph>Number</emph> is an integer greater than "
"or equal to zero."
msgstr ""
"Վերադարձնում է <emph>Թիվը</emph>            <emph>!!</emph>, <emph>Թվի</emph>"
" կրկնակի ֆակտորիալը, որտեղ <emph>Թիվը</emph> զրոյին հավասար կամ զրոյից մեծ "
"ամբողջ է։"

#: 04060116.xhp#par_id2480849.help.text
#: 04060116.xhp%23par_id2480849.help.text
msgid "For even numbers FACTDOUBLE(n) returns:"
msgstr "Զույգ թվերի համար FACTDOUBLE(n) վերադարձնում է:"

#: 04060116.xhp#par_id4181951.help.text
#: 04060116.xhp%23par_id4181951.help.text
msgid "2*4*6*8* ... *n"
msgstr "2*4*6*8* ... *n"

#: 04060116.xhp#par_id2927335.help.text
#: 04060116.xhp%23par_id2927335.help.text
msgid "For odd numbers FACTDOUBLE(n) returns:"
msgstr "Կենտ թվերի համար FACTDOUBLE(n) վերադարձնում է:"

#: 04060116.xhp#par_id2107303.help.text
#: 04060116.xhp%23par_id2107303.help.text
msgid "1*3*5*7* ... *n"
msgstr "1*3*5*7* ... *n"

#: 04060116.xhp#par_id4071779.help.text
#: 04060116.xhp%23par_id4071779.help.text
msgid "FACTDOUBLE(0) returns 1 by definition."
msgstr "FACTDOUBLE(0) վերադարձնում է 1 ըստ սահմանման։"

#: 04060116.xhp#hd_id3154622.42.help.text
#: 04060116.xhp%23hd_id3154622.42.help.text
msgctxt "04060116.xhp#hd_id3154622.42.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060116.xhp#par_id7844477.help.text
#: 04060116.xhp%23par_id7844477.help.text
msgid "            <item type=\"input\">=FACTDOUBLE(5)</item> returns 15."
msgstr ""
"            <item type=\"input\">=FACTDOUBLE(5)</item> վերադարձնում է 15։"

#: 04060116.xhp#par_id3154116.43.help.text
#: 04060116.xhp%23par_id3154116.43.help.text
msgid "            <item type=\"input\">=FACTDOUBLE(6)</item> returns 48."
msgstr ""
"            <item type=\"input\">=FACTDOUBLE(6)</item> վերադարձնում է 48։"

#: 04060116.xhp#par_id6478469.help.text
#: 04060116.xhp%23par_id6478469.help.text
msgid "            <item type=\"input\">=FACTDOUBLE(0)</item> returns 1."
msgstr ""
"            <item type=\"input\">=FACTDOUBLE(0)</item> վերադարձնում է 1։"
