#: 04060119.xhp%23hd_id3149052.1.help.text
msgctxt "04060119.xhp#hd_id3149052.1.help.text"
msgid "Financial Functions Part Two"
msgstr "Ֆինանսական գործառույթներ Մաս երկրորդ"

#: 04060119.xhp#par_id3148742.343.help.text
#: 04060119.xhp%23par_id3148742.343.help.text
msgctxt "04060119.xhp#par_id3148742.343.help.text"
msgid ""
"<link href=\"text/scalc/01/04060103.xhp\" name=\"Back to Financial Functions "
"Part One\">Back to Financial Functions Part One</link>"
msgstr ""
"<link href=\"text/scalc/01/04060103.xhp\" name=\"Հետ դեպի Ֆինանսական "
"գործառույթներ Մաս առաջին\">Հետ դեպի Ֆինանսական գործառույթներ Մաս "
