msgstr "<bookmark_value>IMABS function</bookmark_value>"

#: 04060116.xhp#hd_id3154959.44.help.text
#: 04060116.xhp%23hd_id3154959.44.help.text
msgid "IMABS"
msgstr "IMABS"

#: 04060116.xhp#par_id3149895.45.help.text
#: 04060116.xhp%23par_id3149895.45.help.text
msgid ""
"<ahelp hid=\"HID_AAI_FUNC_IMABS\">The result is the absolute value of a "
"complex number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_AAI_FUNC_IMABS\">Արդյունքը բարդ թիվի բացարձակ արժեքն "
"է:</ahelp>"

#: 04060116.xhp#hd_id3155382.46.help.text
#: 04060116.xhp%23hd_id3155382.46.help.text
msgctxt "04060116.xhp#hd_id3155382.46.help.text"
