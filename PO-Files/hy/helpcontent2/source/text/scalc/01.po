msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SUBT_OPTIONS:BTN_PAGEBREAK\">Inserts a "
"new page after each group of subtotaled data.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SUBT_OPTIONS:BTN_PAGEBREAK\">"
"Յուրաքանչյուր խմբի ենթաարդյունքների տվյալների յուրաքանչյուր խմբից հետո "
"տեղադրում է նոր էջ:</ahelp>"

#: 12050200.xhp#hd_id3146985.5.help.text
#: 12050200.xhp%23hd_id3146985.5.help.text
msgctxt "12050200.xhp#hd_id3146985.5.help.text"
msgid "Case sensitive"
msgstr "Զգայուն Ռեգիստրի նկատմամբ"

#: 12050200.xhp#par_id3153190.6.help.text
#: 12050200.xhp%23par_id3153190.6.help.text
msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SUBT_OPTIONS:BTN_CASE\">Recalculates "
"subtotals when you change the case of a data label.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SUBT_OPTIONS:BTN_CASE\">Վերահաշվարկում է "
"ենթաարդյունքները, երբ փոխում ես տվյալների պիտակի դեպքը:</ahelp>"

#: 12050200.xhp#hd_id3151119.7.help.text
#: 12050200.xhp%23hd_id3151119.7.help.text
msgid "Pre-sort area according to groups"
msgstr "Նախատեսակավորման տարածքը ըստ խմբերի"

#: 12050200.xhp#par_id3149664.8.help.text
#: 12050200.xhp%23par_id3149664.8.help.text
msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SUBT_OPTIONS:BTN_SORT\">Sorts the area "
"that you selected in the <emph>Group by</emph> box of the Group tabs "
"according to the columns that you selected.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SUBT_OPTIONS:BTN_SORT\">Տեսակավորում է "
"տարածքը, որը ընտրել եք <emph>Խմբավորել ըստ</emph> Խմբի ներդիրի վանդակը, "
"համաձայն ձեր ընտրած սյունակների։</ahelp>"

#: 12050200.xhp#hd_id3153951.9.help.text
#: 12050200.xhp%23hd_id3153951.9.help.text
msgctxt "12050200.xhp#hd_id3153951.9.help.text"
msgid "Sort"
msgstr "Տեսակավորել"

#: 12050200.xhp#hd_id3145252.11.help.text
#: 12050200.xhp%23hd_id3145252.11.help.text
msgid "Include formats"
msgstr "Ներառեք ձևաչափերը"

#: 12050200.xhp#par_id3147125.12.help.text
#: 12050200.xhp%23par_id3147125.12.help.text
msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SUBT_OPTIONS:BTN_FORMATS\">Considers "
"formatting attributes when sorting.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCPAGE_SUBT_OPTIONS:BTN_FORMATS\">Հաշվի է "
"առնում ձևավորման ատրիբուտները տեսակավորելիս։</ahelp>"

#: 12050200.xhp#hd_id3155418.13.help.text
#: 12050200.xhp%23hd_id3155418.13.help.text
msgid "Custom sort order"
msgstr "Օգտվողի տեսակավորման կարգ"

#: 12050200.xhp#par_id3149400.14.help.text
#: 12050200.xhp%23par_id3149400.14.help.text
msgid ""
"<ahelp hid=\"SC:LISTBOX:RID_SCPAGE_SUBT_OPTIONS:LB_USERDEF\">Uses a custom "
"sorting order that you defined in the Options dialog box at <emph>%"
"PRODUCTNAME Calc - Sort Lists</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:LISTBOX:RID_SCPAGE_SUBT_OPTIONS:LB_USERDEF\">Օգտագործում է "
"օգտվողի տեսակավորման կարգը, որը սահմանել եք Ընտրանքների երկխոսության "
"վանդակում <emph>%PRODUCTNAME Calc - Տեսակավորման ցուցակներ</emph> "
"-ից։</ahelp>"

#: 12050200.xhp#hd_id3149121.15.help.text
#: 12050200.xhp%23hd_id3149121.15.help.text
msgctxt "12050200.xhp#hd_id3149121.15.help.text"
msgid "Ascending"
msgstr "Ըստ Աճման"

#: 12050200.xhp#par_id3155068.16.help.text
#: 12050200.xhp%23par_id3155068.16.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_SUBT_OPTIONS:BTN_ASCENDING\">Sorts "
"beginning with the lowest value. You can define the sort rules on Data - "
"Sort - Options.</ahelp> You define the default on Tools - Options - Language "
"settings - Languages."
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_SUBT_OPTIONS:BTN_ASCENDING\">"
"Տեսակավորումը սկսվում է ամենացածր արժեքից: Կարող եք սահմանել տեսակավորման "
"կանոնները այստեղ Տվյալներ - Տեսակավորել - Ընտրանքներ:</ahelp> Լռելյանը "
"սահմանում եք այստեղ Գործիքներ - Ընտրանքներ - Լեզվական կարգաբերումներ - "
"Լեզուներ:"

#: 12050200.xhp#hd_id3155443.17.help.text
#: 12050200.xhp%23hd_id3155443.17.help.text
msgctxt "12050200.xhp#hd_id3155443.17.help.text"
msgid "Descending"
msgstr "Նվազող"

#: 12050200.xhp#par_id3153766.18.help.text
#: 12050200.xhp%23par_id3153766.18.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_SUBT_OPTIONS:BTN_DESCENDING\">Sorts "
"beginning with the highest value. You can define the sort rules on Data - "
"Sort - Options.</ahelp> You define the default on Tools - Options - Language "
"settings - Languages."
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCPAGE_SUBT_OPTIONS:BTN_DESCENDING\">"
"Տեսակավորումը սկսվում է ամենաբարձր արժեքից: Կարող եք սահմանել տեսակավորման "
"կանոնները այստեղ Տվյալներ - Տեսակավորել - Ընտրանքներ:</ahelp> Լռելյանը "
"սահմանում եք այստեղ Գործիքներ - Ընտրանքներ - Լեզվական կարգաբերումներ - "
"Լեզուներ:"

#: 02180000.xhp#tit.help.text
#: 02180000.xhp%23tit.help.text
msgctxt "02180000.xhp#tit.help.text"
msgid "Move or Copy a Sheet"
msgstr "Տեղափոխեք կամ պատճենեք թերթիկը"

#: 02180000.xhp#bm_id3153360.help.text
#: 02180000.xhp%23bm_id3153360.help.text
msgid ""
"<bookmark_value>spreadsheets; "
"moving</bookmark_value><bookmark_value>spreadsheets; "
"copying</bookmark_value><bookmark_value>moving; "
"spreadsheets</bookmark_value><bookmark_value>copying; "
"spreadsheets</bookmark_value>"
msgstr ""
"<bookmark_value>spreadsheets; "
"moving</bookmark_value><bookmark_value>spreadsheets; "
"copying</bookmark_value><bookmark_value>moving; "
"spreadsheets</bookmark_value><bookmark_value>copying; "
"spreadsheets</bookmark_value>"

#: 02180000.xhp#hd_id3153360.1.help.text
#: 02180000.xhp%23hd_id3153360.1.help.text
msgctxt "02180000.xhp#hd_id3153360.1.help.text"
msgid "Move or Copy a Sheet"
msgstr "Տեղափոխեք կամ պատճենեք թերթիկ"

#: 02180000.xhp#par_id3154686.2.help.text
#: 02180000.xhp%23par_id3154686.2.help.text
msgid ""
"<variable id=\"tabelleverschiebenkopierentext\"><ahelp hid=\".uno:Move\">"
"Moves or copies a sheet to a new location in the document or to a different "
"document.</ahelp></variable>"
msgstr ""
"<variable id=\"tabelleverschiebenkopierentext\"><ahelp hid=\".uno:Move\">"
"Տեղափոխում կամ պատճենում է թերթը փաստաթղթի մեջ նոր վայրում, կամ այլ "
"փաստաթղթում:</ahelp></variable>"

#: 02180000.xhp#par_id2282479.help.text
#: 02180000.xhp%23par_id2282479.help.text
msgid ""
"When you copy and paste cells containing <link href=\"text/scalc/01/04060102."
"xhp\">date values</link> between different spreadsheets, both spreadsheet "
"documents must be set to the same date base. If date bases differ, the "
"displayed date values will change!"
msgstr ""
"Երբ պատճենեք և հետ դնեք բջիջները, որոնք պարունակում են <link href=\""
"text/scalc/01/04060102.xhp\">ամսաթվի արժեքներ</link> տարբեր աղյուսակների "
"միջև, աղյուսակային երկու փաստաթղթերը պետք է կարգաբերվեն ըստ նույն ամսաթվային "
"հիմքի: Եթե ամսաթվերի հիմքերը տարբերվեն, ցուցադրված ամսաթվերի արժեքները "
"կփոխվեն:"

#: 02180000.xhp#hd_id3163710.3.help.text
#: 02180000.xhp%23hd_id3163710.3.help.text
msgid "To Document"
msgstr "Դեպի փաստաթուղթ"

#: 02180000.xhp#par_id3148645.4.help.text
#: 02180000.xhp%23par_id3148645.4.help.text
msgid ""
"<ahelp hid=\"SC:LISTBOX:RID_SCDLG_MOVETAB:LB_DEST\">Indicates where the "
"current sheet is to be moved or copied to.</ahelp> Select <emph>new "
"document</emph> if you want to create a new location for the sheet to be "
"moved or copied."
msgstr ""
"<ahelp hid=\"SC:LISTBOX:RID_SCDLG_MOVETAB:LB_DEST\">Ցույց է տալիս, թե ուր է "
"պետք տեղափոխել կամ պատճենել ընթացիկ թերթը:</ahelp> Ընտրեք <emph>նորր "
"փաստաթուղթ</emph> եթե ցանկանում եք ստեղծել նոր տեղաբաշխում, որպեսզի թերթը "
"տեղափոխվի կամ պատճենվի:"

#: 02180000.xhp#hd_id3154012.5.help.text
#: 02180000.xhp%23hd_id3154012.5.help.text
msgid "Insert Before"
msgstr "Ներդրեք մինչ"

#: 02180000.xhp#par_id3145366.6.help.text
#: 02180000.xhp%23par_id3145366.6.help.text
msgid ""
"<ahelp hid=\"SC:LISTBOX:RID_SCDLG_MOVETAB:LB_INSERT\">The current sheet is "
"moved or copied in front of the selected sheet.</ahelp> The <emph>move to "
"end position</emph> option places the current sheet at the end."
msgstr ""
"<ahelp hid=\"SC:LISTBOX:RID_SCDLG_MOVETAB:LB_INSERT\">Ընթացիկ թերթիկը "
"տեղափոխվում կամ պատճենվում է ընտրված թերթի դիմաց:</ahelp> Այս <emph>"
"տեղափոխումը դեպի վերջին դիրքը</emph> ընտրանքը տեղադրում է ընթացիկ թերթը "
"վերջում։"

#: 02180000.xhp#hd_id3153726.7.help.text
#: 02180000.xhp%23hd_id3153726.7.help.text
msgid "Copy"
msgstr "Պատճենել"

#: 02180000.xhp#par_id3144764.8.help.text
#: 02180000.xhp%23par_id3144764.8.help.text
msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_MOVETAB:BTN_COPY\">Specifies that the "
"sheet is to be copied. If the option is unmarked, the sheet is moved.</ahelp>"
" Moving sheets is the default."
msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_MOVETAB:BTN_COPY\">Նշում է, որ թերթը պետք "
"է պատճենվի: Եթե ընտրանքն ապանշված է, թերթը տեղափոխվում է:</ahelp> Թերթերի "
"տեղաշարժումը լռելյայն են:"

#: 02140300.xhp#tit.help.text
#: 02140300.xhp%23tit.help.text
msgctxt "02140300.xhp#tit.help.text"
msgid "Up"
msgstr "Վեր"

#: 02140300.xhp#hd_id3147264.1.help.text
#: 02140300.xhp%23hd_id3147264.1.help.text
msgid "<link href=\"text/scalc/01/02140300.xhp\" name=\"Up\">Up</link>"
msgstr "<link href=\"text/scalc/01/02140300.xhp\" name=\"Վեր\">Վեր</link>"

#: 02140300.xhp#par_id3150793.2.help.text
#: 02140300.xhp%23par_id3150793.2.help.text
msgid ""
"<ahelp hid=\".uno:FillUp\" visibility=\"visible\">Fills a selected range of "
"at least two rows with the contents of the bottom most cell.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:FillUp\" visibility=\"visible\">Լրացնում է առնվազն երկու "
"ընտրված շարքի միջակայքը, ամենաներքևի բջիջների պարունակությամբ:</ahelp>"

#: 02140300.xhp#par_id3150447.3.help.text
#: 02140300.xhp%23par_id3150447.3.help.text
msgid ""
"If a selected range has only one column, the content of the bottom most cell "
"is copied into the selected cells. If several columns are selected, the "
"contents of the bottom most cells are copied into those selected above."
msgstr ""
"Եթե ընտրված միջակայքն ունի միայն մեկ սյունակ, ամենաներքևի բջջի "
"պարունակությունը պատճենվում է ընտրված բջիջների մեջ: Եթե ընտրված են մի քանի "
"սյունակներ, ամենաներքևի բջիջների պարունակությունը կպատճենվի վերևում "
"ընտրվածների մեջ:"

#: 12090105.xhp#tit.help.text
#: 12090105.xhp%23tit.help.text
msgctxt "12090105.xhp#tit.help.text"
msgid "Data field"
msgstr "Տվյալի դաշտ"

#: 12090105.xhp#bm_id7292397.help.text
#: 12090105.xhp%23bm_id7292397.help.text
msgid "<bookmark_value>calculating;pivot table</bookmark_value>"
msgstr "<bookmark_value>calculating;pivot table</bookmark_value>"

#: 12090105.xhp#hd_id3150871.1.help.text
#: 12090105.xhp%23hd_id3150871.1.help.text
msgctxt "12090105.xhp#hd_id3150871.1.help.text"
msgid "Data field"
msgstr "Տվյալի դաշտ"

#: 12090105.xhp#par_id3154124.16.help.text
#: 12090105.xhp%23par_id3154124.16.help.text
msgid ""
"The contents of this dialog is different for data fields in the "
"<emph>Data</emph> area, and data fields in the <emph>Row</emph> or "
"<emph>Column</emph> area of the <link href=\"text/scalc/01/12090102.xhp\" "
"name=\"Pivot table\">Pivot Table</link> dialog."
msgstr ""
"Այս երկխոսության բովանդակությունը տարբեր է <emph>Տվյալներ</emph> տիրույթի "
"տվյալների դաշտերի համար, և <emph>Տող</emph> կամ <emph>Սյունակ</emph> "
"տիրույթի տվյալների դաշտերի համար <link href=\"text/scalc/01/12090102.xhp\" "
"name=\"Առանցքային աղյուսակ\">Առանցքային աղյուսակ</link> երկխոսության մեջ։"

#: 12090105.xhp#hd_id3152596.2.help.text
#: 12090105.xhp%23hd_id3152596.2.help.text
msgctxt "12090105.xhp#hd_id3152596.2.help.text"
msgid "Subtotals"
msgstr "Ենթագումարներ"

#: 12090105.xhp#par_id3151113.3.help.text
#: 12090105.xhp%23par_id3151113.3.help.text
msgid ""
"<ahelp hid=\"HID_SC_PIVOTSUBT\">Specify the subtotals that you want to "
"calculate.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_SC_PIVOTSUBT\">Հատկորոշեք այն ենթգումարները, որոնք "
"ցանկանում եք հաշվել:</ahelp>"

#: 12090105.xhp#hd_id3145366.4.help.text
#: 12090105.xhp%23hd_id3145366.4.help.text
msgid "None"
msgstr "Ոչ մեկը"

#: 12090105.xhp#par_id3152576.5.help.text
#: 12090105.xhp%23par_id3152576.5.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_PIVOTSUBT:BTN_NONE\">Does not "
"calculate subtotals.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_PIVOTSUBT:BTN_NONE\">Չի հաշվում "
"ենթագումարները։</ahelp>"

#: 12090105.xhp#hd_id3154012.6.help.text
#: 12090105.xhp%23hd_id3154012.6.help.text
msgid "Automatic"
msgstr "Ավտոմատ"

#: 12090105.xhp#par_id3155856.7.help.text
#: 12090105.xhp%23par_id3155856.7.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_PIVOTSUBT:BTN_AUTO\">Automatically "
"calculates subtotals.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_PIVOTSUBT:BTN_AUTO\">Ինքնահաշվում է "
"ենթագումարները։</ahelp>"

#: 12090105.xhp#hd_id3155411.8.help.text
#: 12090105.xhp%23hd_id3155411.8.help.text
msgid "User-defined"
msgstr "Օգտվողի նշած"

#: 12090105.xhp#par_id3149581.9.help.text
#: 12090105.xhp%23par_id3149581.9.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_PIVOTSUBT:BTN_USER\">Select this "
"option, and then click the type of subtotal that you want to calculate in "
"the list.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_PIVOTSUBT:BTN_USER\">Ընտրեք այս "
"տարբերակը, ապա կտտացրեք ենթագաումարի այն տեսակի վրա, որը ցանկանում եք "
"ցուցակում հաշվել:</ahelp>"

#: 12090105.xhp#hd_id3147124.10.help.text
#: 12090105.xhp%23hd_id3147124.10.help.text
msgctxt "12090105.xhp#hd_id3147124.10.help.text"
msgid "Function"
msgstr "Գործառույթ"

#: 12090105.xhp#par_id3154490.11.help.text
#: 12090105.xhp%23par_id3154490.11.help.text
msgid ""
"<ahelp hid=\"SC:MULTILISTBOX:RID_SCDLG_PIVOTSUBT:LB_FUNC\">Click the type of "
"subtotal that you want to calculate. This option is only available if the "
"<emph>User-defined</emph> option is selected.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:MULTILISTBOX:RID_SCDLG_PIVOTSUBT:LB_FUNC\">Կտտացրեք "
"ենթագումարի այն տեսակը, որը ցանկանում եք հաշվել: Այս ընտրանքը մատչելի է "
"միայն այն դեպքում, երբ ընտրված է <emph>Օգտվողի սահմանված </emph> "
"տարբերակը:</ahelp>"

#: 12090105.xhp#hd_id3154944.14.help.text
#: 12090105.xhp%23hd_id3154944.14.help.text
msgid "Show elements without data"
msgstr "Ցուցադրել տարրերը առանց տվյալների"

#: 12090105.xhp#par_id3149403.15.help.text
#: 12090105.xhp%23par_id3149403.15.help.text
msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_PIVOTSUBT:CB_SHOWALL\">Includes empty "
"columns and rows in the results table.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_PIVOTSUBT:CB_SHOWALL\">Արդյունքների "
"աղյուսակում ներառված են դատարկ սյունակները և տողերը:</ahelp>"

#: 12090105.xhp#hd_id3149122.12.help.text
#: 12090105.xhp%23hd_id3149122.12.help.text
msgid "Name:"
msgstr "Անուն․"

#: 12090105.xhp#par_id3150749.13.help.text
#: 12090105.xhp%23par_id3150749.13.help.text
msgid "Lists the name of the selected data field."
msgstr "Թվարկում է տվյալների ընտրված դաշտի անունը"

#: 12090105.xhp#par_idN106EC.help.text
#: 12090105.xhp%23par_idN106EC.help.text
msgctxt "12090105.xhp#par_idN106EC.help.text"
msgid "More"
msgstr "Ավելին"

#: 12090105.xhp#par_idN106F0.help.text
#: 12090105.xhp%23par_idN106F0.help.text
msgid ""
"<ahelp hid=\".\">Expands or reduces the dialog. The <emph>More</emph> button "
"is visible for data fields only.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընդլայնում կամ սեղմում է երկխոսությունը։ <emph>Ավելին</emph>"
" կոճակը տեսանելի է միայն տվյալների դաշտերի համար։</ahelp>"

#: 12090105.xhp#par_idN106F3.help.text
#: 12090105.xhp%23par_idN106F3.help.text
msgctxt "12090105.xhp#par_idN106F3.help.text"
msgid "Options"
msgstr "Ընտրանքներ"

#: 12090105.xhp#par_idN106F7.help.text
#: 12090105.xhp%23par_idN106F7.help.text
msgid ""
"<ahelp hid=\".\">Opens the <link href=\"text/scalc/01/12090106.xhp\">Data "
"Field Options</link> dialog. The <emph>Options</emph> button is visible for "
"column, row, or page fields only.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է <link href=\"text/scalc/01/12090106.xhp\">"
"Տվյալների դաշտերի ընտրանքներ</link> երկխոսությունը։ <emph>Ընտրանքներ</emph> "
"կոճակը տեսանելի է միայն սյունակ, տող կամ էջ դաշտերի համար։</ahelp>"

#: 12090105.xhp#par_idN10708.help.text
#: 12090105.xhp%23par_idN10708.help.text
msgid ""
"If the dialog is expanded by the <emph>More</emph> button, the following "
"items are added to the dialog:"
msgstr ""
"Եթե երկխոսությունն ընդլայնվում է <emph>Ավելին</emph> կոճակով, երկխոսությանը "
"ավելացվում են հետևյալ կետերը."

#: 12090105.xhp#par_idN1070B.help.text
#: 12090105.xhp%23par_idN1070B.help.text
msgctxt "12090105.xhp#par_idN1070B.help.text"
msgid "Displayed value"
msgstr "Արտածված արժեք"

#: 12090105.xhp#par_idN1070F.help.text
#: 12090105.xhp%23par_idN1070F.help.text
msgid ""
"<ahelp hid=\".\">For each data field, you can select the type of "
"display.</ahelp> For some types you can select additional information for a "
"base field and a base item."
msgstr ""
"<ahelp hid=\".\">Տվյալների յուրաքանչյուր դաշտի համար կարող եք ընտրել "
"արտածման տեսակը: </ahelp> Որոշ տեսակների համար կարող եք ընտրել լրացուցիչ "
"տեղեկատվություն հիմնական դաշտի և հիմնական տարրի համար:"

#: 12090105.xhp#par_idN10712.help.text
#: 12090105.xhp%23par_idN10712.help.text
msgctxt "12090105.xhp#par_idN10712.help.text"
msgid "Type"
msgstr "Տեսակ"

#: 12090105.xhp#par_idN10716.help.text
#: 12090105.xhp%23par_idN10716.help.text
msgid ""
"<ahelp hid=\"1495371266\">Select the type of calculating of the displayed "
"value for the data field.</ahelp>"
msgstr ""
"<ahelp hid=\"1495371266\">Տվյալների դաշտի համար ընտրեք արտածված արժեքի "
"հաշվարկի տեսակը:</ahelp>"

#: 12090105.xhp#par_idN10724.help.text
#: 12090105.xhp%23par_idN10724.help.text
msgctxt "12090105.xhp#par_idN10724.help.text"
msgid "Type"
msgstr "Տեսակ"

#: 12090105.xhp#par_idN1072A.help.text
#: 12090105.xhp%23par_idN1072A.help.text
msgctxt "12090105.xhp#par_idN1072A.help.text"
msgid "Displayed value"
msgstr "Արտածված արժեք"

#: 12090105.xhp#par_idN10731.help.text
#: 12090105.xhp%23par_idN10731.help.text
msgid "Normal"
msgstr "Նորմալ"

#: 12090105.xhp#par_idN10737.help.text
#: 12090105.xhp%23par_idN10737.help.text
msgid "Results are shown unchanged"
msgstr "Արդյունքները ցուցադրվում են անփոփոխ"

#: 12090105.xhp#par_idN1073E.help.text
#: 12090105.xhp%23par_idN1073E.help.text
msgid "Difference from"
msgstr "Տարբերությունը"

#: 12090105.xhp#par_idN10744.help.text
#: 12090105.xhp%23par_idN10744.help.text
msgid ""
"From each result, its reference value (see below) is subtracted, and the "
"difference is shown. Totals outside of the base field are shown as empty "
"results."
msgstr ""
"Յուրաքանչյուր արդյունքից հանվում է դրա տեղեկատու արժեքը (տես ստորև), և "
"ցուցադրվում է տարբերությունը: Հիմնական դաշտի սահմաններից դուրս գտնվող "
"արդյունքները որպես դատարկ արդյունք են ցուցադրվում:"

#: 12090105.xhp#par_idN10747.help.text
#: 12090105.xhp%23par_idN10747.help.text
msgid "<emph>Named item</emph>"
msgstr "<emph>Անվանական նյութ</emph>"

#: 12090105.xhp#par_idN1074C.help.text
#: 12090105.xhp%23par_idN1074C.help.text
msgid ""
"If a base item name is specified, the reference value for a combination of "
"field items is the result where the item in the base field is replaced by "
"the specified base item."
msgstr ""
"Եթե հիմնական նյութի անվանումը նշվում է, դաշտի նյութերի համադրության համար "
"հղման արժեքն այն արդյունքն է, երբ հիմնական դաշտում գտնվող տարրը փոխարինվում "
"է նշված հիմնական կետով:"

#: 12090105.xhp#par_idN1074F.help.text
#: 12090105.xhp%23par_idN1074F.help.text
msgid "<emph>Previous item or Next item</emph>"
msgstr "<emph>Նախորդ նյութը կամ Հաջորդ նյութը</emph>"

#: 12090105.xhp#par_idN10754.help.text
#: 12090105.xhp%23par_idN10754.help.text
msgid ""
"If \"previous item\" or \"next item\" is specified as the base item, the "
"reference value is the result for the next visible member of the base field, "
"in the base field's sort order."
msgstr ""
"Եթե «նախորդ կետը» կամ «հաջորդ կետը» նշվում է որպես հիմնական տարր, ապա հղման "
"արժեքը արդյունքն է հիմնային դաշտի հաջորդ տեսանելի անդամի, ըստ հիմնային դաշտի "
"տեսակավորման կարգի:"

#: 12090105.xhp#par_idN1075B.help.text
#: 12090105.xhp%23par_idN1075B.help.text
msgid "% Of"
msgstr "%"

#: 12090105.xhp#par_idN10761.help.text
#: 12090105.xhp%23par_idN10761.help.text
msgid ""
"Each result is divided by its reference value. The reference value is "
"determined in the same way as for \"Difference from\". Totals outside of the "
"base field are shown as empty results. "
msgstr ""
"Յուրաքանչյուր արդյունք բաժանվում է իր հղման արժեքով: Հղման արժեքը որոշվում է "
"նույն կերպ, ինչ «Տարբերությունից»: Հիմնային դաշտից դուրս մնացած "
"հանրագումարները ցուցադրվում են որպես դատարկ արդյունք "

#: 12090105.xhp#par_idN1076A.help.text
#: 12090105.xhp%23par_idN1076A.help.text
msgid "% Difference from"
msgstr "% տարբերությունը"

#: 12090105.xhp#par_idN10770.help.text
#: 12090105.xhp%23par_idN10770.help.text
msgid ""
"From each result, its reference value is subtracted, and the difference is "
"divided by the reference value. The reference value is determined in the "
"same way as for \"Difference from\". Totals outside of the base field are "
"shown as empty results."
msgstr ""
"Յուրաքանչյուր արդյունքից հանվում է դրա հղման արժեքը, և տարբերությունը "
"բաժանվում է հղման արժեքով: Հղման արժեքը որոշվում է նույն կերպ, ինչ "
"«Տարբերությունից»: Հիմնային դաշտի սահմաններից դուրս գտնվող հանրագումարները "
"ցուցադրվում են որպես դատարկ արդյունք:"

#: 12090105.xhp#par_idN10777.help.text
#: 12090105.xhp%23par_idN10777.help.text
msgid "Running total in"
msgstr "Հանրագումարի կատարում"

#: 12090105.xhp#par_idN1077D.help.text
#: 12090105.xhp%23par_idN1077D.help.text
msgid ""
"Each result is added to the sum of the results for preceding items in the "
"base field, in the base field's sort order, and the total sum is shown."
msgstr ""
"Յուրաքանչյուր արդյունք ավելացվում է հիմնային դաշտում, որպես նախորդ նյութերի "
"արդյունքների գումար, հիմնային դաշտի տեսակավորման կարգում, և ցուցադրվում է "
"հանրագումարը:"

#: 12090105.xhp#par_idN10780.help.text
#: 12090105.xhp%23par_idN10780.help.text
msgid ""
"Results are always summed, even if a different summary function was used to "
"get each result."
msgstr ""
"Արդյունքները միշտ ամփոփվում են, նույնիսկ եթե յուրաքանչյուր արդյունքի "
"հասնելու համար օգտագործվել է տարբեր ամփոփ գործառույթ:"

#: 12090105.xhp#par_idN10787.help.text
#: 12090105.xhp%23par_idN10787.help.text
msgid "% of row"
msgstr "% ըստ տողի"

#: 12090105.xhp#par_idN1078D.help.text
#: 12090105.xhp%23par_idN1078D.help.text
msgid ""
"Each result is divided by the total result for its row in the pivot table. "
"If there are several data fields, the total for the result's data field is "
"used. If there are subtotals with manually selected summary functions, the "
"total with the data field's summary function is still used. "
msgstr ""
"Արդյունքներից յուրաքանչյուրը բաժանվում է առանցքային աղյուսակում տողերի "
"ընդհանուր արդյունքի վրա: Եթե կան տվյալների մի քանի դաշտեր, ապա օգտագործվում "
"է տվյալների արդյունքի դաշտի հանրագումարը: Եթե կան ձեռքով ընտրված ամփոփ "
"գործառույթների ենթահանրագումարներ, տվյալների դաշտի ամփոփ գործառույթի "
"հանրագումարն է դեռևս օգտագործվում։ "

#: 12090105.xhp#par_idN10794.help.text
#: 12090105.xhp%23par_idN10794.help.text
msgid "% of column"
msgstr "% սյունակից"

#: 12090105.xhp#par_idN1079A.help.text
#: 12090105.xhp%23par_idN1079A.help.text
msgid "Same as \"% of row\", but the total for the result's column is used."
msgstr ""
"Նույնը, ինչ որ \"% տողից\", բայց արդյունքի սյունակի համար օգտագործվում է "
"հանրագումարը։"

#: 12090105.xhp#par_idN107A1.help.text
#: 12090105.xhp%23par_idN107A1.help.text
msgid "% of total"
msgstr "% հանրագումարի"

#: 12090105.xhp#par_idN107A7.help.text
#: 12090105.xhp%23par_idN107A7.help.text
msgid ""
"Same as \"% of row\", but the grand total for the result's data field is "
"used."
msgstr ""
"Նույնը, ինչ որ \"% տողից\", բայց արդյունքի տվյալների դաշտի համար "
"օգտագործվում է ընդհանուր հանրագումարը։"

#: 12090105.xhp#par_idN107AE.help.text
#: 12090105.xhp%23par_idN107AE.help.text
msgid "Index"
msgstr "Ցուցիչ"

#: 12090105.xhp#par_idN107B4.help.text
#: 12090105.xhp%23par_idN107B4.help.text
msgid ""
"The row and column totals and the grand total, following the same rules as "
"above, are used to calculate the following expression:"
msgstr ""
"Տողի և սյունակի հանրագումարները և ընդհանուր հանրագումարը, համաձայն վերը "
"նշված նույն կանոնների, օգտագործվում են հետևյալ արտահայտությունը հաշվելու "
"համար."

#: 12090105.xhp#par_idN107B7.help.text
#: 12090105.xhp%23par_idN107B7.help.text
msgid "( original result * grand total ) / ( row total * column total )"
msgstr "( original result * grand total ) / ( row total * column total )"

#: 12090105.xhp#par_idN107BA.help.text
#: 12090105.xhp%23par_idN107BA.help.text
msgid "Base field"
msgstr "Հիմնային դաշտ"

#: 12090105.xhp#par_idN107BE.help.text
#: 12090105.xhp%23par_idN107BE.help.text
msgid ""
"<ahelp hid=\"1495371267\">Select the field from which the respective value "
"is taken as base for the calculation.</ahelp>"
msgstr ""
"<ahelp hid=\"1495371267\">Ընտրեք այն դաշտը, որտեղից հաշվարկի համար հիմք է "
"ընդունվում համապատասխան արժեքը:</ahelp>"

#: 12090105.xhp#par_idN107C1.help.text
#: 12090105.xhp%23par_idN107C1.help.text
