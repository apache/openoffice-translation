"նիշքերից:</ahelp>"

#: 04050100.xhp#par_idN105F7.help.text
#: 04050100.xhp%23par_idN105F7.help.text
msgid ""
"Use the <link href=\"text/shared/01/01020000.xhp\">File - Open</link> dialog "
"to locate the spreadsheet."
msgstr ""
