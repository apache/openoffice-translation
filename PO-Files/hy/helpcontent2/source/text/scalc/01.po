msgstr "Միջակայքը պարունակում է սյունակի պիտակներ"

#: 12040201.xhp#par_id3153768.8.help.text
#: 12040201.xhp%23par_id3153768.8.help.text
msgid ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_SPEC_FILTER:BTN_HEADER\">Includes the "
