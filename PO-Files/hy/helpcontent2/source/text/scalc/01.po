"միջակայքեր են, որոնք ներկայացնում են նմուշը հիմնված ողջ ընտրանքի վրա:"

#: 04060185.xhp#hd_id3147233.133.help.text
#: 04060185.xhp%23hd_id3147233.133.help.text
msgctxt "04060185.xhp#hd_id3147233.133.help.text"
msgid "Example"
msgstr "Օրինակ"

