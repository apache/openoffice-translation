msgstr "IMAGINARY"

#: 04060116.xhp#par_id3146965.52.help.text
#: 04060116.xhp%23par_id3146965.52.help.text
msgid ""
"<ahelp hid=\"HID_AAI_FUNC_IMAGINARY\">The result is the imaginary "
"coefficient of a complex number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_AAI_FUNC_IMAGINARY\">Արդյունքը բարդ թվերի երևակայական "
"գործակիցն է:</ahelp>"

#: 04060116.xhp#hd_id3153555.53.help.text
#: 04060116.xhp%23hd_id3153555.53.help.text
msgctxt "04060116.xhp#hd_id3153555.53.help.text"
