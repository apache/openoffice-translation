#: 04060181.xhp#par_id3150960.59.help.text
#: 04060181.xhp%23par_id3150960.59.help.text
msgctxt "04060181.xhp#par_id3150960.59.help.text"
msgid ""
"            <emph>Start</emph> (optional) is the lower bound for "
"<emph>Number</emph>."
msgstr ""
"            <emph>Սկիզբ</emph> (ըստ ցանկության) ստորին սահմանն է "
"<emph>Թվի</emph> համար:"

#: 04060181.xhp#par_id3151268.60.help.text
#: 04060181.xhp%23par_id3151268.60.help.text
msgctxt "04060181.xhp#par_id3151268.60.help.text"
msgid ""
"            <emph>End</emph> (optional) is the upper bound for "
"<emph>Number</emph>."
msgstr ""
"            <emph>Ավարտ</emph> (ըստ ցանկության) վերին սահմանն է "
"<emph>Թվի</emph> համար:"

#: 04060181.xhp#par_idN109DF.help.text
#: 04060181.xhp%23par_idN109DF.help.text
