msgid "Example"
msgstr "Օրինակ"

#: func_edate.xhp#par_id3155845.220.help.text
#: func_edate.xhp%23par_id3155845.220.help.text
msgid "What date is one month prior to 3.31.2001?"
msgstr "Ո՞ր ամսաթիվն է մեկ ամիս առաջ՝ 3.31.2001։"

#: func_edate.xhp#par_id3155999.221.help.text
#: func_edate.xhp%23par_id3155999.221.help.text
msgid "<item type=\"input\">=EDATE(3.31.2001;-1)</item> returns 2.28.2001."
msgstr ""
"<item type=\"input\">=EDATE(3.31.2001;-1)</item> վերադարձնում է 2.28.2001."

#: 06080000.xhp#tit.help.text
#: 06080000.xhp%23tit.help.text
msgid "Recalculate"
msgstr "Վերհաշվարկ"

#: 06080000.xhp#bm_id3157909.help.text
#: 06080000.xhp%23bm_id3157909.help.text
msgid ""
"<bookmark_value>recalculating;all formulas in "
"sheets</bookmark_value><bookmark_value>formulas; recalculating "
"manually</bookmark_value><bookmark_value>cell contents; "
"recalculating</bookmark_value>"
msgstr ""
"<bookmark_value>recalculating;all formulas in "
"sheets</bookmark_value><bookmark_value>formulas; recalculating "
"manually</bookmark_value><bookmark_value>cell contents; "
"recalculating</bookmark_value>"

#: 06080000.xhp#hd_id3157909.1.help.text
#: 06080000.xhp%23hd_id3157909.1.help.text
msgid ""
"<link href=\"text/scalc/01/06080000.xhp\" name=\"Recalculate\""
">Recalculate</link>"
msgstr ""
"<link href=\"text/scalc/01/06080000.xhp\" name=\"Վերահաշվարկել\""
">Վերահաշվարկել</link>"

#: 06080000.xhp#par_id3154758.2.help.text
#: 06080000.xhp%23par_id3154758.2.help.text
msgid ""
"<ahelp hid=\".uno:Calculate\">Recalculates all changed formulas. If "
"AutoCalculate is enabled, the Recalculate command applies only to formulas "
"like RAND or NOW.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:Calculate\">Վերահաշվարկում է բոլոր փոխված բանաձևերը: Եթե "
"AutoCalculate -ը միացված է, Վերահաշվարկի հրամանը կիրառվում է միայն այն "
"բանաձևերի վրա, ինչպիսիք են RAND կամ NOW:</ahelp>"

#: 06080000.xhp#par_id315475899.help.text
#: 06080000.xhp%23par_id315475899.help.text
msgid ""
"Press F9 to recalculate. Press Shift+<switchinline select=\"sys\"><"
"caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F9 "
"to recalculate all formulas in the document."
msgstr ""
"Սեղմեք F9 վերահաշվարկելու համար։ Սեղմեք Shift+<switchinline select=\"sys\"><"
"caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F9 "
"փաստաթղթում առկա բանաձևերը վերահաշվարկելու համար։"

#: 06080000.xhp#par_id3150793.5.help.text
#: 06080000.xhp%23par_id3150793.5.help.text
msgid ""
"After the document has been recalculated, the display is refreshed. All "
"charts are also refreshed."
msgstr ""
"Փաստաթղթի վերահաշվարկից հետո պաստառը թարմացվում է: Բոլոր գծապատկերները "
"նույնպես թարմացվում են:"

#: 06080000.xhp#par_id315475855.help.text
#: 06080000.xhp%23par_id315475855.help.text
msgid ""
"The Add-In functions like RANDBETWEEN currently cannot respond to the "
"Recalculate command or F9. Press Shift+<switchinline select=\"sys\"><"
"caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F9 "
"to recalculate all formulas, including the Add-In functions."
msgstr ""
"Add-In գործառույթները, ինչպիսիք են RANDBETWEEN ներկայումս չեն կարող "
"պատասխանել Վերահաշվարկի հրամանին կամ F9. Սեղմեք Shift+<switchinline select=\""
"sys\"><caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F9 "
"վերահաշվարկելու համար բոլոր բանաձևերը, ներառյալ Add-In գործառույթները:"

#: 04060000.xhp#tit.help.text
#: 04060000.xhp%23tit.help.text
msgid "Function Wizard"
msgstr "Գործառույթի հրաշագործ"

#: 04060000.xhp#bm_id3147426.help.text
#: 04060000.xhp%23bm_id3147426.help.text
