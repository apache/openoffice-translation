msgid "Example"
msgstr "Օրինակ"

#: 04060183.xhp#par_id3150016.64.help.text
#: 04060183.xhp%23par_id3150016.64.help.text
msgid "<item type=\"input\">=KURT(A1;A2;A3;A4;A5;A6)</item>"
msgstr "<item type=\"input\">=KURT(A1;A2;A3;A4;A5;A6)</item>"

#: 04060183.xhp#bm_id3150928.help.text
#: 04060183.xhp%23bm_id3150928.help.text
msgid ""
"<bookmark_value>LOGINV function</bookmark_value><bookmark_value>inverse of "
"lognormal distribution</bookmark_value>"
msgstr ""
"<bookmark_value>LOGINV function</bookmark_value><bookmark_value>inverse of "
"lognormal distribution</bookmark_value>"

#: 04060183.xhp#hd_id3150928.66.help.text
#: 04060183.xhp%23hd_id3150928.66.help.text
msgid "LOGINV"
msgstr "LOGINV"

#: 04060183.xhp#par_id3145297.67.help.text
#: 04060183.xhp%23par_id3145297.67.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_LOGINV\">Returns the inverse of the lognormal "
"distribution.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_LOGINV\">Վերադարձնում է լոգոնորմալ բաշխման "
"հակադարձը։</ahelp>"

#: 04060183.xhp#hd_id3151016.68.help.text
#: 04060183.xhp%23hd_id3151016.68.help.text
msgctxt "04060183.xhp#hd_id3151016.68.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060183.xhp#par_id3153049.69.help.text
#: 04060183.xhp%23par_id3153049.69.help.text
msgid "LOGINV(Number; Mean; StDev)"
msgstr "LOGINV(Number; Mean; StDev)"

#: 04060183.xhp#par_id3148390.70.help.text
#: 04060183.xhp%23par_id3148390.70.help.text
msgid ""
"<emph>Number</emph> is the probability value for which the inverse standard "
"logarithmic distribution is to be calculated."
msgstr ""
"<emph>Թիվ</emph> հավանականության արժեքն է, որի համար պետք է հաշվարկվի "
"հակադարձ ստանդարտ լոգարիթմական բաշխումը:"

#: 04060183.xhp#par_id3149538.71.help.text
#: 04060183.xhp%23par_id3149538.71.help.text
msgid ""
"<emph>Mean</emph> is the arithmetic mean of the standard logarithmic "
"distribution."
msgstr "<emph>Միջին</emph> ստանդարտ լոգարիթմական բաշխման թվաբանական միջինն է:"

#: 04060183.xhp#par_id3145355.72.help.text
#: 04060183.xhp%23par_id3145355.72.help.text
msgid ""
"<emph>StDev</emph> is the standard deviation of the standard logarithmic "
"distribution."
msgstr "<emph>StDev</emph> ստանդարտ լոգարիթմական բաշխման ստանդարտ շեղումն է:"

#: 04060183.xhp#hd_id3148768.73.help.text
#: 04060183.xhp%23hd_id3148768.73.help.text
msgctxt "04060183.xhp#hd_id3148768.73.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060183.xhp#par_id3155623.74.help.text
#: 04060183.xhp%23par_id3155623.74.help.text
msgid "<item type=\"input\">=LOGINV(0.05;0;1)</item> returns 0.19."
msgstr "<item type=\"input\">=LOGINV(0.05;0;1)</item> վերադարձնում է 0.19։"

#: 04060183.xhp#bm_id3158417.help.text
#: 04060183.xhp%23bm_id3158417.help.text
msgid ""
"<bookmark_value>LOGNORMDIST function</bookmark_value><bookmark_value>"
"cumulative lognormal distribution</bookmark_value>"
msgstr ""
"<bookmark_value>LOGNORMDIST function</bookmark_value><bookmark_value>"
"կումուլյատիվ լոգնորմալ բաշխում</bookmark_value>"

#: 04060183.xhp#hd_id3158417.76.help.text
#: 04060183.xhp%23hd_id3158417.76.help.text
msgid "LOGNORMDIST"
msgstr "LOGNORMDIST"

#: 04060183.xhp#par_id3154953.77.help.text
#: 04060183.xhp%23par_id3154953.77.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_LOGNORMVERT\">Returns the cumulative lognormal "
"distribution.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_LOGNORMVERT\">Վերադարձնում է կումուլյատիվ լոգնորմալ "
"բաշխումը։</ahelp>"

#: 04060183.xhp#hd_id3150474.78.help.text
#: 04060183.xhp%23hd_id3150474.78.help.text
msgctxt "04060183.xhp#hd_id3150474.78.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060183.xhp#par_id3150686.79.help.text
#: 04060183.xhp%23par_id3150686.79.help.text
msgid "LOGNORMDIST(Number; Mean; StDev; Cumulative)"
msgstr "LOGNORMDIST(Number; Mean; StDev; Cumulative)"

#: 04060183.xhp#par_id3154871.80.help.text
#: 04060183.xhp%23par_id3154871.80.help.text
msgid ""
"<emph>Number</emph> is the probability value for which the standard "
"logarithmic distribution is to be calculated."
msgstr ""
"<emph>Թիվ</emph> հավանականության արժեքն է, որի համար պետք է հաշվել ստանդարտ "
"լոգարիթմական բաշխումը:"

#: 04060183.xhp#par_id3155820.81.help.text
#: 04060183.xhp%23par_id3155820.81.help.text
msgid ""
"<emph>Mean</emph> (optional) is the mean value of the standard logarithmic "
"distribution."
msgstr ""
"<emph>Միջին</emph> (կամընտրական) ստանդարտ լոգարիթմական բաշխման միջին արժեքն "
"է:"

#: 04060183.xhp#par_id3155991.82.help.text
#: 04060183.xhp%23par_id3155991.82.help.text
msgid ""
"<emph>StDev</emph> (optional) is the standard deviation of the standard "
"logarithmic distribution."
msgstr ""
"<emph>StDev</emph> (կամընտրական) ստանդարտ լոգարիթմական բաշխման ստանդարտ "
"շեղումն է:"

#: 04060183.xhp#par_id3155992.help.text
#: 04060183.xhp%23par_id3155992.help.text
msgid ""
"<emph>Cumulative</emph> (optional) = 0 calculates the density function, "
"Cumulative = 1 calculates the distribution."
msgstr ""
"<emph>Կումուլյատիվ</emph> (կամընտրական) = 0 հաշվում է խտության գործառույթը, "
"Կումուլյատիվը = 1 հաշվում է բաշխումը:"

#: 04060183.xhp#hd_id3153178.83.help.text
#: 04060183.xhp%23hd_id3153178.83.help.text
msgctxt "04060183.xhp#hd_id3153178.83.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060183.xhp#par_id3149778.84.help.text
#: 04060183.xhp%23par_id3149778.84.help.text
msgid "<item type=\"input\">=LOGNORMDIST(0.1;0;1)</item> returns 0.01."
msgstr "<item type=\"input\">=LOGNORMDIST(0.1;0;1)</item> վերադարձնում է 0.01։"

#: 12090106.xhp#tit.help.text
#: 12090106.xhp%23tit.help.text
msgctxt "12090106.xhp#tit.help.text"
msgid "Data Field Options"
msgstr "Տվյալի դաշտի տարբերակներ"

#: 12090106.xhp#bm_id711386.help.text
#: 12090106.xhp%23bm_id711386.help.text
msgid ""
"<bookmark_value>hiding;data fields, from calculations in pivot "
"table</bookmark_value><bookmark_value>display options in pivot "
"table</bookmark_value><bookmark_value>sorting;options in pivot "
"table</bookmark_value><bookmark_value>data field options for pivot "
"table</bookmark_value>"
msgstr ""
"<bookmark_value>hiding;data fields, from calculations in pivot "
"table</bookmark_value><bookmark_value>display options in pivot "
"table</bookmark_value><bookmark_value>sorting;options in pivot "
"table</bookmark_value><bookmark_value>data field options for pivot "
"table</bookmark_value>"

#: 12090106.xhp#par_idN10542.help.text
#: 12090106.xhp%23par_idN10542.help.text
msgctxt "12090106.xhp#par_idN10542.help.text"
msgid "Data Field Options"
msgstr "Տվյալի դաշտի տարբերակներ"

#: 12090106.xhp#par_idN10546.help.text
#: 12090106.xhp%23par_idN10546.help.text
msgid ""
"You can specify additional options for column, row, and page data fields in "
"the <link href=\"text/scalc/01/12090105.xhp\">pivot table</link>."
msgstr ""
"Կարող եք նշել սյունակի, տողի և էջի տվյալների դաշտերի լրացուցիչ ընտրանքները <"
"link href=\"text/scalc/01/12090105.xhp\">առանցքային աղյուսակում</link>։"

#: 12090106.xhp#par_idN10557.help.text
#: 12090106.xhp%23par_idN10557.help.text
msgctxt "12090106.xhp#par_idN10557.help.text"
msgid "Sort by"
msgstr "Տեսակավորել ըստ"

#: 12090106.xhp#par_idN1055B.help.text
#: 12090106.xhp%23par_idN1055B.help.text
msgid ""
"<ahelp hid=\"1495387653\">Select the data field that you want to sort "
"columns or rows by.</ahelp>"
msgstr ""
"<ahelp hid=\"1495387653\">Ընտրեք տվյալների դաշտը, որով ցանկանում եք "
"տեսակավորել սյունակները կամ տողերը ըստ:</ahelp>"

#: 12090106.xhp#par_idN1055E.help.text
#: 12090106.xhp%23par_idN1055E.help.text
msgctxt "12090106.xhp#par_idN1055E.help.text"
msgid "Ascending"
msgstr "Աճող"

#: 12090106.xhp#par_idN10562.help.text
#: 12090106.xhp%23par_idN10562.help.text
msgid ""
"<ahelp hid=\"1495384580\">Sorts the values from the lowest value to the "
"highest value. If the selected field is the field for which the dialog was "
"opened, the items are sorted by name. If a data field was selected, the "
"items are sorted by the resultant value of the selected data field.</ahelp>"
msgstr ""
"<ahelp hid=\"1495384580\">Տեսակավորում են արժեքները ամենափոքրից մինչև "
"առավելագույնը: Եթե ընտրված դաշտը այն է, որի համար բացվեց երկխոսությունը, "
"նյութերը տեսակավորվում են ըստ անվան: Եթե ընտրվել է տվյալների դաշտը, ապա "
"տարրերը տեսակավորվում են ըստ ընտրված տվյալների դաշտի արդյունքային "
"արժեքի:</ahelp>"

#: 12090106.xhp#par_idN10565.help.text
#: 12090106.xhp%23par_idN10565.help.text
msgctxt "12090106.xhp#par_idN10565.help.text"
msgid "Descending"
msgstr "Նվազող"

#: 12090106.xhp#par_idN10569.help.text
#: 12090106.xhp%23par_idN10569.help.text
msgid ""
"<ahelp hid=\"1495384581\">Sorts the values descending from the highest value "
"to the lowest value. If the selected field is the field for which the dialog "
"was opened, the items are sorted by name. If a data field was selected, the "
"items are sorted by the resultant value of the selected data field.</ahelp>"
msgstr ""
"<ahelp hid=\"1495384581\">Տեսակավորում են ամենաբարձր արժեքից մինչև "
"նվազագույնը: Եթե ընտրված դաշտը այն է, որի համար բացվել է երկխոսությունը, "
"տարրերը տեսակավորվում են ըստ անվան: Եթե ընտրվել է տվյալների դաշտը, ապա "
"տարրերը տեսակավորվում են ըստ տվյալի ընտրված դաշտի արդյունքային "
"արժեքի.</ahelp>"

#: 12090106.xhp#par_idN1056C.help.text
#: 12090106.xhp%23par_idN1056C.help.text
msgid "Manual"
msgstr "Ձեռքով"

#: 12090106.xhp#par_idN10570.help.text
#: 12090106.xhp%23par_idN10570.help.text
msgid "<ahelp hid=\"1495384582\">Sorts values alphabetically.</ahelp>"
msgstr ""
"<ahelp hid=\"1495384582\">Արժեքները տեսակավորում է ըստ այբբենական "
"կարգի:</ahelp>"

#: 12090106.xhp#par_idN10585.help.text
#: 12090106.xhp%23par_idN10585.help.text
msgid "Display options"
msgstr "Արտածման ընտրանքները"

#: 12090106.xhp#par_idN10589.help.text
#: 12090106.xhp%23par_idN10589.help.text
msgid ""
"You can specify the display options for all row fields except for the last, "
"innermost row field."
msgstr ""
"Կարող եք ցուցադրել տողի բոլոր դաշտերը, բացառությամբ վերջին, ամենախոր տողի "
"դաշտի:"

#: 12090106.xhp#par_idN1058C.help.text
#: 12090106.xhp%23par_idN1058C.help.text
msgctxt "12090106.xhp#par_idN1058C.help.text"
msgid "Layout"
msgstr "Դասավորություն"

#: 12090106.xhp#par_idN10590.help.text
#: 12090106.xhp%23par_idN10590.help.text
msgid ""
"<ahelp hid=\"1495387654\">Select the layout mode for the field in the list "
"box.</ahelp>"
msgstr ""
"<ahelp hid=\"1495387654\">Ցանկի վանդակում ընտրեք դաշտի դասավորության "
"ռեժիմը:</ahelp>"

#: 12090106.xhp#par_idN10593.help.text
#: 12090106.xhp%23par_idN10593.help.text
msgid "Empty line after each item"
msgstr "Ամեն նյութից առաջ դատարկ տող"

#: 12090106.xhp#par_idN10597.help.text
#: 12090106.xhp%23par_idN10597.help.text
msgid ""
"<ahelp hid=\"1495385090\">Adds an empty row after the data for each item in "
"the pivot table.</ahelp>"
msgstr ""
"<ahelp hid=\"1495385090\">Առանցքային աղյուսակի յուրաքանչյուր տարրից հետո, "
"տվյալների համար ավելացվում է դատարկ տող:</ahelp>"

#: 12090106.xhp#par_idN1059A.help.text
#: 12090106.xhp%23par_idN1059A.help.text
msgid "Show automatically"
msgstr "Ցուցադրել ավտոմատ կերպով"

#: 12090106.xhp#par_idN1059E.help.text
#: 12090106.xhp%23par_idN1059E.help.text
msgid "Displays the top or bottom nn items when you sort by a specified field."
msgstr ""
"Ցուցադրում է վերևի կամ ներքևի nn կետերը, երբ տեսակավորվում եք ըստ նշված "
"դաշտի:"

#: 12090106.xhp#par_idN105A1.help.text
#: 12090106.xhp%23par_idN105A1.help.text
msgctxt "12090106.xhp#par_idN105A1.help.text"
msgid "Show"
msgstr "Ցույց տալ"

#: 12090106.xhp#par_idN105A5.help.text
#: 12090106.xhp%23par_idN105A5.help.text
msgid "<ahelp hid=\"1495385091\">Turns on the automatic show feature.</ahelp>"
msgstr ""
"<ahelp hid=\"1495385091\">Միացնում է ավտոմատ ցուցադրման "
"հնարավորությունը:</ahelp>"

#: 12090106.xhp#par_idN105A8.help.text
#: 12090106.xhp%23par_idN105A8.help.text
msgid "items"
msgstr "նյութեր"

#: 12090106.xhp#par_idN105AC.help.text
#: 12090106.xhp%23par_idN105AC.help.text
msgid ""
"<ahelp hid=\"1495390209\">Enter the maximum number of items that you want to "
"show automatically.</ahelp>"
msgstr ""
"<ahelp hid=\"1495390209\">Մուտքագրեք նյութերի այն առավելագույն քանակը, որը "
"ցանկանում եք ինքնաբերաբար ցուցադրել:</ahelp>"

#: 12090106.xhp#par_idN105AF.help.text
#: 12090106.xhp%23par_idN105AF.help.text
msgid "From"
msgstr "ից"

#: 12090106.xhp#par_idN105B3.help.text
#: 12090106.xhp%23par_idN105B3.help.text
msgid ""
"<ahelp hid=\"1495387655\">Shows the top or bottom items in the specified "
"sort order.</ahelp>"
msgstr ""
"<ahelp hid=\"1495387655\">Ցույց է տալիս վերևի կամ ներքևի կետերը, "
"տեսակավորման որոշված կարգով:</ahelp>"

#: 12090106.xhp#par_idN105B6.help.text
#: 12090106.xhp%23par_idN105B6.help.text
msgid "Using field"
msgstr "Դաշտի օգտագործում"

#: 12090106.xhp#par_idN105BA.help.text
#: 12090106.xhp%23par_idN105BA.help.text
msgid ""
"<ahelp hid=\"1495387656\">Select the data field that you want to sort the "
"data by.</ahelp>"
msgstr ""
"<ahelp hid=\"1495387656\">Ընտրեք տվյալների դաշտը, ըստ որի ցանկանում եք "
"տեսակավորել տվյալները:</ahelp>"

#: 12090106.xhp#par_idN105BD.help.text
#: 12090106.xhp%23par_idN105BD.help.text
msgid "Hide items"
msgstr "Թաքցնել կետերը"

#: 12090106.xhp#par_idN105C1.help.text
#: 12090106.xhp%23par_idN105C1.help.text
msgid ""
"<ahelp hid=\"59010\">Select the items that you want to hide from the "
"calculations.</ahelp>"
msgstr ""
"<ahelp hid=\"59010\">Ընտրեք այն կետերը, որոնք ցանկանում եք թաքցնել "
"հաշվարկներից:</ahelp>"

#: 12090106.xhp#par_idN105C4.help.text
#: 12090106.xhp%23par_idN105C4.help.text
msgid "Hierarchy"
msgstr "Հիերարխիա"

#: 12090106.xhp#par_idN105C8.help.text
#: 12090106.xhp%23par_idN105C8.help.text
msgid ""
"<ahelp hid=\"1495387657\">Select the hierarchy that you want to use. The "
