msgctxt "04060183.xhp#par_id3152986.6.help.text"
msgid "<emph>Data</emph> is the cell range of data."
msgstr "<emph>Տվյալներ</emph> տվյալների բջջային տիրույթն է:"

#: 04060183.xhp#par_id3156448.7.help.text
#: 04060183.xhp%23par_id3156448.7.help.text
msgid "<emph>RankC</emph> is the ranking of the value."
msgstr "<emph>RankC</emph> արժեքի դասակարգումն է:"

#: 04060183.xhp#hd_id3152889.8.help.text
#: 04060183.xhp%23hd_id3152889.8.help.text
msgctxt "04060183.xhp#hd_id3152889.8.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060183.xhp#par_id3148702.9.help.text
#: 04060183.xhp%23par_id3148702.9.help.text
msgid ""
"<item type=\"input\">=LARGE(A1:C50;2)</item> gives the second largest value "
"in A1:C50."
msgstr ""
"<item type=\"input\">=LARGE(A1:C50;2)</item> տալիս է երկրորդ մեծագույն "
"արժեքը A1:C50 -ում։"

#: 04060183.xhp#bm_id3154532.help.text
