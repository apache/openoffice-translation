#: 04060184.xhp%23par_id3147340.5.help.text
msgid "MAX(Number1; Number2; ...Number30)"
msgstr "MAX(Number1; Number2; ...Number30)"

#: 04060184.xhp#par_id3149568.6.help.text
#: 04060184.xhp%23par_id3149568.6.help.text
msgid ""
"<emph>Number1; Number2;...Number30</emph> are numerical values or ranges. "
msgstr ""
"<emph>Number1; Number2;...Number30</emph> թվային արժեքներ կամ տիրույթներ են։ "

#: 04060184.xhp#hd_id3153963.7.help.text
#: 04060184.xhp%23hd_id3153963.7.help.text
msgctxt "04060184.xhp#hd_id3153963.7.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060184.xhp#par_id3147343.8.help.text
#: 04060184.xhp%23par_id3147343.8.help.text
msgid ""
"<item type=\"input\">=MAX(A1;A2;A3;50;100;200)</item> returns the largest "
"value from the list."
msgstr ""
"<item type=\"input\">=MAX(A1;A2;A3;50;100;200)</item> ցուցակից վերադարձնում "
"է մեծագույն արժեքը։"

#: 04060184.xhp#par_id3148485.9.help.text
#: 04060184.xhp%23par_id3148485.9.help.text
msgid ""
"<item type=\"input\">=MAX(A1:B100)</item> returns the largest value from the "
"list."
msgstr ""
"<item type=\"input\">=MAX(A1:B100)</item>  ցուցակից վերադարձնում է մեծագույն "
"արժեքը։"

#: 04060184.xhp#bm_id3166426.help.text
#: 04060184.xhp%23bm_id3166426.help.text
msgid "<bookmark_value>MAXA function</bookmark_value>"
msgstr "<bookmark_value>MAXA function</bookmark_value>"

#: 04060184.xhp#hd_id3166426.139.help.text
#: 04060184.xhp%23hd_id3166426.139.help.text
msgid "MAXA"
msgstr "MAXA"

#: 04060184.xhp#par_id3150363.140.help.text
#: 04060184.xhp%23par_id3150363.140.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_MAXA\">Returns the maximum value in a list of "
"arguments. In opposite to MAX, here you can enter text. The value of the "
"text is 0.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_MAXA\">Վերադարձնում է առավելագույն արժեքը փաստարկների "
"ցանկում: Հակառակ MAX -ի, այստեղ կարող եք տեքստ մուտքագրել: Տեքստի արժեքը 0 "
"է:</ahelp>"

#: 04060184.xhp#par_id7689443.help.text
#: 04060184.xhp%23par_id7689443.help.text
msgctxt "04060184.xhp#par_id7689443.help.text"
msgid ""
"The functions MINA() and MAXA() return 0 if no value (numeric or text) and "
"no error was encountered."
msgstr ""
"MINA() և MAXA() գործառույթները վերադարձնում են 0, եթե որևէ արժեք (թվային կամ "
"տեքստ) և սխալ չի հայտնաբերվել:"

#: 04060184.xhp#hd_id3150516.141.help.text
#: 04060184.xhp%23hd_id3150516.141.help.text
msgctxt "04060184.xhp#hd_id3150516.141.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060184.xhp#par_id3166431.142.help.text
#: 04060184.xhp%23par_id3166431.142.help.text
msgid "MAXA(Value1; Value2; ... Value30)"
msgstr "MAXA(Value1; Value2; ... Value30)"

#: 04060184.xhp#par_id3150202.143.help.text
#: 04060184.xhp%23par_id3150202.143.help.text
msgctxt "04060184.xhp#par_id3150202.143.help.text"
msgid ""
"<emph>Value1; Value2;...Value30</emph> are values or ranges. Text has the "
"value of 0."
msgstr ""
"<emph>Value1; Value2;...Value30</emph> արժեքներ կամ միջակայքեր են: Տեքստն "
"ունի 0 արժեք:"

#: 04060184.xhp#hd_id3156290.144.help.text
#: 04060184.xhp%23hd_id3156290.144.help.text
msgctxt "04060184.xhp#hd_id3156290.144.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060184.xhp#par_id3156446.145.help.text
#: 04060184.xhp%23par_id3156446.145.help.text
msgid ""
"<item type=\"input\">=MAXA(A1;A2;A3;50;100;200;\"Text\")</item> returns the "
"largest value from the list."
msgstr ""
"<item type=\"input\">=MAXA(A1;A2;A3;50;100;200;\"Text\")</item> վերադարձնում "
"է ցուցակի ամենամեծ արժեքը:"

#: 04060184.xhp#par_id3149404.146.help.text
#: 04060184.xhp%23par_id3149404.146.help.text
