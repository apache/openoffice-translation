msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_RIGHT\">Ստեղծում է "
"ընտրված բջջային միջակայքում ձախից աջ գնացող շարքեր, օգտագործելով սահմանված "
"աճը մինչև վերջնական արժեք:</ahelp>"

#: 02140600.xhp#hd_id3146972.10.help.text
#: 02140600.xhp%23hd_id3146972.10.help.text
msgctxt "02140600.xhp#hd_id3146972.10.help.text"
msgid "Up"
msgstr "Վեր"

#: 02140600.xhp#par_id3153711.11.help.text
#: 02140600.xhp%23par_id3153711.11.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_TOP\">Creates an upward "
"series in the cell range of the column using the defined increment to the "
"end value.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_TOP\">Սյունակի բջջային "
"միջակայքում ստեղծում է դեպի վեր շարքեր, օգտագործելով սահմանված աճը մինչև "
"վերջնական արժեք:</ahelp>"

#: 02140600.xhp#hd_id3153764.12.help.text
#: 02140600.xhp%23hd_id3153764.12.help.text
msgctxt "02140600.xhp#hd_id3153764.12.help.text"
msgid "Left"
msgstr "Ձախ"

#: 02140600.xhp#par_id3156382.13.help.text
#: 02140600.xhp%23par_id3156382.13.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_LEFT\">Creates a series "
"running from right to left in the selected cell range using the defined "
"increment to the end value.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_LEFT\">Ստեղծում է "
"ընտրված բջջային միջակայքում աջից ձախ գնացող շարքեր, օգտագործելով սահմանված "
"աճը մինչև վերջնական արժեք:</ahelp>"

#: 02140600.xhp#hd_id3147344.14.help.text
#: 02140600.xhp%23hd_id3147344.14.help.text
msgid "Series Type"
msgstr "Շարքի տեսակ"

#: 02140600.xhp#par_id3149257.15.help.text
#: 02140600.xhp%23par_id3149257.15.help.text
msgid ""
"Defines the series type. Choose between <emph>Linear, Growth, Date </emph>"
"and <emph>AutoFill</emph>."
msgstr ""
"Սահմանում է շարքի տեսակը։ Ընտրեք <emph>Գծային, Աճ, Ամսաթիվ </emph>և "
"<emph>Ինքնալրացնել</emph> միջև։"

#: 02140600.xhp#hd_id3148488.16.help.text
#: 02140600.xhp%23hd_id3148488.16.help.text
msgid "Linear"
msgstr "Գծային"

#: 02140600.xhp#par_id3159238.17.help.text
#: 02140600.xhp%23par_id3159238.17.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_ARITHMETIC\">Creates a "
"linear number series using the defined increment and end value.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_ARITHMETIC\">Ստեղծում է "
"թվերի գծային շարք, օգտագործելով սահմանված աճը և վերջնական արժեքը:</ahelp>"

#: 02140600.xhp#hd_id3149210.18.help.text
#: 02140600.xhp%23hd_id3149210.18.help.text
msgid "Growth"
msgstr "Աճ"

#: 02140600.xhp#par_id3150364.19.help.text
#: 02140600.xhp%23par_id3150364.19.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_GEOMETRIC\">Creates a "
"growth series using the defined increment and end value.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_GEOMETRIC\">Ստեղծում է "
"աճի շարք, օգտագործելով սահմանված աճը և վերջնական արժեքը:</ahelp>"

#: 02140600.xhp#hd_id3149528.20.help.text
#: 02140600.xhp%23hd_id3149528.20.help.text
msgctxt "02140600.xhp#hd_id3149528.20.help.text"
msgid "Date"
msgstr "Ամսաթիվ"

#: 02140600.xhp#par_id3150887.21.help.text
#: 02140600.xhp%23par_id3150887.21.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DATE\">Creates a date "
"series using the defined increment and end date.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DATE\">Ստեղծում է "
"ամսաթվի շարքը, օգտագործելով սահմանված աճը և վերջնական ամսաթիվը:</ahelp>"

#: 02140600.xhp#hd_id3150202.22.help.text
#: 02140600.xhp%23hd_id3150202.22.help.text
msgid "AutoFill"
msgstr "Ինքնալրացնել"

#: 02140600.xhp#par_id3156288.23.help.text
#: 02140600.xhp%23par_id3156288.23.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_AUTOFILL\">Forms a "
"series directly in the sheet.</ahelp> The AutoFill function takes account of "
"customized lists. For example, by entering <emph>January</emph> in the first "
"cell, the series is completed using the list defined under <emph><"
"switchinline select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - %PRODUCTNAME Calc - Sort "
"Lists</emph>."
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_AUTOFILL\">Թերթում "
"ուղղակիորեն ձևավորում է շարք։</ahelp> Ինքնալրացնել գործառույթը հաշվի է "
"առնում հարմարեցված ցուցակները։ Օրինակ, առաջին բջիջում մուտքագրելով "
"<emph>Հունվար</emph> շարքը լրացվում է օգտագործելով <emph><switchinline "
"select=\"sys\"><caseinline select=\"MAC\">%PRODUCTNAME - "
"Նախապատվություններ</caseinline><defaultinline>Գործիքներ - "
"Ընտրանքներ</defaultinline></switchinline> - %PRODUCTNAME Calc - Տեսակավորման "
"ցուցակներ</emph> ներքո սահմանված ցուցակը։"

#: 02140600.xhp#par_id3155811.24.help.text
#: 02140600.xhp%23par_id3155811.24.help.text
msgid ""
"AutoFill tries to complete a value series by using a defined pattern. The "
"series 1,3,5 is automatically completed with 7,9,11,13, and so on. Date and "
"time series are completed accordingly; for example, after 01.01.99 and "
"15.01.99, an interval of 14 days is used."
msgstr ""
"Ինքնալրացումը փորձում է լրացնել արժեքային շարքը օգտագործելով սահմանված "
"ձևանմուշը: 1,3,5 շարքը ինքնաավարտվում է 7,9,11,13-ով և այլն: "
"Համապատասխանաբար ավարտվում են ամսաթվի և ժամանակի շարքերը. օրինակ, 01.01.99-"
"ից և 15.01.99-ից հետո օգտագործվում է 14 օրվա ընդմիջում:"

#: 02140600.xhp#hd_id3148700.25.help.text
#: 02140600.xhp%23hd_id3148700.25.help.text
msgid "Unit of Time"
msgstr "Ժամանի միավոր"

#: 02140600.xhp#par_id3153308.26.help.text
#: 02140600.xhp%23par_id3153308.26.help.text
msgid ""
"In this area you can specify the desired unit of time. This area is only "
"active if the <emph>Date</emph> option has been chosen in the <emph>Series "
"type</emph> area."
msgstr ""
"Այս միջակայքում կարող եք նշել ժամանակի ցանկալի միավորը: Այս տարածքը ակտիվ է "
"միայն այն դեպքում, երբ <emph>Ամսաթիվ</emph> տարբերակը ընտրվել է <emph>Շարքի "
"տեսակ</emph> տարածքում:"

#: 02140600.xhp#hd_id3148868.27.help.text
#: 02140600.xhp%23hd_id3148868.27.help.text
msgid "Day"
msgstr "Օր"

#: 02140600.xhp#par_id3148605.28.help.text
#: 02140600.xhp%23par_id3148605.28.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DAY\">Use the "
"<emph>Date</emph> series type and this option to create a series using seven "
"days.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DAY\">Օգտագործեք "
"<emph>Ամսաթիվ</emph> շարքի տեսակը և այս ընտրանքը՝ ստեղծելու յոթ օրից կազմված "
"շարք:</ahelp>"

#: 02140600.xhp#hd_id3144771.29.help.text
#: 02140600.xhp%23hd_id3144771.29.help.text
msgid "Weekday"
msgstr "Շաբաթվա օր"

#: 02140600.xhp#par_id3150108.30.help.text
#: 02140600.xhp%23par_id3150108.30.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DAY_OF_WEEK\">Use the "
"<emph>Date</emph> series type and this option to create a series of five day "
"sets.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_DAY_OF_WEEK\">"
"Օգտագործեք <emph>Ամսաթիվ</emph> շարքի տեսակը և այս ընտրանքը՝ ստեղծելու հինգ "
"օրից կազմված շարք:</ahelp>"

#: 02140600.xhp#hd_id3154957.31.help.text
#: 02140600.xhp%23hd_id3154957.31.help.text
msgid "Month"
msgstr "Ամիս"

#: 02140600.xhp#par_id3149126.32.help.text
#: 02140600.xhp%23par_id3149126.32.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_MONTH\">Use the "
"<emph>Date</emph> series type and this option to form a series from the "
"names or abbreviations of the months.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_MONTH\">Օգտագործեք "
"<emph>Ամսաթիվ</emph> շարքի տեսակը և այս ընտրանքը՝ ստեղծելու անուններից կամ "
"ամիսների հապավումներից կազմված շարք:</ahelp>"

#: 02140600.xhp#hd_id3152870.33.help.text
#: 02140600.xhp%23hd_id3152870.33.help.text
msgid "Year"
msgstr "Տարի"

#: 02140600.xhp#par_id3151300.34.help.text
#: 02140600.xhp%23par_id3151300.34.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_YEAR\">Use the "
"<emph>Date</emph> series type and this option to create a series of "
"years.</ahelp>"
msgstr ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_FILLSERIES:BTN_YEAR\">Օգտագործեք "
"<emph>Ամսաթիվ</emph> շարքի տեսակը և այս ընտրանքը, ստեղծելու տարիներից "
"կազմված շարք:</ahelp>"

#: 02140600.xhp#hd_id3154762.35.help.text
#: 02140600.xhp%23hd_id3154762.35.help.text
msgid "Start Value"
msgstr "Սկզբնական արժեք"

#: 02140600.xhp#par_id3149381.36.help.text
#: 02140600.xhp%23par_id3149381.36.help.text
msgid ""
"<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_START_VALUES\">Determines the "
"start value for the series.</ahelp> Use numbers, dates or times."
msgstr ""
"<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_START_VALUES\">Շարքի համար "
"սահմանում է սկզբնական արժեքը։</ahelp> Օգտագործեք թվեր, ամսաթվեր կամ ժամանակ։"

#: 02140600.xhp#hd_id3153013.37.help.text
#: 02140600.xhp%23hd_id3153013.37.help.text
msgid "End Value"
msgstr "Ավարտի ամսաթիվ"

#: 02140600.xhp#par_id3153487.38.help.text
#: 02140600.xhp%23par_id3153487.38.help.text
msgid ""
"<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_END_VALUES\">Determines the end "
"value for the series.</ahelp> Use numbers, dates or times."
msgstr ""
"<ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_END_VALUES\">Շարքի համար "
"սահմանում է ավարտի արժեքը։</ahelp> Օգտագործեք թվեր, ամսաթվեր կամ ժամանակ։"

#: 02140600.xhp#hd_id3149312.39.help.text
#: 02140600.xhp%23hd_id3149312.39.help.text
msgid "Increment"
msgstr "Աճ"

#: 02140600.xhp#par_id3154739.40.help.text
#: 02140600.xhp%23par_id3154739.40.help.text
msgid ""
"The term \"increment\" denotes the amount by which a given value increases.<"
"ahelp hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_INCREMENT\"> Determines the "
"value by which the series of the selected type increases by each "
"step.</ahelp> Entries can only be made if the linear, growth or date series "
"types have been selected."
msgstr ""
"«Աճ» տերմինը նշանակում է այն գումարը, որով ավելանում է տվյալ արժեքը:<ahelp "
"hid=\"SC:EDIT:RID_SCDLG_FILLSERIES:ED_INCREMENT\"> Որոշում է արժեքը, որով "
"ընտրված տեսակի շարքը աճում է յուրաքանչյուր քայլով:</ahelp> Մուտքեր կարող են "
"կատարվել միայն այն դեպքում, եթե ընտրվել են գծային, աճի կամ ամսաթվային շարքի "
"տեսակները:"

#: 05080400.xhp#tit.help.text
#: 05080400.xhp%23tit.help.text
msgctxt "05080400.xhp#tit.help.text"
msgid "Add"
msgstr "Ավելացնել"

#: 05080400.xhp#hd_id3149457.1.help.text
#: 05080400.xhp%23hd_id3149457.1.help.text
msgid "<link href=\"text/scalc/01/05080400.xhp\" name=\"Add\">Add</link>"
msgstr ""
"<link href=\"text/scalc/01/05080400.xhp\" name=\"Ավելացնել\">Ավելացնել</link>"

#: 05080400.xhp#par_id3156423.2.help.text
#: 05080400.xhp%23par_id3156423.2.help.text
msgid ""
"<ahelp hid=\".uno:AddPrintArea\">Adds the current selection to the defined "
"print areas.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:AddPrintArea\">Ավելացնում է ընթացիկ ընտրությունը տպելու "
"սահմանված տիրույթներում:</ahelp>"

#: 04050000.xhp#tit.help.text
#: 04050000.xhp%23tit.help.text
msgctxt "04050000.xhp#tit.help.text"
msgid "Insert Sheet"
msgstr "Ներդրեք թերթը"

#: 04050000.xhp#bm_id4522232.help.text
#: 04050000.xhp%23bm_id4522232.help.text
msgid "<bookmark_value>sheets;creating</bookmark_value>"
msgstr "<bookmark_value>թերթեր;ստեղծել</bookmark_value>"

#: 04050000.xhp#hd_id3155629.1.help.text
#: 04050000.xhp%23hd_id3155629.1.help.text
msgctxt "04050000.xhp#hd_id3155629.1.help.text"
msgid "Insert Sheet"
msgstr "Ներդրեք թերթը"

#: 04050000.xhp#par_id3147264.2.help.text
#: 04050000.xhp%23par_id3147264.2.help.text
msgid ""
"<variable id=\"tabelleeinfuegentext\"><ahelp hid=\".uno:Insert\">Defines the "
"options to be used to insert a new sheet.</ahelp> You can create a new "
"sheet, or insert an existing sheet from a file.</variable>"
msgstr ""
"<variable id=\"tabelleeinfuegentext\"><ahelp hid=\".uno:Insert\">Սահմանում է "
"նոր թերթ տեղադրելու համար օգտագործվող ընտրանքները:</ahelp> Կարող եք ստեղծել "
"նոր թերթ, կամ գոյություն ունեցող թերթ տեղադրել նիշքից:</variable>"

#: 04050000.xhp#hd_id3154684.19.help.text
#: 04050000.xhp%23hd_id3154684.19.help.text
msgid "Position"
msgstr "Դիրք"

#: 04050000.xhp#par_id3156281.20.help.text
#: 04050000.xhp%23par_id3156281.20.help.text
msgid "Specifies where the new sheet is to be inserted into your document."
msgstr "Նշում է, թե ձեր փաստաթղթում որտեղ է տեղադրվելու նոր թերթը:"

#: 04050000.xhp#hd_id3154123.21.help.text
#: 04050000.xhp%23hd_id3154123.21.help.text
msgid "Before current sheet"
msgstr "Ընթացիկ թերթից առաջ"

#: 04050000.xhp#par_id3145787.22.help.text
#: 04050000.xhp%23par_id3145787.22.help.text
msgid ""
"<ahelp hid=\"SC:RADIOBUTTON:RID_SCDLG_INSERT_TABLE:RB_BEFORE\">Inserts a new "
"sheet directly before the current sheet.</ahelp>"
msgstr ""
