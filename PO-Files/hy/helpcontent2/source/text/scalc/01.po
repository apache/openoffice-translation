#: 06070000.xhp#par_id3148798.2.help.text
#: 06070000.xhp%23par_id3148798.2.help.text
msgid ""
"<ahelp hid=\".uno:AutomaticCalculation\">Automatically recalculates all "
"formulas in the document.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:AutomaticCalculation\">Ավտոմատ կերպով վերահաշվարկում է "
"փաստաթղթում առկա բոլոր բանաձևերը:</ahelp>"

#: 06070000.xhp#par_id3145173.3.help.text
#: 06070000.xhp%23par_id3145173.3.help.text
msgid ""
"All cells are recalculated after a sheet cell has been modified. Any charts "
"in the sheet will also be refreshed."
msgstr ""
"Բոլոր բջիջները վերահաշվարկվում են, թերթի բջիջի թարմացումից հետո: Թերթի "
"ցանկացած գծապատկերները նույնպես կթարմացվեն:"

