msgstr ""
"<ahelp hid=\"SC:CHECKBOX:RID_SCDLG_NAMES:BTN_PRINTAREA\">Սահմանում է "
"տարածքը, որպես տպելու միջակայք։</ahelp>"

#: 04070100.xhp#hd_id3153764.19.help.text
#: 04070100.xhp%23hd_id3153764.19.help.text
