msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060118.xhp#par_id3146098.74.help.text
#: 04060118.xhp%23par_id3146098.74.help.text
msgid ""
"ODDFPRICE(Settlement; Maturity; Issue; FirstCoupon; Rate; Yield; Redemption; "
"Frequency; Basis)"
msgstr ""
"ODDFPRICE(Settlement; Maturity; Issue; FirstCoupon; Rate; Yield; Redemption; "
"Frequency; Basis)"

#: 04060118.xhp#par_id3153337.75.help.text
#: 04060118.xhp%23par_id3153337.75.help.text
msgctxt "04060118.xhp#par_id3153337.75.help.text"
msgid "<emph>Settlement</emph> is the date of purchase of the security."
msgstr "<emph>Համաձայնագիր</emph> արժեթղթի գնման ամսաթիվն է:"

#: 04060118.xhp#par_id3149051.76.help.text
#: 04060118.xhp%23par_id3149051.76.help.text
msgctxt "04060118.xhp#par_id3149051.76.help.text"
msgid ""
"<emph>Maturity</emph> is the date on which the security matures (expires)."
msgstr ""
"<emph>Մարում</emph> այն ամսաթիվն է, որի ընթացքում հասունանում է արժեթղթի "
"ժամկետը (լրանում է):"

#: 04060118.xhp#par_id3147297.77.help.text
#: 04060118.xhp%23par_id3147297.77.help.text
msgctxt "04060118.xhp#par_id3147297.77.help.text"
msgid "<emph>Issue</emph> is the date of issue of the security."
msgstr "<emph>Թողարկում</emph> արժեթղթի թողարկման ամսաթիվն է։"

#: 04060118.xhp#par_id3150393.78.help.text
#: 04060118.xhp%23par_id3150393.78.help.text
msgid "<emph>FirstCoupon</emph> is the first interest date of the security."
msgstr "<emph>FirstCoupon</emph> արժեթղթի առաջին տոկոսի ամսաթիվն է:"

#: 04060118.xhp#par_id3147402.79.help.text
#: 04060118.xhp%23par_id3147402.79.help.text
