msgid "EXP"
msgstr "EXP"

#: 04060106.xhp#par_id3150592.199.help.text
#: 04060106.xhp%23par_id3150592.199.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_EXP\">Returns e raised to the power of a "
"number.</ahelp> The constant e has a value of approximately 2.71828182845904."
msgstr ""
"<ahelp hid=\"HID_FUNC_EXP\">Վերադարձնում է e բարձրացված թվի աստիճան։</ahelp> "
"e հաստատունի մոտավոր արժեքն է 2.71828182845904։"

#: 04060106.xhp#hd_id3150351.200.help.text
#: 04060106.xhp%23hd_id3150351.200.help.text
msgctxt "04060106.xhp#hd_id3150351.200.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3146786.201.help.text
#: 04060106.xhp%23par_id3146786.201.help.text
msgid "EXP(Number)"
msgstr "EXP(Number)"

#: 04060106.xhp#par_id3155608.202.help.text
#: 04060106.xhp%23par_id3155608.202.help.text
msgid "<emph>Number</emph> is the power to which e is to be raised."
msgstr "<emph>Թիվ</emph> աստիճանն է, որով պետք է բարձրացվի e -ն։"

#: 04060106.xhp#hd_id3154418.203.help.text
#: 04060106.xhp%23hd_id3154418.203.help.text
msgctxt "04060106.xhp#hd_id3154418.203.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3156340.204.help.text
#: 04060106.xhp%23par_id3156340.204.help.text
msgid ""
"<item type=\"input\">=EXP(1)</item> returns 2.71828182845904, the "
"mathematical constant e to Calc's accuracy."
msgstr ""
"<item type=\"input\">=EXP(1)</item> վերադարձնում է 2.71828182845904, e -ի "
"մաթեմատիկական հաստատունը Calc -ի ճշգրտության աստիճանով։"

#: 04060106.xhp#bm_id3145781.help.text
#: 04060106.xhp%23bm_id3145781.help.text
msgid ""
"<bookmark_value>FACT "
"function</bookmark_value><bookmark_value>factorials;numbers</bookmark_value>"
msgstr ""
"<bookmark_value>FACT "
"function</bookmark_value><bookmark_value>factorials;numbers</bookmark_value>"

#: 04060106.xhp#hd_id3145781.208.help.text
#: 04060106.xhp%23hd_id3145781.208.help.text
msgid "FACT"
msgstr "FACT"

#: 04060106.xhp#par_id3151109.209.help.text
#: 04060106.xhp%23par_id3151109.209.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_FAKULTAET\">Returns the factorial of a number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_FAKULTAET\">Վերադարձնում է թվի ֆակտորիալը։</ahelp>"

#: 04060106.xhp#hd_id3146902.210.help.text
#: 04060106.xhp%23hd_id3146902.210.help.text
msgctxt "04060106.xhp#hd_id3146902.210.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3154661.211.help.text
#: 04060106.xhp%23par_id3154661.211.help.text
msgid "FACT(Number)"
msgstr "FACT(Number)"

#: 04060106.xhp#par_id3152952.212.help.text
#: 04060106.xhp%23par_id3152952.212.help.text
msgid ""
" Returns Number!, the factorial of <emph>Number</emph>, calculated as "
"1*2*3*4* ... * Number."
msgstr ""
" Վերադարձնում է Number!, <emph>Թիվ</emph> ֆակտորիալն է, հաշվարկված որպես "
"1*2*3*4* ... * Թիվ։"

#: 04060106.xhp#par_id3834650.help.text
#: 04060106.xhp%23par_id3834650.help.text
msgid "=FACT(0) returns 1 by definition. "
msgstr "=FACT(0) վերադարձնում է 1 ըստ սահմանման։"

#: 04060106.xhp#par_id8429517.help.text
#: 04060106.xhp%23par_id8429517.help.text
msgid ""
"The factorial of a negative number returns the \"invalid argument\" error."
msgstr "Բացասական թվի ֆակտորիալը վերադարձնում է «անվավեր փաստարկ» սխալը:"

#: 04060106.xhp#hd_id3154569.213.help.text
#: 04060106.xhp%23hd_id3154569.213.help.text
msgctxt "04060106.xhp#hd_id3154569.213.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3154476.216.help.text
#: 04060106.xhp%23par_id3154476.216.help.text
msgid "<item type=\"input\">=FACT(3)</item> returns 6."
msgstr "<item type=\"input\">=FACT(3)</item> վերադարձնում է 6։"

#: 04060106.xhp#par_id3147525.214.help.text
#: 04060106.xhp%23par_id3147525.214.help.text
msgid "<item type=\"input\">=FACT(0)</item> returns 1."
msgstr "<item type=\"input\">=FACT(0)</item> վերադարձնում է 1։"

#: 04060106.xhp#bm_id3159084.help.text
#: 04060106.xhp%23bm_id3159084.help.text
msgid ""
"<bookmark_value>INT function</bookmark_value><bookmark_value>numbers;"
"rounding down to next integer</bookmark_value><bookmark_value>rounding;down "
"to next integer</bookmark_value>"
msgstr ""
"<bookmark_value>INT function</bookmark_value><bookmark_value>numbers;"
"rounding down to next integer</bookmark_value><bookmark_value>rounding;down "
"to next integer</bookmark_value>"

#: 04060106.xhp#hd_id3159084.218.help.text
#: 04060106.xhp%23hd_id3159084.218.help.text
msgid "INT"
msgstr "INT"

#: 04060106.xhp#par_id3158441.219.help.text
#: 04060106.xhp%23par_id3158441.219.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_GANZZAHL\">Rounds a number down to the nearest "
"integer.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_GANZZAHL\">Կլորացնում է թիվը ներքև, դեպի ամենամոտ "
"ամբողջը:</ahelp>"

#: 04060106.xhp#hd_id3146132.220.help.text
#: 04060106.xhp%23hd_id3146132.220.help.text
msgctxt "04060106.xhp#hd_id3146132.220.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3156146.221.help.text
#: 04060106.xhp%23par_id3156146.221.help.text
msgid "INT(Number)"
msgstr "INT(Number)"

#: 04060106.xhp#par_id3154117.222.help.text
#: 04060106.xhp%23par_id3154117.222.help.text
msgid "Returns <emph>Number</emph> rounded down to the nearest integer."
msgstr "Վերադարձնում է <emph>Թիվ</emph> կլորացված ներքև, դեպի ամենամոտ ամբողջը:"

#: 04060106.xhp#par_id153508.help.text
#: 04060106.xhp%23par_id153508.help.text
msgid "Negative numbers round down to the integer below."
msgstr "Բացասական թվերը կլորացվում են ներքև դեպի ներքևի ամբողջը։"

#: 04060106.xhp#hd_id3155118.223.help.text
#: 04060106.xhp%23hd_id3155118.223.help.text
msgctxt "04060106.xhp#hd_id3155118.223.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3156267.224.help.text
#: 04060106.xhp%23par_id3156267.224.help.text
msgid "<item type=\"input\">=INT(5.7)</item> returns 5."
msgstr "<item type=\"input\">=INT(5.7)</item> վերադարձնում է 5։"

#: 04060106.xhp#par_id3147323.225.help.text
#: 04060106.xhp%23par_id3147323.225.help.text
msgid "<item type=\"input\">=INT(-1.3)</item> returns -2."
msgstr "<item type=\"input\">=INT(-1.3)</item> վերադարձնում է -2։"

#: 04060106.xhp#bm_id3150938.help.text
#: 04060106.xhp%23bm_id3150938.help.text
msgid ""
"<bookmark_value>EVEN function</bookmark_value><bookmark_value>numbers;"
"rounding up/down to even "
"integers</bookmark_value><bookmark_value>rounding;up/down to even "
"integers</bookmark_value>"
msgstr ""
"<bookmark_value>EVEN function</bookmark_value><bookmark_value>numbers;"
"rounding up/down to even "
"integers</bookmark_value><bookmark_value>rounding;up/down to even "
"integers</bookmark_value>"

#: 04060106.xhp#hd_id3150938.227.help.text
#: 04060106.xhp%23hd_id3150938.227.help.text
msgid "EVEN"
msgstr "EVEN"

#: 04060106.xhp#par_id3149988.228.help.text
#: 04060106.xhp%23par_id3149988.228.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_GERADE\">Rounds a positive number up to the next even "
"integer and a negative number down to the next even integer.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_GERADE\">Կլորացնում է դրական թիվը վեր մինչև հաջորդ "
"զույգ ամբողջը, և բացասական թիվը ներքև, մինչև հաջորդ զույգ ամբողջ "
"թիվը։</ahelp>"

#: 04060106.xhp#hd_id3148401.229.help.text
#: 04060106.xhp%23hd_id3148401.229.help.text
msgctxt "04060106.xhp#hd_id3148401.229.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3150830.230.help.text
#: 04060106.xhp%23par_id3150830.230.help.text
msgid "EVEN(Number)"
msgstr "EVEN(Number)"

#: 04060106.xhp#par_id3153350.231.help.text
#: 04060106.xhp%23par_id3153350.231.help.text
msgid ""
" Returns <emph>Number</emph> rounded to the next even integer up, away from "
"zero. "
msgstr ""
" Վերադարձնում է <emph>Թիվ</emph> կլորացված վեր մինչև հաջորդ զույգ ամբողջը, "
"զրոյից հեռու: "

#: 04060106.xhp#hd_id3155508.232.help.text
#: 04060106.xhp%23hd_id3155508.232.help.text
msgctxt "04060106.xhp#hd_id3155508.232.help.text"
msgid "Examples"
msgstr "Օրինակներ"

#: 04060106.xhp#par_id3154361.233.help.text
#: 04060106.xhp%23par_id3154361.233.help.text
msgid "<item type=\"input\">=EVEN(2.3)</item> returns 4."
msgstr "<item type=\"input\">=EVEN(2.3)</item> վերադարձնում է 4։"

#: 04060106.xhp#par_id8477736.help.text
#: 04060106.xhp%23par_id8477736.help.text
msgid "<item type=\"input\">=EVEN(2)</item> returns 2."
msgstr "<item type=\"input\">=EVEN(2)</item> վերադարձնում է 2։"

#: 04060106.xhp#par_id159611.help.text
#: 04060106.xhp%23par_id159611.help.text
msgid "<item type=\"input\">=EVEN(0)</item> returns 0."
msgstr "<item type=\"input\">=EVEN(0)</item> վերադարձնում է 0։"

#: 04060106.xhp#par_id6097598.help.text
#: 04060106.xhp%23par_id6097598.help.text
msgid "<item type=\"input\">=EVEN(-0.5)</item> returns -2."
msgstr "<item type=\"input\">=EVEN(-0.5)</item> վերադարձնում է -2։"

#: 04060106.xhp#bm_id3147356.help.text
#: 04060106.xhp%23bm_id3147356.help.text
msgid ""
"<bookmark_value>GCD function</bookmark_value><bookmark_value>greatest common "
"divisor</bookmark_value>"
msgstr ""
"<bookmark_value>GCD function</bookmark_value><bookmark_value>ամենամեծ "
"ընդհանուր բաժանարար</bookmark_value>"

#: 04060106.xhp#hd_id3147356.237.help.text
#: 04060106.xhp%23hd_id3147356.237.help.text
msgid "GCD"
msgstr "GCD"

#: 04060106.xhp#par_id3152465.238.help.text
#: 04060106.xhp%23par_id3152465.238.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_GGT\">Returns the greatest common divisor of two or "
"more integers.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_GGT\">Վերադարձնում է երկու կամ ավելի ամբողջ թվերի "
"ամենամեծ ընդհանուր բաժանարարը:</ahelp>"

#: 04060106.xhp#par_id2769249.help.text
#: 04060106.xhp%23par_id2769249.help.text
msgid ""
"The greatest common divisor is the positive largest integer which will "
"divide, without remainder, each of the given integers."
msgstr ""
"Ամենամեծ ընդհանուր բաժանարարը դրական ամենամեծ ամբողջն է, որի վրա առանց "
"մնացորդի կբաժանվեն բոլոր տրված ամբողջները։"

#: 04060106.xhp#hd_id3150643.239.help.text
#: 04060106.xhp%23hd_id3150643.239.help.text
msgctxt "04060106.xhp#hd_id3150643.239.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3154524.240.help.text
#: 04060106.xhp%23par_id3154524.240.help.text
msgid "GCD(Integer1; Integer2; ...; Integer30)"
msgstr "GCD(Integer1; Integer2; ...; Integer30)"

#: 04060106.xhp#par_id3149340.241.help.text
#: 04060106.xhp%23par_id3149340.241.help.text
msgid ""
"<emph>Integer1 To 30</emph> are up to 30 integers whose greatest common "
"divisor is to be calculated."
msgstr ""
"<emph>Integer1 մինչև 30</emph> մինչև 30 ամբողջ թիվ, որոնց ամենամեծ ընդհանուր "
"բաժանարարը պետք է հաշվարկվի:"

#: 04060106.xhp#hd_id3147317.242.help.text
#: 04060106.xhp%23hd_id3147317.242.help.text
msgctxt "04060106.xhp#hd_id3147317.242.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3151285.243.help.text
#: 04060106.xhp%23par_id3151285.243.help.text
msgid ""
"<item type=\"input\">=GCD(16;32;24) </item>gives the result 8, because 8 is "
"the largest number that can divide 16, 24 and 32 without a remainder."
msgstr ""
"<item type=\"input\">=GCD(16;32;24) </item>արդյունքը տալիս է 8, քանի որ 8-ը "
"ամենամեծ թիվն է, որը կարող է բաժանել 16-ը, 24-ը և 32-ը առանց մնացորդի:"

#: 04060106.xhp#par_id1604663.help.text
#: 04060106.xhp%23par_id1604663.help.text
msgid ""
"<item type=\"input\">=GCD(B1:B3)</item> where cells B1, B2, B3 contain <item "
"type=\"input\">9</item>, <item type=\"input\">12</item>, <item type=\"input\""
">9</item> gives 3."
msgstr ""
"<item type=\"input\">=GCD(B1:B3)</item> որտեղ B1, B2, B3 բջիջները "
"պարունակում են <item type=\"input\">9</item>, <item type=\"input\">12</item>"
", <item type=\"input\">9</item> տալիս է 3։"

#: 04060106.xhp#bm_id3151221.help.text
#: 04060106.xhp%23bm_id3151221.help.text
msgid "<bookmark_value>GCD_ADD function</bookmark_value>"
msgstr "<bookmark_value>GCD_ADD function</bookmark_value>"

#: 04060106.xhp#hd_id3151221.677.help.text
#: 04060106.xhp%23hd_id3151221.677.help.text
msgid "GCD_ADD"
msgstr "GCD_ADD"

#: 04060106.xhp#par_id3153257.678.help.text
#: 04060106.xhp%23par_id3153257.678.help.text
msgid ""
"<ahelp hid=\"HID_AAI_FUNC_GCD\"> The result is the greatest common divisor "
"of a list of numbers.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_AAI_FUNC_GCD\"> Արդյունքը թվերի ցուցակի ամենամեծ ընդհանուր "
"բաժանարարն է:</ahelp>"

#: 04060106.xhp#hd_id3147548.679.help.text
#: 04060106.xhp%23hd_id3147548.679.help.text
msgctxt "04060106.xhp#hd_id3147548.679.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3156205.680.help.text
#: 04060106.xhp%23par_id3156205.680.help.text
msgid "GCD_ADD(Number(s))"
msgstr "GCD_ADD(Number(s))"

#: 04060106.xhp#par_id3145150.681.help.text
#: 04060106.xhp%23par_id3145150.681.help.text
msgctxt "04060106.xhp#par_id3145150.681.help.text"
msgid "<emph>Number(s)</emph> is a list of up to 30 numbers."
msgstr "<emph>Թվեր</emph> մինչև 30 թվերի ցուցակ է:"

#: 04060106.xhp#hd_id3150239.682.help.text
#: 04060106.xhp%23hd_id3150239.682.help.text
msgctxt "04060106.xhp#hd_id3150239.682.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3159192.683.help.text
#: 04060106.xhp%23par_id3159192.683.help.text
msgid "<item type=\"input\">=GCD_ADD(5;15;25)</item> returns 5."
msgstr "<item type=\"input\">=GCD_ADD(5;15;25)</item> վերադարձնում է 5։"

#: 04060106.xhp#bm_id3156048.help.text
#: 04060106.xhp%23bm_id3156048.help.text
msgid ""
"<bookmark_value>ISEVEN function</bookmark_value><bookmark_value>even "
"integers</bookmark_value>"
msgstr ""
"<bookmark_value>ISEVEN function</bookmark_value><bookmark_value>even "
"integers</bookmark_value>"

#: 04060106.xhp#hd_id3156048.245.help.text
#: 04060106.xhp%23hd_id3156048.245.help.text
msgid "ISEVEN"
msgstr "ISEVEN"

#: 04060106.xhp#par_id3149169.246.help.text
#: 04060106.xhp%23par_id3149169.246.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_ISTGERADE\">Returns TRUE if the value is an even "
"integer, or FALSE if the value is odd.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_ISTGERADE\">Վերադարձնում է TRUE, եթե արժեքը զույգ "
"ամբողջ թիվ է, կամ FALSE, եթե արժեքը կենտ է:</ahelp>"

#: 04060106.xhp#hd_id3146928.247.help.text
#: 04060106.xhp%23hd_id3146928.247.help.text
msgctxt "04060106.xhp#hd_id3146928.247.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3151203.248.help.text
#: 04060106.xhp%23par_id3151203.248.help.text
msgid "ISEVEN(Value)"
msgstr "ISEVEN(Value)"

#: 04060106.xhp#par_id3150491.249.help.text
#: 04060106.xhp%23par_id3150491.249.help.text
msgctxt "04060106.xhp#par_id3150491.249.help.text"
msgid "<emph>Value</emph> is the value to be checked."
msgstr "<emph>Արժեք</emph> ստուգման ենթակա արժեքն է:"

#: 04060106.xhp#par_id3445844.help.text
#: 04060106.xhp%23par_id3445844.help.text
msgctxt "04060106.xhp#par_id3445844.help.text"
msgid ""
"If Value is not an integer any digits after the decimal point are ignored. "
"The sign of Value is also ignored."
msgstr ""
