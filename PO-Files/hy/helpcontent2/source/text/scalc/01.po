msgstr "ATANH(Number)"

#: 04060106.xhp#par_id3150521.134.help.text
#: 04060106.xhp%23par_id3150521.134.help.text
msgid ""
" This function returns the inverse hyperbolic tangent of <emph>Number</emph>"
", that is the number whose hyperbolic tangent is Number. "
msgstr ""
" Այս գործառույթը վերադարձնում է <emph>Թիվ</emph> հակադարձ հիպերբոլիկ "
"տանգեսը, այսինքն այն թիվը, որի հիպերբոլիկ տանգեսը Թիվ է: "

#: 04060106.xhp#par_id9357280.help.text
#: 04060106.xhp%23par_id9357280.help.text
msgid " Number must obey the condition -1 < number < 1."
msgstr " Թիվը պետք է ենթարկվի պայմանին -1 < թիվ < 1։"

#: 04060106.xhp#hd_id3148450.135.help.text
#: 04060106.xhp%23hd_id3148450.135.help.text
msgctxt "04060106.xhp#hd_id3148450.135.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3145419.136.help.text
#: 04060106.xhp%23par_id3145419.136.help.text
msgid "<item type=\"input\">=ATANH(0)</item> returns 0."
msgstr "<item type=\"input\">=ATANH(0)</item> վերադարձնում է 0։"

