#: 04060116.xhp#par_id0908200903061174.help.text
#: 04060116.xhp%23par_id0908200903061174.help.text
msgid ""
"Information units \"bit\" and \"byte\" may also be prefixed by one of the "
"following IEC 60027-2 / IEEE 1541 prefixes:"
msgstr ""
"\"Բիթ\" և \"բայթ\" տեղեկատվական միավորների համար կարող են օգտագործվել նաև "
"նախածանցներ հետևյալներից՝ IEC 60027-2 / IEEE 1541․"

#: 04060116.xhp#par_id0908200903090966.help.text
#: 04060116.xhp%23par_id0908200903090966.help.text
msgid "ki kibi 1024"
msgstr "ki kibi 1024"

#: 04060116.xhp#par_id0908200903090958.help.text
#: 04060116.xhp%23par_id0908200903090958.help.text
