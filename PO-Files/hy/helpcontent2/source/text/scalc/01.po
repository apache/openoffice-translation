msgstr "TIMEVALUE "

#: func_timevalue.xhp#bm_id3146755.help.text
#: func_timevalue.xhp%23bm_id3146755.help.text
msgid "<bookmark_value>TIMEVALUE function</bookmark_value>"
msgstr "<bookmark_value>TIMEVALUE function</bookmark_value>"

#: func_timevalue.xhp#hd_id3146755.160.help.text
#: func_timevalue.xhp%23hd_id3146755.160.help.text
msgid ""
"<variable id=\"timevalue\"><link href=\"text/scalc/01/func_timevalue.xhp\""
">TIMEVALUE</link></variable>"
msgstr ""
"<variable id=\"timevalue\"><link href=\"text/scalc/01/func_timevalue.xhp\""
">TIMEVALUE</link></variable>"

#: func_timevalue.xhp#par_id3148502.161.help.text
#: func_timevalue.xhp%23par_id3148502.161.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_ZEITWERT\">TIMEVALUE returns the internal time number "
"from a text enclosed by quotes and which may show a possible time entry "
"format.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_ZEITWERT\">TIMEVALUE վերադարձնում է ներքին ժամանակի "
"թիվը չակերտներում ներառված տեքստից, և որը կարող է ցույց տալ ժամանակի մուտքի "
"հնարավոր ձևաչափը:</ahelp>"

#: func_timevalue.xhp#par_id3150794.162.help.text
#: func_timevalue.xhp%23par_id3150794.162.help.text
msgid ""
"The internal number indicated as a decimal is the result of the date system "
"used under $[officename] to calculate date entries."
msgstr ""
"Որպես տասնորդական նշված ներքին թիվը արդյունք է այն ամսաթվերի համակարգի, որն "
"օգտագործվում է $[officename] ներքո, ամսաթվի մուտքերը հաշվելու համար:"

#: func_timevalue.xhp#par_id011920090347118.help.text
#: func_timevalue.xhp%23par_id011920090347118.help.text
msgid ""
"If the text string also includes a year, month, or day, TIMEVALUE only "
"returns the fractional part of the conversion."
msgstr ""
"Եթե տեքստի տողը ներառում է նաև տարի, ամիս կամ օր, ապա TIMEVALUE միայն "
"վերադարձնում է ձևափոխման կոտորակային մասը:"

#: func_timevalue.xhp#hd_id3150810.163.help.text
#: func_timevalue.xhp%23hd_id3150810.163.help.text
msgctxt "func_timevalue.xhp#hd_id3150810.163.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: func_timevalue.xhp#par_id3150823.164.help.text
#: func_timevalue.xhp%23par_id3150823.164.help.text
msgid "TIMEVALUE(\"Text\")"
msgstr "TIMEVALUE(\"Text\")"

#: func_timevalue.xhp#par_id3152556.165.help.text
#: func_timevalue.xhp%23par_id3152556.165.help.text
msgid ""
"         <emph>Text</emph> is a valid time expression and must be entered in "
"quotation marks."
msgstr ""
"         <emph>Տեքստ</emph> ժամանակի վավեր արտահայտություն է և պետք է "
"մուտքագրվի չակերտների մեջ:"

#: func_timevalue.xhp#hd_id3146815.166.help.text
#: func_timevalue.xhp%23hd_id3146815.166.help.text
msgctxt "func_timevalue.xhp#hd_id3146815.166.help.text"
msgid "Examples"
msgstr "Օրինակներ"

#: func_timevalue.xhp#par_id3146829.167.help.text
#: func_timevalue.xhp%23par_id3146829.167.help.text
msgid ""
"         <item type=\"input\">=TIMEVALUE(\"4PM\")</item> returns 0.67. When "
"formatting in time format HH:MM:SS, you then get 16:00:00."
msgstr ""
"         <item type=\"input\">=TIMEVALUE(\"4PM\")</item> վերադարձնում է 0.67։"
" Երբ ձևաչափում եք Ժամանակի ԺԺ:ՐՐ:ՎՎ ձևաչափով, ստանում եք 16:00:00։"

#: func_timevalue.xhp#par_id3153632.168.help.text
#: func_timevalue.xhp%23par_id3153632.168.help.text
msgid ""
"         <item type=\"input\">=TIMEVALUE(\"24:00\")</item> returns 1. If you "
"use the HH:MM:SS time format, the value is 00:00:00."
msgstr ""
"         <item type=\"input\">=TIMEVALUE(\"24:00\")</item> վերադարձնում է 1։ "
"Եթե օգտագործում եք ժամանակի ԺԺ:ՐՐ:ՎՎ ձևաչափը, արժեքն է 00:00:00․"

#: 12090300.xhp#tit.help.text
#: 12090300.xhp%23tit.help.text
