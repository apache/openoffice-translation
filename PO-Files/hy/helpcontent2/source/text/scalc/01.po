"<ahelp hid=\"HID_FUNC_KGV\">Returns the least common multiple of one or more "
"integers.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_KGV\">Վերադարձնում է մեկ կամ մի քանի ամբողջ թվերից "
"ամենափոքր ընդհանուր բազմապատիկը:</ahelp>"

#: 04060106.xhp#hd_id3148632.267.help.text
#: 04060106.xhp%23hd_id3148632.267.help.text
msgctxt "04060106.xhp#hd_id3148632.267.help.text"
