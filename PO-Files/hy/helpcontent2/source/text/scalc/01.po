msgid "<bookmark_value>QUARTILE function</bookmark_value>"
msgstr "<bookmark_value>QUARTILE function</bookmark_value>"

#: 04060184.xhp#hd_id3166442.130.help.text
#: 04060184.xhp%23hd_id3166442.130.help.text
msgid "QUARTILE"
msgstr "QUARTILE"

#: 04060184.xhp#par_id3146958.131.help.text
#: 04060184.xhp%23par_id3146958.131.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_QUARTILE\">Returns the quartile of a data set.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_QUARTILE\">Վերադարձնում է տվյալների հավաքածուի "
"կվարտիլը:</ahelp>"

#: 04060184.xhp#hd_id3152942.132.help.text
#: 04060184.xhp%23hd_id3152942.132.help.text
msgctxt "04060184.xhp#hd_id3152942.132.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

