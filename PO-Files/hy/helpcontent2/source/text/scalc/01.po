msgid "Logical Functions"
msgstr "Տրամաբանական գործառույթներ"

#: 04060105.xhp#bm_id3153484.help.text
#: 04060105.xhp%23bm_id3153484.help.text
msgid ""
"<bookmark_value>logical functions</bookmark_value>      <bookmark_value>"
"Function Wizard; logical</bookmark_value>      <bookmark_value>functions; "
"logical functions</bookmark_value>"
msgstr ""
"<bookmark_value>logical functions</bookmark_value>      <bookmark_value>"
"Function Wizard; logical</bookmark_value>      <bookmark_value>functions; "
"logical functions</bookmark_value>"

#: 04060105.xhp#hd_id3153484.1.help.text
#: 04060105.xhp%23hd_id3153484.1.help.text
