#: 02120000.xhp#par_id3151073.2.help.text
#: 02120000.xhp%23par_id3151073.2.help.text
msgid ""
"<variable id=\"kopfundfusszeilentext\"><ahelp hid=\".uno:"
"EditHeaderAndFooter\">Allows you to define and format headers and "
"footers.</ahelp></variable>"
msgstr ""
"<variable id=\"kopfundfusszeilentext\"><ahelp hid=\".uno:"
"EditHeaderAndFooter\">Թույլ է տալիս սահմանել և ձևավորել Էջագլուխները և "
"Էջատակերը։</ahelp></variable>"

#: 02120000.xhp#par_id3153415.3.help.text
#: 02120000.xhp%23par_id3153415.3.help.text
msgid ""
"The<emph> Headers/Footers </emph>dialog contains the tabs for defining "
"headers and footers. There will be separate tabs for the left and right page "
"headers and footers if the <emph>Same content left/right</emph> option was "
"not marked in the <link href=\"text/scalc/01/05070000.xhp\" name=\"Page "
"Style\">Page Style</link> dialog."
msgstr ""
"<emph> Էջագլուխներ/Էջատակեր </emph>երկխոսությունը պարունակում է ներդիրներներ "
"էջագլուխները և էջատակերը որոշելու համար: Կլինեն առանձին ներդիրներ էջի ձախ և "
"աջ էջագլուխների և էջատակերի համար, եթե <emph>Նույն բովանդակությունը "
"ձախ/աջ</emph> ընտրանքը ընտրված չէ <link href=\"text/scalc/01/05070000.xhp\" "
"name=\"Էջի ոճ\">Էջի ոճ</link> երկխոսությունում։"

