#: solver.xhp#par_id9210486.help.text
#: solver.xhp%23par_id9210486.help.text
msgid ""
"<ahelp hid=\".\">Opens the Solver dialog. A solver allows to solve equations "
"with multiple unknown variables by goal seeking methods.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Բացում է Լուծիչի երկխոսությունը։ Լուծողը թույլ է տալիս "
"լուծել բազմաթիվ անհայտ փոփոխականներով հավասարումներ, նպատակների որոնման "
"մեթոդներով:</ahelp>"

#: solver.xhp#par_id8538773.help.text
#: solver.xhp%23par_id8538773.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Enter or click the cell reference of "
"the target cell. This field takes the address of the cell whose value is to "
"be optimized.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Մուտքագրեք կամ կտտացրեք թիրախային "
"բջիջի բջջային տեղեկանքը: Այս դաշտը վերցնում է բջիջի հասցեն, որի արժեքն "
"օպտիմիզացնելն է:</ahelp>"

#: solver.xhp#par_id7564012.help.text
#: solver.xhp%23par_id7564012.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Try to solve the equation for a "
"maximum value of the target cell.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Փորձեք լուծել հավասարումը թիրախային "
"բջիջի առավելագույն արժեքի համար:</ahelp>"

#: solver.xhp#par_id1186254.help.text
#: solver.xhp%23par_id1186254.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Try to solve the equation for a "
"minimum value of the target cell.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">TՓորձեք լուծել հավասարումը թիրախային "
"բջիջի նվազագույն արժեքի համար:</ahelp>"

#: solver.xhp#par_id7432477.help.text
#: solver.xhp%23par_id7432477.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Try to solve the equation to approach "
"a given value of the target cell.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Փորձեք լուծել հավասարումը, որպեսզի "
"մոտենաք նպատակային բջջի տվյալ արժեքին:</ahelp>"

#: solver.xhp#par_id7141026.help.text
#: solver.xhp%23par_id7141026.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Enter the value or a cell "
"reference.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Մուտքագրեք արժեքը կամ բջիջի "
"հղումը:</ahelp>"

#: solver.xhp#par_id8531449.help.text
#: solver.xhp%23par_id8531449.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Enter the cell range that can be "
"changed.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Մուտքագրեք բջջային միջակայքը, որը "
"կարող է փոխվել:</ahelp>"

#: solver.xhp#par_id9183935.help.text
#: solver.xhp%23par_id9183935.help.text
msgid "<ahelp hid=\".\" visibility=\"hidden\">Enter a cell reference.</ahelp>"
msgstr "<ahelp hid=\".\" visibility=\"hidden\">Մուտքագրեք բջիջի հղումը:</ahelp>"

#: solver.xhp#par_id946684.help.text
#: solver.xhp%23par_id946684.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Select an operator from the "
"list.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ցանկից ընտրեք օպերատորին:</ahelp>"

#: solver.xhp#par_id9607226.help.text
#: solver.xhp%23par_id9607226.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Enter a value or a cell "
"reference.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Մուտքագրեք արժեքը կամ բջիջի "
"հղումը:</ahelp>"

#: solver.xhp#par_id1939451.help.text
#: solver.xhp%23par_id1939451.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Click to shrink or restore the "
"dialog. You can click or select cells in the sheet. You can enter a cell "
"reference manually in the input box.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Կտտացրեք՝ երկխոսությունը նեղացնելու "
"կամ վերականգնելու համար: Կարող եք սեղմել կամ ընտրել բջիջները թերթում: "
"Մուտքագրման վանդակում կարող եք ձեռքով մուտքագրել բջիջի հղումը:</ahelp>"

#: solver.xhp#par_id9038972.help.text
#: solver.xhp%23par_id9038972.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Click to remove the row from the "
"list. Any rows from below this row move up.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Կտտացրեք՝ տողը ցուցակից հանելու համար:"
" Այս տողից ներքև ցանկացած տող բարձրանում է վեր:</ahelp>"

#: solver.xhp#par_id2423780.help.text
#: solver.xhp%23par_id2423780.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens the Options dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացվում է Ընտրանքների "
"երկխոսությունը:</ahelp>"

#: solver.xhp#par_id2569658.help.text
#: solver.xhp%23par_id2569658.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Click to solve the equation with the "
"current settings. The dialog settings are retained until you close the "
"current document.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Կտտացրեք ընթացիկ պարամետրերով "
"հավասարումը լուծելու համար: Երկխոսության պարամետրերը պահպանվում են, մինչև "
"չփակեք ընթացիկ փաստաթուղթը:</ahelp>"

#: solver.xhp#par_id5474410.help.text
#: solver.xhp%23par_id5474410.help.text
msgid "To solve equations with the solver"
msgstr "Լուծողի հետ հավասարումները լուծել"

#: solver.xhp#par_id2216559.help.text
#: solver.xhp%23par_id2216559.help.text
msgid ""
"The goal of the solver process is to find those variable values of an "
"equation that result in an optimized value in the <emph>target cell</emph>, "
"also named the \"objective\". You can choose whether the value in the target "
"cell should be a maximum, a minimum, or approaching a given value."
msgstr ""
"Լուծող գործընթացի նպատակն է գտնել հավասարման այն փոփոխական արժեքները, որոնք "
"հանգեցնում են օպտիմիզացված արժեքի <emph>թիրախ բջիջ</emph>, որը նույնպես "
"անվանվել է \"օբյեկտիվ\": Կարող եք ընտրել, արդյոք թիրախային բջիջի արժեքը պետք "
"է լինի առավելագույն, նվազագույն, կամ մոտենալ տվյալ արժեքին:"

#: solver.xhp#par_id7869502.help.text
#: solver.xhp%23par_id7869502.help.text
msgid ""
"The initial variable values are inserted in a rectangular cell range that "
"you enter in the <emph>By changing cells</emph> box. "
msgstr ""
"Նախնական փոփոխական արժեքները տեղադրվում են ուղղանկյուն բջջային տիրույթում, "
"որը մուտքագրում եք <emph>Բջիջները փոխելու միջոցով</emph> վանդակում։"

#: solver.xhp#par_id9852900.help.text
#: solver.xhp%23par_id9852900.help.text
msgid ""
"You can define a series of limiting conditions that set constraints for some "
"cells. For example, you can set the constraint that one of the variables or "
"cells must not be bigger than another variable, or not bigger than a given "
"value. You can also define the constraint that one or more variables must be "
"integers (values without decimals), or binary values (where only 0 and 1 are "
"allowed)."
msgstr ""
"Կարող եք սահմանել սահմանափակումների մի շարք պայմաններ, որոնք "
"սահմանափակումներ են առաջացնում որոշ բջիջների համար: Օրինակ, կարող եք "
"սահմանափակում դնել, որ փոփոխականներից կամ բջիջներից մեկը չպետք է լինի ավելի "
"մեծ, քան մյուս փոփոխականը, կամ ոչ ավելի, քան տվյալ արժեքից: Կարող եք "
"սահմանել նաև այն սահմանափակումները, որ մեկ կամ մի քանի փոփոխական պետք է "
"լինեն ամբողջ թվեր (արժեքներ առանց տասնորդական մասերի) կամ երկուական արժեքներ "
"(որտեղ թույլատրվում է ընդամենը 0 և 1):"

#: solver.xhp#par_id5323953.help.text
#: solver.xhp%23par_id5323953.help.text
msgid "The default solver engine supports only linear equations."
msgstr "Լռելյայն լուծող շարժիչը օժանդակում է միայն գծային հավասարումներին:"

#: 05100000.xhp#tit.help.text
#: 05100000.xhp%23tit.help.text
msgid "Styles and Formatting"
msgstr "Ոճեր և ձևավորում"

