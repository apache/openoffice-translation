msgid "Example"
msgstr "Օրինակ"

#: 04060101.xhp#par_id3149104.136.help.text
#: 04060101.xhp%23par_id3149104.136.help.text
msgid ""
"To find the average weight of all children of the same age in the above "
"example (scroll up, please), enter the following formula in B16:"
msgstr ""
"Վերը բերված օրինակում, նույն տարիքի բոլոր երեխաների միջին քաշը գտնելու համար "
"(ոլորեք վերև, խնդրում ենք), B16-ում մուտքագրեք հետևյալ բանաձևը."

#: 04060101.xhp#par_id3153688.137.help.text
#: 04060101.xhp%23par_id3153688.137.help.text
msgid "<item type=\"input\">=DAVERAGE(A1:E10;\"Weight\";A13:E14)</item>"
msgstr "<item type=\"input\">=DAVERAGE(A1:E10;\"Կշիռ\";A13:E14)</item>"

#: 04060101.xhp#par_id3155587.138.help.text
#: 04060101.xhp%23par_id3155587.138.help.text
msgid ""
"In row 14, under Age, enter <item type=\"input\">7, 8, 9,</item> and so on, "
"one after the other. The average weight of all children of the same age "
"appears."
msgstr ""
"14-րդ տողում, Տարիքի ներքո մուտքագրեք <item type=\"input\">7, 8, 9,</item> և "
"այսպես մեկը մյուսի հետևից։ Հայտնվում է նույն տարիքի բոլոր երեխաների միջին "
"քաշը:"

#: 04060101.xhp#bm_id3159269.help.text
#: 04060101.xhp%23bm_id3159269.help.text
msgid ""
"<bookmark_value>DPRODUCT function</bookmark_value>         "
"<bookmark_value>multiplying;cell contents in Calc databases</bookmark_value>"
msgstr ""
"<bookmark_value>DPRODUCT function</bookmark_value>         "
"<bookmark_value>multiplying;cell contents in Calc databases</bookmark_value>"

#: 04060101.xhp#hd_id3159269.139.help.text
#: 04060101.xhp%23hd_id3159269.139.help.text
msgid "DPRODUCT"
msgstr "DPRODUCT"

#: 04060101.xhp#par_id3152879.140.help.text
#: 04060101.xhp%23par_id3152879.140.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_DBPRODUKT\">DPRODUCT multiplies all cells of a data "
"range where the cell contents match the search criteria.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_DBPRODUKT\">DPRODUCT բազմապատկում է տվյալների տիրույթի "
"բոլոր բջիջները, որտեղ բջջի պարունակությունը համապատասխանում է որոնման "
"չափանիշներին:</ahelp>"

#: 04060101.xhp#hd_id3149966.141.help.text
