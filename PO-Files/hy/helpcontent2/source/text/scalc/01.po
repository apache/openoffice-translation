"<bookmark_value>TDIST function</bookmark_value>         "
"<bookmark_value>t-distribution</bookmark_value>"
msgstr ""
"<bookmark_value>TDIST function</bookmark_value>         "
"<bookmark_value>t-distribution</bookmark_value>"

#: 04060185.xhp#hd_id3154930.118.help.text
#: 04060185.xhp%23hd_id3154930.118.help.text
