#: 04030000.xhp#par_id3150767.2.help.text
#: 04030000.xhp%23par_id3150767.2.help.text
msgid ""
"<ahelp hid=\".uno:InsertRows\" visibility=\"visible\">Inserts a new row "
"above the active cell.</ahelp> The number of rows inserted correspond to the "
"number of rows selected. The existing rows are moved downward."
msgstr ""
"<ahelp hid=\".uno:InsertRows\" visibility=\"visible\">Ակտիվ բջիջի վերևում "
"տեղադրում է նոր տող:</ahelp> Տեղադրված տողերի քանակը համապատասխանում է "
"ընտրված տողերի քանակին: Առկա տողերը տեղափոխվում են ներքև:"

#: 05080300.xhp#tit.help.text
#: 05080300.xhp%23tit.help.text
