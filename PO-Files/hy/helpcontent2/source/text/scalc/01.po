#: 02170000.xhp%23par_id3153193.2.help.text
msgid ""
"<variable id=\"tabelleloeschentext\"><ahelp hid=\".uno:Remove\">Deletes the "
"current sheet after query confirmation.</ahelp></variable>"
msgstr ""
"<variable id=\"tabelleloeschentext\"><ahelp hid=\".uno:Remove\">Ջնջում է "
"ընթացիկ թերթը հարցման հաստատումից հետո:</ahelp></variable>"

#: 02170000.xhp#par_id3145801.7.help.text
#: 02170000.xhp%23par_id3145801.7.help.text
msgid ""
"You cannot delete a sheet while <emph>Edit - Changes - Record</emph> is "
"activated."
msgstr ""
"Չեք կարող ջնջել թերթը, քանի դեռ <emph>Խմբագրել - Փոփոխություններ - "
"Գրառում</emph> ակտիվ է։"

#: 02170000.xhp#hd_id3147124.3.help.text
#: 02170000.xhp%23hd_id3147124.3.help.text
msgid "Yes"
msgstr "Այո"

#: 02170000.xhp#par_id3154943.4.help.text
#: 02170000.xhp%23par_id3154943.4.help.text
msgid "Deletes the current sheet."
msgstr "Ջնջում է ընթացիկ թերթը։"

#: 02170000.xhp#hd_id3149412.5.help.text
#: 02170000.xhp%23hd_id3149412.5.help.text
msgid "No"
msgstr "Ոչ"

#: 02170000.xhp#par_id3154510.6.help.text
#: 02170000.xhp%23par_id3154510.6.help.text
msgid "Cancels the dialog. No delete is performed."
msgstr "Չեղարկում է երկխոսությունը: Ջնջում չի կատարվում:"

