"համակարգային ամսաթիվը:"

#: 06130000.xhp#tit.help.text
#: 06130000.xhp%23tit.help.text
msgid "AutoInput"
msgstr "Ինքնամուտք"

#: 06130000.xhp#bm_id2486037.help.text
#: 06130000.xhp%23bm_id2486037.help.text
