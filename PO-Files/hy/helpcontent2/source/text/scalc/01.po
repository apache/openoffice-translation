msgstr "Սահմանում է լրացուցիչ ընտրանքները, կապված հղման տարածքի տեսակի հետ:"

#: 04070100.xhp#hd_id3150716.17.help.text
#: 04070100.xhp%23hd_id3150716.17.help.text
msgctxt "04070100.xhp#hd_id3150716.17.help.text"
msgid "Print range"
msgstr "Տպելու տիրույթ"

