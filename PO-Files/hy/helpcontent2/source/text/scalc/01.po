"<ahelp hid=\"HID_FUNC_TREND\">Returns values along a linear trend.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_TREND\">Վերադարձնում է արժեքները գծային միտման "
"երկայնքով:</ahelp>"

#: 04060107.xhp#hd_id3166109.198.help.text
#: 04060107.xhp%23hd_id3166109.198.help.text
