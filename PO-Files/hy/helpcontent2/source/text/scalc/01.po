msgid "Mathematical Functions"
msgstr "Մաթեմատիկական գործառույթներ"

#: 04060106.xhp#par_id3154943.2.help.text
#: 04060106.xhp%23par_id3154943.2.help.text
msgid ""
"<variable id=\"mathematiktext\">This category contains the "
"<emph>Mathematical</emph> functions for Calc.</variable> To open the <emph>"
"Function Wizard</emph>, choose <link href=\"text/scalc/01/04060000.xhp\" "
"name=\"Insert - Function\"><emph>Insert - Function</emph></link>."
msgstr ""
"<variable id=\"mathematiktext\">Այս դասը պարունակում է "
"<emph>Մաթեմատիկական</emph> գործառույթներ Calc -ի համար։</variable> Բացելու "
"համար <emph>Գործառույթի Հրաշագործը</emph>, ընտրեք <link href=\""
"text/scalc/01/04060000.xhp\" name=\"Տեղադրել - Գործառույթ\"><emph>Տեղադրել - "
"Գործառույթ</emph></link>։"

#: 04060106.xhp#bm_id3146944.help.text
#: 04060106.xhp%23bm_id3146944.help.text
msgid ""
"<bookmark_value>ABS function</bookmark_value><bookmark_value>absolute "
"values</bookmark_value><bookmark_value>values;absolute</bookmark_value>"
msgstr ""
"<bookmark_value>ABS գործառույթ</bookmark_value><bookmark_value>բացարձակ "
"արժեքներ</bookmark_value><bookmark_value>արժեքներ;բացարձակ</bookmark_value>"

#: 04060106.xhp#hd_id3146944.33.help.text
#: 04060106.xhp%23hd_id3146944.33.help.text
msgid "ABS"
msgstr "ABS"

#: 04060106.xhp#par_id3154546.34.help.text
#: 04060106.xhp%23par_id3154546.34.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_ABS\">Returns the absolute value of a number.</ahelp>"
msgstr "<ahelp hid=\"HID_FUNC_ABS\">Վերադարձնում է թվի բացարձակ արժեքը։</ahelp>"

#: 04060106.xhp#hd_id3154843.35.help.text
#: 04060106.xhp%23hd_id3154843.35.help.text
msgctxt "04060106.xhp#hd_id3154843.35.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3147475.36.help.text
#: 04060106.xhp%23par_id3147475.36.help.text
msgid "ABS(Number)"
msgstr "ABS(Number)"

#: 04060106.xhp#par_id3148438.37.help.text
#: 04060106.xhp%23par_id3148438.37.help.text
msgid ""
"<emph>Number</emph> is the number whose absolute value is to be calculated. "
"The absolute value of a number is its value without the +/- sign."
msgstr ""
"<emph>Թիվ</emph> դա թիվ է, որի բացարձակ արժեքը պետք է հաշվարկվի: Թվի "
"բացարձակ արժեքը, արժեքն է առանց +/- նշանի:"

#: 04060106.xhp#hd_id3155823.38.help.text
#: 04060106.xhp%23hd_id3155823.38.help.text
msgctxt "04060106.xhp#hd_id3155823.38.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3152787.39.help.text
#: 04060106.xhp%23par_id3152787.39.help.text
msgid "<item type=\"input\">=ABS(-56)</item> returns 56."
msgstr "<item type=\"input\">=ABS(-56)</item> վերադարձնում է 56։"

#: 04060106.xhp#par_id3148752.40.help.text
#: 04060106.xhp%23par_id3148752.40.help.text
msgid "<item type=\"input\">=ABS(12)</item> returns 12."
msgstr "<item type=\"input\">=ABS(12)</item> վերադարձնում է 12։"

#: 04060106.xhp#par_id320139.help.text
#: 04060106.xhp%23par_id320139.help.text
msgid "<item type=\"input\">=ABS(0)</item> returns 0."
msgstr "<item type=\"input\">=ABS(0)</item> վերադարձնում է 0։"

#: 04060106.xhp#bm_id3150896.help.text
#: 04060106.xhp%23bm_id3150896.help.text
msgid ""
"<bookmark_value>COUNTBLANK function</bookmark_value><bookmark_value>counting;"
"empty cells</bookmark_value><bookmark_value>empty "
"cells;counting</bookmark_value>"
msgstr ""
"<bookmark_value>COUNTBLANK function</bookmark_value><bookmark_value>counting;"
"empty cells</bookmark_value><bookmark_value>empty "
"cells;counting</bookmark_value>"

#: 04060106.xhp#hd_id3150896.42.help.text
#: 04060106.xhp%23hd_id3150896.42.help.text
msgid "COUNTBLANK"
msgstr "COUNTBLANK"

#: 04060106.xhp#par_id3155260.43.help.text
#: 04060106.xhp%23par_id3155260.43.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_ANZAHLLEEREZELLEN\">Returns the number of empty "
"cells.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_ANZAHLLEEREZELLEN\">Վերադարձնում է դատարկ բջիջների "
"քանակը։</ahelp>"

#: 04060106.xhp#hd_id3145144.44.help.text
#: 04060106.xhp%23hd_id3145144.44.help.text
msgctxt "04060106.xhp#hd_id3145144.44.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3153931.45.help.text
#: 04060106.xhp%23par_id3153931.45.help.text
msgid "COUNTBLANK(Range)"
msgstr "COUNTBLANK(Range)"

#: 04060106.xhp#par_id3149512.46.help.text
#: 04060106.xhp%23par_id3149512.46.help.text
msgid ""
" Returns the number of empty cells in the cell range <emph>Range</emph>."
msgstr ""
" Վերադարձնում է դատարկ բջիջների քանակը, բջջային տիրույթում "
"<emph>Տիրույթ</emph>։"

#: 04060106.xhp#hd_id3146139.47.help.text
#: 04060106.xhp%23hd_id3146139.47.help.text
msgctxt "04060106.xhp#hd_id3146139.47.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3148586.48.help.text
#: 04060106.xhp%23par_id3148586.48.help.text
msgid ""
"<item type=\"input\">=COUNTBLANK(A1:B2)</item> returns 4 if cells A1, A2, "
"B1, and B2 are all empty."
msgstr ""
"<item type=\"input\">=COUNTBLANK(A1:B2)</item> վերադարձնում է 4 եթե A1, A2, "
"B1 բջիջները, և B2 բոլորը դատարկ են։"

#: 04060106.xhp#bm_id3153114.help.text
#: 04060106.xhp%23bm_id3153114.help.text
msgid "<bookmark_value>ACOS function</bookmark_value>"
msgstr "<bookmark_value>ACOS function</bookmark_value>"

#: 04060106.xhp#hd_id3153114.50.help.text
#: 04060106.xhp%23hd_id3153114.50.help.text
msgid "ACOS"
msgstr "ACOS"

#: 04060106.xhp#par_id3145163.51.help.text
#: 04060106.xhp%23par_id3145163.51.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_ARCCOS\">Returns the inverse trigonometric cosine of a "
"number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_ARCCOS\">Վերադարձնում է թվի հակադարձ եռանկյունաչափական "
"կոսինուսը:</ahelp>"

#: 04060106.xhp#hd_id3153565.52.help.text
#: 04060106.xhp%23hd_id3153565.52.help.text
msgctxt "04060106.xhp#hd_id3153565.52.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060106.xhp#par_id3150020.53.help.text
#: 04060106.xhp%23par_id3150020.53.help.text
msgid "ACOS(Number)"
msgstr "ACOS(Number)"

#: 04060106.xhp#par_id3159134.54.help.text
#: 04060106.xhp%23par_id3159134.54.help.text
msgid ""
" This function returns the inverse trigonometric cosine of "
"<emph>Number</emph>, that is the angle (in radians) whose cosine is Number. "
"The angle returned is between 0 and PI."
msgstr ""
" Այս գործառույթը վերադարձնում է <emph>Թիվ</emph> հակառակ եռանկյունաչափական "
"կոսինուսը, դա այն անկյունն է (ռադիաններով), որի կոսինուսը թիվ է: Վերադարձված "
"անկյունը 0-ից PI -ի միջև է:"

#: 04060106.xhp#par_id679647.help.text
#: 04060106.xhp%23par_id679647.help.text
msgctxt "04060106.xhp#par_id679647.help.text"
msgid "To return the angle in degrees, use the DEGREES function."
msgstr ""
"Անկյունն աստիճաններով վերադարձնելու համար, օգտագործեք DEGREES գործառույթը։"

#: 04060106.xhp#hd_id3149882.55.help.text
#: 04060106.xhp%23hd_id3149882.55.help.text
msgctxt "04060106.xhp#hd_id3149882.55.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060106.xhp#par_id3150128.56.help.text
#: 04060106.xhp%23par_id3150128.56.help.text
msgid ""
"<item type=\"input\">=ACOS(-1)</item> returns 3.14159265358979 (PI radians)"
msgstr ""
"<item type=\"input\">=ACOS(-1)</item> վերադարձնում է 3.14159265358979 (PI "
"ռադիաններ)"

#: 04060106.xhp#par_id8792382.help.text
#: 04060106.xhp%23par_id8792382.help.text
msgid ""
"<item type=\"input\">=DEGREES(ACOS(0.5))</item> returns 60. The cosine of 60 "
"degrees is 0.5."
msgstr ""
"<item type=\"input\">=DEGREES(ACOS(0.5))</item> վերադարձնում է 60. 60 "
"աստիճանի կոսինուսն է 0.5։"

#: 04060106.xhp#bm_id3145355.help.text
#: 04060106.xhp%23bm_id3145355.help.text
msgid "<bookmark_value>ACOSH function</bookmark_value>"
msgstr "<bookmark_value>ACOSH function</bookmark_value>"

#: 04060106.xhp#hd_id3145355.60.help.text
#: 04060106.xhp%23hd_id3145355.60.help.text
msgid "ACOSH"
msgstr "ACOSH"

#: 04060106.xhp#par_id3157993.61.help.text
#: 04060106.xhp%23par_id3157993.61.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_ARCOSHYP\">Returns the inverse hyperbolic cosine of a "
"number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_ARCOSHYP\">Վերադարձնում է թվի հակադարձ հիպերբոլիկ "
