#: 04060184.xhp%23par_id3153684.133.help.text
msgid "QUARTILE(Data; Type)"
msgstr "QUARTILE(Data; Type)"

#: 04060184.xhp#par_id3153387.134.help.text
#: 04060184.xhp%23par_id3153387.134.help.text
msgctxt "04060184.xhp#par_id3153387.134.help.text"
msgid "<emph>Data</emph> represents the array of data in the sample."
msgstr "<emph>Data</emph> ներկայացնում է նմուշում տվյալների զանգվածը:"

#: 04060184.xhp#par_id3155589.135.help.text
#: 04060184.xhp%23par_id3155589.135.help.text
msgid ""
"<emph>Type</emph> represents the type of quartile. (0 = MIN, 1 = 25%, 2 = 50%"
" (MEDIAN), 3 = 75% and 4 = MAX.)"
msgstr ""
"<emph>Type</emph> ներկայացնոմ է կվարտիլի տեսակը։ (0 = MIN, 1 = 25%, 2 = 50% "
"(MEDIAN), 3 = 75% and 4 = MAX.)"

#: 04060184.xhp#hd_id3149103.136.help.text
#: 04060184.xhp%23hd_id3149103.136.help.text
msgctxt "04060184.xhp#hd_id3149103.136.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060184.xhp#par_id3159276.137.help.text
#: 04060184.xhp%23par_id3159276.137.help.text
msgid ""
"<item type=\"input\">=QUARTILE(A1:A50;2)</item> returns the value of which "
"50% of the scale corresponds to the lowest to highest values in the range "
"A1:A50."
msgstr ""
"<item type=\"input\">=QUARTILE(A1:A50;2)</item> վերադարձնում է արժեքը, որի "
"մասշտաբի 50% -ը համապատասխանում է A1:A50-ի միջակայքում ամենացածր և "
"բարձրագույն արժեքներին:"

