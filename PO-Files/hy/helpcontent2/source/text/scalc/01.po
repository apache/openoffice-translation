#: 04060181.xhp%23par_id3156107.69.help.text
msgctxt "04060181.xhp#par_id3156107.69.help.text"
msgid "            <emph>Alpha</emph> is a parameter to the distribution."
msgstr "            <emph>Alpha</emph> բաշխման պարամետրն է։"

#: 04060181.xhp#par_id3153619.70.help.text
#: 04060181.xhp%23par_id3153619.70.help.text
