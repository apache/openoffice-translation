msgid "Example"
msgstr "Օրինակ"

#: 04060107.xhp#par_id3166245.205.help.text
#: 04060107.xhp%23par_id3166245.205.help.text
msgid ""
"Select a spreadsheet range in which the trend data will appear. Select the "
"function. Enter the output data or select it with the mouse. Mark the "
"<emph>Array</emph> field. click <emph>OK</emph>. The trend data calculated "
"from the output data is displayed."
msgstr ""
"Ընտրեք փռված թերթիկի միջակայքը, որում կհայտնվեն միտումային տվյալները: Ընտրեք "
"գործառույթը: Մուտքագրեք ելքային տվյալները, կամ ընտրեք այն մկնիկով: Նշեք "
"<emph>Զանգված </emph> դաշտը: Կտտացրեք <emph>ԼԱՎ</emph>: Ցուցադրվում են "
"ելքային տվյալներից հաշվարկված միտումային տվյալները:"

#: 04060107.xhp#bm_id3166317.help.text
#: 04060107.xhp%23bm_id3166317.help.text
msgid ""
"<bookmark_value>GROWTH function</bookmark_value><bookmark_value>exponential "
"trends in arrays</bookmark_value>"
msgstr ""
"<bookmark_value>GROWTH function</bookmark_value><bookmark_value>էքսպոնենցիալ "
"միտումներ զանգվածներում</bookmark_value>"

