msgid "Syntax"
msgstr "Շարահյուսություն"

#: func_edate.xhp#par_id3153212.216.help.text
#: func_edate.xhp%23par_id3153212.216.help.text
msgid "EDATE(StartDate; Months)"
msgstr "EDATE(StartDate; Months)"

#: func_edate.xhp#par_id3146860.217.help.text
#: func_edate.xhp%23par_id3146860.217.help.text
msgid "<emph>StartDate</emph> is a date."
msgstr "<emph>StartDate</emph> ամսաթիվ է։"

#: func_edate.xhp#par_id3152929.218.help.text
#: func_edate.xhp%23par_id3152929.218.help.text
msgctxt "func_edate.xhp#par_id3152929.218.help.text"
msgid ""
"<emph>Months</emph> is the number of months before (negative) or after "
"(positive) the start date."
msgstr ""
"<emph>Ամիսները</emph> մեկնարկի ամսաթվից առաջ (բացասական) կամ դրանից հետո "
"(դրական) ամիսն է:"

#: func_edate.xhp#hd_id3151289.219.help.text
#: func_edate.xhp%23hd_id3151289.219.help.text
