msgstr ""
"            <item type=\"input\">=ARABIC(\"MXIV\")</item> վերադարձնում է 1014"

#: 04060110.xhp#par_id3147553.246.help.text
#: 04060110.xhp%23par_id3147553.246.help.text
msgid "            <item type=\"input\">=ARABIC(\"MMII\")</item> returns 2002"
msgstr ""
"            <item type=\"input\">=ARABIC(\"MMII\")</item> վերադարձնում է 2002"

#: 04060110.xhp#bm_id8796349.help.text
#: 04060110.xhp%23bm_id8796349.help.text
msgid "<bookmark_value>ASC function</bookmark_value>"
msgstr "<bookmark_value>ASC գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id7723929.help.text
#: 04060110.xhp%23hd_id7723929.help.text
msgid "ASC"
msgstr "ASC"

#: 04060110.xhp#par_id8455153.help.text
#: 04060110.xhp%23par_id8455153.help.text
msgid ""
"<ahelp hid=\".\">The ASC function converts full-width to half-width ASCII "
"and katakana characters. Returns a text string.</ahelp>"
msgstr ""
"<ahelp hid=\".\">ASC գործառույթը ամբողջ լայնությունը վերածում է կես "
"լայնության ASCII և կատականա նիշերի: Վերադարձնում է տեքստային տողը:</ahelp>"

#: 04060110.xhp#par_id9912411.help.text
#: 04060110.xhp%23par_id9912411.help.text
msgctxt "04060110.xhp#par_id9912411.help.text"
msgid ""
"See <link href=\"https://wiki.openoffice.org/wiki/Calc/Features/"
"JIS_and_ASC_functions\">JIS and ASC Spreadsheet Functions</link> for a "
"conversion table."
msgstr ""
"Տե՛ս <link href=\"https://wiki.openoffice.org/wiki/Calc/Features/"
"JIS_and_ASC_functions\">JIS and ASC Spreadsheet Functions</link> ձևափոխման "
"աղյուսակի համար"

#: 04060110.xhp#hd_id9204992.help.text
#: 04060110.xhp%23hd_id9204992.help.text
msgctxt "04060110.xhp#hd_id9204992.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id1993774.help.text
#: 04060110.xhp%23par_id1993774.help.text
msgid "ASC(\"Text\")"
msgstr "ASC(\"Text\")"

#: 04060110.xhp#par_id2949919.help.text
#: 04060110.xhp%23par_id2949919.help.text
msgctxt "04060110.xhp#par_id2949919.help.text"
msgid ""
"            <emph>Text</emph> is the text that contains characters to be "
"converted."
msgstr ""
"            <emph>Տեքստ</emph> տեքստ է, որը պարունակում է վերափոխվելու նիշեր:"

#: 04060110.xhp#par_id2355113.help.text
#: 04060110.xhp%23par_id2355113.help.text
msgid "See also JIS function."
msgstr "Տե՛ս նաև JIS գործառույթը։"

#: 04060110.xhp#bm_id9323709.help.text
#: 04060110.xhp%23bm_id9323709.help.text
msgid "<bookmark_value>BAHTTEXT function</bookmark_value>"
msgstr "<bookmark_value>BAHTTEXT գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id6695455.help.text
#: 04060110.xhp%23hd_id6695455.help.text
msgid "BAHTTEXT"
msgstr "BAHTTEXT"

#: 04060110.xhp#par_id354014.help.text
#: 04060110.xhp%23par_id354014.help.text
msgid "Converts a number to Thai text, including the Thai currency names."
msgstr ""
"Ձևափոխում է թիվը Թաի տեքստի, ներառյալ Թաիլանդի արժույթների անվանումները:"

#: 04060110.xhp#hd_id9942014.help.text
#: 04060110.xhp%23hd_id9942014.help.text
msgctxt "04060110.xhp#hd_id9942014.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id8780785.help.text
#: 04060110.xhp%23par_id8780785.help.text
msgid "BAHTTEXT(Number)"
msgstr "BAHTTEXT(Number)"

#: 04060110.xhp#par_id1539353.help.text
#: 04060110.xhp%23par_id1539353.help.text
msgid ""
"            <emph>Number</emph> is any number. \"Baht\" is appended to the "
"integral part of the number, and \"Satang\" is appended to the decimal part "
"of the number."
msgstr ""
"            <emph>Թիվ</emph> ցանկացած թիվ է։ \"Baht\" -ը հավելած է թվի "
"ամբողջ մասին, իսկ \"Satang\" -ը հավելած է թվի տասնորդական մասին:"

#: 04060110.xhp#hd_id9694814.help.text
#: 04060110.xhp%23hd_id9694814.help.text
msgctxt "04060110.xhp#hd_id9694814.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3289284.help.text
#: 04060110.xhp%23par_id3289284.help.text
msgid ""
"            <item type=\"input\">=BAHTTEXT(12.65)</item> returns a string in "
"Thai characters with the meaning of \"Twelve Baht and sixty five Satang\"."
msgstr ""
"            <item type=\"input\">=BAHTTEXT(12.65)</item> Վերադարձնում է "
"թայերեն նիշերի տողի տեսքով \"Տասներկու բահ և վաթսունհինգ սատանգ\":"

#: 04060110.xhp#bm_id3153072.help.text
#: 04060110.xhp%23bm_id3153072.help.text
msgid "<bookmark_value>BASE function</bookmark_value>"
msgstr "<bookmark_value>BASE գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3153072.213.help.text
#: 04060110.xhp%23hd_id3153072.213.help.text
msgid "BASE"
msgstr "BASE"

#: 04060110.xhp#par_id3153289.214.help.text
#: 04060110.xhp%23par_id3153289.214.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_BASIS\">Converts a positive integer to a specified "
"base into a text from the <link href=\"text/shared/00/00000005.xhp#"
"zahlensystem\" name=\"numbering system\">numbering system</link>.</ahelp> "
"The digits 0-9 and the letters A-Z are used."
msgstr ""
"<ahelp hid=\"HID_FUNC_BASIS\">Նշված հիմքով դրական ամբողջ թիվը այստեղից <link "
"href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"numbering system\">"
"numbering system</link> վերածում է տեքստի։</ahelp> Օգտագործվում են 0-9 թվերը "
"և A-Z տառերը։"

#: 04060110.xhp#hd_id3146097.215.help.text
#: 04060110.xhp%23hd_id3146097.215.help.text
msgctxt "04060110.xhp#hd_id3146097.215.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3155743.216.help.text
#: 04060110.xhp%23par_id3155743.216.help.text
msgid "BASE(Number; Radix; [MinimumLength])"
msgstr "BASE(Number; Radix; [MinimumLength])"

#: 04060110.xhp#par_id3151339.217.help.text
#: 04060110.xhp%23par_id3151339.217.help.text
msgid ""
"            <emph>Number</emph> is the positive integer to be converted."
msgstr "            <emph>Թիվ</emph> ձևափոխման ենթակա դրական ամբողջ թիվ է։"

#: 04060110.xhp#par_id3159262.218.help.text
#: 04060110.xhp%23par_id3159262.218.help.text
msgctxt "04060110.xhp#par_id3159262.218.help.text"
msgid ""
"            <emph>Radix</emph> indicates the base of the number system. It "
"may be any positive integer between 2 and 36."
msgstr ""
"            <emph>Radix</emph> նշում է թվային համակարգի հիմքը։ Այն կարող է "
"լինել ցանկացած դրական ամբողջ թիվ 2-ի և 36-ի միջև:"

#: 04060110.xhp#par_id3148746.219.help.text
#: 04060110.xhp%23par_id3148746.219.help.text
msgid ""
"            <emph>MinimumLength</emph> (optional) determines the minimum "
"length of the character sequence that has been created. If the text is "
"shorter than the indicated minimum length, zeros are added to the left of "
"the string."
msgstr ""
"            <emph>MinimumLength</emph> (կամընտրական) որոշում է նիշերի "
"հաջորդականության նվազագույն երկարությունը, որը ստեղծվել է: Եթե տեքստը կարճ "
"է, քան նշված նվազագույն երկարությունը, զրոները ավելացվում են տողի ձախ մասում:"

#: 04060110.xhp#hd_id3146323.220.help.text
#: 04060110.xhp%23hd_id3146323.220.help.text
msgctxt "04060110.xhp#hd_id3146323.220.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#bm_id3156399.help.text
#: 04060110.xhp%23bm_id3156399.help.text
msgid "<bookmark_value>decimal system; converting to</bookmark_value>"
msgstr "<bookmark_value>տասնորդական համակարգ; ձևափոխություն</bookmark_value>"

#: 04060110.xhp#par_id3156399.221.help.text
#: 04060110.xhp%23par_id3156399.221.help.text
msgid ""
"            <item type=\"input\">=BASE(17;10;4)</item> returns 0017 in the "
"decimal system."
msgstr ""
"            <item type=\"input\">=BASE(17;10;4)</item> վերադարձնում է 0017 "
"տասնորդական համակարգում:"

#: 04060110.xhp#bm_id3157871.help.text
#: 04060110.xhp%23bm_id3157871.help.text
msgid "<bookmark_value>binary system; converting to</bookmark_value>"
msgstr "<bookmark_value>երկուական համակարգ; ձևափոխություն</bookmark_value>"

#: 04060110.xhp#par_id3157871.222.help.text
#: 04060110.xhp%23par_id3157871.222.help.text
msgid ""
"            <item type=\"input\">=BASE(17;2)</item> returns 10001 in the "
"binary system."
msgstr ""
"            <item type=\"input\">=BASE(17;2)</item> վերադարձնում է 10001 "
"երկուական համակարգում։"

#: 04060110.xhp#bm_id3145226.help.text
#: 04060110.xhp%23bm_id3145226.help.text
msgid "<bookmark_value>hexadecimal system; converting to</bookmark_value>"
msgstr "<bookmark_value>տասնվեցական համակարգ; ձևափոխություն</bookmark_value>"

#: 04060110.xhp#par_id3145226.223.help.text
#: 04060110.xhp%23par_id3145226.223.help.text
msgid ""
"            <item type=\"input\">=BASE(255;16;4)</item> returns 00FF in the "
"hexadecimal system."
msgstr ""
"            <item type=\"input\">=BASE(255;16;4)</item> վերադարձնում է 00FF "
"տասնվեցական համակարգում։"

#: 04060110.xhp#bm_id3149321.help.text
#: 04060110.xhp%23bm_id3149321.help.text
msgid "<bookmark_value>CHAR function</bookmark_value>"
msgstr "<bookmark_value>CHAR գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3149321.201.help.text
#: 04060110.xhp%23hd_id3149321.201.help.text
msgid "CHAR"
msgstr "CHAR"

#: 04060110.xhp#par_id3149150.202.help.text
#: 04060110.xhp%23par_id3149150.202.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_ZEICHEN\">Converts a number into a character according "
"to the current code table.</ahelp> The number can be a two-digit or three-"
"digit integer number."
msgstr ""
"<ahelp hid=\"HID_FUNC_ZEICHEN\">Կոդավորման ընթացիկ աղյուսակի համաձայն "
"ձևափոխում է թիվը նիշի:</ahelp> Թիվը կարող է լինել երկնիշ կամ եռանիշ ամբողջ "
"թիվ:"

#: 04060110.xhp#hd_id3149945.203.help.text
#: 04060110.xhp%23hd_id3149945.203.help.text
msgctxt "04060110.xhp#hd_id3149945.203.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3145634.204.help.text
#: 04060110.xhp%23par_id3145634.204.help.text
msgid "CHAR(Number)"
msgstr "CHAR(Number)"

#: 04060110.xhp#par_id3155906.205.help.text
#: 04060110.xhp%23par_id3155906.205.help.text
msgid ""
"            <emph>Number</emph> is a number between 1 and 255 representing "
"the code value for the character."
msgstr ""
"            <emph>Թիվ</emph> 1-ից 255 միջակայքում թիվ է, որը ներկայացնում է "
"նիշի կոդի արժեքը:"

#: 04060110.xhp#hd_id3152982.207.help.text
#: 04060110.xhp%23hd_id3152982.207.help.text
msgctxt "04060110.xhp#hd_id3152982.207.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3149890.208.help.text
#: 04060110.xhp%23par_id3149890.208.help.text
msgid ""
"            <item type=\"input\">=CHAR(100)</item> returns the character d."
msgstr ""
"            <item type=\"input\">=CHAR(100)</item> վերադարձնում է d նիշը։"

#: 04060110.xhp#par_id0907200910283297.help.text
#: 04060110.xhp%23par_id0907200910283297.help.text
msgid ""
"=\"abc\" & CHAR(10) & \"def\" inserts a newline character into the string."
msgstr "=\"abc\" & CHAR(10) & \"def\" տողում ներդնում է նոր տողի նիշը:"

#: 04060110.xhp#bm_id3149009.help.text
#: 04060110.xhp%23bm_id3149009.help.text
msgid "<bookmark_value>CLEAN function</bookmark_value>"
msgstr "<bookmark_value>CLEAN գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3149009.132.help.text
#: 04060110.xhp%23hd_id3149009.132.help.text
msgid "CLEAN"
msgstr "CLEAN"

#: 04060110.xhp#par_id3150482.133.help.text
#: 04060110.xhp%23par_id3150482.133.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_SAEUBERN\">All non-printing characters are removed "
"from the string.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_SAEUBERN\">Բոլոր չտպվող նիշերը հեռացված են "
"տողից։</ahelp>"

#: 04060110.xhp#hd_id3146880.134.help.text
#: 04060110.xhp%23hd_id3146880.134.help.text
msgctxt "04060110.xhp#hd_id3146880.134.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3147472.135.help.text
#: 04060110.xhp%23par_id3147472.135.help.text
msgid "CLEAN(\"Text\")"
msgstr "CLEAN(\"Text\")"

#: 04060110.xhp#par_id3150695.136.help.text
#: 04060110.xhp%23par_id3150695.136.help.text
msgid ""
"            <emph>Text</emph> refers to the text from which to remove all "
"non-printable characters."
msgstr ""
"            <emph>Տեքստ</emph> վերաբերում է այն տեքստին, որից հեռացվելու են "
"բոլոր ոչ տպվող նիշերը:"

#: 04060110.xhp#bm_id3155498.help.text
#: 04060110.xhp%23bm_id3155498.help.text
msgid "<bookmark_value>CODE function</bookmark_value>"
msgstr "<bookmark_value>CODE գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3155498.3.help.text
#: 04060110.xhp%23hd_id3155498.3.help.text
msgid "CODE"
msgstr "CODE"

#: 04060110.xhp#par_id3152770.4.help.text
#: 04060110.xhp%23par_id3152770.4.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_CODE\">Returns a numeric code for the first character "
"in a text string.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_CODE\">Վերադարձնում է նիշային տողի առաջին նիշի թվային "
"կոդը:</ahelp>"

#: 04060110.xhp#hd_id3155830.5.help.text
#: 04060110.xhp%23hd_id3155830.5.help.text
msgctxt "04060110.xhp#hd_id3155830.5.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3149188.6.help.text
#: 04060110.xhp%23par_id3149188.6.help.text
msgid "CODE(\"Text\")"
msgstr "CODE(\"Text\")"

#: 04060110.xhp#par_id3154383.7.help.text
#: 04060110.xhp%23par_id3154383.7.help.text
msgid ""
"            <emph>Text</emph> is the text for which the code of the first "
"character is to be found."
msgstr ""
"            <emph>Տեքստ</emph> այն տեքստն է, որի համար պետք է գտնվի առաջին "
"նիշի կոդը։"

#: 04060110.xhp#hd_id3154394.8.help.text
#: 04060110.xhp%23hd_id3154394.8.help.text
msgctxt "04060110.xhp#hd_id3154394.8.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3159209.9.help.text
#: 04060110.xhp%23par_id3159209.9.help.text
msgid ""
"            <item type=\"input\">=CODE(\"Hieronymus\")</item> returns 72, <"
"item type=\"input\">=CODE(\"hieroglyphic\")</item> returns 104."
msgstr ""
"            <item type=\"input\">=CODE(\"Hieronymus\")</item> վերադարձնում է "
"72, <item type=\"input\">=CODE(\"hieroglyphic\")</item> վերադարձնում է 104։"

#: 04060110.xhp#par_id3150280.211.help.text
#: 04060110.xhp%23par_id3150280.211.help.text
msgid ""
"The code used here does not refer to ASCII, but to the code table currently "
"loaded."
msgstr ""
"Այստեղ օգտագործված կոդը չի վերաբերում ASCII-ին, այլ ներկայումս բեռնված "
"կոդային աղյուսակին:"

#: 04060110.xhp#bm_id3149688.help.text
#: 04060110.xhp%23bm_id3149688.help.text
msgid "<bookmark_value>CONCATENATE function</bookmark_value>"
msgstr "<bookmark_value>CONCATENATE գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3149688.167.help.text
#: 04060110.xhp%23hd_id3149688.167.help.text
msgid "CONCATENATE"
msgstr "CONCATENATE"

#: 04060110.xhp#par_id3154524.168.help.text
#: 04060110.xhp%23par_id3154524.168.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_VERKETTEN\">Combines several text strings into one "
"string.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_VERKETTEN\">Մի քանի տեքստային տողերը միացնում են "
"մեկում:</ahelp>"

#: 04060110.xhp#hd_id3149542.169.help.text
#: 04060110.xhp%23hd_id3149542.169.help.text
msgctxt "04060110.xhp#hd_id3149542.169.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3155954.170.help.text
#: 04060110.xhp%23par_id3155954.170.help.text
msgid "CONCATENATE(\"Text1\"; ...; \"Text30\")"
msgstr "CONCATENATE(\"Text1\"; ...; \"Text30\")"

#: 04060110.xhp#par_id3146847.171.help.text
#: 04060110.xhp%23par_id3146847.171.help.text
msgid ""
"            <emph>Text 1; Text 2; ...</emph> represent up to 30 text "
"passages which are to be combined into one string."
msgstr ""
"            <emph>Text 1; Text 2; ...</emph> ներկայացնում են մինչև 30 "
"տեքստային հատվածներ, որոնք պետք է միավորվեն մեկ տողում:"

#: 04060110.xhp#hd_id3153110.172.help.text
#: 04060110.xhp%23hd_id3153110.172.help.text
msgctxt "04060110.xhp#hd_id3153110.172.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3150008.173.help.text
#: 04060110.xhp%23par_id3150008.173.help.text
msgid ""
"            <item type=\"input\">=CONCATENATE(\"Good \";\"Morning \";\"Mrs. "
"\";\"Doe\")</item> returns: Good Morning Mrs. Doe."
msgstr ""
"            <item type=\"input\">=CONCATENATE(\"Բարի \";\"առավոտ \";\"պրն \";"
"\"Դոե\")</item> վերադարձնում է: Բարի առավոտ պրն Դոե։"

#: 04060110.xhp#bm_id3145166.help.text
#: 04060110.xhp%23bm_id3145166.help.text
msgid "<bookmark_value>DECIMAL function</bookmark_value>"
msgstr "<bookmark_value>DECIMAL գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3145166.225.help.text
#: 04060110.xhp%23hd_id3145166.225.help.text
msgid "DECIMAL"
msgstr "DECIMAL"

#: 04060110.xhp#par_id3156361.226.help.text
#: 04060110.xhp%23par_id3156361.226.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_DEZIMAL\">Converts text with characters from a <link "
"href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"number system\">"
"number system</link> to a positive integer in the base radix given.</ahelp> "
"The radix must be in the range 2 to 36. Spaces and tabs are ignored. The "
"<emph>Text</emph> field is not case-sensitive."
msgstr ""
"<ahelp hid=\"HID_FUNC_DEZIMAL\">Ձևափոխում է նիշերով տեքստը այստեղից <link "
"href=\"text/shared/00/00000005.xhp#zahlensystem\" name=\"number system\">"
"number system</link> տրված radix հիմքով դրական ամբողջի։</ahelp> radix -ը "
"պետք է լինի 2 մինչև 36 տիրույթում։ Բացատները և տաբերը անտեսվում են։ Այս "
"<emph>Տեքստ</emph> դաշտը ընտրությանը անզգա է։"

#: 04060110.xhp#par_id3157994.227.help.text
#: 04060110.xhp%23par_id3157994.227.help.text
msgid ""
"If the radix is 16, a leading x or X or 0x or 0X, and an appended h or H, is "
"disregarded. If the radix is 2, an appended b or B is disregarded. Other "
"characters that do not belong to the number system generate an error."
msgstr ""
"Եթե radix -ը 16 է, առաջատար x կամ X կամ 0x կամ 0X, և հավելած h կամ H- ը, "
"անտեսվում է: Եթե radix -ը 2 է, հավելած b կամ B- ն անտեսվում է: Այլ նիշերը, "
"որոնք չեն պատկանում թվային համակարգին, սխալ են առաջացնում:"

#: 04060110.xhp#hd_id3150014.228.help.text
#: 04060110.xhp%23hd_id3150014.228.help.text
msgctxt "04060110.xhp#hd_id3150014.228.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3154328.229.help.text
#: 04060110.xhp%23par_id3154328.229.help.text
msgid "DECIMAL(\"Text\"; Radix)"
msgstr "DECIMAL(\"Text\"; Radix)"

#: 04060110.xhp#par_id3150128.230.help.text
#: 04060110.xhp%23par_id3150128.230.help.text
msgid ""
"            <emph>Text</emph> is the text to be converted. To differentiate "
"between a hexadecimal number, such as A1 and the reference to cell A1, you "
"must place the number in quotation marks, for example, \"A1\" or \"FACE\"."
msgstr ""
"            <emph>Տեքստ</emph> փոխակերպվող տեքստն է: Տարբերելու համար "
"տասնվեցական թիվը, ինչպիսին է A1- ը և A1 բջջի հղումը, դուք պետք է թիվը "
"տեղադրեք չակերտների մեջ, օրինակ ՝ \"A1\" կամ \"FACE\":"

#: 04060110.xhp#par_id3145241.231.help.text
#: 04060110.xhp%23par_id3145241.231.help.text
msgctxt "04060110.xhp#par_id3145241.231.help.text"
msgid ""
"            <emph>Radix</emph> indicates the base of the number system. It "
"may be any positive integer between 2 and 36."
msgstr ""
"            <emph>Radix</emph> ցույց է տալիս թվային համակարգի հիմքը: Դա "
"կարող է լինել ցանկացած դրական ամբողջ թիվ 2-ի և 36-ի միջև:"

#: 04060110.xhp#hd_id3156062.232.help.text
#: 04060110.xhp%23hd_id3156062.232.help.text
msgctxt "04060110.xhp#hd_id3156062.232.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3145355.233.help.text
#: 04060110.xhp%23par_id3145355.233.help.text
msgid "            <item type=\"input\">=DECIMAL(\"17\";10)</item> returns 17."
msgstr ""
"            <item type=\"input\">=DECIMAL(\"17\";10)</item> վերադարձնում է "
"17։"

#: 04060110.xhp#par_id3155622.234.help.text
#: 04060110.xhp%23par_id3155622.234.help.text
msgid ""
"            <item type=\"input\">=DECIMAL(\"FACE\";16)</item> returns 64206."
msgstr ""
"            <item type=\"input\">=DECIMAL(\"FACE\";16)</item> վերադարձնում է "
"64206։"

#: 04060110.xhp#par_id3151015.235.help.text
#: 04060110.xhp%23par_id3151015.235.help.text
msgid "            <item type=\"input\">=DECIMAL(\"0101\";2)</item> returns 5."
msgstr ""
"            <item type=\"input\">=DECIMAL(\"0101\";2)</item> վերադարձնում է "
"5։"

#: 04060110.xhp#bm_id3148402.help.text
#: 04060110.xhp%23bm_id3148402.help.text
msgid "<bookmark_value>DOLLAR function</bookmark_value>"
msgstr "<bookmark_value>DOLLAR գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3148402.11.help.text
#: 04060110.xhp%23hd_id3148402.11.help.text
msgid "DOLLAR"
msgstr "DOLLAR"

#: 04060110.xhp#par_id3153049.12.help.text
#: 04060110.xhp%23par_id3153049.12.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_DM\">Converts a number to an amount in the currency "
"format, rounded to a specified decimal place.</ahelp> In the <item type=\""
"literal\">Value</item> field enter the number to be converted to currency. "
"Optionally, you may enter the number of decimal places in the <item type=\""
"literal\">Decimals</item> field. If no value is specified, all numbers in "
"currency format will be displayed with two decimal places. "
msgstr ""
"<ahelp hid=\"HID_FUNC_DM\">Վերափոխում է թիվը արժույթի ձևաչափով գումարի, "
"կլորացված սահմանված տասնորդական չափի:</ahelp> Այս <item type=\"literal\""
">Արժեք</item> դաշտում մուտքագրեք թիվը, որը պետք է փոխարկվի արժույթով: Ըստ "
"ցանկության, կարող եք մուտքագրել տասնորդական տեղերի քանակը <item type=\""
"literal\">Տասնորդականներ</item> դաշտում։ Եթե որևէ արժեք նշված չէ, արժույթի "
"ձևաչափով բոլոր թվերը կարտածվեն տասնորդական երկու դիրքով: "

#: 04060110.xhp#par_id3151280.263.help.text
#: 04060110.xhp%23par_id3151280.263.help.text
msgid "You set the currency format in your system settings."
msgstr "Դուք սահմանում եք արժույթի ձևաչափը ձեր համակարգի կարգաբերումներում:"

#: 04060110.xhp#hd_id3150569.13.help.text
#: 04060110.xhp%23hd_id3150569.13.help.text
msgctxt "04060110.xhp#hd_id3150569.13.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3154188.14.help.text
#: 04060110.xhp%23par_id3154188.14.help.text
msgid "DOLLAR(Value; Decimals)"
msgstr "DOLLAR(Value; Decimals)"

#: 04060110.xhp#par_id3145299.15.help.text
#: 04060110.xhp%23par_id3145299.15.help.text
msgid ""
"            <emph>Value</emph> is a number, a reference to a cell containing "
"a number, or a formula which returns a number."
msgstr ""
"            <emph>Արժեք</emph> թիվ է, հղում է թիվը պարունակող բջջին կամ "
"բանաձև է, որը վերադարձնում է թիվը:"

#: 04060110.xhp#par_id3145629.16.help.text
#: 04060110.xhp%23par_id3145629.16.help.text
msgid ""
"            <emph>Decimals</emph> is the optional number of decimal places."
msgstr ""
"            <emph>Տասնորդականներ</emph>տասնորդական դիրքերի կամընտրական թիվն "
"է:"

#: 04060110.xhp#hd_id3149030.17.help.text
#: 04060110.xhp%23hd_id3149030.17.help.text
msgctxt "04060110.xhp#hd_id3149030.17.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3153546.18.help.text
#: 04060110.xhp%23par_id3153546.18.help.text
msgid "            <item type=\"input\">=DOLLAR(255)</item> returns $255.00."
msgstr ""
"            <item type=\"input\">=DOLLAR(255)</item> վերադարձնում է $255.00։"

#: 04060110.xhp#par_id3154635.19.help.text
#: 04060110.xhp%23par_id3154635.19.help.text
msgid ""
"            <item type=\"input\">=DOLLAR(367.456;2)</item> returns $367.46. "
"Use the decimal separator that corresponds to the <link href=\""
"text/shared/optionen/01140000.xhp\" name=\"current locale setting\">current "
"locale setting</link>."
msgstr ""
"            <item type=\"input\">=DOLLAR(367.456;2)</item> վերադարձնում է "
"$367.46։ Օգտագործեք տասնորդական տարանջատիչը, որը համապատասխանում է <link "
"href=\"text/shared/optionen/01140000.xhp\" name=\"ընթացիկ տեղայինի "
"կարգաբերում\">ընթացիկ տեղայինի կարգաբերում</link>։"

#: 04060110.xhp#bm_id3150685.help.text
#: 04060110.xhp%23bm_id3150685.help.text
msgid "<bookmark_value>EXACT function</bookmark_value>"
msgstr "<bookmark_value>EXACT գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3150685.78.help.text
#: 04060110.xhp%23hd_id3150685.78.help.text
msgid "EXACT"
msgstr "EXACT"

#: 04060110.xhp#par_id3158413.79.help.text
#: 04060110.xhp%23par_id3158413.79.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_IDENTISCH\">Compares two text strings and returns TRUE "
"if they are identical.</ahelp> This function is case-sensitive."
msgstr ""
"<ahelp hid=\"HID_FUNC_IDENTISCH\">Համեմատում է տեքստային երկու տողերը և "
"վերադարձնում է TRUE, եթե դրանք նույնական են:</ahelp> Այս գործառույթը զգայուն "
"է ընտրությանը:"

#: 04060110.xhp#hd_id3152817.80.help.text
#: 04060110.xhp%23hd_id3152817.80.help.text
msgctxt "04060110.xhp#hd_id3152817.80.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3148594.81.help.text
#: 04060110.xhp%23par_id3148594.81.help.text
msgid "EXACT(\"Text1\"; \"Text2\")"
msgstr "EXACT(\"Text1\"; \"Text2\")"

#: 04060110.xhp#par_id3153224.82.help.text
#: 04060110.xhp%23par_id3153224.82.help.text
msgid "            <emph>Text1</emph> refers to the first text to compare."
msgstr ""
"            <emph>Text1</emph> վերաբերում է համեմատման ենթակա առաջին տեքստին:"

#: 04060110.xhp#par_id3148637.83.help.text
#: 04060110.xhp%23par_id3148637.83.help.text
msgid "            <emph>Text2</emph> is the second text to compare."
msgstr ""
"            <emph>Text2</emph> վերաբերում է համեմատման ենթակա երկրորդ "
"տեքստին:"

#: 04060110.xhp#hd_id3149777.84.help.text
#: 04060110.xhp%23hd_id3149777.84.help.text
msgctxt "04060110.xhp#hd_id3149777.84.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3156263.85.help.text
#: 04060110.xhp%23par_id3156263.85.help.text
msgid ""
"            <item type=\"input\">=EXACT(\"microsystems\";\"Microsystems\""
")</item> returns FALSE."
msgstr ""
"            <item type=\"input\">=EXACT(\"microsystems\";\"Microsystems\""
")</item> վերադարձնում է FALSE։"

#: 04060110.xhp#bm_id3152589.help.text
#: 04060110.xhp%23bm_id3152589.help.text
msgid "<bookmark_value>FIND function</bookmark_value>"
msgstr "<bookmark_value>FIND գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3152589.44.help.text
#: 04060110.xhp%23hd_id3152589.44.help.text
msgid "FIND"
msgstr "FIND"

#: 04060110.xhp#par_id3146149.45.help.text
#: 04060110.xhp%23par_id3146149.45.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_FINDEN\">Looks for a string of text within another "
"string.</ahelp> You can also define where to begin the search. The search "
"term can be a number or any string of characters. The search is case-"
"sensitive."
msgstr ""
"<ahelp hid=\"HID_FUNC_FINDEN\">Տեքստային տող է փնտրում մեկ այլ "
"տողում:</ahelp> Կարող եք նաև սահմանել, թե որտեղ պետք է սկսել որոնումը: "
"Որոնման տերմինը կարող է լինել թիվ կամ ցանկացած բնույթի նիշերի տող: Որոնումը "
"ընտրությանը զգայուն է:"

#: 04060110.xhp#hd_id3083284.46.help.text
#: 04060110.xhp%23hd_id3083284.46.help.text
msgctxt "04060110.xhp#hd_id3083284.46.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3083452.47.help.text
#: 04060110.xhp%23par_id3083452.47.help.text
msgid "FIND(\"FindText\"; \"Text\"; Position)"
msgstr "FIND(\"FindText\"; \"Text\"; Position)"

#: 04060110.xhp#par_id3150608.48.help.text
#: 04060110.xhp%23par_id3150608.48.help.text
msgid "            <emph>FindText</emph> refers to the text to be found."
msgstr "            <emph>FindText</emph> վերաբերում է փնտրվող տեքստին:"

#: 04060110.xhp#par_id3152374.49.help.text
#: 04060110.xhp%23par_id3152374.49.help.text
msgid "            <emph>Text</emph> is the text where the search takes place."
msgstr ""
"            <emph>Տեքստ</emph> այն տեքստն է, որտեղ կատարվում է որոնումը:"

#: 04060110.xhp#par_id3152475.50.help.text
#: 04060110.xhp%23par_id3152475.50.help.text
msgid ""
"            <emph>Position</emph> (optional) is the position in the text "
"from which the search starts."
msgstr ""
"            <emph>Դիրք</emph> (կամընտրական) այն դիրքն է տեքստում, որից "
"սկսվում է որոնումը:"

#: 04060110.xhp#hd_id3154812.51.help.text
#: 04060110.xhp%23hd_id3154812.51.help.text
msgctxt "04060110.xhp#hd_id3154812.51.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3156375.52.help.text
#: 04060110.xhp%23par_id3156375.52.help.text
msgid ""
"            <item type=\"input\">=FIND(76;998877665544)</item> returns 6."
msgstr ""
"            <item type=\"input\">=FIND(76;998877665544)</item> վերադարձնում "
"է 6։"

#: 04060110.xhp#bm_id3149268.help.text
#: 04060110.xhp%23bm_id3149268.help.text
msgid "<bookmark_value>FIXED function</bookmark_value>"
msgstr "<bookmark_value>FIXED գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3149268.34.help.text
#: 04060110.xhp%23hd_id3149268.34.help.text
msgid "FIXED"
msgstr "FIXED"

#: 04060110.xhp#par_id3155833.35.help.text
#: 04060110.xhp%23par_id3155833.35.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_FEST\">Returns a number as text with a specified "
"number of decimal places and optional thousands separators.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_FEST\">Վերադարձնում է թիվը որպես տեքստ, տասնորդական "
"դիրքերի որոշված քանակով և հազարականների կամընտրական տարանջատիչներով:</ahelp>"

#: 04060110.xhp#hd_id3152470.36.help.text
#: 04060110.xhp%23hd_id3152470.36.help.text
msgctxt "04060110.xhp#hd_id3152470.36.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3147567.37.help.text
#: 04060110.xhp%23par_id3147567.37.help.text
msgid "FIXED(Number; Decimals; NoThousandsSeparators)"
msgstr "FIXED(Number; Decimals; NoThousandsSeparators)"

#: 04060110.xhp#par_id3151272.38.help.text
#: 04060110.xhp%23par_id3151272.38.help.text
msgid "            <emph>Number</emph> refers to the number to be formatted."
msgstr "            <emph>Թիվ</emph> վերաբերում է ձևափոխման ենթակա թվին:"

#: 04060110.xhp#par_id3156322.39.help.text
#: 04060110.xhp%23par_id3156322.39.help.text
msgid ""
"            <emph>Decimals</emph> refers to the number of decimal places to "
"be displayed."
msgstr ""
"            <emph>Տասնորդականներ</emph> վերաբերում է արտածվող տասնորդական "
"դիրքերի քանակին:"

#: 04060110.xhp#par_id3150877.40.help.text
#: 04060110.xhp%23par_id3150877.40.help.text
msgid ""
"            <emph>NoThousandsSeparators</emph> (optional) determines whether "
"the thousands separator is used. If the parameter is a number not equal to "
"0, the thousands separator is suppressed. If the parameter is equal to 0 or "
"if it is missing altogether, the thousands separators of your <link href=\""
"text/shared/optionen/01140000.xhp\" name=\"current locale setting\">current "
"locale setting</link> are displayed."
msgstr ""
"            <emph>NoThousandsSeparators</emph> (կամընտրական) որոշում է, թե "
"օգտագործվում է հազարականի բաժանարարը: Եթե պարամետրը մի թիվ է, որը հավասար չէ "
"0-ի, ապա հազարականի բաժանարարը ճնշվում է: Եթե պարամետրը հավասար է 0-ի, կամ "
"եթե այն ընդհանրապես բացակայում է, հազարականի բաժանարարները <link href=\""
"text/shared/optionen/01140000.xhp\" name=\"ընթացիկ տեղայինի կարգաբերում\">"
"ընթացիկ տեղայինի կարգաբերում</link> արտածվում են:"

#: 04060110.xhp#hd_id3149040.41.help.text
#: 04060110.xhp%23hd_id3149040.41.help.text
msgctxt "04060110.xhp#hd_id3149040.41.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3145208.42.help.text
#: 04060110.xhp%23par_id3145208.42.help.text
msgid ""
"            <item type=\"input\">=FIXED(1234567.89;3)</item> returns "
"1,234,567.890 as a text string. "
msgstr ""
"            <item type=\"input\">=FIXED(1234567.89;3)</item> վերադարձնում է "
"1,234,567.890 որպես տեքստային տող։ "

#: 04060110.xhp#par_id5282143.help.text
#: 04060110.xhp%23par_id5282143.help.text
msgid ""
"            <item type=\"input\">=FIXED(1234567.89;3;1)</item> returns "
"1234567.890 as a text string."
msgstr ""
"            <item type=\"input\">=FIXED(1234567.89;3;1)</item> վերադարձնում "
"է 1234567.890 որպես տեքստային տող։"

#: 04060110.xhp#bm_id7319864.help.text
#: 04060110.xhp%23bm_id7319864.help.text
msgid "<bookmark_value>JIS function</bookmark_value>"
msgstr "<bookmark_value>JIS գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3666188.help.text
#: 04060110.xhp%23hd_id3666188.help.text
msgid "JIS"
msgstr "JIS"

#: 04060110.xhp#par_id964384.help.text
#: 04060110.xhp%23par_id964384.help.text
msgid ""
"<ahelp hid=\".\">The JIS function converts half-width to full-width ASCII "
"and katakana characters. Returns a text string.</ahelp>"
msgstr ""
"<ahelp hid=\".\">JIS գործառույթը կես լայնությունը վերածում է ամբողջ "
"լայնության ASCII և կատականա նիշերով: Վերադարձնում է տեքստի տողը:</ahelp>"

#: 04060110.xhp#par_id1551561.help.text
#: 04060110.xhp%23par_id1551561.help.text
msgctxt "04060110.xhp#par_id1551561.help.text"
msgid ""
"See <link href=\"https://wiki.openoffice.org/wiki/Calc/Features/"
"JIS_and_ASC_functions\">JIS and ASC Spreadsheet Functions</link> for a "
"conversion table."
msgstr ""
"Տե՛ս <link href=\"https://wiki.openoffice.org/wiki/Calc/Features/"
"JIS_and_ASC_functions\">JIS and ASC Spreadsheet Functions</link> ձևափոխման "
"աղյուսակի համար։"

#: 04060110.xhp#hd_id2212897.help.text
#: 04060110.xhp%23hd_id2212897.help.text
msgctxt "04060110.xhp#hd_id2212897.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id2504654.help.text
#: 04060110.xhp%23par_id2504654.help.text
msgid "JIS(\"Text\")"
msgstr "JIS(\"Text\")"

#: 04060110.xhp#par_id5292519.help.text
#: 04060110.xhp%23par_id5292519.help.text
msgctxt "04060110.xhp#par_id5292519.help.text"
msgid ""
"            <emph>Text</emph> is the text that contains characters to be "
"converted."
msgstr ""
"            <emph>Տեքստ</emph> տեքստն է, որը պարունակում է ձևափոխման նիշերը։"

#: 04060110.xhp#par_id3984496.help.text
#: 04060110.xhp%23par_id3984496.help.text
msgid "See also ASC function."
msgstr "Տե՛ս նաև ASC գործառույթը։"

#: 04060110.xhp#bm_id3147083.help.text
#: 04060110.xhp%23bm_id3147083.help.text
msgid "<bookmark_value>LEFT function</bookmark_value>"
msgstr "<bookmark_value>LEFT գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3147083.95.help.text
#: 04060110.xhp%23hd_id3147083.95.help.text
msgid "LEFT"
msgstr "LEFT"

#: 04060110.xhp#par_id3153622.96.help.text
#: 04060110.xhp%23par_id3153622.96.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_LINKS\">Returns the first character or characters of a "
"text.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_LINKS\">Վերադարձնում է տեքստի առաջին նիշը կամ "
"նիշերը:</ahelp>"

#: 04060110.xhp#hd_id3156116.97.help.text
#: 04060110.xhp%23hd_id3156116.97.help.text
msgctxt "04060110.xhp#hd_id3156116.97.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3146786.98.help.text
#: 04060110.xhp%23par_id3146786.98.help.text
msgid "LEFT(\"Text\"; Number)"
msgstr "LEFT(\"Text\"; Number)"

#: 04060110.xhp#par_id3147274.99.help.text
#: 04060110.xhp%23par_id3147274.99.help.text
msgid ""
"            <emph>Text</emph> is the text where the initial partial words "
"are to be determined."
msgstr ""
"            <emph>Տեքստ</emph> տեքստն է, որում պետք է որոշվեն նախնական "
"մասնակի բառերը:"

#: 04060110.xhp#par_id3153152.100.help.text
#: 04060110.xhp%23par_id3153152.100.help.text
msgid ""
"            <emph>Number</emph> (optional) specifies the number of "
"characters for the start text. If this parameter is not defined, one "
"character is returned."
msgstr ""
"            <emph>Թիվ</emph> (կամընտրական) սահմանում է սկզբնական տեքստի "
"նիշերի քանակը: Եթե այս պարամետրը սահմանված չէ, վերադարձվում է մեկ նիշ:"

#: 04060110.xhp#hd_id3150260.101.help.text
#: 04060110.xhp%23hd_id3150260.101.help.text
msgctxt "04060110.xhp#hd_id3150260.101.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3149141.102.help.text
#: 04060110.xhp%23par_id3149141.102.help.text
msgid ""
"            <item type=\"input\">=LEFT(\"output\";3)</item> returns “out”."
msgstr ""
"            <item type=\"input\">=LEFT(\"output\";3)</item> վերադարձնում է "
"“out”։"

#: 04060110.xhp#bm_id3156110.help.text
#: 04060110.xhp%23bm_id3156110.help.text
msgid "<bookmark_value>LEN function</bookmark_value>"
msgstr "<bookmark_value>LEN գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3156110.104.help.text
#: 04060110.xhp%23hd_id3156110.104.help.text
msgid "LEN"
msgstr "LEN"

#: 04060110.xhp#par_id3150147.105.help.text
#: 04060110.xhp%23par_id3150147.105.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_LAENGE\">Returns the length of a string including "
"spaces.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_LAENGE\">Վերադարձնում է տողի երկարությունը, ներառյալ "
"բացատները:</ahelp>"

#: 04060110.xhp#hd_id3155108.106.help.text
#: 04060110.xhp%23hd_id3155108.106.help.text
msgctxt "04060110.xhp#hd_id3155108.106.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3154063.107.help.text
#: 04060110.xhp%23par_id3154063.107.help.text
msgid "LEN(\"Text\")"
msgstr "LEN(\"Text\")"

#: 04060110.xhp#par_id3146894.108.help.text
#: 04060110.xhp%23par_id3146894.108.help.text
msgid ""
"            <emph>Text</emph> is the text whose length is to be determined."
msgstr ""
"            <emph>Տեքստ</emph> այն տեքստն է, որի երկարությունը պետք է որոշվի:"

#: 04060110.xhp#hd_id3153884.109.help.text
#: 04060110.xhp%23hd_id3153884.109.help.text
msgctxt "04060110.xhp#hd_id3153884.109.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3156008.110.help.text
#: 04060110.xhp%23par_id3156008.110.help.text
msgid ""
"            <item type=\"input\">=LEN(\"Good Afternoon\")</item> returns 14."
msgstr ""
"            <item type=\"input\">=LEN(\"Good Afternoon\")</item> "
"վերադարձնում է 14։"

#: 04060110.xhp#par_id3154300.111.help.text
#: 04060110.xhp%23par_id3154300.111.help.text
msgid "            <item type=\"input\">=LEN(12345.67)</item> returns 8."
msgstr ""
"            <item type=\"input\">=LEN(12345.67)</item> վերադարձնում է 8։"

#: 04060110.xhp#bm_id3153983.help.text
#: 04060110.xhp%23bm_id3153983.help.text
msgid "<bookmark_value>LOWER function</bookmark_value>"
msgstr "<bookmark_value>LOWER գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3153983.87.help.text
#: 04060110.xhp%23hd_id3153983.87.help.text
msgid "LOWER"
msgstr "LOWER"

#: 04060110.xhp#par_id3152791.88.help.text
#: 04060110.xhp%23par_id3152791.88.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_KLEIN\">Converts all uppercase letters in a text "
"string to lowercase.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_KLEIN\">Ձևափոխում է տեքստի բոլոր մեծատառերը "
"փոքրատառերի։</ahelp>"

#: 04060110.xhp#hd_id3155902.89.help.text
#: 04060110.xhp%23hd_id3155902.89.help.text
msgctxt "04060110.xhp#hd_id3155902.89.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3150121.90.help.text
#: 04060110.xhp%23par_id3150121.90.help.text
msgid "LOWER(\"Text\")"
msgstr "LOWER(\"Text\")"

#: 04060110.xhp#par_id3153910.91.help.text
#: 04060110.xhp%23par_id3153910.91.help.text
msgctxt "04060110.xhp#par_id3153910.91.help.text"
msgid "            <emph>Text</emph> refers to the text to be converted."
msgstr "            <emph>Տեքստ</emph> վերաբերում է վերափոխվող տեքստին:"

#: 04060110.xhp#hd_id3159343.92.help.text
#: 04060110.xhp%23hd_id3159343.92.help.text
msgctxt "04060110.xhp#hd_id3159343.92.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3155329.93.help.text
#: 04060110.xhp%23par_id3155329.93.help.text
msgid "            <item type=\"input\">=LOWER(\"Sun\")</item> returns sun."
msgstr ""
"            <item type=\"input\">=LOWER(\"Արև\")</item> վերադարձնում է արև։"

#: 04060110.xhp#bm_id3154589.help.text
#: 04060110.xhp%23bm_id3154589.help.text
msgid "<bookmark_value>MID function</bookmark_value>"
msgstr "<bookmark_value>MID գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3154589.148.help.text
#: 04060110.xhp%23hd_id3154589.148.help.text
msgid "MID"
msgstr "MID"

#: 04060110.xhp#par_id3154938.149.help.text
#: 04060110.xhp%23par_id3154938.149.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_TEIL\">Returns a text string of a text. The parameters "
"specify the starting position and the number of characters.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_TEIL\">Վերադարձնում է տեքստի տողի մի տողը: Պարամետրերը "
"նշում են մեկնարկային դիրքը և նիշերի քանակը:</ahelp>"

#: 04060110.xhp#hd_id3148829.150.help.text
#: 04060110.xhp%23hd_id3148829.150.help.text
msgctxt "04060110.xhp#hd_id3148829.150.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3150526.151.help.text
#: 04060110.xhp%23par_id3150526.151.help.text
msgid "MID(\"Text\"; Start; Number)"
msgstr "MID(\"Text\"; Start; Number)"

#: 04060110.xhp#par_id3148820.152.help.text
#: 04060110.xhp%23par_id3148820.152.help.text
msgid ""
"            <emph>Text</emph> is the text containing the characters to "
"extract."
msgstr "            <emph>Տեքստ</emph> տեքստի նիշերն են ենթակա դուրս բերման:"

#: 04060110.xhp#par_id3150774.153.help.text
#: 04060110.xhp%23par_id3150774.153.help.text
msgid ""
"            <emph>Start</emph> is the position of the first character in the "
"text to extract."
msgstr ""
"            <emph>Սկիզբ</emph> տեքստում դուրս բերման ենթակա առաջին նիշի "
"դիրքն է:"

#: 04060110.xhp#par_id3153063.154.help.text
#: 04060110.xhp%23par_id3153063.154.help.text
msgid ""
"            <emph>Number</emph> specifies the number of characters in the "
"part of the text."
msgstr "            <emph>Թիվ</emph> նշում է տեքստի մասի նիշերի քանակը:"

#: 04060110.xhp#hd_id3150509.155.help.text
#: 04060110.xhp%23hd_id3150509.155.help.text
msgctxt "04060110.xhp#hd_id3150509.155.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3158407.156.help.text
#: 04060110.xhp%23par_id3158407.156.help.text
msgid ""
"            <item type=\"input\">=MID(\"office\";2;2)</item> returns ff."
msgstr ""
"            <item type=\"input\">=MID(\"office\";2;2)</item> վերադարձնում է "
"ff։"

#: 04060110.xhp#bm_id3159143.help.text
#: 04060110.xhp%23bm_id3159143.help.text
msgid "<bookmark_value>PROPER function</bookmark_value>"
msgstr "<bookmark_value>PROPER գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3159143.70.help.text
#: 04060110.xhp%23hd_id3159143.70.help.text
msgid "PROPER"
msgstr "PROPER"

#: 04060110.xhp#par_id3149768.71.help.text
#: 04060110.xhp%23par_id3149768.71.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_GROSS2\">Capitalizes the first letter in all words of "
"a text string.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_GROSS2\">Դարձնում է մեծատառ տեքստային տողի բոլոր "
"բառերի առաջին տառը:</ahelp>"

#: 04060110.xhp#hd_id3153573.72.help.text
#: 04060110.xhp%23hd_id3153573.72.help.text
msgctxt "04060110.xhp#hd_id3153573.72.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3154260.73.help.text
#: 04060110.xhp%23par_id3154260.73.help.text
msgid "PROPER(\"Text\")"
msgstr "PROPER(\"Text\")"

#: 04060110.xhp#par_id3147509.74.help.text
#: 04060110.xhp%23par_id3147509.74.help.text
msgctxt "04060110.xhp#par_id3147509.74.help.text"
msgid "            <emph>Text</emph> refers to the text to be converted."
msgstr "            <emph>Տեքստ</emph> վերաբերում է ձևափոխվող տեքստին:"

#: 04060110.xhp#hd_id3147529.75.help.text
#: 04060110.xhp%23hd_id3147529.75.help.text
msgctxt "04060110.xhp#hd_id3147529.75.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3155364.76.help.text
#: 04060110.xhp%23par_id3155364.76.help.text
msgid ""
"            <item type=\"input\">=PROPER(\"open office\")</item> returns "
"Open Office."
msgstr ""
"            <item type=\"input\">=PROPER(\"open office\")</item> "
"վերադարձնում է Open Office։"

#: 04060110.xhp#bm_id3149171.help.text
#: 04060110.xhp%23bm_id3149171.help.text
msgid "<bookmark_value>REPLACE function</bookmark_value>"
msgstr "<bookmark_value>REPLACE գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3149171.22.help.text
#: 04060110.xhp%23hd_id3149171.22.help.text
msgid "REPLACE"
msgstr "REPLACE"

#: 04060110.xhp#par_id3148925.23.help.text
#: 04060110.xhp%23par_id3148925.23.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_ERSETZEN\">Replaces part of a text string with a "
"different text string.</ahelp> This function can be used to replace both "
"characters and numbers (which are automatically converted to text). The "
"result of the function is always displayed as text. If you intend to perform "
"further calculations with a number which has been replaced by text, you will "
"need to convert it back to a number using the <link href=\""
"text/scalc/01/04060110.xhp\" name=\"VALUE\">VALUE</link> function."
msgstr ""
"<ahelp hid=\"HID_FUNC_ERSETZEN\">Տեքստի տողի մի մասը փոխարինում է այլ տեքստի "
"տողով:</ahelp> Այս գործառույթը կարող է օգտագործվել ինչպես նիշերի, այնպես էլ "
"թվերի փոխարինման համար (որոնք ինքնաբերաբար վերածվում են տեքստի): Գործառույթի "
"արդյունքը միշտ ցուցադրվում է որպես տեքստ: Եթե մտադիր եք հետագա հաշվարկները "
"կատարել տեքստով փոխարինված թվով, ապա ձեզ հարկավոր է այն հետ վերափոխել թվի, "
"օգտագործելով <link href=\"text/scalc/01/04060110.xhp\" name=\"VALUE\""
">VALUE</link> գործառույթը։"

#: 04060110.xhp#par_id3158426.24.help.text
#: 04060110.xhp%23par_id3158426.24.help.text
msgid ""
"Any text containing numbers must be enclosed in quotation marks if you do "
"not want it to be interpreted as a number and automatically converted to "
"text."
msgstr ""
"Ցանկացած թվեր պարունակող տեքստը պետք է ներառված լինեն չակերտներում, եթե չես "
"ուզում, որ այն մեկնաբանվի որպես թիվ և ինքնաբերաբար վերածվի տեքստի:"

#: 04060110.xhp#hd_id3149159.25.help.text
#: 04060110.xhp%23hd_id3149159.25.help.text
msgctxt "04060110.xhp#hd_id3149159.25.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3147286.26.help.text
#: 04060110.xhp%23par_id3147286.26.help.text
msgid "REPLACE(\"Text\"; Position; Length; \"NewText\")"
msgstr "REPLACE(\"Text\"; Position; Length; \"NewText\")"

#: 04060110.xhp#par_id3149797.27.help.text
#: 04060110.xhp%23par_id3149797.27.help.text
msgid ""
"            <emph>Text</emph> refers to text of which a part will be "
"replaced."
msgstr ""
"            <emph>Տեքստ</emph> վերաբերում է տեքստին, որի մի մասը կփոխարինվի:"

#: 04060110.xhp#par_id3166451.28.help.text
#: 04060110.xhp%23par_id3166451.28.help.text
msgid ""
"            <emph>Position</emph> refers to the position within the text "
"where the replacement will begin."
msgstr ""
"            <emph>Դիրք</emph> վերաբերում է տեքստում գտնվող այն դիրքին, որտեղ "
"կսկսվի փոխարինումը:"

#: 04060110.xhp#par_id3156040.29.help.text
#: 04060110.xhp%23par_id3156040.29.help.text
msgid ""
"            <emph>Length</emph> is the number of characters in "
"<emph>Text</emph> to be replaced."
msgstr ""
"            <emph>Լայնք</emph> Փոխարինման ենթակա նիշերի թիվն է "
"<emph>Տեքստ</emph> -ում։"

#: 04060110.xhp#par_id3159188.30.help.text
#: 04060110.xhp%23par_id3159188.30.help.text
msgid ""
"            <emph>NewText</emph> refers to the text which replaces "
"<emph>Text</emph>."
msgstr ""
"            <emph>NewText</emph> վերաբերում է այն տեքստին, որը փոխարինում է "
"<emph>Տեքստ</emph> -ը։"

#: 04060110.xhp#hd_id3146958.31.help.text
#: 04060110.xhp%23hd_id3146958.31.help.text
msgctxt "04060110.xhp#hd_id3146958.31.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3154096.32.help.text
#: 04060110.xhp%23par_id3154096.32.help.text
msgid ""
"            <item type=\"input\">=REPLACE(\"1234567\";1;1;\"444\")</item> "
"returns \"444234567\". One character at position 1 is replaced by the "
"complete <item type=\"literal\">NewText</item>."
msgstr ""
"            <item type=\"input\">=REPLACE(\"1234567\";1;1;\"444\")</item> "
"վերադարձնում է \"444234567\"։ 1-ին դիրքում մեկ նիշ փոխարինվում է ամբողջական <"
"item type=\"literal\">NewText</item> -ով:"

#: 04060110.xhp#bm_id3149741.help.text
#: 04060110.xhp%23bm_id3149741.help.text
msgid "<bookmark_value>REPT function</bookmark_value>"
msgstr "<bookmark_value>REPT գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3149741.193.help.text
#: 04060110.xhp%23hd_id3149741.193.help.text
msgid "REPT"
msgstr "REPT"

#: 04060110.xhp#par_id3153748.194.help.text
#: 04060110.xhp%23par_id3153748.194.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_WIEDERHOLEN\">Repeats a character string by the given "
"<emph>number</emph> of copies.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_WIEDERHOLEN\">Կրկնում է նիշերի տողը տրված "
"<emph>քանակի</emph> պատճեններով։</ahelp>"

#: 04060110.xhp#hd_id3152884.195.help.text
#: 04060110.xhp%23hd_id3152884.195.help.text
msgctxt "04060110.xhp#hd_id3152884.195.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3150494.196.help.text
#: 04060110.xhp%23par_id3150494.196.help.text
msgid "REPT(\"Text\"; Number)"
msgstr "REPT(\"Text\"; Number)"

#: 04060110.xhp#par_id3154859.197.help.text
#: 04060110.xhp%23par_id3154859.197.help.text
msgid "            <emph>Text</emph> is the text to be repeated."
msgstr "            <emph>Տեքստ</emph> կրկնվող տեքստն է։"

#: 04060110.xhp#par_id3150638.198.help.text
#: 04060110.xhp%23par_id3150638.198.help.text
msgid "            <emph>Number</emph> is the number of repetitions."
msgstr "            <emph>Թիվ</emph> կրկնությունների քանակն է։"

#: 04060110.xhp#par_id3149922.212.help.text
#: 04060110.xhp%23par_id3149922.212.help.text
msgid "The result can be a maximum of 255 characters."
msgstr "Արդյունքը կարող է լինել մեծագույնը 255 նիշ։"

#: 04060110.xhp#hd_id3156213.199.help.text
#: 04060110.xhp%23hd_id3156213.199.help.text
msgctxt "04060110.xhp#hd_id3156213.199.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3148626.200.help.text
#: 04060110.xhp%23par_id3148626.200.help.text
msgid ""
"            <item type=\"input\">=REPT(\"Good morning\";2)</item> returns "
"Good morningGood morning."
msgstr ""
"            <item type=\"input\">=REPT(\"Good morning\";2)</item> "
"վերադարձնում է Good morningGood morning։"

#: 04060110.xhp#bm_id3149805.help.text
#: 04060110.xhp%23bm_id3149805.help.text
msgid "<bookmark_value>RIGHT function</bookmark_value>"
msgstr "<bookmark_value>RIGHT գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3149805.113.help.text
#: 04060110.xhp%23hd_id3149805.113.help.text
msgid "RIGHT"
msgstr "RIGHT"

#: 04060110.xhp#par_id3145375.114.help.text
#: 04060110.xhp%23par_id3145375.114.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_RECHTS\">Returns the last character or characters of a "
"text.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_RECHTS\">Վերադարձնում է վերջին նիշը կամ տեքստի "
"նիշերը:</ahelp>"

#: 04060110.xhp#hd_id3150837.115.help.text
#: 04060110.xhp%23hd_id3150837.115.help.text
msgctxt "04060110.xhp#hd_id3150837.115.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3154344.116.help.text
#: 04060110.xhp%23par_id3154344.116.help.text
msgid "RIGHT(\"Text\"; Number)"
msgstr "RIGHT(\"Text\"; Number)"

#: 04060110.xhp#par_id3149426.117.help.text
#: 04060110.xhp%23par_id3149426.117.help.text
msgid ""
"            <emph>Text</emph> is the text of which the right part is to be "
"determined."
msgstr "            <emph>Տեքստ</emph> տեքստն է, որի աջ մասը պետք է որոշվի:"

#: 04060110.xhp#par_id3153350.118.help.text
#: 04060110.xhp%23par_id3153350.118.help.text
msgid ""
"            <emph>Number</emph> (optional) is the number of characters from "
"the right part of the text."
msgstr ""
"            <emph>Թիվ</emph> (կամընտրական) տեքստի աջ մասից նիշերի քանակն է:"

#: 04060110.xhp#hd_id3148661.119.help.text
#: 04060110.xhp%23hd_id3148661.119.help.text
msgctxt "04060110.xhp#hd_id3148661.119.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3151132.120.help.text
#: 04060110.xhp%23par_id3151132.120.help.text
msgid "            <item type=\"input\">=RIGHT(\"Sun\";2)</item> returns un."
msgstr ""
"            <item type=\"input\">=RIGHT(\"Sun\";2)</item> վերադարձնում է un։"

#: 04060110.xhp#bm_id3153534.help.text
#: 04060110.xhp%23bm_id3153534.help.text
msgid "<bookmark_value>ROMAN function</bookmark_value>"
msgstr "<bookmark_value>ROMAN գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3153534.248.help.text
#: 04060110.xhp%23hd_id3153534.248.help.text
msgid "ROMAN"
msgstr "ROMAN"

#: 04060110.xhp#par_id3151256.249.help.text
#: 04060110.xhp%23par_id3151256.249.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_ROEMISCH\">Converts a number into a Roman numeral. The "
"value range must be between 0 and 3999, the modes can be integers from 0 to "
"4.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_ROEMISCH\">Թիվը վերածում է հռոմեական թվանշանի: Արժեքի "
"միջակայքը պետք է լինի 0-ից 3999, ռեժիմները կարող են լինել ամբողջական թվեր 0-"
"ից 4-ի սահմաններում:</ahelp>"

#: 04060110.xhp#hd_id3149299.250.help.text
#: 04060110.xhp%23hd_id3149299.250.help.text
msgctxt "04060110.xhp#hd_id3149299.250.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3150593.251.help.text
#: 04060110.xhp%23par_id3150593.251.help.text
msgid "ROMAN(Number; Mode)"
msgstr "ROMAN(Number; Mode)"

#: 04060110.xhp#par_id3156139.252.help.text
#: 04060110.xhp%23par_id3156139.252.help.text
msgid ""
"            <emph>Number</emph> is the number that is to be converted into a "
"Roman numeral."
msgstr ""
"            <emph>Թիվ</emph> այն թիվն է, որը պետք է վերածվի հռոմեական "
"թվանշանի։"

#: 04060110.xhp#par_id3153318.253.help.text
#: 04060110.xhp%23par_id3153318.253.help.text
msgid ""
"            <emph>Mode</emph> (optional) indicates the degree of "
"simplification. The higher the value, the greater is the simplification of "
"the Roman number."
msgstr ""
"            <emph>Ռեժիմ</emph> (կամընտրական) ցույց է տալիս պարզեցման "
"աստիճանը: Որքան բարձր է արժեքը, այնքան ավելի մեծ է հռոմեական թվանշանի "
"պարզեցումը:"

#: 04060110.xhp#hd_id3145306.254.help.text
#: 04060110.xhp%23hd_id3145306.254.help.text
msgctxt "04060110.xhp#hd_id3145306.254.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3151371.255.help.text
#: 04060110.xhp%23par_id3151371.255.help.text
msgid "            <item type=\"input\">=ROMAN(999)</item> returns CMXCIX"
msgstr ""
"            <item type=\"input\">=ROMAN(999)</item> վերադարձնում է CMXCIX"

#: 04060110.xhp#par_id3153938.256.help.text
#: 04060110.xhp%23par_id3153938.256.help.text
msgid "            <item type=\"input\">=ROMAN(999;0)</item> returns CMXCIX"
msgstr ""
"            <item type=\"input\">=ROMAN(999;0)</item> վերադարձնում է CMXCIX"

#: 04060110.xhp#par_id3148412.257.help.text
#: 04060110.xhp%23par_id3148412.257.help.text
msgid "            <item type=\"input\">=ROMAN (999;1)</item> returns LMVLIV"
msgstr ""
"            <item type=\"input\">=ROMAN (999;1)</item> վերադարձնում է LMVLIV"

#: 04060110.xhp#par_id3155421.258.help.text
#: 04060110.xhp%23par_id3155421.258.help.text
msgid "            <item type=\"input\">=ROMAN(999;2)</item> returns XMIX"
msgstr ""
"            <item type=\"input\">=ROMAN(999;2)</item> վերադարձնում է XMIX"

#: 04060110.xhp#par_id3149235.259.help.text
#: 04060110.xhp%23par_id3149235.259.help.text
msgid "            <item type=\"input\">=ROMAN(999;3)</item> returns VMIV"
msgstr ""
"            <item type=\"input\">=ROMAN(999;3)</item> վերադարձնում է VMIV"

#: 04060110.xhp#par_id3150624.260.help.text
#: 04060110.xhp%23par_id3150624.260.help.text
msgid "            <item type=\"input\">=ROMAN(999;4)</item> returns IM"
msgstr "            <item type=\"input\">=ROMAN(999;4)</item> վերադարձնում է IM"

#: 04060110.xhp#bm_id3151005.help.text
#: 04060110.xhp%23bm_id3151005.help.text
msgid "<bookmark_value>SEARCH function</bookmark_value>"
msgstr "<bookmark_value>SEARCH գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3151005.122.help.text
#: 04060110.xhp%23hd_id3151005.122.help.text
msgid "SEARCH"
msgstr "SEARCH"

#: 04060110.xhp#par_id3148692.123.help.text
#: 04060110.xhp%23par_id3148692.123.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_SUCHEN\">Returns the position of a text segment within "
"a character string.</ahelp> You can set the start of the search as an "
"option. The search text can be a number or any sequence of characters. The "
"search is not case-sensitive."
msgstr ""
"<ahelp hid=\"HID_FUNC_SUCHEN\">Նիշերի տողից վերադարձնում է տեքստային հատվածի "
"դիրքը: </ahelp> Կարող եք որոնման սկիզբը դնել որպես տարբերակ: Որոնման տեքստը "
"կարող է լինել թիվ կամ նիշերի ցանկացած հաջորդականություն: Որոնումը դեպքի "
"ընտրությանը զգայուն չէ։"

#: 04060110.xhp#hd_id3152964.124.help.text
#: 04060110.xhp%23hd_id3152964.124.help.text
msgctxt "04060110.xhp#hd_id3152964.124.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3154671.125.help.text
#: 04060110.xhp%23par_id3154671.125.help.text
msgid "SEARCH(\"FindText\"; \"Text\"; Position)"
msgstr "SEARCH(\"FindText\"; \"Text\"; Position)"

#: 04060110.xhp#par_id3146080.126.help.text
#: 04060110.xhp%23par_id3146080.126.help.text
msgid "            <emph>FindText</emph> is the text to be searched for."
msgstr "            <emph>FindText</emph> փնտրման տեքստ է։"

#: 04060110.xhp#par_id3154111.127.help.text
#: 04060110.xhp%23par_id3154111.127.help.text
msgid ""
"            <emph>Text</emph> is the text where the search will take place."
msgstr "            <emph>Տեքստ</emph> տեստն է, որում կկատարվի որոնումը։"

#: 04060110.xhp#par_id3149559.128.help.text
#: 04060110.xhp%23par_id3149559.128.help.text
msgid ""
"            <emph>Position</emph> (optional) is the position in the text "
"where the search is to start."
msgstr ""
"            <emph>Դիրք</emph> (կամընտրական) տեքստի այն դիրքն է, որտեղից պետք "
"է սկսվի որոնումը:"

#: 04060110.xhp#hd_id3147322.129.help.text
#: 04060110.xhp%23hd_id3147322.129.help.text
msgctxt "04060110.xhp#hd_id3147322.129.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3154564.130.help.text
#: 04060110.xhp%23par_id3154564.130.help.text
msgid ""
"            <item type=\"input\">=SEARCH(54;998877665544)</item> returns 10."
msgstr ""
"            <item type=\"input\">=SEARCH(54;998877665544)</item> "
"վերադարձնում է 10։"

#: 04060110.xhp#bm_id3154830.help.text
#: 04060110.xhp%23bm_id3154830.help.text
msgid "<bookmark_value>SUBSTITUTE function</bookmark_value>"
msgstr "<bookmark_value>SUBSTITUTE գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3154830.174.help.text
#: 04060110.xhp%23hd_id3154830.174.help.text
msgid "SUBSTITUTE"
msgstr "SUBSTITUTE"

#: 04060110.xhp#par_id3153698.175.help.text
#: 04060110.xhp%23par_id3153698.175.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_WECHSELN\">Substitutes new text for old text in a "
"string.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_WECHSELN\">Տողում հին տեքստի փոխարինում է "
"նորով։</ahelp>"

#: 04060110.xhp#hd_id3150994.176.help.text
#: 04060110.xhp%23hd_id3150994.176.help.text
msgctxt "04060110.xhp#hd_id3150994.176.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3147582.177.help.text
#: 04060110.xhp%23par_id3147582.177.help.text
msgid "SUBSTITUTE(\"Text\"; \"SearchText\"; \"NewText\"; Occurrence)"
msgstr "SUBSTITUTE(\"Text\"; \"SearchText\"; \"NewText\"; Occurrence)"

#: 04060110.xhp#par_id3153675.178.help.text
#: 04060110.xhp%23par_id3153675.178.help.text
msgid ""
"            <emph>Text</emph> is the text in which text segments are to be "
"exchanged."
msgstr ""
"            <emph>Տեքստ</emph> այն տեքստն է, որում պետք է փոխանակվեն "
"տեքստային հատվածները:"

#: 04060110.xhp#par_id3156155.179.help.text
#: 04060110.xhp%23par_id3156155.179.help.text
msgid ""
"            <emph>SearchText </emph>is the text segment that is to be "
"replaced (a number of times)."
msgstr ""
"            <emph>SearchText </emph>տեքստի հատվածն է, որը պետք է փոխարինվի ("
"մի քանի անգամ):"

#: 04060110.xhp#par_id3145779.180.help.text
#: 04060110.xhp%23par_id3145779.180.help.text
msgid ""
"            <emph>NewText</emph> is the text that is to replace the text "
"segment."
msgstr ""
"            <emph>NewText</emph> այն տեքստն է, որը փոխարինելու է տեքստի "
"հատվածը:"

#: 04060110.xhp#par_id3150348.181.help.text
#: 04060110.xhp%23par_id3150348.181.help.text
msgid ""
"            <emph>Occurrence</emph> (optional) indicates which occurrence of "
"the search text is to be replaced. If this parameter is missing the search "
"text is replaced throughout."
msgstr ""
"            <emph>Պատահումներ</emph> (կամընտրական) ցույց է տալիս, թե որոնման "
"տեքստի որ դեպքը պետք է փոխարինվի: Եթե այս պարամետրը բացակայում է, որոնման "
"տեքստը ամբողջությամբ փոխարինվում է:"

#: 04060110.xhp#hd_id3150946.182.help.text
#: 04060110.xhp%23hd_id3150946.182.help.text
msgctxt "04060110.xhp#hd_id3150946.182.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3150412.183.help.text
#: 04060110.xhp%23par_id3150412.183.help.text
msgid ""
"            <item type=\"input\">=SUBSTITUTE(\"123123123\";\"3\";\"abc\""
")</item> returns 12abc12abc12abc."
msgstr ""
"            <item type=\"input\">=SUBSTITUTE(\"123123123\";\"3\";\"abc\""
")</item> վերադարձնում է 12abc12abc12abc։"

#: 04060110.xhp#par_id3154915.238.help.text
#: 04060110.xhp%23par_id3154915.238.help.text
msgid ""
"            <item type=\"input\">=SUBSTITUTE(\"123123123\";\"3\";\"abc\""
";2)</item> returns 12312abc123."
msgstr ""
"            <item type=\"input\">=SUBSTITUTE(\"123123123\";\"3\";\"abc\""
";2)</item> վերադարձնում է 12312abc123։"

#: 04060110.xhp#bm_id3148977.help.text
#: 04060110.xhp%23bm_id3148977.help.text
msgid "<bookmark_value>T function</bookmark_value>"
msgstr "<bookmark_value>T գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3148977.140.help.text
#: 04060110.xhp%23hd_id3148977.140.help.text
msgid "T"
msgstr "T"

#: 04060110.xhp#par_id3154359.141.help.text
#: 04060110.xhp%23par_id3154359.141.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_T\">This function returns the target text, or a blank "
"text string if the target is not text.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_T\">Այս գործառույթը վերադարձնում է թիրախային տեքստը "
"կամ տեքստի դատարկ տողը, եթե թիրախը տեքստ չէ:</ahelp>"

#: 04060110.xhp#hd_id3155858.142.help.text
#: 04060110.xhp%23hd_id3155858.142.help.text
msgctxt "04060110.xhp#hd_id3155858.142.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3155871.143.help.text
#: 04060110.xhp%23par_id3155871.143.help.text
msgid "T(Value)"
msgstr "T(Value)"

#: 04060110.xhp#par_id3154726.144.help.text
#: 04060110.xhp%23par_id3154726.144.help.text
msgid ""
"If <emph>Value</emph> is a text string or refers to a text string, T returns "
"that text string; otherwise it returns a blank text string."
msgstr ""
"Եթե <emph>Արժեքը</emph> տեքստի տող է կամ հղում է տեքստի տողին, T -ն "
"վերադարձնում է տեքստի տողը. հակառակ դեպքում այն վերադարձնում է տեքստի դատարկ "
"տողը:"

#: 04060110.xhp#hd_id3155544.145.help.text
#: 04060110.xhp%23hd_id3155544.145.help.text
msgctxt "04060110.xhp#hd_id3155544.145.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3151062.146.help.text
#: 04060110.xhp%23par_id3151062.146.help.text
msgid ""
"            <item type=\"input\">=T(12345)</item> returns an empty string. "
msgstr ""
"            <item type=\"input\">=T(12345)</item> վերադարձնում է դատարկ տող։ "

#: 04060110.xhp#par_id4650105.help.text
#: 04060110.xhp%23par_id4650105.help.text
msgid ""
"            <item type=\"input\">=T(\"12345\")</item> returns the string "
"12345."
msgstr ""
"            <item type=\"input\">=T(\"12345\")</item> վերադարձնում է 12345 "
"տողը։"

#: 04060110.xhp#bm_id3147132.help.text
#: 04060110.xhp%23bm_id3147132.help.text
msgid "<bookmark_value>TEXT function</bookmark_value>"
msgstr "<bookmark_value>TEXT գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3147132.158.help.text
#: 04060110.xhp%23hd_id3147132.158.help.text
msgid "TEXT"
msgstr "TEXT"

#: 04060110.xhp#par_id3147213.159.help.text
#: 04060110.xhp%23par_id3147213.159.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_TEXT\">Converts a number into text according to a "
"given format.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_TEXT\">Թիվը վերածում է տեքստի համաձայն տրված "
"ձևաչափի:</ahelp>"

#: 04060110.xhp#hd_id3153129.160.help.text
#: 04060110.xhp%23hd_id3153129.160.help.text
msgctxt "04060110.xhp#hd_id3153129.160.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3147377.161.help.text
#: 04060110.xhp%23par_id3147377.161.help.text
msgid "TEXT(Number; Format)"
msgstr "TEXT(Number; Format)"

#: 04060110.xhp#par_id3147389.162.help.text
#: 04060110.xhp%23par_id3147389.162.help.text
msgid "            <emph>Number</emph> is the numerical value to be converted."
msgstr "            <emph>Թիվ</emph> Ձևափոխման ենթակա թվային արժեքն է։"

#: 04060110.xhp#par_id3156167.163.help.text
#: 04060110.xhp%23par_id3156167.163.help.text
msgid ""
"            <emph>Format</emph> is the text which defines the format. Use "
"decimal and thousands separators according to the language set in the cell "
"format."
msgstr ""
"            <emph>Ձևաչափ</emph> այն տեքստն է, որը սահմանում է ձևաչափը: "
"Օգտագործեք տասնորդական և հազարերորդական տարանջատիչները, համաձայն բջջային "
"ձևաչափում կարգաբերված լեզվի:"

#: 04060110.xhp#hd_id1243629.help.text
#: 04060110.xhp%23hd_id1243629.help.text
msgctxt "04060110.xhp#hd_id1243629.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id9044770.help.text
#: 04060110.xhp%23par_id9044770.help.text
msgid ""
"            <item type=\"input\">=TEXT(12.34567;\"###.##\")</item> returns "
"the text 12.35"
msgstr ""
"            <item type=\"input\">=TEXT(12.34567;\"###.##\")</item> "
"վերադարձնում է 12.35 տեքստը"

#: 04060110.xhp#par_id3674123.help.text
#: 04060110.xhp%23par_id3674123.help.text
msgid ""
"            <item type=\"input\">=TEXT(12.34567;\"000.00\")</item> returns "
"the text 012.35"
msgstr ""
"            <item type=\"input\">=TEXT(12.34567;\"000.00\")</item> "
"վերադարձնում է 012.35 տեքստը"

#: 04060110.xhp#bm_id3151039.help.text
#: 04060110.xhp%23bm_id3151039.help.text
msgid "<bookmark_value>TRIM function</bookmark_value>"
msgstr "<bookmark_value>TRIM գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3151039.54.help.text
#: 04060110.xhp%23hd_id3151039.54.help.text
msgid "TRIM"
msgstr "TRIM"

#: 04060110.xhp#par_id3157888.55.help.text
#: 04060110.xhp%23par_id3157888.55.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_GLAETTEN\">Removes spaces from a string, leaving only "
"a single space character between words.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_GLAETTEN\">Հեռացնում է բացատները տողից, բառերի միջև "
"թողնելով միայն մեկական բացատ։</ahelp>"

#: 04060110.xhp#hd_id3152913.56.help.text
#: 04060110.xhp%23hd_id3152913.56.help.text
msgctxt "04060110.xhp#hd_id3152913.56.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3151349.57.help.text
#: 04060110.xhp%23par_id3151349.57.help.text
msgid "TRIM(\"Text\")"
msgstr "TRIM(\"Text\")"

#: 04060110.xhp#par_id3151362.58.help.text
#: 04060110.xhp%23par_id3151362.58.help.text
msgid ""
"            <emph>Text</emph> refers to text in which spaces are removed."
msgstr ""
"            <emph>Տեքստ</emph> վերաբերում է տեքստին, որում բացատները հանված "
"են:"

#: 04060110.xhp#hd_id3146838.59.help.text
#: 04060110.xhp%23hd_id3146838.59.help.text
msgctxt "04060110.xhp#hd_id3146838.59.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3156074.60.help.text
#: 04060110.xhp%23par_id3156074.60.help.text
msgid "            <item type=\"input\">=TRIM(\"hello\")</item> returns hello."
msgstr ""
"            <item type=\"input\">=TRIM(\"hello\")</item> վերադարձնում է "
"hello։"

#: 04060110.xhp#bm_id0907200904030935.help.text
#: 04060110.xhp%23bm_id0907200904030935.help.text
msgid "<bookmark_value>UNICHAR function</bookmark_value>"
msgstr "<bookmark_value>UNICHAR գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id0907200904022525.help.text
#: 04060110.xhp%23hd_id0907200904022525.help.text
msgid "UNICHAR"
msgstr "UNICHAR"

#: 04060110.xhp#par_id0907200904022538.help.text
#: 04060110.xhp%23par_id0907200904022538.help.text
msgid ""
"<ahelp hid=\".\">Converts a code number into a Unicode character or "
"letter.</ahelp>"
msgstr "<ahelp hid=\".\">Կոդի համարը վերածում է ՅՈՒՆԻԿՈԴ նիշի կամ տառի:</ahelp>"

#: 04060110.xhp#hd_id0907200904123753.help.text
#: 04060110.xhp%23hd_id0907200904123753.help.text
msgctxt "04060110.xhp#hd_id0907200904123753.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id0907200904123753.help.text
#: 04060110.xhp%23par_id0907200904123753.help.text
msgid "UNICHAR(number)"
msgstr "UNICHAR(number)"

#: 04060110.xhp#hd_id0907200904123720.help.text
#: 04060110.xhp%23hd_id0907200904123720.help.text
msgctxt "04060110.xhp#hd_id0907200904123720.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id090720090412378.help.text
#: 04060110.xhp%23par_id090720090412378.help.text
msgid "=UNICHAR(169) returns the Copyright character <emph>©</emph>."
msgstr "=UNICHAR(169) վերադարձնում է Հեղինակային իրավունքի նիշը <emph>©</emph>."

#: 04060110.xhp#bm_id0907200904033543.help.text
#: 04060110.xhp%23bm_id0907200904033543.help.text
msgid "<bookmark_value>UNICODE function</bookmark_value>"
msgstr "<bookmark_value>UNICODE գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id0907200904022588.help.text
#: 04060110.xhp%23hd_id0907200904022588.help.text
msgid "UNICODE"
msgstr "UNICODE"

#: 04060110.xhp#par_id0907200904022594.help.text
#: 04060110.xhp%23par_id0907200904022594.help.text
msgid ""
"<ahelp hid=\".\">Returns the numeric code for the first Unicode character in "
"a text string.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Վերադարձնում է տեքստային տողի առաջին ՅՈՒՆԻԿՈԴ նիշի թվային "
"կոդը:</ahelp>"

#: 04060110.xhp#hd_id0907200904123874.help.text
#: 04060110.xhp%23hd_id0907200904123874.help.text
msgctxt "04060110.xhp#hd_id0907200904123874.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id0907200904123846.help.text
#: 04060110.xhp%23par_id0907200904123846.help.text
msgid "UNICODE(\"Text\")"
msgstr "UNICODE(\"Text\")"

#: 04060110.xhp#hd_id0907200904123899.help.text
#: 04060110.xhp%23hd_id0907200904123899.help.text
msgctxt "04060110.xhp#hd_id0907200904123899.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id0907200904123919.help.text
#: 04060110.xhp%23par_id0907200904123919.help.text
msgid ""
"=UNICODE(\"©\") returns the Unicode number 169 for the Copyright character."
msgstr ""
"=UNICODE(\"©\") Հեղինակային իրավունքի նիշի համար վերադարձնում է Յունիկոդային "
"169 թիվը։"

#: 04060110.xhp#bm_id3145178.help.text
#: 04060110.xhp%23bm_id3145178.help.text
msgid "<bookmark_value>UPPER function</bookmark_value>"
msgstr "<bookmark_value>UPPER գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3145178.62.help.text
#: 04060110.xhp%23hd_id3145178.62.help.text
msgid "UPPER"
msgstr "UPPER"

#: 04060110.xhp#par_id3162905.63.help.text
#: 04060110.xhp%23par_id3162905.63.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_GROSS\">Converts the string specified in the "
"<emph>text</emph> field to uppercase.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_GROSS\"><emph>տեքստ</emph> դաշտում նշված տողը վերածում "
"է մեծատառի:</ahelp>"

#: 04060110.xhp#hd_id3148526.64.help.text
#: 04060110.xhp%23hd_id3148526.64.help.text
msgctxt "04060110.xhp#hd_id3148526.64.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3148539.65.help.text
#: 04060110.xhp%23par_id3148539.65.help.text
msgid "UPPER(\"Text\")"
msgstr "UPPER(\"Text\")"

#: 04060110.xhp#par_id3148496.66.help.text
#: 04060110.xhp%23par_id3148496.66.help.text
msgid ""
"            <emph>Text</emph> refers to the lower case letters you want to "
"convert to upper case."
msgstr ""
"            <emph>Տեքստ</emph> վերաբերում է փոքրատառերին, որոնք ցանկանում եք "
"վերածել մեծատառերի:"

#: 04060110.xhp#hd_id3148516.67.help.text
#: 04060110.xhp%23hd_id3148516.67.help.text
msgctxt "04060110.xhp#hd_id3148516.67.help.text"
msgid "Example"
msgstr "Օրինակ"

#: 04060110.xhp#par_id3146757.68.help.text
#: 04060110.xhp%23par_id3146757.68.help.text
msgid ""
"            <item type=\"input\">=UPPER(\"Good Morning\")</item> returns "
"GOOD MORNING."
msgstr ""
"            <item type=\"input\">=UPPER(\"Good Morning\")</item> "
"վերադարձնում է GOOD MORNING."

#: 04060110.xhp#bm_id3150802.help.text
#: 04060110.xhp%23bm_id3150802.help.text
msgid "<bookmark_value>VALUE function</bookmark_value>"
msgstr "<bookmark_value>VALUE գործառույթ</bookmark_value>"

#: 04060110.xhp#hd_id3150802.185.help.text
#: 04060110.xhp%23hd_id3150802.185.help.text
msgid "VALUE"
msgstr "VALUE"

#: 04060110.xhp#par_id3152551.186.help.text
#: 04060110.xhp%23par_id3152551.186.help.text
msgid ""
"<ahelp hid=\"HID_FUNC_WERT\">Converts a text string into a number.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_FUNC_WERT\">տեքստային տողը ձևափոխում է թվայինի։</ahelp>"

#: 04060110.xhp#hd_id3152568.187.help.text
#: 04060110.xhp%23hd_id3152568.187.help.text
msgctxt "04060110.xhp#hd_id3152568.187.help.text"
msgid "Syntax"
msgstr "Շարահյուսություն"

#: 04060110.xhp#par_id3153638.188.help.text
#: 04060110.xhp%23par_id3153638.188.help.text
msgid "VALUE(\"Text\")"
msgstr "VALUE(\"Text\")"

#: 04060110.xhp#par_id3153651.189.help.text
#: 04060110.xhp%23par_id3153651.189.help.text
