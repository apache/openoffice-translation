#: userdefined_function.xhp%23par_id3145384.25.help.text
msgid ""
"In the <emph>Macro from</emph> field select <emph>(Name of the Calc document)"
" - Standard - Module1</emph>. Click <emph>Edit</emph>."
msgstr ""
