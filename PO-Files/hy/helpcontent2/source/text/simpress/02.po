msgid "Flip"
msgstr "Շրջել"

#: 10030000.xhp#hd_id3155263.33.help.text
#: 10030000.xhp%23hd_id3155263.33.help.text
msgctxt "10030000.xhp#hd_id3155263.33.help.text"
msgid "In 3D Rotation Object"
msgstr "3D պտտման առարկայում"

#: 10030000.xhp#par_id3145169.35.help.text
#: 10030000.xhp%23par_id3145169.35.help.text
msgid ""
"<ahelp hid=\".uno:ConvertInto3DLathe\">Converts the selected 2D object(s) to "
"a 3D object, by rotating the object(s) around a symmetry line.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ConvertInto3DLathe\">Ընտրված 2D օբյեկտ(ներ)ը վերափոխում է "
"3D օբյեկտի՝ օբյեկտ(ներ)ը պտտելով համաչափության գծի շուրջ:</ahelp>"

#: 10030000.xhp#par_id3150332.36.help.text
#: 10030000.xhp%23par_id3150332.36.help.text
msgid ""
"Drag the symmetry line to a new location to change the shape of the "
"converted object. To change the orientation of the symmetry line, drag one "
"of its end points. Click the object to convert it to 3D. "
msgstr ""
"Քաշեք համաչափության գիծը նոր վայր՝ փոխարկված օբյեկտի ձևը փոխելու համար: "
"Համաչափության գծի կողմնորոշումը փոխելու համար քաշեք դրա վերջնակետերից մեկը: "
"Կտտացրեք օբյեկտին՝ այն 3D դարձնելու համար"

#: 10030000.xhp#par_id3150928.help.text
#: 10030000.xhp%23par_id3150928.help.text
msgid ""
"<image id=\"img_id3145295\" src=\"svx/res/rotate3d.png\" width=\"5.64mm\" "
"height=\"5.64mm\"><alt id=\"alt_id3145295\">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3145295\" src=\"svx/res/rotate3d.png\" width=\"5.64mm\" "
"height=\"5.64mm\"><alt id=\"alt_id3145295\">Պատկերակ</alt></image>"

#: 10030000.xhp#par_id3149024.34.help.text
#: 10030000.xhp%23par_id3149024.34.help.text
msgctxt "10030000.xhp#par_id3149024.34.help.text"
msgid "In 3D Rotation Object"
msgstr "3D պտտման առարկայում"

#: 10030000.xhp#hd_id3147536.24.help.text
#: 10030000.xhp%23hd_id3147536.24.help.text
msgctxt "10030000.xhp#hd_id3147536.24.help.text"
msgid "Set in circle (perspective)"
msgstr "Շրջանակով դրված (ապագայում)"

#: 10030000.xhp#par_id3150468.26.help.text
#: 10030000.xhp%23par_id3150468.26.help.text
msgid ""
"<ahelp hid=\".uno:CrookRotate\">Distorts the selected object by wrapping it "
"around imaginary circles, and then adding perspective. Drag a handle of the "
"selected object to distort it.</ahelp> If the selected object is not a "
"polygon or Bézier curve, you are prompted to change the object to a curve "
"before you can distort it."
msgstr ""
"<ahelp hid=\".uno:CrookRotate\">Խեղաթյուրում է ընտրված օբյեկտը՝ այն "
"փաթաթելով երեւակայական շրջանակների շուրջ, ապա ավելացնելով հեռանկար: Քաշեք "
"ընտրված օբյեկտի բռնակը՝ այն աղավաղելու համար:</ahelp> Եթե ընտրված օբյեկտը "
"բազմանկյուն կամ Բեզիեի կոր չէ, ձեզ կառաջարկվի փոխել օբյեկտը կորի, նախքան "
"կկարողանաք այն աղավաղել:"

#: 10030000.xhp#par_id3147167.help.text
#: 10030000.xhp%23par_id3147167.help.text
msgid ""
"<image id=\"img_id3083443\" src=\"res/commandimagelist/sc_crookslant.png\" "
"width=\"5.64mm\" height=\"5.64mm\"><alt id=\"alt_id3083443\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3083443\" src=\"res/commandimagelist/sc_crookslant.png\" "
"width=\"5.64mm\" height=\"5.64mm\"><alt id=\"alt_id3083443\""
">Պատկերակ</alt></image>"

#: 10030000.xhp#par_id3149454.25.help.text
#: 10030000.xhp%23par_id3149454.25.help.text
