#: 10020000.xhp#par_id3147339.2.help.text
#: 10020000.xhp%23par_id3147339.2.help.text
msgid ""
"<ahelp hid=\".uno:ZoomToolBox\">Reduces or enlarges the screen display of "
"the current document. Click the arrow next to the icon to open the "
"<emph>Zoom</emph> toolbar.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ZoomToolBox\">Նվազեցնում կամ մեծացնում է ընթացիկ փաստաթղթի "
"պաստառի ցուցադրումը: Սեղմեք պատկերակի կողքին գտնվող սլաքը՝ "
