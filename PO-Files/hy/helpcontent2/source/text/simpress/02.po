#: 10080000.xhp#par_id3150354.28.help.text
#: 10080000.xhp%23par_id3150354.28.help.text
msgid ""
"<ahelp hid=\".uno:Polygon_Diagonal_Unfill\">Draws a line composed of a "
"series of straight line segments, that are constrained by angles of 45 "
"degree. Drag to draw a line segment, click to define the endpoint of the "
"line segment, and then drag to draw a new line segment. Double-click to "
"finish drawing the line. To create a closed shape, hold down <switchinline "
"select=\"sys\"><caseinline select=\"MAC\""
">Option</caseinline><defaultinline>Alt</defaultinline></switchinline> and "
"double-click.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:Polygon_Diagonal_Unfill\">Նկարում է գիծ կազմված ուղիղ "
"գծերի սեգմենտների շարքից, որոնք կաշկանդված են 45 աստիճանի անկյուններով: "
"Քաշեք՝ գծի հատված նկարելու համար, կտտացրեք՝ գծի հատվածի վերջնակետը "
"սահմանելու համար, ապա քաշեք՝ գծի նոր հատված նկարելու համար: Կրկնակի կտտացրեք՝"
" գծի նկարելն ավարտելու համար: Փակ ձև ստեղծելու համար սեղմված պահեք <"
"switchinline select=\"sys\"><caseinline select=\"MAC\""
">Option</caseinline><defaultinline>Alt</defaultinline></switchinline> և "
"կրկնակի կտտացրեք։</ahelp>"

