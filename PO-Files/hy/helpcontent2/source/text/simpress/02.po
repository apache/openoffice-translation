msgid ""
"<ahelp hid=\".uno:EllipseToolbox\">Using Customize Toolbar, you can add the "
"Ellipse icon which opens the <emph>Circles and Ovals</emph> toolbar.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:EllipseToolbox\">Օգտագործելով Անհատականացնել "
"Գործիքադարակը, կարող եք ավելացնել էլիպսաձև պատկերակը, որը բացում է <emph>"
"Շրջանակներ ու օվալներ</emph> գործիքագոտին:</ahelp>"

#: 10070000.xhp#hd_id3154762.5.help.text
#: 10070000.xhp%23hd_id3154762.5.help.text
