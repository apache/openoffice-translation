msgid "Distort"
msgstr "Աղավաղել"

#: 10030000.xhp#par_id3149756.32.help.text
#: 10030000.xhp%23par_id3149756.32.help.text
msgid ""
"<ahelp hid=\".uno:Shear\">Lets you drag the handles of the selected object "
"to change its shape.</ahelp> If the selected object is not a polygon or "
"Bézier curve, you are prompted to change the object to a curve before you "
"can distort it."
msgstr ""
"<ahelp hid=\".uno:Shear\">Թույլ է տալիս ձեզ քաշել ընտրված օբյեկտի բռնակները՝ "
"դրա ձևը փոխելու համար:</ahelp> Եթե ընտրված օբյեկտը բազմանկյուն կամ Բեզիեի "
"կոր չէ, ձեզ կառաջարկվի փոխել օբյեկտը կորի, նախքան այն կկարողանաք աղավաղել:"

#: 10030000.xhp#par_id3154693.help.text
#: 10030000.xhp%23par_id3154693.help.text
msgid ""
"<image id=\"img_id3154933\" src=\"res/commandimagelist/sc_shear.png\" width="
"\"5.64mm\" height=\"5.64mm\"><alt id=\"alt_id3154933\">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3154933\" src=\"res/commandimagelist/sc_shear.png\" width="
"\"5.64mm\" height=\"5.64mm\"><alt id=\"alt_id3154933\">Պատկերակ</alt></image>"

