#: 11070000.xhp%23par_id3154492.2.help.text
msgid ""
"<ahelp visibility=\"visible\" hid=\".uno:OutlineExpandAll\">Displays the "
"hidden headings of the slides in the current slide show. To hide all of the "
"headings in the current slide show, except for the slide titles, click the <"
"link href=\"text/simpress/02/11060000.xhp\" name=\"First Level\"><emph>First "
"Level</emph></link> icon.</ahelp>"
msgstr ""
"<ahelp visibility=\"visible\" hid=\".uno:OutlineExpandAll\">Սահիկի ներկայիս "
"ցուցադրությունում արտածում է սահիկների թաքնված վերնախորագրերը: Սահիկի "
"ներկայիս ցուցադրությունում բոլոր վերնախորագրերը թաքցնելու համար, "
"բացառությամբ սահիկի վերնագրերի, կտտացրեք <link href=\""
"text/simpress/02/11060000.xhp\" name=\"Առաջին մակարդակ\""
"><emph>վ</emph></link> պատկերակը։</ahelp>"

