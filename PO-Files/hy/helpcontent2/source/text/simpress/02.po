msgctxt "10030000.xhp#hd_id3154203.42.help.text"
msgid "Transparency"
msgstr "Թափանցիկություն"

#: 10030000.xhp#par_id3154258.43.help.text
#: 10030000.xhp%23par_id3154258.43.help.text
msgid ""
"<ahelp hid=\".uno:InteractiveTransparence\">Applies a transparency gradient "
"to the selected object.</ahelp> The transparency line represents a a "
"grayscale, with the black handle corresponding to 0% transparency and the "
"white handle to 100% transparency."
msgstr ""
"<ahelp hid=\".uno:InteractiveTransparence\">Ընտրված օբյեկտի վրա կիրառում է "
"թափանցիկության գրադիենտը:</ahelp> Թափանցիկության գիծը ներկայացնում է "
"մոխրագույն սանդղակ, որի սեւ բռնակը համապատասխանում է 0% թափանցիկությանը, իսկ "
"սպիտակ բռնակը՝ 100% թափանցիկությանը:"

#: 10030000.xhp#par_id3147516.44.help.text
#: 10030000.xhp%23par_id3147516.44.help.text
msgid ""
"Drag the white handle to change the direction of the transparency gradient. "
"Drag the black handle to change the length of the gradient. You can also "
"drag and drop colors onto the handles from the <emph>Color</emph> Bar to "
"change their grayscale values."
msgstr ""
"Քաշեք սպիտակ բռնակը՝ թափանցիկության գրադիենտի ուղղությունը փոխելու համար: "
"Քաշեք սեւ բռնակը՝ գրադիենտի երկարությունը փոխելու համար: Կարող եք նաև "
"գույները քաշել և գցել բռնակների վրա <emph>Գույն </emph> վահանակից՝ դրանց "
"մոխրագույն մասշտաբի արժեքները փոխելու համար:"

#: 10030000.xhp#par_id3154104.60.help.text
#: 10030000.xhp%23par_id3154104.60.help.text
msgctxt "10030000.xhp#par_id3154104.60.help.text"
msgid ""
"To display the <emph>Color Bar</emph>, choose <emph>View - Toolbars - Color "
"Bar</emph>."
msgstr ""
"Արտածելու համար <emph>Գույնի վահանակը</emph>, ընտրեք <emph>Տեսք - "
"Գործիքագոտիներ - Գույնի վահանակ</emph>։"

#: 10030000.xhp#par_id3154602.help.text
#: 10030000.xhp%23par_id3154602.help.text
