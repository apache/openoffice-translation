#: shared.xhp%23par_id111111.help.text
msgid ""
"<variable id=\"step1\">Choose <emph>Tools - Presentation Minimizer... - "
"Introduction</emph></variable>"
msgstr ""
"<variable id=\"step1\">Ընտրեք <emph>Գործիքներ - Շնորհանդեսի նվազեցնող... - "
"Ներածություն</emph></variable>"

