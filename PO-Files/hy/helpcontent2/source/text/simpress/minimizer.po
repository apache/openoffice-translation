"<variable id=\"step3\">Choose <emph>Tools - Presentation Minimizer... - "
"Graphics</emph></variable>"
msgstr ""
"<variable id=\"step3\">Ընտրեք <emph>Գործիքներ - Շնորհանդեսի նվազեցնող... - "
"Գրաֆիկներ</emph></variable>"

#: shared.xhp#par_id111114.help.text
#: shared.xhp%23par_id111114.help.text
