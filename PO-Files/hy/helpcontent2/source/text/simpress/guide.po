"<bookmark_value>objects;moving in "
"slides</bookmark_value><bookmark_value>moving;objects in "
"slides</bookmark_value>"
msgstr ""
"<bookmark_value>objects;moving in "
"slides</bookmark_value><bookmark_value>moving;objects in "
"slides</bookmark_value>"

