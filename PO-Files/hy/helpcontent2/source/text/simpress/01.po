msgstr ""
"<ahelp hid=\"SD:CHECKBOX:DLG_INSERT_LAYER:CBX_PRINTABLE\">Տպելիս տպեք կամ "
"անտեսեք այս հատուկ շերտը:</ahelp>"

#: 04020000.xhp#hd_id3146965.11.help.text
#: 04020000.xhp%23hd_id3146965.11.help.text
