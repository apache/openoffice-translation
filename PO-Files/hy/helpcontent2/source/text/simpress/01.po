"default.</ahelp>.<embedvar href=\"text/shared/00/00000001.xhp#kontext\"/>"
msgstr ""
"<ahelp hid=\".uno:NewRouting\">Վերակայում է գծի շեղման արժեքները "
"լռելյայնին։</ahelp>.<embedvar href=\"text/shared/00/00000001.xhp#kontext\"/>"

