"<variable id=\"tabelletext\"><ahelp hid=\".\">Inserts a new table into the "
"current slide or page.</ahelp></variable>"
msgstr ""
"<variable id=\"tabelletext\"><ahelp hid=\".\">Ընթացիկ սահիկում կամ էջում "
"տեղադրվում է նոր աղյուսակ:</ahelp></variable>"

#: 03150100.xhp#tit.help.text
#: 03150100.xhp%23tit.help.text
msgid "Slide Master"
msgstr "Սահիկի վարպետ"

#: 03150100.xhp#bm_id3154013.help.text
#: 03150100.xhp%23bm_id3154013.help.text
msgid ""
"<bookmark_value>normal view; "
"backgrounds</bookmark_value><bookmark_value>backgrounds; normal "
"view</bookmark_value><bookmark_value>views;slide master "
"view</bookmark_value><bookmark_value>slide master view</bookmark_value>"
msgstr ""
"<bookmark_value>normal view; "
"backgrounds</bookmark_value><bookmark_value>backgrounds; normal "
"view</bookmark_value><bookmark_value>views;slide master "
"view</bookmark_value><bookmark_value>slide master view</bookmark_value>"

#: 03150100.xhp#hd_id3154013.1.help.text
#: 03150100.xhp%23hd_id3154013.1.help.text
msgid ""
"<link href=\"text/simpress/01/03150100.xhp\" name=\"Slide Master\">Slide "
"Master</link>"
msgstr ""
"<link href=\"text/simpress/01/03150100.xhp\" name=\"Սահիկի վարպետ\">Սահիկի "
"վարպետ</link>"

#: 03150100.xhp#par_id3151075.2.help.text
#: 03150100.xhp%23par_id3151075.2.help.text
msgid ""
"<ahelp hid=\".uno:SlideMasterPage\">Switches to slide master view, where you "
"can add elements that you want to appear on all of the slides in your show "
"that use the same slide master.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:SlideMasterPage\">Անցնում է սահիկի հիմնական դիտմանը, որտեղ "
"կարող եք ավելացնել տարրեր, որոնք ցանկանում եք որ հայտնվեն ձեր ցուցադրության "
"բոլոր սահիկներում, որոնք օգտագործում են սահիկի նույն վարպետին:</ahelp>"

#: 03150100.xhp#par_id4941557.help.text
#: 03150100.xhp%23par_id4941557.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Inserts a new slide master into the "
"document. Double-click the new slide master on the Slides pane to apply it "
"to all slides.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Փաստաթղթում տեղադրում է սահիկի նոր "
"վարպետ: Սահիկների երեսակում կրկնակի կտտացրեք սահիկի նոր վարպետի՝ այն բոլոր "
"սահիկների վրա կիրառելու համար:</ahelp>"

#: 03150100.xhp#par_id9961851.help.text
#: 03150100.xhp%23par_id9961851.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Select a slide master and click this "
"icon to remove the slide master from the document.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ընտրեք սահիկի վարպետը և կտտացրեք այս "
"պատկերակին՝ սահիկի վարպետը փաստաթղթից հեռացնելու համար:</ahelp>"

#: 03150100.xhp#par_id4526200.help.text
#: 03150100.xhp%23par_id4526200.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Select a slide master and click this "
"icon to rename the slide master.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ընտրեք սահիկի վարպետը և կտտացրեք այս "
"պատկերակին՝ սահիկի վարպետը վերանվանելու համար:</ahelp>"

#: 03150100.xhp#par_id8036133.help.text
#: 03150100.xhp%23par_id8036133.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Closes the slide master view.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Փակում է սահիկի վարպետի տեսքը:</ahelp>"

#: 03050000.xhp#tit.help.text
#: 03050000.xhp%23tit.help.text
msgid "Option Bar"
msgstr "Ընտրանքի վահանակ"

#: 03050000.xhp#hd_id3153415.1.help.text
#: 03050000.xhp%23hd_id3153415.1.help.text
msgid ""
"<link href=\"text/simpress/01/03050000.xhp\" name=\"Option Bar\">Option "
"Bar</link>"
msgstr ""
"<link href=\"text/simpress/01/03050000.xhp\" name=\"Ընտրանքի վահանակ\">"
"Ընտրանքի վահանակ</link>"

#: 05250600.xhp#tit.help.text
#: 05250600.xhp%23tit.help.text
msgid "Behind Object "
msgstr "Առարկայի հետևում"

#: 05250600.xhp#bm_id3149664.help.text
#: 05250600.xhp%23bm_id3149664.help.text
msgid ""
"<bookmark_value>objects; behind object "
"command</bookmark_value><bookmark_value>behind object "
"command</bookmark_value>"
msgstr ""
"<bookmark_value>objects; behind object "
"command</bookmark_value><bookmark_value>behind object "
"command</bookmark_value>"

#: 05250600.xhp#hd_id3149664.1.help.text
#: 05250600.xhp%23hd_id3149664.1.help.text
msgid ""
"<link href=\"text/simpress/01/05250600.xhp\" name=\"Behind Object\">Behind "
"Object</link>"
msgstr ""
"<link href=\"text/simpress/01/05250600.xhp\" name=\"Առարկայի հետևում\">"
"Առարկայի հետևում</link>"

#: 05250600.xhp#par_id3145253.2.help.text
#: 05250600.xhp%23par_id3145253.2.help.text
msgid ""
"<ahelp hid=\".uno:BehindObject\">Changes the stacking order by moving the "
"selected object behind an object that you specify. The screen location of "
"the selected object does not change.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:BehindObject\">Փոխում է կուտակման կարգը՝ ընտրված առարկան "
"տեղափոխելով ձեր կողմից նշված առարկայի ետևում: Ընտրված առարկայի պաստառի վրայի "
"տեղակայումը չի փոխվում:</ahelp>"

#: 05250600.xhp#par_id3149121.4.help.text
#: 05250600.xhp%23par_id3149121.4.help.text
msgid ""
"Select the object(s) that you want to move behind an other object. Right-"
"click and choose <emph>Arrange - Behind Object</emph>, and then click an "
"object in your slide."
msgstr ""
"Ընտրեք այն առարկաները, որոնք ցանկանում եք տեղափոխել այլ առարկայի ետևում: Աջ "
"կտտացրեք և ընտրեք <emph>Դասավորություն - Առարկայի հետևում</emph> և այնուհետև "
"կտտացրեք ձեր սահիկում առարկայի վրա։"

#: 05250600.xhp#par_id3150345.5.help.text
#: 05250600.xhp%23par_id3150345.5.help.text
msgid ""
"<variable id=\"all\">Arranging objects affects the stacking order of all "
"objects in your document. </variable>"
msgstr ""
"<variable id=\"all\">Առարկաների դասավորումը ազդում է ձեր փաստաթղթում առկա "
"բոլոր առարկաների կուտակման կարգի վրա: </variable>"

#: 04990100.xhp#tit.help.text
#: 04990100.xhp%23tit.help.text
msgid "Date (fixed)  "
msgstr "Ամսաթիվ (սևեռված)  "

#: 04990100.xhp#bm_id3153726.help.text
#: 04990100.xhp%23bm_id3153726.help.text
msgid ""
"<bookmark_value>dates; fixed</bookmark_value><bookmark_value>fields; dates "
"(fixed)</bookmark_value>"
msgstr ""
"<bookmark_value>dates; fixed</bookmark_value><bookmark_value>fields; dates "
"(fixed)</bookmark_value>"

#: 04990100.xhp#hd_id3153726.1.help.text
#: 04990100.xhp%23hd_id3153726.1.help.text
msgid ""
"<link href=\"text/simpress/01/04990100.xhp\" name=\"Date (fixed)\">Date "
"(fixed)</link>"
msgstr ""
"<link href=\"text/simpress/01/04990100.xhp\" name=\"Ամսաթիվ (սևեռված)\">"
"Ամսաթիվ (սևեռված)</link>"

#: 04990100.xhp#par_id3151073.2.help.text
#: 04990100.xhp%23par_id3151073.2.help.text
msgid ""
"<ahelp hid=\".uno:InsertDateFieldFix\">Inserts the current date into your "
"slide as a fixed field. The date is not automatically updated.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:InsertDateFieldFix\">Ընթացիկ ամսաթիվը տեղադրում է ձեր "
"սահիկում որպես սևեռված դաշտ: Ամսաթիվը ինքնաշխատ կերպով չի թարմացվում:</ahelp>"

#: 04990100.xhp#par_id3146969.3.help.text
#: 04990100.xhp%23par_id3146969.3.help.text
msgid ""
"<variable id=\"bearbeiten\">To edit an inserted field in your slide, double-"
"click the field, place the cursor in front of the first character in the "
"field and choose <link href=\"text/simpress/01/02160000.xhp\" name=\"Edit - "
"Fields\"><emph>Edit - Fields</emph></link>.</variable>"
msgstr ""
"<variable id=\"bearbeiten\">Ձեր սահիկում տեղադրված դաշտը խմբագրելու համար "
"կրկնակի սեղմեք դաշտը, կուրսորը դրեք դաշտի առաջին նիշի դիմաց և ընտրեք <link "
"href=\"text/simpress/01/02160000.xhp\" name=\"Խմբագրել - Դաշտեր\"><emph>"
"Խմբագրել - Դաշտեր</emph></link>։</variable>"

#: 03151200.xhp#tit.help.text
#: 03151200.xhp%23tit.help.text
msgid "Notes Master Layout"
msgstr "Նշումների վարպետի ուրվագիծ"

#: 03151200.xhp#par_idN10527.help.text
#: 03151200.xhp%23par_idN10527.help.text
msgid "<link href=\"text/simpress/01/03151200.xhp\">Notes Master Layout</link>"
msgstr ""
"<link href=\"text/simpress/01/03151200.xhp\">Նշումների վարպետի "
"ուրվագիծ</link>"

#: 03151200.xhp#par_idN1052B.help.text
#: 03151200.xhp%23par_idN1052B.help.text
msgid ""
"<ahelp hid=\"SID_MASTER_LAYOUTS_NOTES\">Add header, footer, date, and slide "
"number to the notes master.</ahelp>"
msgstr ""
"<ahelp hid=\"SID_MASTER_LAYOUTS_NOTES\">Նշումների վարպետին ավելացրեք "
"վերնագիր, էջատակ, ամսաթիվ և սահիկի թիվը:</ahelp>"

#: 13050300.xhp#tit.help.text
#: 13050300.xhp%23tit.help.text
msgid "Convert to 3D "
msgstr "Ձևափոխեք 3D -ի "

#: 13050300.xhp#hd_id3154017.1.help.text
#: 13050300.xhp%23hd_id3154017.1.help.text
msgid ""
"<link href=\"text/simpress/01/13050300.xhp\" name=\"Convert to 3D\">Convert "
"to 3D</link>"
msgstr ""
"<link href=\"text/simpress/01/13050300.xhp\" name=\"Ձևափոխեք 3D-ի\">Ձևափոխեք "
"3D-ի</link>"

#: 13050300.xhp#par_id3155066.2.help.text
#: 13050300.xhp%23par_id3155066.2.help.text
msgid ""
"<ahelp hid=\".uno:ConvertInto3D\">Converts the selected object to a three-"
"dimensional (3D) object.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ConvertInto3D\">Ընտրված առարկան վերափոխում է եռաչափ (3D) "
"օբյեկտի:</ahelp>"

#: 13050300.xhp#par_id3147339.8.help.text
#: 13050300.xhp%23par_id3147339.8.help.text
msgid ""
"<variable id=\"anmerkung\">The selected object is first converted to a "
"contour, and then to a 3D object.</variable>"
msgstr ""
"<variable id=\"anmerkung\">Ընտրված օբյեկտը նախ վերափոխվում է ուրվագծի, "
"այնուհետև 3D օբյեկտի:</variable>"

#: 13050300.xhp#par_id3149127.3.help.text
#: 13050300.xhp%23par_id3149127.3.help.text
msgid ""
"If you select two or more objects and convert them to 3D, the result is a 3D "
"group that acts as a single object. You can edit the individual objects in "
"the group by choosing <switchinline select=\"appl\"><caseinline select=\""
"DRAW\"><emph>Modify</emph> - <emph>Enter "
"Group</emph></caseinline><defaultinline><emph>Format - Group - Edit "
"Group</emph></defaultinline></switchinline>. Choose <switchinline select=\""
"appl\"><caseinline select=\"DRAW\"><emph>Modify – Exit "
"Group</emph></caseinline><defaultinline><emph>Format – Group – Exit "
"Group</emph></defaultinline></switchinline> when you are finished."
msgstr ""
"Եթե դուք ընտրում եք երկու կամ ավելի օբյեկտներ և դրանք դարձնում 3D, արդյունքը "
"ստացվում է 3D խումբ, որը գործում է որպես մեկ օբյեկտ: Խմբի առանձին օբյեկտները "
"կարող եք խմբագրել` ընտրելով <switchinline select=\"appl\"><caseinline select="
"\"DRAW\"><emph>Ձևափոխել</emph> - <emph>Մտեք "
"խումբ</emph></caseinline><defaultinline><emph>Ձևաչափ - Խումբ - Խմբագրել "
"խումբը</emph></defaultinline></switchinline>։ Ընտրեք <switchinline select=\""
"appl\"><caseinline select=\"DRAW\"><emph>Ձևափոխել – Լքել "
"խումբը</emph></caseinline><defaultinline><emph>Ձևաչափ - Խումբ - Լքել "
"խումբը</emph></defaultinline></switchinline> երբ ավարտել ես։"

#: 13050300.xhp#par_id3151242.5.help.text
#: 13050300.xhp%23par_id3151242.5.help.text
msgid ""
"Converting a group of objects to 3D does not change the stacking order of "
"the individual objects."
msgstr ""
"Օբյեկտների խումբը 3D- ի վերափոխելը չի փոխում առանձին օբյեկտների կուտակման "
"կարգը:"

#: 13050300.xhp#par_id3146965.9.help.text
#: 13050300.xhp%23par_id3146965.9.help.text
msgid "Press F3 to quickly enter a group and Ctrl+F3 to leave the group."
msgstr ""
"Սեղմեք F3՝ արագ մուտք գործելու խումբ, և Ctrl+F3՝ խմբից դուրս գալու համար:"

#: 13050300.xhp#par_id3145114.4.help.text
#: 13050300.xhp%23par_id3145114.4.help.text
msgid ""
"You can also convert bitmap images and vector graphics, including clipart, "
"to 3D objects. $[officename] treats bitmaps as rectangles and vector "
"graphics as a group of polygons when converting to 3D."
msgstr ""
"Կարող եք նաև փոխակերպել bitmap պատկերները և վեկտորային գրաֆիկաները, ներառյալ "
"պատկերները, 3D օբյեկտների: $[officename] -ը բիթքարտեզներին վերաբերվում է "
"որպես ուղղանկյունների և վեկտորային գրաֆիկային՝ որպես բազմանկյունների մի "
"խմբի, երբ ձևափոխում է 3D -ի:"

#: 13050300.xhp#par_id3149876.6.help.text
#: 13050300.xhp%23par_id3149876.6.help.text
msgid "Even drawing objects that contain text can be converted."
msgstr "Նույնիսկ տեքստ պարունակող նկարչական օբյեկտները կարող են փոխակերպվել:"

#: 13050300.xhp#par_id3153960.7.help.text
#: 13050300.xhp%23par_id3153960.7.help.text
msgid ""
"If you want, you can also apply a <link href=\"text/shared/01/05350000.xhp\" "
"name=\"3D Effect\">3D Effect</link> to the converted object."
msgstr ""
"Եթե ցանկանում եք, կարող եք նաև կիրառել <link href=\"text/shared/01/05350000."
