msgstr "Տեղորոշեք մակրոն, որը ցանկանում եք գործարկել:"

#: 06070000.xhp#hd_id3150424.43.help.text
#: 06070000.xhp%23hd_id3150424.43.help.text
msgid "Exit presentation"
msgstr "Լքեք շնորհանդեսը"

#: 06070000.xhp#par_id3154799.87.help.text
#: 06070000.xhp%23par_id3154799.87.help.text
