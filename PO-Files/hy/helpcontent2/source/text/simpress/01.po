msgid ""
"<variable id=\"praesent\"><ahelp hid=\".uno:PresentationDialog\">Defines "
"settings for your slide show, including which slide to start from, the way "
"you advance the slides, the type of presentation, and pointer "
"options.</ahelp></variable>"
msgstr ""
"<variable id=\"praesent\"><ahelp hid=\".uno:PresentationDialog\">Սահմանում է "
"սահիկի ձեր ներկայացման կարգավորումները, ներառյալ թե որ սահիկից սկսել, "
"սահիկները առաջ տանելու եղանակը, ներկայացման տեսակը և ցուցիչի "
"ընտրանքները:</ahelp></variable>"

#: 06080000.xhp#hd_id3150213.3.help.text
#: 06080000.xhp%23hd_id3150213.3.help.text
msgid "Range"
msgstr "Միջակայք"

#: 06080000.xhp#par_id3154766.4.help.text
#: 06080000.xhp%23par_id3154766.4.help.text
msgid "Specifies which slides to include in the slide show."
msgstr "Նշում է, թե որ սահիկներն ներառել սահիկի ներկայացման մեջ:"

#: 06080000.xhp#hd_id3145363.5.help.text
#: 06080000.xhp%23hd_id3145363.5.help.text
