#: taskpanel.xhp#par_idN10554.help.text
#: taskpanel.xhp%23par_idN10554.help.text
msgid ""
"<ahelp hid=\".\">Switches the %PRODUCTNAME Impress task pane on and "
"off.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Միացնում կամ անջատում է %PRODUCTNAME Impress -ի առաջադրանքի "
"երեսակը։</ahelp>"

#: taskpanel.xhp#par_idN10557.help.text
#: taskpanel.xhp%23par_idN10557.help.text
msgid ""
"The task pane contains pages to specify the master pages, layouts, custom "
"animation, and slide transition. Click another heading to open another page."
msgstr ""
"Առաջադրանքների երեսակը պարունակում է էջեր` հիմնական էջերը, "
"դասավորությունները, անհատականացված անիմացիան և սահիկների անցումը "
"հատկորոշելու համար: Կտտացրեք մեկ այլ խորագիր՝ մեկ այլ էջ բացելու համար:"

#: taskpanel.xhp#par_idN105D4.help.text
#: taskpanel.xhp%23par_idN105D4.help.text
msgctxt "taskpanel.xhp#par_idN105D4.help.text"
msgid "<embedvar href=\"text/simpress/guide/masterpage.xhp#masterpage\"/>"
msgstr "<embedvar href=\"text/simpress/guide/masterpage.xhp#masterpage\"/>"

#: taskpanel.xhp#par_idN10652.help.text
#: taskpanel.xhp%23par_idN10652.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens the Master Pages tab page, "
"where you apply a master page (background) to all slides (left-click) or to "
"the selected slides (right-click).</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացում է Վարպետ էջեր ներդիրի էջը, "
"որտեղ դուք կիրառում եք վարպետ էջը (հետնամաս) բոլոր սահիկների վրա (ձախ կտտոց)"
", կամ ընտրված սահիկների վրա (աջ կտտոց):</ahelp>"

#: taskpanel.xhp#par_idN1067D.help.text
#: taskpanel.xhp%23par_idN1067D.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Lists the currently used master "
"pages.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Թվարկում է ներկայումս օգտագործվող "
"վարպետ էջերը:</ahelp>"

#: taskpanel.xhp#par_idN106A8.help.text
#: taskpanel.xhp%23par_idN106A8.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Lists the recently used master "
"pages.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Թվարկում է վերջերս օգտագործված վարպետ "
"էջերը:</ahelp>"

#: taskpanel.xhp#par_idN106D3.help.text
#: taskpanel.xhp%23par_idN106D3.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Lists all available master "
"pages.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Թվարկում է բոլոր հասանելի վարպետ "
"էջերը:</ahelp>"

#: taskpanel.xhp#par_idN106FA.help.text
#: taskpanel.xhp%23par_idN106FA.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Left-click to apply the master page "
"to all slides. Right-click for a submenu.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Ձախ կտտացրեք՝ վարպետ էջը կիրառելու "
"համար բոլոր սահիկների վրա: Ենթաընտրացանկի համար՝ աջ սեղմեք</ahelp>"

#: taskpanel.xhp#par_idN10747.help.text
#: taskpanel.xhp%23par_idN10747.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Applies the master page to all "
"slides.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Կիրառում է վարպետ էջը բոլոր սահիկների "
"վրա:</ahelp>"

#: taskpanel.xhp#par_idN10762.help.text
#: taskpanel.xhp%23par_idN10762.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Applies the master page or the slide "
"design to the selected slides.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Կիրառում է վարպետ էջը կամ սահիկի "
"նախագծումը ընտրված սահիկների վրա:</ahelp>"

#: taskpanel.xhp#par_idN10785.help.text
#: taskpanel.xhp%23par_idN10785.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Resizes the preview of the master "
"pages.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Չափափոխում է վարպետ էջերի "
"նախադիտումը:</ahelp>"

#: taskpanel.xhp#par_idN107B4.help.text
#: taskpanel.xhp%23par_idN107B4.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens the Layouts tab page, where you "
"apply a slide design to the selected slide or slides.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացում է Դասավորություններ ներդիրի "
"էջը, որտեղ դուք կիրառում եք սահիկի նախագծումը ընտրված սահիկի կամ սահիկների "
"վրա:</ahelp>"

#: taskpanel.xhp#par_idN107CB.help.text
#: taskpanel.xhp%23par_idN107CB.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Click to apply a slide design to all "
"selected slides. Right-click for a submenu.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Կտտացրեք՝ բոլոր ընտրված սահիկների վրա "
"սահիկի նախագծումը կիրառելու համար: Ենթաընտրացանկի համար աջ սեղմեք</ahelp>"

#: taskpanel.xhp#par_idN1080E.help.text
#: taskpanel.xhp%23par_idN1080E.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens the Custom Animation tab page, "
"where you apply effects to the selected objects on a slide.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացում է Անհատականացված անիմացիա "
"ներդիրի էջը, որտեղ դուք ազդեցություններ եք կիրառում սահիկում ընտրված "
"օբյեկտների վրա:</ahelp>"

#: taskpanel.xhp#par_idN10839.help.text
#: taskpanel.xhp%23par_idN10839.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens the Slide Transition tab page, "
"where you apply transition effects to the selected slides.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացում է Սահիկի անցում ներդիրի էջը, "
"որտեղ դուք կիրառում եք անցումային էֆեկտներ ընտրված սլայդների վրա:</ahelp>"

#: taskpanel.xhp#par_id0916200812240344.help.text
#: taskpanel.xhp%23par_id0916200812240344.help.text
msgid ""
"<ahelp hid=\".\" visibility=\"hidden\">Opens the Table Design. Double-click "
"a preview to insert a new table.</ahelp>"
msgstr ""
"<ahelp hid=\".\" visibility=\"hidden\">Բացում է աղյուսակի ձևավորումը: "
"Կրկնակի կտտացրեք նախադիտմանը՝ նոր աղյուսակ տեղադրելու համար:</ahelp>"

