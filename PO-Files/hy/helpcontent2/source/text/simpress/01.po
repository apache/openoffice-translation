msgid "Macro"
msgstr "Մակրո"

#: 06070000.xhp#par_id3148625.85.help.text
#: 06070000.xhp%23par_id3148625.85.help.text
msgid ""
"<ahelp hid=\"SD_EDIT_TP_ANIMATION_EDT_MACRO\">Enter a path to the macro you "
"want to run, or click <emph>Browse </emph>to locate the macro.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_EDIT_TP_ANIMATION_EDT_MACRO\">Մուտքագրեք ուղին դեպի մակրո, "
"որը ցանկանում եք գործարկել, կամ սեղմեք <emph>Զննել</emph> ՝ մակրոն "
"տեղորոշելու համար:</ahelp>"

#: 06070000.xhp#hd_id3150628.42.help.text
#: 06070000.xhp%23hd_id3150628.42.help.text
