"<link href=\"text/simpress/01/06030000.xhp\" name=\"Տողադարձում\""
">Տողադարձում</link>"

#: 06030000.xhp#par_id3153728.2.help.text
#: 06030000.xhp%23par_id3153728.2.help.text
msgid ""
"<ahelp hid=\".uno:Hyphenation\" visibility=\"visible\">Turns hyphenation "
"option for text objects on or off.</ahelp> You can turn hyphenation on or "
"off for each paragraph."
msgstr ""
"<ahelp hid=\".uno:Hyphenation\" visibility=\"visible\">Միացնում կամ անջատում "
"է տեքստային առարկաների տողադարձումը:</ahelp> Յուրաքանչյուր պարբերության "
"համար տողադարձումը կարող եք միացնել կամ անջատել:"

#: effectoptionstiming.xhp#tit.help.text
#: effectoptionstiming.xhp%23tit.help.text
msgid "Timing"
msgstr "Ժամանակ"

#: effectoptionstiming.xhp#par_idN10544.help.text
#: effectoptionstiming.xhp%23par_idN10544.help.text
msgid ""
"<variable id=\"timing\"><link href=\"text/simpress/01/effectoptionstiming."
"xhp\">Timing</link></variable>"
msgstr ""
"<variable id=\"timing\"><link href=\"text/simpress/01/effectoptionstiming."
"xhp\">Ժամանակ</link></variable>"

#: effectoptionstiming.xhp#par_idN10562.help.text
#: effectoptionstiming.xhp%23par_idN10562.help.text
msgid ""
"Specifies the timing for the current effect in the <link href=\""
"text/simpress/01/effectoptions.xhp\">Effect Options</link> dialog."
msgstr ""
"Նշում է ընթացիկ ազդեցության ժամանակը <link href=\""
"text/simpress/01/effectoptions.xhp\">Ազդեցության ընտրանքներ</link> "
"երկխոսությունում։"

#: effectoptionstiming.xhp#par_idN1057D.help.text
#: effectoptionstiming.xhp%23par_idN1057D.help.text
msgctxt "effectoptionstiming.xhp#par_idN1057D.help.text"
msgid "Start"
msgstr "Մեկնարկ"

#: effectoptionstiming.xhp#par_idN1066F.help.text
#: effectoptionstiming.xhp%23par_idN1066F.help.text
msgid ""
"<ahelp hid=\"878841346\">Displays the start property of the selected "
"animation effect.</ahelp> The following start properties are available:"
msgstr ""
"<ahelp hid=\"878841346\">Ցուցադրում է ընտրված անիմացիոն ազդեցության մեկնարկի "
"հատկությունը:</ahelp> Հասանելի են մեկնարկի հետևյալ հատկությունները։"

#: effectoptionstiming.xhp#par_idN10675.help.text
#: effectoptionstiming.xhp%23par_idN10675.help.text
msgctxt "effectoptionstiming.xhp#par_idN10675.help.text"
msgid ""
"<emph>On click</emph> - the animation stops at this effect until the next "
"mouse click."
msgstr ""
"<emph>Կտտացնելով</emph> - անիմացիան կանգ է առնում այս էֆեկտի վրա, մինչ "
"մկնիկի հաջորդ կտտոցը:"

#: effectoptionstiming.xhp#par_idN1067C.help.text
#: effectoptionstiming.xhp%23par_idN1067C.help.text
msgctxt "effectoptionstiming.xhp#par_idN1067C.help.text"
msgid "<emph>With previous</emph> - the animation runs immediately."
msgstr "<emph>Նախորդի հետ</emph> - անիմացիան միանգամից կատարվում է։"

#: effectoptionstiming.xhp#par_idN10683.help.text
#: effectoptionstiming.xhp%23par_idN10683.help.text
msgctxt "effectoptionstiming.xhp#par_idN10683.help.text"
msgid ""
"<emph>After previous</emph> - the animation runs as soon as the previous "
"animation ends."
msgstr ""
"<emph>Նախորդից հետո</emph> - անիմացիան կատարվում է նախորդ անիմացիայի "
"ավարտվելուն պես:"

#: effectoptionstiming.xhp#par_idN10583.help.text
#: effectoptionstiming.xhp%23par_idN10583.help.text
msgid "Delay"
msgstr "Հետաձգում"

#: effectoptionstiming.xhp#par_idN10693.help.text
#: effectoptionstiming.xhp%23par_idN10693.help.text
msgid ""
"<ahelp hid=\"878844420\">Specifies an additional delay of n seconds until "
"the effect starts.</ahelp>"
msgstr ""
"<ahelp hid=\"878844420\">Հատկորոշում է n վայրկյանների լրացուցիչ հետաձգում, "
"մինչև էֆեկտը սկսվի:</ahelp>"

#: effectoptionstiming.xhp#par_idN10587.help.text
#: effectoptionstiming.xhp%23par_idN10587.help.text
msgctxt "effectoptionstiming.xhp#par_idN10587.help.text"
msgid "Speed"
msgstr "Արագություն"

#: effectoptionstiming.xhp#par_idN106A0.help.text
#: effectoptionstiming.xhp%23par_idN106A0.help.text
msgid "<ahelp hid=\"878841862\">Specifies the duration of the effect.</ahelp>"
msgstr ""
"<ahelp hid=\"878841862\">Հատկորոշում է ազդեցության տևողությունը։</ahelp>"

#: effectoptionstiming.xhp#par_idN1058B.help.text
#: effectoptionstiming.xhp%23par_idN1058B.help.text
msgid "Repeat"
msgstr "Կրկնել"

#: effectoptionstiming.xhp#par_idN106AD.help.text
#: effectoptionstiming.xhp%23par_idN106AD.help.text
msgid ""
"<ahelp hid=\"878841864\">Specifies whether and how to repeat the current "
"effect.</ahelp> Enter the number of repeats, or select from the list:"
msgstr ""
"<ahelp hid=\"878841864\">Նշում է արդյոք և ինչպես կրկնել ընթացիկ "
"էֆեկտը:</ahelp> Մուտքագրեք կրկնությունների քանակը կամ ընտրեք ցուցակից."

#: effectoptionstiming.xhp#par_idN106B3.help.text
#: effectoptionstiming.xhp%23par_idN106B3.help.text
msgid "<emph>(none)</emph> - the effect is not repeated."
msgstr "<emph>(ոչ մեկը)</emph> - ազդեցությունը չի կրկնվում։"

#: effectoptionstiming.xhp#par_idN106BA.help.text
#: effectoptionstiming.xhp%23par_idN106BA.help.text
msgid ""
"<emph>Until next click</emph> - the animation is repeated until the next "
"mouse click."
msgstr ""
"<emph>Մինչ հաջորդ կտտոցը</emph> - անիմացիան կրկնվում է մինչ մկնիկի հաջորդ "
"կտտոցը:"

#: effectoptionstiming.xhp#par_idN106C1.help.text
#: effectoptionstiming.xhp%23par_idN106C1.help.text
msgid ""
"<emph>Until end of slide</emph> - the animation repeats as long as the slide "
"is displayed."
msgstr ""
"<emph>Մինչ սահիկի ավարտը</emph> - անիմացիան կրկնվում է այնքան ժամանակ, քանի "
"դեռ ցուցադրվում է սահիկը:"

#: effectoptionstiming.xhp#par_idN1058F.help.text
#: effectoptionstiming.xhp%23par_idN1058F.help.text
msgid "Rewind when done playing"
msgstr "Կատարումից հետո հետ ոլորեք"

#: effectoptionstiming.xhp#par_idN106D1.help.text
#: effectoptionstiming.xhp%23par_idN106D1.help.text
msgid ""
"<ahelp hid=\"878838793\">Specifies whether to let the animated shape return "
"to its starting state after the animation ends.</ahelp>"
msgstr ""
"<ahelp hid=\"878838793\">Նշում է՝ արդյոք թույլ տալ անիմացիոն ձևին այն "
"ավարտելուց հետո վերադառնալու իր սկզբնական վիճակին:</ahelp>"

#: effectoptionstiming.xhp#par_idN10593.help.text
#: effectoptionstiming.xhp%23par_idN10593.help.text
msgid "Animate as part of click sequence"
msgstr "Անիմացնել որպես կտտոցի հաջորդականության մաս"

#: effectoptionstiming.xhp#par_idN106DE.help.text
#: effectoptionstiming.xhp%23par_idN106DE.help.text
msgid ""
"<ahelp hid=\"878838283\">Specifies whether to let the animation start in the "
"normal click sequence.</ahelp>"
msgstr ""
"<ahelp hid=\"878838283\">Նշում է, թե արդյոք թույլ տալ սկսելու անիմացիան "
"կտտոցի սովորական հաջորդականությամբ:</ahelp>"

#: effectoptionstiming.xhp#par_idN10597.help.text
#: effectoptionstiming.xhp%23par_idN10597.help.text
msgid "Start effect on click of"
msgstr "Սկսել ազդեցությունը կտտոցի դեպքում"

#: effectoptionstiming.xhp#par_idN106EB.help.text
#: effectoptionstiming.xhp%23par_idN106EB.help.text
msgid ""
"<ahelp hid=\"878838284\">Specifies whether to let the animation start when a "
"specified shape is clicked.</ahelp>"
msgstr ""
"<ahelp hid=\"878838284\">Նշում է, թե արդյոք թույլ կտա անիմացիայի սկսելը, երբ "
"կտտացնում է նշված ձևը:</ahelp>"

#: effectoptionstiming.xhp#par_idN107C5.help.text
#: effectoptionstiming.xhp%23par_idN107C5.help.text
msgid ""
"<ahelp hid=\"878841357\">Select the shape by its name from the list "
"box.</ahelp>"
msgstr "<ahelp hid=\"878841357\">Ցանկի վանդակից ընտրեք ձևն իր անունով:</ahelp>"

#: 13050600.xhp#tit.help.text
#: 13050600.xhp%23tit.help.text
msgid "To metafile "
msgstr "Դեպի մետանիշք "

#: 13050600.xhp#bm_id3147434.help.text
#: 13050600.xhp%23bm_id3147434.help.text
msgid ""
"<bookmark_value>converting; to metafile format "
"(WMF)</bookmark_value><bookmark_value>metafiles; converting "
"to</bookmark_value>"
msgstr ""
"<bookmark_value>ձևափոխում; դեպի մետանիշքի ձևաչափ "
"(WMF)</bookmark_value><bookmark_value>մետանիշքեր; ձևափոխում</bookmark_value>"

#: 13050600.xhp#hd_id3147434.1.help.text
#: 13050600.xhp%23hd_id3147434.1.help.text
