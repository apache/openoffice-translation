#: 13180000.xhp#tit.help.text
#: 13180000.xhp%23tit.help.text
msgid "Shapes"
msgstr "Պատկերներ"

#: 13180000.xhp#hd_id3154319.1.help.text
#: 13180000.xhp%23hd_id3154319.1.help.text
msgid ""
"<link href=\"text/simpress/01/13180000.xhp\" name=\"Shapes\">Shapes</link>"
msgstr ""
"<link href=\"text/simpress/01/13180000.xhp\" name=\"Պատկերներ\""
">Պատկերներ</link>"

#: 13180000.xhp#par_id3147435.2.help.text
#: 13180000.xhp%23par_id3147435.2.help.text
msgid "Creates a shape from two or more selected objects."
msgstr "Պատկեր է ստեղծում ընտրված երկու կամ ավելի օբյեկտներից:"

#: 13180000.xhp#par_id3156286.3.help.text
#: 13180000.xhp%23par_id3156286.3.help.text
msgid ""
"Shapes take on the properties of the lowermost object in the stacking order."
msgstr ""
"Պատկերները վերցնում են ամենաստորին օբյեկտի հատկությունները ըստ դասավորման "
"կարգի:"

#: 03120000.xhp#tit.help.text
#: 03120000.xhp%23tit.help.text
msgid "Handout Page"
msgstr "Բաշխված նյութերի էջ"

#: 03120000.xhp#hd_id3149456.1.help.text
#: 03120000.xhp%23hd_id3149456.1.help.text
msgid ""
"<link href=\"text/simpress/01/03120000.xhp\" name=\"Handout Page\">Handout "
"Page</link>"
msgstr ""
"<link href=\"text/simpress/01/03120000.xhp\" name=\"Բաշխված նյութերի էջ\">"
"Բաշխված նյութերի էջ</link>"

#: 03120000.xhp#par_id3154684.2.help.text
#: 03120000.xhp%23par_id3154684.2.help.text
msgid ""
"<ahelp hid=\"HID_SD_BTN_HANDOUT\">Switches to the handout master page, where "
"you can scale several slides to fit on one printed page.</ahelp> To modify "
"the number of slides you can print on a page, open the <emph>Layouts</emph> "
"task pane and double-click a layout."
msgstr ""
"<ahelp hid=\"HID_SD_BTN_HANDOUT\">Փոխանցում է բաշխված նյութերի վարպետի էջին, "
"որտեղ կարող եք մասշտաբել մի քանի սահիկ՝ մեկ տպագիր էջում տեղավորելու "
"համար:</ahelp> Սահիկների քանակը փոփոխելու համար, որոնք կարող եք տպել էջում, "
"բացեք <emph>Ուրվագծեր</emph> առաջադրանքների երեսակը և կրկնակի կտտացրեք "
"դասավորությանը:"

#: 05250700.xhp#tit.help.text
#: 05250700.xhp%23tit.help.text
msgid "Reverse "
msgstr "Հակառակ կարգով"

#: 05250700.xhp#bm_id3154011.help.text
#: 05250700.xhp%23bm_id3154011.help.text
msgid ""
"<bookmark_value>reversing objects</bookmark_value><bookmark_value>objects; "
"reversing</bookmark_value>"
msgstr ""
"<bookmark_value>reversing objects</bookmark_value><bookmark_value>objects; "
"reversing</bookmark_value>"

#: 05250700.xhp#hd_id3154011.1.help.text
#: 05250700.xhp%23hd_id3154011.1.help.text
msgid ""
"<link href=\"text/simpress/01/05250700.xhp\" name=\"Reverse\">Reverse</link>"
msgstr ""
"<link href=\"text/simpress/01/05250700.xhp\" name=\"Հակառակ կարգով\">Հակառակ "
"կարգով</link>"

#: 05250700.xhp#par_id3145800.2.help.text
#: 05250700.xhp%23par_id3145800.2.help.text
msgid ""
"<ahelp hid=\".uno:ReverseOrder\">Reverses the stacking order of the selected "
"objects.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ReverseOrder\">հակառակ կարգով է դարձնում ընտրված "
"օբյեկտների կուտակումը:</ahelp>"

#: 05250700.xhp#par_id3150717.3.help.text
#: 05250700.xhp%23par_id3150717.3.help.text
msgid ""
"You can select this function only if at least two drawing elements are "
"selected together."
msgstr ""
"Դուք կարող եք ընտրել այս գործառույթը միայն այն դեպքում, եթե առնվազն երկու "
"գծագրական տարր է ընտրված միասին:"

#: 01180000.xhp#tit.help.text
#: 01180000.xhp%23tit.help.text
msgctxt "01180000.xhp#tit.help.text"
msgid "Page"
msgstr "Էջ"

#: 01180000.xhp#hd_id3149379.1.help.text
#: 01180000.xhp%23hd_id3149379.1.help.text
msgctxt "01180000.xhp#hd_id3149379.1.help.text"
msgid "Page"
msgstr "Էջ"

#: 01180000.xhp#par_id3150717.2.help.text
#: 01180000.xhp%23par_id3150717.2.help.text
msgid ""
"<variable id=\"seiteeintext\"><ahelp hid=\".uno:PageSetup\" visibility=\""
"visible\">Sets page orientation, page margins, background and other layout "
"options.</ahelp></variable>"
msgstr ""
"<variable id=\"seiteeintext\"><ahelp hid=\".uno:PageSetup\" visibility=\""
"visible\">Կարգավորում է էջի կողմնորոշումը, էջի լուսանցքները, հետնամասի և "
"դասավորության այլ ընտրանքները:</ahelp></variable>"

#: 01180000.xhp#par_id3145587.5.help.text
#: 01180000.xhp%23par_id3145587.5.help.text
msgid ""
"To change the background of all of the pages in the active file, select a "
"background, click <emph>OK</emph> and click <emph>Yes</emph> in the <emph>"
"Page Settings</emph> dialog."
msgstr ""
"Ակտիվ նիշքի բոլոր էջերի հետնամսաերը փոխելու համար ընտրեք ֆոն, կտտացրեք "
"<emph>Լավ</emph> և <emph>Էջի կարգավորումներ</emph> երկխոսության մեջ կտտացրեք "
"<emph>Այո</emph>:"

#: 13050500.xhp#tit.help.text
#: 13050500.xhp%23tit.help.text
msgid "To Bitmap "
msgstr "Բիթքարտեզի"

#: 13050500.xhp#bm_id3153142.help.text
#: 13050500.xhp%23bm_id3153142.help.text
msgid ""
"<bookmark_value>converting; to "
"bitmaps</bookmark_value><bookmark_value>bitmaps; converting "
"to</bookmark_value>"
msgstr ""
"<bookmark_value>converting; to "
"bitmaps</bookmark_value><bookmark_value>bitmaps; converting "
"to</bookmark_value>"

#: 13050500.xhp#hd_id3153142.1.help.text
#: 13050500.xhp%23hd_id3153142.1.help.text
msgid ""
"<link href=\"text/simpress/01/13050500.xhp\" name=\"To Bitmap\">To "
"Bitmap</link>"
msgstr ""
"<link href=\"text/simpress/01/13050500.xhp\" name=\"Բիթքարտեզի\""
">Բիթքարտեզի</link>"

#: 13050500.xhp#par_id3146975.2.help.text
#: 13050500.xhp%23par_id3146975.2.help.text
msgid ""
"<ahelp hid=\".uno:ConvertIntoBitmap\">Converts the selected object to a "
"bitmap (a grid of pixels that represents an image).</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ConvertIntoBitmap\">Ընտրված առարկան փոխակերպում է "
"բիթքարտեզի (պիքսելների ցանց, որը պատկեր է ներկայացնում):</ahelp>"

#: 13050500.xhp#par_id3149377.4.help.text
#: 13050500.xhp%23par_id3149377.4.help.text
msgid ""
"For more information, see the <link href=\"text/shared/00/00000005.xhp\" "
"name=\"Glossary\">Glossary</link>."
msgstr ""
"Լրացուցիչ տեղեկությունների համար տե՛ս <link href=\"text/shared/00/00000005."
"xhp\" name=\"Բառարան\">Բառարանy</link>."

#: 13050500.xhp#par_id3155333.3.help.text
#: 13050500.xhp%23par_id3155333.3.help.text
msgid ""
"You can also copy the selected object and choose <emph>Edit - Paste Special "
"</emph>and select the bitmap format from the list."
msgstr ""
"Կարող եք նաև պատճենել ընտրված առարկան և ընտրել <emph>Խմբագրել - Տեղադրել "
"հատուկ</emph> և ցուցակից ընտրել bitmap ձևաչափը:"

#: 04040000m.xhp#tit.help.text
#: 04040000m.xhp%23tit.help.text
msgid "Columns"
msgstr "Սյունակներ"

#: 04040000m.xhp#bm_id31556284711.help.text
#: 04040000m.xhp%23bm_id31556284711.help.text
msgid ""
"<bookmark_value>inserting; columns</bookmark_value><bookmark_value>columns; "
"inserting</bookmark_value>"
msgstr ""
"<bookmark_value>տեղադրել; "
"սյունակներ</bookmark_value><bookmark_value>սյունակներ; "
"տեղադրել</bookmark_value>"

#: 04040000m.xhp#hd_id3155628.1.help.text
#: 04040000m.xhp%23hd_id3155628.1.help.text
msgid ""
"<link href=\"text/simpress/01/04040000m.xhp\" name=\"Columns\">Columns</link>"
msgstr ""
"<link href=\"text/simpress/01/04040000m.xhp\" name=\"Սյունակներ\""
">Սյունակներ</link>"

#: 04040000m.xhp#par_id3150791.2.help.text
#: 04040000m.xhp%23par_id3150791.2.help.text
msgid ""
"<ahelp hid=\".uno:InsertColumns\">Inserts a new column to the left of the "
"active cell. The number of columns inserted correspond to the number of "
"columns selected. The existing columns are moved to the right.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:InsertColumns\">Տեղադրում է նոր սյունակ ակտիվ բջիջից ձախ: "
"Տեղադրված սյունակների քանակը համապատասխանում է ընտրված սյունակների թվին: "
"Գոյություն ունեցող սյունակները տեղափոխվում են աջ:</ahelp>"

#: 04040000m.xhp#par_id0916200811234668.help.text
#: 04040000m.xhp%23par_id0916200811234668.help.text
msgid "In the context menu of a cell, choose <emph>Insert - Columns</emph>"
msgstr ""
"Բջջի համատեքստային ընտրացանկում ընտրեք <emph>Տեղադրել - Սյունակներ</emph>"

#: 03150300.xhp#tit.help.text
#: 03150300.xhp%23tit.help.text
msgid "Notes Master"
msgstr "Նշումների վարպետ"

#: 03150300.xhp#bm_id3153144.help.text
#: 03150300.xhp%23bm_id3153144.help.text
msgid ""
"<bookmark_value>notes;default formatting</bookmark_value><bookmark_value>back"
"grounds;notes</bookmark_value><bookmark_value>speaker "
"notes;defaults</bookmark_value>"
msgstr ""
"<bookmark_value>նշումներ;լռելյայն ձևաչափում</bookmark_value><bookmark_value>հ"
"ետնամասեր;նշումներ</bookmark_value><bookmark_value>զեկուցողի "
"նշումներ;լռելյաններ</bookmark_value>"

#: 03150300.xhp#hd_id3153144.1.help.text
#: 03150300.xhp%23hd_id3153144.1.help.text
msgid ""
"<link href=\"text/simpress/01/03150300.xhp\" name=\"Notes Master\">Notes "
"Master</link>"
msgstr ""
"<link href=\"text/simpress/01/03150300.xhp\" name=\"Նշումների վարպետ\">"
"Նշումների վարպետ</link>"

#: 03150300.xhp#par_id3154491.2.help.text
#: 03150300.xhp%23par_id3154491.2.help.text
msgid ""
"<ahelp hid=\".uno:NotesMasterPage\">Displays the notes master, where you can "
"set the default formatting for notes.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:NotesMasterPage\">Ցուցադրում է նշումների վարպետը, որտեղ "
"կարող եք սահմանել նշումների լռելյայն ձևաչափումը:</ahelp>"

#: effectoptionseffect.xhp#tit.help.text
#: effectoptionseffect.xhp%23tit.help.text
msgid "Effect"
msgstr "Ազդեցություն"

#: effectoptionseffect.xhp#par_idN10682.help.text
#: effectoptionseffect.xhp%23par_idN10682.help.text
msgid ""
"<variable id=\"effect\"><link href=\"text/simpress/01/effectoptionseffect."
"xhp\">Effect</link></variable>"
msgstr ""
"<variable id=\"effect\"><link href=\"text/simpress/01/effectoptionseffect."
"xhp\">Ազդեցություն</link></variable>"

#: effectoptionseffect.xhp#par_idN106A0.help.text
#: effectoptionseffect.xhp%23par_idN106A0.help.text
msgid ""
"Specifies the settings and enhancements for the current effect in the <link "
"href=\"text/simpress/01/effectoptions.xhp\">Effect Options</link> dialog."
msgstr ""
"Նշում է ընթացիկ ազդեցության կարգավորումները և լրացումները <link href=\""
"text/simpress/01/effectoptions.xhp\">Ազդեցության ընտրանքներ</link> "
"երկխոսությունում։"

#: effectoptionseffect.xhp#par_idN106B1.help.text
#: effectoptionseffect.xhp%23par_idN106B1.help.text
msgctxt "effectoptionseffect.xhp#par_idN106B1.help.text"
msgid "Settings"
msgstr "Կարգավորումներ"

#: effectoptionseffect.xhp#par_idN106B5.help.text
#: effectoptionseffect.xhp%23par_idN106B5.help.text
msgid ""
"For some effects, the settings can be specified on the <emph>Effect</emph> "
"tab page."
msgstr ""
"Որոշ ազդեցությունների համար կարգավորումները կարող են նշված լինել "
"<emph>Ազդեցություն</emph> էջանիշում:"

#: effectoptionseffect.xhp#hd_id950041.help.text
#: effectoptionseffect.xhp%23hd_id950041.help.text
msgid "Direction"
msgstr "Ուղղություն"

#: effectoptionseffect.xhp#par_id2195196.help.text
#: effectoptionseffect.xhp%23par_id2195196.help.text
msgid "<ahelp hid=\".\">Specifies the direction for the effect.</ahelp>"
msgstr "<ahelp hid=\".\">Նշում է ազդեցության ուղղությունը:</ahelp>"

#: effectoptionseffect.xhp#hd_id8484756.help.text
#: effectoptionseffect.xhp%23hd_id8484756.help.text
msgid "Accelerated start"
msgstr "Արագացված մեկնարկ"

#: effectoptionseffect.xhp#par_id5049287.help.text
#: effectoptionseffect.xhp%23par_id5049287.help.text
msgid ""
"<ahelp hid=\".\">Enable this option to assign a gradually increasing speed "
"to the start of the effect.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Միացրեք այս տարբերակը` ազդեցության մեկնարկին աստիճանաբար "
"աճող արագություն նշանակելու համար:</ahelp>"

#: effectoptionseffect.xhp#hd_id7056794.help.text
#: effectoptionseffect.xhp%23hd_id7056794.help.text
msgid "Decelerated end"
msgstr "Դանդաղեցված ավարտ"

#: effectoptionseffect.xhp#par_id1145359.help.text
#: effectoptionseffect.xhp%23par_id1145359.help.text
msgid ""
"<ahelp hid=\".\">Enable this option to assign a gradually decreasing speed "
"to the end of the effect.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Միացրեք այս տարբերակը` ազդեցության ավարտին աստիճանաբար "
"նվազող արագություն նշանակելու համար:</ahelp>"

#: effectoptionseffect.xhp#par_idN10707.help.text
#: effectoptionseffect.xhp%23par_idN10707.help.text
msgid "Enhancements"
msgstr "Բարելավումներ"

#: effectoptionseffect.xhp#par_idN1070B.help.text
#: effectoptionseffect.xhp%23par_idN1070B.help.text
msgid "Specifies the enhancements for the current effect."
msgstr "Նշում է ընթացիկ ազդեցության բարելավումները:"

#: effectoptionseffect.xhp#par_idN1070E.help.text
#: effectoptionseffect.xhp%23par_idN1070E.help.text
msgctxt "effectoptionseffect.xhp#par_idN1070E.help.text"
msgid "Sound"
msgstr "Հնչյուն"

#: effectoptionseffect.xhp#par_idN10712.help.text
#: effectoptionseffect.xhp%23par_idN10712.help.text
msgid ""
"<ahelp hid=\"878824971\">Select a sound from the Gallery or select one of "
"the special entries.</ahelp>"
msgstr ""
"<ahelp hid=\"878824971\">Պատկերասրահից ընտրեք հնչյունը, կամ ընտրեք հատուկ "
"մուտքերից մեկը:</ahelp>"

#: effectoptionseffect.xhp#par_idN10718.help.text
#: effectoptionseffect.xhp%23par_idN10718.help.text
msgid ""
"<emph>No sound</emph> - no sound is played during animation of the effect."
msgstr ""
"<emph>Չկա հնչյուն</emph> - ազդեցության անիմացիայի ժամանակ ոչ մի ձայն չի "
"հնչում:"

#: effectoptionseffect.xhp#par_idN1071F.help.text
#: effectoptionseffect.xhp%23par_idN1071F.help.text
msgid ""
"<emph>Stop previous sound</emph> - the sound of the previous effect is "
"stopped as soon as the current effect runs."
msgstr ""
"<emph>Դադարեցնել նախորդ ձայնը</emph> - նախորդ ազդեցության ձայնը դադարեցվում "
"է ընթացիկ ազդեցության աշխատելուն պես:"

#: effectoptionseffect.xhp#par_idN10726.help.text
#: effectoptionseffect.xhp%23par_idN10726.help.text
msgid ""
"<emph>Other sound</emph> - displays a file open dialog to select a sound "
"file."
msgstr ""
"<emph>Այլ ձայն</emph> - ցուցադրում է նիշքը բացելու երկխոսությունը` ձայնային "
"նիշք ընտրելու համար:"

#: effectoptionseffect.xhp#par_idN1072C.help.text
#: effectoptionseffect.xhp%23par_idN1072C.help.text
msgid "Sound button"
msgstr "Ձայնի կոճակ"

#: effectoptionseffect.xhp#par_idN10730.help.text
#: effectoptionseffect.xhp%23par_idN10730.help.text
msgid "<ahelp hid=\".\">Plays the selected sound file.</ahelp>"
msgstr "<ahelp hid=\".\">Նվագարկում է ձայնային ընտրված նիշքը:</ahelp>"

#: effectoptionseffect.xhp#par_idN10733.help.text
#: effectoptionseffect.xhp%23par_idN10733.help.text
msgid "After animation"
msgstr "Անիմացիայից հետո"

#: effectoptionseffect.xhp#par_idN10737.help.text
#: effectoptionseffect.xhp%23par_idN10737.help.text
msgid ""
"<ahelp hid=\"878824973\">Select a color to be shown after the animation "
"ends, or select another after-effect from the list</ahelp>:"
msgstr ""
"<ahelp hid=\"878824973\">Ընտրեք գույնը, որը կցուցադրվի անիմացիայի ավարտից "
"հետո կամ ցուցակից ընտրեք մեկ այլ ազդեցության ավարտի</ahelp>:"

#: effectoptionseffect.xhp#par_idN10752.help.text
#: effectoptionseffect.xhp%23par_idN10752.help.text
msgid ""
"<emph>Dim with color</emph> - after the animation a dim color fills the "
"shape."
msgstr ""
"<emph>Մգացրեք գույնով</emph> - անիմացիայից հետո աղոտ գույնը լցնում է պատկերը:"

#: effectoptionseffect.xhp#par_idN1073D.help.text
#: effectoptionseffect.xhp%23par_idN1073D.help.text
msgid "<emph>Don't dim</emph> - no after-effect runs."
msgstr "<emph>Մի մգացրեք</emph> - րի կատարվում չկա ազդեցությունից հետո։"

#: effectoptionseffect.xhp#par_idN10744.help.text
#: effectoptionseffect.xhp%23par_idN10744.help.text
msgid ""
"<emph>Hide after animation</emph> - hides the shape after the animation ends."
msgstr ""
"<emph>Թաքցնել անիմացիայից հետո</emph> - անիմացիան ավարտելուց հետո թաքցնում է "
"ձևը:"

#: effectoptionseffect.xhp#par_idN1074B.help.text
#: effectoptionseffect.xhp%23par_idN1074B.help.text
msgid ""
"<emph>Hide on next animation</emph> - hides the shape on the next animation."
msgstr ""
"<emph>Թաքցնել հաջորդ անիմացիայի ժամանակ</emph> - հաջորդ անիմացիայի ժամանակ "
"թաքցնում է ձևը:"

#: effectoptionseffect.xhp#par_idN10865.help.text
#: effectoptionseffect.xhp%23par_idN10865.help.text
msgid "Dim color"
msgstr "Աղոտացնել գույնը"

#: effectoptionseffect.xhp#par_idN1087B.help.text
#: effectoptionseffect.xhp%23par_idN1087B.help.text
msgid "<ahelp hid=\"878824975\">Select the dim color.</ahelp>"
msgstr "<ahelp hid=\"878824975\">Ընտրեք աղոտ գույնը:</ahelp>"

#: effectoptionseffect.xhp#par_idN10758.help.text
#: effectoptionseffect.xhp%23par_idN10758.help.text
msgid "Text animation"
msgstr "Տեքստի անիմացիա"

#: effectoptionseffect.xhp#par_idN1075C.help.text
#: effectoptionseffect.xhp%23par_idN1075C.help.text
msgid ""
"<ahelp hid=\"878824977\">Select the animation mode for the text of the "
"current shape</ahelp>:"
msgstr ""
"<ahelp hid=\"878824977\">Ընթացիկ ձևի տեքստի համար ընտրեք անիմացիայի "
"վիճակը</ahelp>:"

#: effectoptionseffect.xhp#par_idN10762.help.text
#: effectoptionseffect.xhp%23par_idN10762.help.text
msgid "<emph>All at once</emph> - animates the text all at once."
msgstr "<emph>Բոլորը միանգամից</emph> - միանգամից կենդանացնում է տեքստը:"

#: effectoptionseffect.xhp#par_idN10769.help.text
#: effectoptionseffect.xhp%23par_idN10769.help.text
msgid "<emph>Word by word</emph> - animates the text word by word."
msgstr "<emph>Բառ առ բառ</emph> - բառ առ բառ կենդանացնում է տեքստը:"

#: effectoptionseffect.xhp#par_idN10770.help.text
#: effectoptionseffect.xhp%23par_idN10770.help.text
msgid "<emph>Letter by letter</emph> - animates the text letter by letter."
msgstr "<emph>Տառ առ տառ</emph> - տառ առ տառ կենդանացնում է տեքստը:"

#: effectoptionseffect.xhp#par_idN10776.help.text
#: effectoptionseffect.xhp%23par_idN10776.help.text
msgid "Delay between characters"
msgstr "Հետաձգում նիշերի միջեւ"

#: effectoptionseffect.xhp#par_idN1077A.help.text
#: effectoptionseffect.xhp%23par_idN1077A.help.text
msgid ""
"<ahelp hid=\"878828050\">Specifies the percentage of delay between "
"animations of words or letters.</ahelp>"
msgstr ""
"<ahelp hid=\"878828050\">Նշում է բառերի կամ տառերի անիմացիաների հետաձգման "
"տոկոսը:</ahelp>"

#: 03060000.xhp#tit.help.text
#: 03060000.xhp%23tit.help.text
msgid "Rulers"
msgstr "Քանոններ"

#: 03060000.xhp#hd_id3146974.1.help.text
#: 03060000.xhp%23hd_id3146974.1.help.text
msgid ""
"<link href=\"text/simpress/01/03060000.xhp\" name=\"Rulers\">Ruler</link>"
msgstr ""
"<link href=\"text/simpress/01/03060000.xhp\" name=\"Քանոններ\">Քանոն</link>"

#: 03060000.xhp#par_id3149378.2.help.text
#: 03060000.xhp%23par_id3149378.2.help.text
msgid ""
"<ahelp hid=\".uno:ShowRuler\">Displays or hides rulers at the top and at the "
"left edge of the workspace.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ShowRuler\">Ցուցադրում կամ թաքցնում է քանոնները "
"աշխատանքային տարածքի վերևում և ձախ եզրին:</ahelp>"

#: 03060000.xhp#par_id3146972.3.help.text
#: 03060000.xhp%23par_id3146972.3.help.text
msgid ""
"You can use <link href=\"text/simpress/main0209.xhp\" name=\"rulers\""
">rulers</link> to position objects in the workspace, to set paragraph "
"indents or to drag <link href=\"text/simpress/01/04030000.xhp\" name=\""
"guides\">guides</link> onto the page."
msgstr ""
"Կարող եք օգտագրծել <link href=\"text/simpress/main0209.xhp\" name=\""
"քանոնները\">քանոնները</link> առարկաները աշխատանքային տարածքում տեղադրելու, "
"պարբերության փորվածքներ սահմանելու կամ քաշելու համար <link href=\""
"text/simpress/01/04030000.xhp\" name=\"ուղեցույցները\">ուղեցույցները</link> "
"էջի վրա։"

#: 03180000.xhp#tit.help.text
#: 03180000.xhp%23tit.help.text
msgid "Color/Grayscale"
msgstr "Գույն/Մոխրագույնի սանդղակ"

#: 03180000.xhp#bm_id3153142.help.text
#: 03180000.xhp%23bm_id3153142.help.text
msgid ""
"<bookmark_value>display qualities of "
"presentations</bookmark_value><bookmark_value>colors; displaying "
"presentations</bookmark_value><bookmark_value>black and white "
"display</bookmark_value><bookmark_value>grayscale display</bookmark_value>"
msgstr ""
"<bookmark_value>display qualities of "
"presentations</bookmark_value><bookmark_value>colors; displaying "
"presentations</bookmark_value><bookmark_value>black and white "
"display</bookmark_value><bookmark_value>grayscale display</bookmark_value>"

#: 03180000.xhp#hd_id3153142.1.help.text
#: 03180000.xhp%23hd_id3153142.1.help.text
msgid ""
"<link href=\"text/simpress/01/03180000.xhp\" name=\"Display Quality\""
">Color/Grayscale</link>"
msgstr ""
"<link href=\"text/simpress/01/03180000.xhp\" name=\"Արտածման որակ\">Գույն/"
"Մոխրագույնի սանդղակ</link>"

#: 03180000.xhp#par_id3151073.2.help.text
#: 03180000.xhp%23par_id3151073.2.help.text
msgid "Shows slides in color, grayscale, or black and white."
msgstr "Ցուցադրում է սահիկները գույնով, մոխրագույն կամ սև սպիտակ:"

#: 03180000.xhp#hd_id3149123.3.help.text
#: 03180000.xhp%23hd_id3149123.3.help.text
msgid "Color"
msgstr "Գույն"

#: 03180000.xhp#par_id3154757.4.help.text
#: 03180000.xhp%23par_id3154757.4.help.text
msgid "<ahelp hid=\".uno:OutputQualityColor\">Shows slides in color.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:OutputQualityColor\">Ցույց է տալիս սահիկները "
"գույնով։</ahelp>"

#: 03180000.xhp#hd_id3155333.5.help.text
#: 03180000.xhp%23hd_id3155333.5.help.text
msgid "Grayscale"
msgstr "Մոխրագույնի սանդղակ"

#: 03180000.xhp#par_id3150200.6.help.text
#: 03180000.xhp%23par_id3150200.6.help.text
msgid ""
"<ahelp hid=\".uno:OutputQualityGrayscale\">Shows slides in shades of black "
"and white.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:OutputQualityGrayscale\">Ցուցադրում է սահիկները սև և "
"սպիտակ երանգներով:</ahelp>"

#: 03180000.xhp#hd_id3150342.7.help.text
#: 03180000.xhp%23hd_id3150342.7.help.text
msgid "Black and White"
msgstr "Սև և սպիտակ"

#: 03180000.xhp#par_id3150207.8.help.text
#: 03180000.xhp%23par_id3150207.8.help.text
msgid ""
"<ahelp hid=\".uno:OutputQualityBlackWhite\">Shows slides in pure black or "
"white without shading.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:OutputQualityBlackWhite\">Ցուցադրում է սահիկները մաքուր սև "
"կամ սպիտակ` առանց ստվերի:</ahelp>"

#: 06100000.xhp#tit.help.text
#: 06100000.xhp%23tit.help.text
msgctxt "06100000.xhp#tit.help.text"
msgid "Custom Slide Shows"
msgstr "Սահիկի անհատականացված ցուցադրում"

#: 06100000.xhp#hd_id3154659.1.help.text
#: 06100000.xhp%23hd_id3154659.1.help.text
msgctxt "06100000.xhp#hd_id3154659.1.help.text"
msgid "Custom Slide Shows"
msgstr "Սահիկի անհատականացված ցուցադրում"

#: 06100000.xhp#par_id3149207.2.help.text
#: 06100000.xhp%23par_id3149207.2.help.text
msgid ""
"<variable id=\"indipraesent\"><ahelp hid=\".uno:CustomShowDialog\">Defines a "
"custom slide show using slides within the current presentation. You can then "
"pick slides to meet the needs of your audience. You can create as many "
"custom slide shows as you want.</ahelp></variable>"
msgstr ""
"<variable id=\"indipraesent\"><ahelp hid=\".uno:CustomShowDialog\">Ընթացիկ "
"շնորհանդեսի շրջանակներում օգտագործելով սահիկները սահմանում է սահիկների "
"անհատականացված ցուցադրությունը: Ապա կարող եք սահիկներ ընտրել՝ ձեր լսարանի "
"կարիքները բավարարելու համար: Կարող եք ստեղծել սահիկների այնքան "
"ցուցադրություններ, որքան ցանկանում եք:</ahelp></variable>"

#: 06100000.xhp#hd_id3155530.3.help.text
#: 06100000.xhp%23hd_id3155530.3.help.text
msgid "Name of the presentation(s)"
msgstr "Շնորհանդես(ներ)ի անունը"

#: 06100000.xhp#par_id3156449.4.help.text
#: 06100000.xhp%23par_id3156449.4.help.text
msgid ""
"<ahelp hid=\"SD_LISTBOX_DLG_CUSTOMSHOW_LB_CUSTOMSHOWS\">Lists the custom "
"slide shows that are available.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_LISTBOX_DLG_CUSTOMSHOW_LB_CUSTOMSHOWS\">Թվարկում է սահիկների "
"հասանելի ցուցադրությունները:</ahelp>"

#: 06100000.xhp#par_id3149408.5.help.text
#: 06100000.xhp%23par_id3149408.5.help.text
msgid "To create a custom slide show, click <emph>New</emph>."
msgstr ""
"Սահիկի անհատականացված ցուցադրություն ստեղծելու համար, կտտացրեք "
"<emph>Նոր</emph>։"

#: 06100000.xhp#hd_id3152899.9.help.text
#: 06100000.xhp%23hd_id3152899.9.help.text
msgid "Use Custom Slide Show"
msgstr "Օգտագործեք սահիկի անհատականացված ցուցադրությունը"

#: 06100000.xhp#par_id3149947.10.help.text
#: 06100000.xhp%23par_id3149947.10.help.text
msgid ""
"<ahelp hid=\"SD_CHECKBOX_DLG_CUSTOMSHOW_CBX_USE_CUSTOMSHOW\">Runs the custom "
"slide show you selected when you click <emph>Start</emph>. Otherwise, the "
"entire presentation is shown.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_CHECKBOX_DLG_CUSTOMSHOW_CBX_USE_CUSTOMSHOW\">Աշխատեցնում է "
"ձեր ընտրած սահիկի անհատականացված ցուցադրությունը, երբ կտտացնում եք "
"<emph>Մեկնարկ</emph>։ Հակառակ դեպքում ցուցադրվում է ամբողջ "
"շնորհանդեսը:</ahelp>"

#: 06100000.xhp#hd_id3148604.6.help.text
#: 06100000.xhp%23hd_id3148604.6.help.text
msgid "To run a custom slide show:"
msgstr "Սահիկի անհատականացված ցուցադրությունը աշխատեցնելու համար"

#: 06100000.xhp#par_id3153250.7.help.text
#: 06100000.xhp%23par_id3153250.7.help.text
msgid ""
"Click the show in the list and then select <emph>Use Custom Slide "
"Show</emph>."
msgstr ""
"Ցուցակից կտտացրեք ցուցադրությունը և ընտրեք <emph>Օգտագործեք սահիկի "
"անհատականացված ցուցադրությունը</emph>։"

#: 06100000.xhp#par_id3159230.8.help.text
#: 06100000.xhp%23par_id3159230.8.help.text
msgid "Click <emph>Start</emph>."
msgstr "Սեղմեք <emph>Մեկնարկ</emph>։"

#: 06100000.xhp#hd_id3153808.11.help.text
#: 06100000.xhp%23hd_id3153808.11.help.text
msgid "<link href=\"text/simpress/01/06100100.xhp\" name=\"New\">New</link>"
msgstr "<link href=\"text/simpress/01/06100100.xhp\" name=\"Նոր\">Նոր</link>"

#: 06100000.xhp#hd_id3153073.12.help.text
#: 06100000.xhp%23hd_id3153073.12.help.text
msgctxt "06100000.xhp#hd_id3153073.12.help.text"
msgid "Edit"
msgstr "Խմբագրել"

#: 06100000.xhp#par_id3150431.13.help.text
#: 06100000.xhp%23par_id3150431.13.help.text
msgid ""
"<ahelp hid=\"SD_PUSHBUTTON_DLG_CUSTOMSHOW_BTN_EDIT\"><link href=\""
"text/simpress/01/06100100.xhp\" name=\"Add, remove or reorder\">Add, remove "
"or reorder</link> slides as well as change the name of the selected custom "
"slide show.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_PUSHBUTTON_DLG_CUSTOMSHOW_BTN_EDIT\"><link href=\""
"text/simpress/01/06100100.xhp\" name=\"Ավելացնել, հեռացնել կամ "
"վերադասավորել\">Ավելացնել, հեռացնել կամ վերադասավորել</link> սահիկները, "
"ինչպես նաև փոխել ընտրված սահիկների անհատական ցուցադրության անունը:</ahelp>"

#: 06100000.xhp#hd_id3151393.14.help.text
#: 06100000.xhp%23hd_id3151393.14.help.text
msgid "Copy"
msgstr "Պատճենել"

#: 06100000.xhp#par_id3145236.15.help.text
#: 06100000.xhp%23par_id3145236.15.help.text
msgid ""
"<ahelp hid=\"SD_PUSHBUTTON_DLG_CUSTOMSHOW_BTN_COPY\">Creates a copy of the "
"selected custom slide show. You can modify the name of the show by clicking "
"<emph>Edit</emph>.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_PUSHBUTTON_DLG_CUSTOMSHOW_BTN_COPY\">Ստեղծում է ընտրված "
"անհատական սահիկների ցուցադրության պատճենը: Ցուցադրության անունը կարող եք "
"փոփոխել՝ սեղմելով <emph>Խմբագրել</emph>.</ahelp>"

#: 06100000.xhp#hd_id3153121.16.help.text
