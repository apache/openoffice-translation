#: 06050000.xhp%23par_id3152871.7.help.text
msgid "Backwards"
msgstr "Հետ"

#: 06050000.xhp#par_id3150210.10.help.text
#: 06050000.xhp%23par_id3150210.10.help.text
msgid ""
"<ahelp hid=\"SD_IMAGEBUTTON_FLT_WIN_ANIMATION_BTN_STOP\">Stops playing the "
"animation.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_IMAGEBUTTON_FLT_WIN_ANIMATION_BTN_STOP\">Դադարեցնում է "
"անիմացիայի խաղարկումը։</ahelp>"

#: 06050000.xhp#par_id3153011.help.text
#: 06050000.xhp%23par_id3153011.help.text
msgid ""
"<image id=\"img_id3147250\" src=\"res/helpimg/sistop.png\" width=\"0.2189in\""
" height=\"0.1874in\"><alt id=\"alt_id3147250\">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3147250\" src=\"res/helpimg/sistop.png\" width=\"0.2189in\""
" height=\"0.1874in\"><alt id=\"alt_id3147250\">Պատկերակ</alt></image>"

#: 06050000.xhp#par_id3153961.9.help.text
#: 06050000.xhp%23par_id3153961.9.help.text
msgid "Stop"
msgstr "Դադար"

#: 06050000.xhp#par_id3147297.12.help.text
#: 06050000.xhp%23par_id3147297.12.help.text
msgid ""
"<ahelp hid=\"SD_IMAGEBUTTON_FLT_WIN_ANIMATION_BTN_PLAY\">Plays the "
"animation.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_IMAGEBUTTON_FLT_WIN_ANIMATION_BTN_PLAY\">Խաղարկում է "
"անիմացիան։</ahelp>"

#: 06050000.xhp#par_id3153119.help.text
#: 06050000.xhp%23par_id3153119.help.text
msgid ""
"<image id=\"img_id3149352\" src=\"res/helpimg/right.png\" width=\"0.2189in\" "
"height=\"0.1874in\"><alt id=\"alt_id3149352\">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3149352\" src=\"res/helpimg/right.png\" width=\"0.2189in\" "
"height=\"0.1874in\"><alt id=\"alt_id3149352\">Պատկերակ</alt></image>"

