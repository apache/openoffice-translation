#: 06050000.xhp%23par_id3150008.16.help.text
msgid ""
"<ahelp hid=\"SD_NUMERICFIELD_FLT_WIN_ANIMATION_NUM_FLD_BITMAP\">Indicates "
"the position of the current image in the animation sequence.</ahelp> If you "
"want to view another image, enter its number or click the up and down arrows."
msgstr ""
"<ahelp hid=\"SD_NUMERICFIELD_FLT_WIN_ANIMATION_NUM_FLD_BITMAP\">Անիմացիայի "
"հաջորդականության մեջ ցույց է տալիս ներկայիս պատկերի դիրքը:</ahelp> Եթե "
"ցանկանում եք դիտել մեկ այլ պատկեր, մուտքագրեք դրա թիվը կամ կտտացրեք դեպի վեր "
"և դեպի ներքև սլաքներին:"

#: 06050000.xhp#hd_id3148569.17.help.text
#: 06050000.xhp%23hd_id3148569.17.help.text
msgid "Duration"
msgstr "Տևողություն"

#: 06050000.xhp#par_id3150337.18.help.text
#: 06050000.xhp%23par_id3150337.18.help.text
msgid ""
"<ahelp hid=\"SD_TIMEFIELD_FLT_WIN_ANIMATION_TIME_FIELD\">Enter the number of "
"seconds to display the current image. This option is only available if you "
"select the <emph>Bitmap object</emph> option in the <emph>Animation "
"group</emph> field.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_TIMEFIELD_FLT_WIN_ANIMATION_TIME_FIELD\">Մուտքագրեք "
"վայրկյանների քանակը` ընթացիկ պատկերը ցուցադրելու համար: Այս տարբերակը "
"հասանելի է միայն այն դեպքում, եթե <emph>Անիմացիայի խումբ</emph> դաշտում "
"ընտրեք <emph>Բիթքարտեզ առարկա</emph> տարբերակը:</ahelp>"

#: 06050000.xhp#hd_id3147368.83.help.text
#: 06050000.xhp%23hd_id3147368.83.help.text
msgid "Loop count"
msgstr "Պտույտների հաշվիչ"

#: 06050000.xhp#par_id3154326.84.help.text
#: 06050000.xhp%23par_id3154326.84.help.text
msgid ""
"<ahelp hid=\"SD_LISTBOX_FLT_WIN_ANIMATION_LB_LOOP_COUNT\">Sets the number of "
"times that the animation is played.</ahelp> If you want the animation to "
"play continuously, choose <emph>Max</emph>."
msgstr ""
"<ahelp hid=\"SD_LISTBOX_FLT_WIN_ANIMATION_LB_LOOP_COUNT\">Սահմանում է "
"անիմացիայի խաղարկման քանակը:</ahelp> Եթե ցանկանում եք, որ անիմացիան անընդհատ "
"խաղարկվի, ընտրեք <emph>Մաքս</emph>։"

#: 06050000.xhp#hd_id3155928.19.help.text
#: 06050000.xhp%23hd_id3155928.19.help.text
msgid "Image"
msgstr "Պատկեր"

#: 06050000.xhp#par_id3155434.37.help.text
#: 06050000.xhp%23par_id3155434.37.help.text
msgid "Adds or removes objects from your animation."
msgstr "Ձեր անիմացիայից ավելացնում կամ հեռացնում է օբյեկտները:"

