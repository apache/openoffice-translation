#: 04030000m.xhp%23par_id3150767.2.help.text
msgid ""
"<ahelp hid=\".uno:InsertRows\">Inserts a new row above the active cell. The "
"number of rows inserted correspond to the number of rows selected. The "
"existing rows are moved downward.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:InsertRows\">Ակտիվ բջիջի վերևում տեղադրում է նոր տող: "
"Տեղադրված տողերի քանակը համապատասխանում է ընտրված տողերի թվին: Գոյություն "
"ունեցող տողերը տեղափոխվում են ներքև:</ahelp>"

#: 04030000m.xhp#par_id091620081118197.help.text
#: 04030000m.xhp%23par_id091620081118197.help.text
msgid "In the context menu of a cell, choose <emph>Insert - Rows</emph>"
msgstr "Բջջի համատեքստային ընտրացանկում ընտրեք <emph>Տեղադրել - Տողեր</emph>"

