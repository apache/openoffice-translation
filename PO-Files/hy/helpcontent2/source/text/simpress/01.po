"the start slide.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:LISTBOX:DLG_START_PRESENTATION:LB_DIAS\">Մուտքագրեք մեկնարկի "
"սահիկի թիվը:</ahelp>"

#: 06080000.xhp#hd_id3147404.86.help.text
#: 06080000.xhp%23hd_id3147404.86.help.text
msgid "Custom Slide Show"
msgstr "Սահիկի անհատականացված ներկայացում"

#: 06080000.xhp#par_id3150538.87.help.text
#: 06080000.xhp%23par_id3150538.87.help.text
msgid ""
"<ahelp hid=\"SD:LISTBOX:DLG_START_PRESENTATION:LB_CUSTOMSHOW\">Runs a custom "
"slide show in the order that you defined in <link href=\""
"text/simpress/01/06100000.xhp\" name=\"Slide Show - Custom Slide Show\""
"><emph>Slide Show - Custom Slide Show</emph></link>.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:LISTBOX:DLG_START_PRESENTATION:LB_CUSTOMSHOW\">Գործարկում է "
"սահիկի անհատականացված ներկայացում այն կարգով, որը սահմանել եք այստեղ <link "
"href=\"text/simpress/01/06100000.xhp\" name=\"Սահիկի ներկայացում - Սահիկի "
"անհատականացված ներկայացում\"><emph>Սահիկի ներկայացում - Սահիկի "
"անհատականացված ներկայացում</emph></link>։</ahelp>"

#: 06080000.xhp#hd_id3150653.88.help.text
#: 06080000.xhp%23hd_id3150653.88.help.text
msgctxt "06080000.xhp#hd_id3150653.88.help.text"
msgid "Type"
msgstr "Տեսակ"

#: 06080000.xhp#par_id3149354.93.help.text
#: 06080000.xhp%23par_id3149354.93.help.text
msgid "Select the slide show type."
msgstr "Ընտրեք սահիկի ներկայացման տեսակը։"

#: 06080000.xhp#hd_id3150482.89.help.text
#: 06080000.xhp%23hd_id3150482.89.help.text
msgid "Default"
msgstr "Լռելյայն"

#: 06080000.xhp#par_id3148730.94.help.text
#: 06080000.xhp%23par_id3148730.94.help.text
msgid ""
"<ahelp hid=\"SD:RADIOBUTTON:DLG_START_PRESENTATION:RBT_STANDARD\">A full "
"screen slide is shown.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:RADIOBUTTON:DLG_START_PRESENTATION:RBT_STANDARD\">Ցուցադրված "
"է ամբողջ պաստառով սահիկ:</ahelp>"

#: 06080000.xhp#hd_id3153034.90.help.text
#: 06080000.xhp%23hd_id3153034.90.help.text
msgid "Window"
msgstr "Պատուհան"

#: 06080000.xhp#par_id3155257.82.help.text
#: 06080000.xhp%23par_id3155257.82.help.text
msgid ""
"<ahelp hid=\"SD:RADIOBUTTON:DLG_START_PRESENTATION:RBT_WINDOW\">Slide show "
"runs in the $[officename] program window.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:RADIOBUTTON:DLG_START_PRESENTATION:RBT_WINDOW\">Սահիկի "
"ներկայացումը կատարվում է $[officename] ծրագրի պատուհանում։</ahelp>"

#: 06080000.xhp#hd_id3145593.91.help.text
#: 06080000.xhp%23hd_id3145593.91.help.text
msgid "Auto"
msgstr "Ինքնաշխատ"

#: 06080000.xhp#par_id3149509.95.help.text
#: 06080000.xhp%23par_id3149509.95.help.text
msgid ""
"<ahelp hid=\"SD:RADIOBUTTON:DLG_START_PRESENTATION:RBT_AUTO\">Restarts the "
"slide show after the pause interval you specify. A pause slide is displayed "
"between the final slide and the start slide. Press the Esc key to stop the "
"show.</ahelp>."
msgstr ""
"<ahelp hid=\"SD:RADIOBUTTON:DLG_START_PRESENTATION:RBT_AUTO\">Ձեր կողմից "
"նշված դադարների միջակայքից հետո վերսկսվում է սահիկի ներկայացումը: Վերջնական "
"սահիկի և մեկնարկի սահիկի միջև ցուցադրվում է դադարների սահիկը: Սեղմեք Esc "
"ստեղնը՝ ցուցադրումը դադարեցնելու համար:</ahelp>."

#: 06080000.xhp#hd_id3150862.96.help.text
#: 06080000.xhp%23hd_id3150862.96.help.text
msgid "Duration of pause"
msgstr "Դադարի տևողությունը"

#: 06080000.xhp#par_id3153112.97.help.text
#: 06080000.xhp%23par_id3153112.97.help.text
msgid ""
"<ahelp hid=\"SD:TIMEFIELD:DLG_START_PRESENTATION:TMF_PAUSE\">Enter the "
"duration of the pause before the slide show is repeated. If you enter zero, "
"the show restarts immediately without showing a pause slide.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:TIMEFIELD:DLG_START_PRESENTATION:TMF_PAUSE\">Մուտքագրեք "
"դադարի տևողությունը մինչ սահիկի ներկայացման կրկնությունը: Եթե զրո եք "
"մուտքագրում, ներկայացումն անմիջապես վերագործարկվում է առանց ցուցադրելու "
"դադարի սահիկը:</ahelp>"

#: 06080000.xhp#hd_id3166420.92.help.text
#: 06080000.xhp%23hd_id3166420.92.help.text
msgid "Show logo"
msgstr "Ցույց տալ լոգոն"

#: 06080000.xhp#par_id3154501.98.help.text
#: 06080000.xhp%23par_id3154501.98.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_AUTOLOGO\">Displays the "
"$[officename] logo on the pause slide.</ahelp> The logo cannot be exchanged."
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_AUTOLOGO\">Դադարի "
"սահիկում ցուցադրում է $[officename] լոգոն:</ahelp> Լոգոն հնարավոր չէ "
"փոխարինել։"

#: 06080000.xhp#hd_id3150130.9.help.text
#: 06080000.xhp%23hd_id3150130.9.help.text
msgid "Options"
msgstr "Ընտրանքներ"

#: 06080000.xhp#hd_id3149883.13.help.text
#: 06080000.xhp%23hd_id3149883.13.help.text
msgid "Change slides manually"
msgstr "Փոխեք սահիկները ձեռքով"

#: 06080000.xhp#par_id3147373.14.help.text
#: 06080000.xhp%23par_id3147373.14.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_MANUEL\">Slides never "
"change automatically when this box is selected.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_MANUEL\">Սահիկները երբեք "
"ինքնաշխատ կերպով չեն փոխվում, երբ այս վանդակն է ընտրված:</ahelp>"

#: 06080000.xhp#hd_id3155439.15.help.text
#: 06080000.xhp%23hd_id3155439.15.help.text
msgid "Mouse pointer visible"
msgstr "Մկնիկի ցուցիչը տեսանելի է"

#: 06080000.xhp#par_id3150272.16.help.text
#: 06080000.xhp%23par_id3150272.16.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_MOUSEPOINTER\">Shows the "
"mouse pointer during a slide show.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_MOUSEPOINTER\">Սահիկի "
"ցուցադրման ընթացքում ցույց է տալիս մկնիկի ցուցիչը։</ahelp>"

#: 06080000.xhp#hd_id3150570.17.help.text
#: 06080000.xhp%23hd_id3150570.17.help.text
msgid "Mouse pointer as pen"
msgstr "Մկնիկի ցուցիչը որպես գրիչ"

#: 06080000.xhp#par_id3150665.18.help.text
#: 06080000.xhp%23par_id3150665.18.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_PEN\">Changes the mouse "
"pointer to a pen which you can use to draw on slides during the "
"presentation.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_PEN\">Մկնիկի ցուցիչը "
"փոխում է գրիչի, որը կարող եք օգտագործել ներկայացման ընթացքում սահիկներ "
"նկարելու համար:</ahelp>"

#: 06080000.xhp#par_id3150475.19.help.text
#: 06080000.xhp%23par_id3150475.19.help.text
msgid ""
"Anything you write with the pen is not saved when you exit the slide show. "
"The color of the pen cannot be changed."
msgstr ""
"Այն ամենը, ինչ գրում եք գրիչով, չի պահվում, երբ դուրս եք գալիս սահիկի "
"ներկայացումից: Գրիչի գույնը հնարավոր չէ փոխել:"

#: 06080000.xhp#hd_id3153927.20.help.text
#: 06080000.xhp%23hd_id3153927.20.help.text
msgid "Navigator visible"
msgstr "Նավարկիչը տեսանելի է"

#: 06080000.xhp#par_id3148430.21.help.text
#: 06080000.xhp%23par_id3148430.21.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_NAVIGATOR\">Displays the "
"<link href=\"text/simpress/01/02110000.xhp\" name=\"Navigator\""
">Navigator</link> during the slide show.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_NAVIGATOR\">Արտածում է <"
"link href=\"text/simpress/01/02110000.xhp\" name=\"Նավարկիչը\""
">Նավարկիչը</link> սահիկի ցուցադրման ընթացքում։</ahelp>"

#: 06080000.xhp#hd_id3153718.84.help.text
#: 06080000.xhp%23hd_id3153718.84.help.text
msgid "Animations allowed"
msgstr "Անիմացիաները թույլատրված են"

#: 06080000.xhp#par_id3083445.85.help.text
#: 06080000.xhp%23par_id3083445.85.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_ANIMATION_ALLOWED\">"
"Displays all frames of animated GIF files during the slide show.</ahelp> If "
"this option is not selected, only the first frame of an animated GIF file is "
"displayed."
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_ANIMATION_ALLOWED\">"
"Սահիկի ներկայացման ընթացքում ցուցադրում է անիմացիոն GIF նիշքերի բոլոր "
"շրջանակները:</ahelp> Եթե այս տարբերակը ընտրված չէ, ցուցադրվում է անիմացիոն "
"GIF նիշքի միայն առաջին շրջանակը:"

#: 06080000.xhp#hd_id3152478.22.help.text
#: 06080000.xhp%23hd_id3152478.22.help.text
msgid "Change slides by clicking on background"
msgstr "Հետնամասին սեղմելով, փոխեք սահիկները"

#: 06080000.xhp#par_id3156305.23.help.text
#: 06080000.xhp%23par_id3156305.23.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_CHANGE_PAGE\">Advances "
"to the next slide when you click on the background of a slide.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_CHANGE_PAGE\">Հաջորդ "
"սահիկին անցում, երբ կտտացնում եք սահիկի հետնամասին:</ahelp>"

#: 06080000.xhp#hd_id3150960.24.help.text
#: 06080000.xhp%23hd_id3150960.24.help.text
msgid "Presentation always on top"
msgstr "Շնորհանդեսը միշտ առջևում է"

#: 06080000.xhp#par_id3150764.25.help.text
#: 06080000.xhp%23par_id3150764.25.help.text
msgid ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_ALWAYS_ON_TOP\">The "
"$[officename] window remains on top during the presentation. No other "
"program will show its window in front of your presentation.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:DLG_START_PRESENTATION:CBX_ALWAYS_ON_TOP\""
">$[officename] պատուհանը շնորհանդեսի ընթացքում մնում է վերևում: Ոչ մի այլ "
"ծրագիր չի ցուցադրի իր պատուհանը ձեր շնորհանդեսի առջևում:</ahelp>"

#: 06080000.xhp#hd_id6086611.help.text
#: 06080000.xhp%23hd_id6086611.help.text
msgid "Multiple Monitors"
msgstr "Բազմակի պաստառներ"

#: 06080000.xhp#par_id5446943.help.text
#: 06080000.xhp%23par_id5446943.help.text
msgid ""
"By default the primary monitor is used for slide show mode. If the current "
"desktop is displayed on more than one monitor, you can select which monitor "
"to use for full screen slide show mode. If the current desktop spans only "
"one monitor, or if the multi monitor feature is not supported on the current "
"system, you cannot select another monitor."
msgstr ""
"Լռելյայն, հիմնական պաստառը օգտագործվում է սահիկների ցուցադրման վիճակի համար: "
"Եթե ներկայիս աշխատասեղանը ցուցադրվում է մեկից ավելի պաստառների վրա, ապա "
"կարող եք ընտրել, թե որ պաստառը օգտագործել լրիվ պաստառով սահիկի ցուցադրման "
"վիճակում: Եթե ներկայիս աշխատասեղանը տարածվում է միայն մեկ պաստառի վրա, կամ "
"եթե բազմապաստառ հատկությունը չի ապահովվում ընթացիկ համակարգում, ապա դուք չեք "
"կարող ընտրել մեկ այլ պաստառ:"

#: 06080000.xhp#hd_id4962309.help.text
#: 06080000.xhp%23hd_id4962309.help.text
msgid "Presentation Monitor"
msgstr "Շնորհանդեսային պաստառ"

#: 06080000.xhp#par_id5168919.help.text
#: 06080000.xhp%23par_id5168919.help.text
msgid ""
"<ahelp hid=\".\">Select a monitor to use for full screen slide show "
"mode.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Ընտրեք մոնիտորը՝ ամբողջ պաստառով սահիկի ներկայացման վիճակի "
"համար:</ahelp>"

#: 06080000.xhp#par_id4846339.help.text
#: 06080000.xhp%23par_id4846339.help.text
msgid ""
"If the system allows to span a window over all available monitors, you can "
"also select \"All monitors\". In this case the presentation spans over all "
"available monitors. "
msgstr ""
"Եթե համակարգը թույլ է տալիս պատուհանը բացել բոլոր մատչելի մոնիտորների վրա, "
"կարող եք նաև ընտրել «Բոլոր մոնիտորները»: Այս դեպքում ներկայացումը տարածվում "
"է առկա բոլոր մոնիտորների վրա:"

#: 06080000.xhp#par_id2321543.help.text
#: 06080000.xhp%23par_id2321543.help.text
msgid ""
"This setting is saved in the user configuration and not inside the document."
msgstr ""
"Այս կարգաբերումը պահվում է օգտագործողի կազմաձևում և ոչ թե փաստաթղթի ներսում:"

#: 13050700.xhp#tit.help.text
#: 13050700.xhp%23tit.help.text
msgid "To Contour "
msgstr "Դեպի Ուրվագիծ "

#: 13050700.xhp#bm_id3146119.help.text
#: 13050700.xhp%23bm_id3146119.help.text
msgid ""
"<bookmark_value>converting; to "
"contours</bookmark_value><bookmark_value>contours; converting "
"to</bookmark_value>"
msgstr ""
"<bookmark_value>ձևափոխում; "
"ուրվագծերի</bookmark_value><bookmark_value>ուրվագծեր; "
"ձևափոխում</bookmark_value>"

#: 13050700.xhp#hd_id3146119.1.help.text
#: 13050700.xhp%23hd_id3146119.1.help.text
msgid ""
"<link href=\"text/simpress/01/13050700.xhp\" name=\"To Contour\">To "
"Contour</link>"
msgstr ""
"<link href=\"text/simpress/01/13050700.xhp\" name=\"Դեպի Ուրվագիծ\">Դեպի "
"Ուրվագիծr</link>"

#: 13050700.xhp#par_id3146974.2.help.text
#: 13050700.xhp%23par_id3146974.2.help.text
msgid ""
"<ahelp hid=\".uno:convert_to_contour\">Converts the selected object to a "
"polygon, or a group of polygons.</ahelp> If the conversion creates a group "
"of polygons (for example, when you convert a text object), then press F3 to "
"enter the group before you can select an individual polygon."
msgstr ""
"<ahelp hid=\".uno:convert_to_contour\">Ընտրված օբյեկտը վերափոխում է "
"բազմանկյունի կամ բազմանկյունների խմբի:</ahelp> Եթե փոխակերպման արդյունքում "
"ստեղծվում է բազմանկյունների խումբ (օրինակ՝ երբ տեքստային օբյեկտ եք փոխարկում)"
", ապա սեղմեք F3՝ խումբ մտնելու համար նախքան կկարողանաք ընտրել առանձին "
"բազմանկյուն:"

#: 13050700.xhp#par_id3155601.3.help.text
#: 13050700.xhp%23par_id3155601.3.help.text
msgid ""
"Once you convert a line or a text object to a contour, you can no longer "
"edit it as you normally would. Instead, you can edit the contour as you "
"would any polygon, including using the <emph>Edit – Points </emph>command to "
"adjust its shape."
msgstr ""
"Գիծը կամ տեքստային առարկան ուրվագիծ դարձնելուն պես այլևս չեք կարող խմբագրել "
"այն, ինչպես սովորաբար անում եք: Փոխարենը, կարող եք խմբագրել ուրվագիծը ինչպես "
"ցանկացած բազմանկյուն, ներառյալ <emph>Խմբագրել - Կետեր </emph> հրամանը՝ դրա "
"ձևը կարգավորելու համար:"

#: 03090000.xhp#tit.help.text
#: 03090000.xhp%23tit.help.text
msgid "Outline"
msgstr "Եզրագիծ"

#: 03090000.xhp#bm_id3149664.help.text
#: 03090000.xhp%23bm_id3149664.help.text
msgid ""
"<bookmark_value>outline view</bookmark_value><bookmark_value>editing;slide "
"titles</bookmark_value>"
msgstr ""
"<bookmark_value>եզրագծի տեսք</bookmark_value><bookmark_value>խմբագրել;սահիկի "
"վերնագրեր</bookmark_value>"

#: 03090000.xhp#hd_id3149664.1.help.text
#: 03090000.xhp%23hd_id3149664.1.help.text
msgid ""
"<link href=\"text/simpress/01/03090000.xhp\" name=\"Outline\">Outline</link>"
msgstr ""
"<link href=\"text/simpress/01/03090000.xhp\" name=\"Եզրագիծ\">Եզրագիծ</link>"

#: 03090000.xhp#par_id3152597.2.help.text
#: 03090000.xhp%23par_id3152597.2.help.text
msgid ""
"<ahelp hid=\"HID_SD_BTN_OUTLINE\">Switches to outline view where you can "
"reorder slides and edit slide titles and headings.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_SD_BTN_OUTLINE\">Փոխարկում է ուրվագծի տեսքին, որտեղ կարող "
"եք դասավորել սահիկները և խմբագրել սահիկների վերնագրերը</ahelp>"

#: 03090000.xhp#par_id3150715.3.help.text
#: 03090000.xhp%23par_id3150715.3.help.text
msgid ""
"The <emph>Text Formatting</emph> bar contains the following icons for slide "
"titles:<link href=\"text/shared/02/06060000.xhp\" name=\"Promote\""
">Promote</link>, <link href=\"text/shared/02/06050000.xhp\" name=\"Demote\""
">Demote</link>, <link href=\"text/shared/02/06100000.xhp\" name=\"Move Up\">"
"Move Up</link> and <link href=\"text/shared/02/06110000.xhp\" name=\"Move "
"Down\">Move Down</link>. If you want to reorder slide titles with the "
"keyboard, ensure that the cursor is at the beginning of a title and press <"
"item type=\"keycode\">Tab</item> to move the title one level lower in the "
"hierarchy. To move the title up one level, press <item type=\"keycode\""
">Shift+Tab</item>."
msgstr ""
"<emph>Տեքստի ձևաչափում</emph> վահանակը պարունակում է հետևյալ պատկերակները "
"սահիկի վերնագրերի համար:<link href=\"text/shared/02/06060000.xhp\" name=\""
"Խթանել\">Խթանել</link>, <link href=\"text/shared/02/06050000.xhp\" name=\""
"Իջեցնել\">Իջեցնել</link>, <link href=\"text/shared/02/06100000.xhp\" name=\""
"Վերև շարժվեք\">Վերև շարժվեք</link> and <link href=\"text/shared/02/06110000."
"xhp\" name=\"Ներքև շարժվեք\">Ներքև շարժվեք</link>։ Եթե ցանկանում եք սահիկի "
"վերնագրերը վերադասավորել ստեղնաշարի միջոցով, համոզվեք, որ կուրսորը վերնագրի "
"սկզբում է և սեղմեք <item type=\"keycode\">Tab</item> վերնագիրը "
"աստիճանակարգումում մեկ մակարդակով ցածր տեղափոխելու համար: Վերնագիրը մեկ "
"աստիճանով վեր բարձրացնելու համար սեղմեք <item type=\"keycode\""
">Shift+Tab</item>։"

#: 03090000.xhp#par_id3156382.4.help.text
#: 03090000.xhp%23par_id3156382.4.help.text
msgid ""
"The upper outline level corresponds to slide titles, and the lower levels "
"correspond to the headings on a slides."
msgstr ""
"Ուրվագծի վերին մակարդակը համապատասխանում է սահիկի վերնագրերին, իսկ ստորին "
"մակարդակները համապատասխանում են սահիկների խորագրերին:"

#: 03100000.xhp#tit.help.text
#: 03100000.xhp%23tit.help.text
msgid "Slide Sorter"
msgstr "Սահիկի տեսակավորող"

#: 03100000.xhp#hd_id3146974.1.help.text
#: 03100000.xhp%23hd_id3146974.1.help.text
msgid ""
"<link href=\"text/simpress/01/03100000.xhp\" name=\"Slide Sorter\">Slide "
"Sorter</link>"
