"image in the animation sequence.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_IMAGEBUTTON_FLT_WIN_ANIMATION_BTN_LAST\">Անցում է անիմացիայի "
"հաջորդականության վերջին պատկերին:</ahelp>"

#: 06050000.xhp#par_id3153932.help.text
#: 06050000.xhp%23par_id3153932.help.text
msgid ""
"<image id=\"img_id3145593\" src=\"res/helpimg/right2.png\" width=\"0.2189in\""
" height=\"0.1874in\"><alt id=\"alt_id3145593\">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3145593\" src=\"res/helpimg/right2.png\" width=\"0.2189in\""
