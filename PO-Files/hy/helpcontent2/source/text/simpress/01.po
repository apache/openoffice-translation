"<ahelp hid=\"SD:CHECKBOX:DLG_INSERT_LAYER:CBX_LOCKED\">Prevent elements on "
"the layer from being edited.</ahelp>"
msgstr ""
"<ahelp hid=\"SD:CHECKBOX:DLG_INSERT_LAYER:CBX_LOCKED\">Կանխել շերտի տարրերի "
"խմբագրումը:</ahelp>"

#: 06030000.xhp#tit.help.text
#: 06030000.xhp%23tit.help.text
