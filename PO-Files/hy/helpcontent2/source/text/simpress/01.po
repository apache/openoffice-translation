msgid "Start"
msgstr "Մեկնարկ"

#: 06100000.xhp#par_id3157907.17.help.text
#: 06100000.xhp%23par_id3157907.17.help.text
msgid ""
"<ahelp hid=\"SD_PUSHBUTTON_DLG_CUSTOMSHOW_BTN_STARTSHOW\">Runs the slide "
"show. Ensure that <emph>Use Custom Slide Show</emph> is selected if you want "
"to run a custom presentation.</ahelp>"
msgstr ""
"<ahelp hid=\"SD_PUSHBUTTON_DLG_CUSTOMSHOW_BTN_STARTSHOW\">Կատարում է սահիկի "
"ցուցադրությունը: Համոզվեք, որ ընտրված է <emph>Օգտագործեք սահիկների անհատական "
"ցուցադրությունը</emph>, եթե ցանկանում եք գործարկել անհատականացված "
"շնորհանդես:</ahelp>"

#: 04080100.xhp#tit.help.text
#: 04080100.xhp%23tit.help.text
