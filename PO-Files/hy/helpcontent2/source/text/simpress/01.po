"<image id=\"img_id3148768\" src=\"sd/res/get1obj.png\" width=\"0.1665in\" "
"height=\"0.1665in\"><alt id=\"alt_id3148768\">Պատկերակ</alt></image>"

#: 06050000.xhp#par_id3150268.79.help.text
#: 06050000.xhp%23par_id3150268.79.help.text
msgctxt "06050000.xhp#par_id3150268.79.help.text"
msgid "Apply Object"
msgstr "Կիրառեք օբյեկտը"

