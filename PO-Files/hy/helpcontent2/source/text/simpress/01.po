#: 04130000.xhp#par_id3154319.2.help.text
#: 04130000.xhp%23par_id3154319.2.help.text
msgid ""
"<ahelp hid=\".uno:ExpandPage\">Creates a new slide from every top-level "
"outline point (text one level below the title text in the outline hierarchy) "
"in the selected slide. The outline text becomes the title of the new "
"slide.</ahelp> Outline points below the top level on the original slide are "
"moved up one level on the new slide."
msgstr ""

#: 04130000.xhp#par_id3146972.3.help.text
#: 04130000.xhp%23par_id3146972.3.help.text
msgid ""
"You can only use the <emph>Expand Slide </emph>command if your slide layout "
"contains a title object and an outline object."
msgstr ""

#: 04130000.xhp#par_id3149019.4.help.text
#: 04130000.xhp%23par_id3149019.4.help.text
msgid ""
"If you want to keep the original slide, choose <emph>Edit - Undo</emph>."
msgstr ""

