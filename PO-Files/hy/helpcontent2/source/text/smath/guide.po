msgstr "Կարող եք վերահսկել $[officename] Math -ը առանց մկնիկի։"

#: keyboard.xhp#hd_id3150343.2.help.text
#: keyboard.xhp%23hd_id3150343.2.help.text
msgid "Inserting a Formula Directly"
msgstr "Բանաձևի ուղղակի տեղադրում"

#: keyboard.xhp#par_id3154659.3.help.text
#: keyboard.xhp%23par_id3154659.3.help.text
msgid ""
"If you want to insert a formula into a text document, and you already know "
"the correct writing, you can proceed as follows:"
msgstr ""
"Եթե ցանկանում եք բանաձև տեղադրել տեքստային փաստաթղթում, և արդեն գիտեք ճիշտ "
"գրելը, կարող եք վարվել հետևյալ կերպ."

#: keyboard.xhp#par_id3153818.4.help.text
#: keyboard.xhp%23par_id3153818.4.help.text
msgid "Write the formula into your text"
msgstr "Գրիր բանաձևը քո տեքստի մեջ"

#: keyboard.xhp#par_id3153915.5.help.text
#: keyboard.xhp%23par_id3153915.5.help.text
msgid "Select the formula"
msgstr "Ընտրել բանաձևը"

#: keyboard.xhp#par_id3150213.6.help.text
#: keyboard.xhp%23par_id3150213.6.help.text
