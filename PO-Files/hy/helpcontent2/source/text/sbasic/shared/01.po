#: 06130100.xhp#par_id3150276.2.help.text
#: 06130100.xhp%23par_id3150276.2.help.text
msgid ""
"<ahelp hid=\"HID_PASSWORD\">Protects the selected library with a "
"password.</ahelp> You can enter a new password, or change the current "
"password."
msgstr ""
"<ahelp hid=\"HID_PASSWORD\">Ընտրված գրադարանը պաշտպանում է "
"գաղտնաբառով:</ahelp> Կարող եք մուտքագրել նոր գաղտնաբառ կամ փոխել ընթացիկ "
"գաղտնաբառը:"

#: 06130100.xhp#hd_id3154285.3.help.text
#: 06130100.xhp%23hd_id3154285.3.help.text
msgid "Old password"
msgstr "Հին գաղտնաբառը"

#: 06130100.xhp#hd_id3153665.4.help.text
#: 06130100.xhp%23hd_id3153665.4.help.text
msgctxt "06130100.xhp#hd_id3153665.4.help.text"
msgid "Password"
msgstr "Գաղտնաբառ"

#: 06130100.xhp#par_id3155628.5.help.text
#: 06130100.xhp%23par_id3155628.5.help.text
msgid ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_OLD_PASSWD\">Enter the current "
"password for the selected library.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_OLD_PASSWD\">Մուտքագրեք ընտրված "
"գրադարանի ընթացիկ գաղտնաբառը:</ahelp>"

#: 06130100.xhp#hd_id3153126.6.help.text
#: 06130100.xhp%23hd_id3153126.6.help.text
msgid "New password"
msgstr "Նոր գաղտնաբառ։"

#: 06130100.xhp#hd_id3153628.7.help.text
#: 06130100.xhp%23hd_id3153628.7.help.text
msgctxt "06130100.xhp#hd_id3153628.7.help.text"
msgid "Password"
msgstr "Գաղտնաբառ"

#: 06130100.xhp#par_id3159413.8.help.text
#: 06130100.xhp%23par_id3159413.8.help.text
msgid ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_NEW_PASSWD\">Enter a new "
"password for the selected library.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_NEW_PASSWD\">Մուտքագրեք ընտրված "
"գրադարանի նոր գաղտնաբառը:</ahelp>"

#: 06130100.xhp#hd_id3148947.9.help.text
#: 06130100.xhp%23hd_id3148947.9.help.text
msgid "Confirm"
msgstr "Հաստատել"

#: 06130100.xhp#par_id3149457.10.help.text
#: 06130100.xhp%23par_id3149457.10.help.text
msgid ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_REPEAT_PASSWD\">Repeat the new "
"password for the selected library.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_REPEAT_PASSWD\">Ընտրված "
"գրադարանի համար կրկնեք նոր գաղտնաբառը:</ahelp>"

#: 06130000.xhp#tit.help.text
#: 06130000.xhp%23tit.help.text
msgctxt "06130000.xhp#tit.help.text"
msgid "Macro"
msgstr "Մակրո"

#: 06130000.xhp#bm_id3145786.help.text
#: 06130000.xhp%23bm_id3145786.help.text
msgid ""
"<bookmark_value>macros; Basic IDE</bookmark_value><bookmark_value>Basic IDE; "
"macros</bookmark_value>"
msgstr ""
"<bookmark_value>macros; Basic IDE</bookmark_value><bookmark_value>Basic IDE; "
"macros</bookmark_value>"

#: 06130000.xhp#hd_id3145786.1.help.text
#: 06130000.xhp%23hd_id3145786.1.help.text
msgctxt "06130000.xhp#hd_id3145786.1.help.text"
msgid "Macro"
msgstr "Մակրո"

#: 06130000.xhp#par_id3152886.2.help.text
#: 06130000.xhp%23par_id3152886.2.help.text
msgid ""
"<variable id=\"makro\"><ahelp hid=\".\">Opens the <emph>Macro </emph>dialog, "
"where you can create, edit, organize, and run $[officename] Basic "
"macros.</ahelp></variable>"
msgstr ""
"<variable id=\"makro\"><ahelp hid=\".\">Բացում է <emph>Macro </emph>"
"երկխոսությունը, որում կարող ես ստեղծել, խմբագրել, կազմակերպել, և կատարել "
"$[officename] Basic մակրոները։</ahelp></variable>"

#: 06130000.xhp#hd_id3154145.3.help.text
#: 06130000.xhp%23hd_id3154145.3.help.text
msgid "Macro name"
msgstr "Մակրոյի անունը"

#: 06130000.xhp#par_id3151116.4.help.text
#: 06130000.xhp%23par_id3151116.4.help.text
msgid ""
"<ahelp hid=\"BASCTL_EDIT_RID_MACROCHOOSER_RID_ED_MACRONAME\">Displays the "
"name of the selected macro. To create or to change the name of a macro, "
"enter a name here.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_EDIT_RID_MACROCHOOSER_RID_ED_MACRONAME\">Արտածում է "
"ընտրված մակրոյի անունը: Մակրոյի անունը ստեղծելու կամ փոխելու համար, "
"մուտքագրեք անունն այստեղ:</ahelp>"

#: 06130000.xhp#hd_id3153729.7.help.text
#: 06130000.xhp%23hd_id3153729.7.help.text
msgid "Macro from / Save macro in"
msgstr "Macro from / Save macro in"

#: 06130000.xhp#par_id3153190.8.help.text
#: 06130000.xhp%23par_id3153190.8.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_LIBS\">Lists the libraries and the modules where "
"you can open or save your macros. To save a macro with a particular "
"document, open the document, and then open this dialog.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_BASICIDE_LIBS\">Թվարկում է գրադարաններն ու մոդուլները, "
"որոնցում կարող եք բացել կամ պահպանել ձեր մակրոները: Որոշակի փաստաթղթով "
"մակրոն պահպանելու համար բացեք փաստաթուղթը, ապա բացեք այս "
"երկխոսությունը:</ahelp>"

#: 06130000.xhp#hd_id3146975.11.help.text
#: 06130000.xhp%23hd_id3146975.11.help.text
msgid "Run / Save"
msgstr "Կատարել / Հիշել"

#: 06130000.xhp#par_id3154791.12.help.text
#: 06130000.xhp%23par_id3154791.12.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_RUN\">Runs or saves "
"the current macro.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_RUN\">Կատարում կամ "
"հիշում է ընթացիկ մակրոն։</ahelp>"

#: 06130000.xhp#hd_id3153158.15.help.text
#: 06130000.xhp%23hd_id3153158.15.help.text
msgid "Assign"
msgstr "Նշանակել"

#: 06130000.xhp#par_id3149961.16.help.text
#: 06130000.xhp%23par_id3149961.16.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ASSIGN\">Opens the "
"Customize dialog, where you can assign the selected macro to a menu command, "
"a toolbar, or an event.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ASSIGN\">Բացվում է "
"«Անհատականացնել» երկխոսությունը, որտեղ կարող եք ընտրված մակրոն նշանակել "
"ընտրացանկի հրամանին, գործիքագոտուն կամ իրադարձությանը:</ahelp>"

#: 06130000.xhp#hd_id3145799.17.help.text
#: 06130000.xhp%23hd_id3145799.17.help.text
msgctxt "06130000.xhp#hd_id3145799.17.help.text"
msgid "Edit"
msgstr "Խմբագրել"

#: 06130000.xhp#par_id3147127.18.help.text
#: 06130000.xhp%23par_id3147127.18.help.text
msgid ""
"<ahelp hid=\".\">Starts the $[officename] Basic editor and opens the "
"selected macro for editing.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Սկսում է $[officename] Basic խմբագրիչը, և բացում է ընտրված "
"մակրոն խնբագման համար։</ahelp>"

#: 06130000.xhp#hd_id3149400.19.help.text
#: 06130000.xhp%23hd_id3149400.19.help.text
msgid "New/Delete"
msgstr "Նոր/Ջնջել"

#: 06130000.xhp#par_id3155602.61.help.text
#: 06130000.xhp%23par_id3155602.61.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_DEL\">Creates a new "
"macro, or deletes the selected macro.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_DEL\">Ստեղծում է նոր "
"մակրո, կամ ջնջում է ընտրված մակրոն։</ahelp>"

#: 06130000.xhp#par_id3149124.20.help.text
#: 06130000.xhp%23par_id3149124.20.help.text
msgid ""
"To create a new macro, select the \"Standard\" module in the <emph>Macro "
"from</emph> list, and then click <emph>New</emph>. "
msgstr ""
"Նոր մակրո ստեղծելու համար, ընտրեք \"Ստանդարտ\" մոդուլը <emph>Մակրոն "
"այստեղից</emph> ցուցակից, այնուհետև կտտացրեք <emph>Նոր</emph>։ "

#: 06130000.xhp#par_id3150749.21.help.text
#: 06130000.xhp%23par_id3150749.21.help.text
msgid "To delete a macro, select it, and then click <emph>Delete</emph>."
msgstr "Մակրոն ջնջելու համար, ընտրեք այն և սեղմեք <emph>Ջնջել</emph>։"

#: 06130000.xhp#hd_id3153764.22.help.text
#: 06130000.xhp%23hd_id3153764.22.help.text
msgid "Organizer"
msgstr "Կազմակերպիչ"

#: 06130000.xhp#par_id3148405.23.help.text
#: 06130000.xhp%23par_id3148405.23.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ORG\">Opens the <emph>"
"Macro Organizer</emph> dialog, where you can add, edit, or delete existing "
"macro modules, dialogs, and libraries.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ORG\">Բացում է <emph>"
"Մակրոյի կազմակերպիչ</emph> երկխոսությունը, որտեղ կարող ես ավելացնել, "
"խմբագրել կամ ջնջել առկա մակրոյի մոդուլները, երկխոսությունները և "
"գրադարանները։</ahelp>"

#: 06130000.xhp#hd_id3166447.29.help.text
#: 06130000.xhp%23hd_id3166447.29.help.text
msgid "Module/Dialog"
msgstr "Մոդուլ/երկխոսություն"

#: 06130000.xhp#par_id3155959.30.help.text
#: 06130000.xhp%23par_id3155959.30.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_MODULES_TREE\">Lists the existing macros and "
"dialogs.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_BASICIDE_MODULES_TREE\">Թվարկում է առկա մակրոները և "
"երկխոսությունները։</ahelp>"

#: 06130000.xhp#par_id3149922.31.help.text
#: 06130000.xhp%23par_id3149922.31.help.text
msgid "You can drag-and-drop a module or a dialog between libraries."
msgstr "Կարող եք քաշել և թողնել մոդուլը կամ գրադարանների միջև երկխոսությունը:"

#: 06130000.xhp#par_id3159333.33.help.text
#: 06130000.xhp%23par_id3159333.33.help.text
msgid ""
"To copy a dialog or a module, hold down the <switchinline select=\"sys\"><"
"caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline> key "
"while you drag-and-drop."
msgstr ""
"Երկխոսությունը կամ մոդուլը պատճենելու համար պահեք այն <switchinline select=\""
"sys\"><caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline> "
"ստեղնը, մինչ դու ձգում-և-քաշում ես։"

#: 06130000.xhp#hd_id3147131.34.help.text
#: 06130000.xhp%23hd_id3147131.34.help.text
msgctxt "06130000.xhp#hd_id3147131.34.help.text"
msgid "Edit"
msgstr "Խմբագրել"

#: 06130000.xhp#par_id3149816.35.help.text
#: 06130000.xhp%23par_id3149816.35.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_EDIT\">Opens the "
"selected macro or dialog for editing.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_EDIT\">Խմբագրման համար "
"բացում է ընտրված մակրոն կամ երկխոսությունը։</ahelp>"

#: 06130000.xhp#hd_id3151214.36.help.text
#: 06130000.xhp%23hd_id3151214.36.help.text
msgctxt "06130000.xhp#hd_id3151214.36.help.text"
msgid "New"
msgstr "Նոր"

#: 06130000.xhp#par_id3154202.37.help.text
#: 06130000.xhp%23par_id3154202.37.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWMOD\">Creates a new "
"module.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWMOD\">Ստեղծում է նոր "
"մոդուլը։</ahelp>"

#: 06130000.xhp#par_id3153269.40.help.text
#: 06130000.xhp%23par_id3153269.40.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWDLG\">Creates a new "
"dialog.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWDLG\">Ստեղծում է նոր "
"երկխոսություն։</ahelp>"

#: 06130000.xhp#hd_id3154587.42.help.text
#: 06130000.xhp%23hd_id3154587.42.help.text
msgid "Libraries tab page"
msgstr "Գրադարանների ներդիրի էջը"

#: 06130000.xhp#par_id3153705.43.help.text
#: 06130000.xhp%23par_id3153705.43.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWDLG\">Lets you manage "
"the macro libraries.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWDLG\">Թույլ է տալիս "
"կառավարել մակրո գրադարանները։</ahelp>"

#: 06130000.xhp#hd_id3145259.44.help.text
#: 06130000.xhp%23hd_id3145259.44.help.text
msgid "Location"
msgstr "Տեղակայություն"

#: 06130000.xhp#par_id3153234.45.help.text
#: 06130000.xhp%23par_id3153234.45.help.text
msgid ""
"<ahelp hid=\"BASCTL_LISTBOX_RID_TP_LIBS_RID_LB_BASICS\">Select the location "
"containing the macro libraries that you want to organize.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_LISTBOX_RID_TP_LIBS_RID_LB_BASICS\">Ընտրեք "
"տեղակայությունը, որը պարունակում է մակրո գրադարանները, որոնք ցանկանում եք "
"կազմակերպել։</ahelp>"

#: 06130000.xhp#hd_id3148460.46.help.text
#: 06130000.xhp%23hd_id3148460.46.help.text
msgid "Library"
msgstr "Գրադարան"

#: 06130000.xhp#par_id3150828.47.help.text
#: 06130000.xhp%23par_id3150828.47.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_LIBS_TREE\">Lists the macro libraries in the "
"chosen location.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_BASICIDE_LIBS_TREE\">Ընտրված տեղակայությունում թվարկում է "
"մակրո գրադարանները։</ahelp>"

#: 06130000.xhp#hd_id3145134.48.help.text
#: 06130000.xhp%23hd_id3145134.48.help.text
msgctxt "06130000.xhp#hd_id3145134.48.help.text"
msgid "Edit"
msgstr "Խմբագրել"

#: 06130000.xhp#par_id3150518.49.help.text
#: 06130000.xhp%23par_id3150518.49.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_EDIT\">Opens the "
"$[officename] Basic editor so that you can modify the selected "
"library.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_EDIT\">Բացում է "
"$[officename] Basic խմբագրիչը, որպեսզի կարողանաք ձևափոխել ընտրված "
"գրադարանը:</ahelp>"

#: 06130000.xhp#hd_id3150371.50.help.text
#: 06130000.xhp%23hd_id3150371.50.help.text
msgctxt "06130000.xhp#hd_id3150371.50.help.text"
