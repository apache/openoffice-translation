#: graphic_insert.xhp#tit.help.text
#: graphic_insert.xhp%23tit.help.text
msgid "Inserting Graphics"
msgstr "Գրաֆիկների ներդնում"

#: graphic_insert.xhp#bm_id3156443.help.text
#: graphic_insert.xhp%23bm_id3156443.help.text
msgid ""
"<bookmark_value>pictures; inserting</bookmark_value><bookmark_value>images; "
"inserting</bookmark_value><bookmark_value>files; inserting "
"pictures</bookmark_value><bookmark_value>inserting;pictures</bookmark_value>"
msgstr ""
"<bookmark_value>նկարներ; ներդրում</bookmark_value><bookmark_value>պատկերներ; "
"ներդրում</bookmark_value><bookmark_value>նիշքեր; նկարների "
"ներդրում</bookmark_value><bookmark_value>ներդրում;նկարներ</bookmark_value>"

#: graphic_insert.xhp#hd_id3156443.1.help.text
#: graphic_insert.xhp%23hd_id3156443.1.help.text
msgid ""
"<variable id=\"graphic_insert\"><link href=\"text/sdraw/guide/graphic_insert."
"xhp\" name=\"Inserting Graphics\">Inserting Pictures</link></variable>"
msgstr ""
"<variable id=\"graphic_insert\"><link href=\"text/sdraw/guide/graphic_insert."
"xhp\" name=\"Գրաֆիկների ներդրում\">Նկարների ներդրում</link></variable>"

#: graphic_insert.xhp#par_id3155600.2.help.text
#: graphic_insert.xhp%23par_id3155600.2.help.text
msgid "Choose <emph>Insert - Picture - From File</emph>."
msgstr "Ընտրեք <emph>Ներդնել - Նկար - Նիշքից</emph>."

#: graphic_insert.xhp#par_id3150749.3.help.text
#: graphic_insert.xhp%23par_id3150749.3.help.text
msgid ""
"Locate the picture you want to insert. Select the <emph>Link</emph> check "
"box to insert only a link to the picture. If you want to see the picture "
"before you insert it, select <emph>Preview</emph>."
msgstr ""
"Տեղորոշեք նկարը, որը ցանկանում եք տեղադրել: Ընտրեք <emph>Հղում</emph> "
"ընտրավանդակը՝ նկարին միայն հղումը տեղադրելու համար: Եթե ցանկանում եք տեսնել "
"նկարը նախքան այն տեղադրելը, ընտրեք <emph>Նախադիտում</emph>."

#: graphic_insert.xhp#par_id3155764.4.help.text
#: graphic_insert.xhp%23par_id3155764.4.help.text
msgid ""
"After you insert a linked picture, do not change the name of the source "
"picture or move the source picture to another directory."
msgstr ""
"Կապակցված նկար տեղադրելուց հետո մի փոխեք սկզբնաղբյուր նկարի անունը կամ մի "
"տեղափոխեք սկզբնաղբյուր նկարը այլ գրացուցակ:"

#: graphic_insert.xhp#par_id3150044.5.help.text
#: graphic_insert.xhp%23par_id3150044.5.help.text
msgid "Click <emph>Open</emph> to insert the picture."
msgstr "Կտտացրեք <emph>Բացել</emph> նկար ներդնելու համար:"

#: gradient.xhp#tit.help.text
#: gradient.xhp%23tit.help.text
msgid "Creating Gradient Fills"
msgstr "Գրադիենտ լցնումների ստեղծում"

#: gradient.xhp#bm_id3150792.help.text
#: gradient.xhp%23bm_id3150792.help.text
msgid ""
"<bookmark_value>gradients; applying and defining</bookmark_value><bookmark_va"
"lue>editing;gradients</bookmark_value><bookmark_value>defining;gradients</boo"
"kmark_value><bookmark_value>custom gradients</bookmark_value><bookmark_value>"
"transparency;adjusting</bookmark_value>"
msgstr ""
"<bookmark_value>գրադիենտներ; կիրառելով և "
"սահմանելով</bookmark_value><bookmark_value>խմբագրում; "
"գրադիենտներ</bookmark_value><bookmark_value>սահմանել; "
"գրադիենտներ</bookmark_value><bookmark_value>անհատականացված գրադիենտներ</bookm"
"ark_value><bookmark_value>թափանցիկություն;ճշգրտում</bookmark_value>"

#: gradient.xhp#hd_id3150792.3.help.text
#: gradient.xhp%23hd_id3150792.3.help.text
msgid ""
"<variable id=\"gradient\"><link href=\"text/sdraw/guide/gradient.xhp\" name="
"\"Creating Gradient Fills\">Creating Gradient Fills</link> </variable>"
msgstr ""
"<variable id=\"gradient\"><link href=\"text/sdraw/guide/gradient.xhp\" name="
"\"Գրադիենտ լցնումների ստեղծում\">Գրադիենտ լցնումների ստեղծում</link> "
"</variable>"

#: gradient.xhp#par_id3154012.4.help.text
#: gradient.xhp%23par_id3154012.4.help.text
msgid ""
"A gradient fill is an incremental blend of two different colors, or shades "
"of the same color, that you can apply to a drawing object."
msgstr ""
"Գրադիենտ լցնումը երկու տարբեր գույների կամ նույն գույնի երանգների "
"աստիճանական խառնուրդ է, որը կարող եք կիրառել նկարչական օբյեկտի վրա:"

#: gradient.xhp#hd_id3147436.61.help.text
#: gradient.xhp%23hd_id3147436.61.help.text
msgid "To apply a gradient:"
msgstr "Գրադիենտ կիրառելու համար"

#: gradient.xhp#par_id3146974.5.help.text
#: gradient.xhp%23par_id3146974.5.help.text
msgid "Select a drawing object."
msgstr "Ընտրեք նկարչական օբյեկտ:"

#: gradient.xhp#par_id3154491.6.help.text
#: gradient.xhp%23par_id3154491.6.help.text
msgid ""
"Choose <emph>Format - Area</emph> and select <emph>Gradient</emph> as the "
"<emph>Fill</emph> type."
msgstr ""
"Ընտրեք <emph>Ձևաչափ - Տարածք</emph> ապա ընտրեք <emph>Գրադիենտ</emph> որպես "
"<emph>Լցման</emph> տեսակ:"

#: gradient.xhp#par_id3153415.7.help.text
#: gradient.xhp%23par_id3153415.7.help.text
msgid "Select a gradient style from the list and click <emph>OK</emph>."
msgstr "Ցանկից ընտրեք գրադիենտի ոճը և սեղմեք <emph>ԼԱՎ</emph>."

#: gradient.xhp#hd_id3154702.8.help.text
#: gradient.xhp%23hd_id3154702.8.help.text
msgid "Creating Custom Gradients"
msgstr "Անհատականացված գրադիենտների ստեղծում"

#: gradient.xhp#par_id3145791.9.help.text
#: gradient.xhp%23par_id3145791.9.help.text
msgid ""
"You can define your own gradients and modify existing gradients, as well as "
"save and load a list of gradient files."
msgstr ""
"Դուք կարող եք սահմանել ձեր սեփական գրադիենտները և փոփոխել առկա գրադիենտները, "
"ինչպես նաև պահպանել և բեռնել գրադիենտ նիշքերի ցանկը:"

#: gradient.xhp#hd_id3145384.62.help.text
#: gradient.xhp%23hd_id3145384.62.help.text
msgid "To create a custom gradient:"
msgstr "Անհատականացված գրադիենտ ստեղծելու համար."

#: gradient.xhp#par_id3151242.11.help.text
#: gradient.xhp%23par_id3151242.11.help.text
msgctxt "gradient.xhp#par_id3151242.11.help.text"
msgid ""
"Choose <emph>Format - Area</emph> and click the <emph>Gradients</emph> tab."
msgstr ""
"Ընտրեք <emph>Ձևաչափ - Տարածք</emph> և կտտացրեք <emph>Գրադիենտներ</emph> "
"ներդիրը:"

#: gradient.xhp#par_id3150046.12.help.text
#: gradient.xhp%23par_id3150046.12.help.text
msgid ""
"Select a gradient from the list to use as the basis for your new gradient "
"and click <emph>Add</emph>."
msgstr ""
"Ցանկից ընտրեք գրադիենտ, որը կօգտագործվի որպես հիմք ձեր նոր գրադիենտի համար և "
"սեղմեք <emph>Ավելացնել</emph>."

#: gradient.xhp#par_id3145116.13.help.text
#: gradient.xhp%23par_id3145116.13.help.text
msgid "Type a name for the gradient in the text box and click <emph>OK</emph>."
msgstr ""
"Մուտքագրեք գրադիենտի անունը տեքստային վանդակում և սեղմեք <emph>ԼԱՎ</emph>."

#: gradient.xhp#par_id6535843.help.text
#: gradient.xhp%23par_id6535843.help.text
msgid ""
"The name appears at the end of the gradient list and is selected for editing."
msgstr ""
"Անունը հայտնվում է գրադիենտ ցուցակի վերջում և ընտրվում է խմբագրման համար:"

#: gradient.xhp#par_id3150391.15.help.text
#: gradient.xhp%23par_id3150391.15.help.text
msgid ""
"Set the gradient properties and click <emph>Modify</emph> to save the "
"gradient."
msgstr ""
"Սահմանեք գրադիենտի հատկությունները և սեղմեք <emph>Փոփոխել</emph>՝ գրադիենտը "
"պահպանելու համար:"

#: gradient.xhp#par_id3156396.16.help.text
#: gradient.xhp%23par_id3156396.16.help.text
msgid "Click <emph>OK.</emph> "
msgstr "Սեղմեք <emph>ԼԱՎ.</emph> "

#: gradient.xhp#hd_id3149947.40.help.text
#: gradient.xhp%23hd_id3149947.40.help.text
msgid "Using Gradients and Transparency"
msgstr "Օգտագործելով գրադիենտներ և թափանցիկություն"

#: gradient.xhp#par_id3157905.41.help.text
#: gradient.xhp%23par_id3157905.41.help.text
msgid ""
"You can adjust the properties of a gradient as well as the transparency of a "
"drawing object with your mouse."
msgstr ""
"Դուք կարող եք կարգավորել գրադիենտի հատկությունները, ինչպես նաև նկարչական "
"օբյեկտի թափանցիկությունը ձեր մկնիկի օգնությամբ:"

#: gradient.xhp#hd_id3150653.63.help.text
#: gradient.xhp%23hd_id3150653.63.help.text
msgid "To adjust the gradient of a drawing object:"
msgstr "Նկարչական օբյեկտի գրադիենտը կարգավորելու համար."

#: gradient.xhp#par_id3154844.42.help.text
#: gradient.xhp%23par_id3154844.42.help.text
msgid "Select a drawing object with the gradient that you want to modify."
msgstr "Ընտրեք գծագրության օբյեկտը գրադիենտով, որը ցանկանում եք փոփոխել:"

#: gradient.xhp#par_id3145592.43.help.text
#: gradient.xhp%23par_id3145592.43.help.text
msgctxt "gradient.xhp#par_id3145592.43.help.text"
msgid ""
"Choose <emph>Format - Area</emph> and click the <emph>Gradients</emph> tab."
msgstr ""
"Ընտրեք <emph>Ձևաչափ - Տարածք</emph> և կտտացրեք <emph>Գրադիենտներ</emph> "
"ներդիրը:"

#: gradient.xhp#par_idN107BE.help.text
#: gradient.xhp%23par_idN107BE.help.text
msgid ""
"Adjust the values for the gradient to suit your needs and click "
"<emph>OK</emph>."
msgstr ""
"Կարգավորեք գրադիենտի արժեքները ձեր կարիքներին համապատասխան և սեղմեք "
"<emph>ԼԱՎ</emph>."

#: gradient.xhp#par_id3150659.46.help.text
#: gradient.xhp%23par_id3150659.46.help.text
msgid ""
"To adjust the transparency of an object, select the object, choose <emph>"
"Format - Area</emph> and click the <emph>Transparency</emph> tab."
msgstr ""
"Օբյեկտի թափանցիկությունը կարգավորելու համար ընտրեք օբյեկտը, ընտրեք <emph>"
"Ձևաչափ - Տարածք</emph> և կտտացրեք <emph>Թափանցիկություն</emph> ներդիրը:"

#: join_objects3d.xhp#tit.help.text
#: join_objects3d.xhp%23tit.help.text
msgid "Assembling 3D Objects"
msgstr "3D օբյեկտների հավաքում"

#: join_objects3d.xhp#bm_id3154014.help.text
#: join_objects3d.xhp%23bm_id3154014.help.text
msgid ""
"<bookmark_value>3D objects; assembling</bookmark_value><bookmark_value>"
"assembled objects in 3D</bookmark_value><bookmark_value>combining;3D "
"objects</bookmark_value><bookmark_value>joining;3D objects</bookmark_value>"
msgstr ""
"<bookmark_value>3D առարկաներ; հավաքում</bookmark_value><bookmark_value>"
"հավաքված առարկաներ 3D-ում</bookmark_value><bookmark_value>համատեղում; 3D "
"առարկաներ</bookmark_value><bookmark_value>միացում;3D "
"առարկաներ</bookmark_value>"

#: join_objects3d.xhp#hd_id3156442.29.help.text
#: join_objects3d.xhp%23hd_id3156442.29.help.text
msgid ""
"<variable id=\"join_objects3d\"><link href=\"text/sdraw/guide/join_objects3d."
"xhp\" name=\"Assembling 3D Objects\">Assembling 3D Objects</link></variable>"
msgstr ""
"<variable id=\"join_objects3d\"><link href=\"text/sdraw/guide/join_objects3d."
"xhp\" name=\"3D օբյեկտների հավաքում\">3D օբյեկտների "
"հավաքում</link></variable>"

#: join_objects3d.xhp#par_id3145251.30.help.text
#: join_objects3d.xhp%23par_id3145251.30.help.text
msgid ""
"3D objects that each form a 3D scene can be combined into a single 3D scene."
msgstr ""
"Եռաչափ առարկաները, որոնցից յուրաքանչյուրը ձևավորում է 3D տեսարան, կարելի է "
"միավորել մեկ 3D տեսարանի մեջ:"

#: join_objects3d.xhp#hd_id3150042.41.help.text
#: join_objects3d.xhp%23hd_id3150042.41.help.text
msgid "To combine 3D objects:"
msgstr "3D օբյեկտները համատեղելու համար."

#: join_objects3d.xhp#par_id3154702.31.help.text
#: join_objects3d.xhp%23par_id3154702.31.help.text
msgid ""
"Insert a 3D object from the <emph>3D Objects</emph> toolbar (for example, a "
"cube)."
msgstr ""
"Տեղադրեք 3D օբյեկտ <emph>3D օբյեկտներ</emph> գործիքագոտուց (օրինակ՝ "
"խորանարդ):"

#: join_objects3d.xhp#par_id3155335.32.help.text
#: join_objects3d.xhp%23par_id3155335.32.help.text
msgid "Insert a second slightly larger 3D object (for example, a sphere)."
msgstr "Տեղադրեք երկրորդ մի փոքր ավելի մեծ 3D առարկա (օրինակ՝ գունդ):"

#: join_objects3d.xhp#par_id3148488.33.help.text
#: join_objects3d.xhp%23par_id3148488.33.help.text
msgid ""
"Select the second 3D object (sphere) and choose <emph>Edit - Cut</emph>."
msgstr ""
"Ընտրեք երկրորդ 3D օբյեկտը (գունդ) և ընտրեք <emph>Խմբագրել – Կտրել</emph>."

#: join_objects3d.xhp#par_id3149211.34.help.text
#: join_objects3d.xhp%23par_id3149211.34.help.text
msgid "Double-click the first object (cube) to enter its group."
msgstr ""
"Կրկնակի սեղմեք առաջին օբյեկտի (խորանարդի) վրա՝ դրա խումբը մտնելու համար:"

#: join_objects3d.xhp#par_id3154652.35.help.text
#: join_objects3d.xhp%23par_id3154652.35.help.text
msgid ""
"Choose <emph>Edit - Paste</emph>. Both objects are now part of the same "
"group. If you want, you can edit the individual objects or change their "
"position within the group."
msgstr ""
"Ընտրեք <emph>Խմբագրել – Կպցնել</emph>: Երկու օբյեկտներն էլ այժմ նույն խմբի "
"մաս են կազմում: Եթե ցանկանում եք, կարող եք խմբագրել առանձին օբյեկտները կամ "
"փոխել դրանց դիրքը խմբի ներսում:"

#: join_objects3d.xhp#par_id3155376.36.help.text
#: join_objects3d.xhp%23par_id3155376.36.help.text
msgid "Double-click outside the group to exit the group."
msgstr "Կրկնակի սեղմեք խմբից դուրս՝ խմբից դուրս գալու համար:"

#: join_objects3d.xhp#par_id3148606.38.help.text
#: join_objects3d.xhp%23par_id3148606.38.help.text
msgid "You cannot intersect or subtract 3D objects."
msgstr "Դուք չեք կարող հատել կամ հանել 3D օբյեկտները:"

#: join_objects3d.xhp#par_id3154537.39.help.text
#: join_objects3d.xhp%23par_id3154537.39.help.text
msgid ""
"<link href=\"text/simpress/02/10090000.xhp\" name=\"Objects in 3D\">Objects "
"in 3D</link>"
msgstr ""
"<link href=\"text/simpress/02/10090000.xhp\" name=\"Օբյեկտներ 3D\">Օբյեկտներ "
"3D</link>"

#: align_arrange.xhp#tit.help.text
#: align_arrange.xhp%23tit.help.text
msgid "Arranging, Aligning and Distributing Objects"
msgstr "Օբյեկտների դասավորություն, հավասարեցում և բաշխում"

#: align_arrange.xhp#hd_id3149656.73.help.text
#: align_arrange.xhp%23hd_id3149656.73.help.text
msgid ""
"<variable id=\"align_arrange\"><link href=\"text/sdraw/guide/align_arrange."
"xhp\" name=\"Arranging and Aligning Objects\">Arranging, Aligning and "
"Distributing Objects</link></variable>"
msgstr ""
"<variable id=\"align_arrange\"><link href=\"text/sdraw/guide/align_arrange."
"xhp\" name=\"Օբյեկտների դասավորություն և հավասարեցում\">Օբյեկտների "
"դասավորություն, հավասարեցում և բաշխում</link></variable>"

#: align_arrange.xhp#bm_id3125863.help.text
#: align_arrange.xhp%23bm_id3125863.help.text
msgid ""
"<bookmark_value>arranging; objects (guide)</bookmark_value><bookmark_value>ob"
"jects;aligning</bookmark_value><bookmark_value>distributing draw "
"objects</bookmark_value><bookmark_value>aligning;draw "
"objects</bookmark_value>"
msgstr ""
"<bookmark_value>դասավորություն; առարկաներ (ուղեցույց)</bookmark_value><bookma"
"rk_value>առարկաներ;հավասարեցում</bookmark_value><bookmark_value>նկարչության "
"առարկաների բաշխում</bookmark_value><bookmark_value>հավասարեցում;նկարել "
"առարկաներ</bookmark_value>"

#: align_arrange.xhp#hd_id3125863.17.help.text
#: align_arrange.xhp%23hd_id3125863.17.help.text
msgid "Arranging Objects"
msgstr "Օբյեկտների դասավորություն"

#: align_arrange.xhp#par_id3153727.18.help.text
#: align_arrange.xhp%23par_id3153727.18.help.text
msgid ""
"Each object that you place in your document is successively stacked on the "
"preceding object. To re-arrange the stacking order of a selected object, "
"proceed as follows."
msgstr ""
"Յուրաքանչյուր առարկա, որը տեղադրում եք ձեր փաստաթղթում, հաջորդաբար դրվում է "
"նախորդ օբյեկտի վրա: Ընտրված օբյեկտի կուտակման կարգը վերադասավորելու համար "
"կատարեք հետևյալը."

#: align_arrange.xhp#par_idN107D5.help.text
#: align_arrange.xhp%23par_idN107D5.help.text
msgctxt "align_arrange.xhp#par_idN107D5.help.text"
msgid "Click the object whose position you want to change."
msgstr "Կտտացրեք այն օբյեկտին, որի դիրքը ցանկանում եք փոխել:"

#: align_arrange.xhp#par_id3150327.78.help.text
#: align_arrange.xhp%23par_id3150327.78.help.text
msgid ""
"Choose <item type=\"menuitem\">Modify - Arrange</item> to bring up the "
"context menu and choose one of the arrange options:"
msgstr ""
"Ընտրեք <item type=\"menuitem\">Փոփոխել – Դասավորել</item> համատեքստային "
"ընտրացանկը բերելու համար և ընտրել դասավորության տարբերակներից մեկը."

#: align_arrange.xhp#par_idN107E6.help.text
#: align_arrange.xhp%23par_idN107E6.help.text
msgid ""
"<emph>Bring to Front</emph> places the object on top of all other objects"
msgstr "<emph>Առաջ բերել</emph> տեղադրում է օբյեկտը բոլոր մյուս օբյեկտների վրա"

#: align_arrange.xhp#par_idN107EC.help.text
#: align_arrange.xhp%23par_idN107EC.help.text
msgid ""
"<emph>Bring Forward</emph> places the object one place forward in the stack "
"of objects"
msgstr ""
"<emph>Բերել առաջամաս</emph> օբյեկտը դնում է մեկ տեղ առաջ՝ օբյեկտների կույտի "
"մեջ"

#: align_arrange.xhp#par_idN107F2.help.text
#: align_arrange.xhp%23par_idN107F2.help.text
msgid ""
"<emph>Send Backward</emph> places the object one place back in the stack of "
"objects"
msgstr ""
"<emph>Ուղարկել հետնամաս</emph> օբյեկտը տեղադրում է մեկ տեղ ետ օբյեկտների "
"կույտի մեջ"

#: align_arrange.xhp#par_idN107F8.help.text
#: align_arrange.xhp%23par_idN107F8.help.text
msgid "<emph>Send to Back</emph> places the object behind all other objects"
msgstr ""
"<emph>Ուղարկել հետ</emph> օբյեկտը տեղադրում է մնացած բոլոր առարկաների հետևում"

#: align_arrange.xhp#par_idN107FE.help.text
#: align_arrange.xhp%23par_idN107FE.help.text
msgid ""
"<emph>Behind Object</emph> places the object behind another object that you "
"select"
msgstr ""
"<emph>Օբյեկտի հետևում</emph> օբյեկտը տեղադրում է ձեր ընտրած մեկ այլ օբյեկտի "
"հետևում"

#: align_arrange.xhp#hd_id3155766.79.help.text
#: align_arrange.xhp%23hd_id3155766.79.help.text
msgid "Arranging an Object Behind Another Object"
msgstr "Օբյեկտի դասավորությունը մեկ այլ օբյեկտի հետևում"

#: align_arrange.xhp#par_idN10811.help.text
#: align_arrange.xhp%23par_idN10811.help.text
msgctxt "align_arrange.xhp#par_idN10811.help.text"
msgid "Click the object whose position you want to change."
msgstr "Կտտացրեք այն օբյեկտին, որի դիրքը ցանկանում եք փոխել:"

#: align_arrange.xhp#par_id3154253.80.help.text
#: align_arrange.xhp%23par_id3154253.80.help.text
msgid ""
"Choose <item type=\"menuitem\">Modify - Arrange</item> to open the context "
"menu and choose <emph>Behind Object</emph>. The mouse pointer changes to a "
"hand."
msgstr ""
"Ընտրեք <item type=\"menuitem\">Փոփոխել – Դասավորել</item> համատեքստի "
"ընտրացանկը բացելու համար և ընտրեք <emph>Օբյեկտի հետևում</emph>: Մկնիկի "
"ցուցիչը փոխվում է թաթիկի:"

#: align_arrange.xhp#par_id3149126.81.help.text
#: align_arrange.xhp%23par_id3149126.81.help.text
msgid "Click the object behind which you want to place the selected object."
msgstr "Սեղմեք այն օբյեկտը, որի հետևում ցանկանում եք տեղադրել ընտրված օբյեկտը:"

#: align_arrange.xhp#hd_id3145789.20.help.text
#: align_arrange.xhp%23hd_id3145789.20.help.text
msgid "Reversing The Stacking Order of Two Objects"
msgstr "Երկու օբյեկտների կուտակման կարգի հակադարձում"

#: align_arrange.xhp#par_id3154022.83.help.text
#: align_arrange.xhp%23par_id3154022.83.help.text
msgid "Shift-click both objects to select them."
msgstr "Shift-սեղմեք երկու օբյեկտների վրա՝ դրանք ընտրելու համար:"

#: align_arrange.xhp#par_id3155114.84.help.text
#: align_arrange.xhp%23par_id3155114.84.help.text
msgid ""
"Choose <item type=\"menuitem\">Modify - Arrange</item> to open the context "
"menu and choose <emph>Reverse</emph>."
msgstr ""
"Ընտրեք <item type=\"menuitem\">Փոփոխել - Դասավորել</item>՝ համատեքստի "
"ընտրացանկը բացելու համար և ընտրեք <emph>Հակադարձ</emph>."

#: align_arrange.xhp#hd_id3166425.21.help.text
#: align_arrange.xhp%23hd_id3166425.21.help.text
msgid "Aligning Objects"
msgstr "Օբյեկտների հավասարեցում"

#: align_arrange.xhp#par_id3152994.22.help.text
#: align_arrange.xhp%23par_id3152994.22.help.text
msgid ""
"The <emph>Alignment</emph> function enables you to align objects relative to "
"each other or relative to the page."
msgstr ""
"<emph>Հավասարեցում</emph> ֆունկցիան հնարավորություն է տալիս հավասարեցնել "
"օբյեկտները միմյանց կամ էջի համեմատ:"

#: align_arrange.xhp#par_idN108A3.help.text
#: align_arrange.xhp%23par_idN108A3.help.text
msgid ""
"Select an object to align it to the page or select multiple objects to align "
"them relative to each other."
msgstr ""
"Ընտրեք օբյեկտ՝ այն էջին հավասարեցնելու համար կամ ընտրեք մի քանի օբյեկտ՝ "
"դրանք միմյանց նկատմամբ հավասարեցնելու համար:"

#: align_arrange.xhp#par_idN108A7.help.text
#: align_arrange.xhp%23par_idN108A7.help.text
msgid ""
"Choose <item type=\"menuitem\">Modify - Alignment</item> and select one of "
"the alignment options."
msgstr ""
"Ընտրեք <item type=\"menuitem\">Փոփոխել - Հավասարեցում</item> և ընտրեք "
"հավասարեցման տարբերակներից մեկը:"

#: align_arrange.xhp#par_idN108AE.help.text
#: align_arrange.xhp%23par_idN108AE.help.text
msgid "Distributing Objects"
msgstr "Օբյեկտների բաշխում"

#: align_arrange.xhp#par_id3151390.71.help.text
#: align_arrange.xhp%23par_id3151390.71.help.text
msgid ""
"If you select three or more objects in Draw, you can also use the <link href="
"\"text/shared/01/05360000.xhp\" name=\"Distribution\""
"><emph>Distribution</emph></link> command to distribute the vertical and "
"horizontal spacing evenly between the objects."
msgstr ""
"Եթե Draw-ում ընտրեք երեք կամ ավելի օբյեկտ, կարող եք նաև օգտագործել <link "
"href=\"text/shared/01/05360000.xhp\" name=\"Բաշխում\""
"><emph>Բաշխում</emph></link> հրամանը օբյեկտների միջև ուղղահայաց և "
"հորիզոնական տարածությունները հավասարաչափ բաշխելու համար:"

#: align_arrange.xhp#par_idN108CE.help.text
#: align_arrange.xhp%23par_idN108CE.help.text
msgid "Select three or more objects to be distributed."
msgstr "Ընտրեք երեք կամ ավելի օբյեկտներ, որոնք պետք է բաշխվեն:"

#: align_arrange.xhp#par_idN108D2.help.text
#: align_arrange.xhp%23par_idN108D2.help.text
msgid "Choose <item type=\"menuitem\">Modify - Distribution</item>."
msgstr "Ընտրեք <item type=\"menuitem\">Փոփոխել – Բաշխում</item>."

#: align_arrange.xhp#par_idN108DA.help.text
#: align_arrange.xhp%23par_idN108DA.help.text
msgid ""
"Select the horizontal and vertical distribution option and click "
"<emph>OK</emph>."
msgstr ""
"Ընտրեք հորիզոնական և ուղղահայաց բաշխման տարբերակը և սեղմեք <emph>ԼԱՎ</emph>."

#: align_arrange.xhp#par_id3150535.72.help.text
#: align_arrange.xhp%23par_id3150535.72.help.text
msgid ""
"Selected objects are distributed evenly along the horizontal or vertical "
"axis. The two outermost objects are used as reference points and do not move "
"when the <emph>Distribution</emph> command is applied."
msgstr ""
"Ընտրված առարկաները հավասարաչափ բաշխվում են հորիզոնական կամ ուղղահայաց "
"առանցքի երկայնքով: Երկու ամենահեռավոր օբյեկտները օգտագործվում են որպես հղման "
"կետեր և չեն շարժվում, երբ կիրառվում է <emph>Բաշխում</emph> հրամանը:"

#: eyedropper.xhp#tit.help.text
#: eyedropper.xhp%23tit.help.text
msgid "Replacing Colors"
msgstr "Գույների փոխարինում"

#: eyedropper.xhp#bm_id3147436.help.text
#: eyedropper.xhp%23bm_id3147436.help.text
msgid ""
"<bookmark_value>eyedropper tool</bookmark_value><bookmark_value>colors; "
"replacing</bookmark_value><bookmark_value>replacing;colors in "
"bitmaps</bookmark_value><bookmark_value>metafiles;replacing "
"colors</bookmark_value><bookmark_value>bitmaps;replacing "
"colors</bookmark_value><bookmark_value>GIF images;replacing "
"colors</bookmark_value>"
msgstr ""
"<bookmark_value>աչքի կաթիլային "
"գործիք</bookmark_value><bookmark_value>գույներ; "
"փոխարինելով</bookmark_value><bookmark_value>փոխարինում;գույները "
"բիթքարտեզում</bookmark_value><bookmark_value>մետանիշքեր;գույների "
"փոխարինում</bookmark_value><bookmark_value>բիթքարտեզներ;գույների "
"փոխարինում</bookmark_value><bookmark_value>GIF պատկերներ;գույների "
"փոխարինում</bookmark_value>"

#: eyedropper.xhp#hd_id3147436.38.help.text
#: eyedropper.xhp%23hd_id3147436.38.help.text
msgid ""
"<variable id=\"eyedropper\"><link href=\"text/sdraw/guide/eyedropper.xhp\" "
"name=\"Replacing Colors\">Replacing Colors</link></variable>"
msgstr ""
"<variable id=\"eyedropper\"><link href=\"text/sdraw/guide/eyedropper.xhp\" "
"name=\"Գույների փոխարինում\">Գույների փոխարինում</link></variable>"

#: eyedropper.xhp#par_id3156286.24.help.text
#: eyedropper.xhp%23par_id3156286.24.help.text
msgid ""
"You can replace colors in bitmaps with the <emph>Color Replacer</emph> tool."
msgstr ""
"Դուք կարող եք փոխարինել գույները բիթքարտեզներոում <emph>Գույնի "
"փոխարինող</emph> գործիքով:"

#: eyedropper.xhp#par_id3154704.25.help.text
#: eyedropper.xhp%23par_id3154704.25.help.text
msgid "Up to four colors can be replaced at once."
msgstr "Մինչև չորս գույն կարելի է փոխարինել միանգամից։"

#: eyedropper.xhp#par_id3147344.26.help.text
#: eyedropper.xhp%23par_id3147344.26.help.text
msgid ""
"You can also use the <emph>Transparency</emph> option to replace the "
"transparent areas of an image with a color."
msgstr ""
"Կարող եք նաև օգտագործել <emph>Թափանցիկություն</emph> տարբերակը՝ պատկերի "
"թափանցիկ տարածքները գույնով փոխարինելու համար:"

#: eyedropper.xhp#par_id3148488.27.help.text
#: eyedropper.xhp%23par_id3148488.27.help.text
msgid ""
"Similarly, you can use the <emph>Color Replacer</emph> to make a color on "
"your image transparent."
msgstr ""
"Նմանապես, դուք կարող եք օգտագործել <emph>Գույնի փոխարինիչ</emph>՝ ձեր "
"պատկերի գույնը թափանցիկ դարձնելու համար:"

#: eyedropper.xhp#hd_id3150205.28.help.text
#: eyedropper.xhp%23hd_id3150205.28.help.text
msgid "To replace colors with the Color Replacer tool"
msgstr "Գույները փոխարինելու համար Գույնի փոխարինիչ գործիքով"

#: eyedropper.xhp#par_id3154656.29.help.text
#: eyedropper.xhp%23par_id3154656.29.help.text
msgid ""
"Ensure that the image you are using is a bitmap (for example, BMP, GIF, JPG, "
"or PNG) or a metafile (for example, WMF)."
msgstr ""
"Համոզվեք, որ ձեր օգտագործած պատկերը բիթքարտեզ է (օրինակ՝ BMP, GIF, JPG կամ "
"PNG) կամ մետանիշք (օրինակ՝ WMF):"

#: eyedropper.xhp#par_id3150202.30.help.text
#: eyedropper.xhp%23par_id3150202.30.help.text
msgid "Choose <emph>Tools - Color Replacer</emph>."
msgstr "Ընտրեք <emph>Գործիքներ - Գույնի փոխարինող</emph>:"

#: eyedropper.xhp#par_id3155531.31.help.text
#: eyedropper.xhp%23par_id3155531.31.help.text
msgid ""
"Click the Color Replacer icon and position the mouse pointer over the color "
"you want to replace in the image. The color appears in the box next to the "
"icon."
msgstr ""
"Սեղմեք Գույնի փոխարինիչ պատկերակը և մկնիկի ցուցիչը տեղադրեք այն գույնի վրա, "
"որը ցանկանում եք փոխարինել պատկերում: Գույնը հայտնվում է պատկերակի կողքին "
"գտնվող վանդակում:"

#: eyedropper.xhp#par_id3152985.32.help.text
#: eyedropper.xhp%23par_id3152985.32.help.text
msgid ""
"Click the color in the image. The color appears in the first <emph>Source "
"color</emph> box and the check box next to the color is selected."
msgstr ""
"Սեղմեք պատկերի գույնը: Գույնը հայտնվում է առաջին <emph>Աղբյուրի գույնը</emph>"
" վանդակում և ընտրված է գույնի կողքին գտնվող վանդակը:"

#: eyedropper.xhp#par_id3148866.33.help.text
#: eyedropper.xhp%23par_id3148866.33.help.text
msgid "In the <emph>Replace with</emph> box, select the new color."
msgstr "<emph>Փոխարինեք</emph> վանդակում ընտրեք նոր գույնը:"

#: eyedropper.xhp#par_id3145362.41.help.text
#: eyedropper.xhp%23par_id3145362.41.help.text
msgid ""
"This replaces all occurrences of the <emph>Source color</emph> in the image."
msgstr ""
"Սա փոխարինում է պատկերի <emph>Աղբյուրի գույնը</emph> բոլոր հանդիպումներում:"

#: eyedropper.xhp#par_id3151191.34.help.text
#: eyedropper.xhp%23par_id3151191.34.help.text
msgid ""
"If you want to replace another color while the dialog is open, select the "
"check box in front of <emph>Source color</emph> in the next row and repeat "
"steps 3 to 5."
msgstr ""
"Եթե ցանկանում եք փոխարինել մեկ այլ գույն, մինչ երկխոսությունը բաց է, ընտրեք "
"վանդակը հաջորդ տողում <emph>Աղբյուրի գույնը</emph> և կրկնեք 3-ից 5-րդ "
"քայլերը:"

#: eyedropper.xhp#par_id3149876.36.help.text
#: eyedropper.xhp%23par_id3149876.36.help.text
msgid "Click <emph>Replace</emph>."
msgstr "Սեղմեք <emph>Փոխարինել</emph>."

#: eyedropper.xhp#par_id3157871.37.help.text
#: eyedropper.xhp%23par_id3157871.37.help.text
msgid ""
"If you want to expand or contract the color selection area, increase or "
"decrease the tolerance of the <emph>Color Replacer</emph> tool and repeat "
"your selection."
msgstr ""
"Եթե ցանկանում եք ընդլայնել կամ կրճատել գույների ընտրության տարածքը, "
"ավելացրեք կամ նվազեցրեք <emph>Գույնի փոխարինիչ</emph> գործիքի "
"հանդուրժողականությունը և կրկնեք ձեր ընտրությունը:"

#: eyedropper.xhp#par_id3146878.39.help.text
#: eyedropper.xhp%23par_id3146878.39.help.text
msgid ""
"<link href=\"text/shared/01/06030000.xhp\" name=\"Color Replacer\">Color "
"Replacer</link>"
msgstr ""
"<link href=\"text/shared/01/06030000.xhp\" name=\"Գույնի փոխարինիչ\">Գույնի "
"փոխարինիչ</link>"

#: cross_fading.xhp#tit.help.text
#: cross_fading.xhp%23tit.help.text
msgid "Cross-Fading Two Objects"
msgstr "Երկու օբյեկտների խաչաձև ստվերում"

#: cross_fading.xhp#bm_id3150715.help.text
#: cross_fading.xhp%23bm_id3150715.help.text
msgid ""
"<bookmark_value>draw objects; cross-fading two "
"objects</bookmark_value><bookmark_value>cross-fading; two draw "
"objects</bookmark_value>"
msgstr ""
"<bookmark_value>նկարել առարկաներ; երկու օբյեկտների խաչաձև "
"ստվերում</bookmark_value><bookmark_value>խաչաձև ստվերում; երկու նկար "
"առարկաներ</bookmark_value>"

#: cross_fading.xhp#hd_id3150715.17.help.text
#: cross_fading.xhp%23hd_id3150715.17.help.text
msgid ""
"<variable id=\"cross_fading\"><link href=\"text/sdraw/guide/cross_fading."
"xhp\" name=\"Cross-Fading Two Objects\">Cross-Fading Two "
"Objects</link></variable>"
msgstr ""
"<variable id=\"cross_fading\"><link href=\"text/sdraw/guide/cross_fading."
"xhp\" name=\"Երկու առարկաների խաչաձև ստվերում\">Երկու առարկաների խաչաձև "
"ստվերում</link></variable>"

#: cross_fading.xhp#par_id3154754.18.help.text
#: cross_fading.xhp%23par_id3154754.18.help.text
msgid ""
"Cross-fading creates shapes and distributes them by uniform increments "
"between two drawing objects."
msgstr ""
"Խաչաձև ստվերումը ստեղծում է ձևեր և դրանք բաշխում է միատեսակ աճերով նկարչական "
"երկու առարկաների միջև:"

#: cross_fading.xhp#par_id3155112.41.help.text
#: cross_fading.xhp%23par_id3155112.41.help.text
msgid ""
"The cross-fading command is only available in $[officename] Draw. You can, "
"however, copy and paste cross-faded objects into $[officename] Impress."
msgstr ""
"Խաչաձև ստվերման հրամանը հասանելի է միայն $[officename] Draw-ում: "
"Այնուամենայնիվ, դուք կարող եք պատճենել և տեղադրել խաչաձև ստվերված առարկաներ "
"$[officename] Impress-ում:"

#: cross_fading.xhp#hd_id3149209.20.help.text
#: cross_fading.xhp%23hd_id3149209.20.help.text
msgid "To cross-fade two objects:"
msgstr "Երկու առարկաների խաչաձև ստվերում."

#: cross_fading.xhp#par_id3150370.45.help.text
#: cross_fading.xhp%23par_id3150370.45.help.text
msgid "Hold down Shift and click each object."
msgstr "Սեղմած պահեք Shift-ը և կտտացրեք յուրաքանչյուր օբյեկտ:"

#: cross_fading.xhp#par_id3166428.22.help.text
#: cross_fading.xhp%23par_id3166428.22.help.text
msgid "Choose <emph>Edit - Cross-fading</emph>."
msgstr "Ընտրեք <emph>Խմբագրել - Խաչաձև ստվերում</emph>."

#: cross_fading.xhp#par_id3156450.44.help.text
#: cross_fading.xhp%23par_id3156450.44.help.text
msgid ""
"Enter a value to specify the number of objects between the start and end of "
"the cross-fade in the <emph>Increments</emph> box."
msgstr ""
"Մուտքագրեք արժեք՝ <emph>Ավելացումներ</emph> վանդակում խաչաձև ստվերման սկզբի "
"և վերջի միջև ընկած օբյեկտների քանակը նշելու համար:"

#: cross_fading.xhp#par_id3149405.23.help.text
#: cross_fading.xhp%23par_id3149405.23.help.text
msgid "Click <emph>OK</emph>."
msgstr "Կտտացրեք <emph>ԼԱՎ</emph>."

#: cross_fading.xhp#par_id3151240.24.help.text
#: cross_fading.xhp%23par_id3151240.24.help.text
msgid ""
"A group containing the two original objects and the specified number "
"(increments) of cross-faded objects is displayed."
msgstr ""
"Ցուցադրվում է խումբ, որը պարունակում է երկու բնօրինակ օբյեկտներ և խաչաձև "
"ստվերած օբյեկտների նշված թիվը (աճը):"

#: cross_fading.xhp#par_id3159203.help.text
#: cross_fading.xhp%23par_id3159203.help.text
msgid ""
"<image id=\"img_id3150210\" src=\"res/helpimg/ueberblenden.png\" width=\"74."
"88mm\" height=\"65.62mm\"><alt id=\"alt_id3150210\">Illustration for "
"crossfading</alt></image>"
msgstr ""
"<image id=\"img_id3150210\" src=\"res/helpimg/ueberblenden.png\" width=\"74."
"88mm\" height=\"65.62mm\"><alt id=\"alt_id3150210\">Խաչաձև ստվերման "
"նկարազարդում</alt></image>"

#: cross_fading.xhp#par_id3154766.25.help.text
#: cross_fading.xhp%23par_id3154766.25.help.text
msgid ""
"You can edit the individual objects of a group by selecting the group and "
"pressing F3. Press <switchinline select=\"sys\"><caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F3 "
"to exit the group editing mode."
msgstr ""
"You can edit the individual objects of a group by selecting the group and "
"pressing F3. Press <switchinline select=\"sys\"><caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F3 "
"խմբի խմբագրման ռեժիմից դուրս գալու համար։"

#: cross_fading.xhp#par_id3155760.42.help.text
#: cross_fading.xhp%23par_id3155760.42.help.text
msgid ""
"<link href=\"text/simpress/01/02150000.xhp\" name=\"Editing - Cross-fading\">"
"Editing - Cross-fading</link>"
msgstr ""
"<link href=\"text/simpress/01/02150000.xhp\" name=\"Խմբագրում - Խաչաձև "
"ստվերում\">Խմբագրում - Խաչաձև ստվերում</link>"

#: duplicate_object.xhp#tit.help.text
#: duplicate_object.xhp%23tit.help.text
msgid "Duplicating Objects"
msgstr "Օբյեկտների կրկնօրինակում"

#: duplicate_object.xhp#bm_id3145750.help.text
#: duplicate_object.xhp%23bm_id3145750.help.text
msgid ""
"<bookmark_value>doubling draw objects</bookmark_value><bookmark_value>draw "
"objects; duplicating</bookmark_value><bookmark_value>duplicating draw "
"objects</bookmark_value><bookmark_value>multiplying draw "
"objects</bookmark_value>"
msgstr ""
"<bookmark_value>նկարչական առարկաների "
"կրկնապատկում</bookmark_value><bookmark_value>նկարել առարկաներ; "
"կրկնօրինակել</bookmark_value><bookmark_value>նկարչական օբյեկտների "
"կրկնօրինակում</bookmark_value><bookmark_value>նկարչական օբյեկտների "
"բազմապատկում</bookmark_value>"

#: duplicate_object.xhp#hd_id3145750.3.help.text
#: duplicate_object.xhp%23hd_id3145750.3.help.text
msgid ""
"<variable id=\"duplicate_object\"><link href=\""
"text/sdraw/guide/duplicate_object.xhp\" name=\"Duplicating Objects\">"
"Duplicating Objects</link></variable>"
msgstr ""
"<variable id=\"duplicate_object\"><link href=\""
"text/sdraw/guide/duplicate_object.xhp\" name=\"Օբյեկտների կրկնօրինակում\">"
"Օբյեկտների կրկնօրինակում</link></variable>"

#: duplicate_object.xhp#par_id3149400.4.help.text
#: duplicate_object.xhp%23par_id3149400.4.help.text
msgid ""
"You can create duplicate or multiple copies of an object. The copies can be "
"identical or can differ in size, color, orientation and location."
msgstr ""
"Դուք կարող եք ստեղծել օբյեկտի կրկնօրինակը կամ մի քանի օրինակ: Պատճենները "
"կարող են լինել նույնական կամ կարող են տարբերվել չափերով, գույնով, "
"կողմնորոշմամբ և դիրքով:"

#: duplicate_object.xhp#par_id3153415.5.help.text
#: duplicate_object.xhp%23par_id3153415.5.help.text
msgid ""
"The following example creates a stack of coins by making multiple copies of "
"a single ellipse."
msgstr ""
"Հետևյալ օրինակը ստեղծում է մետաղադրամների կույտ՝ մեկ էլիպսի մի քանի "
"կրկնօրինակներ ստեղծելով:"

#: duplicate_object.xhp#par_id3149129.6.help.text
#: duplicate_object.xhp%23par_id3149129.6.help.text
msgid "Use the <emph>Ellipse</emph> tool to draw a solid yellow ellipse."
msgstr "Օգտագործեք <emph>Էլիպս</emph> գործիքը՝ պինդ դեղին էլիպս նկարելու համար:"

#: duplicate_object.xhp#par_id3149209.8.help.text
#: duplicate_object.xhp%23par_id3149209.8.help.text
msgid "Select the ellipse and choose <emph>Edit - Duplicate</emph>."
msgstr "Նշեք էլիպսը և ընտրեք <emph>Խմբագրել - Կրկնօրինակել</emph>:"

#: duplicate_object.xhp#par_id3145585.9.help.text
#: duplicate_object.xhp%23par_id3145585.9.help.text
msgid "Enter 12 as <emph>Number of copies.</emph>"
msgstr "Մուտքագրեք 12-ը որպես <emph>Պատճենների թիվը:</emph>"

#: duplicate_object.xhp#par_id3151192.11.help.text
#: duplicate_object.xhp%23par_id3151192.11.help.text
msgid ""
"Enter a negative value for the <emph>Width</emph> and <emph>Height</emph> so "
"that the coins decrease in size as you go up the stack."
msgstr ""
"Մուտքագրեք բացասական արժեք <emph>Լայնությունը</emph> և "
"<emph>Բարձրությունը</emph> համար, որպեսզի մետաղադրամները փոքրանան չափսերով, "
"երբ դուք բարձրանում եք կույտով վեր:"

#: duplicate_object.xhp#par_id3151387.39.help.text
#: duplicate_object.xhp%23par_id3151387.39.help.text
msgid ""
"To define a color transition for the coins, select different colors in the "
"<emph>Start</emph> and <emph>End</emph> boxes. The <emph>Start</emph> color "
"is applied to the object that you are duplicating."
msgstr ""
"Մետաղադրամների համար գունային անցում սահմանելու համար ընտրեք տարբեր գույներ "
"<emph>Սկիզբ</emph> և <emph>Վերջ</emph> վանդակներում: <emph>Սկիզբ</emph> "
"գույնը կիրառվում է այն օբյեկտի վրա, որը դուք կրկնօրինակում եք:"

#: duplicate_object.xhp#par_id3149947.12.help.text
#: duplicate_object.xhp%23par_id3149947.12.help.text
msgid "Click <emph>OK</emph> to create the duplicates."
msgstr "Կրկնօրինակները ստեղծելու համար սեղմեք <emph>ԼԱՎ</emph>:"

#: duplicate_object.xhp#par_id3153935.50.help.text
#: duplicate_object.xhp%23par_id3153935.50.help.text
msgid ""
"<link href=\"text/simpress/01/02120000.xhp\" name=\"Edit - Duplicate\">Edit -"
" Duplicate</link>"
msgstr ""
"<link href=\"text/simpress/01/02120000.xhp\" name=\"Խմբագրել – Կրկնօրինակել\""
">Խմբագրել – Կրկնօրինակել</link>"

#: combine_etc.xhp#tit.help.text
#: combine_etc.xhp%23tit.help.text
msgid "Combining Objects and Constructing Shapes"
msgstr "Օբյեկտների համադրում և ձևերի կառուցում"

#: combine_etc.xhp#bm_id3156443.help.text
#: combine_etc.xhp%23bm_id3156443.help.text
msgid ""
"<bookmark_value>combining; draw "
"objects</bookmark_value><bookmark_value>merging; draw "
"objects</bookmark_value><bookmark_value>connecting; draw "
"objects</bookmark_value><bookmark_value>draw objects; "
"combining</bookmark_value><bookmark_value>intersecting draw "
"objects</bookmark_value><bookmark_value>polygons; "
"intersecting/subtracting/merging</bookmark_value><bookmark_value>subtracting "
"polygons</bookmark_value><bookmark_value>constructing shapes</bookmark_value>"
msgstr ""
"<bookmark_value>համակցում; նկարել "
"առարկաներ</bookmark_value><bookmark_value>միաձուլում; նկարել "
"առարկաներ</bookmark_value><bookmark_value>միացում; նկարել "
"առարկաներ</bookmark_value><bookmark_value>նկարել առարկաներ; "
"համատեղել</bookmark_value><bookmark_value>հատվող նկարչական "
"առարկաներ</bookmark_value><bookmark_value>բազմանկյուններ; "
"հատում/հանում/միաձուլում</bookmark_value><bookmark_value>բազմանկյունների "
"հանում</bookmark_value><bookmark_value>ձևերի կառուցում</bookmark_value>"

#: combine_etc.xhp#hd_id3156443.64.help.text
#: combine_etc.xhp%23hd_id3156443.64.help.text
msgid ""
"<variable id=\"combine_etc\"><link href=\"text/sdraw/guide/combine_etc.xhp\" "
"name=\"Combining Objects and Constructing Shapes\">Combining Objects and "
"Constructing Shapes</link> </variable>"
msgstr ""
"<variable id=\"combine_etc\"><link href=\"text/sdraw/guide/combine_etc.xhp\" "
"name=\"Օբյեկտների համադրում և ձևերի կառուցում\">Օբյեկտների համադրում և ձևերի "
"կառուցում</link> </variable>"

#: combine_etc.xhp#par_id3149020.65.help.text
#: combine_etc.xhp%23par_id3149020.65.help.text
msgid ""
"Combined drawing objects act as grouped objects, except that you cannot "
"enter the group to edit the individual objects. "
msgstr ""
"Համակցված գծագրական օբյեկտները գործում են որպես խմբավորված օբյեկտներ, "
"բացառությամբ, որ դուք չեք կարող մտնել խումբ՝ առանձին օբյեկտները խմբագրելու "
"համար: "

#: combine_etc.xhp#par_id3154659.87.help.text
#: combine_etc.xhp%23par_id3154659.87.help.text
msgid "You can only combine 2D objects."
msgstr "Դուք կարող եք համատեղել միայն 2D օբյեկտները:"

#: combine_etc.xhp#hd_id3150344.32.help.text
#: combine_etc.xhp%23hd_id3150344.32.help.text
msgid "To combine 2D objects:"
msgstr "2D օբյեկտները համատեղելու համար."

#: combine_etc.xhp#par_id3166428.66.help.text
#: combine_etc.xhp%23par_id3166428.66.help.text
msgctxt "combine_etc.xhp#par_id3166428.66.help.text"
msgid "Select two or more 2D objects."
msgstr "Ընտրեք երկու կամ ավելի 2D օբյեկտ:"

#: combine_etc.xhp#par_id3145587.67.help.text
#: combine_etc.xhp%23par_id3145587.67.help.text
msgid "Choose <emph>Modify - Combine</emph>."
msgstr "Ընտրեք <emph>Փոփոխել - Միավորել</emph>:"

#: combine_etc.xhp#par_id3146978.33.help.text
#: combine_etc.xhp%23par_id3146978.33.help.text
msgid ""
"Unlike groups, a combined object takes on the properties of the lowermost "
"object in the stacking order. You can split apart combined objects, but the "
"original object properties are lost."
msgstr ""
"Ի տարբերություն խմբերի, համակցված օբյեկտը ստանձնում է ամենացածր օբյեկտի "
"հատկությունները` շարման կարգով: Դուք կարող եք բաժանել համակցված օբյեկտները, "
"բայց բնօրինակ օբյեկտի հատկությունները կորչում են:"

#: combine_etc.xhp#par_id3155088.34.help.text
#: combine_etc.xhp%23par_id3155088.34.help.text
msgid "When you combine objects, holes appear where the objects overlap."
msgstr ""
"Երբ դուք միավորում եք առարկաները, անցքեր են հայտնվում, որտեղ առարկաները "
"համընկնում են:"

#: combine_etc.xhp#par_id3156019.help.text
#: combine_etc.xhp%23par_id3156019.help.text
msgid ""
" <image id=\"img_id3157978\" src=\"res/helpimg/kombi1.png\" width=\"8."
"3646inch\" height=\"2.5inch\"><alt id=\"alt_id3157978\">Illustration for "
"combining objects</alt></image>"
msgstr ""
" <image id=\"img_id3157978\" src=\"res/helpimg/kombi1.png\" width=\"8."
"3646inch\" height=\"2.5inch\"><alt id=\"alt_id3157978\">Օբյեկտների համադրման "
"նկարազարդում</alt></image>"

#: combine_etc.xhp#par_id3153249.35.help.text
#: combine_etc.xhp%23par_id3153249.35.help.text
msgid ""
"In the illustration, the uncombined objects are on the left and the combined "
"objects on the right."
msgstr "Նկարում չհամակցված առարկաները ձախ կողմում են, իսկ համակցվածները՝ աջ:"

#: combine_etc.xhp#hd_id3159229.68.help.text
#: combine_etc.xhp%23hd_id3159229.68.help.text
msgid "Constructing Shapes"
msgstr "Ձևերի կառուցում"

#: combine_etc.xhp#par_id3150049.63.help.text
#: combine_etc.xhp%23par_id3150049.63.help.text
msgid ""
"You can construct shapes by applying the <link href=\""
"text/simpress/01/13180000.xhp\" name=\"Shapes\"><emph>Shapes</emph></link> "
"<emph>- Merge, Subtract and Intersect</emph> commands to two or more drawing "
"objects."
msgstr ""
"Դուք կարող եք ձևեր կառուցել կիրառելով <link href=\"text/simpress/01/13180000."
"xhp\" name=\"Ձևեր\"><emph>Ձևեր</emph></link> <emph>- Միաձուլել, Հանել և "
"Հատել</emph> հրամանները երկու կամ ավելի նկարչական օբյեկտների համար:"

#: combine_etc.xhp#par_id3147403.88.help.text
#: combine_etc.xhp%23par_id3147403.88.help.text
msgid "Shape commands only work on 2D objects."
msgstr "Ձևեր հրամաններն աշխատում են միայն 2D օբյեկտների վրա:"

#: combine_etc.xhp#par_id3150539.89.help.text
#: combine_etc.xhp%23par_id3150539.89.help.text
msgid ""
"Constructed shapes take on the properties of the lowermost object in the "
"stacking order."
msgstr ""
"Կառուցված ձևերը ստանձնում են ամենացածր օբյեկտի հատկությունները՝ ըստ շարման "
"կարգի:"

#: combine_etc.xhp#hd_id3156402.90.help.text
#: combine_etc.xhp%23hd_id3156402.90.help.text
msgid "To construct a shape:"
msgstr "Ձև ստեղծելու համար."

#: combine_etc.xhp#par_id3157874.69.help.text
#: combine_etc.xhp%23par_id3157874.69.help.text
msgctxt "combine_etc.xhp#par_id3157874.69.help.text"
msgid "Select two or more 2D objects."
msgstr "Ընտրեք երկու կամ ավելի 2D օբյեկտ:"

#: combine_etc.xhp#par_id3150650.70.help.text
#: combine_etc.xhp%23par_id3150650.70.help.text
msgid "Choose <emph>Modify - Shapes</emph> and one of the following:"
msgstr "Ընտրեք <emph>Փոփոխել - Ձևեր</emph> և հետևյալներից մեկը."

#: combine_etc.xhp#par_id3145829.91.help.text
#: combine_etc.xhp%23par_id3145829.91.help.text
msgid " <emph>Merge</emph> "
msgstr " <emph>Միաձուլել</emph> "

#: combine_etc.xhp#par_id3154680.92.help.text
#: combine_etc.xhp%23par_id3154680.92.help.text
msgid " <emph>Subtract</emph> "
msgstr " <emph>Հանել</emph> "

#: combine_etc.xhp#par_id3153034.93.help.text
#: combine_etc.xhp%23par_id3153034.93.help.text
msgid " <emph>Intersect</emph>."
msgstr " <emph>Հատվել</emph>."

#: combine_etc.xhp#hd_id3145144.94.help.text
#: combine_etc.xhp%23hd_id3145144.94.help.text
msgid "Shape Commands"
msgstr "Ձևի հրամաններ"

#: combine_etc.xhp#par_id3153931.71.help.text
#: combine_etc.xhp%23par_id3153931.71.help.text
msgid ""
"In the following illustrations, the original objects are on the left and the "
"modified shapes on the right."
msgstr ""
"Հետևյալ նկարներում բնօրինակ առարկաները գտնվում են ձախ կողմում, իսկ փոփոխված "
"ձևերը՝ աջում:"

#: combine_etc.xhp#hd_id3149950.72.help.text
#: combine_etc.xhp%23hd_id3149950.72.help.text
msgid "Shapes - Merge"
msgstr "Ձևեր - Միաձուլել"

#: combine_etc.xhp#par_id3148585.help.text
#: combine_etc.xhp%23par_id3148585.help.text
msgid ""
" <image id=\"img_id3145593\" src=\"res/helpimg/formvers.png\" width=\"3."
"4791inch\" height=\"1.3126inch\"><alt id=\"alt_id3145593\">Illustration for "
"merging shapes</alt></image>"
msgstr ""
" <image id=\"img_id3145593\" src=\"res/helpimg/formvers.png\" width=\"3."
"4791inch\" height=\"1.3126inch\"><alt id=\"alt_id3145593\">Ձևերի միաձուլման "
"նկարազարդում</alt></image>"

#: combine_etc.xhp#par_id3150001.73.help.text
#: combine_etc.xhp%23par_id3150001.73.help.text
msgid ""
"Adds the area of the selected objects to the area of the lowermost object in "
"the stacking order."
msgstr ""
"Ընտրված օբյեկտների տարածքը ավելացնում է ամենացածր օբյեկտի տարածքին` ըստ "
"շարման կարգի:"

#: combine_etc.xhp#hd_id3153002.74.help.text
#: combine_etc.xhp%23hd_id3153002.74.help.text
msgid "Shapes - Subtract"
msgstr "Ձևեր – Հանել"

#: combine_etc.xhp#par_id3150338.help.text
#: combine_etc.xhp%23par_id3150338.help.text
msgid ""
" <image id=\"img_id3154505\" src=\"res/helpimg/formsubt.png\" width=\"3."
"4689inch\" height=\"1.3126inch\"><alt id=\"alt_id3154505\">Illustration for "
"subtracting shapes</alt></image>"
msgstr ""
" <image id=\"img_id3154505\" src=\"res/helpimg/formsubt.png\" width=\"3."
"4689inch\" height=\"1.3126inch\"><alt id=\"alt_id3154505\">Նկարազարդում "
"պատկերները հանելու համար</alt></image>"

#: combine_etc.xhp#par_id3150022.75.help.text
#: combine_etc.xhp%23par_id3150022.75.help.text
msgid ""
"Subtracts the area of the selected objects from the area of the lowermost "
"object in the stacking order."
msgstr ""
"Ընտրված օբյեկտների տարածքը հանում է ամենացածր օբյեկտի տարածքից՝ ըստ "
"դասավորության:"

#: combine_etc.xhp#hd_id3147370.78.help.text
#: combine_etc.xhp%23hd_id3147370.78.help.text
msgid "Shapes - Intersect"
msgstr "Ձեւեր – Հատվում են"

#: combine_etc.xhp#par_id3150570.help.text
#: combine_etc.xhp%23par_id3150570.help.text
msgid ""
" <image id=\"img_id3150658\" src=\"res/helpimg/formschn.png\" width=\"3."
"4272inch\" height=\"1.302inch\"><alt id=\"alt_id3150658\">Illustration for "
"intersecting shapes</alt></image>"
msgstr ""
" <image id=\"img_id3150658\" src=\"res/helpimg/formschn.png\" width=\"3."
"4272inch\" height=\"1.302inch\"><alt id=\"alt_id3150658\">Նկարազարդում "
"հատվող ձևերի համար</alt></image>"

#: combine_etc.xhp#par_id3157972.79.help.text
#: combine_etc.xhp%23par_id3157972.79.help.text
msgid "The overlapping area of the selected objects creates the new shape."
msgstr "Ընտրված օբյեկտների համընկնող տարածքը ստեղծում է նոր ձև:"

#: combine_etc.xhp#par_id3151020.80.help.text
#: combine_etc.xhp%23par_id3151020.80.help.text
msgid "The area outside the overlap is removed."
msgstr "Համընկնումից դուրս գտնվող տարածքը հեռացվում է:"

#: text_enter.xhp#tit.help.text
#: text_enter.xhp%23tit.help.text
msgid "Adding Text"
msgstr "տեքստի ավելացում"

#: text_enter.xhp#bm_id3153144.help.text
#: text_enter.xhp%23bm_id3153144.help.text
msgid ""
"<bookmark_value>text frames</bookmark_value>      <bookmark_value>inserting;"
"text frames</bookmark_value>      <bookmark_value>copying;text from other "
"documents</bookmark_value>      <bookmark_value>pasting;text from other "
"documents</bookmark_value>      <bookmark_value>legends; "
"drawings</bookmark_value>"
msgstr ""
"<bookmark_value>տեքստի շրջանակներ</bookmark_value>      "
"<bookmark_value>զետեղում;տեքստի շրջանակներ</bookmark_value>      "
"<bookmark_value>պատճենում;տեքստ այլ փաստաթղթերից</bookmark_value>      "
"<bookmark_value>կպցնել;տեքստ այլ փաստաթղթերից</bookmark_value>      "
"<bookmark_value>լեգենդներ; գծագրեր</bookmark_value>"

#: text_enter.xhp#hd_id3153144.45.help.text
#: text_enter.xhp%23hd_id3153144.45.help.text
msgid ""
"<variable id=\"text_enter\"><link href=\"text/sdraw/guide/text_enter.xhp\" "
"name=\"Adding Text\">Adding Text</link></variable>"
msgstr ""
"<variable id=\"text_enter\"><link href=\"text/sdraw/guide/text_enter.xhp\" "
"name=\"Տեքստի ավելացում\">Տեքստի ավելացում</link></variable>"

#: text_enter.xhp#par_id3145750.46.help.text
#: text_enter.xhp%23par_id3145750.46.help.text
msgid ""
"There are several types of text you can add to a drawing or presentation: "
msgstr ""
"Գոյություն ունեն տեքստի մի քանի տեսակներ, որոնք կարող եք ավելացվել գծագրին "
"կամ ներկայացմանը. "

#: text_enter.xhp#par_idN10824.help.text
#: text_enter.xhp%23par_idN10824.help.text
msgid "Text in a text box"
msgstr "Տեքստը տեքստային վանդակում"

#: text_enter.xhp#par_idN10828.help.text
#: text_enter.xhp%23par_idN10828.help.text
msgid "Text that changes character size to fill the frame size"
msgstr "Տեքստ, որը փոխում է նիշերի չափը՝ շրջանակի չափը լրացնելու համար"

#: text_enter.xhp#par_idN1082C.help.text
#: text_enter.xhp%23par_idN1082C.help.text
msgid "Text that is added to any drawing object by double-clicking the object"
msgstr ""
"Տեքստ, որն ավելացվում է գծագրության ցանկացած օբյեկտի վրա՝ կրկնակի սեղմելով "
"օբյեկտի վրա"

#: text_enter.xhp#par_idN10830.help.text
#: text_enter.xhp%23par_idN10830.help.text
msgid "Text that is copied from a Writer document"
msgstr "Տեքստ, որը պատճենված է Writer փաստաթղթից"

#: text_enter.xhp#par_idN10834.help.text
#: text_enter.xhp%23par_idN10834.help.text
msgid "Text that is inserted from a text document or HTML document"
msgstr "Տեքստ, որը զետեղված է տեքստային փաստաթղթից կամ HTML փաստաթղթից"

#: text_enter.xhp#hd_id3150202.48.help.text
#: text_enter.xhp%23hd_id3150202.48.help.text
msgid "Adding a Text Box"
msgstr "Տեքստային վանդակի ավելացում"

#: text_enter.xhp#par_id3155266.49.help.text
#: text_enter.xhp%23par_id3155266.49.help.text
msgid ""
"Click the <emph>Text</emph> icon <image id=\"img_id3156450\" src=\""
"res/commandimagelist/sc_text.png\" width=\"0.1665in\" height=\"0.1665in\"><"
"alt id=\"alt_id3156450\">Icon</alt></image> and move the mouse pointer to "
"where you want to enter the text box."
msgstr ""
"Click the <emph>Text</emph> icon <image id=\"img_id3156450\" src=\""
"res/commandimagelist/sc_text.png\" width=\"0.1665in\" height=\"0.1665in\"><"
"alt id=\"alt_id3156450\">Պատկերակ</alt></image> և տեղափոխեք մկնիկի ցուցիչը "
"այնտեղ, որտեղ ցանկանում եք մուտքագրել տեքստային տուփը:"

#: text_enter.xhp#par_id3149052.50.help.text
#: text_enter.xhp%23par_id3149052.50.help.text
msgid "Drag a text box to the size you want in your document."
msgstr "Քաշեք տեքստային տուփը ձեր փաստաթղթում ուզած չափով:"

#: text_enter.xhp#par_id3151194.51.help.text
#: text_enter.xhp%23par_id3151194.51.help.text
msgid "Type or paste your text into the text box."
msgstr "Մուտքագրեք կամ տեղադրեք ձեր տեքստը տեքստային վանդակում:"

#: text_enter.xhp#par_id3145118.53.help.text
#: text_enter.xhp%23par_id3145118.53.help.text
msgid ""
"Double-click the text to edit it or to format text properties, such as font "
"size or font color. Click the border of the text box to edit the object "
"properties, such as border color or arranging in front or behind other "
"objects."
msgstr ""
"Կրկնակի սեղմեք տեքստի վրա՝ այն խմբագրելու կամ տեքստի հատկությունները "
"ֆորմատավորելու համար, օրինակ՝ տառաչափը կամ տառատեսակի գույնը: Սեղմեք "
"տեքստային տուփի եզրագիծը՝ օբյեկտի հատկությունները խմբագրելու համար, օրինակ՝ "
"եզրագծերի գույները կամ այլ օբյեկտների առջևում կամ հետևում դասավորելը:"

#: text_enter.xhp#hd_id3150437.54.help.text
#: text_enter.xhp%23hd_id3150437.54.help.text
msgid "Fitting Text to Frames"
msgstr "Տեքստի տեղադրումը շրջանակներում"

#: text_enter.xhp#par_id3146877.56.help.text
#: text_enter.xhp%23par_id3146877.56.help.text
msgid "Create a text box as described in the steps above."
msgstr "Ստեղծեք տեքստային տուփ, ինչպես նկարագրված է վերը նշված քայլերում:"

#: text_enter.xhp#par_idN108A3.help.text
#: text_enter.xhp%23par_idN108A3.help.text
msgid ""
"With the text object selected, choose <emph>Format - Text</emph>. The "
"<emph>Text</emph> dialog opens."
msgstr ""
"Ընտրված տեքստային օբյեկտի դեպքում, ընտրեք <emph>Ձևաչափ - Տեքստ</emph>: "
"Բացվում է <emph>Տեքստ</emph> երկխոսությունը:"

#: text_enter.xhp#par_idN108AF.help.text
#: text_enter.xhp%23par_idN108AF.help.text
msgid ""
"On the <emph>Text</emph> tab page, clear the <emph>Fit height to text</emph> "
"checkbox, then select the <emph>Fit to frame</emph> checkbox. Click "
"<emph>OK</emph>."
msgstr ""
"<emph>Տեքստ</emph> ներդիրի էջում մաքրեք <emph>Տեքստին հարմարեցնել "
"բարձրությունը</emph> վանդակը, այնուհետև ընտրեք <emph>Համապատասխանություն "
"շրջանակին</emph> վանդակը: Սեղմեք <emph>ԼԱՎ</emph>:"

#: text_enter.xhp#par_id0610200902133994.help.text
#: text_enter.xhp%23par_id0610200902133994.help.text
msgid ""
"Now you can resize the text box to change the size and shape of the text "
"characters."
msgstr ""
"Այժմ դուք կարող եք չափափոխել տեքստային տուփի չափը՝ տեքստի նիշերի չափն ու ձևը "
"փոխելու համար:"

#: text_enter.xhp#hd_id3155955.58.help.text
#: text_enter.xhp%23hd_id3155955.58.help.text
msgid "Text Tied to a Graphic"
msgstr "Տեքստը կապված է գրաֆիկայի հետ"

#: text_enter.xhp#par_idN10917.help.text
#: text_enter.xhp%23par_idN10917.help.text
msgid "You can add text to any graphic after double-clicking the graphic."
msgstr ""
"Գրաֆիկի վրա կրկնակի կտտացնելուց հետո կարող եք տեքստ ավելացնել ցանկացած "
"գրաֆիկի վրա:"

#: text_enter.xhp#par_id1827448.help.text
#: text_enter.xhp%23par_id1827448.help.text
msgid ""
"To determine the position of the text, use the settings in <emph>Format - "
"Text</emph>."
msgstr ""
"Տեքստի դիրքը որոշելու համար օգտագործեք <emph>Ձևաչափ - Տեքստ</emph> -ի "
"կարգաբերումները:"

#: text_enter.xhp#par_id3147366.59.help.text
#: text_enter.xhp%23par_id3147366.59.help.text
msgid ""
"For example, click the arrow next to the <emph>Callouts</emph> icon <image "
"id=\"img_id3154508\" src=\"res/commandimagelist/sc_calloutshapes.png\" width="
"\"0.1665in\" height=\"0.1665in\"><alt id=\"alt_id3154508\">Icon</alt></image>"
" to open the Callouts toolbar."
msgstr ""
"Օրինակ, սեղմեք <emph>Ելուստի</emph> պատկերակի կողքին գտնվող սլաքը <image id="
"\"img_id3154508\" src=\"res/commandimagelist/sc_calloutshapes.png\" width=\""
"0.1665in\" height=\"0.1665in\"><alt id=\"alt_id3154508\""
">Պատկերակ</alt></image> բացելու համար Ելուստների գործիքագոտին:"

#: text_enter.xhp#par_idN108FD.help.text
#: text_enter.xhp%23par_idN108FD.help.text
msgid ""
"Select a callout and move the mouse pointer to where you want the callout to "
"start."
msgstr ""
"Ընտրեք ելուստը և մկնիկի ցուցիչը տեղափոխեք այնտեղ, որտեղ ցանկանում եք, որ "
"ելուստը սկսվի:"

#: text_enter.xhp#par_id3150272.60.help.text
#: text_enter.xhp%23par_id3150272.60.help.text
msgid "Drag to draw the callout."
msgstr "Քաշեք՝ ելուստը նկարելու համար:"

#: text_enter.xhp#par_id1978514.help.text
#: text_enter.xhp%23par_id1978514.help.text
msgid "Enter the text."
msgstr "Մուտքագերք տեքստւ"

#: text_enter.xhp#par_idN1091A.help.text
#: text_enter.xhp%23par_idN1091A.help.text
msgid "Copying Text"
msgstr "Տեքստի պատճենում"

#: text_enter.xhp#par_idN10921.help.text
#: text_enter.xhp%23par_idN10921.help.text
msgid "Select the text in your Writer document."
msgstr "Ընտրեք տեքստը ձեր Writer փաստաթղթում:"

#: text_enter.xhp#par_idN10925.help.text
#: text_enter.xhp%23par_idN10925.help.text
msgid "Copy the text to the clipboard (<emph>Edit - Copy</emph>)."
msgstr "Տեքստը պատճենեք հիշողության բուֆեր (<emph>Խմբագրել - Պատճենել</emph>)."

#: text_enter.xhp#par_idN1092D.help.text
#: text_enter.xhp%23par_idN1092D.help.text
msgid "Click the page or slide where you want to paste the text."
msgstr "Սեղմեք այն էջը կամ սահիկը, որտեղ ցանկանում եք տեղադրել տեքստը:"

#: text_enter.xhp#par_idN10931.help.text
#: text_enter.xhp%23par_idN10931.help.text
