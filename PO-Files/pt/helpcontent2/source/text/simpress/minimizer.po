#: step4.xhp#tit.help.text
#: step4.xhp%23tit.help.text
msgid "Presentation Minimizer - OLE Objects"
msgstr "Optimização de diaporamas - Objectos OLE"

#: step4.xhp#par_id77665507.help.text
#: step4.xhp%23par_id77665507.help.text
msgid ""
"<link href=\"text/simpress/minimizer/step4.xhp\" name=\"Presentation "
"Minimizer - OLE Objects\">Presentation Minimizer - OLE Objects</link>"
msgstr ""
"<link href=\"text/simpress/minimizer/step4.xhp\" name=\"Optimização de "
"diaporamas - Objectos OLE\">Optimização de diaporamas - Objectos OLE</link>"

#: step4.xhp#par_id77665508.help.text
#: step4.xhp%23par_id77665508.help.text
msgid ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:Step4\">Choose settings for "
"replacing OLE objects.</ahelp>"
msgstr ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:Step4\">Escolha as definições para "
"substituir objectos OLE.</ahelp>"

#: step4.xhp#hd_id77665501.help.text
#: step4.xhp%23hd_id77665501.help.text
msgid "Create static replacement graphics for OLE objects"
msgstr "Criar imagens estáticas de substituição para objectos OLE"

#: step4.xhp#par_id77665503n.help.text
#: step4.xhp%23par_id77665503n.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step4:CBOLE\">Replace OLE object with a "
"static graphic.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step4:CBOLE\">Substituir objectos OLE "
"por imagens estáticas.</ahelp>"

#: step4.xhp#hd_id77665502.help.text
#: step4.xhp%23hd_id77665502.help.text
msgid "For all OLE objects"
msgstr "Para todos os objectos OLE"

#: step4.xhp#par_id77665503o.help.text
#: step4.xhp%23par_id77665503o.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step4:RBAllOLE\">Replace all OLE objects "
"with a static graphic.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step4:RBAllOLE\">Substituir todos os "
"objectos OLE por uma imagem estática.</ahelp>"

#: step4.xhp#hd_id77665503.help.text
#: step4.xhp%23hd_id77665503.help.text
msgid "For OLE objects not based on OpenDocument format"
msgstr "Para objectos OLE não baseados no formato OpenDocument"

#: step4.xhp#par_id77665503p.help.text
#: step4.xhp%23par_id77665503p.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step4:RBNotODF\">Replace only OLE "
"objects not based on the Open Document Format used by %PRODUCTNAME.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step4:RBNotODF\">Substituir só objectos "
"OLE não baseados no formato OpenDocument usado pelo %PRODUCTNAME.</ahelp>"

#: step4.xhp#par_id3153087.help.text
#: step4.xhp%23par_id3153087.help.text
msgid ""
"            <link href=\"text/simpress/minimizer/step5.xhp\" name=\"Go to "
"Presentation Minimizer - Summary\">Go to Presentation Minimizer - "
"Summary</link>        "
msgstr ""
"            <link href=\"text/simpress/minimizer/step5.xhp\" name=\"Ir para "
"a optimização de diaporamas - Resumo\">Ir para a optimização de diaporamas - "
"Resumo</link>        "

#: step3.xhp#tit.help.text
#: step3.xhp%23tit.help.text
msgid "Presentation Minimizer - Graphics"
msgstr "Optimização de diaporamas - Imagens"

#: step3.xhp#par_id77665505b.help.text
#: step3.xhp%23par_id77665505b.help.text
msgid ""
"<link href=\"text/simpress/minimizer/step3.xhp\" name=\"Presentation "
"Minimizer - Graphics\">Presentation Minimizer - Graphics</link>"
msgstr ""
"<link href=\"text/simpress/minimizer/step3.xhp\" name=\"Optimização de "
"diaporamas - Imagens\">Optimização de diaporamas - Imagens</link>"

#: step3.xhp#par_id77665506.help.text
#: step3.xhp%23par_id77665506.help.text
msgid ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:Step3\">Choose settings for "
"optimizing pictures and graphics.</ahelp>"
msgstr ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:Step3\">Escolha as definições para "
"optimizar imagens e gráficos.</ahelp>"

#: step3.xhp#hd_id77665501.help.text
#: step3.xhp%23hd_id77665501.help.text
msgid "Lossless compression"
msgstr "Compressão sem perdas"

#: step3.xhp#par_id77665503h.help.text
#: step3.xhp%23par_id77665503h.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:RBLossless\">Lossless "
"compression.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:RBLossless\">Compressão sem "
"perdas.</ahelp>"

#: step3.xhp#hd_id77665502.help.text
#: step3.xhp%23hd_id77665502.help.text
msgid "JPEG compression"
msgstr "Compressão JPEG"

#: step3.xhp#par_id77665503i.help.text
#: step3.xhp%23par_id77665503i.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:RBJPEG\">Compress JPEG "
"graphics.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:RBJPEG\">Comprimir imagens "
"JPEG.</ahelp>"

#: step3.xhp#hd_id77665503.help.text
#: step3.xhp%23hd_id77665503.help.text
msgid "Quality in percent"
msgstr "Qualidade em percentagem"

#: step3.xhp#par_id77665503j.help.text
#: step3.xhp%23par_id77665503j.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:MFQuality\">Specify the quality of "
"the compression. A higher value means less compression.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:MFQuality\">Especifique a "
"qualidade da compressão. Um valor mais alto significa menos "
"compressão.</ahelp>"

#: step3.xhp#hd_id77665504.help.text
#: step3.xhp%23hd_id77665504.help.text
msgid "Reduce image resolution"
msgstr "Reduzir a resolução da imagem"

#: step3.xhp#par_id77665503k.help.text
#: step3.xhp%23par_id77665503k.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:LBDPI\">Specify the image "
"resolution in DPI (dots per inch).</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:LBDPI\">Especifique a resolução da "
"imagem em PPP (pontos por polegada).</ahelp>"

#: step3.xhp#hd_id77665505.help.text
#: step3.xhp%23hd_id77665505.help.text
msgid "Delete cropped graphic areas"
msgstr "Eliminar áreas de imagem cortadas"

#: step3.xhp#par_id77665503l.help.text
#: step3.xhp%23par_id77665503l.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:CBCrop\">Delete cropped graphic "
"areas from the graphics.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:CBCrop\">Eliminar áreas de imagens "
"cortadas das próprias imagens.</ahelp>"

#: step3.xhp#hd_id77665506.help.text
#: step3.xhp%23hd_id77665506.help.text
msgid "Break links to external graphics"
msgstr "Quebrar ligações a imagens externas"

#: step3.xhp#par_id77665503m.help.text
#: step3.xhp%23par_id77665503m.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:CBLinks\">Break all links to "
"external graphics.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:CBLinks\">Quebrar todas as "
"ligações a imagens externas.</ahelp>"

#: step3.xhp#par_id3153087.help.text
#: step3.xhp%23par_id3153087.help.text
msgid ""
"            <link href=\"text/simpress/minimizer/step4.xhp\" name=\"Go to "
"Presentation Minimizer - OLE Objects\">Go to Presentation Minimizer - OLE "
"Objects</link>        "
msgstr ""
"            <link href=\"text/simpress/minimizer/step4.xhp\" name=\"Ir para "
"a optimização de diaporamas - Objectos OLE\">Ir para a optimização de "
"diaporamas - Objectos OLE</link>        "

#: step1.xhp#tit.help.text
#: step1.xhp%23tit.help.text
msgid "Presentation Minimizer - Introduction"
msgstr "Optimização de diaporamas - Inserção"

#: step1.xhp#hd_id77665500.help.text
#: step1.xhp%23hd_id77665500.help.text
msgid ""
"<link href=\"text/simpress/minimizer/step1.xhp\" name=\"Presentation "
"Minimizer - Introduction\">Presentation Minimizer - Introduction</link>"
msgstr ""
"<link href=\"text/simpress/minimizer/step1.xhp\" name=\"Optimização de "
"diaporamas - Inserção\">Optimização de diaporamas - Inserção</link>"

#: step1.xhp#par_id77665500.help.text
#: step1.xhp%23par_id77665500.help.text
msgid ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:Step1\">In this step you can select "
"the settings of the wizard that you have stored previously.</ahelp>"
msgstr ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:Step1\">Neste passo pode seleccionar "
"as definições do assistente previamente guardadas.</ahelp>"

#: step1.xhp#hd_id77665501.help.text
#: step1.xhp%23hd_id77665501.help.text
msgid "Choose settings for Presentation Minimizer"
msgstr "Escolha as definições para a optimização de diaporamas"

#: step1.xhp#par_id77665503a.help.text
#: step1.xhp%23par_id77665503a.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step1:LBSettings\">This list box "
"contains a list of all available wizard settings. Choose one to apply the "
"settings to the wizard options.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step1:LBSettings\">Esta lista contém "
"todas as definições disponíveis para a optimização de diaporamas. Escolha "
"uma para aplicar as definições às opções do assistente.</ahelp>"

#: step1.xhp#hd_id77665502.help.text
#: step1.xhp%23hd_id77665502.help.text
msgid "Delete"
msgstr "Eliminar"

#: step1.xhp#par_id77665503b.help.text
#: step1.xhp%23par_id77665503b.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step1:PBDelSetts\">Delete the wizard "
"settings currently selected on the list box.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step1:PBDelSetts\">Eliminar as "
"definições do assistente actualmente seleccionadas na lista.</ahelp>"

#: step1.xhp#par_id3153087.help.text
#: step1.xhp%23par_id3153087.help.text
msgid ""
"            <link href=\"text/simpress/minimizer/step2.xhp\" name=\"Go to "
"Presentation Minimizer - Slides\">Go to Presentation Minimizer - "
"Slides</link>        "
msgstr ""
"            <link href=\"text/simpress/minimizer/step2.xhp\" name=\"Ir para "
"a optimização de diaporamas - Diapositivos\">Ir para a optimização de "
"diaporamas - Diapositivos</link>        "

#: main.xhp#tit.help.text
#: main.xhp%23tit.help.text
msgctxt "main.xhp#tit.help.text"
msgid "Presentation Minimizer"
msgstr "Optimização de diaporamas"

#: main.xhp#bm_id77665500.help.text
#: main.xhp%23bm_id77665500.help.text
msgid ""
"            <bookmark_value>presentations; optimize file "
"size</bookmark_value>            <bookmark_value>Presentation "
"Minimizer</bookmark_value>        "
msgstr ""
"            <bookmark_value>apresentações; optimizar tamanho do "
"ficheiro</bookmark_value>            <bookmark_value>Optimização de "
"diaporamas</bookmark_value>        "

#: main.xhp#hd_id77665500.help.text
#: main.xhp%23hd_id77665500.help.text
msgctxt "main.xhp#hd_id77665500.help.text"
msgid "Presentation Minimizer"
msgstr "Optimização de diaporamas"

#: main.xhp#par_id77665500.help.text
#: main.xhp%23par_id77665500.help.text
msgid ""
"<ahelp hid=\".uno:PresentationMinimizer\">Opens the Presentation Minimizer "
"wizards, where you can  optimize the size of %PRODUCTNAME Impress files, by "
"compresing large images, reducing cropped areas, removing unused master "
"pages, etc.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:PresentationMinimizer\">Abre o assistente da optimização "
"de diaporamas, onde pode optimizar o tamanho dos ficheiros do %PRODUCTNAME "
"Impress, comprimindo imagens grandes, reduzindo áreas cortadas, removendo "
"páginas mestras não usadas, etc.</ahelp>"

#: main.xhp#par_id77665502.help.text
#: main.xhp%23par_id77665502.help.text
msgid ""
"The Presentation Minimizer is used to reduce the file size of the current "
"presentation. Images will be compressed and data, that is no longer needed, "
"will be removed."
msgstr ""
"A optimização de diaporamas é usada para reduzir o tamanho do ficheiro da "
"apresentação actual. As imagens serão comprimidas e os dados que já não "
"forem necessários, serão removidos."

#: main.xhp#par_id77665503.help.text
#: main.xhp%23par_id77665503.help.text
msgid ""
"At the last step of the wizard you can choose to apply the changes to the "
"current presentation or to create an optimized new version of the "
"presentation."
msgstr ""
"No último passo do assistente, pode optar entre aplicar as alterações à "
"apresentação actual ou criar uma cópia optimizada da apresentação."

#: main.xhp#hd_id776655000.help.text
#: main.xhp%23hd_id776655000.help.text
msgid "Help"
msgstr "Ajuda"

#: main.xhp#par_id776655000.help.text
#: main.xhp%23par_id776655000.help.text
msgid ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:PBHelp\">Open the Online Help for "
"this Wizard.</ahelp>"
msgstr ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:PBHelp\">Abrir a ajuda online para "
"este assistente.</ahelp>"

#: main.xhp#hd_id77665501.help.text
#: main.xhp%23hd_id77665501.help.text
msgid "Back"
msgstr "Anterior"

#: main.xhp#par_id77665501.6.help.text
#: main.xhp%23par_id77665501.6.help.text
msgid ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:PBBack\">Returns to the selections "
"made on the previous page. The current settings remain in effect. This "
"button only becomes active after the first page.</ahelp>"
msgstr ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:PBBack\">Regressa às selecções "
"efectuadas na página anterior. As definições actuais continuarão em vigor. "
"Este botão só se tornará activo após a primeira página.</ahelp>"

#: main.xhp#hd_id77665502.help.text
#: main.xhp%23hd_id77665502.help.text
msgid "Next"
msgstr "Seguinte"

#: main.xhp#par_id77665502b.help.text
#: main.xhp%23par_id77665502b.help.text
msgid ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:PBNext\">The wizard saves the "
"current settings and goes to the next page. Once you reach the last page, "
"this button will become inactive.</ahelp>"
msgstr ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:PBNext\">O assistente guarda as "
"definições actuais e vai para a próxima página. Quando chegar à última "
"página este botão ficará inactivo.</ahelp>"

#: main.xhp#hd_id77665503.help.text
#: main.xhp%23hd_id77665503.help.text
msgid "Finish"
msgstr "Terminar"

#: main.xhp#par_id7766550b.help.text
#: main.xhp%23par_id7766550b.help.text
msgid ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:PBFinish\">According to your "
"selections, the Presentation Minimizer will optimize the size of the "
"presentation.</ahelp>"
msgstr ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:PBFinish\">De acordo com as suas "
"selecções, o programa optimizará o tamanho da apresentação.</ahelp>"

#: main.xhp#par_id77665504.help.text
#: main.xhp%23par_id77665504.help.text
msgid ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:PBCancel\">Cancels the wizard "
"without performing any optimization in the presentation size.</ahelp>"
msgstr ""
"<ahelp hid=\"hid/sdext:Minimizer:Wizard:PBCancel\">Cancela o assistente sem "
"efectuar nenhuma optimização ao tamanho da apresentação.</ahelp>"

