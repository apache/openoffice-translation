#: WikiExtension.xcu#.WikiExtension.Strings.GeneralSendError.value.text
#: WikiExtension.xcu%23.WikiExtension.Strings.GeneralSendError.value.text
msgid "The operation 'Send to MediaWiki' could not be completed successfully."
msgstr "Impossível concluir a operação 'Enviar para MediaWiki' com êxito."

#: WikiExtension.xcu#.WikiExtension.Strings.NoWikiFilter.value.text
#: WikiExtension.xcu%23.WikiExtension.Strings.NoWikiFilter.value.text
msgid ""
"The MediaWiki export filter cannot be found. Choose 'Tools-XML Filter "
"Settings' to install the filter, or use the setup to install the component."
msgstr ""
"Impossível localizar o filtro de exportação do MediaWiki. Escolha "
"'Ferramentas - Definições de filtro XML' para instalar o filtro ou use a "
"configuração para instalar o componente."

#: WikiExtension.xcu#.WikiExtension.Strings.NoConnectionToURL.value.text
#: WikiExtension.xcu%23.WikiExtension.Strings.NoConnectionToURL.value.text
msgid "A connection to the MediaWiki system at '$ARG1' could not be created."
msgstr "Impossível criar uma ligação para o sistema MediaWiki em '$ARG1'."

#: WikiExtension.xcu#.WikiExtension.Strings.WrongLogin.value.text
#: WikiExtension.xcu%23.WikiExtension.Strings.WrongLogin.value.text
msgid ""
"User name or password is incorrect. Please try again, or leave the fields "
"blank for an anonymous connection."
msgstr ""
"Senha ou utilizador incorrectos. Tente novamente ou deixe os campos em "
"branco para uma ligação anónima."

#: WikiExtension.xcu#.WikiExtension.Strings.InvalidURL.value.text
#: WikiExtension.xcu%23.WikiExtension.Strings.InvalidURL.value.text
msgid "A connection could not be created because the URL is invalid."
msgstr "Impossível criar uma ligação porque o URL não é válido."

#: WikiExtension.xcu#.WikiExtension.Strings.NoURL.value.text
#: WikiExtension.xcu%23.WikiExtension.Strings.NoURL.value.text
msgid "Specify a MediaWiki server by providing a URL."
msgstr "Especifique um servidor MediaWiki fornecendo um URL."

#: WikiExtension.xcu#.WikiExtension.Strings.CancelSending.value.text
#: WikiExtension.xcu%23.WikiExtension.Strings.CancelSending.value.text
msgid ""
"The transfer has been interrupted. Please check the integrity of the wiki "
"article."
msgstr ""
"A transferência foi interrompida. Verifique a integridade do artigo da wiki."

