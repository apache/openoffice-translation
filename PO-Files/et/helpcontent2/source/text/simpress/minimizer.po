"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:RBLossless\">Lossless "
"compression.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:RBLossless\">Kadudeta "
"pakkimine.</ahelp>"

#: step3.xhp#hd_id77665502.help.text
#: step3.xhp%23hd_id77665502.help.text
msgid "JPEG compression"
msgstr "JPEG pakkimine"

#: step3.xhp#par_id77665503i.help.text
#: step3.xhp%23par_id77665503i.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:RBJPEG\">Compress JPEG "
"graphics.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:RBJPEG\">Paki JPEG "
"graafika.</ahelp>"

#: step3.xhp#hd_id77665503.help.text
#: step3.xhp%23hd_id77665503.help.text
msgid "Quality in percent"
msgstr "Kvaliteet protsentides"

#: step3.xhp#par_id77665503j.help.text
#: step3.xhp%23par_id77665503j.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:MFQuality\">Specify the quality of "
"the compression. A higher value means less compression.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:MFQuality\">Määra tihendamise "
"kvaliteet. Kõrgem väärtus tähendab väiksemat tihendust.</ahelp>"

#: step3.xhp#hd_id77665504.help.text
#: step3.xhp%23hd_id77665504.help.text
msgid "Reduce image resolution"
msgstr "Eraldusvõime vähendamine"

#: step3.xhp#par_id77665503k.help.text
#: step3.xhp%23par_id77665503k.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:LBDPI\">Specify the image "
"resolution in DPI (dots per inch).</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:LBDPI\">Määra pildi resolutsioon "
"DPIdes (dots per inch ehk punkti tolli kohta).</ahelp>"

#: step3.xhp#hd_id77665505.help.text
#: step3.xhp%23hd_id77665505.help.text
msgid "Delete cropped graphic areas"
msgstr "Kustuta kärbitud pildialad"

#: step3.xhp#par_id77665503l.help.text
#: step3.xhp%23par_id77665503l.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:CBCrop\">Delete cropped graphic "
"areas from the graphics.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:CBCrop\">Kustuta kärbitud graafika "
"alad.</ahelp>"

#: step3.xhp#hd_id77665506.help.text
#: step3.xhp%23hd_id77665506.help.text
msgid "Break links to external graphics"
msgstr "Katkesta lingid välisele graafikale"

#: step3.xhp#par_id77665503m.help.text
#: step3.xhp%23par_id77665503m.help.text
