msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step2:LBCustomShow\">See loend kuvab "
"kõik slaidid, mis ei ole kohandatud slaidiseansil kasutatud.</ahelp>"

#: step2.xhp#hd_id77665505.help.text
#: step2.xhp%23hd_id77665505.help.text
msgid "Clear notes"
msgstr "Tühjenda märkmed"

#: step2.xhp#par_id77665503g.help.text
