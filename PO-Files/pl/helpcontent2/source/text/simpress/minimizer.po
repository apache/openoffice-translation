msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:RBJPEG\">Kompresuj obrazy "
"JPEG.</ahelp>"

#: step3.xhp#hd_id77665503.help.text
#: step3.xhp%23hd_id77665503.help.text
msgid "Quality in percent"
msgstr "Jakość w procentach"

#: step3.xhp#par_id77665503j.help.text
#: step3.xhp%23par_id77665503j.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:MFQuality\">Specify the quality of "
"the compression. A higher value means less compression.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:MFQuality\">Określ jakość "
"kompresji. Wyższa wartość oznacza słabszą kompresję.</ahelp>"

#: step3.xhp#hd_id77665504.help.text
#: step3.xhp%23hd_id77665504.help.text
msgid "Reduce image resolution"
msgstr "Zmniejsz rozdzielczość obrazów"

#: step3.xhp#par_id77665503k.help.text
#: step3.xhp%23par_id77665503k.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:LBDPI\">Specify the image "
"resolution in DPI (dots per inch).</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:LBDPI\">Określ rozdzielczość "
"obrazu w DPI (punkty na cal).</ahelp>"

#: step3.xhp#hd_id77665505.help.text
#: step3.xhp%23hd_id77665505.help.text
msgid "Delete cropped graphic areas"
msgstr "Usuń przycięte obszary rysunków"

#: step3.xhp#par_id77665503l.help.text
#: step3.xhp%23par_id77665503l.help.text
msgid ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:CBCrop\">Delete cropped graphic "
"areas from the graphics.</ahelp>"
msgstr ""
"<ahelp hid=\"sdext:Minimizer:Wizard:Step3:CBCrop\">Usuń z grafiki przycięte "
"obszary.</ahelp>"

#: step3.xhp#hd_id77665506.help.text
#: step3.xhp%23hd_id77665506.help.text
