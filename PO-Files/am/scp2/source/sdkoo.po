#: module_sdkoo.ulf#STR_NAME_MODULE_OPTIONAL_SDKOO.LngText.text
#: module_sdkoo.ulf%23STR_NAME_MODULE_OPTIONAL_SDKOO.LngText.text
msgid "Software Development Kit (SDK)"
msgstr "የ ሶፍትዌር ማበልጸጊያ መሳሪያ (SDK)"

#: module_sdkoo.ulf#STR_DESC_MODULE_OPTIONAL_SDKOO.LngText.text
#: module_sdkoo.ulf%23STR_DESC_MODULE_OPTIONAL_SDKOO.LngText.text
msgid ""
"The SDK provides all necessary tools, examples and documentation to program "
"with and for the office."
msgstr ""
"የ ሶፍትዌር ማበልጸጊያ መሳሪያ SDK ለ ፕሮግራሙ እና ለ ቢሮ ምሳሌዎች እና ሰነዶች አስፈላጊውን መሳሪያዎች ያቀርባል"
