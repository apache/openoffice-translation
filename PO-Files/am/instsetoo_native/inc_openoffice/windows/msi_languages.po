#: SIS.ulf#OOO_SIS_TITLE.LngText.text
#: SIS.ulf%23OOO_SIS_TITLE.LngText.text
msgid "Installation database"
msgstr "ዳታቤዝ መግጠሚያ"

#: SIS.ulf#OOO_SIS_AUTHOR.LngText.text
#: SIS.ulf%23OOO_SIS_AUTHOR.LngText.text
msgid "Author"
msgstr "ደራሲ"

#: SIS.ulf#OOO_SIS_SUBJECT.LngText.text
#: SIS.ulf%23OOO_SIS_SUBJECT.LngText.text
msgid "Subject"
msgstr "ጉዳዩ"

#: SIS.ulf#OOO_SIS_COMMENT.LngText.text
#: SIS.ulf%23OOO_SIS_COMMENT.LngText.text
msgid "Comment"
msgstr "አስተያየት"

#: SIS.ulf#OOO_SIS_KEYWORDS.LngText.text
#: SIS.ulf%23OOO_SIS_KEYWORDS.LngText.text
msgid "Install,MSI"
msgstr "መግጠሚያ, MSI"

#: SIS.ulf#OOO_SIS_APPNAME.LngText.text
#: SIS.ulf%23OOO_SIS_APPNAME.LngText.text
msgid "Windows Installer"
msgstr "መስኮት መግጠሚያ"

#: LaunchCo.ulf#OOO_LAUNCH_1.LngText.text
#: LaunchCo.ulf%23OOO_LAUNCH_1.LngText.text
msgid ""
"The Installation Wizard cannot be run properly because you are logged in as "
"a user without sufficient administrator rights for this system."
msgstr ""
"የ መግጠሚያው እረዳት በትክክል ማስኬድ አልተቻለም: እርስዎ የገቡበት የ ተጠቃሚ ስም በቂ የሆነ የ አስተዳዳሪ ፍቃድ ለ "
"ስርአቱ የለውም:"

#: LaunchCo.ulf#OOO_LAUNCH_2.LngText.text
#: LaunchCo.ulf%23OOO_LAUNCH_2.LngText.text
msgid "Please use the file setup.exe to start the installation."
msgstr "እባክዎን ይህን ፋይል ይጠቀሙ: setup.exe መግጠሚያውን ለ ማስጀመር:"

#: Error.ulf#OOO_ERROR_1.LngText.text
#: Error.ulf%23OOO_ERROR_1.LngText.text
msgid "{{Fatal error: }}"
msgstr "{{አደገኛ ስህተት: }}"

#: Error.ulf#OOO_ERROR_2.LngText.text
#: Error.ulf%23OOO_ERROR_2.LngText.text
msgid "Error [1]."
msgstr "ስህተት [1] ."

#: Error.ulf#OOO_ERROR_3.LngText.text
#: Error.ulf%23OOO_ERROR_3.LngText.text
msgid "Warning [1]."
msgstr "ማስጠንቀቂያ [1] ."

#: Error.ulf#OOO_ERROR_4.LngText.text
#: Error.ulf%23OOO_ERROR_4.LngText.text
msgid "Info [1]."
msgstr "መረጃ [1]."

#: Error.ulf#OOO_ERROR_5.LngText.text
#: Error.ulf%23OOO_ERROR_5.LngText.text
msgid "Internal Error [1]. [2]{, [3]}{, [4]}"
msgstr "የ ውስጥ ስህተት [1]. [2]{, [3]}{, [4]}"

#: Error.ulf#OOO_ERROR_6.LngText.text
#: Error.ulf%23OOO_ERROR_6.LngText.text
msgid "{{Disk full: }}"
msgstr "{{ዲስኩ ሞልቷል: }}"

#: Error.ulf#OOO_ERROR_7.LngText.text
#: Error.ulf%23OOO_ERROR_7.LngText.text
msgid "Action [Time]: [1]. [2]"
msgstr "ተግባር [Time]: [1]. [2]"

#: Error.ulf#OOO_ERROR_8.LngText.text
#: Error.ulf%23OOO_ERROR_8.LngText.text
msgid "[ProductName]"
msgstr "[ProductName]"

#: Error.ulf#OOO_ERROR_9.LngText.text
#: Error.ulf%23OOO_ERROR_9.LngText.text
msgid "{[2]}{, [3]}{, [4]}"
msgstr "{[2]}{, [3]}{, [4]}"

#: Error.ulf#OOO_ERROR_10.LngText.text
#: Error.ulf%23OOO_ERROR_10.LngText.text
msgid "Message type: [1], Argument: [2]"
msgstr "የ መልእክት አይነት: [1], ክርክር : [2]"

#: Error.ulf#OOO_ERROR_11.LngText.text
#: Error.ulf%23OOO_ERROR_11.LngText.text
msgid "=== Logging started: [Date]  [Time] ==="
msgstr "=== መግባት የተጀመረው: [Date]  [Time] ==="

#: Error.ulf#OOO_ERROR_12.LngText.text
#: Error.ulf%23OOO_ERROR_12.LngText.text
msgid "=== Logging stopped: [Date]  [Time] ==="
msgstr "=== መግባት የቆመው: [Date]  [Time] ==="

#: Error.ulf#OOO_ERROR_13.LngText.text
#: Error.ulf%23OOO_ERROR_13.LngText.text
msgid "Action start [Time]: [1]."
msgstr "ተግባሩ የተጀመረው [Time]: [1]."

#: Error.ulf#OOO_ERROR_14.LngText.text
#: Error.ulf%23OOO_ERROR_14.LngText.text
msgid "Action ended [Time]: [1]. Return value [2]."
msgstr "ተግባሩ የተጨረሰው [Time]: [1]. Return value [2]."

#: Error.ulf#OOO_ERROR_15.LngText.text
#: Error.ulf%23OOO_ERROR_15.LngText.text
msgid "Time remaining: {[1] minutes }{[2] seconds}"
msgstr "ቀሪው ሰአት: {[1] minutes }{[2] seconds}"

#: Error.ulf#OOO_ERROR_16.LngText.text
#: Error.ulf%23OOO_ERROR_16.LngText.text
msgctxt "Error.ulf#OOO_ERROR_16.LngText.text"
msgid "Out of memory. Shut down other applications before retrying."
msgstr "Out of memory. እንደገና ከመሞከርዎት በፊት ሌሎች መተግበሪያዎችን በሙሉ ይዝጉ"

#: Error.ulf#OOO_ERROR_17.LngText.text
#: Error.ulf%23OOO_ERROR_17.LngText.text
msgid "Installer is no longer responding."
msgstr "መግጠሚያው መልስ አይሰጥም"

#: Error.ulf#OOO_ERROR_18.LngText.text
#: Error.ulf%23OOO_ERROR_18.LngText.text
msgid "Installer terminated prematurely."
msgstr "መግጠሚያው በድንገት ተቋርጧል"

#: Error.ulf#OOO_ERROR_19.LngText.text
#: Error.ulf%23OOO_ERROR_19.LngText.text
msgid "Please wait while Windows configures [ProductName]"
msgstr "እባክዎን ይቆዩ መስኮት እስከሚያዋቅር [ProductName]"

#: Error.ulf#OOO_ERROR_20.LngText.text
#: Error.ulf%23OOO_ERROR_20.LngText.text
msgid "Gathering required information..."
msgstr "የሚያስፈልገውን መረጃ በ ማሰባሰብ ላይ..."

#: Error.ulf#OOO_ERROR_21.LngText.text
#: Error.ulf%23OOO_ERROR_21.LngText.text
msgid "Removing older versions of this application"
msgstr "የዚህን መተግበሪያ አሮጌ እትም በ ማስወገድ ላይ"

#: Error.ulf#OOO_ERROR_22.LngText.text
#: Error.ulf%23OOO_ERROR_22.LngText.text
msgid "Preparing to remove older versions of this application"
msgstr "የዚህን መተግበሪያ አሮጌ እትም ለ ማስወገድ በ መሰናዳት ላይ"

#: Error.ulf#OOO_ERROR_23.LngText.text
#: Error.ulf%23OOO_ERROR_23.LngText.text
msgid "{[ProductName] }Setup completed successfully."
msgstr "{[ProductName] }ማሰናጃው በሚገባ ተሳክቶ ተፈጽሟል"

#: Error.ulf#OOO_ERROR_24.LngText.text
#: Error.ulf%23OOO_ERROR_24.LngText.text
msgid "{[ProductName] }Setup failed."
msgstr "{[ProductName] }ማሰናዳት አልተቻለም"

#: Error.ulf#OOO_ERROR_25.LngText.text
#: Error.ulf%23OOO_ERROR_25.LngText.text
msgid ""
"Error reading from file: [2]. {{ System error [3].}}  Verify that the file "
"exists and that you can access it."
msgstr ""
"ስህተት ፋይሉን በማንበብ ላይ: [2]. {{ የስርአት ስህተት [3].}}   ይህ ፋይል መኖሩን እና ለመጠቀም ፍቃድ "
"እንዳለዎት በቅድሚያ ያረጋግጡ"

#: Error.ulf#OOO_ERROR_26.LngText.text
#: Error.ulf%23OOO_ERROR_26.LngText.text
msgid ""
"Cannot create the file [3]. A directory with this name already exists. "
"Cancel the installation and try installing to a different location."
msgstr ""
"ፋይሉን መፍጠር አልተቻለም [3]. በዚህ ስም ቀደም ሲል ዳይሬክቶሪ ነበር: መግጠሙን ይሰርዙ እና በሌላ አካባቢ እንደገና "
"ለመግጠም ይሞክሩ"

#: Error.ulf#OOO_ERROR_27.LngText.text
#: Error.ulf%23OOO_ERROR_27.LngText.text
msgid "Please insert the disk: [2]"
msgstr "እባክዎን ዲስኩን ያስገቡ: [2]"

#: Error.ulf#OOO_ERROR_28.LngText.text
#: Error.ulf%23OOO_ERROR_28.LngText.text
msgid ""
"The installer has insufficient privileges to access this directory: [2]. The "
"installation cannot continue.  Log on as an administrator or contact your "
"system administrator."
msgstr ""
"መግጠሚያው እዚህ ዳይሬክቶሪ ጋር ለመድረስ በቂ ፍቃድ የለውም: [2]  መግጠሙን መቀጠል አይቻልም ይቋረጣል: እንደ "
"አስተዳዳሪ መግባት አለብዎት ወይንም የ ስርአት አስተዳዳሪውን ያማክሩ"

#: Error.ulf#OOO_ERROR_29.LngText.text
#: Error.ulf%23OOO_ERROR_29.LngText.text
msgid ""
"Error writing to file [2]. Verify that you have access to that directory."
msgstr "ስህተት ፋይሉ ላይ በመጻፍ [2]. ዳይሬክቶሪውን ለ መጠቀም ፍቃድ እንዳለዎት በቅድሚያ ያረጋግጡ"

#: Error.ulf#OOO_ERROR_30.LngText.text
#: Error.ulf%23OOO_ERROR_30.LngText.text
msgid ""
"Error reading from file [2]. Verify that the file exists and that you can "
"access it."
msgstr "ስህተት ፋይሉን በማንበብ ላይ [2]. ይህ ፋይል መኖሩን እና ለ መጠቀም ፍቃድ እንዳለዎት በቅድሚያ ያረጋግጡ"

#: Error.ulf#OOO_ERROR_31.LngText.text
#: Error.ulf%23OOO_ERROR_31.LngText.text
msgid ""
"Another application has exclusive access to the file [2]. Please shut down "
"all other applications, then click Retry."
msgstr ""
"ሌላ መተግበሪያ ሙሉ በሙሉ ወደ ፋይሉ ጋር ለመድረስ ፍቃድ አለው [2]. እባክዎን ሌሎች መተግበሪያዎችን በሙሉ ይዝጉ እና "
"እንደገና ይሞክሩ"

#: Error.ulf#OOO_ERROR_32.LngText.text
#: Error.ulf%23OOO_ERROR_32.LngText.text
msgid ""
"There is not enough disk space to install the file [2]. Free some disk space "
"and click Retry, or click Cancel to exit."
msgstr ""
"ፋይሉን ለ መግጠም በቂ የሆነ የ ዲስክ ቦታ የለም [2]. ትንሽ የ ዲስክ ቦታ ነፃ ያድርጉ እና እንደገና ይሞክሩ ወይንም "
"መሰረዣ የሚለውን ይጫኑ ዘግቶ ለ መውጣት"

#: Error.ulf#OOO_ERROR_33.LngText.text
#: Error.ulf%23OOO_ERROR_33.LngText.text
msgid ""
"Source file not found: [2]. Verify that the file exists and that you can "
"access it."
msgstr "የ ፋይሉ ምንጭ አልተገኘም: [2]. ይህ ፋይል መኖሩን እና ለ መጠቀም ፍቃድ እንዳለዎት በቅድሚያ ያረጋግጡ"

#: Error.ulf#OOO_ERROR_34.LngText.text
#: Error.ulf%23OOO_ERROR_34.LngText.text
msgid ""
"Error reading from file: [3]. {{ System error [2].}} Verify that the file "
"exists and that you can access it."
msgstr ""
"ስህተት ፋይሉን በ ማንበብ ላይ: [3]. {{ የ ስርአት ስህተት [2].}} ይህ ፋይል መኖሩን እና ለ መጠቀም ፍቃድ "
"እንዳለዎት በቅድሚያ ያረጋግጡ"

#: Error.ulf#OOO_ERROR_35.LngText.text
#: Error.ulf%23OOO_ERROR_35.LngText.text
msgid ""
"Error writing to file: [3]. {{ System error [2].}} Verify that you have "
"access to that directory."
msgstr ""
"ስህተት ፋይሉ ላይ መጻፍአልተቻለም: [3]. {{ የ ስርአት ስህተት [2].}} ዳይሬክቶሪው ጋር ለ መድረስ ፍቃድ "
"እንዳለዎት በቅድሚያ ያረጋግጡ"

#: Error.ulf#OOO_ERROR_36.LngText.text
#: Error.ulf%23OOO_ERROR_36.LngText.text
msgid ""
"Source file not found{{(cabinet)}}: [2]. Verify that the file exists and "
"that you can access it."
msgstr ""
"የ ፋይሉ ምንጭ አልተገኘም {{(cabinet)}}: [2]. ይህ ፋይል መኖሩን እና ለ መጠቀም ፍቃድ እንዳለዎት በቅድሚያ "
"ያረጋግጡ"

#: Error.ulf#OOO_ERROR_37.LngText.text
#: Error.ulf%23OOO_ERROR_37.LngText.text
msgid ""
"Cannot create the directory [2]. A file with this name already exists. "
"Please rename or remove the file and click Retry, or click Cancel to exit."
msgstr ""
"ዳይሬክቶሪውን መፍጠር አልተቻለም: [2]. በዚህ ስም ፋይል ቀደም ሲል ነበር: እባክዎን ፋይሉን እንደገና ይሰይሙ ወይንም "
"ያስወግዱ እና እንደገና ይሞክሩ ወይንም መሰረዣን ይጫኑ ዘግቶ ለ መውጣት"

#: Error.ulf#OOO_ERROR_38.LngText.text
#: Error.ulf%23OOO_ERROR_38.LngText.text
msgid "The volume [2] is currently unavailable. Please select another."
msgstr "ይህ መጠን [2] አሁን ዝግጁ አይደለም: እባክዎን ሌላ ይምረጡ"

#: Error.ulf#OOO_ERROR_39.LngText.text
#: Error.ulf%23OOO_ERROR_39.LngText.text
msgid "The specified path [2] is unavailable."
msgstr "የተወሰነው መንገድ [2] ዝግጁ አይደለም"

#: Error.ulf#OOO_ERROR_40.LngText.text
#: Error.ulf%23OOO_ERROR_40.LngText.text
msgid "Unable to write to the specified folder [2]."
msgstr "ወደ ተወሰነው ፎልደር መጻፍ አልተቻለም [2]."

#: Error.ulf#OOO_ERROR_41.LngText.text
#: Error.ulf%23OOO_ERROR_41.LngText.text
msgid "A network error occurred while attempting to read from the file [2]"
msgstr "የ ኔትዎርክ ስህተት ተፈጥሯል ከ ፋይል ላይ ለ ማንበብ በ መሞከር ላይ እንዳለ [2]"

#: Error.ulf#OOO_ERROR_42.LngText.text
#: Error.ulf%23OOO_ERROR_42.LngText.text
msgid "An error occurred while attempting to create the directory [2]"
msgstr "ስህተት ተፈጥሯል ዳይሬክቶሪውን ለ መፍጠር በ መሞከር ላይ እንዳለ [2]"

#: Error.ulf#OOO_ERROR_43.LngText.text
#: Error.ulf%23OOO_ERROR_43.LngText.text
msgid "A network error occurred while attempting to create the directory [2]"
msgstr "የ ኔትዎርክ ስህተት ተፈጥሯል ዳይሬክቶሪውን ለ መፍጠር በ መሞከር ላይ እንዳለ [2]"

#: Error.ulf#OOO_ERROR_44.LngText.text
#: Error.ulf%23OOO_ERROR_44.LngText.text
msgid ""
"A network error occurred while attempting to open the source file cabinet "
"[2]."
msgstr "የ ኔትዎርክ ስህተት ተፈጥሯል የ ፋይል ካቢኔት ምንጭ ለ መክፈት በ መሞከር ላይ እንዳለ [2]"

#: Error.ulf#OOO_ERROR_45.LngText.text
#: Error.ulf%23OOO_ERROR_45.LngText.text
msgid "The specified path is too long [2]."
msgstr "የተወሰነው መንገድ በጣም እረጅም ነው [2]."

#: Error.ulf#OOO_ERROR_46.LngText.text
#: Error.ulf%23OOO_ERROR_46.LngText.text
msgid "The Installer has insufficient privileges to modify the file [2]."
msgstr "መግጠሚያው ፋይሉን ለ ማሻሻል በቂ ፍቃድ የለውም [2]."

#: Error.ulf#OOO_ERROR_47.LngText.text
#: Error.ulf%23OOO_ERROR_47.LngText.text
msgid "A portion of the path [2] exceeds the length allowed by the system."
msgstr "በ ከፊል መንገዱ [2] ስርአቱ ከሚፈቅደው እርዝመት በላይ አልፏል"

#: Error.ulf#OOO_ERROR_48.LngText.text
#: Error.ulf%23OOO_ERROR_48.LngText.text
msgid "The path [2] contains words that are not valid in folders."
msgstr "መንገዱ [2] በ ፎልደር ውስጥ ዋጋ የሌላቸውን ቃላቶች ይዟል"

#: Error.ulf#OOO_ERROR_49.LngText.text
#: Error.ulf%23OOO_ERROR_49.LngText.text
msgid "The path [2] contains an invalid character."
msgstr "መንገዱ [2] ዋጋ የሌላቸውን ባህሪዎች ይዟል"

#: Error.ulf#OOO_ERROR_50.LngText.text
#: Error.ulf%23OOO_ERROR_50.LngText.text
msgid "[2] is not a valid short file name."
msgstr "[2] ዋጋ ያለው አጭር የ ፋይል ስም አይደለም"

#: Error.ulf#OOO_ERROR_51.LngText.text
#: Error.ulf%23OOO_ERROR_51.LngText.text
msgid "Error getting file security: [3] GetLastError: [2]"
msgstr "ስህተት የ ፋይል ደህንነት በማግኘት ላይ: [3] የ መጨረሻውን ስህተት አግኝ: [2]"

#: Error.ulf#OOO_ERROR_52.LngText.text
#: Error.ulf%23OOO_ERROR_52.LngText.text
msgid "Invalid Drive: [2]"
msgstr "ዋጋ የሌለው አካል: [2]"

#: Error.ulf#OOO_ERROR_53.LngText.text
#: Error.ulf%23OOO_ERROR_53.LngText.text
msgid ""
"Error applying patch to file [2]. It has probably been updated by other "
"means, and can no longer be modified by this patch.  For more information "
"contact your patch vendor. {{System Error: [3]}}"
msgstr ""
"ስህተት patch ወደ ፋይል መፈጸም አልተቻለም [2]. ምናልባት በሌላ መንገድ ተሻሽሎ ሊሆን ይችላል: እና በዚህ "
"patch ማሻሻል አይቻልም: በበለጠ ለመረዳታ የ patch vendor ያማክሩ  {{የስርአት ስህተት: [3]}}"

#: Error.ulf#OOO_ERROR_54.LngText.text
#: Error.ulf%23OOO_ERROR_54.LngText.text
msgid ""
"Could not create key [2]. {{ System error [3].}} Verify that you have "
"sufficient access to that key, or contact your support personnel."
msgstr ""
"ቁልፍ መፍጠር አልተቻለም [2]. {{ የ ስርአት ስህተት [3].}} ለ ቁልፉ በቂ ፍቃድ እንዳለዎት ያረጋግጡ ወይንም የ "
"ስርአቱን አስተዳዳሪ ያማክሩ"

#: Error.ulf#OOO_ERROR_55.LngText.text
#: Error.ulf%23OOO_ERROR_55.LngText.text
msgid ""
"Could not open key: [2]. {{ System error [3].}} Verify that you have "
"sufficient access to that key, or contact your support personnel."
msgstr ""
"ቁልፉን መክፈት አልተቻለም: [2]. {{ የ ስርአት ስህተት [3].}} ለ ቁልፉ በቂ ፍቃድ እንዳለዎት ያረጋግጡ ወይንም "
"የ ስርአቱን አስተዳዳሪ ያማክሩ"

#: Error.ulf#OOO_ERROR_56.LngText.text
#: Error.ulf%23OOO_ERROR_56.LngText.text
msgid ""
"Could not delete value [2] from key [3]. {{ System error [4].}} Verify that "
"you have sufficient access to that key, or contact your support personnel."
msgstr ""
"ዋጋውን ማጥፋት አልተቻለም [2] ከ ቁልፉ [3]. {{ የ ስርአት ስህተት [4].}} ለ ቁልፉ በቂ ፍቃድ እንዳለዎት "
"ያረጋግጡ ወይንም የ ስርአቱን አስተዳዳሪ ያማክሩ"

#: Error.ulf#OOO_ERROR_57.LngText.text
#: Error.ulf%23OOO_ERROR_57.LngText.text
msgid ""
"Could not delete key [2]. {{ System error [3].}} Verify that you have "
"sufficient access to that key, or contact your support personnel."
msgstr ""
"ቁልፉን ማጥፋት አልተቻለም [2]. {{ የ ስርአት ስህተት [3].}} ለ ቁልፉ በቂ ፍቃድ እንዳለዎት ያረጋግጡ ወይንም የ "
"ስርአቱን አስተዳዳሪ ያማክሩ"

#: Error.ulf#OOO_ERROR_58.LngText.text
#: Error.ulf%23OOO_ERROR_58.LngText.text
msgid ""
"Could not read value [2] from key [3]. {{ System error [4].}} Verify that "
"you have sufficient access to that key, or contact your support personnel."
msgstr ""
"ዋጋውን ማንበብ አልተቻለም [2] ከ ቁልፉ [3]. {{ የ ስርአት ስህተት [4].}} ለ ቁልፉ በቂ ፍቃድ እንዳለዎት "
"ያረጋግጡ ወይንም የ ስርአቱን አስተዳዳሪ ያማክሩ"

#: Error.ulf#OOO_ERROR_59.LngText.text
#: Error.ulf%23OOO_ERROR_59.LngText.text
msgid ""
"Could not write value [2] to key [3]. {{ System error [4].}} Verify that you "
"have sufficient access to that key, or contact your support personnel."
msgstr ""
"ዋጋውን መጻፍ አልተቻለም [2] ወደ ቁልፉ [3]. {{ የ ስርአት ስህተት [4].}} ለ ቁልፉ በቂ ፍቃድ እንዳለዎት "
"ያረጋግጡ ወይንም የ ስርአቱን አስተዳዳሪ ያማክሩ"

#: Error.ulf#OOO_ERROR_60.LngText.text
#: Error.ulf%23OOO_ERROR_60.LngText.text
msgid ""
"Could not get value names for key [2]. {{ System error [3].}} Verify that "
"you have sufficient access to that key, or contact your support personnel."
msgstr ""
"ለ ቁልፉ የ ዋጋ ስሞች ማግኘት አልተቻለም [2]. {{ የስርአት ስህተት [3].}} ለቁልፉ በቂ ፍቃድ እንዳለዎት "
"ያረጋግጡ ወይንም የ ስርአቱን አስተዳዳሪ ያማክሩ:"

#: Error.ulf#OOO_ERROR_61.LngText.text
#: Error.ulf%23OOO_ERROR_61.LngText.text
msgid ""
"Could not get sub key names for key [2]. {{ System error [3].}} Verify that "
"you have sufficient access to that key, or contact your support personnel."
msgstr ""
"የ ንዑስ ቁልፉ ዋጋ ስሞችን ማግኘት አልተቻለም [2]. {{ የ ስርአት ስህተት [3].}} ለ ቁልፉ በቂ ፍቃድ እንዳለዎት "
"ያረጋግጡ ወይንም የ ስርአቱን አስተዳዳሪ ያማክሩ:"

#: Error.ulf#OOO_ERROR_62.LngText.text
#: Error.ulf%23OOO_ERROR_62.LngText.text
msgid ""
"Could not read security information for key [2]. {{ System error [3].}} "
"Verify that you have sufficient access to that key, or contact your support "
"personnel."
msgstr ""
"ለ ቁልፉ የ ደህንነት መረጃውን ማንበብ አልተቻለም [2]. {{ የ ስርአት ስህተት [3].}} ለ ቁልፉ በቂ ፍቃድ "
"እንዳለዎት ያረጋግጡ ወይንም የ ስርአቱን አስተዳዳሪ ያማክሩ:"

#: Error.ulf#OOO_ERROR_63.LngText.text
#: Error.ulf%23OOO_ERROR_63.LngText.text
msgid ""
"Could not increase the available registry space. [2] KB of free registry "
"space is required for the installation of this application."
msgstr ""
"ዝግጁ የ መመዝገቢያ ቦታውን መጨመር አልተቻለም [2] ኪባ ከ ነፃ መመዝገቢያው ቦታ ያስፈልጋል መተግበሪያውን ለ መግጠም:"

#: Error.ulf#OOO_ERROR_64.LngText.text
#: Error.ulf%23OOO_ERROR_64.LngText.text
msgid ""
"Another installation is in progress. You must complete that installation "
"before continuing this one."
msgstr "ሌላ መግጠሚያ በ ሂደት ላይ ነው: በቅድሚያ ያንን መግጠሚያ መጨረስ አለብዎት አዲስ መግጠሚያ ከ መጀመርዎት በፊት"

#: Error.ulf#OOO_ERROR_65.LngText.text
#: Error.ulf%23OOO_ERROR_65.LngText.text
msgid ""
"Error accessing secured data. Please make sure the Windows Installer is "
"configured properly and try the installation again."
msgstr ""
"ስህተት አሰማማኝ ዳታ ጋር ለ መድረስ አልተቻለም: እባክዎን የ መስኮት መግጠሚያ በ ትክክል መዋቀሩን ያረጋግጡ እና "
"መግጠሙን በኋላ ይሞክሩ:"

#: Error.ulf#OOO_ERROR_66.LngText.text
#: Error.ulf%23OOO_ERROR_66.LngText.text
msgid ""
"User [2] has previously initiated an installation for product [3]. That user "
"will need to run that installation again before using that product. Your "
"current installation will now continue."
msgstr ""
"ተጠቃሚ [2] ቀደም ሲል ለ እቃው መግጠሚያ አስነስቶ ነበር [3]. ተጠቃሚው መግጠሚያውን እንደገና ማስኬድ አለበት "
"እቃውን ከ መጠቀሙ በፊት: የ አሁኑ መግጠሚያ አሁን ይቀጥላል"

#: Error.ulf#OOO_ERROR_67.LngText.text
#: Error.ulf%23OOO_ERROR_67.LngText.text
msgid ""
"User [2] has previously initiated an installation for product [3]. That user "
"will need to run that installation again before using that product."
msgstr ""
"ተጠቃሚ [2] ቀደም ሲል ለ እቃው መግጠሚያ አስነስቶ ነበር [3]. ተጠቃሚው መግጠሚያውን እንደገና ማስኬድ አለበት "
"እቃውን ከ መጠቀሙ በፊት: የ አሁኑ መግጠሚያ አሁን ይቀጥላል"

#: Error.ulf#OOO_ERROR_68.LngText.text
#: Error.ulf%23OOO_ERROR_68.LngText.text
msgid ""
"Out of disk space -- Volume: '[2]'; required space: [3] KB; available space: "
"[4] KB. Free some disk space and retry."
msgstr ""
"የ ዲስክ ቦታ የለም -- መጠን : '[2]'; የሚያስፈልገው ቦታ: [3] ኪባ; ዝግጁ ቦታ: [4] ኪባ . ትንሽ የ ዲስክ "
"ቦታ ነፃ ያድርጉና እንደገና ይሞክሩ"

#: Error.ulf#OOO_ERROR_69.LngText.text
#: Error.ulf%23OOO_ERROR_69.LngText.text
msgid "Are you sure you want to cancel?"
msgstr "እርስዎ በ እርግጥ መሰረዝ ይፈልጋሉ?"

#: Error.ulf#OOO_ERROR_70.LngText.text
#: Error.ulf%23OOO_ERROR_70.LngText.text
msgid ""
"The file [2][3] is being held in use {by the following process: Name: [4], "
"ID: [5], Window Title: [6]}. Close that application and retry."
msgstr ""
"ይህ ፋይል [2][3] ሌላ እየተጠቀመበት ነው {by the following process: Name: [4], ID: [5], "
"Window Title: [6]}. ይህን መተግበሪያ ይዝጉ እና እንደገና ይሞክሩ"

#: Error.ulf#OOO_ERROR_71.LngText.text
#: Error.ulf%23OOO_ERROR_71.LngText.text
msgid ""
"The product [2] is already installed, preventing the installation of this "
"product. The two products are incompatible."
msgstr "ይህ ውጤት [2] ቀደም ሲል ተገጥሟል ፡ ይህን ውጤት እንዳይገጠም ይከለክላል: ሁለቱ ውጤቶች የሚስማሙ አይደሉም"

#: Error.ulf#OOO_ERROR_72.LngText.text
#: Error.ulf%23OOO_ERROR_72.LngText.text
msgid ""
"Out of disk space -- Volume: [2]; required space: [3] KB; available space: "
"[4] KB. If rollback is disabled, enough space is available. Click Cancel to "
"quit, Retry to check available disk space again, or Ignore to continue "
"without rollback."
msgstr ""
"በቂ የ ዲስክ ቦታ የለም -- መጠኑ: [2]; የሚያስፈልገው ቦታ: [3] ኪ/ቢ; ያለው ቦታ: [4] ኪ/ቢ ወደ ኋላ መሄጃ "
"ከ ተሰናከለ በቂ ዝግጁ ቦታ ይኖራል: ለማቋረጥ መሰረዣን ይጫኑ: በቂ የ ዲስክ ቦታ መኖሩን ለ መመርመር እንደገና "
"መሞከሪያን ይጫኑ: ወይንም ወደ ኋላ መሄዱን ለ መሰረዝ መተውን ይጫኑ"

#: Error.ulf#OOO_ERROR_73.LngText.text
#: Error.ulf%23OOO_ERROR_73.LngText.text
msgid "Could not access network location [2]."
msgstr "የ ኔትዎርክ አካባቢ ጋር መድረስ አልተቻለም [2]."

#: Error.ulf#OOO_ERROR_74.LngText.text
#: Error.ulf%23OOO_ERROR_74.LngText.text
msgid ""
"The following applications should be closed before continuing the "
"installation:"
msgstr "የሚቀጥሉት መተግበሪያዎች መዘጋት አለባቸው መግጠሙን ከ መቀጠልዎት በፊት"

#: Error.ulf#OOO_ERROR_75.LngText.text
#: Error.ulf%23OOO_ERROR_75.LngText.text
msgid ""
"Could not find any previously installed compliant products on the machine "
"for installing this product."
msgstr "በዚህ ኮምፒዩተር ላይ ቀደም ብለው በ ተገጠሙ እቃዎች ላይ ምንም ችግር አልተገኘም"

#: Error.ulf#OOO_ERROR_76.LngText.text
#: Error.ulf%23OOO_ERROR_76.LngText.text
msgid "The key [2] is not valid. Verify that you entered the correct key."
msgstr "ይህ ቁልፍ [2] ዋጋ የለውም: ትክክለኛውን ቁልፍ ማስገባትዎን እንደገና ይመርምሩ"

#: Error.ulf#OOO_ERROR_77.LngText.text
#: Error.ulf%23OOO_ERROR_77.LngText.text
msgid ""
"The installer must restart your system before configuration of [2] can "
"continue. Click Yes to restart now or No if you plan to restart later."
msgstr ""
"መግጠሚያው ከ ማዋቀሩ በፊት ስርአቱን እንደገና ማስነሳት አለበት [2] ለ መቀጠል: አዎን ይጫኑ እንደገና ለ ማስጀመር "
"ወይንም አይ በኋላ ለ ማስጀመር"

#: Error.ulf#OOO_ERROR_78.LngText.text
#: Error.ulf%23OOO_ERROR_78.LngText.text
msgid ""
"You must restart your system for the configuration changes made to [2] to "
"take effect. Click Yes to restart now or No if you plan to restart later."
msgstr ""
"ስርአቱን እንደገና ማስጀመር ያስፈልጋል ማዋቀሪያው ለውጦቹን [2] እንዲፈጽም: ይጫኑ አዎ አሁን እንደገና ለ ማስጀመር "
"ወይንም አይ በኋላ ማስጀመር ከፈለጉ"

#: Error.ulf#OOO_ERROR_79.LngText.text
#: Error.ulf%23OOO_ERROR_79.LngText.text
msgid ""
"An installation for [2] is currently suspended.  You must undo the changes "
"made by that installation to continue. Do you want to undo those changes?"
msgstr ""
"መግጠሚያው ለ [2] አሁን ታግዷል:  በ መግጠሚያው የተቀየሩትን ለውጦች መተው አለብዎት ለ መቀጠል: ለውጦቹን መተው "
"ይፈልጋሉ?"

#: Error.ulf#OOO_ERROR_80.LngText.text
#: Error.ulf%23OOO_ERROR_80.LngText.text
msgid ""
"A previous installation for this product is in progress. You must undo the "
"changes made by that installation to continue. Do you want to undo those "
"changes?"
msgstr ""
"ለዚህ እቃ ቀደም ያለው መግጠሚያ በሂደት ላይ ነው: ለ መቀጠል በዚያ መግጠሚያ የተቀየረውን ለውጦች በሙሉ መተው አለበት: "
"ለውጦቹን መተው ይፈልጋሉ?"

#: Error.ulf#OOO_ERROR_81.LngText.text
#: Error.ulf%23OOO_ERROR_81.LngText.text
msgid ""
"No valid source could be found for product [2]. The Windows Installer cannot "
"continue."
msgstr "ለ እቃው ዋጋ ያለው ምንጭ ማግኘት አልተቻለም [2]. የ Windows መግጠሚያ መቀጠል አይችልም"

#: Error.ulf#OOO_ERROR_82.LngText.text
#: Error.ulf%23OOO_ERROR_82.LngText.text
msgid "Installation operation completed successfully."
msgstr "የ መግጠም ተግባሩ በሚገባ ተሳክቶ ተፈጽሟል"

#: Error.ulf#OOO_ERROR_83.LngText.text
#: Error.ulf%23OOO_ERROR_83.LngText.text
msgid "Installation operation failed."
msgstr "የ መግጠም ተግባሩ አልተሳካም"

#: Error.ulf#OOO_ERROR_84.LngText.text
#: Error.ulf%23OOO_ERROR_84.LngText.text
msgid "Product: [2] -- [3]"
msgstr "ውጤት: [2] -- [3]"

#: Error.ulf#OOO_ERROR_85.LngText.text
#: Error.ulf%23OOO_ERROR_85.LngText.text
msgid ""
"You may either restore your computer to its previous state or continue the "
"installation later. Would you like to restore?"
msgstr ""
"ኮምፒዩተሩን ቀደም ወዳለው ሁኔታ መመለስ አለብዎት ወይንም በኋላ መግጠሚያውን መቀጠል: እንደነበር መመለስ ይፈልጋሉ?"

#: Error.ulf#OOO_ERROR_86.LngText.text
#: Error.ulf%23OOO_ERROR_86.LngText.text
msgid ""
"An error occurred while writing installation information to disk. Check to "
"make sure enough disk space is available, and click Retry, or Cancel to end "
"the installation."
msgstr ""
"የ መግጠሚያውን መረጃ ወደ ዲስክ በ መጻፍ ላይ እንዳለ ስህተት ተፈጥሯል: እባክዎን በቂ የ ዲስክ ቦታ መኖሩን ያረጋግጡ: "
"እና ይጫኑ እንደገና መሞከሪያ ወይንም መሰረዣ የሚለውን መግጠሙን ለ መጨረስ"

#: Error.ulf#OOO_ERROR_87.LngText.text
#: Error.ulf%23OOO_ERROR_87.LngText.text
msgid ""
"One or more of the files required to restore your computer to its previous "
"state could not be found. Restoration will not be possible."
msgstr ""
"የ እርስዎን ኮምፒዩተሩ ቀደም ብሎ ወደ ነበረበት ሁኔታ ለ መመለስ አንድ ወይንም ከዚያ በላይ አስፈልጊ የሆኑ ፋይሎች "
"አልተገኙም ስለዚህ እንደነበር መመለስ አይቻልም"

#: Error.ulf#OOO_ERROR_88.LngText.text
#: Error.ulf%23OOO_ERROR_88.LngText.text
msgid ""
"[2] cannot install one of its required products. Contact your technical "
"support group. {{System Error: [3].}}"
msgstr ""
"[2] አንድ አስፈላጊ የሆነ እቃ መግጠም አልተቻለም: እባክዎን የ ቴክኒክ ቡድን ሀላፊውን ያማክሩ {{የ ስርአት ስህተት: "
"[3].}}"

#: Error.ulf#OOO_ERROR_89.LngText.text
#: Error.ulf%23OOO_ERROR_89.LngText.text
msgid ""
"The older version of [2] cannot be removed.  Contact your technical support "
"group. {{System Error [3].}}"
msgstr ""
"አሮጌውን እትም ከ [2] ማስወገድ አይቻልም:  የ ቴክኒክ ቡድን ሀላፊውን ያማክሩ {{የ ስርአት ስህተት: [3].}}"

#: Error.ulf#OOO_ERROR_90.LngText.text
#: Error.ulf%23OOO_ERROR_90.LngText.text
msgid "The path [2] is not valid. Please specify a valid path."
msgstr "መንገዱ [2] ዋጋ ያለው አይደለም: እባክዎን ዋጋ ያለው መንገድ ይምረጡ"

#: Error.ulf#OOO_ERROR_91.LngText.text
#: Error.ulf%23OOO_ERROR_91.LngText.text
msgctxt "Error.ulf#OOO_ERROR_91.LngText.text"
msgid "Out of memory. Shut down other applications before retrying."
msgstr "በቂ ማስታወሻ የለም: እንደገና ከ መሞከርዎ በፊት ሌሎች መተግበሪያዎችን በ ሙሉ ይዝጉ:"

#: Error.ulf#OOO_ERROR_92.LngText.text
#: Error.ulf%23OOO_ERROR_92.LngText.text
msgid ""
"There is no disk in drive [2]. Please insert one and click Retry, or click "
"Cancel to go back to the previously selected volume."
msgstr ""
"በ ዲስክ ማጫወቻ ውስጥ ዲስክ የለም [2]. እባክዎን አንድ ዲስክ አስገብተው እንደገና ይሞክሩ ወይንም ይጫኑ መሰረዣ "
"የሚለውን ለ መመለስ ቀደም ብለው ወደ መረጡት መጠን"

#: Error.ulf#OOO_ERROR_93.LngText.text
#: Error.ulf%23OOO_ERROR_93.LngText.text
msgid ""
"There is no disk in drive [2]. Please insert one and click Retry, or click "
"Cancel to return to the browse dialog and select a different volume."
msgstr ""
"በዲስክ ማጫወቻ ውስጥ ዲስክ የለም [2]. እባክዎን አንድ ዲስክ አስገብተው እንደገና ይሞክሩ ወይንም ይጫኑ መሰረዣ "
"የሚለውን ወደ መቃኛው ንግግር ለ መመለስ እና የተለየ መጠን ለ መምረጥ:"

#: Error.ulf#OOO_ERROR_94.LngText.text
#: Error.ulf%23OOO_ERROR_94.LngText.text
msgid ""
"The folder [2] does not exist. Please enter a path to an existing folder."
msgstr "ይህ ፎልደር [2] አልነበረም: እባክዎን ላለው ፎልደር መንገድ ያስገቡ"

#: Error.ulf#OOO_ERROR_95.LngText.text
#: Error.ulf%23OOO_ERROR_95.LngText.text
msgid "You have insufficient privileges to read this folder."
msgstr "እርስዎ ይህን ፎልደር ለ ማንበብ በቂ ፍቃድ የለዎትም:"

#: Error.ulf#OOO_ERROR_96.LngText.text
#: Error.ulf%23OOO_ERROR_96.LngText.text
msgid ""
"A valid destination folder for the installation could not be determined."
msgstr "ለ መግጠሚያው ዋጋ ያለው መድረሻ ፎልደር መወሰን አልተቻለም:"

#: Error.ulf#OOO_ERROR_97.LngText.text
#: Error.ulf%23OOO_ERROR_97.LngText.text
msgid "Error attempting to read from the source installation database: [2]."
msgstr "ስህተት ተፈጥሯል ከ መግጠሚያው ምንጭ ዳታቤዝ ለ ማንበብ በ መሞከር ላይ እንዳለ: [2]."

#: Error.ulf#OOO_ERROR_98.LngText.text
#: Error.ulf%23OOO_ERROR_98.LngText.text
msgid ""
"Scheduling reboot operation: Renaming file [2] to [3]. Must reboot to "
"complete operation."
msgstr ""
"እንደገና ማስነሻ ተግባር በማቀድ ላይ: ፋይል እንደገና በ መሰየም ላይ [2] ወደ [3]: ተግባሩን ለ መፈጸም እንደገና "
"መነሳት አለበት"

#: Error.ulf#OOO_ERROR_99.LngText.text
#: Error.ulf%23OOO_ERROR_99.LngText.text
msgid ""
"Scheduling reboot operation: Deleting file [2]. Must reboot to complete "
"operation."
msgstr "እንደገና ማስነሻ ተግባር በማቀድ ላይ: ፋይል በማጥፋት ላይ [2] ተግባሩን ለ መፈጸም እንደገና መነሳት አለበት:"

#: Error.ulf#OOO_ERROR_100.LngText.text
#: Error.ulf%23OOO_ERROR_100.LngText.text
msgid ""
"Module [2] failed to register. HRESULT [3]. Contact your support personnel."
msgstr "ክፍሉን [2] መመዝገብ አልተቻለም: HRESULT [3]. የ ቴክኒክ ቡድን ሀላፊውን ያማክሩ"

#: Error.ulf#OOO_ERROR_101.LngText.text
#: Error.ulf%23OOO_ERROR_101.LngText.text
msgid ""
"Module [2] failed to unregister. HRESULT [3]. Contact your support personnel."
msgstr "ክፍሉን [2] መመዝገብ አልተቻለም: HRESULT [3]. የ ቴክኒክ ቡድን ሀላፊውን ያማክሩ"

#: Error.ulf#OOO_ERROR_102.LngText.text
#: Error.ulf%23OOO_ERROR_102.LngText.text
msgid ""
"Failed to cache package [2]. Error: [3]. Contact your support personnel."
msgstr "ጥቅሉን cache ማድረግ አልተቻለም [2]. ስህተት [3]. የ ቴክኒክ ቡድን ሀላፊውን ያማክሩ"

#: Error.ulf#OOO_ERROR_103.LngText.text
#: Error.ulf%23OOO_ERROR_103.LngText.text
msgid ""
"Could not register font [2]. Verify that you have sufficient permissions to "
"install fonts, and that the system supports this font."
msgstr ""
"ፊደሉን መመዝገብ አልተቻለም [2]. ፊደሉን ለ መግጠም በቂ ፍቃድ እንዳለዎት እና ስርአቱ ይህን ፊደል ይደግፍ እንደሆን "
"ያረጋግጡ"

#: Error.ulf#OOO_ERROR_104.LngText.text
#: Error.ulf%23OOO_ERROR_104.LngText.text
msgid ""
"Could not unregister font [2]. Verify that you have sufficient permissions "
"to remove fonts."
msgstr "ፊደሉን አለ መመዝገብ አልተቻለም [2]. ፊደሉን ለ ማስወገድ በቂ ፍቃድ እንዳለዎት ያረጋግጡ"

#: Error.ulf#OOO_ERROR_105.LngText.text
#: Error.ulf%23OOO_ERROR_105.LngText.text
msgid ""
"Could not create shortcut [2]. Verify that the destination folder exists and "
"that you can access it."
msgstr ""
"አቋራጭ መፍጠር አልተቻለም [2]: መድረሻው ፋይል መኖሩን እና እርስዎ ፋይሉ ጋር ለመድረስ በቂ ፍቃድ እንዳለዎት ያረጋግጡ"

#: Error.ulf#OOO_ERROR_106.LngText.text
#: Error.ulf%23OOO_ERROR_106.LngText.text
msgid ""
"Could not remove shortcut [2]. Verify that the shortcut file exists and that "
"you can access it."
msgstr ""
"አቋራጩን ማስወገድ አልተቻለም [2]. የ አቋራጩ ፋይል መኖሩን እና እርስዎ ፋይሉ ጋር ለመድረስ በቂ ፍቃድ እንዳለዎት "
"ያረጋግጡ"

#: Error.ulf#OOO_ERROR_107.LngText.text
#: Error.ulf%23OOO_ERROR_107.LngText.text
msgid ""
"Could not register type library for file [2]. Contact your support personnel."
msgstr "ለ ፋይሉ የ ቤተ መጻህፍቱን አይነት መመዝገብ አልተቻለም [2]. የ ቴክኒክ ቡድን ሀላፊውን ያማክሩ"

#: Error.ulf#OOO_ERROR_108.LngText.text
#: Error.ulf%23OOO_ERROR_108.LngText.text
msgid ""
"Could not unregister type library for file [2]. Contact your support "
"personnel."
msgstr "ለ ፋይሉ የ ቤተ መጻህፍቱን አይነት አለ መመዝገብ አልተቻለም [2]. የ ቴክኒክ ቡድን ሀላፊውን ያማክሩ"

#: Error.ulf#OOO_ERROR_109.LngText.text
#: Error.ulf%23OOO_ERROR_109.LngText.text
msgid ""
"Could not update the INI file [2][3]. Verify that the file exists and that "
"you can access it."
msgstr ""
"ማሻሻል አልተቻለም የ INI file [2][3]. ፋይሉ መኖሩን እና እርስዎ ፋይሉ ጋር ለ መድረስ በቂ ፍቃድ እንዳለዎት "
"ያረጋግጡ:"

#: Error.ulf#OOO_ERROR_110.LngText.text
#: Error.ulf%23OOO_ERROR_110.LngText.text
msgid ""
"Could not schedule file [2] to replace file [3] on reboot. Verify that you "
"have write permissions to file [3]."
msgstr ""
"ፋይሉን ማቀድ አልተቻለም [2] ፋይሉን ለ መተካት [3] እንደገና በሚነሳበት ጊዜ: እርስዎ ፋይሉ ላይ ለ መጻፍ በቂ "
"ፍቃድ እንዳለዎት ያረጋግጡ [3]."

#: Error.ulf#OOO_ERROR_111.LngText.text
#: Error.ulf%23OOO_ERROR_111.LngText.text
msgid ""
"Error removing ODBC driver manager, ODBC error [2]: [3]. Contact your "
"support personnel."
msgstr ""
"ስህተት ተፈጥሯል በ ማስወገድ ላይ የ ODBC driver manager, ODBC ስህተት [2]: [3]. የ ቴክኒክ ቡድን "
"ሀላፊውን ያማክሩ:"

#: Error.ulf#OOO_ERROR_112.LngText.text
#: Error.ulf%23OOO_ERROR_112.LngText.text
msgid ""
"Error installing ODBC driver manager, ODBC error [2]: [3]. Contact your "
"support personnel."
msgstr ""
"ስህተት ተፈጥሯል በ ማስወገድ ላይ የ ODBC driver manager, ODBC ስህተት [2]: [3]. የ ቴክኒክ ቡድን "
"ሀላፊውን ያማክሩ:"

#: Error.ulf#OOO_ERROR_113.LngText.text
#: Error.ulf%23OOO_ERROR_113.LngText.text
msgid ""
"Error removing ODBC driver [4], ODBC error [2]: [3]. Verify that you have "
"sufficient privileges to remove ODBC drivers."
msgstr ""
"ስህተት ተፈጥሯል በ ማስወገድ ላይ የ ODBC driver [4], ODBC ስህተት [2]: [3]. እርስዎ በቂ ፍቃድ "
"እንዳለዎት የ ODBC drivers ፋይሉን ለ ማስወገድ:"

#: Error.ulf#OOO_ERROR_114.LngText.text
#: Error.ulf%23OOO_ERROR_114.LngText.text
msgid ""
"Error installing ODBC driver [4], ODBC error [2]: [3]. Verify that the file "
"[4] exists and that you can access it."
msgstr ""
"ስህተት ተፈጥሯል በ መግጠም ላይ የ ODBC driver [4], ODBC ስህተት [2]: [3]. እርስዎ [4] ፋይሉ ጋር "
"ለ መድረስ በቂ ፍቃድ እንዳለዎት ያረጋግጡ: "

#: Error.ulf#OOO_ERROR_115.LngText.text
#: Error.ulf%23OOO_ERROR_115.LngText.text
msgid ""
"Error configuring ODBC data source [4], ODBC error [2]: [3]. Verify that the "
"file [4] exists and that you can access it."
msgstr ""
"ስህተት ተፈጥሯል የ ODBC ዳታ ምንጮችን በ ማዋቀር ላይ እንዳለ: [4], የ ODBC ስህተት [2]: [3]. ፋይሉ "
"መኖሩን [4] እና እርስዎ ፋይሉ ጋር ለ መድረስ በቂ ፍቃድ እንዳለዎት ያረጋግጡ:"

#: Error.ulf#OOO_ERROR_116.LngText.text
#: Error.ulf%23OOO_ERROR_116.LngText.text
msgid ""
"Service [2] ([3]) failed to start. Verify that you have sufficient "
"privileges to start system services."
msgstr ""
"ግልጋሎቱን [2] ([3]) ማስጀመር አልተቻለም: የ ስርአቱን ግልጋሎት ለ ማስጀመር እርስዎ በቂ ፍቃድ እንዳለዎት "
"ያረጋግጡ:"

#: Error.ulf#OOO_ERROR_117.LngText.text
#: Error.ulf%23OOO_ERROR_117.LngText.text
msgid ""
"Service [2] ([3]) could not be stopped. Verify that you have sufficient "
"privileges to stop system services."
msgstr ""
"ግልጋሎቱን [2] ([3]) ማስቆም አልተቻለም: የ ስርአቱን ግልጋሎት ለ ማስቆም እርስዎ በቂ ፍቃድ እንዳለዎት ያረጋግጡ:"

#: Error.ulf#OOO_ERROR_118.LngText.text
#: Error.ulf%23OOO_ERROR_118.LngText.text
msgid ""
"Service [2] ([3]) could not be deleted. Verify that you have sufficient "
"privileges to remove system services."
msgstr ""
"ግልጋሎቱን [2] ([3]) ማጥፋት አልተቻለም: የ ስርአቱን ግልጋሎት ለ ማጥፋት እርስዎ በቂ ፍቃድ እንዳለዎት ያረጋግጡ:"

#: Error.ulf#OOO_ERROR_119.LngText.text
#: Error.ulf%23OOO_ERROR_119.LngText.text
msgid ""
"Service [2] ([3]) could not be installed. Verify that you have sufficient "
"privileges to install system services."
msgstr ""
"ግልጋሎቱን [2] ([3]) መግጠም አልተቻለም: የ ስርአቱን ግልጋሎት ለ መግጠም እርስዎ በቂ ፍቃድ እንዳለዎት ያረጋግጡ:"

#: Error.ulf#OOO_ERROR_120.LngText.text
#: Error.ulf%23OOO_ERROR_120.LngText.text
msgid ""
"Could not update environment variable [2]. Verify that you have sufficient "
"privileges to modify environment variables."
msgstr ""
"ተለዋዋጭ አካባቢን ማሻሻል አልተቻለም [2]. ተለዋዋጭ አካባቢን ለ ማሻሻል እርስዎ በቂ ፍቃድ እንዳለዎት ያረጋግጡ:"

#: Error.ulf#OOO_ERROR_121.LngText.text
#: Error.ulf%23OOO_ERROR_121.LngText.text
msgid ""
"You do not have sufficient privileges to complete this installation for all "
"users of the machine. Log on as an administrator and then retry this "
"installation."
msgstr ""
"እርስዎ በቂ የ ሆነ ፍቃድ የሎትም በዚህ ኮምፒዩተር ላይ ለ ሁሉም ተጠቃሚ ይህን መግጠሚያ ገጥሞ ለመጨረስ: እንደ "
"አስተዳዳሪ ይግቡ እና እንደገና ለ መግጠም ይሞክሩ:"

#: Error.ulf#OOO_ERROR_122.LngText.text
#: Error.ulf%23OOO_ERROR_122.LngText.text
msgid ""
"Could not set file security for file [3]. Error: [2]. Verify that you have "
"sufficient privileges to modify the security permissions for this file."
msgstr ""
"ለ ፋይሉ የ ፋይል ደህንነት ማዘጋጀት አልተቻለም [3] ስህተት: [2]. የዚህን ፋይል ደህንነት ለ ማሻሻል እርስዎ በቂ "
"ፍቃድ እንዳለዎት ያረጋግጡ:"

#: Error.ulf#OOO_ERROR_123.LngText.text
#: Error.ulf%23OOO_ERROR_123.LngText.text
msgid ""
"Component Services (COM+ 1.0) are not installed on this computer. This "
"installation requires Component Services in order to complete successfully. "
"Component Services are available on Windows 2000."
msgstr ""
"የ አካላት ግልጋሎቶች (COM+ 1.0) በዚህ ኮምፒዩተር ላይ አልተገጠመም: ይህ መግጠሚያ የ አካላት ግልጋሎቶችን "
"ይፈልጋል በተሟላ ሁኔታ ገጥሞ ለመጨረስ: የ አካላት ግልጋሎቶች ዝግጁ ናቸው በ Windows 2000."

#: Error.ulf#OOO_ERROR_124.LngText.text
#: Error.ulf%23OOO_ERROR_124.LngText.text
msgid ""
"Error registering COM+ application. Contact your support personnel for more "
"information."
msgstr ""
"ስህተት ተፈጥሯል በ መመዝገብ ላይ COM+ application. ለ በለጠ መረጃ የ ቴክኒክ ቡድን ሀላፊውን ያማክሩ:"

#: Error.ulf#OOO_ERROR_125.LngText.text
#: Error.ulf%23OOO_ERROR_125.LngText.text
msgid ""
"Error unregistering COM+ application. Contact your support personnel for "
"more information."
msgstr "ስህተት ተፈጥሯል አልተመዘገበም COM+ application. ለ በለጠ መረጃ የ ቴክኒክ ቡድን ሀላፊውን ያማክሩ:"

#: Error.ulf#OOO_ERROR_126.LngText.text
#: Error.ulf%23OOO_ERROR_126.LngText.text
msgid "The description for service '[2]' ([3]) could not be changed."
msgstr "የ ግልጋሎቱን መግለጫ '[2]' ([3]) መቀየር አይቻልም:"

#: Error.ulf#OOO_ERROR_127.LngText.text
#: Error.ulf%23OOO_ERROR_127.LngText.text
msgid ""
"The Windows Installer service cannot update the system file [2] because the "
"file is protected by Windows. You may need to update your operating system "
"for this program to work correctly. {{Package version: [3], OS Protected "
"version: [4]}}"
msgstr ""
"የ Windows መግጠሚያ ግልጋሎት የ ስርአቱን ፋይል ማሻሻል አይችልም [2] ምክንያቱም ፋይሉ በ Windows የሚጠበቅ "
"ነው: ይህ ፕሮግራም በትክክል እንዲሰራ የ ስርአት መተግበሪያውን ማሻሻል አለብዎት: {{Package version: [3], "
"OS Protected version: [4]}}"

#: Error.ulf#OOO_ERROR_128.LngText.text
#: Error.ulf%23OOO_ERROR_128.LngText.text
msgid ""
"The Windows Installer service cannot update the protected Windows file [2]. "
"{{Package version: [3], OS Protected version: [4], SFP Error: [5]}}"
msgstr ""
"የ Windows መግጠሚያ ግልጋሎት በ Windows የሚጠበቅን ፋይል ማሻሻል አይችልም [2]. {{Package version:"
" [3], OS Protected version: [4], SFP Error: [5]}}"

#: Error.ulf#OOO_ERROR_129.LngText.text
#: Error.ulf%23OOO_ERROR_129.LngText.text
msgid ""
"This setup requires Internet Information Server 4.0 or higher for "
"configuring IIS Virtual Roots. Please make sure that you have IIS 4.0 or "
"higher."
msgstr ""
"ይህ ማሰናጃ የ ኢንተርኔት መረጃ Server 4.0 ወይንም ከዚያ በላይ የሆነ ለማዋቀር ይፈልጋል: IIS Virtual "
"Roots. እባክዎን እርግጠኛ ይሁኑ የ IIS 4.0 ወይንም ከዚያ በላይ እንዳለዎት"

#: Error.ulf#OOO_ERROR_130.LngText.text
#: Error.ulf%23OOO_ERROR_130.LngText.text
msgid ""
"This setup requires Administrator privileges for configuring IIS Virtual "
"Roots."
msgstr "ይህ ማሰናጃ የ አስተዳዳሪ ፍቃድ ይፈልጋል ለ ማዋቀር ይህን IIS Virtual Roots."

#: CustomAc.ulf#OOO_CUSTOMACTION_1.LngText.text
#: CustomAc.ulf%23OOO_CUSTOMACTION_1.LngText.text
msgid ""
"A newer version of [ProductName] was found. To install an older version, the "
"newer version needs to be removed first."
msgstr ""
"አዲስ እትም የ [ProductName] አልተገኘም: አሮጌውን እትም ለ መግጠም አዲሱን እትም በቅድሚያ ማስወገድ አለብዎት:"

#: CustomAc.ulf#OOO_CUSTOMACTION_2.LngText.text
#: CustomAc.ulf%23OOO_CUSTOMACTION_2.LngText.text
msgid "The same version of this product is already installed."
msgstr "የዚህ እቃ ተመሳሳይ እትም ቀደም ብሎ ተገጥሟል:"

#: CustomAc.ulf#OOO_CUSTOMACTION_3.LngText.text
#: CustomAc.ulf%23OOO_CUSTOMACTION_3.LngText.text
msgid ""
"An older version of [ProductName] was found. To install a newer version, the "
"older version needs to be removed first."
msgstr ""
"አዲስ እትም የ [ProductName] አልተገኘም: አሮጌውን እትም ለ መግጠም አዲሱን እትም በቅድሚያ ማስወገድ አለብዎት:"

#: CustomAc.ulf#OOO_CUSTOMACTION_4.LngText.text
#: CustomAc.ulf%23OOO_CUSTOMACTION_4.LngText.text
msgid ""
"Please exit [DEFINEDPRODUCT] [DEFINEDVERSION] and the [DEFINEDPRODUCT] "
"[DEFINEDVERSION] Quickstarter before you continue. If you are using a multi-"
"user system, also make sure that no other user has [DEFINEDPRODUCT] "
"[DEFINEDVERSION] open."
msgstr ""
"እባክዎን ይውጡ [DEFINEDPRODUCT] [DEFINEDVERSION] እና ከ [DEFINEDPRODUCT] "
"[DEFINEDVERSION] በፍጥነት ማስጀመሪያ እርስዎ ከ መቀጠልዎት በፊት: እርስዎ የሚጠቀሙ ከሆነ የ በርካታ-ተጠቃሚ "
"ስርአት: እርግጠኛ ይሁኑ ሌላ ተጠቃሚ [DEFINEDPRODUCT] [DEFINEDVERSION] ከፍቶ እንደማይጠቀም:"

