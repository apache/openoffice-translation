#: 02140000.xhp#par_id3151114.3.help.text
#: 02140000.xhp%23par_id3151114.3.help.text
msgid "Number Format: Percent"
msgstr "የ ቁጥር አቀራረብ: ፕርሰንት"

#: 02140000.xhp#bm_id3149260.help.text
#: 02140000.xhp%23bm_id3149260.help.text
msgid "<bookmark_value>percentage calculations</bookmark_value>"
msgstr "<bookmark_value>ፐርሰንት ማስሊያ</bookmark_value>"

#: 02140000.xhp#par_id3149260.5.help.text
#: 02140000.xhp%23par_id3149260.5.help.text
msgid "You can also enter a percentage sign (%) after a number in a cell:"
msgstr ""

#: 02140000.xhp#par_id3155411.6.help.text
#: 02140000.xhp%23par_id3155411.6.help.text
msgid "1% corresponds to 0.01"
msgstr "1% ተመሳሳይ ነው ከ 0.01"

#: 02140000.xhp#par_id3145749.7.help.text
#: 02140000.xhp%23par_id3145749.7.help.text
msgid "1 + 16% corresponds to 116% or 1.16"
msgstr "1 + 16% ተመሳሳይ ነው ከ 116% ወይንም 1.16"

#: 02140000.xhp#par_id3148575.8.help.text
#: 02140000.xhp%23par_id3148575.8.help.text
msgid "1%% corresponds to 0.0001"
msgstr "1%% ተመሳሳይ ነው ከ 0.0001"

