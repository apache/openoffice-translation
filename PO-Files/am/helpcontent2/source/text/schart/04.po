#: 01020000.xhp#tit.help.text
#: 01020000.xhp%23tit.help.text
msgid "Shortcuts for Charts"
msgstr "አቋራጭ ለ ቻርትስ"

#: 01020000.xhp#bm_id3150767.help.text
#: 01020000.xhp%23bm_id3150767.help.text
msgid ""
"<bookmark_value>shortcut keys; charts</bookmark_value><bookmark_value>charts;"
" shortcuts</bookmark_value>"
msgstr ""
"<bookmark_value>አቋራጭ ቁልፎች; ለ ቻርትስ</bookmark_value><bookmark_value>ለ ቻርትስ; "
"አቋራጭ</bookmark_value>"

#: 01020000.xhp#hd_id3150767.1.help.text
#: 01020000.xhp%23hd_id3150767.1.help.text
msgid ""
"<variable id=\"Chart_keys\"><link href=\"text/schart/04/01020000.xhp\" name="
"\"Shortcuts for Charts\">Shortcuts for Charts</link></variable>"
msgstr ""
"<variable id=\"Chart_keys\"><link href=\"text/schart/04/01020000.xhp\" name="
"\"Shortcuts for Charts\">አቋራጭ ለ ቻርትስ</link></variable>"

#: 01020000.xhp#par_id3155412.2.help.text
#: 01020000.xhp%23par_id3155412.2.help.text
msgid "You can use the following shortcut keys in charts."
msgstr "እርስዎ እነዚህን አቋራጭ ቁልፎች መጠቀም ይችላሉ በ ቻርት ውስጥ:"

#: 01020000.xhp#par_id3159154.3.help.text
#: 01020000.xhp%23par_id3159154.3.help.text
msgid ""
"You can also use the general <link href=\"text/shared/04/01010000.xhp\" name="
"\"shortcut keys\">shortcut keys</link> for $[officename]."
msgstr ""
"እርስዎ ይህንንም መጠቀም ይችላሉ ባጠቃላይ <link href=\"text/shared/04/01010000.xhp\" name=\""
"shortcut keys\">አቋራጭ ቁልፎች</link> ለ $[officename]:"

#: 01020000.xhp#hd_id3149262.4.help.text
#: 01020000.xhp%23hd_id3149262.4.help.text
msgid "Shortcuts in Charts"
msgstr "አቋራጭ በ ቻርትስ ውስጥ"

#: 01020000.xhp#hd_id3151073.5.help.text
#: 01020000.xhp%23hd_id3151073.5.help.text
msgid "Shortcut Keys"
msgstr "አቋራጭ ቁልፎች"

#: 01020000.xhp#par_id3154490.6.help.text
#: 01020000.xhp%23par_id3154490.6.help.text
msgid "Results"
msgstr "ውጤቶች"

#: 01020000.xhp#hd_id3154729.7.help.text
#: 01020000.xhp%23hd_id3154729.7.help.text
msgid "Tab"
msgstr "Tab"

#: 01020000.xhp#par_id3154511.8.help.text
#: 01020000.xhp%23par_id3154511.8.help.text
msgid "Select next object."
msgstr "የሚቀጥለውን እቃ ይምረጡ:"

#: 01020000.xhp#hd_id3155064.9.help.text
#: 01020000.xhp%23hd_id3155064.9.help.text
msgid "Shift+Tab"
msgstr "Shift+Tab"

#: 01020000.xhp#par_id3149020.10.help.text
#: 01020000.xhp%23par_id3149020.10.help.text
msgid "Select previous object."
msgstr "ያለፈውን እቃ ይምረጡ"

#: 01020000.xhp#hd_id3155443.11.help.text
#: 01020000.xhp%23hd_id3155443.11.help.text
msgid "Home"
msgstr "ቤት"

#: 01020000.xhp#par_id3156382.12.help.text
#: 01020000.xhp%23par_id3156382.12.help.text
msgid "Select first object."
msgstr "የ መጀመሪያውን እቃ ይምረጡ"

#: 01020000.xhp#hd_id3153963.13.help.text
#: 01020000.xhp%23hd_id3153963.13.help.text
msgid "End"
msgstr "መጨረሻ"

#: 01020000.xhp#par_id3154702.14.help.text
#: 01020000.xhp%23par_id3154702.14.help.text
msgid "Select last object."
msgstr "የ መጨረሻውን እቃ ይምረጡ"

#: 01020000.xhp#hd_id3143218.15.help.text
#: 01020000.xhp%23hd_id3143218.15.help.text
msgid "Esc"
msgstr "Esc"

#: 01020000.xhp#par_id3147005.16.help.text
#: 01020000.xhp%23par_id3147005.16.help.text
msgid "Cancel selection"
msgstr "ምርጫውን መሰረዣ"

#: 01020000.xhp#hd_id3159239.17.help.text
#: 01020000.xhp%23hd_id3159239.17.help.text
msgid "up/down/left/right arrow"
msgstr "ቀስት ወደ ላይ/ታች/ግራ/ቀኝ"

#: 01020000.xhp#par_id3149210.18.help.text
#: 01020000.xhp%23par_id3149210.18.help.text
msgid "Move the object in the direction of the arrow."
msgstr "እቃውን በ ቀስት ቁልፍ አቅጣጫ ማንቀሳቀሻ:"

#: 01020000.xhp#hd_id3150364.19.help.text
#: 01020000.xhp%23hd_id3150364.19.help.text
msgid "up/down/left/right arrow in pie charts"
msgstr "ወደ ላይ/ታች/የ ግራ/ቀኝ ቀስት በ ፓይ ቻርትስ ውስጥ:"

#: 01020000.xhp#par_id3150369.20.help.text
#: 01020000.xhp%23par_id3150369.20.help.text
msgid "Moves the selected pie segment in the direction of the arrow."
msgstr "የተመረጠውን የ ፓይ ክፋይ እቃ በ ቀስቱ ቁልፍ አቅጣጫ ማንቀሳቀሻ:"

#: 01020000.xhp#hd_id3145584.21.help.text
#: 01020000.xhp%23hd_id3145584.21.help.text
msgid "F2 in titles"
msgstr "F2 በ አርእስቶች ውስጥ"

#: 01020000.xhp#par_id3154372.22.help.text
#: 01020000.xhp%23par_id3154372.22.help.text
msgid "Enter text input mode."
msgstr "በ ማስገቢያ ዘዴ ጽሁፍ ማስገቢያ:"

#: 01020000.xhp#hd_id3146980.23.help.text
#: 01020000.xhp%23hd_id3146980.23.help.text
msgid "F3"
msgstr "F3"

#: 01020000.xhp#par_id3152988.24.help.text
#: 01020000.xhp%23par_id3152988.24.help.text
msgid ""
"Open group so that you can edit the individual components (in legend and "
"data series)."
msgstr "እርስዎ ቡድንን ይክፈቱ እያንዳንዱን አካላት ማረም እንዲችሉ (በ መግለጫ እና ተከታታይ ዳታ ውስጥ)"

#: 01020000.xhp#hd_id3153815.25.help.text
#: 01020000.xhp%23hd_id3153815.25.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F3"
msgstr ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">ትእዛዝ</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F3"

#: 01020000.xhp#par_id3153915.26.help.text
#: 01020000.xhp%23par_id3153915.26.help.text
msgid "Exit group (in legend and data series)."
msgstr "ከ ቡድን መውጫ (ከ መግለጫ እና ተከታታይ ዳታ ውስጥ)"

#: 01020000.xhp#hd_id3155269.27.help.text
#: 01020000.xhp%23hd_id3155269.27.help.text
msgid "+/-"
msgstr "+/-"

#: 01020000.xhp#par_id3156016.28.help.text
#: 01020000.xhp%23par_id3156016.28.help.text
msgid "Reduce or enlarge the chart"
msgstr "ቻርትስ ማሳነሻ ወይንም ማሳደጊያ"

#: 01020000.xhp#hd_id3150210.29.help.text
#: 01020000.xhp%23hd_id3150210.29.help.text
msgid "+/- in pie charts"
msgstr "+/- በ ፓይ ቻርትስ ውስጥ"

#: 01020000.xhp#par_id3159204.30.help.text
#: 01020000.xhp%23par_id3159204.30.help.text
msgid "Moves the selected pie segment off or into the pie chart."
msgstr "የ ተመረጠውን የ ፓይ ክፋይ ማጥፊያ ወይንም ወደ ፓይ ቻርት ውስጥ ማንቀሳቀሻ:"
