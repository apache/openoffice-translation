#: 01020000.xhp#par_idN10AF2.help.text
#: 01020000.xhp%23par_idN10AF2.help.text
msgid "Switch to next layer"
msgstr "ወደሚቀጥለው ደረጃ መቀየሪያ"

#: 01020000.xhp#hd_id3153927.71.help.text
#: 01020000.xhp%23hd_id3153927.71.help.text
msgid "Arrow Key"
msgstr "የ ቀስት ቁልፍ"

#: 01020000.xhp#par_id3155986.72.help.text
#: 01020000.xhp%23par_id3155986.72.help.text
msgid "Moves the selected object in the direction of the arrow key."
msgstr "የተመረጠውን እቃ በ ቀስት ቁልፍ አቅጣጫ ማንቀሳቀሻ"

#: 01020000.xhp#hd_id3156259.73.help.text
#: 01020000.xhp%23hd_id3156259.73.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+"
"Arrow Key"
msgstr ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">ትእዛዝ</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+የ ቀስት "
"ቁልፍ"

#: 01020000.xhp#par_id3147171.74.help.text
#: 01020000.xhp%23par_id3147171.74.help.text
msgid "Moves the page view in the direction of the arrow key."
msgstr "የ ገጽ መመልከቻውን በ ቀስት ቁልፍ አቅጣጫ ማንቀሳቀሻ"

#: 01020000.xhp#hd_id3152484.79.help.text
#: 01020000.xhp%23hd_id3152484.79.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>-"
"click while dragging an object. Note: you must first enable the <link href=\""
"text/shared/optionen/01070500.xhp\" name=\"Copy when moving\">Copy when "
"moving</link> option in <switchinline select=\"sys\"><caseinline select=\""
"MAC\">%PRODUCTNAME - Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - %PRODUCTNAME Draw - General to use "
"this shortcut key."
msgstr ""

#: 01020000.xhp#par_id3149450.80.help.text
#: 01020000.xhp%23par_id3149450.80.help.text
msgid "Creates a copy of the dragged object when mouse button is released."
msgstr ""

#: 01020000.xhp#hd_id3154643.104.help.text
#: 01020000.xhp%23hd_id3154643.104.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+"
"Enter with keyboard focus (F6) on a drawing object icon on Tools bar"
msgstr ""

#: 01020000.xhp#par_id3150756.105.help.text
#: 01020000.xhp%23par_id3150756.105.help.text
msgid ""
"Inserts a drawing object of default size into the center of the current view."
msgstr ""

#: 01020000.xhp#hd_id3151189.106.help.text
#: 01020000.xhp%23hd_id3151189.106.help.text
msgid "Shift+F10"
msgstr "Shift+F10"

#: 01020000.xhp#par_id3151266.107.help.text
#: 01020000.xhp%23par_id3151266.107.help.text
msgid "Opens the context menu for the selected object."
msgstr ""

#: 01020000.xhp#hd_id3156100.108.help.text
#: 01020000.xhp%23hd_id3156100.108.help.text
msgctxt "01020000.xhp#hd_id3156100.108.help.text"
msgid "F2"
msgstr "F2"

#: 01020000.xhp#par_id3156323.109.help.text
#: 01020000.xhp%23par_id3156323.109.help.text
msgid "Enters text mode."
msgstr "ወደ ጽሁፍ ዘዴ መግቢያ"

#: 01020000.xhp#hd_id3147563.110.help.text
#: 01020000.xhp%23hd_id3147563.110.help.text
msgid "Enter"
msgstr "ማስገቢያ"

#: 01020000.xhp#par_id3150258.111.help.text
#: 01020000.xhp%23par_id3150258.111.help.text
msgid "Enters text mode if a text object is selected."
msgstr "የ ጽሁፍ እቃ ከ ተመረጠ ወደ ጽሁፍ ዘዴ መግቢያ"

#: 01020000.xhp#hd_id3155851.112.help.text
#: 01020000.xhp%23hd_id3155851.112.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Enter"
msgstr ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">ትእዛዝ</caseinline><defaultinline>Ctrl</defaultinline></switchinline>+ማስገቢያ"

#: 01020000.xhp#par_id3154046.113.help.text
#: 01020000.xhp%23par_id3154046.113.help.text
msgid ""
"Enters text mode if a text object is selected. If there are no text objects "
"or if you have cycled through all of the text objects on the page, a new "
"page is inserted."
msgstr ""

#: 01020000.xhp#hd_id3149977.81.help.text
#: 01020000.xhp%23hd_id3149977.81.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">Option</caseinline><defaultinline>Alt</defaultinline></switchinline>"
msgstr ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">ምርጫ</caseinline><defaultinline>Alt</defaultinline></switchinline>"

#: 01020000.xhp#par_id3152812.82.help.text
#: 01020000.xhp%23par_id3152812.82.help.text
msgid ""
"Press the <switchinline select=\"sys\"><caseinline select=\"MAC\""
">Option</caseinline><defaultinline>Alt</defaultinline></switchinline> key "
"and drag with the mouse to draw or resize an object from the center of the "
"object outward."
msgstr ""

#: 01020000.xhp#hd_id3143232.83.help.text
#: 01020000.xhp%23hd_id3143232.83.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">Option</caseinline><defaultinline>Alt</defaultinline></switchinline> + "
"click on an object"
msgstr ""

#: 01020000.xhp#par_id3156007.84.help.text
#: 01020000.xhp%23par_id3156007.84.help.text
msgid "Selects the object behind the currently selected object."
msgstr ""

#: 01020000.xhp#hd_id3147252.85.help.text
#: 01020000.xhp%23hd_id3147252.85.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\""
">Option</caseinline><defaultinline>Alt</defaultinline></switchinline>+Shift+"
"click an object"
msgstr ""

