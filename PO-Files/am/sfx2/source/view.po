#: view.src#STR_NODEFPRINTER.string.text
#: view.src%23STR_NODEFPRINTER.string.text
msgid ""
"No default printer found.\n"
"Please choose a printer and try again."
msgstr ""
"ነባር ማተሚያ አለገኘም\n"
"እባክዎን ማተሚያ ይምረጡ እና እንደገና ይሞክሩ:"

#: view.src#STR_NOSTARTPRINTER.string.text
#: view.src%23STR_NOSTARTPRINTER.string.text
msgid ""
"Could not start printer.\n"
"Please check your printer configuration."
msgstr ""
"ማተሚያውን ማስጀመር አልተቻለም\n"
"እባክዎን የ ማተሚያ ማሰናጃ ይመርምሩ:"

#: view.src#STR_PRINTER_NOTAVAIL.string.text
#: view.src%23STR_PRINTER_NOTAVAIL.string.text
msgid ""
"This document has been formatted for the printer $1. The specified printer "
"is not available.\n"
"Do you want to use the standard printer $2 ?"
msgstr ""
"ሰነዱ ለ ማተሚያው አቀራረብ ተዘጋጅቷል $1. የተመረጠው ማተሚያ አልተገኘም\n"
"መደበኛ ማተሚያ መጠቀም ይፈልጋሉ $2 ?"

#: view.src#STR_PRINT_OPTIONS.string.text
#: view.src%23STR_PRINT_OPTIONS.string.text
msgid "Options..."
msgstr "ምርጫ..."

#: view.src#STR_PRINT_OPTIONS_TITLE.string.text
#: view.src%23STR_PRINT_OPTIONS_TITLE.string.text
msgid "Printer Options"
msgstr "የ ማተሚያ ምርጫ"

#: view.src#STR_ERROR_PRINTER_BUSY.string.text
#: view.src%23STR_ERROR_PRINTER_BUSY.string.text
msgid "Printer busy"
msgstr "ማተሚያው በ ስራ ላይ ነው"

#: view.src#STR_ERROR_PRINT.string.text
#: view.src%23STR_ERROR_PRINT.string.text
msgid "Error while printing"
msgstr "በ ማተም ላይ እንዳለ ስህተት ተፈጥሯል"

#: view.src#STR_PRINTING.string.text
#: view.src%23STR_PRINTING.string.text
msgid "Printing"
msgstr "በ ማተም ላይ"

#: view.src#STR_PAGE.string.text
#: view.src%23STR_PAGE.string.text
msgid "Page "
msgstr "ገጽ "

#: view.src#STR_ERROR_SAVE_TEMPLATE.string.text
#: view.src%23STR_ERROR_SAVE_TEMPLATE.string.text
msgid "Error saving template "
msgstr "ቴምፕሌት በ ማስቀመጥ ላይ እንዳለ ስህተት ተፈጥሯል "

#: view.src#STR_READONLY.string.text
#: view.src%23STR_READONLY.string.text
msgid " (read-only)"
msgstr " (ለ ማንበብ-ብቻ)"

#: view.src#STR_PRINT_NEWORI.string.text
#: view.src%23STR_PRINT_NEWORI.string.text
msgctxt "view.src#STR_PRINT_NEWORI.string.text"
msgid ""
"The page size and orientation have been modified.\n"
"Would you like to save the new settings in the\n"
"active document?"
msgstr ""
"የ ገጹ መጠን እና አቅጣጫ ተሻሽሏል\n"
"በንቁ ሰነድ ውስጥ አዲስ የተዘጋጀውን\n"
"ማስቀመጥ ይፈልጋሉ?"

#: view.src#STR_PRINT_NEWSIZE.string.text
#: view.src%23STR_PRINT_NEWSIZE.string.text
msgid ""
"The page size has been modified.\n"
"Should the new settings be saved\n"
"in the active document?"
msgstr ""
"የ ገጹ መጠን ተሻሽሏል\n"
"በንቁ ሰነድ ውስጥ አዲስ የተዘጋጀውን\n"
"ማስቀመጥ ይፈልጋሉ?"

#: view.src#STR_PRINT_NEWORISIZE.string.text
#: view.src%23STR_PRINT_NEWORISIZE.string.text
msgctxt "view.src#STR_PRINT_NEWORISIZE.string.text"
msgid ""
"The page size and orientation have been modified.\n"
"Would you like to save the new settings in the\n"
"active document?"
msgstr ""
"የ ገጹ መጠን እና አቅጣጫ ተሻሽሏል\n"
"በንቁ ሰነድ ውስጥ አዲስ የተዘጋጀውን\n"
"ማስቀመጥ ይፈልጋሉ?"

#: view.src#STR_PREVIEW_DOCINFO.string.text
#: view.src%23STR_PREVIEW_DOCINFO.string.text
msgid ""
"<html><body BGCOLOR=\"#c0c0c0\"><font FACE=\"Arial\"><dl><dt><b>Title:</b><dd"
">$(TITEL)<dt><b>Subject:</b><dd>$(THEME)<dt><b>Keywords:</b><dd>$(KEYWORDS)<d"
"t><b>Description:</b><dd>$(TEXT)</dl></font></body></html>"
msgstr ""
"<html><body BGCOLOR=\"#c0c0c0\"><font FACE=\"Arial\""
"><dl><dt><b>አርእስት:</b><dd>$(TITEL)<dt><b>ጉዳዩ:</b><dd>$(THEME)<dt><b>ቁልፍ "
"ቃል:</b><dd>$(KEYWORDS)<dt><b>መግለጫ:</b><dd>$(TEXT)</dl></font></body></html>"

#: view.src#STR_PREVIEW_NODOCINFO.string.text
#: view.src%23STR_PREVIEW_NODOCINFO.string.text
msgid ""
"<HTML><BODY BGCOLOR=\"#c0c0c0\"><BR><BR><P><FONT FACE=\"Arial\"><B>No "
"document properties found.</B></FONT></P></BODY></HTML>"
msgstr ""
"<HTML><BODY BGCOLOR=\"#c0c0c0\"><BR><BR><P><FONT FACE=\"Arial\"><B>ምንም የ ሰነድ "
"ባህሪ አልተገኘም</B></FONT></P></BODY></HTML>"

#: view.src#MSG_CANT_CLOSE.infobox.text
#: view.src%23MSG_CANT_CLOSE.infobox.text
msgid ""
"The document cannot be closed because a\n"
"print job is being carried out."
msgstr ""
"ሰነዱን መዝጋት አልተቻለም ምክንያቱም\n"
"የ ህትመት ስራ እየተከናወነ ነው"

#: view.src#DLG_PRINTMONITOR_TEXT.#define.text
#: view.src%23DLG_PRINTMONITOR_TEXT.%23define.text
msgid "Print Monitor"
msgstr "ማተሚያ መቆጣጠሪያ"

#: view.src#DLG_PRINTMONITOR.FT_PRINTING.fixedtext.text
#: view.src%23DLG_PRINTMONITOR.FT_PRINTING.fixedtext.text
msgid "is being printed on"
msgstr "እየታተመ ነው"

#: view.src#DLG_PRINTMONITOR.STR_FT_PREPARATION.string.text
#: view.src%23DLG_PRINTMONITOR.STR_FT_PREPARATION.string.text
msgid "is being prepared for printing"
msgstr "ለ ማተም በ ማሰናዳት ላይ ነው"

#: view.src#MSG_ERROR_SEND_MAIL.infobox.text
#: view.src%23MSG_ERROR_SEND_MAIL.infobox.text
msgid ""
"An error occurred in sending the message. Possible errors could be a missing "
"user account or a defective setup.\n"
"Please check the %PRODUCTNAME settings or your e-mail program settings."
msgstr ""
"መልእክቱን በ መላክ ላይ እንዳለ ስህተት ተፈጥሯል: ምናልባት ስህተቱ የተጠቃሚ መግለጫ ማጣት ወይንም የተሳሳተ ማሰናጃ "
"ሊሆን ይችላል:\n"
"እባክዎን ማሰናጃውን %PRODUCTNAME ይመርምሩ ወይንም የ ኢ-ሜይል ፕሮግራም ማሰናጃውን ይመርምሩ"

#: view.src#MSG_QUERY_OPENASTEMPLATE.querybox.text
#: view.src%23MSG_QUERY_OPENASTEMPLATE.querybox.text
msgid ""
"This document cannot be edited, possibly due to missing access rights. Do "
"you want to edit a copy of the document?"
msgstr "ይህን ሰነድ ማረም አይቻልም: ምክንያቱም በ ፍቃድ ማጣት ምክንያት: የ ሰነዱን ኮፒ ማረም ይፈልጋሉ?"

#: view.src#STR_REPAIREDDOCUMENT.string.text
#: view.src%23STR_REPAIREDDOCUMENT.string.text
msgid " (repaired document)"
msgstr " (የ ተጠገነ ሰነድ)"

#: view.src#MSG_ERROR_NO_WEBBROWSER_FOUND.errorbox.text
#: view.src%23MSG_ERROR_NO_WEBBROWSER_FOUND.errorbox.text
msgid ""
"%PRODUCTNAME could not find a web browser on your system. Please check your "
"desktop preferences or install a web browser (for example, Mozilla) in the "
"default location requested during the browser installation."
msgstr ""
"%PRODUCTNAME በ እርስዎ ስርአት ውስጥ የ ዌብ መቃኛ ማግኘት አልተቻለም: እባክዎን የ ዴስክቶፕ ምርጫዎችን "
"ይመርምሩ ወይንም የ ዌብ መቃኛ (ለምሳሌ ሞዚላ) በ ነባር ለ ዌብ መቃኛ መግጠሚያ የተጠየቀውን አካባቢ ውስጥ ይመርምሩ"
