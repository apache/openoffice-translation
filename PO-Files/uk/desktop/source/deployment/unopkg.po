#: unopkg.src#RID_STR_UNOPKG_ACCEPT_LIC_1.string.text
#: unopkg.src%23RID_STR_UNOPKG_ACCEPT_LIC_1.string.text
msgid "Extension Software License Agreement of $NAME:"
msgstr "Ліцензійна угода розширення $NAME:"

#: unopkg.src#RID_STR_UNOPKG_ACCEPT_LIC_2.string.text
#: unopkg.src%23RID_STR_UNOPKG_ACCEPT_LIC_2.string.text
msgid ""
"Read the complete License Agreement displayed above. Accept the License "
"Agreement by typing \"yes\" on the console then press the Return key. Type \""
"no\" to decline and to abort the extension setup."
msgstr ""
"Прочитайте ліцензійну угоду вище. Введіть \"yes\", щоб прийняти умови "
"ліцензійної угоди та натисніть Return. Ведіть \"no\" для відхилення та "
"виходу з встановлення розширення."

#: unopkg.src#RID_STR_UNOPKG_ACCEPT_LIC_3.string.text
#: unopkg.src%23RID_STR_UNOPKG_ACCEPT_LIC_3.string.text
msgid "[Enter \"yes\" or \"no\"]:"
msgstr "[Введіть \"yes\" чи \"no\"]:"

#: unopkg.src#RID_STR_UNOPKG_ACCEPT_LIC_4.string.text
#: unopkg.src%23RID_STR_UNOPKG_ACCEPT_LIC_4.string.text
msgid "Your input was not correct. Please enter \"yes\" or \"no\":"
msgstr "Ввід некоректний. Введіть \"yes\" чи \"no\":"

#: unopkg.src#RID_STR_UNOPKG_ACCEPT_LIC_YES.string.text
#: unopkg.src%23RID_STR_UNOPKG_ACCEPT_LIC_YES.string.text
msgid "YES"
msgstr "YES"

#: unopkg.src#RID_STR_UNOPKG_ACCEPT_LIC_Y.string.text
#: unopkg.src%23RID_STR_UNOPKG_ACCEPT_LIC_Y.string.text
msgid "Y"
msgstr "Y"

#: unopkg.src#RID_STR_UNOPKG_ACCEPT_LIC_NO.string.text
#: unopkg.src%23RID_STR_UNOPKG_ACCEPT_LIC_NO.string.text
msgid "NO"
msgstr "NO"

#: unopkg.src#RID_STR_UNOPKG_ACCEPT_LIC_N.string.text
#: unopkg.src%23RID_STR_UNOPKG_ACCEPT_LIC_N.string.text
msgid "N"
msgstr "N"

#: unopkg.src#RID_STR_CONCURRENTINSTANCE.string.text
#: unopkg.src%23RID_STR_CONCURRENTINSTANCE.string.text
msgid ""
"unopkg cannot be started. The lock file indicates it as already running. If "
"this does not apply, delete the lock file at:"
msgstr ""
"unopkg не може запуститись, бо файл блокування свідчить за те що unopkg вже "
"запущений. Якщо це не так, видаліть файл блокування за шляхом:"

