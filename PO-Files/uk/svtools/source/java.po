#: javaerror.src#WARNINGBOX_JAVANOTFOUND.warningbox.text
#: javaerror.src%23WARNINGBOX_JAVANOTFOUND.warningbox.text
msgid ""
"%PRODUCTNAME requires a Java runtime environment (JRE) to perform this task. "
"Please install a JRE and restart %PRODUCTNAME."
msgstr ""
"Для виконання цього завдання %PRODUCTNAME потрібне встановлене оточення Java "
"(JRE). Встановіть JRE та перезапустіть %PRODUCTNAME."

#: javaerror.src#WARNINGBOX_INVALIDJAVASETTINGS.warningbox.text
#: javaerror.src%23WARNINGBOX_INVALIDJAVASETTINGS.warningbox.text
msgid ""
"The %PRODUCTNAME configuration has been changed. Under Tools - Options - %"
"PRODUCTNAME - Java, select the Java runtime environment you want to have "
"used by %PRODUCTNAME."
msgstr ""
"Параметри конфігурації %PRODUCTNAME були змінені. Виберіть бажану версію "
"оточення Java для %PRODUCTNAME у Сервіс - Параметри - %PRODUCTNAME - Java."

#: javaerror.src#QBX_JAVADISABLED.querybox.text
#: javaerror.src%23QBX_JAVADISABLED.querybox.text
msgid ""
"%PRODUCTNAME requires a Java runtime environment (JRE) to perform this task. "
"However, use of a JRE has been disabled. Do you want to enable the use of a "
"JRE now?"
msgstr ""
"Для виконання цього завдання %PRODUCTNAME потрібне встановлене оточення Java "
"(JRE). Використання Java вимкнено у параметрах програми. Дозволити "
"використання Java?"

#: javaerror.src#ERRORBOX_JVMCREATIONFAILED.errorbox.text
#: javaerror.src%23ERRORBOX_JVMCREATIONFAILED.errorbox.text
msgid ""
"%PRODUCTNAME requires a Java runtime environment (JRE) to perform this task. "
"The selected JRE is defective. Please select another version or install a "
"new JRE and select it under Tools - Options - %PRODUCTNAME - Java."
msgstr ""
"Для виконання цього завдання, %PRODUCTNAME потрібне встановлене оточення "
"Java (JRE). Вибране JRE є несправним. Будь ласка виберіть іншу версію JRE "
"або встановіть нову, яку і виберіть потім в Інструменти - Параметри - %"
"PRODUCTNAME - Java."

#: javaerror.src#ERRORBOX_RESTARTREQUIRED.errorbox.text
#: javaerror.src%23ERRORBOX_RESTARTREQUIRED.errorbox.text
msgid ""
"For the selected Java runtime environment to work properly, %PRODUCTNAME "
"must be restarted. Please restart %PRODUCTNAME now."
msgstr ""
"Для правильної роботи обраного оточення Java, %PRODUCTNAME треба "
"перезапустити. будь ласка, перезапустіть %PRODUCTNAME зараз."

#: javaerror.src#STR_WARNING_JAVANOTFOUND.string.text
#: javaerror.src%23STR_WARNING_JAVANOTFOUND.string.text
msgid "JRE Required"
msgstr "Вимагається JRE"

#: javaerror.src#STR_WARNING_INVALIDJAVASETTINGS.string.text
#: javaerror.src%23STR_WARNING_INVALIDJAVASETTINGS.string.text
msgid "Select JRE"
msgstr "Вибрати JRE"

#: javaerror.src#STR_ERROR_RESTARTREQUIRED.string.text
#: javaerror.src%23STR_ERROR_RESTARTREQUIRED.string.text
msgid "Restart Required"
msgstr "Потрібен перезапуск"

#: javaerror.src#STR_QUESTION_JAVADISABLED.string.text
#: javaerror.src%23STR_QUESTION_JAVADISABLED.string.text
msgid "Enable JRE"
msgstr "Увімкнути JRE"

#: javaerror.src#STR_ERROR_JVMCREATIONFAILED.string.text
#: javaerror.src%23STR_ERROR_JVMCREATIONFAILED.string.text
msgid "JRE is Defective"
msgstr "JRE пошкоджене"
