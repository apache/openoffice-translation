#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_CANTCREATEFOLDER.string.text
msgctxt "errtxt.src#RID_ERRHDL.ERRCODE_SFX_CANTCREATEFOLDER.string.text"
msgid "The input syntax is invalid."
msgstr "Неправильний синтаксис вводу."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_CANTRENAMEFOLDER.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_CANTRENAMEFOLDER.string.text
msgctxt "errtxt.src#RID_ERRHDL.ERRCODE_SFX_CANTRENAMEFOLDER.string.text"
msgid "The input syntax is invalid."
msgstr "Неправильний синтаксис вводу."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_WRONG_CDF_FORMAT.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_WRONG_CDF_FORMAT.string.text
msgid "The channel document has an invalid format."
msgstr "Документ каналу має неправильний формат."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_EMPTY_SERVER.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_EMPTY_SERVER.string.text
msgid "The server must not be empty."
msgstr "Сервер не повинен бути порожнім."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_NO_ABOBOX.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_NO_ABOBOX.string.text
msgid "A subscription folder is required to install a Channel."
msgstr "Для встановлення каналу треба тека підписки."

#: errtxt.src#RID_ERRHDL.ERRCODE_IO_NOTSTORABLEINBINARYFORMAT.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_IO_NOTSTORABLEINBINARYFORMAT.string.text
msgid ""
"This document contains attributes that cannot be saved in the selected "
"format.\n"
"Please save the document in a %PRODUCTNAME %PRODUCTVERSION file format."
msgstr ""
"Цей документ містить атрибути, що неможливо зберегти у вибраному форматі.\n"
"Будь ласка, збережіть документ в форматі %PRODUCTNAME %PRODUCTVERSION."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_TARGETFILECORRUPTED.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_TARGETFILECORRUPTED.string.text
msgid ""
"The file $(FILENAME) cannot be saved. Please check your system settings. You "
"can find an automatically generated backup copy of this file in folder "
"$(PATH) named $(BACKUPNAME)."
msgstr ""
"Не вдалося зберегти файл $(FILENAME). Перевірте налаштування системи. Ви "
"можете знайти автоматично створену резервну копію цього файлу з іменем "
"$(BACKUPNAME) в теці $(PATH)."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_NOMOREDOCUMENTSALLOWED.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_NOMOREDOCUMENTSALLOWED.string.text
msgid ""
"The maximum number of documents that can be opened at the same time has been "
"reached. You need to close one or more documents before you can open a new "
"document."
msgstr ""
"Досягнуто максимально можливу кількість одночасно відкритих документів. Ви "
"маєте закрити один чи більше документів перед відкриттям нового."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_CANTCREATEBACKUP.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_CANTCREATEBACKUP.string.text
msgid "Could not create backup copy."
msgstr "Не вдалося створити резервну копію."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_MACROS_SUPPORT_DISABLED.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_MACROS_SUPPORT_DISABLED.string.text
msgid ""
"An attempt was made to execute a macro.\n"
"For security reasons, macro support is disabled."
msgstr ""
"Була спроба запустити макрос.\n"
"З міркувань безпеки, підтримка макросів відключена."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_DOCUMENT_MACRO_DISABLED.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_DOCUMENT_MACRO_DISABLED.string.text
msgid ""
"This document contains macros.\n"
"\n"
"Macros may contain viruses. Execution of macros is disabled due to the "
"current macro security setting in Tools - Options - %PRODUCTNAME - Security."
"\n"
"\n"
"Therefore, some functionality may not be available."
msgstr ""
"Цей документ містить макроси.\n"
"\n"
"Макрос може містити вірусу. Виконання макросів наразі відключене відповідно "
"до параметрів безпеки в Засоби - Параметри - %PRODUCTNAME - Безпека.\n"
"\n"
"Тому деякі функції можуть не працювати."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_BROKENSIGNATURE.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_BROKENSIGNATURE.string.text
msgid ""
"The digitally signed document content and/or macros do not match the current "
"document signature.\n"
"\n"
"This could be the result of document manipulation or of structural document "
"damage due to data transmission.\n"
"\n"
"We recommend that you do not trust the content of the current document.\n"
"Execution of macros is disabled for this document.\n"
" "
msgstr ""
"Вміст та/або макроси документа з цифровим підписом не відповідають поточному "
"підпису.\n"
"\n"
"Це може бути пов'язано з маніпуляцією з документом та/або з ушкодженням його "
"структури внаслідок передачі.\n"
"\n"
"Ми радимо не довіряти вмісту даного документа.\n"
"Виконання макросів для цього документа відключене.\n"

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_INCOMPLETE_ENCRYPTION.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_INCOMPLETE_ENCRYPTION.string.text
msgid ""
"The encrypted document contains unexpected non-encrypted streams.\n"
"\n"
"This could be the result of document manipulation.\n"
"\n"
"We recommend that you do not trust the content of the current document.\n"
"Execution of macros is disabled for this document.\n"
" "
msgstr ""
"Зашифрований документ містить неочікувані незашифровані потоки.\n"
"\n"
"Це може бути результатом маніпуляцій з документом.\n"
"\n"
"Ми радимо не довіряти вмісту цього документа.\n"
"Виконання макросів для цього документа відключене.\n"

#: errtxt.src#RID_ERRHDL.ERRCODE_IO_INVALIDLENGTH.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_IO_INVALIDLENGTH.string.text
msgid "Invalid data length."
msgstr "Недійсна довжина даних."

#: errtxt.src#RID_ERRHDL.ERRCODE_IO_CURRENTDIR.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_IO_CURRENTDIR.string.text
msgid "Function not possible: path contains current directory."
msgstr "Виконати функцію неможливо: шлях містить поточну теку."

#: errtxt.src#RID_ERRHDL.ERRCODE_IO_NOTSAMEDEVICE.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_IO_NOTSAMEDEVICE.string.text
msgid "Function not possible: device (drive) not identical."
msgstr "Виконання функції неможливе: пристрій (диск) не ідентичний."

#: errtxt.src#RID_ERRHDL.ERRCODE_IO_DEVICENOTREADY.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_IO_DEVICENOTREADY.string.text
msgid "Device (drive) not ready."
msgstr "Пристрій (диск) не готовий."

#: errtxt.src#RID_ERRHDL.ERRCODE_IO_BADCRC.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_IO_BADCRC.string.text
msgid "Wrong check amount."
msgstr "Неправильна контрольна сума."

#: errtxt.src#RID_ERRHDL.ERRCODE_IO_WRITEPROTECTED.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_IO_WRITEPROTECTED.string.text
msgid "Function not possible: write protected."
msgstr "Виконання функції неможливе: захист від запису."

#: errtxt.src#RID_ERRHDL.ERRCODE_SFX_SHARED_NOPASSWORDCHANGE.string.text
#: errtxt.src%23RID_ERRHDL.ERRCODE_SFX_SHARED_NOPASSWORDCHANGE.string.text
msgid ""
"The password of a shared spreadsheet cannot be set or changed.\n"
"Deactivate sharing mode first."
msgstr ""
"Неможливо встановити чи змінити пароль на спільну електронну таблицю.\n"
"Спочатку вимкніть режим спільного доступу."
