msgid ""
"This operation cannot be run on\n"
"files containing wildcards."
msgstr ""
"Цю операцію неможливо виконати з\n"
"файлами, що містять символи підстановки."

#: errtxt.src#RID_ERRHDL.ERRCODE_IO_NOTSUPPORTED.string.text
