msgid ""
"The object cannot be accessed\n"
"due to insufficient user rights."
msgstr ""
"Неможливо отримати доступ до об’єкта\n"
"через недостатні права користувача."

#: errtxt.src#RID_ERRHDL.ERRCODE_IO_LOCKVIOLATION.string.text
