#: 06130500.xhp#tit.help.text
#: 06130500.xhp%23tit.help.text
msgctxt "06130500.xhp#tit.help.text"
msgid "Append libraries"
msgstr "Додавання бібліотек"

#: 06130500.xhp#bm_id3150502.help.text
#: 06130500.xhp%23bm_id3150502.help.text
msgid ""
"<bookmark_value>libraries; adding</bookmark_value><bookmark_value>inserting;"
"Basic libraries</bookmark_value>"
msgstr ""
"<bookmark_value>бібліотеки; "
"додавання</bookmark_value><bookmark_value>вставлення;Бібліотеки "
"Basic</bookmark_value>"

#: 06130500.xhp#hd_id3150502.1.help.text
#: 06130500.xhp%23hd_id3150502.1.help.text
msgctxt "06130500.xhp#hd_id3150502.1.help.text"
msgid "Append libraries"
msgstr "Додавання бібліотек"

#: 06130500.xhp#par_id3154840.2.help.text
#: 06130500.xhp%23par_id3154840.2.help.text
msgid ""
"<ahelp hid=\".\">Locate that <item type=\"productname\">%PRODUCTNAME</item> "
"Basic library that you want to add to the current list, and then click "
"Open.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Знайдіть основну бібліотеку <item type=\"productname\""
">%PRODUCTNAME</item>, яку потрібно додати до поточного списку, а потім "
"натисніть \"Відкрити\".</ahelp>"

#: 06130500.xhp#hd_id3149119.3.help.text
#: 06130500.xhp%23hd_id3149119.3.help.text
msgid "File name:"
msgstr "Ім'я файлу:"

#: 06130500.xhp#par_id3147102.4.help.text
#: 06130500.xhp%23par_id3147102.4.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_LIBSDLG_TREE\">Enter a name or the path to the "
"library that you want to append.</ahelp> You can also select a library from "
"the list."
msgstr ""
"<ahelp hid=\"HID_BASICIDE_LIBSDLG_TREE\">Введіть назву або шлях до "
"бібліотеки, яку потрібно додати.</ahelp> Ви також можете вибрати бібліотеку "
"зі списку."

#: 06130500.xhp#hd_id3147291.5.help.text
#: 06130500.xhp%23hd_id3147291.5.help.text
msgid "Options"
msgstr "Параметри"

#: 06130500.xhp#hd_id3147226.7.help.text
#: 06130500.xhp%23hd_id3147226.7.help.text
msgid "Insert as reference (read-only)"
msgstr "Вставити як посилання (тільки для читання)"

#: 06130500.xhp#par_id3155892.8.help.text
#: 06130500.xhp%23par_id3155892.8.help.text
msgid ""
"<ahelp hid=\"BASCTL_CHECKBOX_RID_DLG_LIBS_RID_CB_REF\">Adds the selected "
"library as a read-only file. The library is reloaded each time you start <"
"item type=\"productname\">%PRODUCTNAME</item>.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_CHECKBOX_RID_DLG_LIBS_RID_CB_REF\">Додає вибрану "
"бібліотеку як файл лише для читання. Бібліотека перезавантажується кожного "
"разу, коли ви запускаєте <item type=\"productname\""
">%PRODUCTNAME</item>.</ahelp>"

#: 06130500.xhp#hd_id3145071.9.help.text
#: 06130500.xhp%23hd_id3145071.9.help.text
msgid "Replace existing libraries"
msgstr "Замінити існуючу бібліотек"

#: 06130500.xhp#par_id3149812.10.help.text
#: 06130500.xhp%23par_id3149812.10.help.text
msgid ""
"<ahelp hid=\"BASCTL_CHECKBOX_RID_DLG_LIBS_RID_CB_REPL\">Replaces a library "
"that has the same name with the current library.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_CHECKBOX_RID_DLG_LIBS_RID_CB_REPL\">Замінює бібліотеку з "
"такою самою назвою поточною бібліотекою.</ahelp>"

#: 06130100.xhp#tit.help.text
#: 06130100.xhp%23tit.help.text
msgctxt "06130100.xhp#tit.help.text"
msgid "Change Password"
msgstr "Змінити пароль"

#: 06130100.xhp#hd_id3159399.1.help.text
#: 06130100.xhp%23hd_id3159399.1.help.text
msgctxt "06130100.xhp#hd_id3159399.1.help.text"
msgid "Change Password"
msgstr "Змінити пароль"

#: 06130100.xhp#par_id3150276.2.help.text
#: 06130100.xhp%23par_id3150276.2.help.text
msgid ""
"<ahelp hid=\"HID_PASSWORD\">Protects the selected library with a "
"password.</ahelp> You can enter a new password, or change the current "
"password."
msgstr ""
"<ahelp hid=\"HID_PASSWORD\">Захищає вибрану бібліотеку паролем.</ahelp> Ви "
"можете ввести новий пароль або змінити поточний пароль."

#: 06130100.xhp#hd_id3154285.3.help.text
#: 06130100.xhp%23hd_id3154285.3.help.text
msgid "Old password"
msgstr "Старий пароль"

#: 06130100.xhp#hd_id3153665.4.help.text
#: 06130100.xhp%23hd_id3153665.4.help.text
msgctxt "06130100.xhp#hd_id3153665.4.help.text"
msgid "Password"
msgstr "Пароль"

#: 06130100.xhp#par_id3155628.5.help.text
#: 06130100.xhp%23par_id3155628.5.help.text
msgid ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_OLD_PASSWD\">Enter the current "
"password for the selected library.</ahelp>"
msgstr ""
"<help hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_OLD_PASSWD\">Введіть поточний "
"пароль для вибраної бібліотеки.</ahelp>"

#: 06130100.xhp#hd_id3153126.6.help.text
#: 06130100.xhp%23hd_id3153126.6.help.text
msgid "New password"
msgstr "Новий пароль"

#: 06130100.xhp#hd_id3153628.7.help.text
#: 06130100.xhp%23hd_id3153628.7.help.text
msgctxt "06130100.xhp#hd_id3153628.7.help.text"
msgid "Password"
msgstr "Пароль"

#: 06130100.xhp#par_id3159413.8.help.text
#: 06130100.xhp%23par_id3159413.8.help.text
msgid ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_NEW_PASSWD\">Enter a new "
"password for the selected library.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_NEW_PASSWD\">Введіть новий "
"пароль для вибраної бібліотеки.</ahelp>"

#: 06130100.xhp#hd_id3148947.9.help.text
#: 06130100.xhp%23hd_id3148947.9.help.text
msgid "Confirm"
msgstr "Підтвердити"

#: 06130100.xhp#par_id3149457.10.help.text
#: 06130100.xhp%23par_id3149457.10.help.text
msgid ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_REPEAT_PASSWD\">Repeat the new "
"password for the selected library.</ahelp>"
msgstr ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_REPEAT_PASSWD\">Повторіть новий "
"пароль для вибраної бібліотеки.</ahelp>"

#: 06130000.xhp#tit.help.text
#: 06130000.xhp%23tit.help.text
msgctxt "06130000.xhp#tit.help.text"
msgid "Macro"
msgstr "Макрос"

#: 06130000.xhp#bm_id3145786.help.text
#: 06130000.xhp%23bm_id3145786.help.text
msgid ""
"<bookmark_value>macros; Basic IDE</bookmark_value><bookmark_value>Basic IDE; "
"macros</bookmark_value>"
msgstr ""
"<bookmark_value>макроси; IDE Basic</bookmark_value><bookmark_value>IDE Basic;"
" макроси</bookmark_value>"

#: 06130000.xhp#hd_id3145786.1.help.text
#: 06130000.xhp%23hd_id3145786.1.help.text
msgctxt "06130000.xhp#hd_id3145786.1.help.text"
msgid "Macro"
msgstr "Макрос"

#: 06130000.xhp#par_id3152886.2.help.text
#: 06130000.xhp%23par_id3152886.2.help.text
msgid ""
"<variable id=\"makro\"><ahelp hid=\".\">Opens the <emph>Macro </emph>dialog, "
"where you can create, edit, organize, and run $[officename] Basic "
"macros.</ahelp></variable>"
msgstr ""
"<variable id=\"makro\"><ahelp hid=\".\">Відкриває діалогове вікно "
"<emph>Макрос</emph>, де можна створювати, редагувати, упорядковувати та "
"запускати макроси $[officename] Basic.</ahelp> </variable>"

#: 06130000.xhp#hd_id3154145.3.help.text
#: 06130000.xhp%23hd_id3154145.3.help.text
msgid "Macro name"
msgstr "Назва макросу"

#: 06130000.xhp#par_id3151116.4.help.text
#: 06130000.xhp%23par_id3151116.4.help.text
msgid ""
"<ahelp hid=\"BASCTL_EDIT_RID_MACROCHOOSER_RID_ED_MACRONAME\">Displays the "
"name of the selected macro. To create or to change the name of a macro, "
"enter a name here.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_EDIT_RID_MACROCHOOSER_RID_ED_MACRONAME\">Відображає "
"назву вибраного макросу. Щоб створити або змінити назву макросу, введіть "
"назву тут.</ahelp>"

#: 06130000.xhp#hd_id3153729.7.help.text
#: 06130000.xhp%23hd_id3153729.7.help.text
msgid "Macro from / Save macro in"
msgstr "Макрос із / Зберегти макрос у"

#: 06130000.xhp#par_id3153190.8.help.text
#: 06130000.xhp%23par_id3153190.8.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_LIBS\">Lists the libraries and the modules where "
"you can open or save your macros. To save a macro with a particular "
"document, open the document, and then open this dialog.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_BASICIDE_LIBS\">Список бібліотек і модулів, у яких можна "
"відкрити або зберегти свої макроси. Щоб зберегти макрос із певним "
"документом, відкрийте документ, а потім відкрийте це діалогове вікно.</ahelp>"

#: 06130000.xhp#hd_id3146975.11.help.text
#: 06130000.xhp%23hd_id3146975.11.help.text
msgid "Run / Save"
msgstr "Запустити / Зберегти"

#: 06130000.xhp#par_id3154791.12.help.text
#: 06130000.xhp%23par_id3154791.12.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_RUN\">Runs or saves "
"the current macro.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_RUN\">Запускає або "
"зберігає поточний макрос.</ahelp>"

#: 06130000.xhp#hd_id3153158.15.help.text
#: 06130000.xhp%23hd_id3153158.15.help.text
msgid "Assign"
msgstr "Призначити"

#: 06130000.xhp#par_id3149961.16.help.text
#: 06130000.xhp%23par_id3149961.16.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ASSIGN\">Opens the "
"Customize dialog, where you can assign the selected macro to a menu command, "
"a toolbar, or an event.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ASSIGN\">Відкриває "
"діалогове вікно \"Налаштувати\", де можна призначити вибраний макрос команді "
"меню, панелі інструментів або події.</ahelp>"

#: 06130000.xhp#hd_id3145799.17.help.text
#: 06130000.xhp%23hd_id3145799.17.help.text
msgctxt "06130000.xhp#hd_id3145799.17.help.text"
msgid "Edit"
msgstr "Редагувати"

#: 06130000.xhp#par_id3147127.18.help.text
#: 06130000.xhp%23par_id3147127.18.help.text
msgid ""
"<ahelp hid=\".\">Starts the $[officename] Basic editor and opens the "
"selected macro for editing.</ahelp>"
msgstr ""
"<ahelp hid=\".\">Запускає редактор $[officename] Basic і відкриває вибраний "
"макрос для редагування.</ahelp>"

#: 06130000.xhp#hd_id3149400.19.help.text
#: 06130000.xhp%23hd_id3149400.19.help.text
msgid "New/Delete"
msgstr "Створити/Видалити"

#: 06130000.xhp#par_id3155602.61.help.text
#: 06130000.xhp%23par_id3155602.61.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_DEL\">Creates a new "
"macro, or deletes the selected macro.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_DEL\">Створює новий "
"макрос або видаляє вибраний макрос.</ahelp>"

#: 06130000.xhp#par_id3149124.20.help.text
#: 06130000.xhp%23par_id3149124.20.help.text
msgid ""
"To create a new macro, select the \"Standard\" module in the <emph>Macro "
"from</emph> list, and then click <emph>New</emph>. "
msgstr ""
"Щоб створити новий макрос, виберіть модуль \"Стандартний\" у списку <emph>"
"Макрос із</emph>, а потім натисніть <emph>Новий</emph>. "

#: 06130000.xhp#par_id3150749.21.help.text
#: 06130000.xhp%23par_id3150749.21.help.text
msgid "To delete a macro, select it, and then click <emph>Delete</emph>."
msgstr "Щоб видалити макрос, виберіть його та натисніть <emph>Видалити</emph>."

#: 06130000.xhp#hd_id3153764.22.help.text
#: 06130000.xhp%23hd_id3153764.22.help.text
msgid "Organizer"
msgstr "Упорядник"

#: 06130000.xhp#par_id3148405.23.help.text
#: 06130000.xhp%23par_id3148405.23.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ORG\">Opens the <emph>"
"Macro Organizer</emph> dialog, where you can add, edit, or delete existing "
"macro modules, dialogs, and libraries.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ORG\">Відкриває "
"діалогове вікно <emph>Упорядник макросів</emph>, де можна додавати, "
"редагувати або видаляти існуючі модулі макросів, діалогові вікна та "
"бібліотеки.</ahelp>"

#: 06130000.xhp#hd_id3166447.29.help.text
#: 06130000.xhp%23hd_id3166447.29.help.text
msgid "Module/Dialog"
msgstr "Модуль/Діалог"

#: 06130000.xhp#par_id3155959.30.help.text
#: 06130000.xhp%23par_id3155959.30.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_MODULES_TREE\">Lists the existing macros and "
"dialogs.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_BASICIDE_MODULES_TREE\">Список існуючих макросів і "
"діалогових вікон.</ahelp>"

#: 06130000.xhp#par_id3149922.31.help.text
#: 06130000.xhp%23par_id3149922.31.help.text
msgid "You can drag-and-drop a module or a dialog between libraries."
msgstr "Ви можете перетягувати модуль або діалогове вікно між бібліотеками."

#: 06130000.xhp#par_id3159333.33.help.text
#: 06130000.xhp%23par_id3159333.33.help.text
msgid ""
"To copy a dialog or a module, hold down the <switchinline select=\"sys\"><"
"caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline> key "
"while you drag-and-drop."
msgstr ""
"Щоб скопіювати діалогове вікно чи модуль, утримуйте клавішу <switchinline "
"select=\"sys\"><caseinline select=\"MAC\""
">Command</caseinline><defaultinline>Ctrl</defaultinline></switchinline> під "
"час перетягування та кидання."

#: 06130000.xhp#hd_id3147131.34.help.text
#: 06130000.xhp%23hd_id3147131.34.help.text
msgctxt "06130000.xhp#hd_id3147131.34.help.text"
msgid "Edit"
msgstr "Редагувати"

#: 06130000.xhp#par_id3149816.35.help.text
#: 06130000.xhp%23par_id3149816.35.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_EDIT\">Opens the "
"selected macro or dialog for editing.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_EDIT\">Відкриває "
"вибраний макрос або діалогове вікно для редагування.</ahelp>"

#: 06130000.xhp#hd_id3151214.36.help.text
#: 06130000.xhp%23hd_id3151214.36.help.text
msgctxt "06130000.xhp#hd_id3151214.36.help.text"
msgid "New"
msgstr "Новий модуль"

#: 06130000.xhp#par_id3154202.37.help.text
#: 06130000.xhp%23par_id3154202.37.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWMOD\">Creates a new "
"module.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWMOD\">Створює новий "
"модуль.</ahelp>"

#: 06130000.xhp#par_id3153269.40.help.text
#: 06130000.xhp%23par_id3153269.40.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWDLG\">Creates a new "
"dialog.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWDLG\">Створює новий "
"діалог.</ahelp>"

#: 06130000.xhp#hd_id3154587.42.help.text
#: 06130000.xhp%23hd_id3154587.42.help.text
msgid "Libraries tab page"
msgstr "Вкладка \"Бібліотеки\"."

#: 06130000.xhp#par_id3153705.43.help.text
#: 06130000.xhp%23par_id3153705.43.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWDLG\">Lets you manage "
"the macro libraries.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWDLG\">Дозволяє "
"керувати бібліотеками макросів.</ahelp>"

#: 06130000.xhp#hd_id3145259.44.help.text
#: 06130000.xhp%23hd_id3145259.44.help.text
msgid "Location"
msgstr "Розташування"

#: 06130000.xhp#par_id3153234.45.help.text
#: 06130000.xhp%23par_id3153234.45.help.text
msgid ""
"<ahelp hid=\"BASCTL_LISTBOX_RID_TP_LIBS_RID_LB_BASICS\">Select the location "
"containing the macro libraries that you want to organize.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_LISTBOX_RID_TP_LIBS_RID_LB_BASICS\">Виберіть "
"розташування, що містить бібліотеки макросів, які потрібно "
"впорядкувати.</ahelp>"

#: 06130000.xhp#hd_id3148460.46.help.text
#: 06130000.xhp%23hd_id3148460.46.help.text
msgid "Library"
msgstr "Бібліотека"

#: 06130000.xhp#par_id3150828.47.help.text
#: 06130000.xhp%23par_id3150828.47.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_LIBS_TREE\">Lists the macro libraries in the "
"chosen location.</ahelp>"
msgstr ""
"<ahelp hid=\"HID_BASICIDE_LIBS_TREE\">Список бібліотек макросів у вибраному "
"розташуванні.</ahelp>"

#: 06130000.xhp#hd_id3145134.48.help.text
#: 06130000.xhp%23hd_id3145134.48.help.text
msgctxt "06130000.xhp#hd_id3145134.48.help.text"
msgid "Edit"
msgstr "Редагувати"

#: 06130000.xhp#par_id3150518.49.help.text
#: 06130000.xhp%23par_id3150518.49.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_EDIT\">Opens the "
"$[officename] Basic editor so that you can modify the selected "
"library.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_EDIT\">Відкриває редактор "
"$[officename] Basic, щоб можна було змінити вибрану бібліотеку.</ahelp>"

#: 06130000.xhp#hd_id3150371.50.help.text
#: 06130000.xhp%23hd_id3150371.50.help.text
msgctxt "06130000.xhp#hd_id3150371.50.help.text"
msgid "Password"
msgstr "Пароль"

#: 06130000.xhp#par_id3166430.51.help.text
#: 06130000.xhp%23par_id3166430.51.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_PASSWORD\">Assigns or "
"edits the <link href=\"text/sbasic/shared/01/06130100.xhp\" name=\"password\""
">password</link> for the selected library. \"Standard\" libraries cannot "
"have a password.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_PASSWORD\">Призначає або "
"редагує <link href=\"text/sbasic/shared/01/06130100.xhp\" name=\"пароль\""
">пароль</link> для вибраної бібліотеки. \"Стандартні\" бібліотеки не можуть "
"мати пароль.</ahelp>"

#: 06130000.xhp#hd_id3154372.52.help.text
#: 06130000.xhp%23hd_id3154372.52.help.text
msgctxt "06130000.xhp#hd_id3154372.52.help.text"
msgid "New"
msgstr "Створити"

#: 06130000.xhp#par_id3145387.53.help.text
#: 06130000.xhp%23par_id3145387.53.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_NEWLIB\">Creates a new "
"library.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_NEWLIB\">Створює нову "
"бібліотеку.</ahelp>"

#: 06130000.xhp#hd_id3154259.56.help.text
#: 06130000.xhp%23hd_id3154259.56.help.text
msgid "Name"
msgstr "Назва"

#: 06130000.xhp#par_id3156169.57.help.text
#: 06130000.xhp%23par_id3156169.57.help.text
msgid ""
"<ahelp hid=\"BASCTL_EDIT_RID_DLG_NEWLIB_RID_ED_LIBNAME\">Enter a name for "
"the new module, dialog, or library.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_EDIT_RID_DLG_NEWLIB_RID_ED_LIBNAME\">Введіть назву для "
"нового модуля, діалогового вікна або бібліотеки.</ahelp>"

#: 06130000.xhp#hd_id3151183.54.help.text
#: 06130000.xhp%23hd_id3151183.54.help.text
msgid "Append"
msgstr "Додати"

#: 06130000.xhp#par_id3155126.55.help.text
#: 06130000.xhp%23par_id3155126.55.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_APPEND\">Locate that "
"$[officename] Basic library that you want to add to the current list, and "
"then click Open.</ahelp>"
msgstr ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_APPEND\">Знайдіть "
"бібліотеку $[officename] Basic, яку потрібно додати до поточного списку, і "
"натисніть \"Відкрити\".</ahelp>"
