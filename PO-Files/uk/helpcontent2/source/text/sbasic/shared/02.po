msgstr ""
"<image id=\"img_id3147077\" src=\"res/commandimagelist/sc_timefield.png\" "
"width=\"0.1665inch\" height=\"0.1665inch\"><alt id=\"alt_id3147077\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3151191.41.help.text
#: 20000000.xhp%23par_id3151191.41.help.text
msgid "<ahelp hid=\"SID_INSERT_TIMEFIELD\">Adds a time field.</ahelp>"
msgstr "<ahelp hid=\"SID_INSERT_TIMEFIELD\">Додає поле часу.</ahelp>"

#: 20000000.xhp#hd_id3154733.42.help.text
#: 20000000.xhp%23hd_id3154733.42.help.text
msgid "Numeric Field"
msgstr "Числове поле"

#: 20000000.xhp#par_id3146107.help.text
#: 20000000.xhp%23par_id3146107.help.text
msgid ""
"<image id=\"img_id3147499\" src=\"res/commandimagelist/sc_insertnumericfield."
"png\" width=\"0.0874inch\" height=\"0.0874inch\"><alt id=\"alt_id3147499\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3147499\" src=\"res/commandimagelist/sc_insertnumericfield."
"png\" width=\"0.0874inch\" height=\"0.0874inch\"><alt id=\"alt_id3147499\""
