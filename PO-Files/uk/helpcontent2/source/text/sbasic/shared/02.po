msgid "Insert Controls"
msgstr "Вставити елемент керування"

#: 20000000.xhp#par_id3157958.5.help.text
#: 20000000.xhp%23par_id3157958.5.help.text
msgid ""
"In edit mode, double-click a control to open the <link href=\""
"text/sbasic/shared/01170100.xhp\" name=\"properties dialog\">properties "
"dialog</link>."
msgstr ""
"У режимі редагування двічі клацніть елемент керування, щоб відкрити <link "
"href=\"text/sbasic/shared/01170100.xhp\" name=\"діалогове вікно "
"властивостей\">діалогове вікно властивостей</link>."

#: 20000000.xhp#par_id3148538.6.help.text
#: 20000000.xhp%23par_id3148538.6.help.text
msgid ""
"In edit mode, you can also right-click a control and choose the cut, copy, "
"and paste command."
msgstr ""
"У режимі редагування ви також можете клацнути правою кнопкою миші елемент "
"керування та вибрати команду вирізати, скопіювати та вставити."

#: 20000000.xhp#hd_id3148473.7.help.text
#: 20000000.xhp%23hd_id3148473.7.help.text
msgid "Button"
msgstr "Кнопка"

#: 20000000.xhp#par_id3153824.help.text
#: 20000000.xhp%23par_id3153824.help.text
msgid ""
"<image id=\"img_id3157909\" src=\"res/commandimagelist/sc_insertpushbutton."
"png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3157909\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3157909\" src=\"res/commandimagelist/sc_insertpushbutton."
"png\" width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3157909\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3147530.8.help.text
#: 20000000.xhp%23par_id3147530.8.help.text
msgid ""
"<ahelp hid=\".uno:InsertPushbutton\">Adds a command button.</ahelp> You can "
"use a command button to execute a command for a defined event, such as a "
"mouse click."
msgstr ""
"<ahelp hid=\".uno:InsertPushbutton\">Додає командну кнопку.</ahelp> Ви "
"можете використовувати командну кнопку для виконання команди для певної "
"події, наприклад клацання миші."

#: 20000000.xhp#par_id3154923.9.help.text
#: 20000000.xhp%23par_id3154923.9.help.text
msgid "If you want, you can add text or a graphic to the button."
msgstr "Якщо хочете, ви можете додати текст або графіку до кнопки."

#: 20000000.xhp#hd_id3148550.10.help.text
#: 20000000.xhp%23hd_id3148550.10.help.text
msgid "Image Control"
msgstr "Елемент керування \"зображення\""

#: 20000000.xhp#par_id3154138.help.text
msgid ""
"<image id=\"img_id3144760\" src=\"res/commandimagelist/sc_imagecontrol.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3144760\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3144760\" src=\"res/commandimagelist/sc_imagecontrol.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3144760\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3151042.11.help.text
#: 20000000.xhp%23par_id3151042.11.help.text
msgid ""
"<ahelp hid=\".uno:InsertImageControl\">Adds a control that displays a "
"graphic.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:InsertImageControl\">Додає елемент керування, який "
"відображає графіку.</ahelp>"

#: 20000000.xhp#hd_id3150447.12.help.text
#: 20000000.xhp%23hd_id3150447.12.help.text
msgid "Check Box"
msgstr "Прапорець"

#: 20000000.xhp#par_id3155131.help.text
#: 20000000.xhp%23par_id3155131.help.text
msgid ""
"<image id=\"img_id3150439\" src=\"res/commandimagelist/sc_checkbox.png\" "
"width=\"0.1665inch\" height=\"0.1665inch\"><alt id=\"alt_id3150439\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3150439\" src=\"res/commandimagelist/sc_checkbox.png\" "
"width=\"0.1665inch\" height=\"0.1665inch\"><alt id=\"alt_id3150439\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3147317.13.help.text
#: 20000000.xhp%23par_id3147317.13.help.text
msgid ""
"<ahelp hid=\".uno:Checkbox\">Adds a check box that you can use to turn a "
"function on or off.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:Checkbox\">Додає прапорець, за допомогою якого можна "
"увімкнути або вимкнути функцію.</ahelp>"

#: 20000000.xhp#hd_id3150486.14.help.text
#: 20000000.xhp%23hd_id3150486.14.help.text
msgid "Option Button"
msgstr "Кнопка вибору"

#: 20000000.xhp#par_id3155856.help.text
#: 20000000.xhp%23par_id3155856.help.text
msgid ""
"<image id=\"img_id3146921\" src=\"res/commandimagelist/sc_radiobutton.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3146921\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3146921\" src=\"res/commandimagelist/sc_radiobutton.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3146921\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3153575.15.help.text
#: 20000000.xhp%23par_id3153575.15.help.text
msgid ""
"<ahelp hid=\".uno:Radiobutton\">Adds a button that allows a user to select "
"from a number of options.</ahelp> Grouped option buttons must have "
"consecutive tab indices. They are commonly encircled by a group box. If you "
"have two groups of option buttons, you must insert a tab index between the "
"tab indices of the two groups on the group frame."
msgstr ""
"<ahelp hid=\".uno:Radiobutton\">Додає кнопку, яка дозволяє користувачеві "
"вибирати з кількох параметрів.</ahelp> Згруповані кнопки параметрів повинні "
"мати послідовні індекси вкладок. Зазвичай вони обведені рамкою групи. Якщо у "
"вас є дві групи кнопок параметрів, ви повинні вставити індекс вкладки між "
"індексами вкладок двох груп у рамці групи."

#: 20000000.xhp#hd_id3154729.16.help.text
#: 20000000.xhp%23hd_id3154729.16.help.text
msgid "Label Field"
msgstr "Поле мітки"

#: 20000000.xhp#par_id3149300.help.text
#: 20000000.xhp%23par_id3149300.help.text
msgid ""
"<image id=\"img_id3153415\" src=\"res/commandimagelist/sc_insertfixedtext."
"png\" width=\"0.0874inch\" height=\"0.0874inch\"><alt id=\"alt_id3153415\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3153415\" src=\"res/commandimagelist/sc_insertfixedtext."
"png\" width=\"0.0874inch\" height=\"0.0874inch\"><alt id=\"alt_id3153415\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3156181.17.help.text
#: 20000000.xhp%23par_id3156181.17.help.text
msgid ""
"<ahelp hid=\".uno:InsertFixedText\">Adds a field for displaying text "
"labels.</ahelp> These labels are only for displaying predefined text, and "
"not for entering text."
msgstr ""
"<ahelp hid=\".uno:InsertFixedText\">Додає поле для відображення текстових "
"міток.</ahelp> Ці мітки призначені лише для відображення попередньо "
"визначеного тексту, а не для введення тексту."

#: 20000000.xhp#hd_id3149123.18.help.text
#: 20000000.xhp%23hd_id3149123.18.help.text
msgid "Text Box"
msgstr "Текстове поле"

#: 20000000.xhp#par_id3153766.help.text
#: 20000000.xhp%23par_id3153766.help.text
msgid ""
"<image id=\"img_id3148996\" src=\"res/commandimagelist/sc_edit.png\" width=\""
"0.0874inch\" height=\"0.0874inch\"><alt id=\"alt_id3148996\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3148996\" src=\"res/commandimagelist/sc_edit.png\" width=\""
"0.0874inch\" height=\"0.0874inch\"><alt id=\"alt_id3148996\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3153712.19.help.text
#: 20000000.xhp%23par_id3153712.19.help.text
msgid ""
"<ahelp hid=\".uno:InsertEdit\">Adds an input box where you can enter and "
"edit text.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:InsertEdit\">Додає поле введення, де можна вводити та "
"редагувати текст.</ahelp>"

#: 20000000.xhp#hd_id3154253.20.help.text
#: 20000000.xhp%23hd_id3154253.20.help.text
msgid "List Box"
msgstr "Список"

#: 20000000.xhp#par_id3155959.help.text
#: 20000000.xhp%23par_id3155959.help.text
msgid ""
"<image id=\"img_id3163808\" src=\"res/commandimagelist/sc_listbox.png\" "
"width=\"0.1665inch\" height=\"0.1665inch\"><alt id=\"alt_id3163808\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3163808\" src=\"res/commandimagelist/sc_listbox.png\" "
"width=\"0.1665inch\" height=\"0.1665inch\"><alt id=\"alt_id3163808\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3155176.21.help.text
#: 20000000.xhp%23par_id3155176.21.help.text
msgid ""
"<ahelp hid=\".uno:InsertListbox\">Adds a box where you can click an entry on "
"a list.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:InsertListbox\">Додає поле, у якому можна клацнути запис у "
"списку.</ahelp>"

#: 20000000.xhp#hd_id3150644.22.help.text
#: 20000000.xhp%23hd_id3150644.22.help.text
msgid "Combo Box"
msgstr "Поле зі списком"

#: 20000000.xhp#par_id3148418.help.text
#: 20000000.xhp%23par_id3148418.help.text
msgid ""
"<image id=\"img_id3153200\" src=\"res/commandimagelist/sc_combobox.png\" "
"width=\"0.1665inch\" height=\"0.1665inch\"><alt id=\"alt_id3153200\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3153200\" src=\"res/commandimagelist/sc_combobox.png\" "
"width=\"0.1665inch\" height=\"0.1665inch\"><alt id=\"alt_id3153200\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3154199.23.help.text
#: 20000000.xhp%23par_id3154199.23.help.text
msgid ""
"<ahelp hid=\".uno:Combobox\">Adds a combo box. A combo box is a one line "
"list box that a user can click, and then choose an entry from the "
"list.</ahelp> If you want, you can make the entries in the combo box \"read "
"only\"."
msgstr ""
"<ahelp hid=\".uno:Combobox\">Додає поле зі списком. Поле зі списком — це "
"однорядкове поле зі списком, яке користувач може клацнути, а потім вибрати "
"запис зі списку.</ahelp> За бажанням можна зробити записи в полі зі списком "
"\"лише для читання\"."

#: 20000000.xhp#hd_id3154585.24.help.text
#: 20000000.xhp%23hd_id3154585.24.help.text
msgid "Horizontal Scrollbar"
msgstr "Горизонтальна смуга прокрутки"

#: 20000000.xhp#par_id3153781.help.text
#: 20000000.xhp%23par_id3153781.help.text
msgid ""
"<image id=\"img_id3149530\" src=\"res/commandimagelist/sc_hscrollbar.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149530\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3149530\" src=\"res/commandimagelist/sc_hscrollbar.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3149530\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3153232.25.help.text
#: 20000000.xhp%23par_id3153232.25.help.text
msgid ""
"<ahelp hid=\".uno:HScrollbar\">Adds a horizontal scrollbar to the "
"dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:HScrollbar\">Додає горизонтальну смугу прокручування до "
"діалогового вікна.</ahelp>"

#: 20000000.xhp#hd_id3154119.26.help.text
#: 20000000.xhp%23hd_id3154119.26.help.text
msgid "Vertical Scrollbar"
msgstr "Вертикальна смуга прокрутки"

#: 20000000.xhp#par_id3150515.help.text
#: 20000000.xhp%23par_id3150515.help.text
msgid ""
"<image id=\"img_id3150203\" src=\"res/commandimagelist/sc_vscrollbar.png\" "
"width=\"0.1665inch\" height=\"0.1665inch\"><alt id=\"alt_id3150203\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3150203\" src=\"res/commandimagelist/sc_vscrollbar.png\" "
"width=\"0.1665inch\" height=\"0.1665inch\"><alt id=\"alt_id3150203\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3155376.27.help.text
#: 20000000.xhp%23par_id3155376.27.help.text
msgid ""
"<ahelp hid=\".uno:VScrollbar\">Adds a vertical scrollbar to the "
"dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:VScrollbar\">Додає вертикальну смугу прокручування до "
"діалогового вікна.</ahelp>"

#: 20000000.xhp#hd_id3150313.28.help.text
#: 20000000.xhp%23hd_id3150313.28.help.text
msgid "Group Box"
msgstr "Група"

#: 20000000.xhp#par_id3151184.help.text
#: 20000000.xhp%23par_id3151184.help.text
msgid ""
"<image id=\"img_id3151335\" src=\"res/commandimagelist/sc_groupbox.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3151335\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3151335\" src=\"res/commandimagelist/sc_groupbox.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3151335\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3159622.29.help.text
#: 20000000.xhp%23par_id3159622.29.help.text
msgid ""
"<ahelp hid=\".uno:Groupbox\">Adds a frame that you can use to visually group "
"similar controls, such as option buttons.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:Groupbox\">Додає рамку, яку можна використовувати для "
"візуального групування схожих елементів керування, наприклад кнопок "
"опцій.</ahelp>"

#: 20000000.xhp#par_id3148820.30.help.text
#: 20000000.xhp%23par_id3148820.30.help.text
msgid ""
"To define two different groups of option buttons, ensure that the tab index "
"of the group frame is between the tab indices of the two groups."
msgstr ""
"Щоб визначити дві різні групи кнопок параметрів, переконайтеся, що індекс "
"вкладки рамки групи знаходиться між індексами вкладок двох груп."

#: 20000000.xhp#hd_id3149330.31.help.text
#: 20000000.xhp%23hd_id3149330.31.help.text
msgid "Progress Bar"
msgstr "Індикатор виконання"

#: 20000000.xhp#par_id3159093.help.text
#: 20000000.xhp%23par_id3159093.help.text
msgid ""
"<image id=\"img_id3150318\" src=\"res/commandimagelist/sc_progressbar.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3150318\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3150318\" src=\"res/commandimagelist/sc_progressbar.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3150318\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3157979.32.help.text
#: 20000000.xhp%23par_id3157979.32.help.text
msgid ""
"<ahelp hid=\".uno:ProgressBar\">Adds a progress bar to the dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:ProgressBar\">Додає індикатор прогресу до діалогового "
"вікна.</ahelp>"

#: 20000000.xhp#hd_id3145654.33.help.text
#: 20000000.xhp%23hd_id3145654.33.help.text
msgid "Horizontal Line"
msgstr "Горизонтальна лінія"

#: 20000000.xhp#par_id3150888.help.text
#: 20000000.xhp%23par_id3150888.help.text
msgid ""
"<image id=\"img_id3152872\" src=\"res/commandimagelist/sc_hfixedline.png\" "
"width=\"0.2201inch\" height=\"0.2201inch\"><alt id=\"alt_id3152872\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3152872\" src=\"res/commandimagelist/sc_hfixedline.png\" "
"width=\"0.2201inch\" height=\"0.2201inch\"><alt id=\"alt_id3152872\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3151000.34.help.text
#: 20000000.xhp%23par_id3151000.34.help.text
msgid ""
"<ahelp hid=\".uno:HFixedLine\">Adds a horizontal line to the dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:HFixedLine\">Додає горизонтальну лінію до діалогового "
"вікна.</ahelp>"

#: 20000000.xhp#hd_id3155095.35.help.text
#: 20000000.xhp%23hd_id3155095.35.help.text
msgid "Vertical Line"
msgstr "Вертикальна лінія"

#: 20000000.xhp#par_id3154913.help.text
#: 20000000.xhp%23par_id3154913.help.text
msgid ""
"<image id=\"img_id3153249\" src=\"res/commandimagelist/sc_vfixedline.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3153249\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3153249\" src=\"res/commandimagelist/sc_vfixedline.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3153249\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3159203.36.help.text
#: 20000000.xhp%23par_id3159203.36.help.text
msgid ""
"<ahelp hid=\".uno:VFixedLine\">Adds a vertical line to the dialog.</ahelp>"
msgstr ""
"<ahelp hid=\".uno:VFixedLine\">Додає вертикальну лінію до діалогу.</ahelp>"

#: 20000000.xhp#hd_id3154540.37.help.text
#: 20000000.xhp%23hd_id3154540.37.help.text
msgid "Date Field"
msgstr "Поле дати"

#: 20000000.xhp#par_id3148901.help.text
#: 20000000.xhp%23par_id3148901.help.text
msgid ""
"<image id=\"img_id3151010\" src=\"res/commandimagelist/sc_adddatefield.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3151010\""
">Icon</alt></image>"
msgstr ""
"<image id=\"img_id3151010\" src=\"res/commandimagelist/sc_adddatefield.png\" "
"width=\"0.222inch\" height=\"0.222inch\"><alt id=\"alt_id3151010\""
">Піктограма</alt></image>"

#: 20000000.xhp#par_id3154214.38.help.text
#: 20000000.xhp%23par_id3154214.38.help.text
msgid "<ahelp hid=\".uno:AddDateField\">Adds a date field.</ahelp>"
msgstr "<ahelp hid=\".uno:AddDateField\">Додає поле дати.</ahelp>"

#: 20000000.xhp#par_id3150046.39.help.text
#: 20000000.xhp%23par_id3150046.39.help.text
msgid ""
"If you assign the \"dropdown\" property to the date field, a user can drop "
"down a calendar to select a date."
msgstr ""
"Якщо ви призначите властивість \"спадне меню\" для поля дати, користувач "
"зможе вибрати дату в розкривному календарі."

#: 20000000.xhp#hd_id3151126.40.help.text
#: 20000000.xhp%23hd_id3151126.40.help.text
msgid "Time Field"
msgstr "Поле часу"

#: 20000000.xhp#par_id3154338.help.text
#: 20000000.xhp%23par_id3154338.help.text
msgid ""
"<image id=\"img_id3147077\" src=\"res/commandimagelist/sc_timefield.png\" "
