#: sdbt_strings.src#STR_QUERY_AND_TABLE_DISTINCT_NAMES.string.text
#: sdbt_strings.src%23STR_QUERY_AND_TABLE_DISTINCT_NAMES.string.text
msgid ""
"You cannot give a table and a query the same name. Please use a name which "
"is not yet used by a query or table."
msgstr ""
"Non pode dar o mesmo nome a unha táboa e a unha consulta. Utilice un nome "
"que non pertenza a outra táboa ou consulta."

#: sdbt_strings.src#STR_BASENAME_TABLE.string.text
#: sdbt_strings.src%23STR_BASENAME_TABLE.string.text
msgid "Table"
msgstr "Táboa"

#: sdbt_strings.src#STR_BASENAME_QUERY.string.text
#: sdbt_strings.src%23STR_BASENAME_QUERY.string.text
msgid "Query"
msgstr "Consulta"

#: sdbt_strings.src#STR_CONN_WITHOUT_QUERIES_OR_TABLES.string.text
#: sdbt_strings.src%23STR_CONN_WITHOUT_QUERIES_OR_TABLES.string.text
msgid "The given connection is no valid query and/or tables supplier."
msgstr ""
"A conexión proporcionada non é unha consulta correcta e/ou un fornecedor de "
"táboas."

#: sdbt_strings.src#STR_NO_TABLE_OBJECT.string.text
#: sdbt_strings.src%23STR_NO_TABLE_OBJECT.string.text
msgid "The given object is no table object."
msgstr "O obxecto indicado non é un obxecto de táboa."

#: sdbt_strings.src#STR_INVALID_COMPOSITION_TYPE.string.text
#: sdbt_strings.src%23STR_INVALID_COMPOSITION_TYPE.string.text
msgid ""
"Invalid composition type - need a value from "
"com.sun.star.sdb.tools.CompositionType."
msgstr ""
"Tipo de composición incorrecta - precísase un valor de "
"com.sun.star.sdb.tools.CompositionType."

#: sdbt_strings.src#STR_INVALID_COMMAND_TYPE.string.text
#: sdbt_strings.src%23STR_INVALID_COMMAND_TYPE.string.text
msgid ""
"Invalid command type - only TABLE and QUERY from "
"com.sun.star.sdb.CommandType are allowed."
msgstr ""
"O tipo de orde non é correcto - só se permiten o tipo de ordes (CommandType) "
"TABLE e QUERY de com.sun.star.sdb."
