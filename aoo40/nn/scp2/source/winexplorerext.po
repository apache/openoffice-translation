#: module_winexplorerext.ulf%23STR_NAME_MODULE_OPTIONAL_WINDOWS_EXPLORER_EXTENSIONS.LngText.text
msgid "Windows Explorer Extension"
msgstr "Utviding til Windows utforskar"

#: module_winexplorerext.ulf%23STR_DESC_MODULE_OPTIONAL_WINDOWS_EXPLORER_EXTENSIONS.LngText.text
msgid ""
"Enables the Microsoft Windows Explorer to show information about %"
"PRODUCTNAME documents, such as thumbnail previews."
msgstr ""
"Gjer utforskaren i Microsoft Windows i stand til å visa informasjon om "
"%PRODUCTNAME-dokument, som til dømes førehandsvising."
