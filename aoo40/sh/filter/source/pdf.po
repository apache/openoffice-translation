#: impdialog.src%23RID_PDF_ERROR_DLG.STR_WARN_TRANSP_PDFA_SHORT.string.text
#: impdialog.src#RID_PDF_ERROR_DLG.STR_WARN_TRANSP_PDFA_SHORT.string.text
msgid "PDF/A transparency"
msgstr "PDF/A providnost"

#: impdialog.src%23RID_PDF_ERROR_DLG.STR_WARN_TRANSP_PDFA.string.text
#: impdialog.src#RID_PDF_ERROR_DLG.STR_WARN_TRANSP_PDFA.string.text
msgid ""
"PDF/A forbids transparency. A transparent object was painted opaque instead."
msgstr "PDF/A zabranjuje providnost. Providan objekat je obojen neprovidno."

#: impdialog.src%23RID_PDF_ERROR_DLG.STR_WARN_TRANSP_VERSION_SHORT.string.text
#: impdialog.src#RID_PDF_ERROR_DLG.STR_WARN_TRANSP_VERSION_SHORT.string.text
msgid "PDF version conflict"
msgstr "PDF sukob verzija"

#: impdialog.src%23RID_PDF_ERROR_DLG.STR_WARN_TRANSP_VERSION.string.text
#: impdialog.src#RID_PDF_ERROR_DLG.STR_WARN_TRANSP_VERSION.string.text
msgid ""
"Transparency is not supported in PDF versions earlier than PDF 1.4. A "
"transparent object was painted opaque instead"
msgstr ""
"Providnost nije podržana u PDF verzijima starijim od PDF 1.4. Providan "
"objekat je obojen neprovidno."

#: impdialog.src%23RID_PDF_ERROR_DLG.STR_WARN_FORMACTION_PDFA_SHORT.string.text
#: impdialog.src#RID_PDF_ERROR_DLG.STR_WARN_FORMACTION_PDFA_SHORT.string.text
msgid "PDF/A form action"
msgstr "PDF/A akcija formulara"

#: impdialog.src%23RID_PDF_ERROR_DLG.STR_WARN_FORMACTION_PDFA.string.text
#: impdialog.src#RID_PDF_ERROR_DLG.STR_WARN_FORMACTION_PDFA.string.text
msgid ""
"A form control contained an action not supported by the PDF/A standard. The "
"action was skipped"
msgstr ""
"Kontrola forme sadrži akciju koja nije podržana PDF/A standardom. Akcija je "
"zanemarena"

#: impdialog.src%23RID_PDF_ERROR_DLG.STR_WARN_TRANSP_CONVERTED.string.text
#: impdialog.src#RID_PDF_ERROR_DLG.STR_WARN_TRANSP_CONVERTED.string.text
msgid ""
"Some objects were converted to an image in order to remove transparencies, "
"because the target PDF format does not support transparencies. Possibly "
"better results can be achieved if you remove the transparent objects before "
"exporting."
msgstr ""
"Neki objekti su pretvoreni u sliku kako bi se uklonila providnost pošto je "
"odredišni PDF format ne podržava. Moguće da ćete postići bolje rezultate ako "
"uklonite providne objekte pre izvoza dokumenta."

#: impdialog.src%23RID_PDF_ERROR_DLG.STR_WARN_TRANSP_CONVERTED_SHORT.string.text
#: impdialog.src#RID_PDF_ERROR_DLG.STR_WARN_TRANSP_CONVERTED_SHORT.string.text
msgid "Transparencies removed"
msgstr "Uklonjena providnost"

#: impdialog.src%23RID_PDF_ERROR_DLG.modaldialog.text
#: impdialog.src#RID_PDF_ERROR_DLG.modaldialog.text
msgid "Problems during PDF export"
msgstr "Problem prilikom izvoza u PDF"
