#: solver.src#RID_SOLVER_COMPONENT.string.text
#: solver.src%23RID_SOLVER_COMPONENT.string.text
msgid "%PRODUCTNAME Linear Solver"
msgstr "Fuasglair loidhneach %PRODUCTNAME"

#: solver.src#RID_PROPERTY_NONNEGATIVE.string.text
#: solver.src%23RID_PROPERTY_NONNEGATIVE.string.text
msgid "Assume variables as non-negative"
msgstr "Cuir mar fhiacham nach eil na caochladairean àicheach"

#: solver.src#RID_PROPERTY_INTEGER.string.text
#: solver.src%23RID_PROPERTY_INTEGER.string.text
msgid "Assume variables as integer"
msgstr "Cuir mar fhiacham gur e àireamh shlàn a tha anns na caochladairean"

#: solver.src#RID_PROPERTY_TIMEOUT.string.text
#: solver.src%23RID_PROPERTY_TIMEOUT.string.text
msgid "Solving time limit (seconds)"
msgstr "Cuingeachadh ama airson fuasgladh (ann an diogan)"

#: solver.src#RID_PROPERTY_EPSILONLEVEL.string.text
#: solver.src%23RID_PROPERTY_EPSILONLEVEL.string.text
msgid "Epsilon level (0-3)"
msgstr "Leibheil epsilon (0-3)"

#: solver.src#RID_PROPERTY_LIMITBBDEPTH.string.text
#: solver.src%23RID_PROPERTY_LIMITBBDEPTH.string.text
msgid "Limit branch-and-bound depth"
msgstr "Cuingich doimhneachd air geugadh is ceangladh"

#: solver.src#RID_PROPERTY_NONLINEARTEST.string.text
#: solver.src%23RID_PROPERTY_NONLINEARTEST.string.text
msgid "Run strict linearity checks"
msgstr ""

#: solver.src#RID_ERROR_NONLINEAR.string.text
#: solver.src%23RID_ERROR_NONLINEAR.string.text
msgid "The model seems nonlinear (see options)."
msgstr ""

#: solver.src#RID_ERROR_EPSILONLEVEL.string.text
#: solver.src%23RID_ERROR_EPSILONLEVEL.string.text
msgid "The epsilon level is invalid."
msgstr "Tha an leibheil epsilon seo mì-dhligheach."

#: solver.src#RID_ERROR_INFEASIBLE.string.text
#: solver.src%23RID_ERROR_INFEASIBLE.string.text
msgid "The model is infeasible. Check limiting conditions."
msgstr ""
"Cha ghabh am modail seo fhuasgladh. Cuir sùil air na cumhaichean "
"cuingeachaidh."

#: solver.src#RID_ERROR_UNBOUNDED.string.text
#: solver.src%23RID_ERROR_UNBOUNDED.string.text
msgid "The model is unbounded."
msgstr "Tha am modail seo gun chuingeachadh."

#: solver.src#RID_ERROR_TIMEOUT.string.text
#: solver.src%23RID_ERROR_TIMEOUT.string.text
msgid "The time limit was reached."
msgstr "Ràinigeadh an cuingeachadh ùine."
