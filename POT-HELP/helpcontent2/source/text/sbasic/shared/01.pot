#: 06130000.xhp%23tit.help.text
msgctxt "06130000.xhp#tit.help.text"
msgid "Macro"
msgstr ""

#: 06130000.xhp%23bm_id3145786.help.text
msgid ""
"<bookmark_value>macros; Basic IDE</bookmark_value><bookmark_value>Basic IDE; "
"macros</bookmark_value>"
msgstr ""

#: 06130000.xhp%23hd_id3145786.help.text
msgctxt "06130000.xhp#hd_id3145786.help.text"
msgid "Macro"
msgstr ""

#: 06130000.xhp%23par_id3152886.help.text
msgid ""
"<variable id=\"makro\"><ahelp hid=\".\">Opens the <emph>Macro</emph> dialog, "
"where you can create, edit, organize, and run $[officename] Basic macros.</"
"ahelp></variable>"
msgstr ""

#: 06130000.xhp%23hd_id3154145.help.text
msgid "Macro name"
msgstr ""

#: 06130000.xhp%23par_id3151116.help.text
msgid ""
"<ahelp hid=\"BASCTL_EDIT_RID_MACROCHOOSER_RID_ED_MACRONAME\">Displays the "
"name of the selected macro. To create or to change the name of a macro, "
"enter a name here.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3153729.help.text
msgid "Macro from / Save macro in"
msgstr ""

#: 06130000.xhp%23par_id3153190.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_LIBS\">Lists the libraries and the modules where "
"you can open or save your macros. To save a macro with a particular "
"document, open the document, and then open this dialog.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3146975.help.text
msgid "Run / Save"
msgstr ""

#: 06130000.xhp%23par_id3154791.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_RUN\">Runs or saves "
"the current macro.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3153158.help.text
msgid "Assign"
msgstr ""

#: 06130000.xhp%23par_id3149961.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ASSIGN\">Opens the "
"Customize dialog, where you can assign the selected macro to a menu command, "
"a toolbar, or an event.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3145799.help.text
msgctxt "06130000.xhp#hd_id3145799.help.text"
msgid "Edit"
msgstr ""

#: 06130000.xhp%23par_id3147127.help.text
msgid ""
"<ahelp hid=\".\">Starts the $[officename] Basic editor and opens the "
"selected macro for editing.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3149400.help.text
msgid "New/Delete"
msgstr ""

#: 06130000.xhp%23par_id3155602.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_DEL\">Creates a new "
"macro, or deletes the selected macro.</ahelp>"
msgstr ""

#: 06130000.xhp%23par_id3149124.help.text
msgid ""
"To create a new macro, select the \"Standard\" module in the <emph>Macro "
"from</emph> list, and then click <emph>New</emph>."
msgstr ""

#: 06130000.xhp%23par_id3150749.help.text
msgid "To delete a macro, select it, and then click <emph>Delete</emph>."
msgstr ""

#: 06130000.xhp%23hd_id3153764.help.text
msgid "Organizer"
msgstr ""

#: 06130000.xhp%23par_id3148405.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_MACROCHOOSER_RID_PB_ORG\">Opens the <emph>"
"Macro Organizer</emph> dialog, where you can add, edit, or delete existing "
"macro modules, dialogs, and libraries.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3166447.help.text
msgid "Module/Dialog"
msgstr ""

#: 06130000.xhp%23par_id3155959.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_MODULES_TREE\">Lists the existing macros and "
"dialogs.</ahelp>"
msgstr ""

#: 06130000.xhp%23par_id3149922.help.text
msgid "You can drag-and-drop a module or a dialog between libraries."
msgstr ""

#: 06130000.xhp%23par_id3159333.help.text
msgid ""
"To copy a dialog or a module, hold down the <switchinline select=\"sys\">"
"<caseinline select=\"MAC\">Command</caseinline><defaultinline>Ctrl</"
"defaultinline></switchinline> key while you drag-and-drop."
msgstr ""

#: 06130000.xhp%23hd_id3147131.help.text
msgctxt "06130000.xhp#hd_id3147131.help.text"
msgid "Edit"
msgstr ""

#: 06130000.xhp%23par_id3149816.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_EDIT\">Opens the "
"selected macro or dialog for editing.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3151214.help.text
msgctxt "06130000.xhp#hd_id3151214.help.text"
msgid "New"
msgstr ""

#: 06130000.xhp%23par_id3154202.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWMOD\">Creates a new "
"module.</ahelp>"
msgstr ""

#: 06130000.xhp%23par_id3153269.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWDLG\">Creates a new "
"dialog.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3154587.help.text
msgid "Libraries tab page"
msgstr ""

#: 06130000.xhp%23par_id3153705.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_MODULS_RID_PB_NEWDLG\">Lets you manage "
"the macro libraries.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3145259.help.text
msgid "Location"
msgstr ""

#: 06130000.xhp%23par_id3153234.help.text
msgid ""
"<ahelp hid=\"BASCTL_LISTBOX_RID_TP_LIBS_RID_LB_BASICS\">Select the location "
"containing the macro libraries that you want to organize.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3148460.help.text
msgid "Library"
msgstr ""

#: 06130000.xhp%23par_id3150828.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_LIBS_TREE\">Lists the macro libraries in the "
"chosen location.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3145134.help.text
msgctxt "06130000.xhp#hd_id3145134.help.text"
msgid "Edit"
msgstr ""

#: 06130000.xhp%23par_id3150518.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_EDIT\">Opens the "
"$[officename] Basic editor so that you can modify the selected library.</"
"ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3150371.help.text
msgctxt "06130000.xhp#hd_id3150371.help.text"
msgid "Password"
msgstr ""

#: 06130000.xhp%23par_id3166430.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_PASSWORD\">Assigns or "
"edits the <link href=\"text/sbasic/shared/01/06130100.xhp\" "
"name=\"password\">password</link> for the selected library. \"Standard\" "
"libraries cannot have a password.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3154372.help.text
msgctxt "06130000.xhp#hd_id3154372.help.text"
msgid "New"
msgstr ""

#: 06130000.xhp%23par_id3145387.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_NEWLIB\">Creates a new "
"library.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3154259.help.text
msgid "Name"
msgstr ""

#: 06130000.xhp%23par_id3156169.help.text
msgid ""
"<ahelp hid=\"BASCTL_EDIT_RID_DLG_NEWLIB_RID_ED_LIBNAME\">Enter a name for "
"the new module, dialog, or library.</ahelp>"
msgstr ""

#: 06130000.xhp%23hd_id3151183.help.text
msgid "Append"
msgstr ""

#: 06130000.xhp%23par_id3155126.help.text
msgid ""
"<ahelp hid=\"BASCTL_PUSHBUTTON_RID_TP_LIBS_RID_PB_APPEND\">Locate that "
"$[officename] Basic library that you want to add to the current list, and "
"then click Open.</ahelp>"
msgstr ""

#: 06130500.xhp%23tit.help.text
msgctxt "06130500.xhp#tit.help.text"
msgid "Append libraries"
msgstr ""

#: 06130500.xhp%23bm_id3150502.help.text
msgid ""
"<bookmark_value>libraries; adding</bookmark_value><bookmark_value>"
"inserting;Basic libraries</bookmark_value>"
msgstr ""

#: 06130500.xhp%23hd_id3150502.help.text
msgctxt "06130500.xhp#hd_id3150502.help.text"
msgid "Append libraries"
msgstr ""

#: 06130500.xhp%23par_id3154840.help.text
msgid ""
"<ahelp hid=\".\">Locate that <item type=\"productname\">%PRODUCTNAME</item> "
"Basic library that you want to add to the current list, and then click "
"Open.</ahelp>"
msgstr ""

#: 06130500.xhp%23hd_id3149119.help.text
msgid "File name:"
msgstr ""

#: 06130500.xhp%23par_id3147102.help.text
msgid ""
"<ahelp hid=\"HID_BASICIDE_LIBSDLG_TREE\">Enter a name or the path to the "
"library that you want to append.</ahelp> You can also select a library from "
"the list."
msgstr ""

#: 06130500.xhp%23hd_id3147291.help.text
msgid "Options"
msgstr ""

#: 06130500.xhp%23hd_id3147226.help.text
msgid "Insert as reference (read-only)"
msgstr ""

#: 06130500.xhp%23par_id3155892.help.text
msgid ""
"<ahelp hid=\"BASCTL_CHECKBOX_RID_DLG_LIBS_RID_CB_REF\">Adds the selected "
"library as a read-only file. The library is reloaded each time you start "
"<item type=\"productname\">%PRODUCTNAME</item>.</ahelp>"
msgstr ""

#: 06130500.xhp%23hd_id3145071.help.text
msgid "Replace existing libraries"
msgstr ""

#: 06130500.xhp%23par_id3149812.help.text
msgid ""
"<ahelp hid=\"BASCTL_CHECKBOX_RID_DLG_LIBS_RID_CB_REPL\">Replaces a library "
"that has the same name with the current library.</ahelp>"
msgstr ""

#: 06130100.xhp%23tit.help.text
msgctxt "06130100.xhp#tit.help.text"
msgid "Change Password"
msgstr ""

#: 06130100.xhp%23hd_id3159399.help.text
msgctxt "06130100.xhp#hd_id3159399.help.text"
msgid "Change Password"
msgstr ""

#: 06130100.xhp%23par_id3150276.help.text
msgid ""
"<ahelp hid=\"HID_PASSWORD\">Protects the selected library with a password.</"
"ahelp> You can enter a new password, or change the current password."
msgstr ""

#: 06130100.xhp%23hd_id3154285.help.text
msgid "Old password"
msgstr ""

#: 06130100.xhp%23hd_id3153665.help.text
msgctxt "06130100.xhp#hd_id3153665.help.text"
msgid "Password"
msgstr ""

#: 06130100.xhp%23par_id3155628.help.text
msgid ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_OLD_PASSWD\">Enter the current "
"password for the selected library.</ahelp>"
msgstr ""

#: 06130100.xhp%23hd_id3153126.help.text
msgid "New password"
msgstr ""

#: 06130100.xhp%23hd_id3153628.help.text
msgctxt "06130100.xhp#hd_id3153628.help.text"
msgid "Password"
msgstr ""

#: 06130100.xhp%23par_id3159413.help.text
msgid ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_NEW_PASSWD\">Enter a new "
"password for the selected library.</ahelp>"
msgstr ""

#: 06130100.xhp%23hd_id3148947.help.text
msgid "Confirm"
msgstr ""

#: 06130100.xhp%23par_id3149457.help.text
msgid ""
"<ahelp hid=\"SVX:EDIT:RID_SVXDLG_PASSWORD:ED_REPEAT_PASSWD\">Repeat the new "
"password for the selected library.</ahelp>"
msgstr ""
