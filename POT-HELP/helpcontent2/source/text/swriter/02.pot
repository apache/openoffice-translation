msgstr ""

#: 14020000.xhp%23par_id3156097.help.text
msgid "Subtraction"
msgstr ""

#: 14020000.xhp%23par_id3150087.help.text
msgid "-"
msgstr ""

#: 14020000.xhp%23par_id3153122.help.text
msgid "Calculates the difference"
msgstr ""

#: 14020000.xhp%23par_id3153135.help.text
msgid "Example: 10 - <B5>"
msgstr ""

#: 14020000.xhp%23par_id3149646.help.text
msgid "Multiplication"
msgstr ""

#: 14020000.xhp%23par_id3154038.help.text
msgid "MUL or *"
msgstr ""

#: 14020000.xhp%23par_id3149965.help.text
msgid "Calculates the product."
msgstr ""

#: 14020000.xhp%23par_id3149603.help.text
msgid "Example: 7 MUL 9"
msgstr ""

#: 14020000.xhp%23par_id3145096.help.text
msgid "Division"
msgstr ""

#: 14020000.xhp%23par_id3149570.help.text
msgid "DIV or /"
msgstr ""

#: 14020000.xhp%23par_id3149592.help.text
msgid "Calculates the quotient"
msgstr ""

#: 14020000.xhp%23par_id3156243.help.text
msgid "Example: 100 DIV 15"
msgstr ""

#: 14020000.xhp%23hd_id3156260.help.text
msgid "Basic Functions in the Submenu"
msgstr ""

#: 14020000.xhp%23par_id3145185.help.text
msgctxt "14020000.xhp#par_id3145185.help.text"
msgid "Sum"
msgstr ""

#: 14020000.xhp%23par_id3155312.help.text
msgid "SUM"
msgstr ""

#: 14020000.xhp%23par_id3155335.help.text
msgid ""
"<ahelp hid=\"HID_MN_CALC_SUM\">Calculates the sum of the selected cells.</"
"ahelp>"
msgstr ""

#: 14020000.xhp%23par_id3154411.help.text
msgid "Example: SUM <A2:C2> displays the sum of the values in cells A2 to C2"
msgstr ""

#: 14020000.xhp%23par_id3153381.help.text
msgid "Round"
msgstr ""

#: 14020000.xhp%23par_id3145598.help.text
msgid "ROUND"
msgstr ""

#: 14020000.xhp%23par_id3145621.help.text
msgid ""
"<ahelp hid=\"HID_MN_CALC_ROUND\">Rounds a number to the specified decimal "
"places.</ahelp>"
msgstr ""

#: 14020000.xhp%23par_id3154862.help.text
msgid "Example: 15.678 ROUND 2 displays 15.68"
msgstr ""

#: 14020000.xhp%23par_id3148687.help.text
msgid "Percent"
msgstr ""

#: 14020000.xhp%23par_id3155930.help.text
msgid "PHD"
msgstr ""

#: 14020000.xhp%23par_id3155953.help.text
msgid "<ahelp hid=\"HID_MN_CALC_PHD\">Calculates a percentage</ahelp>"
msgstr ""

#: 14020000.xhp%23par_id3149991.help.text
msgid "Example: 10 + 15 PHD displays 10.15"
msgstr ""

#: 14020000.xhp%23par_id3153016.help.text
msgid "Square Root"
msgstr ""

#: 14020000.xhp%23par_id3153038.help.text
msgid "SQRT"
msgstr ""

#: 14020000.xhp%23par_id3153062.help.text
msgid "<ahelp hid=\"HID_MN_CALC_SQRT\">Calculates the square root.</ahelp>"
msgstr ""

#: 14020000.xhp%23par_id3153882.help.text
msgid "Example: SQRT 25 displays 5.00"
msgstr ""

#: 14020000.xhp%23par_id3153909.help.text
msgid "Power"
msgstr ""

#: 14020000.xhp%23par_id3147124.help.text
msgid "POW"
msgstr ""

#: 14020000.xhp%23par_id3149768.help.text
msgid ""
"<ahelp hid=\"HID_MN_CALC_POW\">Calculates the power of a number.</ahelp>"
msgstr ""

#: 14020000.xhp%23par_id3149789.help.text
msgid "Example: 2 POW 8 displays 256.00"
msgstr ""

#: 14020000.xhp%23hd_id3150216.help.text
msgid "Operators"
msgstr ""

#: 14020000.xhp%23par_id3150244.help.text
msgid ""
"<ahelp hid=\"HID_MN_POP_OPS\">You can insert various operators in your "
"formula.</ahelp> Choose from the following functions:"
msgstr ""

#: 14020000.xhp%23par_id3150316.help.text
msgid "List Separator"
msgstr ""

