#: 06070000.xhp%23par_id3145241.help.text
msgid ""
"<ahelp hid=\".uno:DecrementSubLevels\">Shifts paragraphs with subpoints down "
"one level.</ahelp> This is only visible when the cursor is positioned within "
"numbered or bulleted text."
msgstr ""

#: 06070000.xhp%23par_id3145084.help.text
msgid ""
"<image id=\"img_id3156376\" src=\"res/commandimagelist/"
"sc_decrementsublevels.png\" width=\"0.222inch\" height=\"0.222inch\"><alt "
"id=\"alt_id3156376\">Icon</alt></image>"
