#: 14020000.xhp%23par_id3150720.help.text
msgid "Greater"
msgstr ""

#: 14020000.xhp%23par_id3150743.help.text
msgid "G"
msgstr ""

#: 14020000.xhp%23par_id3147310.help.text
msgid ""
"<ahelp hid=\"HID_MN_CALC_GRE\">Tests for values greater than a specified "
"value</ahelp>"
msgstr ""

#: 14020000.xhp%23par_id3147333.help.text
msgid ""
"Example: <A1> G 2 displays 1 (true), if the content of A1 is greater than 2."
msgstr ""

#: 14020000.xhp%23par_id3148408.help.text
