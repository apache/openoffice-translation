msgid ""
"<ahelp hid=\".uno:ShadowCursor\">Activates or deactivates the direct "
"cursor.</ahelp> You can specify the behavior of the direct cursor by "
"choosing <emph><switchinline select=\"sys\"><caseinline select=\"MAC\">"
"%PRODUCTNAME - Preferences</caseinline><defaultinline>Tools - Options</"
"defaultinline></switchinline> - <link href=\"text/shared/optionen/"
"01040600.xhp\" name=\"Text Document - Formatting Aids\">%PRODUCTNAME "
