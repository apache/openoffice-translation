msgid ""
"<ahelp hid=\"HID_MN_CALC_GEQ\">Tests for values greater than or equal to a "
"specified value</ahelp>"
msgstr ""

#: 14020000.xhp%23par_id3148898.help.text
msgid ""
"Example: <A1> GEQ 2 displays 1 (true), if the content of A1 is greater than "
