#: 01020000.xhp%23hd_id3148870.help.text
msgid "Shortcut Keys for Formula Functions"
msgstr ""

#: 01020000.xhp%23par_id3153246.help.text
msgid ""
"The following shortcut keys correspond to commands in the <emph>Edit</emph> "
"and <emph>View</emph> menus."
msgstr ""

#: 01020000.xhp%23hd_id3146324.help.text
msgid "F3"
msgstr ""

#: 01020000.xhp%23par_id3150537.help.text
msgid "Next Error"
msgstr ""

#: 01020000.xhp%23hd_id3155620.help.text
msgid "Shift+F3"
msgstr ""

#: 01020000.xhp%23par_id3149355.help.text
msgid "Previous Error"
msgstr ""

#: 01020000.xhp%23hd_id3153808.help.text
msgid "F4"
msgstr ""

#: 01020000.xhp%23par_id3149871.help.text
msgid "Next Marker (Placeholder)"
msgstr ""

#: 01020000.xhp%23hd_id3150396.help.text
msgid "Shift+F4"
msgstr ""

#: 01020000.xhp%23par_id3151390.help.text
msgid "Previous Marker (Placeholder)"
msgstr ""

#: 01020000.xhp%23hd_id3154554.help.text
msgid "F9"
msgstr ""

#: 01020000.xhp%23par_id3153003.help.text
msgid "Update"
msgstr ""

#: 01020000.xhp%23hd_id3153732.help.text
msgid "Navigation in the Elements Window"
msgstr ""

#: 01020000.xhp%23hd_id3155927.help.text
msgid "Left or right arrow"
msgstr ""

#: 01020000.xhp%23par_id3145249.help.text
msgid "Move left or right to the next category or function."
msgstr ""

#: 01020000.xhp%23hd_id3150928.help.text
msgid "Enter key"
msgstr ""

#: 01020000.xhp%23par_id3148390.help.text
msgid ""
"Selects a category (within the category section) or inserts a function in "
"the <emph>Commands</emph> window (within the function section)."
msgstr ""

#: 01020000.xhp%23hd_id3155988.help.text
msgid "Tab"
msgstr ""

#: 01020000.xhp%23par_id3153723.help.text
msgid ""
"Jump from the first category item to the first function of the category."
msgstr ""

#: 01020000.xhp%23hd_id3083451.help.text
msgid "Shift+Tab"
msgstr ""

#: 01020000.xhp%23par_id3151181.help.text
msgid "Jump from the last category item to the last function of the category."
msgstr ""
