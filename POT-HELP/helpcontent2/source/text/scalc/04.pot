#: 01020000.xhp%23hd_id3145669.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+1 (not on the number pad)"
msgstr ""

