msgid "<emph>Effect</emph>"
msgstr ""

#: 01020000.xhp%23hd_id3146871.help.text
msgctxt "01020000.xhp#hd_id3146871.help.text"
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Home"
msgstr ""

#: 01020000.xhp%23par_id3159093.help.text
msgid "Moves the cursor to the first cell in the sheet (A1)."
msgstr ""

#: 01020000.xhp%23hd_id3145073.help.text
msgctxt "01020000.xhp#hd_id3145073.help.text"
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+End"
msgstr ""

#: 01020000.xhp%23par_id3153283.help.text
msgid "Moves the cursor to the last cell on the sheet that contains data."
msgstr ""

#: 01020000.xhp%23hd_id3149127.help.text
msgctxt "01020000.xhp#hd_id3149127.help.text"
msgid "Home"
msgstr ""

#: 01020000.xhp%23par_id3159205.help.text
msgid "Moves the cursor to the first cell of the current row."
msgstr ""

#: 01020000.xhp%23hd_id3149897.help.text
msgctxt "01020000.xhp#hd_id3149897.help.text"
msgid "End"
msgstr ""

#: 01020000.xhp%23par_id3155095.help.text
msgid "Moves the cursor to the last cell of the current row."
msgstr ""

#: 01020000.xhp%23hd_id3143220.help.text
msgctxt "01020000.xhp#hd_id3143220.help.text"
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Left Arrow"
msgstr ""

#: 01020000.xhp%23par_id3154766.help.text
msgid ""
"Moves the cursor to the left edge of the current data range. If the column "
"to the left of the cell that contains the cursor is empty, the cursor moves "
"to the next column to the left that contains data."
msgstr ""

#: 01020000.xhp%23hd_id3153554.help.text
msgctxt "01020000.xhp#hd_id3153554.help.text"
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Right Arrow"
msgstr ""

#: 01020000.xhp%23par_id3155593.help.text
msgid ""
"Moves the cursor to the right edge of the current data range. If the column "
"to the right of the cell that contains the cursor is empty, the cursor moves "
"to the next column to the right that contains data."
msgstr ""

#: 01020000.xhp%23hd_id3149317.help.text
msgctxt "01020000.xhp#hd_id3149317.help.text"
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Up Arrow"
msgstr ""

#: 01020000.xhp%23par_id3153076.help.text
msgid ""
"Moves the cursor to the top edge of the current data range. If the row above "
"the cell that contains the cursor is empty, the cursor moves up to the next "
"row that contains data."
msgstr ""

#: 01020000.xhp%23hd_id3147250.help.text
msgctxt "01020000.xhp#hd_id3147250.help.text"
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Down Arrow"
msgstr ""

#: 01020000.xhp%23par_id3149054.help.text
msgid ""
"Moves the cursor to the bottom edge of the current data range. If the row "
"below the cell that contains the cursor is empty, the cursor moves down to "
"the next row that contains data."
msgstr ""

#: 01020000.xhp%23hd_id3148744.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Shift+Arrow"
msgstr ""

#: 01020000.xhp%23par_id3159258.help.text
msgid ""
"Selects all cells containing data from the current cell to the end of the "
"continuous range of data cells, in the direction of the arrow pressed. If "
"used to select rows and columns together, a rectangular cell range is "
"selected."
msgstr ""

#: 01020000.xhp%23hd_id3156399.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Page Up"
msgstr ""

#: 01020000.xhp%23par_id3145236.help.text
msgid "Moves one sheet to the left."
msgstr ""

#: 01020000.xhp%23par_id3149725.help.text
msgid "In the page preview: Moves to the previous print page."
msgstr ""

#: 01020000.xhp%23hd_id3147411.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Page Down"
msgstr ""

#: 01020000.xhp%23par_id3150372.help.text
msgid "Moves one sheet to the right."
msgstr ""

#: 01020000.xhp%23par_id3159120.help.text
msgid "In the page preview: Moves to the next print page."
msgstr ""

#: 01020000.xhp%23hd_id3146885.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline>"
"<defaultinline>Alt</defaultinline></switchinline> + Page Up"
msgstr ""

#: 01020000.xhp%23par_id3152976.help.text
msgid "Moves one screen to the left."
msgstr ""

#: 01020000.xhp%23hd_id3149013.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline>"
"<defaultinline>Alt</defaultinline></switchinline> + Page Down"
msgstr ""

#: 01020000.xhp%23par_id3150477.help.text
msgid "Moves one screen page to the right."
msgstr ""

#: 01020000.xhp%23par_idN10AFC.help.text
msgid ""
"Shift+<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</"
"caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Page Up"
msgstr ""

#: 01020000.xhp%23par_idN10B00.help.text
msgid ""
"Adds the previous sheet to the current selection of sheets. If all the "
"sheets in a spreadsheet are selected, this shortcut key combination only "
"selects the previous sheet. Makes the previous sheet the current sheet."
msgstr ""

#: 01020000.xhp%23par_idN10B03.help.text
msgid ""
"Shift+<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</"
"caseinline><defaultinline>Ctrl</defaultinline></switchinline>+Page Down"
msgstr ""

#: 01020000.xhp%23par_idN10B07.help.text
msgid ""
"Adds the next sheet to the current selection of sheets. If all the sheets in "
"a spreadsheet are selected, this shortcut key combination only selects the "
"next sheet. Makes the next sheet the current sheet."
msgstr ""

#: 01020000.xhp%23hd_id3145826.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline> + *"
msgstr ""

#: 01020000.xhp%23par_id3148882.help.text
msgid "where (*) is the multiplication sign on the numeric key pad"
msgstr ""

#: 01020000.xhp%23par_id3154847.help.text
msgid ""
"Selects the data range that contains the cursor. A range is a contiguous "
"cell range that contains data and is bounded by empty row and columns."
msgstr ""

#: 01020000.xhp%23hd_id3151233.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline> + /"
msgstr ""

#: 01020000.xhp%23par_id3149949.help.text
msgid "where (/) is the division sign on the numeric key pad"
msgstr ""

#: 01020000.xhp%23par_id3150144.help.text
msgid "Selects the matrix formula range that contains the cursor."
msgstr ""

#: 01020000.xhp%23par_id8163396.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Plus key"
msgstr ""

#: 01020000.xhp%23par_id9901425.help.text
msgid "Insert cells (as in menu Insert - Cells)"
msgstr ""

#: 01020000.xhp%23par_id3389080.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Minus key"
msgstr ""

#: 01020000.xhp%23par_id5104220.help.text
msgid "Delete cells (as in menu Edit - Delete Cells)"
msgstr ""

#: 01020000.xhp%23hd_id3155825.help.text
msgid "Enter (in a selected range)"
msgstr ""

#: 01020000.xhp%23par_id3153935.help.text
msgid ""
"Moves the cursor down one cell in a selected range. To specify the direction "
"that the cursor moves, choose <emph><switchinline select=\"sys\"><caseinline "
"select=\"MAC\">%PRODUCTNAME - Preferences</caseinline><defaultinline>Tools - "
"Options</defaultinline></switchinline> - %PRODUCTNAME Calc - General</emph>."
msgstr ""

#: 01020000.xhp%23par_id5961180.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command </caseinline>"
"<defaultinline>Ctrl </defaultinline></switchinline> + ` (see note below this "
"table)"
msgstr ""

#: 01020000.xhp%23par_id6407055.help.text
msgid "Displays or hides the formulas instead of the values in all cells."
msgstr ""

#: 01020000.xhp%23par_id8070314.help.text
msgid ""
"The ` key is located next to the \"1\" key on most English keyboards. If "
"your keyboard does not show this key, you can assign another key: Choose "
"Tools - Customize, click the Keyboard tab. Select the \"View\" category and "
"the \"Toggle Formula\" function."
msgstr ""

#: 01020000.xhp%23hd_id3148756.help.text
msgid "Function Keys Used in Spreadsheets"
msgstr ""

#: 01020000.xhp%23hd_id3148581.help.text
msgctxt "01020000.xhp#hd_id3148581.help.text"
msgid "Shortcut Keys"
msgstr ""

#: 01020000.xhp%23par_id3152790.help.text
msgctxt "01020000.xhp#par_id3152790.help.text"
msgid "<emph>Effect</emph>"
msgstr ""

#: 01020000.xhp%23hd_id3154809.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+F1"
msgstr ""

#: 01020000.xhp%23par_id3145140.help.text
msgid "Displays the comment that is attached to the current cell"
msgstr ""

#: 01020000.xhp%23hd_id3146142.help.text
msgid "F2"
msgstr ""

#: 01020000.xhp%23par_id3148568.help.text
msgid ""
"Switches to Edit mode and places the cursor at the end of the contents of "
"the current cell. Press again to exit Edit mode."
msgstr ""

#: 01020000.xhp%23par_id3153108.help.text
msgid ""
"If the cursor is in an input box in a dialog that has a <emph>Minimize</"
"emph> button, the dialog is hidden and the input box remains visible. Press "
"F2 again to show the whole dialog."
msgstr ""

#: 01020000.xhp%23hd_id3146850.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+F2"
msgstr ""

#: 01020000.xhp%23par_id3145162.help.text
msgid "Opens the Function Wizard."
msgstr ""

#: 01020000.xhp%23hd_id3147366.help.text
msgid ""
"Shift+<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</"
"caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F2"
msgstr ""

#: 01020000.xhp%23par_id3155929.help.text
msgid ""
"Moves the cursor to the <emph>Input line</emph> where you can enter a "
"formula for the current cell."
msgstr ""

#: 01020000.xhp%23hd_id3153730.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+F3"
msgstr ""

#: 01020000.xhp%23par_id3145245.help.text
msgid "Opens the <emph>Define Names</emph> dialog."
msgstr ""

#: 01020000.xhp%23hd_id3148768.help.text
msgid "F4"
msgstr ""

#: 01020000.xhp%23par_id3153047.help.text
msgid "Shows or Hides the Database explorer."
msgstr ""

#: 01020000.xhp%23hd_id3145353.help.text
msgid "Shift+F4"
msgstr ""

#: 01020000.xhp%23par_id3155620.help.text
msgid ""
"Rearranges the relative or absolute references (for example, A1, $A$1, $A1, "
"A$1) in the input field."
msgstr ""

#: 01020000.xhp%23hd_id3156063.help.text
msgid "F5"
msgstr ""

#: 01020000.xhp%23par_id3149540.help.text
msgid "Shows or hides the <emph>Navigator</emph>."
msgstr ""

#: 01020000.xhp%23hd_id3148392.help.text
msgid "Shift+F5"
msgstr ""

#: 01020000.xhp%23par_id3150268.help.text
msgid "Traces dependents."
msgstr ""

#: 01020000.xhp%23hd_id3148430.help.text
msgid "Shift+F7"
msgstr ""

#: 01020000.xhp%23par_id3153179.help.text
msgid "Traces precedents."
msgstr ""

#: 01020000.xhp%23hd_id3150568.help.text
msgid ""
"Shift+<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</"
"caseinline><defaultinline>Ctrl</defaultinline></switchinline>+F5"
msgstr ""

#: 01020000.xhp%23par_id3153551.help.text
msgid ""
"Moves the cursor from the <emph>Input line</emph> to the <emph>Sheet area</"
"emph> box."
msgstr ""

#: 01020000.xhp%23hd_id3155368.help.text
msgid "F7"
msgstr ""

#: 01020000.xhp%23par_id3154871.help.text
msgid "Checks spelling in the current sheet."
msgstr ""

#: 01020000.xhp%23hd_id3150688.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+F7"
msgstr ""

#: 01020000.xhp%23par_id3149781.help.text
msgid "Opens the Thesaurus if the current cell contains text."
msgstr ""

#: 01020000.xhp%23hd_id3156257.help.text
msgid "F8"
msgstr ""

#: 01020000.xhp%23par_id3147482.help.text
msgid ""
"Turns additional selection mode on or off. In this mode, you can use the "
"arrow keys to extend the selection. You can also click in another cell to "
"extend the selection."
msgstr ""

#: 01020000.xhp%23hd_id3154313.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+F8"
msgstr ""

#: 01020000.xhp%23par_id3150385.help.text
msgid "Highlights cells containing values."
msgstr ""

#: 01020000.xhp%23hd_id3152479.help.text
msgid "F9"
msgstr ""

#: 01020000.xhp%23par_id3163827.help.text
msgid "Recalculates changed formulas in the current sheet."
msgstr ""

#: 01020000.xhp%23par_id9027069.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Shift+F9"
msgstr ""

#: 01020000.xhp%23par_id1729178.help.text
msgid "Recalculates all formulas in all sheets."
msgstr ""

#: 01020000.xhp%23hd_id3156300.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+F9"
msgstr ""

#: 01020000.xhp%23par_id3154817.help.text
msgid "Updates the selected chart."
msgstr ""

#: 01020000.xhp%23hd_id3149279.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command+T</"
"caseinline><defaultinline>F11</defaultinline></switchinline>"
msgstr ""

#: 01020000.xhp%23par_id3150967.help.text
msgid ""
"Opens the <emph>Styles and Formatting</emph> window where you can apply a "
"formatting style to the contents of the cell or to the current sheet."
msgstr ""

#: 01020000.xhp%23hd_id3156308.help.text
msgid "Shift+F11"
msgstr ""

#: 01020000.xhp%23par_id3145209.help.text
msgid "Creates a document template."
msgstr ""

#: 01020000.xhp%23hd_id3147622.help.text
msgid ""
"Shift<switchinline select=\"sys\"><caseinline select=\"MAC\">+Command</"
"caseinline><defaultinline>+Ctrl</defaultinline></switchinline>+F11"
msgstr ""

#: 01020000.xhp%23par_id3153215.help.text
msgid "Updates the templates."
msgstr ""

#: 01020000.xhp%23hd_id3150760.help.text
msgid "F12"
msgstr ""

#: 01020000.xhp%23par_id3156321.help.text
msgid "Groups the selected data range."
msgstr ""

#: 01020000.xhp%23hd_id3146859.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+F12"
msgstr ""

#: 01020000.xhp%23par_id3156128.help.text
msgid "Ungroups the selected data range."
msgstr ""

#: 01020000.xhp%23hd_id3151264.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline>"
"<defaultinline>Alt</defaultinline></switchinline> + Down Arrow"
msgstr ""

#: 01020000.xhp%23par_id3153155.help.text
msgid "Increases the height of current row."
msgstr ""

#: 01020000.xhp%23hd_id3151297.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline>"
"<defaultinline>Alt</defaultinline></switchinline> + Up Arrow"
msgstr ""

#: 01020000.xhp%23par_id3155849.help.text
msgid "Decreases the height of current row."
msgstr ""

#: 01020000.xhp%23hd_id3155997.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline>"
"<defaultinline>Alt</defaultinline></switchinline> + Right Arrow"
msgstr ""

#: 01020000.xhp%23par_id3150256.help.text
msgid "Increases the width of the current column."
msgstr ""

#: 01020000.xhp%23hd_id3154046.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline>"
"<defaultinline>Alt</defaultinline></switchinline> + Left Arrow"
msgstr ""

#: 01020000.xhp%23par_id3150155.help.text
msgid "Decreases the width of the current column."
msgstr ""

#: 01020000.xhp%23hd_id3149293.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Option</caseinline>"
"<defaultinline>Alt</defaultinline></switchinline>+Shift+Arrow Key"
msgstr ""

#: 01020000.xhp%23par_id3159180.help.text
msgid "Optimizes the column width or row height based on the current cell."
msgstr ""

