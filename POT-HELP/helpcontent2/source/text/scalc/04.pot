msgstr ""

#: 01020000.xhp%23hd_id3145668.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Shift+1 (not on the "
"number pad)"
msgstr ""

#: 01020000.xhp%23par_id3149196.help.text
msgid "Two decimal places, thousands separator"
msgstr ""

#: 01020000.xhp%23hd_id3155331.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Shift+2 (not on the "
"number pad)"
msgstr ""

#: 01020000.xhp%23par_id3150120.help.text
msgid "Standard exponential format"
msgstr ""

#: 01020000.xhp%23hd_id3154932.help.text
msgid ""
"<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline>"
"<defaultinline>Ctrl</defaultinline></switchinline>+Shift+3 (not on the "
